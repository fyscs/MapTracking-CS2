import { Instance, CSInputs, CSDamageTypes, CSHitGroup} from "cs_script/point_script";



//================初始化相关===============================================
const playerStates = new Map();//用于记录玩家状态




//初始化：返回一个标准的模版玩家状态
function createPlayerState() {
    return {
        skillType: "空",      	 // 技能类型，方块、地雷、TNT、医疗包、瞬移、手雷、护甲、"地图技能手雷"、"地图技能燃烧瓶"、"地图技能诱饵弹"、火箭筒
        cooldownEndTime: 0,     // 技能冷却的截止时间（秒）
		remainingUses: 5,		//技能次数，默认5次
		skillToggle: false,		//技能状态切换，用于技能有两种模式的情况，例如TNT，有安放模式、引爆模式
		skillEnt: null,			//技能的绑定实体
        //equipment: [],       // 拥有装备列表（待开发）
        activeCallbacks: []    // 记录该玩家当前绑定的事件回调，用于注销。以防事件永远保留使游戏变卡。
    };
}


//初始化玩家状态
function resetAllPlayerStates() {
	
	//删除旧的。将记录过的玩家状态键，遍历每一个执行删除
    for (const [playerId, state] of playerStates) {
        // 注销上一回合残留回调函数
        for (const cb of state.activeCallbacks) {
            Instance.DisconnectOutput(cb);
        }
        //删除
        playerStates.delete(playerId);
    }	
	
	
	//建立新的。获取所有玩家的id值，并建立对应的状态键	
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
    for (let controller of controllers) {				//遍历玩家控制器
	
        if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

        const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
        if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活

		const slot = controller.GetPlayerSlot();	//获取玩家的id
		playerStates.set(slot, createPlayerState());//创建该id的玩家状态键。若原先的slot还有，那么将会覆盖之前的
    }	
}



//当技能类型玩家手动选择好后，再设置对应技能的初始参数
function SetResetPlayerStates(slot) {
	let state = playerStates.get(slot); 	//获取玩家状态
	switch (state.skillType) {
		case "空":
		case null:
			break;			//空技能不做操作
		case "攻击之爪":
		case "夺命凶弹":
			break;			//这些被动技能暂时不做操作（未来可以设置成装备栏的添加装备）
		case "地图技能手雷":
		case "地图技能燃烧瓶":
		case "地图技能诱饵弹":
		case "地图技能电击枪":
			break;			//这些地图技能可以不做操作，已经在释放函数中设置为不消耗次数、无cd
		case "方块":
			state.remainingUses = 32;
			break;
			
		case "地雷":
			state.remainingUses = 6;
			break;
			
		case "TNT":
			state.remainingUses = 2;
			break;
			
		case "医疗包":
			state.remainingUses = 2;
			break;
			
		case "瞬移":
			state.remainingUses = 6;
			break;
			
		case "手雷":
			state.remainingUses = 10;
			break;
			
		case "护甲":
			state.remainingUses = 1;
			break;	
		//case "火箭筒":
		//	state.remainingUses = 2;
		//	break;	
		
		default:
			Instance.Msg(`[Warning] 未知的技能类型: ${state.skillType}`);
    }
}
		
			
		
		
		
		

//================函数入口==============================================================
//当新回合开始时触发的入口函数

//主要是初始化工作，重新赋值全局变量。全局变量应该尽量少用，能减少代码的维护和工作量。但是不可避免的要用，因为许多实体引发的函数运行，并不是连续执行的，需要全局变量传参。所以，凡是用let定义的全局变量，全部需要在这里初始化，不能遗漏
Instance.OnRoundStart( () => {
	Instance.Msg("回合初始化中：");
	//-------------玩家相关-------------------
	//初始化：去除所有玩家武器
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
	for (let controller of controllers) {				//遍历玩家控制器
	if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

	const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
	if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活

	pawn.DestroyWeapons();
	//pawn.DestroyWeapon();		//有两个api，一个名称带s，一个名称不带s
	}
	
	if(HandleBuyPointT && HandleBuyPointT.IsValid()){
		Instance.EntFireAtTarget({
			target: HandleBuyPointT,
			input: "Kill",
		});			
	}
	if(HandleBuyPointCT && HandleBuyPointCT.IsValid()){
		Instance.EntFireAtTarget({
			target: HandleBuyPointCT,
			input: "Kill",
		});			
	}
	Instance.Msg("====去除所有玩家武器、地图购买点====");
	
	//初始化：技能模块关闭
	skillEnabled = false;
	TickIsEnabled = false;
	Instance.Msg("====帧循环函数入口TickIsEnabled已关闭、技能模块已关闭，请玩家按钮打开启用技能模块skillEnabled,在传送到地图后可打开TickIsEnabled ====");
	
	//初始化：开始帧循环函数
	Instance.SetThink(Tick);
	Instance.SetNextThink(Instance.GetGameTime() + 0.5);
	Instance.Msg("====获取玩家技能按键模块的帧循环函数已自动加载 ====");
	
	//初始化：玩家状态
	resetAllPlayerStates();
	Instance.Msg("====玩家技能状态已清零，请玩家按钮选择自己的技能 ====");
	
	
	//-------------------地图全局设置相关--------------------------------
	//初始化：武器默认随机
	activeWeapon = "随机";	//当前武器类型
	SelectWeaponListShare = false;//自选武器T和CT不共享
	Instance.Msg("====初始化，当前武器类型为随机、自选武器T和CT不共享====");
	
	//初始化：地图实体（传送出生点）状态初始化和默认随机
	mapTspawn = {position: Instance.FindEntityByName("原地对枪图T出生点").GetAbsOrigin(), angles: Instance.FindEntityByName("原地对枪图T出生点").GetAbsAngles() };
	mapCTspawn = {position: Instance.FindEntityByName("原地对枪图CT出生点").GetAbsOrigin(), angles: Instance.FindEntityByName("原地对枪图CT出生点").GetAbsAngles() };
	activeMap = "随机";		//地图
	Instance.Msg("====地图传送出生点位置初始化、地图选择默认随机====");	
	
	//初始化：最大生命值为100
	HealthMax = 100;
	SetHealthMax();
	Instance.Msg("====初始化所有玩家最大生命值为100、护甲无====");
	
	//初始化：重力值=1*800（默认800），摔伤=1
	gravityMultiply = 1;
	falldamageMultiply = 1;
	Instance.ServerCommand("sv_gravity 800");
	Instance.ServerCommand("sv_falldamage_scale 1");
	Instance.Msg("====初始化，重力值=800（默认），摔伤=1====");
	
	//伤害位置倍率
	shotBodyDamageMultiply = 1;
	Instance.Msg("====初始化，身体伤害倍率为1====");
	
	//武器伤害白名单、队伍伤害白名单清空
	//（暂不考虑）
	
	
	//-------------------部分地图功能设置相关----------------
	//初始化：1v1地图初始。
	vsFightN = 1;		//nVSn对抗模式战斗人数默认为1v1
	CheesPlayerWeapon = [null, null, null, null];		//棋位玩家的武器暂存
	Instance.Msg("====1v1地图（战斗人数=1vs1、棋位玩家的武器暂存）状态初始化====");	
	
	//初始化：下棋模块初始化
	activatedEntChess = null;	//象棋选中的棋子
	BlackWhiteToggle = 3;		//黑白棋先手为阵营3（CT阵营）
	Instance.Msg("====下棋模块（象棋模块的选中实体、黑白棋先手阵营）状态初始化====");	
	
	//初始化：地图地形
	spawnPushEnt = false;		//加速板
	spawnTaserPushEnt = false;	//电击枪加速板
	
	spawnEntCount = 0;		//设置生成物个数	
	QueueCount = [0, 0, 0];		//设置指定类型的个数	
	spawnEntQueue = ["墙", 0, 0, 0, "透明墙", 0, 0, 0, "梯子", 0, 0, 0, "箱子", 0, 0, 0, "加速板", 0, 0, 0];	//随机地形生成队列
	Instance.Msg("====地形生成（电击枪加速板、设置物体个数/角度类型/生成队列）状态初始化====");

	
	//最后
	Instance.Msg("====初始化完毕====");
	
});



//选择技能触发的入口函数
//玩家手动选择技能，遍历生成每一种技能的输入入口函数
const SkillSelect = ["方块", "地雷", "TNT", "医疗包", "瞬移", "手雷", "护甲",    "攻击之爪", "夺命凶弹",    "防弹盾", "火箭筒", "伪装"];//另外，地图技能由地图决定（不能主动选择）"地图技能手雷"、"地图技能燃烧瓶"、"地图技能诱饵弹"
SkillSelect.forEach(n => {
    // 例如当 n 为 5 时，注册一个名为 "选择技能5" 的输入监听
    Instance.OnScriptInput(`选择技能是${n}`, (inputData) => {
		
	// 1. 通过 inputData 中获取触发按钮的玩家角色肉体（Pawn类型）
    const pawn = inputData.activator;
    if (!pawn || !pawn.IsValid()) {
        Instance.Msg("[SkillSelect] 错误：无法获取触发按钮的玩家实体\n");
        return;
    }

	//2.通过Pawn获取玩家控制器（Controller类型）
	let playerController = pawn.GetPlayerController();	
	//3.通过Controller获取slot
	const slot = playerController.GetPlayerSlot();
    if (slot === undefined || slot === null) {
        Instance.Msg("错误：无法获取玩家 slot");
        return;
    }

    // 4. 将该 slot 作为键，设置 skillType 
    // 如果该 slot 还没有状态对象，先初始化一个默认对象
    if (!playerStates.has(slot)) {
        playerStates.set(slot, createPlayerState());
    }
	
    //设置技能类型
    const state = playerStates.get(slot);
    state.skillType = n;	//设置技能类型值
	SetResetPlayerStates(slot);		//设置该技能类型的其余数据
	
    //Instance.Msg(`[SkillSelect] 玩家 slot=${slot} 已选择技能${n}\n`);
	const spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
	textEntityShow(spawnedEntities, pawn, `你技能是: ${state.skillType}`, 5);			//显示文本实体
	
    });
});



//按钮触发人入口函数，启用技能
let skillEnabled = false;
Instance.OnScriptInput("启用技能模块", (inputData) => {
	skillEnabled = true;
	Instance.Msg("====启用技能模块打开 ====");
	Instance.ServerCommand("say 启用技能");
});

//*********************************************基本属性（血量、护甲、重力、摔伤、身体伤害倍率）*********************************

//身体伤害倍率
let shotBodyDamageMultiply = 1;
//设置文本显示身体伤害倍率
const shotBodyDamageSelect = [-0.25, 0.25];
shotBodyDamageSelect.forEach(n => {
    Instance.OnScriptInput(`设置身体伤害倍率${n}`, (inputData) => {
		const SetDamage = shotBodyDamageMultiply + n;
		shotBodyDamageMultiply = SetDamage;
		
		if (0.1 >= SetDamage) {
		shotBodyDamageMultiply = 0.1;		//下限值
		}
		
		if (1.25 <= SetDamage) {
		shotBodyDamageMultiply = 1.25;		//上限值
		}
		
		Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置身体伤害倍率文本"),
		input: "SetMessage",
		value: `设置身体伤害倍率：${shotBodyDamageMultiply} 倍`
		});
    });
});
//入口函数，确认设置身体伤害倍率
Instance.OnScriptInput("确认设置身体伤害倍率", (inputData) => {		
	//（空操作），尽管不需要确定，但是也必须通知所有玩家，所以必须要这么一个过程。
	Instance.ServerCommand(`say 玩家设置身体伤害倍率:${shotBodyDamageMultiply}倍`);
});





//血量
let HealthMax = 100;		//最大生命值
//设置文本显示血量
const HealthSelect = [-500, -100, -25, 25, 100, 500];
HealthSelect.forEach(n => {
    Instance.OnScriptInput(`设置玩家生命值${n}`, (inputData) => {
		const SetHealth = HealthMax + n;
		HealthMax = SetHealth;
		
		if (0 >= SetHealth) {
		HealthMax = 1;		//下限值
		}
		
		if (1500 <= SetHealth) {
		HealthMax = 1500;		//上限值
		}
		
		Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置玩家生命值文本"),
		input: "SetMessage",
		value: `设置玩家生命值：${HealthMax}`
		});
		
    });
});
//入口函数，确认设置血量
Instance.OnScriptInput("确认设置玩家生命值", (inputData) => {
	SetHealthMax();
	Instance.ServerCommand(`say 玩家设置生命值:${HealthMax}`);
});
//确认设置血量
function SetHealthMax() {
	
let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
for (let controller of controllers) {				//遍历玩家控制器
	if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

	const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
	if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活

	pawn.SetMaxHealth(HealthMax);
	pawn.SetHealth(HealthMax);
	}
}



//重力
let gravityMultiply = 1;		//重力倍率
//设置文本显示重力
const gravitySelect = [-0.25, 0.25];
gravitySelect.forEach(n => {
    Instance.OnScriptInput(`设置重力${n}`, (inputData) => {
		const Setgravity = gravityMultiply + n;
		gravityMultiply = Setgravity;
		
		if (0.25 >= Setgravity) {
		gravityMultiply = 0.25;		//下限值
		}
		
		if (2 <= Setgravity) {
		gravityMultiply = 2;		//上限值
		}
		
		Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置重力文本"),
		input: "SetMessage",
		value: `设置重力：${gravityMultiply} 倍`
		});
    });
});
//入口函数，确认设置重力
Instance.OnScriptInput("确认设置重力", (inputData) => {
	Instance.ServerCommand(`sv_gravity ${800*gravityMultiply}`);
	Instance.ServerCommand(`say 玩家设置重力:${gravityMultiply}倍`);
});



//摔伤
let falldamageMultiply = 1;		//摔伤倍率
//设置文本显示摔伤
const falldamageSelect = [-0.25, 0.25];
falldamageSelect.forEach(n => {
    Instance.OnScriptInput(`设置摔伤${n}`, (inputData) => {
		const SetFalldamage = falldamageMultiply + n;
		falldamageMultiply = SetFalldamage;
		
		if (0.05 >= SetFalldamage) {
		falldamageMultiply = 0.05;		//下限值
		}
		
		if (3 <= SetFalldamage) {
		falldamageMultiply = 3;		//上限值
		}
		
		Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置摔伤文本"),
		input: "SetMessage",
		value: `摔伤：${falldamageMultiply} 倍`
		});
    });
});
//确认设置摔伤
Instance.OnScriptInput("确认设置摔伤", (inputData) => {
	Instance.ServerCommand(`sv_falldamage_scale ${falldamageMultiply}`);
	Instance.ServerCommand(`say 玩家设置摔伤:${falldamageMultiply}倍`);
});



//随机的重力摔伤
Instance.OnScriptInput("随机的重力摔伤", (inputData) => {
	
	const randG = Math.random(); // 生成 0~1 的随机数
	
	//随机获取区间内的实数Math.random() * (max - min) + min
    if (randG < 1/3) {
        gravityMultiply = 1;
    } else if (randG < 2/3) {
        gravityMultiply = ((Math.random() * (1 - 0.25)) + 0.25).toFixed(1);//取1~0.25
    } else {
        gravityMultiply = ((Math.random() * (2 - 1)) + 1).toFixed(1);//取2~1
    }
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置重力文本"),
		input: "SetMessage",
		value: `设置重力：${gravityMultiply} 倍`
	});	
	Instance.ServerCommand(`sv_gravity ${800*gravityMultiply}`);	
	
	const randF = Math.random(); // 生成 0~1 的随机数
	if (randF < 1/3) {
        falldamageMultiply = 1;
    } else if (randF < 2/3) {
        falldamageMultiply = ((Math.random() * (1 - 0.1)) + 0.1).toFixed(1);//取1~0.1
    } else {
        falldamageMultiply = ((Math.random() * (3 - 1)) + 1).toFixed(1);//取3~1
    }
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置摔伤文本"),
		input: "SetMessage",
		value: `摔伤：${falldamageMultiply} 倍`
	});
	Instance.ServerCommand(`sv_falldamage_scale ${falldamageMultiply}`);
	
	
	Instance.ServerCommand(`say 随机为，设置摔伤:${falldamageMultiply}倍、重力:${gravityMultiply}倍`);
});

//随机统一的生命值和身体伤害倍率
Instance.OnScriptInput("随机统一的生命值和身体伤害倍率", (inputData) => {
	const randH = Math.random(); // 生成 0~1 的随机数
	const randM = Math.random();
	
	//随机获取区间内的实数Math.random() * (max - min) + min
    if (randH < 1/3) {
        HealthMax = 100;
    } else if (randH < 2/3) {
        HealthMax = Math.floor((Math.random() * (125 - 1)) + 1);//取125~1
    } else {
        HealthMax = Math.floor((Math.random() * (1500 - 125)) + 125);//取1500~125
    }
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置玩家生命值文本"),
		input: "SetMessage",
		value: `设置玩家生命值：${HealthMax}`
	});
	SetHealthMax();
	
	if (randM < 1/3) {
        shotBodyDamageMultiply = 1;
    } else if (randM < 2/3) {
        shotBodyDamageMultiply = 0.1;
    } else {
        shotBodyDamageMultiply = Math.floor((Math.random() * (1.25 - 0.1)) + 0.1);//取0.1~1.25
    }
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置身体伤害倍率文本"),
		input: "SetMessage",
		value: `设置身体伤害倍率：${shotBodyDamageMultiply} 倍`
	});
	Instance.ServerCommand(`say 随机为，设置玩家生命值:${HealthMax}、身体伤害倍率：${shotBodyDamageMultiply} 倍`);

});









