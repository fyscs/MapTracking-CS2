//下棋模块玩家相关
//传送进:关闭入传送门、传送到棋位、记录玩家指定槽位武器并销毁、发放下棋工具
let CheesPlayerWeapon = [null, null, null, null];
const chessTeleportEnter = [0, 1, 2, 3];
chessTeleportEnter.forEach(n => {
    Instance.OnScriptInput(`下棋入传送门${n}`, (inputData) => {
	//关闭入传送门
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName(`下棋入口触发器${n}`),
		input: "Disable"
	});
	//标记入传送门为红
	/*
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName(`下棋入口标志${n}`),
		input: "Color",
		value: {255, 0, 0}
	});*/	//EntFireAtTarget的value：不支持传入对象
	Instance.FindEntityByName(`下棋入口标志${n}`).SetColor({r: 255, g: 0, b: 0});
	
	//玩家传送到棋位
	const pawn = inputData.activator;
	pawn.Teleport({
		position: Instance.FindEntityByName(`玩家棋位${n}`).GetAbsOrigin()
	});
	
	//记录玩家指定槽位武器
	const CSWeaponBase = pawn.FindWeaponBySlot(1);//1==PISTOL（手枪槽位）
	if(CSWeaponBase){//销毁武器
		CheesPlayerWeapon[n] = CSWeaponBase.GetData().GetName();
		//Instance.Msg(`调试:发现玩家有武器 ${CSWeaponBase}`);
		pawn.DestroyWeapon(CSWeaponBase);
	}
	
	//发放下棋工具
	pawn.GiveNamedItem("weapon_glock");
    });
});

//传送出：开启入传送门、传送到出生点、销毁下棋工具、找回武器、
const chessTeleportExit = [0, 1, 2, 3];
chessTeleportExit.forEach(n => {
    Instance.OnScriptInput(`下棋出传送门${n}`, (inputData) => {
	//开启入传送门
	Instance.EntFireAtTarget({
		target: Instance.FindEntityByName(`下棋入口触发器${n}`),
		input: "Enable"
	});
	//标记入传送门为绿
	Instance.FindEntityByName(`下棋入口标志${n}`).SetColor({r: 0, g: 255, b: 0});
	
	const pawn = inputData.activator;
	//销毁下棋工具
	const CSWeaponBase = pawn.FindWeaponBySlot(1);//1==PISTOL（手枪槽位）
	if(CSWeaponBase){
		//Instance.Msg(`调试:发现玩家有武器 ${CSWeaponBase}`);
		pawn.DestroyWeapon(CSWeaponBase);		
	}

	//玩家传送到出生点
	mapTeleportEnd(pawn);
	
	//找回武器
	if (CheesPlayerWeapon[n]){		//MO：若是武器对象(当前是数组，不需要)，必须先检查是否存在 && CheesPlayerWeapon[n].IsValid，以免报错
		pawn.GiveNamedItem(CheesPlayerWeapon[n]);
		CheesPlayerWeapon[n] = null;	//找回后，清空记录，避免给下一个棋位玩家
		}
    });
});




//1v1模块，方案一
//构思：选地图时，地图按钮有+1-1的选项调节1~4人，最多4v4。上方加伤害过滤器，使观战区域不能对玩家造成伤害。采用6个固定位置（可以留个空气墙，看起来像门，但不是门）用传送的方式，传送穿过空气墙。
//战斗结束阶段。初始地图，只有一个传送门。玩家死亡后，离开触发器，检测玩家是否为0，若为0进入入场阶段。
//战斗入场阶段。敌方区域触发传送，传送回休息区（使见不到对手，防止堵杀），模型门关动画。战斗人数 - 休息区人数 = 入场人数，生成入场人数个传送门。若人数达到要求，进入开始阶段。
//战斗开始阶段。每一次传送检查双方人数是否满足要求，满足即关闭休息区传送，模型门开动画。

//不采用tick函数循环，采用开始触发和离开触发的函数调用。	开始触发：人数+1，检测双方人数，并操作当前是哪个阶段。离开触发：人数-1，检测双方人数，并操作当前是哪个阶段。

/*
  Instance.OnScriptInput("1v1战斗时间结束", (inputData) => {	//战斗区传送触发器生效将玩家传送回起点、门关闭、计算并生成需要的传送门个数
	//处死战斗区所有玩家
});

  Instance.OnScriptInput("人数+1", (inputData) => {		//计算当前人数，若双方
  
});
let vsFightT = 0;		//t在场人数
let vsFightCT = 0;		//ct在场人数
let vsFightN = 1;		//对抗模式战斗人数
Instance.OnScriptInput("VS人数-1", (inputData) => {		
	const pawn = inputData.activator;
	if(pawn.GetTeamNumber() == 2){//2是T阵营，3是CT阵营
		vsFightT -= 1;
	} else{
		vsFightCT -= 1;
	}
	
	if(vsFightT ==0 || vsFightCT ==0){
		resetVsFight();
	}
	
});
Instance.OnScriptInput("VS人数计数", (inputData) => {
	const pawn = inputData.activator;
	if(pawn.GetTeamNumber() == 2){//2是T阵营，3是CT阵营
		vsFightT += 1;
	} else{
		vsFightCT += 1;
	}	
});

async function resetVsFight(){//计算剩余人数，若某方人数为0：战斗区传送触发器生效将玩家传送回起点、计算生成入场传送门个数、并重置人数、
//await Instance.Delay(0.5);	//；留出时间让触发器运行，统计人数

	//Instance.EntFireAtTarget({
	//target: Instance.FindEntityByName("VS人数计数"),
	//input: "enable"
	//});
	
............（代码未完成，不写了）
我总担忧出bug，之前那些别人图的1v1的bug的经历让我担忧，所以我采用方案二。
*/


//方案二：尽可能依靠脚本（脚本是主动触发更可控，还可以增加冗余减少出错。而实体是被动触发，一个环节出错，就卡死了），而且脚本一般不会很卡，因为技能释放都没卡。
const VsPosT = {position: Instance.FindEntityByName("1v1图T战斗位置").GetAbsOrigin(), angles: Instance.FindEntityByName("1v1图T战斗位置").GetAbsAngles() };
const VsPosCT = {position: Instance.FindEntityByName("1v1图CT战斗位置").GetAbsOrigin(), angles: Instance.FindEntityByName("1v1图CT战斗位置").GetAbsAngles() };
const mPosZ = Instance.FindEntityByName("1v1图高度中间位置").GetAbsOrigin().z;
let vsFightN = 1;		//对抗模式战斗人数
//函数入口。计算剩余人数，若某方人数为0：战斗区传送触发器生效将玩家传送回起点、计算生成T和CT入场传送门个数
Instance.OnScriptInput("VS人数-1", (inputData) => {
	let vsFightT = [];
	let vsFightCT = [];
	
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
    for (let controller of controllers) {				//遍历玩家控制器
        if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

        const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
        if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活
		
		const pawnZ = pawn.GetAbsOrigin().z;	//3.计算在场人数
		if(pawnZ < mPosZ){
			if(pawn.GetTeamNumber() == 2){//T阵营是2，CT阵营是3
				vsFightT.push(pawn);
			} else{
				vsFightCT.push(pawn);
			}
		}
    }
	//4.传送
	if(vsFightT.length == 0){//T没人了，开启传送
		for(let ct of vsFightCT){	//所有ct玩家回战斗位置，以免堵传送点
			ct.Teleport(VsPosCT);
		}
		
		for (let i = 0; i < vsFightN; i++) {		//生成指定人数个T传送门，送入战斗人数个T
			SpawnVsTeleport(2);
		}
		
		for (let j = 0; j < vsFightN - vsFightCT.length; j++) {		//生成指定人数个CT传送门，补齐战斗人数个CT
			SpawnVsTeleport(3);
		}
	}
	
	if(vsFightCT.length == 0){//CT没人了，开启传送
		for(let t of vsFightT){
			t.Teleport(VsPosT);
		}
		
		for (let i = 0; i < vsFightN; i++) {		//生成指定人数个CT传送门，送入战斗人数个CT
			SpawnVsTeleport(3);
		}
		
		for (let j = 0; j < vsFightN - vsFightT.length; j++) {		//生成指定人数个T传送门，补齐战斗人数个T
			SpawnVsTeleport(2);
		}
	}
});

function SpawnVsTeleport(t){

	//生成指定阵营的传送门
	const r = Math.floor(Math.random() * 5);	//随机取0~4
	let TeleportPosName;
	let FightPosName;
	if(2 == t){//T阵营是2，CT阵营是3
		TeleportPosName = `1v1T入场位置${r}`;
		FightPosName = VsPosT;
	} else{
		TeleportPosName = `1v1CT入场位置${r}`;
		FightPosName = VsPosCT;
	}
	const pos = Instance.FindEntityByName(TeleportPosName).GetAbsOrigin();
	const template = Instance.FindEntityByName("1v1入场传送门实例模板").ForceSpawn(pos);
	
	//触发器绑定回调函数
	const HandleTeleport = Instance.ConnectOutput(template[0], "OnStartTouch", (inputData) => {
		template[0].Kill();		//1v1入场传送门触发器实例
		template[1].Kill();		//1v1入场传送门特效实例
		template[2].Kill();		//1v1入场传送门地板实例
		template[3].Kill();		//1v1入场传送门文字实例
		
		const pawn = inputData.activator;	//玩家传送到战斗位
		pawn.Teleport(FightPosName);
	});
	
	//回调函数加入销毁队列，随便扔进一个玩家（第一个玩家）的回调销毁队列属性中
	const state = playerStates.values().next().value;		//获取map的第一个键对应元素的值。map对象.迭代器.下一个元素.值
	state.activeCallbacks.push(HandleTeleport);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
}


//对抗模式战斗人数设置
//设置文本显示战斗人数
const vsFightNSelect = [-1, 1];
vsFightNSelect.forEach(n => {
    Instance.OnScriptInput(`设置战斗人数${n}`, (inputData) => {
		const SetN = vsFightN + n;
		vsFightN = SetN;
		
		if (1 >= SetN) {
		vsFightN = 1;		//下限值
		}
		
		if (4 <= SetN) {
		vsFightN = 4;		//上限值
		}
		
		Instance.EntFireAtTarget({
		target: Instance.FindEntityByName("设置战斗人数文本"),
		input: "SetMessage",
		value: `战斗人数：${vsFightN}v${vsFightN}`
		});
    });
});
//入口函数，确认设置
Instance.OnScriptInput("确认设置战斗人数", (inputData) => {		
	//（空操作），尽管不需要确定，但是也必须通知所有玩家，所以必须要这么一个过程。
	Instance.ServerCommand(`say 1v1地图的战斗人数改为:${vsFightN}v${vsFightN}`);
});

