//游戏时间触发的入口函数（循环帧函数）
let TickIsEnabled = false;		//函数启用开关
const Tick_interval = 0.01;		//帧循环函数的间隔时间。可以设置为0，即为每帧都执行
function Tick() {
	
    Instance.SetNextThink(Instance.GetGameTime() + Tick_interval);// 维持 Think 循环（让闹钟一直响） ，设置下一次执行时间
	if (!TickIsEnabled) return;		//函数是否启用
/*
    for (let slot = 0; slot < 64; slot++) {
        const controller = Instance.GetPlayerController(slot);        // 1. 获取指定槽位的玩家控制器
        if (!controller) continue;

        const pawn = controller.GetPlayerPawn();       // 2. 获取玩家的实体 Pawn (肉体)
        if (!pawn || !pawn.IsAlive()) continue;        // 确保玩家存在且存活

        if (pawn.WasInputJustPressed(CSInputs.USE)) {
            const nextAllowedTime = playerCooldowns.get(slot) || 0;

            if (currentTime >= nextAllowedTime) {
                // 生成实体
                SpawnEntityInFrontOfPlayer(pawn);
                playerCooldowns.set(slot, currentTime + COOLDOWN_TIME);
            } else {
                // 显示 env_hudhint 提示
                //ShowHintToPlayer(pawn);		//已删除
				Instance.Msg("====冷却中====\n");
            }
        }
    }
	*/
	
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
    for (let controller of controllers) {				//遍历玩家控制器
        if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

        const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
        if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活

        if (pawn.WasInputJustPressed(CSInputs.USE)) {     // 检查玩家是否按下E键
			const playerId = controller.GetPlayerSlot();
            OnPlayerPressE(pawn, playerId); // 释放技能
        }
    }
	

}




//================技能基本函数相关========================================================================
// 普通实体生成,带偏移，在玩家的视角方向上指定距离处生成一个指定名称的实体，返回这个实体对象
function SpawnEntityInFrontOfPlayer_offset(pawn, template_name, SPAWN_DISTANCE, { offsetRight = 0, offsetUp = 0} = {}) {//玩家对象（得到生成位置），生成物模版名字，生成物与玩家的距离，距离偏移量

	const template = Instance.FindEntityByName(template_name);//确定生成物是哪一个
    if (!template) {
		Instance.Msg("无效的实体");
		return;
	}

    // 获取玩家头部位置和视角角度
    const eyePos = pawn.GetEyePosition();
    const angles = pawn.GetEyeAngles();


	// 1. 角度转弧度
    const DEG_TO_RAD = Math.PI / 180;
    const pitchRad = eyeAng.pitch * DEG_TO_RAD;
    const yawRad = eyeAng.yaw * DEG_TO_RAD;
    
    // 注：对于屏幕中心的平移偏移，Roll 不会改变 Forward/Right/Up 构成的投影平面位置
    // 如果你的需求包含 Roll 导致的画面倾斜偏移，需引入 Roll 参与基向量旋转
    
    // 2. 计算三角函数值
    const cosPitch = Math.cos(pitchRad);
    const sinPitch = Math.sin(pitchRad);
    const cosYaw = Math.cos(yawRad);
    const sinYaw = Math.sin(yawRad);

    // 3. 根据欧拉角计算局部坐标系的三个正交基向量 (Source Engine / 标准FPS约定)(Source 引擎坐标系：X前, Y左, Z上)
    // Forward: 视线正前方
    const fwdX = cosPitch * cosYaw;
    const fwdY = cosPitch * sinYaw;
    const fwdZ = -sinPitch; // Pitch 向上为正时，Z分量取负（视具体引擎而定）

    // Right: 视线右侧 (由 Forward 和 WorldUp(0,0,1) 叉乘得到)
    const rightX = sinYaw;
    const rightY = -cosYaw;
    const rightZ = 0;

    // Up: 视线上侧 (由 Right 和 Forward 叉乘得到)
    const upX = sinPitch * cosYaw;
    const upY = sinPitch * sinYaw;
    const upZ = cosPitch;

    // 4. 在世界坐标系中合成最终位置 (玩家眼睛位置 + 方向向量 * 距离)
    const spawnPos = {									
        x: eyePos.x + SPAWN_DISTANCE * fwdX + offsetRight * rightX + offsetUp * upX,
        y: eyePos.y + SPAWN_DISTANCE * fwdY + offsetRight * rightY + offsetUp * upY,
        z: eyePos.z + SPAWN_DISTANCE * fwdZ + offsetRight * rightZ + offsetUp * upZ
    };

    // 设定生成实体的角度 (我们让它和玩家面朝相同的方向，但保持水平)，
    //const spawnAngle = { pitch: 0, yaw: angles.yaw, roll: 0 };		//这是之前生成方块的角度
	const spawnAngle = {
        pitch: -angles.pitch,
        yaw: angles.yaw + 180, // 加 180 度物体正面朝着玩家眼睛（方便文字的方向正确）
        roll: 0
    };

    return template.ForceSpawn(spawnPos, spawnAngle);		//生成实例（位置，角度）
}


// 普通实体生成，不带偏移，在玩家的视角方向上指定距离处生成一个指定名称的实体，返回这个实体对象
function SpawnEntityInFrontOfPlayer(pawn, template_name, SPAWN_DISTANCE) {//玩家对象（得到生成位置），生成物模版名字，生成物与玩家的距离，距离偏移量

	const template = Instance.FindEntityByName(template_name);//确定生成物是哪一个
    if (!template) {
		Instance.Msg("无效的实体");
		return;
	}
	
    const eyePos = pawn.GetEyePosition();
    const angles = pawn.GetEyeAngles();

	// 1. 角度转弧度
    const pitch = angles.pitch * (Math.PI / 180);
    const yaw = angles.yaw * (Math.PI / 180);

	// Forward: 视线正前方
    const forwardX = Math.cos(yaw) * Math.cos(pitch);
    const forwardY = Math.sin(yaw) * Math.cos(pitch);
    const forwardZ = -Math.sin(pitch);

    const spawnPos = {									//生成位置
        x: eyePos.x + forwardX * SPAWN_DISTANCE,
        y: eyePos.y + forwardY * SPAWN_DISTANCE,
        z: eyePos.z + forwardZ * SPAWN_DISTANCE
    };

    // 设定生成实体的角度 (我们让它和玩家面朝相同的方向，但保持水平)，
    //const spawnAngle = { pitch: 0, yaw: angles.yaw, roll: 0 };		//这是之前生成方块的角度
	const spawnAngle = {
        pitch: -angles.pitch,
        yaw: angles.yaw + 180, // 加 180 度物体正面朝着玩家眼睛（方便文字的方向正确）
        roll: 0
    };

    return template.ForceSpawn(spawnPos, spawnAngle);		//生成实例（位置，角度）
}


//文字实体显示文字
async function textEntityShow(spawnedEntities, pawn, message = "显示的内容", displayTime = 1.2) {	//模版实体对象（不是直接的文字实体）,为文字实体设置个父级,显示文本内容,显示时间
	if (spawnedEntities && spawnedEntities.length > 0) {
		const textEntity = spawnedEntities[0];

		Instance.EntFireAtTarget({
		target: textEntity,
		input: "SetMessage",
		value: message
		});
		
		// 3. 将文字绑定给玩家 (跟随玩家移动)
		textEntity.SetParent(pawn);

		// 4. 1.2 秒后自动销毁该文字实体，防止留存在世界中
		//await Instance.Delay(displayTime);
		await Instance.Delay(displayTime);
		
		if (textEntity && textEntity.IsValid()) {
			textEntity.Remove();
		}
	}else {
        // 空实体
		Instance.Msg("文本显示失败：传入的实体是空实体");
    }
}






//在指定位置生成一个指定主人的手雷并立刻引爆，参数（位置，主人）
function DetonateMineWithGrenade(explodePosition, ownerPawn) {

    //Instance.Msg("==== 生成手雷 ====\n");
    // 依照 SpawnGrenadeProjectileConfigWithoutOwner 配置无主抛射物[cite: 1]
    let config = {
        position: explodePosition, // 必须提供 position[cite: 1]
        type: 0,     // 投掷物的类型，从 CSGrenadeType 枚举中选择 HE 或 FLASHBANG[cite: 1]
		thrower: ownerPawn      // 将该手雷与触发玩家绑定！
    };
    
    // 生成并获取 CSGrenadeProjectileBase 实体[cite: 1]
    let projectile = Instance.SpawnGrenadeProjectile(config);
    
    if (projectile) {
        // 调用底层的 Detonate() 方法瞬间引爆，自动触发官方完美的物理伤害与地形贴花[cite: 1]
        projectile.Detonate();
    }
}




//================游戏运行逻辑================================================================================
// 释放技能
const HUD_HINT_NAME = "实例文本模板"; // Hammer里，文本实体的模版实体的名字
function OnPlayerPressE(pawn, playerId) {
	//也可以仅通过playerId获取pawn。这个暂时就用传参，不通过playerId获取。
	//const controller = Instance.GetPlayerController(playerId);        // 1. 获取指定槽位的玩家控制器
	//const pawn = controller.GetPlayerPawn();       		// 2. 获取玩家的实体 Pawn (肉体)
	
	//或者也仅可以通过pawn获取playerId。
	//const controller = pawn.GetPlayerController();
	//const playerId = controller.GetPlayerSlot();
	
	//或者两个参数直接传进来（目前的做法）
    const currentTime = Instance.GetGameTime(); // 1. 获取当前游戏时间	
	let state = playerStates.get(playerId); 	//获取玩家状态
	
	let spawnedEntities;	//用于存放实体对象
	
	if (currentTime < state.cooldownEndTime) {	//核心判断一：是否冷却结束
		// 显示 HUD 提示
		const remaining = (state.cooldownEndTime - currentTime).toFixed(1);	//计算时间并四舍五入保留1位
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `冷却中: ${remaining} 秒`);			//显示文本实体
		return; //冷却时间未到，不执行后续的技能操作
    }
	
	if (0 >= state.remainingUses) {	//核心判断二：剩余次数是否大于0
		//hud文本提示，技能次数已用完

		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `已用完，技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		return; //技能次数已用完，不执行后续的技能操作
    }
	

	//技能类型，1==方块、2==地雷、3==TNT、4==医疗包、5==火箭筒、6==瞬移。"方块", "地雷", "TNT", "医疗包",  "瞬移"、手雷、护甲
	//可以实现，额外的伤害、传送回家、传送到最近的队友、起飞
	//未实验，侦测、变小、隐身、火焰喷射、自动恢复生命、 反伤、荆棘之甲
	//待研究，"火箭筒"、盾牌
	//其他技能：
	switch (state.skillType) {
	// 根据技能类型执行对应操作	
	case null:
		Instance.Msg("错误：玩家的技能未被记录");
	
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, "玩家未被记录（初始化出错）");			//显示文本实体
		
		return; // 未知技能直接退出，不扣次数
		break;
	case "空":
		// 空技能
		//ExecuteSkill_0(pawn, playerId);//空技能
		
		//shieldEntity();		//盾牌技能，待开发
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, "没有技能");			//显示文本实体
		
		state.cooldownEndTime = currentTime + 2;				
		return; // 未知技能直接退出，不扣次数
		break;
		
	case "方块":
		// 生成方块
		//ExecuteSkill_1(pawn, playerId);
		
		SpawnEntityInFrontOfPlayer(pawn, "实例方块模板", 100,);	//生成方块实体
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 1.2;
		break;
		
	case "地雷":

		SpawnMine(pawn, state);//处理生成操作
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `3秒后生效，快远离\n技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 3;
		break;
		
	case "TNT":
		//生成TNT，先引爆（第一次引爆由于没生成，调用空，就只做生成。第二次引爆成功），再生成（生成之前要判断，是否之前有过引爆（可以设置个技能锁），如果已有就不生成）
		//其实也可以不管。只不过第二次生成的，无法引爆，只能打爆。
		
		if (state.skillToggle == false){
			//未有TNT,执行生成TNT
			
			state.skillEnt = SpawnEntityInFrontOfPlayer(pawn, "实例TNT模板", 40)[0];	//生成tnt
			
			const triggerEnt_disC = SpawnEntityInFrontOfPlayer(pawn, "实例防碰撞触发器模板", 40)[0];	//生成防撞触发器	
			// 绑定 防模型碰撞触发器 输出给回调函数
			const Handle_C = Instance.ConnectOutput(triggerEnt_disC, "OnEndTouchAll", (inputData) => {
				//Instance.Msg("离开防撞触发器");
				Instance.EntFireAtTarget({
					target: state.skillEnt,
					input: "EnableCollision",
					});	
				Instance.DisconnectOutput(Handle_C);
			});
			state.activeCallbacks.push(Handle_C);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
			
			// 绑定 受到伤害 输出给回调函数
			const Handle_T = Instance.ConnectOutput(state.skillEnt, "OnTakeDamage", (inputData) => {
				DetonateTNT(pawn, state);
				state.skillToggle =false;
				
				state.remainingUses -= 1;	//技能使用次数减一
				Instance.DisconnectOutput(Handle_T);
				});
			state.activeCallbacks.push(Handle_T);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
			
			state.skillToggle =true;
			
			spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
			textEntityShow(spawnedEntities, pawn, `已生成，3秒后可主动触发\n技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		} else {
			//已有TNT,执行触发
				DetonateTNT(pawn, state);
				state.skillToggle =false;
				
				spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
				textEntityShow(spawnedEntities, pawn, `已触发引爆\n技能剩余: ${state.remainingUses} 次`);			//显示文本实体
			}
		state.cooldownEndTime = currentTime + 3;
		break;
		
	case "医疗包":
		//加血。声音效果是1秒+3秒。特效是5秒。所以就5秒加血时间。

		particleTreat(pawn, state);		//治疗动画特效
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `加血中，5秒后失效\n技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 10;
		break;
		
	case "瞬移":
		LineTeleport(pawn, 500);	//玩家角色向视角前方500距离处位置传送
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 2;
		break;
		
	case "手雷":
		pawn.GiveNamedItem("weapon_hegrenade");
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 5;
		break;
		
	case "护甲":
		pawn.SetHasHelmet(true);// 设置防弹头盔与防弹衣耐久为 300
		pawn.SetArmor(300);
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `护甲使用完毕，技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		//state.cooldownEndTime = currentTime + 2;//只能使用一次，所以，不需要设置冷却。
		break;

	case "火箭筒":
		//暂未实现
		Instance.Msg("技能暂未完成");
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `技能剩余: ${state.remainingUses} 次`);			//显示文本实体
		
		state.cooldownEndTime = currentTime + 2;
		break;
		
	//地图技能
	case "地图技能手雷":
		pawn.GiveNamedItem("weapon_hegrenade");
		state.cooldownEndTime = currentTime + 2;
		return; //地图技能直接退出，不扣次数
		break;
		
	case "地图技能燃烧瓶":
		pawn.GiveNamedItem("weapon_molotov");
		state.cooldownEndTime = currentTime + 2;
		return;
		break;
		
	case "地图技能诱饵弹":
		pawn.GiveNamedItem("weapon_decoy");
		state.cooldownEndTime = currentTime + 2;
		return;
		break;
		
	case "地图技能电击枪":
		pawn.GiveNamedItem("weapon_taser");
		state.cooldownEndTime = currentTime + 2;
		return;
		break;
	
	//被动技能
	case "夺命凶弹":
		if (state.skillToggle == false){
			state.skillToggle = true;
			spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
			textEntityShow(spawnedEntities, pawn, "暴击时显示文本");			//显示文本实体
		} else {
			state.skillToggle == false;
			spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
			textEntityShow(spawnedEntities, pawn, "暴击时不显示文本");			//显示文本实体
		}
		return;
		break;
	
	case "攻击之爪":	//可以写文本提示。累计基础伤害为xx，实际加成伤害为xx。
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, "被动技能，无需按E");			//显示文本实体
		return;
		break;
		
	default:
		//不能释放的技能
		
		spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, `${state.skillType}未知的技能`);			//显示文本实体
		
		return; // 未知技能直接退出，不扣次数
	}
	state.remainingUses -= 1;	//技能使用次数减一
}






//================技能释放相关=======================
//生成地雷。【M1：//async延迟函数的调用，并不会阻塞后续代码的运行。当调用async函数时，相当于告诉js，在未来执行await Instance.Delay(displayTime)之后的代码。并不是串行的延迟等待。】
async function SpawnMine(pawn, state) {	//
	const triggerEnt = SpawnEntityInFrontOfPlayer(pawn, "实例触发器模板", 30)[0];//生成模板实体,并把模板实体的[0]实体（触发器）取出。M1：生成一个模板实体是一个数组，分别对应模板实体的属性槽位的每个生成实体
	const mineEnt = SpawnEntityInFrontOfPlayer(pawn, "实例地雷模板", 30)[0];
	const triggerEnt_disC = SpawnEntityInFrontOfPlayer(pawn, "实例防碰撞触发器模板", 30)[0];
	const spawnPos = triggerEnt.GetAbsOrigin();		//确定生成位置
	const template = Instance.FindEntityByName("实例小焦痕模板");
	
	// 防模型碰撞触发器
	const Handle_C = Instance.ConnectOutput(triggerEnt_disC, "OnEndTouchAll", (inputData) => {
		Instance.EntFireAtTarget({
			target: mineEnt,
			input: "EnableCollision",
			});	
		Instance.DisconnectOutput(Handle_C);
	});
	state.activeCallbacks.push(Handle_C);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
	
	await Instance.Delay(3);//3秒后地雷生效。为了防止生成后，由于生成时玩家距离太近，立刻生成就会立刻爆炸。留时间让玩家远离。
	
	// 绑定 OnStartTouch 输出给回调函数
	const Handle_O = Instance.ConnectOutput(triggerEnt, "OnStartTouch", async (inputData) => {
		//let victimPawn = inputData.activator; // 踩到地雷的玩家
		// 在这里编写踩到后的逻辑（比如在 position 坐标引爆手雷）
		//Instance.Msg(`====被${victimPawn}触发了====\n`);
	
		//销毁方法一。也可以用EntFireAtTarget（测试过只管销毁没问题）
		//Instance.EntFireAtTarget({
		//target: triggerEnt,
		//input: "kill",
		//delay: 1
		//});
		
		//销毁方法二。也可以用triggerEnt.Remove();(测试过只管销毁没问题)
		//销毁方法三。也可以用triggerEnt.Kill();(测试过只管销毁没问题)
		triggerEnt.Kill();//移除触发器
		await Instance.Delay(0.5);//0.5秒后地雷爆炸	
		mineEnt.Kill();//移除模型
		
		DetonateMineWithGrenade(spawnPos,pawn);			//手雷生成并立刻爆炸并指定手雷拥有者
		template.ForceSpawn(spawnPos);		//焦痕生成模板（？位置，？角度），不需要获取实例	
		Instance.DisconnectOutput(Handle_O);
	});
	state.activeCallbacks.push(Handle_O);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
	
	// 绑定 受到伤害 输出给回调函数
	const Handle_D = Instance.ConnectOutput(mineEnt, "OnTakeDamage", (inputData) => {
		
		triggerEnt.Kill();
		mineEnt.Kill();//移除模型
		//await Instance.Delay(0.5);//0.5秒后地雷爆炸
		
		DetonateMineWithGrenade(spawnPos,pawn);			//手雷生成并立刻爆炸并指定手雷拥有者
		template.ForceSpawn(spawnPos);		//焦痕生成模板（？位置，？角度），不需要获取实例
		Instance.DisconnectOutput(Handle_D);
	});
	state.activeCallbacks.push(Handle_D);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存
}

//TNT爆炸
function DetonateTNT(ownerPawn, state) {
	
	const tntEntity = state.skillEnt;
	const spawnPos = tntEntity.GetAbsOrigin();		//确定生成位置
	tntEntity.Remove();
	
	const { x, y, z } = spawnPos;
	//const { x, y, z } =tntEntity.GetAbsOrigin();		//确定生成位置
	
    // 生成前后左右上下6个方向的局部变量
    //const front = { x: x + 100, y, z };       // X轴正方向（前）
    //const back = { x: x - 100, y, z };        // X轴负方向（后）
    //const right = { x, y: y + 100, z };       // Y轴正方向（右）
    //const left = { x, y: y - 100, z };        // Y轴负方向（左）
    //const up = { x, y, z: z + 100 };          // Z轴正方向（上）
    //const down = { x, y, z: z - 100 };        // Z轴负方向（下）
	//手雷生成并立刻爆炸并指定手雷拥有者
	
	const distance = 300;	//TNT杀伤半径 = 手雷杀死半径 + distance
	const distanceH = distance/2;
	DetonateMineWithGrenade({ x, y, z },ownerPawn);	
	DetonateMineWithGrenade({ x: x + distance, y, z },ownerPawn);	
	DetonateMineWithGrenade({ x: x - distance, y, z },ownerPawn);
	DetonateMineWithGrenade({ x, y: y + distance, z },ownerPawn);
	DetonateMineWithGrenade({ x, y: y - distance, z },ownerPawn);
	DetonateMineWithGrenade({ x, y, z: z + distance },ownerPawn);
	DetonateMineWithGrenade({ x, y, z: z - distance },ownerPawn);
	DetonateMineWithGrenade({ x: x + distanceH, y: y + distanceH, z: z + distanceH },ownerPawn);
	DetonateMineWithGrenade({ x: x - distanceH, y: y + distanceH, z: z + distanceH },ownerPawn);
	DetonateMineWithGrenade({ x, y: y - distanceH, z: z + distanceH },ownerPawn);
	DetonateMineWithGrenade({ x: x + distanceH, y: y - distanceH, z: z - distanceH },ownerPawn);
	DetonateMineWithGrenade({ x: x - distanceH, y: y - distanceH, z: z - distanceH },ownerPawn);
	DetonateMineWithGrenade({ x, y: y + distanceH, z: z - distanceH },ownerPawn);
	Instance.FindEntityByName("实例TNT爆炸模板").ForceSpawn(spawnPos);	
	Instance.FindEntityByName("实例大焦痕模板").ForceSpawn(spawnPos);
	Instance.FindEntityByName("实例硝烟模板").ForceSpawn(spawnPos);
}

//医疗包
async function particleTreat(pawn, state){
	
	state.skillEnt = SpawnEntityInFrontOfPlayer(pawn, "实例加血实体模板", 40)[0];	//生成治疗区域
	const spawnPos = state.skillEnt.GetAbsOrigin();		//获得位置
	
	//加血特效。声音效果是1秒+3秒。特效是5秒。所以就5秒加血时间。
	Instance.FindEntityByName("实例喷射模板").ForceSpawn(spawnPos);	
	Instance.FindEntityByName("实例加血开始模板").ForceSpawn(spawnPos);
	await Instance.Delay(1);
	
	Instance.FindEntityByName("实例加血中模板").ForceSpawn(spawnPos);
	await Instance.Delay(4);		//治疗结束
	
	state.skillEnt.Remove();
}


//瞬移
function LineTeleport(pawn, SPAWN_DISTANCE){
	
	const template1 = Instance.FindEntityByName("实例瞬移模板");
	const template2 = Instance.FindEntityByName("实例瞬移音效模板");
	//传送特效。名称：实例瞬移模板
	template1.ForceSpawn(pawn.GetAbsOrigin());
	template2.ForceSpawn(pawn.GetAbsOrigin());
	
    // 获取玩家头部位置和视角角度
    const eyePos = pawn.GetEyePosition();
    const angles = pawn.GetEyeAngles();

   // Source 引擎角度转弧度
    const pitch = angles.pitch * (Math.PI / 180);
    const yaw = angles.yaw * (Math.PI / 180);

    // 计算玩家正前方的方向向量 (Source 引擎坐标系：X前, Y左, Z上)
    const forwardX = Math.cos(yaw) * Math.cos(pitch);
    const forwardY = Math.sin(yaw) * Math.cos(pitch);
    const forwardZ = -Math.sin(pitch);

    // 计算最终的生成坐标 (玩家眼睛位置 + 方向向量 * 距离 + 偏移量)
    const spawnPos = {									
        x: eyePos.x + forwardX * SPAWN_DISTANCE,
        y: eyePos.y + forwardY * SPAWN_DISTANCE,
        z: eyePos.z + forwardZ * SPAWN_DISTANCE
    };
	
	template1.ForceSpawn(spawnPos);
	template2.ForceSpawn(spawnPos);	//生成特效
	//pawn.Move({		//两个API好像都是同一个效果
	pawn.Teleport({
		position: spawnPos
	});
	
	
	
}

//盾牌
//async function shieldEntity(pawn, EntityName){
function shieldEntity(){
	
	//（暂未实现）
	
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
    for (let controller of controllers) {				//遍历玩家控制器
        if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线

        const pawnA = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
        if (!pawnA || !pawnA.IsAlive()) continue;       // 确保玩家存在且存活
		
		
		const spawnedEntK = SpawnEntityInFrontOfPlayer(pawnA, "实例方块模板", 100)[0];
		const spawnedEntC = SpawnEntityInFrontOfPlayer(pawnA, "复制位置实例模板", 100)[0];
		

		Instance.EntFireAtTarget({
		target: spawnedEntC,
		input: "SetTarget",//SetTarget
		value: spawnedEntK
		});
		
		Instance.EntFireAtTarget({
		target: spawnedEntC,
		input: "SetMeasureTarget",
		value: pawnA
		});
		
		Instance.EntFireAtTarget({
		target: spawnedEntC,
		input: "Enable"
		});
		// 5 秒后自动销毁该实体，防止留存在世界中
		//await Instance.Delay(5);
	
		//if (spawnedEnt && spawnedEnt.IsValid()) {
		//spawnedEnt.Remove();
		//}
		
    }
}


// 注册玩家伤害修改回调
Instance.OnModifyPlayerDamage((event) => {
	
    // ----------------------------------------------------
    // 0. 基本对象属性
		//const baseDamage = event.damage;// 获取当前受击的原始伤害值
		//const attackerEnt = event.attacker;// 获取伤害的施加者，实体或玩家实体
		//const playerEnt = event.player;// 受到伤害的角色
    // ----------------------------------------------------	
	
	let Multiply = 1;//定义倍率变量
	let spawnedEntities;//用于存放文字实体
	
	if (TickIsEnabled) {	//技能是否启用。若没有启用技能就不需要每次都做无意义的操作，可以提高游戏性能。
		//Instance.Msg("调试：攻击到了");	
	
		if(event.player.GetClassName() == event.attacker.GetClassName()){		//由于伤害施加者可能不是玩家，所以会导致代码的API没有而报错，所以先判断是否是玩家造成的伤害
			//计算技能倍率
			const playerId = event.attacker.GetPlayerController().GetPlayerSlot();	//pawn -> Controller -> Slot
			const state = playerStates.get(playerId); 	//获取玩家状态
			
			switch (state.skillType) {
			// 根据技能类型执行对应操作	
			case "攻击之爪":
				Multiply += 0.2;
				break;
				
			case "夺命凶弹":
			//Instance.Msg("调试：技能到了");	
				const randD = Math.random(); // 生成 0~1 的随机数
				const pawn = event.attacker;
				if (randD < 1/3) {		//33%的概率
					Multiply += 2;
					if (state.skillToggle == true){	//显示文本的开关为开
					spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
					textEntityShow(spawnedEntities, pawn, "触发3倍伤害一次!");			//显示文本实体
					}
				}
				break;
				
			default:
				//其他的技能，不操作
			}
		}
	}
	
	//计算地图倍率（应该先计算技能倍率（因为是加法），再计算地图倍率（乘法））
	if(event.hitGroup != CSHitGroup.HEAD) {
		Multiply = Multiply * shotBodyDamageMultiply;
	}
	
	const baseDamage = event.damage;// 获取当前受击的原始伤害值
	return { damage: baseDamage * Multiply};	
	
	
//****************注释内容为示例代码********************
/*
    // ----------------------------------------------------
    // 1. 可以修改特定武器伤害（例如修改 AK47 伤害）
    // ----------------------------------------------------
	
	 if (event.weapon && event.weapon.GetClassName() === "weapon_ak47") {
        // 将 AK47 的基础伤害直接修改为 60（默认约为 36）
        return {damage: event.damage * 0.1 };
    }
	
	// ----------------------------------------------------
    // 2. 可以修改特定类型伤害（例如修没有摔伤）
    // ----------------------------------------------------
	
	if (event.damageTypes == CSDamageTypes.FALL) {
        // 摔伤
		Instance.Msg(`摔伤: ${event.damageTypes}`);
        return { abort: true };
    }
	
	// ----------------------------------------------------
    // 3. 可以修改特定位置伤害（例如爆头翻倍）
    // ----------------------------------------------------
	    if (event.hitGroup == CSHitGroup.HEAD) {
        // 爆头伤害：原伤害 * 2
		Instance.Msg(`爆头: ${event.hitGroup}`);
        return { damage: baseDamage * 3 };
    } else {
		Instance.Msg(`非爆头: ${event.hitGroup}`);
        return { damage: baseDamage * 0.1 };
    }
	

	// ----------------------------------------------------
    // 案例：允许造成伤害的武器类名白名单
    // ----------------------------------------------------
	const ALLOWED_WEAPONS = [
		"weapon_ak47",
		"weapon_knife",
		"weapon_usp_silencer"
	];
	if (event.weapon) {
		const weaponClassName = event.weapon.GetClassName();
		if (ALLOWED_WEAPONS.includes(weaponClassName)) {
			// 白名单内的武器正常造成伤害
			return;
		}
	}
	// 不在白名单内的武器伤害直接取消
	return { abort: true };
	
	
    // ----------------------------------------------------
    // 案例：允许造成伤害的武器类名白名单
    // ----------------------------------------------------
    if (event.damageTypes & CSDamageTypes.BLAST) {
        // 获取受击玩家与爆炸物（手雷实体）的位置
        const playerPos = event.player.GetAbsOrigin();
        const grenadePos = event.inflictor ? event.inflictor.GetAbsOrigin() : null;

        if (grenadePos) {
            // 计算玩家与手雷爆炸点的三维距离
            const dx = playerPos.x - grenadePos.x;
            const dy = playerPos.y - grenadePos.y;
            const dz = playerPos.z - grenadePos.z;
            const distance = Math.sqrt(dx * dx + dy * dy + dz * dz);

            // 自定义范围与伤害公式：
            // 假设我们想要扩展最大伤害半径为 600 单位，中心最高伤害为 150
            const maxRadius = 6000;
            const maxDamage = 1500;

            if (distance <= maxRadius) {
                // 线性衰减：距离越近伤害越高
                const customDamage = maxDamage * (1 - distance / maxRadius);
                return { damage: customDamage };
            } else {
                // 超出自定义范围则取消本次伤害
                return { abort: true };
            }
        }
    }
	
*/
});






//=====================================================地图关卡功能======================================
//下棋模块棋子相关
//黑白棋
let BlackWhiteToggle = 3;		//当前操作的阵营
Instance.OnScriptInput("黑白棋子被击中", (inputData) => {
    const chessEnt = inputData.caller;	//获取棋子实体
	const pawn = inputData.activator	//获取玩家
	const team = pawn.GetTeamNumber();	//获取玩家队伍	
    if (!chessEnt || !chessEnt.IsValid() || !team) {
        Instance.Msg("错误：无法获取击中的实体或玩家\n");
        return;
    }
	//Instance.Msg(`黑白棋子被击中${n}`);
	
	if (team != BlackWhiteToggle){
		const spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
		textEntityShow(spawnedEntities, pawn, "对手还未操作");			//显示文本实体
		return;	//不是自己的回合（对手还未下子），需等待对方操作，函数返回
		}
	
	
	const c = chessEnt.GetColor();
	if ({r: 0, g: 0, b: 0, a: 255} == c || {r: 255, g: 255, b: 255, a: 255} == c){
        return;  //该位置已经落子了，不能更改，函数返回
    }
	
	if (3 == team){
		chessEnt.SetColor({r: 0, g: 0, b: 0, a: 255});//棋子上色
		BlackWhiteToggle =2;		//切换下棋阵营为CT
	} else {
		chessEnt.SetColor({r: 255, g: 255, b: 255, a: 255});//棋子上色
		BlackWhiteToggle =3;		//切换下棋阵营为T
	}
});



//象棋
let activatedEntChess = null;//当前选中的象棋棋子
Instance.OnScriptInput("象棋棋子被击中", (inputData) => {
    const chessEnt = inputData.caller;	//获取棋子实体
	const team = inputData.activator.GetTeamNumber();	//获取玩家队伍	
    if (!chessEnt || !chessEnt.IsValid() || !team) {
        Instance.Msg("错误：无法获取击中的实体或玩家\n");
        return;
    }
	
	//Instance.Msg(`象棋棋子被击中${n}`);
	if (activatedEntChess && activatedEntChess.IsValid()) {		//棋子关掉之前旧的
		activatedEntChess.Unglow();
		activatedEntChess.SetColor({r: 255, g: 255, b: 255});
	}
	activatedEntChess = chessEnt;		//棋子设置当前新的
	
	
	if (2 == team){				//棋子上色标明操作阵营
		activatedEntChess.SetColor({r: 100, g: 0, b: 0});
	} else{
		activatedEntChess.SetColor({r: 0, g: 0, b: 100});
	}
	
	activatedEntChess.Glow();	//棋子高亮，显示被选中
});


