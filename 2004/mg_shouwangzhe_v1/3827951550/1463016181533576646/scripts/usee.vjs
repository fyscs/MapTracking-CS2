生成横向：${spawnEntQueue[4*3 + 1]}，竖向：${spawnEntQueue[4*3 + 2]}，随机角度：${spawnEntQueue[4*3 + 3]}，个箱子实体。
生成横向：${spawnEntQueue[4*4 + 1]}，竖向：${spawnEntQueue[4*4 + 2]}，随机角度：${spawnEntQueue[4*4 + 3]}，个加速板实体。
`		});//好像不用\n字符，代码中的回车字符也能够输入。而且代码前面的空格也会输入到字符串中
});
});


//生成地形
function spawnMapEntQueue (bound1, bound2) {
	// 预计算各轴的最小值和跨度，避免在循环中重复计算
    const minX = Math.floor(Math.min(bound1.x, bound2.x));
    const maxX = Math.floor(Math.max(bound1.x, bound2.x));
    const minY = Math.floor(Math.min(bound1.y, bound2.y));
    const maxY = Math.floor(Math.max(bound1.y, bound2.y));
    const minZ = Math.floor(Math.min(bound1.z, bound2.z));
    const maxZ = Math.floor(Math.max(bound1.z, bound2.z));
	
	//Instance.FindEntityByName("购买区实例模板").ForceSpawn(mapTspawn.position, mapTspawn.angles);
	const item = [Instance.FindEntityByName("墙实例模板"), Instance.FindEntityByName("透明墙实例模板"), Instance.FindEntityByName("梯子实例模板"), Instance.FindEntityByName("箱子实例模板"), Instance.FindEntityByName("加速板实例模板")];
	
	
	for (let i = 0; i < spawnEntTypeSelect.length; i++) {
		//生成横向
		for (let jh = 0; jh < spawnEntQueue[4*i + 1]; jh++) {
			item[i].ForceSpawn({
				x: Math.floor(Math.random() * (maxX - minX) + minX),
				y: Math.floor(Math.random() * (maxY - minY) + minY),
				z: Math.floor(Math.random() * (maxZ - minZ) + minZ)
				},{
				pitch: 0,
				yaw: 0,
				roll: 0
				});//俯仰、航向、横滚，pitch: y轴旋转; yaw: z轴旋转; roll: x轴旋转
		}
		
		//生成竖向
		for (let js = 0; js < spawnEntQueue[4*i + 2]; js++) {
			item[i].ForceSpawn({
				x: Math.floor(Math.random() * (maxX - minX) + minX),
				y: Math.floor(Math.random() * (maxY - minY) + minY),
				z: Math.floor(Math.random() * (maxZ - minZ) + minZ)
				},{
				pitch: 0,
				yaw: 90,
				roll: 0
				});//俯仰、航向、横滚，pitch: y轴旋转; yaw: z轴旋转; roll: x轴旋转
		}
		
		//生成随机角度
		for (let jr = 0; jr < spawnEntQueue[4*i + 3]; jr++) {
			item[i].ForceSpawn({
				x: Math.floor(Math.random() * (maxX - minX) + minX),
				y: Math.floor(Math.random() * (maxY - minY) + minY),
				z: Math.floor(Math.random() * (maxZ - minZ) + minZ)
				},{
				pitch: 0,
				yaw: Math.floor(Math.random() * 360),
				roll: 0
				});//俯仰、航向、横滚，pitch: y轴旋转; yaw: z轴旋转; roll: x轴旋转
		}
		
    }
	
}












