const WeaponRandomList = ["weapon_m4a1_silencer", "weapon_ak47", "weapon_famas", "weapon_galilar", "weapon_aug", "weapon_sg556", "weapon_m4a1", 	//步枪
							"weapon_awp", "weapon_ssg08", "weapon_g3sg1","weapon_scar20",  		//狙
							"weapon_mp9", "weapon_mac10", "weapon_bizon", "weapon_mp7", "weapon_ump45", "weapon_mp5sd", "weapon_p90", 	//冲锋枪
							"weapon_m249", "weapon_negev", 		//机枪
							"weapon_mag7", "weapon_sawedoff", "weapon_nova", "weapon_xm1014", 		//霰弹枪
							"weapon_usp_silencer", "weapon_cz75a", "weapon_hkp2000", "weapon_glock", "weapon_fiveseven", "weapon_tec9", "weapon_revolver", "weapon_deagle", "weapon_p250", "weapon_elite", //手枪
							"weapon_incgrenade", "weapon_molotov", "weapon_hegrenade", "weapon_flashbang", "weapon_smokegrenade", "weapon_decoy", "weapon_taser", "weapon_healthshot", "weapon_knife", //装备
							"初级卡池枪", "中级卡池枪", "高级卡池枪"
							];//玩家可以随机到的武器列表。另外，这个不知道是什么"weapon_tagrenade"
//自选武器触发器对应入口
WeaponRandomList.forEach(n => {
    Instance.OnScriptInput(`自选武器${n}`, (inputData) => {
		if(PlayerSelectWeapon(n, inputData.activator)){	//成功获取武器就传送，没有获取武器就不传送
			mapTeleportEnd(inputData.activator, "选枪区到出生点");	//传送
		}
    });
});

function PlayerSelectWeapon(n, pawn){
if(SelectWeaponListShare == false){
	let CSWeaponBase;
	switch (n) {
	//T武器
	case "weapon_ak47":		case "weapon_galilar":		case "weapon_sg556":
	case "weapon_g3sg1":
	case "weapon_mac10":		case "weapon_mp7":
	case "weapon_sawedoff":
	case "weapon_cz75a":		case "weapon_glock":		case "weapon_tec9":
		if(pawn.GetTeamNumber() != 2){
			const spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
			textEntityShow(spawnedEntities, pawn, "阵营共享武器未开启，不能发枪");			//显示文本实体
			return false;		//未开启共享武器，且触发器武器队伍与玩家时间队伍不一致，函数返回，不做发枪和传送操作
		}
		break;

	//CT武器
	case "weapon_m4a1_silencer":		case "weapon_famas":		case "weapon_aug":
	case "weapon_scar20":
	case "weapon_mp9":		case "weapon_bizon":
	case "weapon_mag7":
	case "weapon_usp_silencer":		case "weapon_hkp2000":		case "weapon_fiveseven":
		if(pawn.GetTeamNumber() != 3){
			const spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
			textEntityShow(spawnedEntities, pawn, "阵营共享武器未开启，不能发枪");			//显示文本实体
			return false;		//未开启共享武器，且触发器武器队伍与玩家时间队伍不一致，函数返回，不做发枪和传送操作
		}
		break;
	
	//通用武器，不做限制
	case "weapon_m4a1":
	case "weapon_awp":		case "weapon_ssg08":
	case "weapon_ump45":		case "weapon_mp5sd":		case "weapon_p90":
	case "weapon_nova":		case "weapon_xm1014":
	case "weapon_revolver":		case "weapon_deagle":		case "weapon_p250":		case "weapon_elite":
		break;
	
	//刀
	case "weapon_knife":
		//如果已经有刀，就不发，避免刷道具
		CSWeaponBase = pawn.FindWeaponBySlot(2);//2==KNIFE（刀槽位）
		if(CSWeaponBase){
			//Instance.Msg(`调试:发现玩家已经有刀 ${CSWeaponBase}`);
			return false;		
		}
		//pawn.GiveNamedItem("weapon_knife");	//获得基础武器刀。M1：必须在传送到出生点这一步才能发刀，否则可能中途（选枪区域）就开始刀战了
	
	//电击枪
	case "weapon_taser":
	//这里应该写个查看电击枪是否拥有，若已经拥有就不发放。但是我不知道如何查询玩家是否有电击枪，所以暂时就不写。
		break;	
		
	case "初级卡池枪":
		pawn.GiveNamedItem(WeaponRandomLow[Math.floor(Math.random() * WeaponRandomLow.length)]);
		return true;	
	case "中级卡池枪":
		pawn.GiveNamedItem(WeaponRandomMiddle[Math.floor(Math.random() * WeaponRandomMiddle.length)]);
		return true;	
	case "高级卡池枪":
		pawn.GiveNamedItem(WeaponRandomHigh[Math.floor(Math.random() * WeaponRandomHigh.length)]);
		return true;	
	
	//其他武器（例如，weapon_hegrenade），不做限制
	case "weapon_hegrenade":
		break;	
			
	default:
	Instance.ServerCommand("say 错误：未定义的自选武器操作");
	}
}
pawn.GiveNamedItem(n);	//发武器
return true;
}


//选择武器类型
const WeaponRandomLow = ["weapon_mp9", "weapon_mac10", "weapon_bizon", "weapon_ump45", "weapon_mp5sd", "weapon_mp7", "weapon_p90",		"weapon_mag7", "weapon_sawedoff", "weapon_nova", "weapon_xm1014"];//随机初级。稳中求胜。冲锋枪或霰弹枪
const WeaponRandomMiddle = ["weapon_ssg08",		"weapon_m4a1_silencer", "weapon_ak47", "weapon_famas", "weapon_galilar", "weapon_aug", "weapon_sg556", "weapon_m4a1",		"weapon_usp_silencer", "weapon_cz75a", "weapon_hkp2000", "weapon_glock", "weapon_fiveseven", "weapon_tec9", "weapon_revolver", "weapon_deagle", "weapon_p250", "weapon_elite"];//随机中级。小试一把。步枪或手枪
const WeaponRandomHigh = ["weapon_awp", "weapon_awp",	"weapon_g3sg1", "weapon_g3sg1", "weapon_scar20", "weapon_scar20",		"weapon_m249", "weapon_negev",		"weapon_incgrenade", "weapon_molotov", "weapon_hegrenade", "weapon_flashbang", "weapon_smokegrenade", "weapon_decoy", "weapon_taser", "weapon_healthshot", "weapon_knife",];//随机高级。险中求贵。连狙大狙、机枪、雷
const WeaponSelect = ["购买", "随机统一所有人", "随机统一团队", "随机个人", "卡池枪", "步枪", "冲锋枪", "霰弹枪", "手枪", "狙击枪", "手雷", "燃烧瓶", "诱饵弹", "电击枪", "刀"];//武器类型列表数组
WeaponSelect.forEach(n => {
    Instance.OnScriptInput(`武器为${n}`, (inputData) => {
	activeWeapon = n;
	Instance.ServerCommand(`say 玩家指定武器类型为:${activeWeapon}`);
    });
});

let activeMap = "随机";		//地图名称
let activeWeapon = "随机";	//武器名称
let mapTspawn = {position: Instance.FindEntityByName("原地对枪图T出生点").GetAbsOrigin(), angles: Instance.FindEntityByName("原地对枪图T出生点").GetAbsAngles() };	//对战地图（目标地图）出生点
let mapCTspawn = {position: Instance.FindEntityByName("原地对枪图CT出生点").GetAbsOrigin(), angles: Instance.FindEntityByName("原地对枪图CT出生点").GetAbsAngles() };
//地图：武器确定后再传送，武器：购买、随机个人、随机统一团队、随机统一所有人、指定类型、指定单独
async function mapTeleport(){
	
	//*************地图前置操作
	//某些地图强制确定武器类型、启用技能。M1：可以由地图确定武器、也可以反过来由武器确定地图，为了统一性，就：由地图强制设置武器。后续再武器强制设置技能。
	//需要一个swich，根据地图的不同，再二次强制确定武器
	//例如，1v1刀战图不能启用技能、kz图不能用武器、等。（待完成，暂时地图少，就不管，暂时没有地图的武器限制）
	
	//switch (activeMap) {
	//操作内容：强制切换武器
	//Instance.ServerCommand(`say 该地图有武器限制，已强制将武器选择为/随机选择为${activeWeapon});
	
	//武器确定了，就可以确定地形生成购买点。另外也同时也一起把生成物一起完成：加速板、掩体随机生成、
	//武器确定了，就可以确定强制设置技能，但是必须在传送完后，不会再选技能了，再初始化技能。所以，这部分内容留到传送操作后，switch (activeMap) （一次性的swich）
	//******************	
	
	//总结为
	//一，落实随机地图和随机武器，由地图强制设置武器
	//二，遍历性操作。传送、发枪、传送完后设置技能。
	//三，一次性操作。提示消息（技能强制更改）、生成地图实体（购买点、加速板、掩体）、打开技能
	
	
	//一，落实地图和武器
	//1，随机地图落实具体地图
	if(activeMap == "随机"){
		activeMap = mapSelect[Math.floor(Math.random() * mapSelect.length)];
		Instance.ServerCommand(`say 随机选择地图：${activeMap}，3秒后立刻传送`);
	} else{
		Instance.ServerCommand(`say 玩家已选择地图：${activeMap}，3秒后立刻传送`);
	}
			
	//确定地图出生点

	mapTspawn = {position: Instance.FindEntityByName(`${activeMap}图T出生点`).GetAbsOrigin(), angles: Instance.FindEntityByName(`${activeMap}图T出生点`).GetAbsAngles() };
	mapCTspawn = {position: Instance.FindEntityByName(`${activeMap}图CT出生点`).GetAbsOrigin(), angles: Instance.FindEntityByName(`${activeMap}图CT出生点`).GetAbsAngles() };	
	//出生点生成房间，出生点玻璃房间实例模板（输入“Break”）
	
	const startRoom = Instance.FindEntityByName("出生点玻璃房间实例模板");
	const startRoomT = startRoom.ForceSpawn(mapTspawn.position, mapTspawn.angles)[0];
	const startRoomCT = startRoom.ForceSpawn(mapCTspawn.position, mapCTspawn.angles)[0];
	
	//2，随机武器类型落实具体武器类型
	await Instance.Delay(1);		//聊天框不能瞬间发消息，必须要间隔时间。
	Instance.Msg("调试：延迟1返回了");		
			
	if(activeWeapon == "随机"){
		activeWeapon = WeaponSelect[Math.floor(Math.random() * WeaponSelect.length)];
		Instance.ServerCommand(`say 随机武器类型已确定为：${activeWeapon}`);
	}	

	//3，强制更改武器
	//（暂不操作）
			
	await Instance.Delay(3);		//留出时间，让选图的玩家选择技能
		Instance.Msg("调试：延迟3返回了")
		
	//二，遍历性操作。传送、发枪、传送完后设置技能。
	
	const allPersonWeapon1 = WeaponRandomList[Math.floor(Math.random() * WeaponRandomList.length)];
	const allPersonWeapon2 = WeaponRandomList[Math.floor(Math.random() * WeaponRandomList.length)];	
	let controllers = Instance.GetAllPlayerControllers();	        // 1. 获取所有的玩家控制器
	for (let controller of controllers) {				//遍历玩家控制器
		if (!controller || !controller.IsConnected()) continue;       // 确保玩家在线
		const pawn = controller.GetPlayerPawn();      // 2. 获取玩家的实体 Pawn (肉体)
		if (!pawn || !pawn.IsAlive()) continue;       // 确保玩家存在且存活

		//mapTeleportOption(pawn, allPersonWeapon1, allPersonWeapon2);
		switch (activeWeapon) {
		case "随机统一所有人":
			mapTeleportEnd(pawn);		//玩家传送到地图
			pawn.GiveNamedItem(allPersonWeapon1);
			break;
			
		case "随机统一团队":
			mapTeleportEnd(pawn);		//玩家传送到地图
			if(pawn.GetTeamNumber() == 2){//2是T阵营，3是CT阵营
				pawn.GiveNamedItem(allPersonWeapon1);	//T获得武器
			} else{
				pawn.GiveNamedItem(allPersonWeapon2);	//CT获得武器
			}
			break;
			
		case "随机个人":
			mapTeleportEnd(pawn);		//玩家传送到地图
			pawn.GiveNamedItem(WeaponRandomList[Math.floor(Math.random() * WeaponRandomList.length)]);	//获得随机武器
			break;
			
		case "步枪":	//传送到选择区
			MapTeleportMid(pawn, "步枪");
			break;
			
		case "冲锋枪":
			MapTeleportMid(pawn, "冲锋枪");
			break;
			
		case "霰弹枪":
			MapTeleportMid(pawn, "霰弹枪");
			break;
			
		case "手枪":
			MapTeleportMid(pawn, "手枪");
			break;
			
		case "狙击枪":
			MapTeleportMid(pawn, "狙击枪");
			break;
			
		case "卡池枪":
			MapTeleportMid(pawn, "卡池枪");
			break;
		
		//以下地图玩法不用发枪
		case "购买":
		case "刀":
			mapTeleportEnd(pawn);		//玩家传送到地图
			break;
			
		case "手雷":
			mapTeleportEnd(pawn);		//玩家传送到地图
			setMapSkill(pawn, controller, "地图技能手雷")	//技能拿雷
			break;
		case "燃烧瓶":
			mapTeleportEnd(pawn);
			setMapSkill(pawn, controller, "地图技能燃烧瓶")
			break;
		case "诱饵弹":
			mapTeleportEnd(pawn);
			setMapSkill(pawn, controller, "地图技能诱饵弹")
			break;
		case "电击枪":
			mapTeleportEnd(pawn);
			setMapSkill(pawn, controller, "地图技能电击枪")
			break;
			
		default:
			Instance.Msg(`[Warning]未知的武器类型: ${activeWeapon}，无法完成分配武器操作`);
		}

	}
	
	//三，传送完成后。操作地图生成、最后启用技能。
	
	mapSpawnEnt();//生成地图实体。武器获取的实体、掩体的实体、设置技能
	await Instance.Delay(2.3); //延迟时间应该>2，setMapSkill()延迟或mapSpawnEnt()延迟=1或1，再+聊天框冷却1 ==2。作用1：让玩家看到实体生成的过程。作用2：等待mapSpawnEnt()执行完成（其中有延迟函数）
			Instance.Msg("调试：延迟2.3返回了")
			
	//所有玩家已经传送完毕（不会更改技能了）、根据特定地图指定技能类型已设置完成（自动设置技能已完成），此时可以启用技能了。
	if(skillEnabled == true){
		TickIsEnabled = true;
		Instance.Msg("====技能释放已打开====");
		Instance.ServerCommand("say 技能释放已打开");
	}

	//破坏出生点房间。出生点房间是为了防止玩家在延迟时间时进入生成物区域被卡住
	//Instance.EntFireAtTarget({
	//target: Instance.FindEntityByName("出生点房间kill按钮"),
	//input: "Press"
	//});
	Instance.EntFireAtTarget({
		target: startRoomT,
		input: "Break"
	});
	Instance.EntFireAtTarget({
		target: startRoomCT,
		input: "Break"
	});
	
}

//设置玩家地图技能
async function setMapSkill(pawn, controller, MapSkillName){
	
	await Instance.Delay(1); //延迟时间，确保玩家传送完成后，离开了手动选择技能的区域，再设置技能。（若不延迟，可能会出现离开手动选择技能的区域时和设置技能时在同一帧内。）
	
	const slot = controller.GetPlayerSlot();
    if (!playerStates.has(slot)) { // 如果该 slot 还没有状态对象，先初始化一个默认对象
        playerStates.set(slot, createPlayerState());
    }
	//resetAllPlayerStates();//注意：其实应该初始化玩家的技能，但目前只设置技能释放就行，对整体无影响。但若后期要添加丰富游戏内容，可能会出现bug，所以这里提前告知
	
    //设置技能类型
    const state = playerStates.get(slot);
    state.skillType = MapSkillName;	//设置技能类型值
	//SetResetPlayerStates(slot);		//设置该技能类型的其余数据。提示：可以通过设置技能属性，也同样完成初始化。
	
    //Instance.Msg(`[SkillSelect] 玩家 slot=${slot} 已选择技能${MapSkillName}\n`);
	const spawnedEntities = SpawnEntityInFrontOfPlayer(pawn, HUD_HINT_NAME, 10);	//生成文本实体
	textEntityShow(spawnedEntities, pawn, `你技能是: ${state.skillType}`, 5);			//显示文本实体
}


//传送玩家到中间选枪区域
function MapTeleportMid(pawn, weaponTypeName){		
	
	if(pawn.GetTeamNumber() == 2){//2是T阵营，3是CT阵营
		const mapMidT = Instance.FindEntityByName(`选择${weaponTypeName}图T传送点`);
		pawn.Teleport({
		position: mapMidT.GetAbsOrigin(),
		angles: mapMidT.GetAbsAngles()
		});
	} else{
		const mapMidCT = Instance.FindEntityByName(`选择${weaponTypeName}图CT传送点`);
		pawn.Teleport({
		position: mapMidCT.GetAbsOrigin(),
		angles: mapMidCT.GetAbsAngles()
		});
	}	
}

//传送指定玩家到出生点
function mapTeleportEnd(pawn, type = "一般传送"){

	if(activeMap == "原地对枪" && type == "一般传送"){		//MO：其实可以在“原点对枪”也设立一个传送点，这样就不需要这个判断了。但是这样会失去一些随机枪的乐趣，所以，就不设立传送点了，只有类型选枪后才会传送到原地传送点。又由于类型选枪后需要传送点，若不要这个判断会导致选枪后无法传送，所以就需要在地图中再多加一个传送触发器。
		return;		//也就是：原点对枪，不传送。MO：若是选枪中间图，拿到枪后，原地对枪需要传送【OO*UA&：不考虑在选枪中间图对枪，因为，选枪区域地图太简陋】
	}
	
	if(pawn.GetTeamNumber() == 2){//2是T阵营，3是CT阵营
			pawn.Teleport(mapTspawn);
		} else{
			pawn.Teleport(mapCTspawn);
	}
	PlayerSelectWeapon("weapon_knife", pawn);	//发刀
}

//地图生成实体
let HandleBuyPointT;		//购买点实体，记录用于销毁
let HandleBuyPointCT;
async function mapSpawnEnt(){
	
	//生成地形实体
	switch (activeMap) {
	case "超级塔对枪":
	case "村庄对枪":
	case "随机地形对枪":
		spawnMapEntQueue (Instance.FindEntityByName(`${activeMap}图边界1`).GetAbsOrigin(), Instance.FindEntityByName(`${activeMap}图边界2`).GetAbsOrigin());	
		break;			
	case "投掷物对战":
		const rotatingEnt = Instance.FindEntityByName("投掷物转盘挡板轴");
		if(rotatingEnt){
			Instance.EntFireAtTarget({
			target: rotatingEnt,
			input: "Start"		//开始旋转
			});			
		}
		break;	
	default:
		//Instance.Msg(`当前地图${activeMap}，不执行地形生成操作`);
	}

	//生成出生点实体
	if(activeMap != "1v1"){		//某些地图太小，不能生成加速板。另外，其实可以把地图放大，就可以生成了。但是实体，太多懒得动了。直接加个不生成的代码。
		if(spawnPushEnt){	//只生成加速板。
			Instance.FindEntityByName("加速板实例模板").ForceSpawn(mapTspawn.position, mapTspawn.angles);
			Instance.FindEntityByName("加速板实例模板").ForceSpawn(mapCTspawn.position, mapCTspawn.angles);	
		} else if(spawnTaserPushEnt){	//生成电击枪，还要生成加速板。
			Instance.FindEntityByName("加速板实例模板").ForceSpawn(mapTspawn.position, mapTspawn.angles);
			Instance.FindEntityByName("加速板实例模板").ForceSpawn(mapCTspawn.position, mapCTspawn.angles);	
			
			const templateT = Instance.FindEntityByName("电击枪触发器实例模板").ForceSpawn(mapTspawn.position, mapTspawn.angles);
			const templateCT = Instance.FindEntityByName("电击枪触发器实例模板").ForceSpawn(mapCTspawn.position, mapCTspawn.angles);
			
			//触发器绑定回调函数
			const HandleTriggerT = Instance.ConnectOutput(templateT[0], "OnEndTouch", (inputData) => {
				PlayerSelectWeapon("weapon_taser", inputData.activator);	//玩家获取电击枪
			});
			//回调函数加入销毁队列，随便扔进一个玩家（第一个玩家）的回调销毁队列属性中
			const state = playerStates.values().next().value;		//获取map的第一个键对应元素的值。map对象.迭代器.下一个元素.值
			state.activeCallbacks.push(HandleTriggerT);	//加入销毁队列，游戏结束后销毁该实体，避免永久占用游戏内存	
			
			const HandleTriggerCT = Instance.ConnectOutput(templateCT[0], "OnEndTouch", (inputData) => {
				PlayerSelectWeapon("weapon_taser", inputData.activator);
			});
			state.activeCallbacks.push(HandleTriggerCT);	
		}		
	}

	
	//生成出生点实体
	switch (activeWeapon) {
	case "购买":		//在传送点生成购买区域
		HandleBuyPointT = Instance.FindEntityByName("购买区实例模板").ForceSpawn(mapTspawn.position, mapTspawn.angles)[0];
		HandleBuyPointCT = Instance.FindEntityByName("购买区实例模板").ForceSpawn(mapCTspawn.position, mapCTspawn.angles)[0];//如果需要，可以设置T和CT不同的购买区
		
		//测试发现，购买点实体不同于一般实体，购买点实体不会回合结束后自动删除，所以需要手动删除。
		//Instance.EntFireAtTarget({
		//	target: HandleBuyPointT,
		//	input: "Kill",
		//	delay: 40
		//});		//不能在这里删除，因为可能游戏结束了，但延迟未到使得删除没有执行，所以需要在初始化中删除。
		break;
	
	case "诱饵弹":
	    HealthMax = 1;
		SetHealthMax();
		Instance.ServerCommand("say 砸人击杀玩法：强制将所有玩家生命值设置为1");
		await Instance.Delay(1); //聊天框不能瞬间发消息，必须要间隔时间。
	case "手雷":
	case "燃烧瓶":
	case "电击枪":
		Instance.ServerCommand("say 投掷物玩法：强制将所有玩家技能设置为获得投掷物");
		skillEnabled = true;//====技能释放打开====

		break;	
	case "随机统一所有人":
	case "随机统一团队":
	case "随机个人":
	case "步枪":		
	case "冲锋枪":
	case "霰弹枪":
	case "手枪":
	case "狙击枪":
		break;
		
	default:
		//Instance.Msg(`[Warning]未知的武器类型: ${activeWeapon}，无法完成地图生成实体操作`);
	}
	


	//草稿：接口名称。
	//.、电击枪触发器实例模板、加速板实例模板[0,1]=[加速板触发器实例, 加速板模型实例]、出生点玻璃房间实例模板（输入“Break”）、、购买区实例模板
	//.、
}


