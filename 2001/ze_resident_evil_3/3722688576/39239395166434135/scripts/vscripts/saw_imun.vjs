// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

const IMMUNITY_FILTER = "Zombies_Ignore";
const IMMUNITY_DURATION = 5;
const immunePlayers = new Map();

function resetImmunity(pawn) {
    if (pawn && pawn.IsValid()) {
        Instance.EntFireAtTarget({
            target: pawn,
            input: "SetDamageFilter",
            value: ""
        });
    }
}

Instance.OnScriptInput("GiveImmunity", ({ activator }) => {
    if (!activator || !activator.IsValid())
        return;

    const controller = activator.GetPlayerController();
    if (!controller)
        return;

    const pawn = controller.GetPlayerPawn();
    if (!pawn || !pawn.IsValid())
        return;

    const slot = controller.GetPlayerSlot();

    if (immunePlayers.has(slot))
        return;

    Instance.EntFireAtTarget({
        target: pawn,
        input: "SetDamageFilter",
        value: IMMUNITY_FILTER
    });

    immunePlayers.set(slot, {
        pawn,
        endTime: Instance.GetGameTime() + IMMUNITY_DURATION
    });
});

Instance.SetThink(() => {
    const now = Instance.GetGameTime();

    for (const [slot, data] of immunePlayers) {
        if (now < data.endTime)
            continue;

        resetImmunity(data.pawn);
        immunePlayers.delete(slot);
    }

    Instance.SetNextThink(now + 0.05);
});

Instance.OnPlayerReset((event) => {
    const player = event.player;

    if (!player?.IsValid())
        return;

    const player_controller = player.GetPlayerController();
    if (!player_controller)
        return;

    const player_slot = player_controller.GetPlayerSlot();

    player.SetColor({ r: 255, g: 255, b: 255, a: 255 });

    Instance.EntFireAtTarget({
        target: player,
        input: "SetDamageFilter"
    });

    immunePlayers.delete(player_slot);

    player.SetEntityName("player_" + player_slot);
});

Instance.SetNextThink(Instance.GetGameTime());