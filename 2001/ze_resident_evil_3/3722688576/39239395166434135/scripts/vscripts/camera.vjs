// Generated by StarDance
// https://github.com/Kxnrl

import {
    CustomCameraMode,
    Instance as I,
    CSInputs
} from "cs_script/point_script";

function vec(x, y, z) {
    return { x, y, z };
}

const playerCameras = new Map();

const CAMERA_OFFSET_RIGHT = vec(-45, -20, 0); // camera offset right side 
const CAMERA_OFFSET_LEFT = vec(-45, 20, 0); // camera offset left side

const TEAM_CT = 3;
//const TEAM_T = 2;

let thinkRegistered = false; // tick

function isCT(player) {
    return player.GetTeamNumber() === TEAM_CT; // working only ct side
}

function applyCamera(player, data) {
    if (!player?.IsValid() || !data?.camera?.IsValid()) return;

    data.camera.SetFollowConfig({
        followEntity: data.pawn,
        clipCameraOffset: true,
        cameraOffset: data.left
            ? CAMERA_OFFSET_LEFT
            : CAMERA_OFFSET_RIGHT,
        followEyes: true
    });

    data.camera.SetMode(CustomCameraMode.FOLLOW_POSITION);
}

function enableCamera(player) {
    if (!player?.IsValid() || !player.IsConnected()) return;
    if (!isCT(player)) return;

    const pawn = player.GetPlayerPawn();
    if (!pawn?.IsValid()) return;

    const camera = pawn.GetCustomCamera();
    if (!camera) return;

    const data = {
        player,
        pawn,
        camera,
        left: false,
        comboWasPressed: false
    };

    playerCameras.set(player.GetPlayerSlot(), data);

    applyCamera(player, data);

    if (!thinkRegistered) {
        thinkRegistered = true;
        I.SetThink(updateAll);
        I.SetNextThink(I.GetGameTime() + 0.016);
    }
}

function disableCamera(playerSlot) {
    const data = playerCameras.get(playerSlot);
    if (!data) return;

    if (data.camera?.IsValid()) {
        data.camera.SetMode(CustomCameraMode.DISABLED);
    }

    playerCameras.delete(playerSlot);

    if (playerCameras.size === 0) {
        thinkRegistered = false;
    }
}

function switchCameraSide(player) {
    const slot = player.GetPlayerSlot();
    const data = playerCameras.get(slot);

    if (!data) return;
    if (!isCT(player)) {
        disableCamera(slot);
        return;
    }

    data.left = !data.left;

    applyCamera(player, data);
}

function updateAll() {
    for (const [slot, data] of playerCameras) {

        if (!data.player?.IsValid() || !data.player.IsConnected()) {
            disableCamera(slot);
            continue;
        }

        if (!isCT(data.player)) {
            disableCamera(slot);
            continue;
        }

        const pawn = data.player.GetPlayerPawn();

        if (!pawn?.IsValid() || !pawn.IsAlive()) {
            continue;
        }

        data.pawn = pawn;

        const attack2Pressed =
            pawn.IsInputPressed(CSInputs.ATTACK2);

        const lookAtPressed =
            pawn.IsInputPressed(CSInputs.LOOK_AT_WEAPON);

        const comboPressed =
            attack2Pressed && lookAtPressed;

        if (comboPressed && !data.comboWasPressed) {
            switchCameraSide(data.player);
        }

        data.comboWasPressed = comboPressed;
    }

    if (playerCameras.size > 0) {
        I.SetNextThink(I.GetGameTime() + 0.016);
    } else {
        thinkRegistered = false;
    }
}

I.OnPlayerChat(({ player, text }) => {
    if (!player?.IsValid()) return;

    const command = text.toLowerCase().trim();
    const slot = player.GetPlayerSlot();

    if (command === "!p3" || command === "/p3") {
        enableCamera(player);
        return;
    }

    if (command === "!p1" || command === "/p1") {
        disableCamera(slot);
    }
});

I.OnPlayerKill(({ player: pawn }) => {
    if (!pawn?.IsValid()) return;

    const player = pawn.GetPlayerController();
    if (!player?.IsValid()) return;

    disableCamera(player.GetPlayerSlot());
});

I.OnPlayerReset(({ player: pawn }) => {
    if (!pawn?.IsValid()) return;

    const player = pawn.GetPlayerController();
    if (!player?.IsValid()) return;

    const slot = player.GetPlayerSlot();

    if (!isCT(player)) {
        disableCamera(slot);
        return;
    }

    const data = playerCameras.get(slot);

    if (!data) return;

    const camera = pawn.GetCustomCamera();
    if (!camera) return;

    data.pawn = pawn;
    data.camera = camera;
    data.comboWasPressed = false;

    applyCamera(player, data);
});

I.OnPlayerDisconnect(({ playerSlot }) => {
    disableCamera(playerSlot);
});

I.OnRoundStart(() => {
    for (const slot of [...playerCameras.keys()]) {
        disableCamera(slot);
    }
});

I.Msg("Camera loaded");