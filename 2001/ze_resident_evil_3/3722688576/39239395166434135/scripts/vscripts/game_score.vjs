import { Instance } from "cs_script/point_script";

Instance.OnScriptInput("CT_Add100", (x) => {
    const pawn = x.activator;
    if (!pawn?.IsValid()) return;

    if (pawn.GetTeamNumber() === 3) {
        pawn.GetPlayerController()?.AddScore(100);
    }
});

