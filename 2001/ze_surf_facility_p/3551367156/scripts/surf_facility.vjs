import { Instance, Entities, CSPlayerPawn } from 'cs_script/point_script';

let soundevent = undefined;
Instance.OnRoundStart(() => {
    soundevent = Entities.FindByName("boost_sound")[0];
});
Instance.OnScriptInput("PlaySound", ({ activator }) => {
    if (!(activator instanceof CSPlayerPawn))
        return;
    soundevent.FireInput({ input: "StartSoundOnSingleClient", value: activator.GetPlayerController().GetPlayerSlot() });
});
