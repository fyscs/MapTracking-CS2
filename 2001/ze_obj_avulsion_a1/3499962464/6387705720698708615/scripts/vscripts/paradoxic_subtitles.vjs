let playbackGeneration = 0;
let isPlaying = false;

function getHud() {
    return Instance.FindEntityByName(HUD_ENTITY_NAME);
}

function getTitleHud() {
    return Instance.FindEntityByName(TITLE_HUD_ENTITY_NAME);
}

function setSubtitle(hud, text, visible) {
    if (!hud) {
        return;
    }

    const showParadoxic = visible && text === PARADOXIC_TEXT;
    const showMixedParadoxic = visible && text === MIXED_PARADOXIC_TEXT;
    const showStandard = visible && !showParadoxic && !showMixedParadoxic;

    hud.SetHasClass(STANDARD_CAPTION_ID, VISIBLE_CLASS, showStandard);
    hud.SetHasClass(PARADOXIC_CAPTION_ID, VISIBLE_CLASS, showParadoxic);
    hud.SetHasClass(MIXED_PARADOXIC_CAPTION_ID, VISIBLE_CLASS, showMixedParadoxic);
    hud.SetDialogVariableString(LABEL_ID, "subtitle", text);
    hud.SetHasClass(PANEL_ID, ACTIVE_CLASS, visible);
}

function showTitle(hud, text, isByline) {
    if (!hud) {
        return;
    }

    hud.SetDialogVariableString(TITLE_LABEL_ID, "title", text);
    hud.SetHasClass(TITLE_LABEL_ID, BYLINE_CLASS, isByline);
    hud.SetHasClass(TITLE_PANEL_ID, ACTIVE_CLASS, true);
}

function hideTitle(hud, clearText) {
    if (!hud) {
        return;
    }

    hud.SetHasClass(TITLE_PANEL_ID, ACTIVE_CLASS, false);
    if (clearText) {
        hud.SetDialogVariableString(TITLE_LABEL_ID, "title", "");
        hud.SetHasClass(TITLE_LABEL_ID, BYLINE_CLASS, false);
    }
}

async function playTitleSequence(generation) {
    const hud = getTitleHud();
    if (!hud) {
        return;
    }

    hideTitle(hud, true);
    await Instance.Delay(TITLE_START_DELAY);
    if (generation !== playbackGeneration) {
        return;
    }

    showTitle(hud, MAIN_TITLE_TEXT, false);
    await Instance.Delay(TITLE_HOLD_DURATION);
    if (generation !== playbackGeneration) {
        return;
    }

    hideTitle(hud, false);
    await Instance.Delay(TITLE_TRANSITION_DURATION);
    if (generation !== playbackGeneration) {
        return;
    }

    showTitle(hud, BYLINE_TEXT, true);
    await Instance.Delay(TITLE_HOLD_DURATION);
    if (generation !== playbackGeneration) {
        return;
    }

    hideTitle(hud, false);
    await Instance.Delay(TITLE_TRANSITION_DURATION);
    if (generation === playbackGeneration) {
        hideTitle(hud, true);
    }
}

async function playCaptions(generation) {
    const hud = getHud();
    if (!hud) {
        isPlaying = false;
        return;
    }

    let elapsed = 0.0;
    setSubtitle(hud, "", false);

    for (const caption of CAPTIONS) {
        await Instance.Delay(Math.max(0.0, caption.start - elapsed));
        if (generation !== playbackGeneration) {
            return;
        }

        setSubtitle(hud, caption.text, true);
        await Instance.Delay(Math.max(0.0, caption.end - caption.start));
        if (generation !== playbackGeneration) {
            return;
        }

        setSubtitle(hud, "", false);
        elapsed = caption.end;
    }

    await Instance.Delay(Math.max(0.0, 310.68 - elapsed));
    if (generation === playbackGeneration) {
        setSubtitle(hud, "", false);
        isPlaying = false;
    }
}

function startParadoxic() {
    if (isPlaying) {
        return;
    }

    isPlaying = true;
    playbackGeneration += 1;
    const generation = playbackGeneration;

    Instance.EntFireAtName({
        name: SOUND_ENTITY_NAME,
        input: "StartSound",
    });

    void playTitleSequence(generation);
    void playCaptions(generation);
}

function stopParadoxic() {
    // Invalidate every pending Delay continuation from the current playback.
    playbackGeneration += 1;
    isPlaying = false;

    const hud = getHud();
    setSubtitle(hud, "", false);

    const titleHud = getTitleHud();
    hideTitle(titleHud, true);

    Instance.EntFireAtName({
        name: SOUND_ENTITY_NAME,
        input: "StopSound",
    });
}

