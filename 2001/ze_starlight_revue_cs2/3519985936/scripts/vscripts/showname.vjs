import { Instance } from "cs_script/point_script";

Instance.OnScriptInput("showName", (context) => {
    const player = context.activator;
    if (!player || !player.IsValid())
        return;
    Instance.ServerCommand("say "+player.GetPlayerController().GetPlayerName()+"成为了Top☆Star");
    Instance.EntFireAtName({ name: "name_show_hud", input: "SetMessage", value: player.GetPlayerController().GetPlayerName()+"成为了Top☆Star" });
    Instance.EntFireAtName({ name: "name_show_trigger", input: "Enable" });
});