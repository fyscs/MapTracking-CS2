.diddle-laser-hud {
    width: 100%;
    height: 100%;
}
.diddle-laser-inner {
    width: 100%;
    height: 100%;
    flow-children: none;
    margin-top: 20%;
}
.diddle-laser-text {
    font-family: "Stratum 2";
    font-size: 48px;
    font-weight: bold;
    color: #ffae00;
    width: 100%;
    text-align: center;
    horizontal-align: center;
    vertical-align: center;
    text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
}
.hidden {
    visibility: collapse;
