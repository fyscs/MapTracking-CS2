.diddle-area-hud {
    width: 100%;
    height: 100%;
}
.diddle-area-inner {
    width: 100%;
    height: 100%;
    flow-children: none;
    margin-bottom: 40%;
}
.diddle-area-text {
    font-family: "Stratum 2";
    font-size: 52px;
    font-weight: bold;
    color: #00FF00;
    text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
    width: 100%;
    text-align: center;
    horizontal-align: center;
    vertical-align: center;
}
.hidden {
    visibility: collapse;
}
