.diddle-coins-hud {
    horizontal-align: left;
    vertical-align: top;
    margin-left: 18%;
    margin-top: 12%;
    width: 360px;
    height: 50px;
}
.diddle-coins-inner {
    width: 100%;
    height: 100%;
    flow-children: none;
}
.diddle-coins-text {
    font-family: "Stratum 2";
    font-size: 52px;
    font-weight: bold;
    color: #ffd700;
    text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
    margin-bottom: 2px;
}
.hidden {
    visibility: collapse;
}
