// Generated by StarDance
// https://github.com/Kxnrl

import { Console, Entity, Instance } from "cs_script/point_script";

const CONFIG = {
    MAX_PTP_ACTIVATE_DISTANCE: 2000,
    MIN_PTP_ACTIVATE_DISTANCE: 300,
    MIN_ZOMBIE_COUNT: 5,
    RESPAWN_DELAY_ADDITION_PER_RATE: 5,
    RESPAWN_DELAY_ADDITION_PER_ZOMBIE: 0.3,
    RESPAWN_DELAY_BASE: 1,
    ZOMBAT_RESPAWN_DELAY: 1,
}

let mainTaskId = 0;
/** @type {Entity[]} */
let allPtps = [];
/** @type {Entity[]} */
let activatePtps = [];
let isZombat = false;
let isZombatInfinity = false;
let zombatDelayTaskId = 0;

Instance.OnScriptInput("Activate", () => {
    allPtps = Instance.FindEntitiesByName("m*_zombie_spawn_ptp_cs2_ze");
    mainTaskId = Delay(0, Main);
});

Instance.OnScriptInput("Spawn", (inputData) => {
    const player = inputData.activator;
    if (!player || !player.IsValid()) return;
    if (activatePtps.length === 0) throw "暂无可用ptp";
    const ptp = activatePtps[Math.floor(Math.random() * activatePtps.length)];
    Instance.EntFireAtTarget({ target: ptp, input: "Teleport", activator: player });
});

Instance.OnScriptInput("Zombat(10)", () => Zombat(10));
Instance.OnScriptInput("Zombat(15)", () => Zombat(15));

/**
 * 尸潮
 * @param {number} duration 
 */
function Zombat(duration) {
    if (isZombat) {
        RescheduleDelay(zombatDelayTaskId, duration);
        return;
    }
    isZombat = true;
    if (!isZombatInfinity) {
        Instance.EntFireAtName({ name: "bgm_mobincoming", input: "StartSound" });
        Instance.EntFireAtName({ name: "sound_control_script", input: "RunScriptInput", value: "StartSoundZombat", delay: 1 });
    }
    zombatDelayTaskId = Delay(duration, () => {
        isZombat = false;
        if (!isZombatInfinity) Instance.EntFireAtName({ name: "bgm_zombat_fadeout", input: "FireUser1", delay: 1 });
    });
}

Instance.OnScriptInput("ZombatOn", () => {
    isZombatInfinity = true;
    if (!isZombat) {
        Instance.EntFireAtName({ name: "bgm_mobincoming", input: "StartSound" });
        Instance.EntFireAtName({ name: "sound_control_script", input: "RunScriptInput", value: "StartSoundZombat", delay: 1 });
    }
});

Instance.OnScriptInput("ZombatOnNoBgm", () => {
    isZombatInfinity = true;
    if (!isZombat) {
        Instance.EntFireAtName({ name: "bgm_mobincoming", input: "StartSound" });
    }
});

Instance.OnScriptInput("ZombatOff", () => {
    isZombatInfinity = false;
    if (!isZombat) Instance.EntFireAtName({ name: "bgm_zombat_fadeout", input: "FireUser1", delay: 1 });
});

Instance.OnRoundStart(() => {
    CancelDelay(mainTaskId);
    CancelDelay(zombatDelayTaskId);
    allPtps.length = 0;
    activatePtps.length = 0;
    isZombat = false;
    isZombatInfinity = false;
});

function Main() {
    GetActivatePtps();
    ApplyRespawnDelay();
    mainTaskId = Delay(1 / 2, Main);
}

/**
 * 设置僵尸复活间隔
 */
function ApplyRespawnDelay() {
    if (isZombatInfinity || isZombat) {
        Console.ServerCommand("zr_respawn_delay " + CONFIG.ZOMBAT_RESPAWN_DELAY);
        return;
    }
    let zombieCount = 0;
    let playerCount = 0;
    for (const player of Instance.FindEntitiesByClass("player")) {
        if (!player.IsValid()) continue;
        playerCount++;
        if (player.GetTeamNumber() !== 2) continue;
        zombieCount++;
    }
    if (playerCount === 0 || zombieCount === 0) return;
    const respawnDelay = Math.round(zombieCount / playerCount * CONFIG.RESPAWN_DELAY_ADDITION_PER_RATE + zombieCount * CONFIG.RESPAWN_DELAY_ADDITION_PER_ZOMBIE + CONFIG.RESPAWN_DELAY_BASE);
    Console.ServerCommand("zr_respawn_delay " + respawnDelay);
}

/**
 * 获取活跃Ptp实体
 */
function GetActivatePtps() {
    activatePtps.length = 0;
    const minSqr = CONFIG.MIN_PTP_ACTIVATE_DISTANCE ** 2;
    const maxSqr = CONFIG.MAX_PTP_ACTIVATE_DISTANCE ** 2;
    if (allPtps.length === 0) return;
    const ptpData = allPtps.map(ptp => ({ ptp, pos: ptp.GetAbsOrigin() }));
    const minDistSqr = new Map();
    const checkedPlayers = Instance.FindEntitiesByClass("player");
    while (checkedPlayers.length !== 0) {
        const player = checkedPlayers.pop();
        if (!player || !player.IsValid() || !player.IsAlive() || player.GetTeamNumber() !== 3) continue;
        const playerPos = player.GetAbsOrigin();
        for (const { ptp, pos } of ptpData) {
            const cur = minDistSqr.get(ptp);
            if (cur !== undefined && cur < minSqr) continue;
            const d = DistanceSqr(pos, playerPos);
            if (cur === undefined || d < cur) minDistSqr.set(ptp, d);
        }
    }
    for (const [ptp, d] of minDistSqr) {
        if (d >= minSqr && d < maxSqr) activatePtps.push(ptp);
    }
}

/**
 * 计算两点之间距离的平方（性能优化）
 * @param {import("cs_script/point_script").Vector} v1 - 第一个点
 * @param {import("cs_script/point_script").Vector} v2 - 第二个点
 * @returns {number} 距离的平方
 */
function DistanceSqr(v1, v2) {
    const dx = v1.x - v2.x;
    const dy = v1.y - v2.y;
    const dz = v1.z - v2.z;
    return dx * dx + dy * dy + dz * dz;
}

/** @type {{ id: number, time: number, callback: () => void }[]} */
const thinkQueue = [];
/** @type {Map<number, { id: number, time: number, callback: () => void }>} */
const taskMap = new Map();
let nextTaskId = 1;

/**
 * 延迟执行函数
 * @param {number} delaySeconds 延迟的秒数
 * @param {() => void} callback 回调函数
 * @returns {number} 任务ID，可用于取消或重新调度
 */
function Delay(delaySeconds, callback) {
    const executeTime = Instance.GetGameTime() + delaySeconds;
    return QueueThink(executeTime, callback);
}

/**
 * 将think任务加入队列
 * @param {number} time 执行时间
 * @param {() => void} callback 回调函数
 * @returns {number} 任务ID
 */
function QueueThink(time, callback) {
    const id = nextTaskId++;
    const task = { id, time, callback };

    // 查找插入位置（按时间升序）
    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= time) {
            insertIndex = i + 1;
            break;
        }
    }

    // 插入任务并记录
    thinkQueue.splice(insertIndex, 0, task);
    taskMap.set(id, task);

    // 如果新任务是最早的，则更新think
    if (insertIndex === 0) {
        Instance.SetNextThink(time);
    }

    return id;
}

/**
 * 取消指定ID的延迟任务（若尚未执行）
 * @param {number} taskId 任务ID
 */
function CancelDelay(taskId) {
    const task = taskMap.get(taskId);
    if (!task) return; // 任务不存在或已执行/取消

    // 从数组中移除
    const index = thinkQueue.indexOf(task);
    if (index !== -1) {
        thinkQueue.splice(index, 1);
    }
    taskMap.delete(taskId);

    // 如果移除的是队首任务，需要重新设置下一次think
    if (index === 0) {
        if (thinkQueue.length > 0) {
            Instance.SetNextThink(thinkQueue[0].time);
        }
    }
}

/**
 * 重新设置未执行任务的新延迟时间（从当前游戏时间开始计算）
 * @param {number} taskId 任务ID
 * @param {number} newDelaySeconds 新的延迟秒数
 * @returns {boolean} 是否修改成功（任务存在且未执行）
 */
function RescheduleDelay(taskId, newDelaySeconds) {
    const task = taskMap.get(taskId);
    if (!task) return false;

    const newTime = Instance.GetGameTime() + newDelaySeconds;

    // 如果时间没有变化，直接返回
    if (task.time === newTime) return true;

    // 先从队列中移除
    const index = thinkQueue.indexOf(task);
    if (index === -1) return false; // 理论上不会发生
    thinkQueue.splice(index, 1);

    // 更新时间
    task.time = newTime;

    // 按新时间重新插入到正确位置
    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= newTime) {
            insertIndex = i + 1;
            break;
        }
    }
    thinkQueue.splice(insertIndex, 0, task);

    // 更新下一次think时间（只要队列不为空就重新设置最早时间）
    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }

    return true;
}

/**
 * Think循环处理函数
 */
function RunThinkQueue() {
    const currentTime = Instance.GetGameTime();

    // 执行所有到期的任务
    while (thinkQueue.length > 0 && thinkQueue[0].time <= currentTime) {
        const task = thinkQueue.shift();
        if (!task) return;
        taskMap.delete(task.id); // 清理映射
        try {
            task.callback();
        } catch (e) {
            // 避免回调异常中断队列处理
        }
    }

    // 更新下一次think
    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }
}

// 设置Think循环
Instance.SetThink(RunThinkQueue);

/**
 * 创建一个循环延时任务
 * @param {number} times 总执行次数（必须 >= 1）
 * @param {number} intervalSeconds 每次执行的间隔秒数
 * @param {(current: number) => void} callback 每次执行时的回调，参数 current 表示当前是第几次执行（从 1 开始）
 * @returns {{ cancel: () => void, getRemaining: () => number }}
 */
function RepeatDelay(times, intervalSeconds, callback) {
    if (times <= 0) {
        return { cancel: () => { }, getRemaining: () => 0 };
    }

    let remaining = times;
    let currentTaskId = 0;
    let cancelled = false;

    const run = () => {
        if (cancelled) return;

        const current = times - remaining + 1;
        try {
            callback(current);
        } catch (e) {
            // 吞掉异常，避免中断后续循环
        }

        remaining--;
        if (remaining > 0 && !cancelled) {
            // 安排下一次执行
            currentTaskId = Delay(intervalSeconds, run);
        } else {
            currentTaskId = 0;
        }
    };

    // 第一次执行：等待 intervalSeconds 后触发
    currentTaskId = Delay(intervalSeconds, run);

    return {
        /**
         * 取消整个循环任务（包括尚未执行的后续任务）
         */
        cancel: () => {
            cancelled = true;
            if (currentTaskId !== 0) {
                CancelDelay(currentTaskId);
                currentTaskId = 0;
            }
        },
        /**
         * 获取剩余未执行的次数
         */
        getRemaining: () => remaining,
    };
}