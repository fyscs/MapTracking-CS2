// Generated by StarDance
// https://github.com/Kxnrl

import { Console, Instance } from "cs_script/point_script";

const CONFIG = {
    CHECKPOINT_OPEN_SPEED_BASE: 1,
    CHECKPOINT_OPEN_SPEED_PER_HUMAN: 0.2,
    CHECKPOINT_OPEN_MAX_SCHEDULE: 200
}

let checkpointOpenSchedule = 0;
let checkpointZoneHumans = new Set();
let isCheckpointOpenScheduleRunning = false;

Instance.OnRoundStart(() => {
    checkpointOpenSchedule = 0;
    checkpointZoneHumans.clear();
    isCheckpointOpenScheduleRunning = false;
});

Instance.OnScriptInput("DetectWin", () => {
    const target1 = Instance.FindEntityByName("human_win_detect_target1_cs2_ze");
    if (!target1 || !target1) throw "错误：目标点丢失";
    const target2 = Instance.FindEntityByName("human_win_detect_target2_cs2_ze");
    if (!target2 || !target2) throw "错误：目标点丢失";
    const pos1 = target1.GetAbsOrigin();
    const pos2 = target2.GetAbsOrigin();
    const players = Instance.FindEntitiesByClass("player");
    let zombies = [];
    for (const player of players) {
        if (!player.IsValid() || !player.IsAlive()) continue;
        if (player.GetTeamNumber() === 3) {
            if (!IsPointInBox(player.GetAbsOrigin(), pos1, pos2)) return;
        } else if (player.GetTeamNumber() === 2) {
            zombies.push(player);
        }
    }
    for (const player of zombies) {
        player.Kill();
    }
    Console.ServerCommand("say **我们安全了，暂时......**");
    Instance.EntFireAtName({ name: "zr_toggle_respawn", input: "Disable" });
    Instance.EntFireAtName({ name: "human_win_detect_trigger_cs2_ze", input: "Kill" });
    Instance.EntFireAtName({ name: "checkpoint_door_cs2", input: "Close" });
    Instance.EntFireAtName({ name: "bgm_checkpoint", input: "StartSound" });
    Instance.EntFireAtName({ name: "stage_manager_script", input: "RunScriptInput", value: "Next" });
});

Instance.OnScriptInput("EnterCheckpointZone", (inputData) => {
    const player = inputData.activator;
    if (!player || !player.IsValid()) return;
    checkpointZoneHumans.add(player);
});

Instance.OnScriptInput("LeaveCheckpointZone", (inputData) => {
    const player = inputData.activator;
    if (!player || !player.IsValid()) return;
    checkpointZoneHumans.delete(player);
});

Instance.OnScriptInput("StartCheckpointOpenSchedule", () => {
    if (isCheckpointOpenScheduleRunning) throw "开门任务正在进行，请勿重复开启";
    isCheckpointOpenScheduleRunning = true;
    Instance.SetNextThink(Instance.GetGameTime());
});

Instance.SetThink(() => {
    if (!isCheckpointOpenScheduleRunning) return;
    const checkpointZoneHumanCount = checkpointZoneHumans.size;
    const checkpointOpenSpeed = checkpointZoneHumanCount !== 0 ? CONFIG.CHECKPOINT_OPEN_SPEED_BASE + checkpointZoneHumanCount * CONFIG.CHECKPOINT_OPEN_SPEED_PER_HUMAN : 0;
    checkpointOpenSchedule += checkpointOpenSpeed;
    const bar = GetProgressBar(checkpointOpenSchedule, CONFIG.CHECKPOINT_OPEN_MAX_SCHEDULE, 30, "|", "-");
    Instance.EntFireAtName({ name: "human_checkpoint_detect_hud", input: "SetMessage", value: `安全屋开启进度\n[${bar}]` });
    for (const player of checkpointZoneHumans) {
        if (!player.IsValid()) {
            checkpointZoneHumans.delete(player);
            continue;
        }
        Instance.EntFireAtName({ name: "human_checkpoint_detect_hud", input: "ShowHudHint", activator: player });
    }
    if (checkpointOpenSchedule >= CONFIG.CHECKPOINT_OPEN_MAX_SCHEDULE) {
        Instance.EntFireAtName({ name: "checkpoint_door_cs2", input: "Open" });
        Console.ServerCommand("say **安全屋已开启**");
        isCheckpointOpenScheduleRunning = false;
        return;
    }
    Instance.SetNextThink(Instance.GetGameTime() + 1);
});

/**
 * 判断一个点是否在由两个对角点定义的轴对齐正六面体（AABB）内（含边界）
 * @param {import("cs_script/point_script").Vector} point 待检测的点
 * @param {import("cs_script/point_script").Vector} a 第一个对角点
 * @param {import("cs_script/point_script").Vector} b 第二个对角点
 * @returns {boolean}
 */
function IsPointInBox(point, a, b) {
    const minX = Math.min(a.x, b.x), maxX = Math.max(a.x, b.x);
    const minY = Math.min(a.y, b.y), maxY = Math.max(a.y, b.y);
    const minZ = Math.min(a.z, b.z), maxZ = Math.max(a.z, b.z);

    return point.x >= minX && point.x <= maxX &&
           point.y >= minY && point.y <= maxY &&
           point.z >= minZ && point.z <= maxZ;
}

/**
 * 生成抽象进度条
 * @param {number} value 当前值（0 ≤ value ≤ max）
 * @param {number} max 最大值（> 0）
 * @param {number} totalBars 进度条总格子数（正整数）
 * @param {string} fillChar 填充字符
 * @param {string|undefined} emptyChar 填空字符
 * @returns {string} 进度条字符串
 */
function GetProgressBar(value, max, totalBars, fillChar, emptyChar = undefined) {

    // 计算填充比例并限制在 [0, totalBars] 之间
    const filled = Math.min(totalBars, Math.max(0, Math.round((value / max) * totalBars)));

    if (emptyChar) {
        // 生成实心和空心部分
        return fillChar.repeat(filled) + emptyChar.repeat(totalBars - filled);
    } else {
        return fillChar.repeat(filled);
    }
}