// Generated by StarDance
// https://github.com/Kxnrl

import { Console, Instance, Entities } from "cs_script/point_script";

/**
 * 关卡管理系统
 * 此脚本由皮皮猫233编写
 * 2026/10/22
 */

// ============================================================
// 配置
// ============================================================

const stageList = ["highway", "fairgrounds", "coaster", "barns", "concert"];

/**
 * 检测位置对象
 * @typedef {Object} DetectPosition
 * @property {Object.<string, import("cs_script/point_script").Vector>} start
 * @property {Object.<string, import("cs_script/point_script").Vector>} end
 */

/** @type {DetectPosition} */
const detectPosition = {
    start: {
        highway: { x: 10716, y: 7908, z: -540 },
        fairgrounds: { x: 1621, y: 2786, z: 5 },
        coaster: { x: 4144, y: 2040, z: -63 },
        barns: { x: 3176, y: 3632, z: -184 },
        concert: { x: -960, y: 2200, z: -255 }
    },
    end: {
        highway: { x: 10716, y: 7908, z: -545 },
        fairgrounds: { x: 1621, y: 2786, z: 0 },
        coaster: { x: 4144, y: 2040, z: -65 },
        barns: { x: 3176, y: 3632, z: -189 },
        concert: { x: -960, y: 2200, z: -257 }
    }
};

// ============================================================
// 模块级状态
// ============================================================

let currentStageIndex = 0;
let enableChatCommand = false;
let autoReloadSwitch = false;

// ============================================================
// 回合取消机制
// ============================================================

let roundToken = 0;

/** @typedef {{ reject: (e: Error) => void }} DelayEntry */

/**
 * @typedef {Object} DelayHandle
 * @property {Promise<void>} promise
 * @property {() => void} cancel
 * @property {Promise<void>["then"]} then
 * @property {Promise<void>["catch"]} catch
 * @property {Promise<void>["finally"]} finally
 */

/** @type {Set<DelayEntry>} */
const pendingDelays = new Set();

class CancelledError extends Error {
    constructor() {
        super("cancelled");
        this.name = "CancelledError";
    }
}

function CancelPendingDelays() {
    for (const entry of pendingDelays) entry.reject(new CancelledError());
    pendingDelays.clear();
    thinkQueue.length = 0;
}

// ============================================================
// 脚本输入
// ============================================================

Instance.OnScriptInput("c2m1", () => { currentStageIndex = 0; Console.ServerCommand("mp_restartgame 1"); });
Instance.OnScriptInput("c2m2", () => { currentStageIndex = 1; Console.ServerCommand("mp_restartgame 1"); });
Instance.OnScriptInput("c2m3", () => { currentStageIndex = 2; Console.ServerCommand("mp_restartgame 1"); });
Instance.OnScriptInput("c2m4", () => { currentStageIndex = 3; Console.ServerCommand("mp_restartgame 1"); });
Instance.OnScriptInput("c2m5", () => { currentStageIndex = 4; Console.ServerCommand("mp_restartgame 1"); });

Instance.OnScriptInput("Next", () => {
    // if (currentStageIndex < stageList.length - 1) currentStageIndex++;
    if (currentStageIndex < 2) currentStageIndex++;
    else currentStageIndex = 0;
});

Instance.OnScriptInput("StartTeleport", (inputData) => {
    const player = inputData.activator;
    if (!player || !player.IsValid()) return;
    Entities.FireInput({ name: `m${currentStageIndex + 1}_start_tp_case_cs2_ze`, input: "PickRandomShuffle", activator: player });
});

// ============================================================
// 聊天命令
// ============================================================

Instance.OnPlayerChat((event) => {
    if (autoReloadSwitch === true && event.text === "!unreload") {
        Delay(1, () => Console.ServerCommand("say **已关闭自动重载功能**"));
        autoReloadSwitch = false;
    }

    if (!enableChatCommand) return;

    if (event.text === "!reload") {
        Delay(1, () => Console.ServerCommand("say **已开启自动重载功能**"));
        autoReloadSwitch = true;
        enableChatCommand = false;
    }
});

// ============================================================
// 回合生命周期
// ============================================================

Instance.OnRoundStart(() => {
    roundToken++;
    CancelPendingDelays();

    const token = roundToken;
    const stage = stageList[currentStageIndex];
    if (!stage) {
        throw "[StageFlow] 无效的关卡索引:" + currentStageIndex;
    }

    RunStageFlow(stage, token).catch((e) => {
        if (e instanceof CancelledError) return;
    });
});

Instance.OnRoundEnd(() => {
    roundToken++;
    CancelPendingDelays();
});

// ============================================================
// 主流程
// ============================================================

/**
 * 完整流程：卸载其它关卡 → 加载当前关卡 → 初始化
 * @param {string} stage
 * @param {number} token
 */
async function RunStageFlow(stage, token) {
    await PlayerDetect(token);
    await UnloadOtherStages(stage, token);
    await LoadStage(stage, token);
    StageInit(stage);
}

/**
 * 加载前检测是否存在实际玩家
 * 防止空服进人回合立即重启导致卡加载
 * @param {number} token
 */
async function PlayerDetect(token) {
    while (true) {
        const players = Entities.FindByClass("player");
        for (const player of players) {
            if (player?.IsValid()) return;
        }
        await DelayAsync(1, token);
    }
}

/**
 * 卸载除目标关卡外的所有关卡
 * @param {string} targetStage
 * @param {number} token
 * @returns {Promise<void>}
 */
async function UnloadOtherStages(targetStage, token) {
    let didUnloadAny = false;

    for (const stage of stageList) {
        if (stage === targetStage) continue;
        if (await UnloadOneStage(stage, token)) didUnloadAny = true;
    }

    if (didUnloadAny) {
        await DelayAsync(5, token);
    }
}

/**
 * 卸载单个关卡
 * @param {string} stage
 * @param {number} token
 * @returns {Promise<boolean>} 是否进行过重试
 */
async function UnloadOneStage(stage, token) {
    if (IsUnloaded(stage)) return false;

    Entities.FireInput({
        name: "LoadVpk_loadunload_*_" + stage,
        input: "StartSpawnGroupUnload"
    });

    for (let i = 1; i < 10; i++) {
        await DelayAsync(1, token);
        if (IsUnloaded(stage)) return true;
    }

    Console.ServerCommand("say **部分关卡卸载超时，正在跳过卸载该关卡**");
    return true;
}

/**
 * 加载当前关卡
 * @param {string} stage
 * @param {number} token
 * @returns {Promise<void>}
 */
async function LoadStage(stage, token) {
    let detectedTimes = 0;

    while (true) {
        if (IsLoaded(stage)) {
            if (detectedTimes === 0) return;
            await DelayAsync(5, token);
            return;
        }

        if (detectedTimes === 0) {
            Console.ServerCommand("say **正在加载地图，加载时间可能较长，请耐心等待**");
            Entities.FireInput({
                name: "LoadVpk_loadunload_*_" + stage,
                input: "StartSpawnGroupLoad"
            });
        }

        if (detectedTimes < 30) {
            detectedTimes++;
        } else if (autoReloadSwitch) {
            detectedTimes = 0;
            Console.ServerCommand("say **正在尝试重新加载**");
        } else {
            detectedTimes = 25;
            Console.ServerCommand('say **当前关卡加载时间过长，请耐心等待或输入"!reload"开启自动重载功能**');
            enableChatCommand = true;
        }

        await DelayAsync(1, token);
    }
}

// ============================================================
// 检测辅助
// ============================================================

/**
 * @param {string} stage
 * @returns {boolean}
 */
function IsLoaded(stage) {
    const entity = Entities.FindByName(`m${stageList.indexOf(stage) + 1}_start_tp_case_cs2_ze`)[0];
    if (!entity || !entity.IsValid()) return false;

    const allEntities = Entities.FindByName("");
    const result = Instance.TraceLine({
        start: detectPosition.start[stage],
        end: detectPosition.end[stage],
        ignoreEntity: allEntities,
        ignorePlayers: true
    });
    return !!result.didHit && !!result.hitEntity?.IsWorld();
}

/**
 * @param {string} stage
 * @returns {boolean}
 */
function IsUnloaded(stage) {
    const entity = Entities.FindByName(`m${stageList.indexOf(stage) + 1}_start_tp_case_cs2_ze`)[0];
    if (entity) return false;

    const allEntities = Entities.FindByName("");
    const result = Instance.TraceLine({
        start: detectPosition.start[stage],
        end: detectPosition.end[stage],
        ignoreEntity: allEntities,
        ignorePlayers: true
    });
    return !result.didHit;
}

/**
 * 关卡初始化
 * @param {string} stage
 */
function StageInit(stage) {
    const stageSlot = stageList.indexOf(stage) + 1;
    Entities.FireInput({ name: "start_human_tp", input: "Enable" });
    Entities.FireInput({ name: "*_skybox_branch", input: "SetValueTest", value: 0 });
    Entities.FireInput({ name: stage + "_skybox_branch", input: "SetValueTest", value: 1 });
    Entities.FireInput({ name: "dynamic_light_fix_script", input: "RunScriptInput", value: "LightFix" });
    Entities.FireInput({ name: "zombie_spawn_manager_script", input: "RunScriptInput", value: "Activate" });
    Entities.FireInput({ name: "stage_" + stage + "_init_relay", input: "Trigger" });
    Entities.FireInput({ name: "weapon_spawn_script", input: "RunScriptInput", value: "SpawnWeapons" });
    for (const player of Entities.FindByClass("player")) {
        if (!player.IsValid() || !player.IsAlive() || player.GetTeamNumber() !== 3) continue;
        Entities.FireInput({ name: `m${stageSlot}_start_tp_case_cs2_ze`, input: "PickRandomShuffle", activator: player });
    }
}

// ============================================================
// 延迟 / Think 队列
// ============================================================

/** @type {{ time: number, callback: () => void }[]} */
const thinkQueue = [];

/**
 * 回调式延迟
 * @param {number} delaySeconds
 * @param {() => void} callback
 */
function Delay(delaySeconds, callback) {
    QueueThink(Instance.GetGameTime() + delaySeconds, callback);
}

/**
 * Promise 式延迟，返回 { promise, cancel }（对象本身也是 thenable）
 *
 * 关键点：resolve 之前检查 token。若回合已切换，则 reject(CancelledError)。
 * 因此调用方 `await DelayAsync(x, token)` 之后无需再做 AssertNotCancelled。
 *
 * @param {number} delaySeconds 延迟的秒数
 * @param {number} token 回合令牌
 * @returns {DelayHandle}
 */
function DelayAsync(delaySeconds, token) {
    // 占位：Promise 构造函数同步执行，执行完 entry.reject 就会被替换成真正的 reject
    /** @type {DelayEntry} */
    const entry = {
        reject: () => {
            // no-op
        }
    };

    /** @type {Promise<void>} */
    const promise = new Promise((resolve, reject) => {
        entry.reject = reject;
        pendingDelays.add(entry);
        Delay(delaySeconds, () => {
            // 已被 cancel() 或 CancelPendingDelays() 处理过
            if (!pendingDelays.delete(entry)) return;
            if (token !== roundToken) reject(new CancelledError());
            else resolve();
        });
    });

    return {
        promise,
        cancel: () => {
            if (pendingDelays.delete(entry)) entry.reject(new CancelledError());
        },
        then: promise.then.bind(promise),
        catch: promise.catch.bind(promise),
        finally: promise.finally.bind(promise)
    };
}

/**
 * 将任务按时间插入 thinkQueue
 * @param {number} time
 * @param {() => void} callback
 */
function QueueThink(time, callback) {
    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= time) {
            insertIndex = i + 1;
            break;
        }
    }
    thinkQueue.splice(insertIndex, 0, { time, callback });
    if (insertIndex === 0) Instance.SetNextThink(time);
}

/**
 * Think 循环
 */
function RunThinkQueue() {
    const currentTime = Instance.GetGameTime();
    while (thinkQueue.length > 0 && thinkQueue[0].time <= currentTime) {
        const task = thinkQueue.shift();
        if (!task) continue;
        task.callback();
    }
    if (thinkQueue.length > 0) Instance.SetNextThink(thinkQueue[0].time);
}

Instance.SetThink(RunThinkQueue);