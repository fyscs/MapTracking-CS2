const Tier1Shotgun = ["weapon_mag7", "weapon_nova"];
const Tier2Shotgun = ["weapon_xm1014"];
const AnyShotgun = Tier1Shotgun.concat(Tier2Shotgun);
const AnySniperRifle = ["weapon_g3sg1", "weapon_scar20", "weapon_awp"];
const AnyRifle = ["weapon_m4a1", "weapon_m4a1_silencer", "weapon_ak47", "weapon_sg556", "weapon_aug"];
const AnySmg = ["weapon_p90", "weapon_ump45", "weapon_mp5sd", "weapon_mp7", "weapon_mp9", "weapon_mac10", "weapon_bizon"];
const Tier2Any = Tier2Shotgun.concat(AnySniperRifle).concat(AnyRifle);
const Tier1Any = Tier1Shotgun.concat(AnySmg).concat(["weapon_galilar", "weapon_famas", "weapon_ssg08"]);
const AnyPrimary = Tier2Any.concat(Tier1Any);
const WeaponPistolMagnum = ["weapon_deagle"];
const WeaponPistol = ["weapon_p250"];
const AnyPistol = ["weapon_usp_silencer", "weapon_deagle", "weapon_elite", "weapon_p250"];
const Any = AnyPrimary.concat(AnyPistol);

const WeaponSmg = ["weapon_mac10"];
const WeaponSmgSilenced = ["weapon_mp5sd"];
const WeaponPumpshotgun = ["weapon_nova"];
const WeaponShotgunChrome = ["weapon_nova"];
const WeaponAutoshotgun = ["weapon_xm1014"];
const WeaponShotgunSpas = ["weapon_xm1014"];
const WeaponRifle = ["weapon_m4a1", "weapon_m4a1_silencer"];
const WeaponRifleDesert = ["weapon_famas"];
const WeaponRifleAk47 = ["weapon_ak47"];
const WeaponHuntingRifle = ["weapon_galilar"];
const WeaponSniperMilitary = ["weapon_g3sg1", "weapon_scar20"];
const WeaponSmgMp5 = ["weapon_mp5sd"];
const WeaponRifleSg552 = ["weapon_sg556"];
const WeaponSniperAwp = ["weapon_awp"];
const WeaponSniperScout = ["weapon_ssg08"];

const Selection = [
    Any,
    AnyPistol,
    WeaponPistol,
    WeaponPistolMagnum,
    AnyPrimary,
    Tier1Any,
    Tier2Any,
    AnySmg,
    AnyRifle,
    AnySniperRifle,
    AnyShotgun,
    Tier1Shotgun,
    Tier2Shotgun,
    WeaponSmg,
    WeaponSmgSilenced,
    WeaponPumpshotgun,
    WeaponShotgunChrome,
    WeaponAutoshotgun,
    WeaponShotgunSpas,
    WeaponRifle,
    WeaponRifleDesert,
    WeaponRifleAk47,
    WeaponHuntingRifle,
    WeaponSniperMilitary,
    WeaponSmgMp5,
    WeaponRifleSg552,
    WeaponSniperAwp,
    WeaponSniperScout
];

Instance.OnScriptInput("SpawnWeapons", () => {
    const counters = Entities.FindByName("weapon_spawn_cs2");
    for (const counter of counters) {
        if (!counter.IsValid()) continue;
        const connectId = Entities.ConnectOutput({
            target: counter, output: "OnGetValue", callback: (inputData) => {
                const index = /** @type {number} */ (inputData.value);
                const weapons = Selection[index];
                if (!weapons) return;
                const weapon = weapons[Math.floor(Math.random() * weapons.length)];
                const origin = counter.GetAbsOrigin();
                const angles = counter.GetAbsAngles();
                for (let i = 0; i < 5; i++) {
                    Entities.Spawn([{
                        classname: weapon,
                        origin,
                        angles
                    }]);
                }
                if (connectId === undefined) return;
                Entities.DisconnectOutput(connectId);
            }
        });
        counter.FireInput({ input: "GetValue" });
    }
});