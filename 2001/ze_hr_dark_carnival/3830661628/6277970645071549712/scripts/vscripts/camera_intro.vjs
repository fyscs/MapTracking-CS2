import { CSMoveType, CSPlayerPawn, CustomCameraMode, Instance } from "cs_script/point_script";

let duration = 0;

Instance.OnScriptInput("Enable", () => {
    for (const player of /** @type {CSPlayerPawn[]} */ (Instance.FindEntitiesByClass("player"))) {
        if (!player.IsValid()) continue;
        player.SetMoveType(CSMoveType.NONE);
        const camera = player.GetCustomCamera();
        Instance.EntFireAtTarget({ target: camera, input: "SetParent", value: "ghostanim_intro" });
        Instance.EntFireAtTarget({ target: camera, input: "SetParentAttachment", value: "Attachment_1" });
        camera.SetMode(CustomCameraMode.CONTROLLED);
    }
});

Instance.OnScriptInput("Disable", () => {
    for (const player of /** @type {CSPlayerPawn[]} */ (Instance.FindEntitiesByClass("player"))) {
        if (!player.IsValid()) continue;
        const camera = player.GetCustomCamera();
        Instance.EntFireAtTarget({ target: camera, input: "ClearParent" });
        const startPosition = camera.GetAbsOrigin();
        const endPosition = player.GetAbsOrigin();
        endPosition.z += 64;
        duration = 0;
        RepeatDelay(64, 1 / 64, () => {
            duration += 1 / 64;
            camera.Move({ position: VectorLerp(startPosition, endPosition, duration) });
        });
        Delay(1, () => {
            player.SetMoveType(CSMoveType.WALK);
            camera.SetMode(CustomCameraMode.DISABLED);
        });
    }
});

Instance.OnRoundStart(() => ClearAllDelays());

/**
 * 向量线性插值
 * @param {import("cs_script/point_script").Vector} start - 起点
 * @param {import("cs_script/point_script").Vector} end - 终点
 * @param {number} t - 插值系数 [0, 1]
 * @returns {import("cs_script/point_script").Vector} 插值结果
 */
function VectorLerp(start, end, t) {
    t = Math.max(0, Math.min(1, t)); // 限制在 [0, 1]
    return {
        x: start.x + (end.x - start.x) * t,
        y: start.y + (end.y - start.y) * t,
        z: start.z + (end.z - start.z) * t
    };
}

/** @typedef {{ id: number, time: number, callback: () => void }} ThinkTask */

/** @type {ThinkTask[]} 按执行时间升序排列的任务队列 */
const thinkQueue = [];
/** @type {Map<number, ThinkTask>} 任务ID -> 任务 */
const taskMap = new Map();
let nextTaskId = 1;

/**
 * 将任务按时间升序插入队列，返回插入位置
 * @param {ThinkTask} task - 任务
 * @returns {number} 插入位置
 */
function insertTask(task) {
    // 默认插到队首（0）：若新任务早于队列中所有任务，插入循环不会命中，将保持该值
    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= task.time) {
            insertIndex = i + 1;
            break;
        }
    }
    thinkQueue.splice(insertIndex, 0, task);
    return insertIndex;
}

/**
 * 将任务加入 think 队列
 * @param {number} time - 执行时间（游戏时间）
 * @param {() => void} callback - 回调函数
 * @returns {number} 任务ID（可用于取消/重排）
 */
function QueueThink(time, callback) {
    const id = nextTaskId++;
    const task = { id, time, callback };

    const insertIndex = insertTask(task);
    taskMap.set(id, task);

    // 新任务最早时更新 think 时间
    if (insertIndex === 0) {
        Instance.SetNextThink(time);
    }
    return id;
}

/**
 * Think 循环：执行所有到期的任务
 */
function RunThinkQueue() {
    const currentTime = Instance.GetGameTime();

    // 执行所有到期的任务（队列按时间升序，queue[0] 一定是最早的）
    while (thinkQueue.length > 0 && thinkQueue[0].time <= currentTime) {
        const task = thinkQueue.shift();
        if (!task) continue;
        taskMap.delete(task.id);
        try {
            task.callback();
        } catch (error) {
            // 单个回调异常不应中断队列
        }
    }

    // 更新下一次 think（取队列最早时间）
    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }
}

Instance.SetThink(RunThinkQueue);

/**
 * 延迟指定秒数后执行回调
 * @param {number} delaySeconds - 延迟秒数（>= 0）
 * @param {() => void} callback - 回调函数
 * @returns {number} 任务ID
 */
export function Delay(delaySeconds, callback) {
    return QueueThink(Instance.GetGameTime() + Math.max(0, delaySeconds), callback);
}

/**
 * 异步延迟，返回 Promise（可用 await）
 * @param {number} delaySeconds - 延迟秒数
 * @returns {Promise<void>}
 */
export function DelayAsync(delaySeconds) {
    return new Promise((resolve) => {
        Delay(delaySeconds, resolve);
    });
}

/**
 * 取消尚未执行的延迟任务
 * @param {number} taskId - 任务ID
 * @returns {boolean} 是否成功取消
 */
export function CancelDelay(taskId) {
    const task = taskMap.get(taskId);
    if (!task) return false;

    const index = thinkQueue.indexOf(task);
    if (index === -1) return false;
    thinkQueue.splice(index, 1);
    taskMap.delete(taskId);

    // 移除的是队首任务时，重设下一次 think
    if (index === 0 && thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }
    return true;
}

/**
 * 重排未执行任务的延迟时间（从当前游戏时间重新计算）
 * @param {number} taskId - 任务ID
 * @param {number} newDelaySeconds - 新的延迟秒数
 * @returns {boolean} 是否成功
 */
export function RescheduleDelay(taskId, newDelaySeconds) {
    const task = taskMap.get(taskId);
    if (!task) return false;

    const newTime = Instance.GetGameTime() + Math.max(0, newDelaySeconds);
    if (task.time === newTime) return true;

    const index = thinkQueue.indexOf(task);
    if (index === -1) return false;
    thinkQueue.splice(index, 1);

    task.time = newTime;
    insertTask(task);

    // 更新下一次 think 时间（取队列最早时间）
    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }
    return true;
}

/**
 * 循环延迟任务：按固定间隔执行指定次数
 * @param {number} times - 总执行次数（>= 1；传 Infinity 表示无限）
 * @param {number} intervalSeconds - 每次执行的间隔秒数
 * @param {(current: number) => void} callback - 每次执行的回调，参数 current 为第几次（从 1 开始）
 * @returns {{ cancel: () => void, getRemaining: () => number }} 控制句柄
 */
export function RepeatDelay(times, intervalSeconds, callback) {
    let remaining = times;
    let cancelled = false;
    let currentTaskId = 0;

    const run = () => {
        if (cancelled) return;
        const current = times - remaining + 1;
        try {
            callback(current);
        } catch (error) {
            // 忽略回调异常，继续循环
        }
        if (cancelled) return;
        remaining -= 1;
        if (remaining > 0) {
            currentTaskId = Delay(intervalSeconds, run);
        }
    };

    currentTaskId = Delay(intervalSeconds, run);

    return {
        /** 取消循环 */
        cancel: () => {
            cancelled = true;
            CancelDelay(currentTaskId);
        },
        /** 剩余执行次数 */
        getRemaining: () => (cancelled ? 0 : Math.max(0, remaining)),
    };
}

/**
 * 无限间隔定时器
 * @param {number} intervalSeconds - 间隔秒数
 * @param {(count: number) => void} callback - 回调，参数 count 为触发次数（从 1 开始）
 * @returns {{ cancel: () => void }} 控制句柄（调用 cancel 停止）
 */
export function Interval(intervalSeconds, callback) {
    return RepeatDelay(Infinity, intervalSeconds, callback);
}

/**
 * 下一帧（下一次 think 循环）执行
 * @param {() => void} callback - 回调函数
 * @returns {number} 任务ID
 */
export function NextTick(callback) {
    return QueueThink(Instance.GetGameTime(), callback);
}

/**
 * 清除所有未执行的延迟任务（如回合重开时调用）
 */
export function ClearAllDelays() {
    thinkQueue.length = 0;
    taskMap.clear();
}

/**
 * 当前待执行的延迟任务数量
 * @returns {number} 数量
 */
export function GetPendingCount() {
    return thinkQueue.length;
}

/**
 * 检查任务是否仍存在（未执行、未取消）
 * @param {number} taskId - 任务ID
 * @returns {boolean} 是否存在
 */
export function HasPendingTask(taskId) {
    return taskMap.has(taskId);
}
