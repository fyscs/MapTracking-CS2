        // Do not board a player already owned by another parent-based mechanic.
        if (player.GetParent()?.IsValid()) return false;
        pendingExits.delete(player);
        exitPoseTokens97.delete(player);
        saved.set(player, {moveType:player.GetMoveType(), position:player.GetAbsOrigin(),
            slot:player.GetPlayerController()?.GetPlayerSlot(),parent:body,seat,jumpHeld:player.IsInputPressed(CSInputs.JUMP)});
        player.SetMoveType(CSMoveType.NONE);
