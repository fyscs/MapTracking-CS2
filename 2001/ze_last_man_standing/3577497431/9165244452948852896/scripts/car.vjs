function physicalAssemblyIssues() {
    // Presence/type contract only: does not establish mass, constraint-group,
    // friction or empty collision-attachment semantics in the Source 2 solver.
    const expected=[['Body','func_physbox',1],['Thruster_X','phys_thruster',1],
        ['Thruster_Y','phys_thruster',1],['Brake','phys_constraint',4]];
    for(const wheel of ['FL','FR','BL','BR']) expected.push(
        [wheel+'Wheel','func_physbox',1],[wheel+'Wheel_Holder','func_physbox',1],
        ['Hinge_'+wheel+'Wheel','phys_hinge',1],['Keep_'+wheel+'Wheel','phys_constraint',1],
        ['Keepupright_'+wheel+'Wheel','phys_keepupright',1],
        ['Collision_'+wheel+'Wheel','logic_collision_pair',1],
        ['Collision_'+wheel+'Wheel_Holder','logic_collision_pair',1]);
    const issues=[];
    for(const [suffix,classname,count] of expected) {
        const matches=Instance.FindEntitiesByName(PREFIX+suffix);
        if(matches.length!==count || new Set(matches).size!==count ||
            matches.some(e=>!e.IsValid() || e.GetClassName()!==classname))
            issues.push(suffix+' expected '+count+' valid '+classname);
    }
    return issues;
}

function seatButtonIssues() {
    // Binding checks do not establish usable hitboxes, movement, or disabled state.
    return SEATS.filter(seat=>seat!=='Mech').filter(seat=>{
        const matches=Instance.FindEntitiesByName(PREFIX+'Button_'+seat);
        return matches.length!==1 || !matches[0].IsValid() || matches[0].GetClassName()!=='func_button';
    });
}

function clearPosition(player, position) {
    if(!finitePosition(position)) return false;
    const trace = Instance.TracePlayer({start:position, player, isDucked:false});
    return trace.startedInSolid===false && trace.didHit===false;
}
function probeExit(player, candidate) {
    const hull={mins:{x:-16,y:-16,z:0},maxs:{x:16,y:16,z:72},ignoreEntity:player};
    const trace=Instance.TraceBox({...hull,start:candidate.start,end:candidate.end});
    if(trace.startedInSolid!==false || trace.didHit!==true || !finitePosition(trace.end) ||
        !Number.isFinite(trace.normal?.z) || trace.normal.z<EXIT_POLICY.minGroundNormal) return undefined;
    if(trace.hitEntity instanceof CSPlayerPawn || trace.hitEntity?.GetEntityName().startsWith(PREFIX)) return undefined;
    const landing={...trace.end,z:trace.end.z+EXIT_POLICY.groundLift};
    const clearance=Instance.TraceBox({...hull,start:landing,end:landing});
    if(clearance.startedInSolid||clearance.didHit||!clearPosition(player,landing))return undefined;
    const from=seatEyeTarget90(candidate.seat)??player.GetEyePosition();
    const ignore=[player,...Instance.FindEntitiesByName(PREFIX+'*')];
    const path=Instance.TraceLine({start:from,end:{...landing,z:landing.z+64},ignoreEntity:ignore});
    return path.startedInSolid||path.didHit?undefined:landing;
}
function exitContext(player,previous,seat) {
    const owner=previous?.parent;
    return {seat:seat??previous?.seat,
        center:owner?.IsValid()?owner.GetAbsOrigin():player.GetAbsOrigin(),
        angles:owner?.IsValid()?owner.GetAbsAngles():undefined};
}
function retryExits() {
    const now=Instance.GetGameTime();
    for(const [player,state] of [...pendingExits]) {
        if(!alive(player) || saved.has(player) || player.GetParent()?.IsValid() ||
            player.GetPlayerController()?.GetPlayerSlot()!==state.slot ||
            distanceSquared(player.GetAbsOrigin(),state.detachedAt)>EXIT_POLICY.maxDrift**2) {
            pendingExits.delete(player);continue;
        }
        if(now>=state.expires) {
            pendingExits.delete(player);Instance.Msg('LMS pickup: no clear forced exit found; player released, recovery timed out.');continue;
        }
        if(now<state.next) continue;
        state.next=now+EXIT_POLICY.retryInterval;
        if(clearPosition(player,player.GetAbsOrigin())) {pendingExits.delete(player);continue;}
        const position=selectExit(exitContext(player,state.previous),p=>probeExit(player,p));
        if(position) {player.Teleport({position,velocity:{x:0,y:0,z:0}});pendingExits.delete(player);}
    }
}
function stopEffects() {
    lastHullPose=undefined;
