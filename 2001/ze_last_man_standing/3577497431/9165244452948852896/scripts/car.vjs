        if(!removingHull && body?.IsValid()) body.SetHealth(99999999);
        emit('Button_*','Kill');
        emit('Entrance_Teleport_*','Kill');
        emit('Thruster_*','Deactivate');
        emit('Sound_*','StopSound');
        emit('Dust_*','Stop');
        emit('Explosion_Hurt','Enable');
