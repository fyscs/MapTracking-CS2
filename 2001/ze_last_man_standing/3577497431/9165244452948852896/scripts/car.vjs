    Instance.Msg('[LMS_PICKUP_STATE83] '+JSON.stringify({ready,destroyed:controller.destroyed,
        seats:[...controller.seats].map(([seat,player])=>({seat,...info(player)})),
        saved:[...saved].map(([player,state])=>({slot:state.slot,...info(player)})),
        pendingExits:[...pendingExits].map(([player,state])=>({slot:state.slot,expires:state.expires,...info(player)})),
        pendingDriver:!!controller.pending,guardPhase:driverGuard.state?.phase??null,lastDrive,
        exitMarker:markerPosition,exitMarkerClear:alive(seated)&&markerPosition?clearPosition(seated,markerPosition):null}));
});
