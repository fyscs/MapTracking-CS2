    const admission={destroyed:controller.destroyed,pending:!!controller.pending,occupied:controller.seats.has(seat),
        available:backend164alive(),eligible:isPlayer&&adapter.eligible(activator,seat),pendingValid:isPlayer&&adapter.pendingValid(activator),
        alive:isPlayer&&activator.IsAlive(),team:isPlayer?activator.GetTeamNumber():undefined,
        playerPosition:isPlayer?activator.GetAbsOrigin():undefined,markerPosition:marker?.IsValid()?marker.GetAbsOrigin():undefined,
        distance:isPlayer&&marker?.IsValid()?Math.sqrt(distanceSquared(activator.GetAbsOrigin(),marker.GetAbsOrigin())):undefined};
    const accepted=isPlayer?controller.board(seat,activator):false;
    Instance.Msg('[LMS_PICKUP_SEAT] '+JSON.stringify({event:'input',seat,isPlayer,ready,accepted,admission}));
});
// Independent lab positioning only; no admission bypass and no human teleport.
Instance.OnScriptInput('LabBotApproach',({activator})=>{
    if(!(activator instanceof CSPlayerPawn)||!activator.GetPlayerController()?.IsBot())return;
    const marker=find('Entrance_Position_Driver');
    const position=marker?.IsValid()?marker.GetAbsOrigin():undefined;
    if(!position||!['x','y','z'].every(k=>Number.isFinite(position[k])&&Math.abs(position[k])<16000))return;
    activator.Teleport({position,velocity:{x:0,y:0,z:0}});
    Instance.Msg('[LMS_PICKUP_SEAT] '+JSON.stringify({event:'bot_approach',position,actual:activator.GetAbsOrigin()}));
