                const choice=requestedExit190(player,previous,seat);
                position=choice.position;exitMode=choice.mode;
                lastExit190={seat,slot:previous?.slot,speed:hullSpeed174,mode:exitMode,time:Instance.GetGameTime()};
                Instance.Msg('[LMS_PICKUP_EXIT190] '+JSON.stringify(lastExit190));
            }else position=selectExit(exitContext(player,previous,seat),p=>probeExit(player,p));
        }
        const restorePose=alive(player)&&previous&&(!parent?.IsValid()||parent===previous.parent)&&
            player.GetPlayerController()?.GetPlayerPawn()===player&&
            !['reset','disconnect'].includes(reason);
        const exitEyes=restorePose?snapshotEyeAngles(player):undefined;
        const wreckPosition=reason==='destroyed'?player.GetAbsOrigin():null;
        player.SetParent(undefined);
        if(wreckPosition){
            pendingExits.delete(player);exitPoseTokens97.delete(player);
            Instance.Msg('[LMS181_WRECK_SEAT] '+JSON.stringify({seat,slot:previous?.slot,
                before: wreckPosition,after:player.GetAbsOrigin(),time:Instance.GetGameTime()}));
        }
        // Do not overwrite a dead/respawned player's movement state during lifecycle cleanup.
        if (alive(player) && previous && player.GetMoveType()===CSMoveType.NONE) player.SetMoveType(previous.moveType);
        if (position) {
            player.Teleport({position,velocity:{x:0,y:0,z:0}});
            Instance.Msg('[LMS_PICKUP_EXIT91] '+JSON.stringify({time:Instance.GetGameTime(),seat,reason,
                slot:player.GetPlayerController()?.GetPlayerSlot(),position,groundedSearch:exitMode==='grounded'}));
        }
        if(relocate && !position && reason!=='requested') {
            const now=Instance.GetGameTime();
            pendingExits.set(player,{previous,slot:previous?.slot,detachedAt:player.GetAbsOrigin(),
                next:now+EXIT_POLICY.retryInterval,expires:now+EXIT_POLICY.retrySeconds});
