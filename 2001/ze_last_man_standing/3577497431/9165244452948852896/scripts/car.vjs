function onHullBreak() {
    if(!ready && !lostActiveHull)return;
    retirePickupPhysics189();
    controller.destroy();
    adapter.wreck(true);
}
Instance.OnScriptInput('VehicleDestroyed',onHullBreak);
Instance.OnScriptInput('ResetController',()=>{pendingExits.clear();stopEffects();controller.reset();managedBrake82(3);lastDrive=undefined;});

function bind() {
    resetBackend164();
    // A P2 template intentionally has no vehicle until the stage's +2 second output.
    // Keep the controller and transport counters outside the vehicle template.
    if(!find('Body')?.IsValid() && Instance.FindEntityByName('Template_Vehicle_Car1')?.IsValid()) {
        ready=false;body=undefined;
        Instance.SetNextThink(Instance.GetGameTime());return;
    }
    physics164.dispose();
    brakeTrial75=false;
    labDrive.clear();
    controller.reset();
    guardTransport?.close();guardTransport=undefined;
    pendingExits.clear();
    stopEffects();
    // Round recreation can destroy the owner before this script receives RoundStart.
    // Disconnect only subscriptions whose original owner still exists.
    for(const {id,owner} of outputConnections) if(owner?.IsValid()) Instance.DisconnectOutput(id);
    outputConnections.length=0;
    body=find('Body');
    rememberHullPose();
    emit('Model','Color','255 255 255');
    const required=['Body','Thruster_X','Thruster_Y','Exit_Position',...SEATS.map(s=>'Entrance_Position_'+s),
        ...['FR','BR','BL','FL'].map(w=>'Dust_'+w+'Wheel')];
    const physicalIssues=physicalAssemblyIssues();
    const buttonIssues=seatButtonIssues();
    ready=required.every(n=>find(n)?.IsValid()) && physicalIssues.length===0 && buttonIssues.length===0;
    ready=ready && Instance.FindEntityByName('LMS_Pickup_Explosion_Maker')?.IsValid() &&
        Instance.FindEntityByName('LMS_Pickup_Small_Template')?.IsValid();
    ready=ready && ['Gas','Nogas'].every(n=>find('Sound_'+n)?.IsValid() && volumeParam(n)?.IsValid()) &&
        ['Low','High'].every(n=>find('Sound_Gas_'+n)?.IsValid());
    for(const name of ['Gas','Nogas']) {
        const sound=find('Sound_'+name);
        if(sound?.IsValid()) {
            const id=Instance.ConnectOutput(sound,'SoundEventGuid',({value})=>bindEngineGuid(name,value));
            if(id!==undefined) outputConnections.push({id,owner:sound});
        }
    }
    lastDrive=undefined;
    if(body?.IsValid()) {
        const watchedBody=body;
        const add=(name,fn)=>{
            const id=Instance.ConnectOutput(watchedBody,name,fn);
            if(id!==undefined) outputConnections.push({id,owner:watchedBody});
        };
        add('OnHealthChanged',({value})=>{
            Instance.Msg('[LMS_PICKUP_HEALTH85] '+JSON.stringify({value,time:Instance.GetGameTime(),ready,health:watchedBody.IsValid()?watchedBody.GetHealth():null}));
            if(body!==watchedBody || !ready)return;
            if(watchedBody.IsValid() && watchedBody.GetHealth()<=0)onHullBreak();
            else controller.healthFraction(value);
        });
        add('OnUser3',()=>{
            if(body===watchedBody && ready) controller.healthFraction(0.1);
        });
        add('OnBreak',()=>{if(body===watchedBody)onHullBreak();});
    }
    if(!guardReloadBlocked) {
        try {
            const self=Instance.FindEntityByName('LMS_Pickup_Controller');
            guardTransport={isAvailable:()=>stockGuard181.supported(),close:()=>stockGuard181.reset()};
        } catch(error) {Instance.Msg('LMS pickup driver unavailable: guard entities or connection missing.');}
    }
    emit('Button_Driver','Lock');
    if(guardReloadBlocked)Instance.Msg('LMS pickup driver disabled after script reload; fresh map required.');
    adapter.drive(0,0,true,false);
    if(physicalIssues.length) Instance.Msg('LMS pickup physical assembly incomplete: '+physicalIssues.join('; '));
    if(buttonIssues.length) Instance.Msg('LMS pickup seat buttons incomplete: '+buttonIssues.join(', '));
    Instance.Msg(ready?'LMS pickup controller bound; runtime validation pending.':'LMS pickup disabled: physical assembly or seat markers missing.');
    Instance.SetNextThink(Instance.GetGameTime());
}
// Both map stage relays can fire in the same round. The truck and its auxiliary
// template use fixed entity names, so only one live assembly can be controlled.
let spawnConfirmed188=false, spawnPendingUntil188=0;
Instance.OnScriptInput('EnsurePickupSpawn188',()=>{
    const now=Instance.GetGameTime();
    if(spawnConfirmed188 || now<spawnPendingUntil188)return;
    if(Instance.FindEntitiesByName('Vehicle_Car1_Body').some(e=>e.IsValid())){
        spawnConfirmed188=true;
        return;
    }
    const template=Instance.FindEntityByName('Template_Vehicle_Car1');
    if(!template?.IsValid()||template.GetClassName()!=='point_template')return;
    spawnPendingUntil188=now+1;
    Instance.EntFireAtTarget({target:template,input:'ForceSpawn'});
});

let stall188=null, nextStallLog188=0;
function pickupGround188(reason){
    const parts=PHYSICS_BODIES.map(find);
    const ignore=[...parts,find('Model')].filter(e=>e?.IsValid());
    const wheels={};
    for(const axle of AXLES164){
        const wheel=find(axle.name+'Wheel');
        if(!wheel?.IsValid())continue;
        const p=wheel.GetAbsOrigin();
        const ray=Instance.TraceLine({start:p,end:{x:p.x,y:p.y,z:p.z-128},ignoreEntity:ignore,ignorePlayers:true});
        wheels[axle.name]={center:p,angularVelocity:wheel.GetAbsAngularVelocity(),
            startsInSolid:ray.startedInSolid,downHit:ray.didHit,centerToSurface:ray.didHit?p.z-ray.end.z:null,
            surface:ray.hitEntity?.GetClassName()??null};
    }
    Instance.Msg('[LMS_PICKUP_GROUND188] '+JSON.stringify({reason,time:Instance.GetGameTime(),
        pos:body?.IsValid()?body.GetAbsOrigin():null,input:lastDrive,physics:physics164.status(),wheels}));
}
function checkPickupTravel188(){
    const driver=controller.seats.get('Driver');
    if(!driver||!lastDrive?.[0]||lastDrive[2]||!body?.IsValid()){stall188=null;return;}
    const pos=body.GetAbsOrigin(),now=Instance.GetGameTime(),direction=lastDrive[0];
    if(stall188?.driver!==driver||stall188.direction!==direction||distanceSquared(pos,stall188.pos)>16){
        stall188={driver,direction,pos,since:now,reported:false};
    }else if(!stall188.reported&&now-stall188.since>=1.5&&now>=nextStallLog188){
        stall188.reported=true;nextStallLog188=now+8;
        pickupGround188('throttle_without_travel');
    }
}
Console.RegisterCheatCommand('lms_pickup_ground188',()=>pickupGround188('manual'));
// Release steering smoothly while the wheels support the truck. Apply one
// common change in world yaw to the whole assembly, preserving wheel spin,
// pitch/roll and mass-weighted translation. No position or angle teleport.
const PICKUP_COAST_TARGET190=18;
function pickupYawDelta189(rate,dt,remaining=Infinity){
    if(!Number.isFinite(rate)||!Number.isFinite(dt)||dt<=0||dt>.1)return 0;
    const change=Math.abs(rate)<.25?-rate:-rate*(1-Math.exp(-6*dt));
    const gentle=Math.max(-150*dt,Math.min(150*dt,change));
    const next=rate+gentle;
    // Keep the freely coasting arc within the requested 18 degrees. External
    // contacts can stop it earlier; never add yaw to force a minimum angle.
    const limited=Math.min(Math.abs(next),Math.max(0,remaining)/dt);
    return Math.sign(next)*limited-rate;
}
function pickupYawPlan189(parts,delta){
    const mass=parts.reduce((s,p)=>s+p.mass,0);
    if(!mass||!Number.isFinite(delta))return [];
    const center=parts.reduce((c,p)=>({x:c.x+p.pos.x*p.mass/mass,y:c.y+p.pos.y*p.mass/mass}),{x:0,y:0});
    const spin=delta*Math.PI/180;
    return parts.map(p=>({velocity:{x:p.vel.x-spin*(p.pos.y-center.y),y:p.vel.y+spin*(p.pos.x-center.x),z:p.vel.z},
        angularVelocity:{x:p.omega.x,y:p.omega.y,z:p.omega.z+delta}}));
}
let steerAssist189=true, steerTime189=null,steerRelease190=null;
let steerState189={active:false,reason:'idle',rate:0,delta:0};
function settleSteering189(){
    const now=Instance.GetGameTime(),dt=steerTime189===null?0:now-steerTime189;
    steerTime189=now;
    const skip=reason=>{steerRelease190=null;steerState189={active:false,reason,rate:body?.IsValid()?body.GetAbsAngularVelocity().z:0,delta:0};};
    if(!steerAssist189){skip('probe_disabled');return;}
    if(!ready||!physics164.ready||!backend164alive()||controller.destroyed||!body?.IsValid()||!controller.seats.has('Driver')){skip('inactive');return;}
    if(!lastDrive||lastDrive[1]!==0||lastDrive[2]){skip('steering_or_braking');return;}
    const angles=body.GetAbsAngles();
    if(Math.abs(angles.pitch)>50||Math.abs(angles.roll)>50){skip('tilted');return;}
    const omega=body.GetAbsAngularVelocity();
    if(!Number.isFinite(dt)||dt<=0||dt>.1){skip('time_gap');return;}
    if(!steerRelease190||steerRelease190.body!==body)
        steerRelease190={body,yaw:angles.yaw,travel:0};
    const step=(angles.yaw-steerRelease190.yaw+540)%360-180;
    steerRelease190.travel+=Math.abs(step);steerRelease190.yaw=angles.yaw;
    const remaining=Math.max(0,PICKUP_COAST_TARGET190-steerRelease190.travel);
    const delta=pickupYawDelta189(omega.z,dt,remaining);
    const entities=PHYSICS_BODIES.map(find);
    if(entities.some(e=>!e?.IsValid())||new Set(entities).size!==9){skip('assembly_missing');return;}
    const ignore=[...entities,find('Model')].filter(e=>e?.IsValid());
    let front=false,rear=false;
    for(const axle of AXLES164){
        const wheel=find(axle.name+'Wheel'),p=wheel.GetAbsOrigin();
        const ray=Instance.TraceLine({start:p,end:{...p,z:p.z-36},ignoreEntity:ignore,ignorePlayers:true});
        if(ray.didHit&&!ray.startedInSolid&&ray.normal.z>=.55){
            if(axle.name[0]==='F')front=true;else rear=true;
        }
    }
    if(!front||!rear){skip('unsupported');return;}
    const parts=entities.map((e,i)=>({mass:PICKUP_MASSES164[i][1],pos:e.GetAbsOrigin(),vel:e.GetAbsVelocity(),omega:e.GetAbsAngularVelocity()}));
    const plan=pickupYawPlan189(parts,delta);
    for(let i=0;i<entities.length;i++)entities[i].Move(plan[i]);
    steerState189={active:true,reason:'neutral_damping',rate:omega.z,delta,targetDegrees:PICKUP_COAST_TARGET190,coastedDegrees:steerRelease190.travel,remainingDegrees:remaining};
}
// Private, bot-only A/B fixture. Human/public sessions cannot disable the assist.
Console.RegisterCheatCommand('lms189_steer_assist',args=>{
    if(!localTestEnabled173)return;
    const users=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected());
    if(!users.length||users.some(c=>!c.IsBot()))return;
    if(args.trim()==='on')steerAssist189=true;
    else if(args.trim()==='off')steerAssist189=false;
    Instance.Msg('[LMS_PICKUP_STEER189] '+JSON.stringify({enabled:steerAssist189,...steerState189}));
});
let retiredRoot189=null;
function retirePickupPhysics189(){
    if(!body||retiredRoot189===body)return;
    const current=find('Body');
    // Never remove the constraints of a newly spawned generation.
    if(current?.IsValid()&&current!==body)return;
    retiredRoot189=body;
    physics164.stop();
    const classes=new Set(['phys_hinge','phys_constraint','phys_keepupright','phys_thruster','phys_constraintsystem']);
    const links=Instance.FindEntitiesByName(PREFIX+'*').filter(e=>e.IsValid()&&classes.has(e.GetClassName()));
    for(const e of links){
        if(e.GetClassName()==='phys_thruster')Instance.EntFireAtTarget({target:e,input:'Deactivate'});
        else if(e.GetClassName()!=='phys_constraintsystem')Instance.EntFireAtTarget({target:e,input:'TurnOff'});
    }
    for(const e of links)if(e.IsValid())e.Remove();
    physics164.joints=[];physics164.brakes=[];physics164.original=[];physics164.bodies=[];
    physics164.phase='destroyed';physics164.parked=true;
    Instance.Msg('[LMS_PICKUP_RETIRE189] '+JSON.stringify({time:Instance.GetGameTime(),links:links.length}));
}
// Destruction owns a snapshot of the occupied seats. Native death does not
// depend on a short-lived, parented trigger_hurt touching an unparented pawn.
function killPickupOccupants189(occupants){
    const victims=occupants.map(([seat,p])=>({seat,p,state:saved.get(p)}));
    for(const {seat,p,state} of victims){
        if(!state||!alive(p))continue;
        const c=p.GetPlayerController(),parent=p.GetParent();
        if(!c?.IsConnected()||c.GetPlayerPawn()!==p||c.GetPlayerSlot()!==state.slot||
            (parent?.IsValid()&&parent!==state.parent))continue;
        const before=p.GetAbsOrigin();
        p.TakeDamage({damage:Math.max(1,p.GetHealth()+1),damageTypes:CSDamageTypes.GENERIC,
            damageFlags:CSDamageFlags.FORCE_DEATH|CSDamageFlags.IGNORE_ARMOR|
                CSDamageFlags.SUPPRESS_DAMAGE_MODIFICATION|CSDamageFlags.SUPPRESS_PHYSICS_FORCE});
        Instance.Msg('[LMS_PICKUP_WRECK189] '+JSON.stringify({seat,slot:state.slot,time:Instance.GetGameTime(),
            dead:!p.IsValid()||!p.IsAlive(),before,after:p.IsValid()?p.GetAbsOrigin():null}));
    }
}

let riverTouch189=false;
// Bot-only checks use the existing real button and the river's actual trigger.
Console.RegisterCheatCommand('lms189_crew_probe',args=>{
    if(!localTestEnabled173)return;
    const users=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected());
    if(!users.length||users.some(c=>!c.IsBot()))return;
    const [op,slot,seat='Passager3']=args.trim().split(/\s+/);
    const p=users.find(c=>String(c.GetPlayerSlot())===slot)?.GetPlayerPawn();
    if(op==='board'&&p?.IsAlive()&&SEATS.includes(seat)&&seat!=='Mech'){
        const marker=find('Entrance_Position_'+seat),button=find('Button_'+seat);
        if(marker?.IsValid()&&button?.IsValid()){
            p.Teleport({position:marker.GetAbsOrigin(),velocity:{x:0,y:0,z:0}});
            Instance.EntFireAtTarget({target:button,input:'Press',activator:p});
        }
    }
    if(op==='exit'&&p?.IsAlive())controller.leave(p,'requested');
    if(op==='tilt_pawn'&&p?.IsAlive()&&saved.has(p)){
        p.Teleport({angles:{pitch:25,yaw:73,roll:-35},angularVelocity:{x:9,y:5,z:3}});
        p.SetEyeAngles({pitch:12,yaw:73,roll:-35});
    }
    if(op==='detach_pawn'&&p?.IsAlive()&&saved.has(p))p.SetParent(undefined);
    if(op==='fast_roll'&&ready&&body?.IsValid()){
        const a=body.GetAbsAngles().yaw*Math.PI/180;
        for(const e of PHYSICS_BODIES.map(find))if(e?.IsValid())e.Move({velocity:{x:450*Math.cos(a),y:450*Math.sin(a),z:0}});
    }
    if(op==='airborne'&&ready&&body?.IsValid()){
        const pos=body.GetAbsOrigin();
        relocateAssembly(PHYSICS_BODIES.map(find),body,{position:{...pos,z:pos.z+400},angles:body.GetAbsAngles()});
        rememberHullPose();queueOccupiedPose90();
    }
    if(op==='river'&&ready&&body?.IsValid()){
        const trigger=Instance.FindEntityByName('stage_1_trigger_tank_out');
        if(trigger?.IsValid()){
            const hull=body;riverTouch189=false;
            const id=Instance.ConnectOutput(trigger,'OnStartTouch',({activator})=>{if(activator===hull){riverTouch189=true;Instance.DisconnectOutput(id);}});
            const pos=trigger.GetAbsOrigin();
            relocateAssembly(PHYSICS_BODIES.map(find),body,{position:{...pos,z:pos.z+24},angles:{pitch:12,yaw:0,roll:25}});
            rememberHullPose();queueOccupiedPose90();
        }
    }
    if(op==='destroy'&&ready&&body?.IsValid())Instance.EntFireAtTarget({target:body,input:'FireUser3'});
    Instance.Msg('[LMS_PICKUP_CREW189] '+JSON.stringify({time:Instance.GetGameTime(),ready,destroyed:controller.destroyed,
        seats:[...controller.seats].map(([seat,p])=>({seat,slot:p.GetPlayerController()?.GetPlayerSlot()})),saved:saved.size,
        pendingExits:pendingExits.size,guard:stockGuard181.seats.size,riverTouch:riverTouch189,lastExit:lastExit190,cameraSync:cameraSync191,cameraAnchorParent:Instance.FindEntityByName('LMS_SeatCamera187_lms_pickup_driver186')?.GetParent()?.GetEntityName()??null,cameraAnchorValid:Instance.FindEntityByName('LMS_SeatCamera187_lms_pickup_driver186')?.IsValid()===true,
        players:users.map(c=>{const p=c.GetPlayerPawn();return {slot:c.GetPlayerSlot(),alive:p?.IsAlive(),
            health:p?.GetHealth(),color:p?.GetColor(),follow:saved.has(p)?{hard:saved.get(p).hardRepairs191??0,smooth:saved.get(p).smoothMoves191??0,maxGap:saved.get(p).maxGap191??0}:null,pos:p?.GetAbsOrigin(),angles:p?.GetAbsAngles(),eye:p?.GetEyeAngles(),
            spin:p?.GetAbsAngularVelocity(),parent:p?.GetParent()?.GetEntityName()??null,move:p?.GetMoveType()};})}));
});

let awaitingBind146=false;
Instance.OnScriptInput('PickupSpawned146',()=>{
    spawnConfirmed188=true;
    if(awaitingBind146)return;
    awaitingBind146=true;
    Instance.QueueAfterThinks(()=>{
        awaitingBind146=false;
        if(find('Body')?.IsValid() && (!ready || body!==find('Body')))bind();
    });
});
// The destination belongs to a dynamically loaded stage; its load and template
// spawn may finish after the main world's I/O. Never use another stage's pose.
let stageMove171=null;
function tryStageMove171(){
    const req=stageMove171;if(!req)return;
    const t=Instance.GetGameTime();if(t<req.next)return;
    if(t>=req.until || (req.body && (!req.body.IsValid() || req.body!==body)) || controller.destroyed){
        stageMove171=null;Instance.Msg('[LMS_PICKUP171] stage move expired/cancelled: '+req.target);return;
    }
    req.next=t+0.1;if(!ready||!body?.IsValid())return;
    req.body=body;
    const anchors=Instance.FindEntitiesByName(req.target).filter(e=>e.IsValid());
    const assembly=PHYSICS_BODIES.map(find);
    if(anchors.length!==1||assembly.some(e=>!e?.IsValid())||new Set(assembly).size!==9)return;
    stageMove171=null;relocateAssembly(assembly,body,{position:anchors[0].GetAbsOrigin(),angles:anchors[0].GetAbsAngles()});
    rememberHullPose();queueOccupiedPose90();
    Instance.Msg('[LMS_PICKUP_SPAWN146] '+JSON.stringify({event:req.input,time:t,position:body.GetAbsOrigin(),bodies:assembly.length}));
}
for(const [input,target] of [['PickupStage1Extreme146','LMS_Pickup_Stage1_Anchor146'],['PickupStage4Teleport146','Stage_4_Spawn_Tank_Teleport_1']]){
    Instance.OnScriptInput(input,()=>{const t=Instance.GetGameTime();stageMove171={input,target,next:t,until:t+10,body:ready?body:null};tryStageMove171();});
}
Instance.OnActivate(bind);
Instance.SetThink(()=>{
    tryStageMove171();
    if(airSaved92.length&&Instance.GetGameTime()>=airUntil92)restoreAir92();
    if (body&&!body.IsValid()&&retiredRoot189!==body) {retirePickupPhysics189();if(ready){lostActiveHull=true;physicsProbe.stop('body_invalid',Instance.GetGameTime());controller.destroy();ready=false;}}
    if (ready) {
        const before=physics164.ready;
        const available=physics164.ensure(Instance.GetGameTime(),backend164alive());
        if(available&&!before&&!controller.seats.has('Driver')&&!controller.pending){
            lastDrive=undefined;emit('Button_Driver','Unlock');
        }
        if(!backend164alive())physics164.stop();
        rememberHullPose();
    }
    if (ready) {
        // Recover an accidentally detached seated pawn before the guard validates ownership.
        measureHull174(Instance.GetGameTime());
        for(const [seat,p] of controller.seats)restoreOccupiedPose146(seat,p);
        controller.tick();settleSteering189();checkPickupTravel188();queueOccupiedPose90();
        const driver187=controller.seats.get('Driver');
        if(driver187 && stockGuard181.valid(driver187))stockGuard181.move(driver187,driverEyeTarget89());
    }
    retryExits();
    if (ready) for(const name of soundCadence.due(Instance.GetGameTime())) {
        emit('Sound_'+name,'StartSound');
        if(name==='Gas') emit('Sound_Gas_*','Trigger'); // p2 P1955, both named relays.
    }
    physicsProbe.tick(Instance.GetGameTime());
    Instance.SetNextThink(Instance.GetGameTime());
});
Instance.OnPlayerKill(({player})=>{exitPoseTokens97.delete(player);pendingExits.delete(player);controller.leave(player,'death');});
Instance.OnPlayerReset(({player})=>{exitPoseTokens97.delete(player);pendingExits.delete(player);controller.leave(player,'reset');});
Instance.OnPlayerTeamChanged(({player})=>controller.teamChanged(player));
Instance.OnPlayerDisconnect(({playerSlot})=>{
    for(const player of exitPoseTokens97.keys())if(!player.IsValid()||player.GetPlayerController()?.GetPlayerSlot()===playerSlot)exitPoseTokens97.delete(player);
    controller.pendingDisconnected(playerSlot);
    for(const [player,state] of [...pendingExits]) if(state.slot===playerSlot) pendingExits.delete(player);
    for(const [player,state] of [...saved]) if(state.slot===playerSlot) controller.leave(player,'disconnect');
});
Instance.OnBeginRoundRestart(()=>{steerAssist189=true;steerTime189=null;steerRelease190=null;spawnConfirmed188=false;spawnPendingUntil188=0;stall188=null;stageMove171=null;pendingExits.clear();stopEffects();controller.destroy('round_restart');managedBrake82(3);guardTransport?.close();guardTransport=undefined;ready=false;});
Instance.OnRoundStart(()=>{controller.reset();bind();});
Instance.OnRoundEnd(()=>{stageMove171=null;pendingExits.clear();stopEffects();controller.destroy('round_end');managedBrake82(3);guardTransport?.close();guardTransport=undefined;ready=false;});
Instance.OnScriptReload({before:()=>{
    stageMove171=null;
    pendingExits.clear();stopEffects();controller.destroy('reload');
    managedBrake82(3);
    guardReloadBlocked=true;guardTransport?.close();guardTransport=undefined;ready=false;
},after:()=>{guardReloadBlocked=true;bind();}});

// Scoped console bridge; this diagnostic never changes the driver's view angles.
Instance.OnScriptInput('DriverView89Status',({activator})=>{if(ready)viewState89(activator,'status');});
for(const lift of [0,8,12,16,20]) Instance.OnScriptInput('DriverView89Height'+lift,()=>{
    if(!ready||!body?.IsValid()||controller.destroyed)return;
    const p=controller.seats.get('Driver');
    driverSeatLift89=lift;
    if(alive(p)&&adapter.valid(p))p.Teleport({position:driverAnchor89(),velocity:{x:0,y:0,z:0}});
    viewState89(p,'height_applied');
});

function auditPickup163(){
  const names=['LMS_Pickup_Controller','Vehicle_Car1_Body','Template_Vehicle_Car1','LMS_Pickup_Stage1_Anchor146','Stage_4_Spawn_Tank_Teleport_1','LMS_Pickup_Guard_Request','LMS_Pickup_Guard_Reply'];
  const found=Object.fromEntries(names.map(n=>[n,Instance.FindEntitiesByName(n).filter(e=>e.IsValid()).map(e=>({cls:e.GetClassName(),position:e.GetAbsOrigin()}))]));
  const g=driverGuard.state;
  Instance.Msg('[LMS_DEPLOY163_PICKUP] '+JSON.stringify({map:Instance.GetMapName(),ready,guardReloadBlocked,transportPresent:!!guardTransport,guard:g?{phase:g.phase,deadline:g.deadline,last:g.last}:null,pendingDriver:!!controller.pending,found,admissionBackend:'official CS2Fixes + map seats181'}));
}
Console.RegisterCheatCommand('pickup_deploy_audit163',auditPickup163);
Instance.OnScriptInput('Audit163',auditPickup163);

Instance.OnScriptInput('Audit164',()=>Instance.Msg('[LMS_PICKUP164] '+JSON.stringify({
 mapControllerReady:backend164alive(),protection:stockGuard181.status(),physics:physics164.status(),ready,guard:!!guardTransport?.isAvailable()})));

// The local RCON launcher enables test controls explicitly. No server convar needs
// to be exposed to the map script. Public rounds start with the controls disabled.
let localTestEnabled173=false;
Instance.OnScriptInput('EnableLocalAcceptance173',({activator,caller})=>{
  if(!activator?.IsValid()&&(!caller?.IsValid()||caller.GetClassName()==='worldspawn')){localTestEnabled173=true;stockGuard181.botProbes=true;}
});
Console.RegisterCheatCommand('lms173_drivecheck',args=>{
  if(!localTestEnabled173)return;
  const users=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected());
  if(!users.length||users.some(c=>!c.IsBot()))return;
  const [op,slot]=args.trim().split(/\s+/);
  const p=users.find(c=>String(c.GetPlayerSlot())===slot)?.GetPlayerPawn();
  if(!p?.IsAlive()||!ready||!body?.IsValid())return;
  if(op==='board'){const point=find('Entrance_Position_Driver');if(!point?.IsValid())return;
    p.Teleport({position:point.GetAbsOrigin(),velocity:{x:0,y:0,z:0}});Instance.EntFireAtTarget({target:find('Button_Driver'),input:'Press',activator:p});}
  if(['forward','reverse','brake','forward_brake','forward_coast','drive_brake','coast_left','coast_right','forward_left','forward_right'].includes(op))labDrive.begin(p,op,Instance.GetGameTime(),controller.seats.get('Driver')===p&&adapter.valid(p));
  if(op==='exit'&&controller.seats.get('Driver')===p)controller.leave(p,'requested');
  Instance.Msg('[LMS173_CAR] '+JSON.stringify({mounted:controller.seats.get('Driver')===p,pos:body.GetAbsOrigin(),yaw:body.GetAbsAngles().yaw,speed:hullSpeed174,
    time:Instance.GetGameTime(),drive:lastDrive,angularVelocity:body.GetAbsAngularVelocity(),steering:steerState189,parking:physics164.status(),hp:body.GetHealth(),active:p.GetActiveWeapon()?.GetClassName()??null,
    knife:p.FindWeaponBySlot(2)?.GetEntityName()??null}));
});

// Private comparisons use real held items, a separate CT/T pawn, or an
// existing map emitter. Never move a human or run in a mixed session.
Console.RegisterCheatCommand('lms174_contact',args=>{
    if(!localTestEnabled173||!body?.IsValid())return;
    const users=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected());
    if(users.some(c=>!c.IsBot()))return;
    const [op,slot]=args.trim().split(/\s+/);
    const p=users.find(c=>String(c.GetPlayerSlot())===slot)?.GetPlayerPawn();
    if(!alive(p)||p.GetParent()?.IsValid())return;
    const point=(x,y,z)=>transformExit({x,y,z},body.GetAbsOrigin(),body.GetAbsAngles());
    const loc=body.GetAbsOrigin(),yaw=body.GetAbsAngles().yaw*Math.PI/180;
    const name=e=>e?.IsValid()?e.GetEntityName()||e.GetClassName():null;
    const linked=e=>{
        for(let n=e,i=0;n?.IsValid()&&i<5;i++,n=n.GetParent())
            if(n===p||n.GetOwner?.()===p)return true;
        return false;
    };
    const solids=Instance.FindEntitiesByClass('func_physbox').filter(linked);
    const eye=p.GetEyePosition(),a=p.GetEyeAngles(),r=Math.PI/180;
    const end={x:eye.x+80*Math.cos(a.pitch*r)*Math.cos(a.yaw*r),y:eye.y+80*Math.cos(a.pitch*r)*Math.sin(a.yaw*r),z:eye.z-80*Math.sin(a.pitch*r)};
    const describe=t=>({solid:t.startedInSolid,hit:name(t.hitEntity),fraction:t.fraction});
    const snapshot=()=>({time:Instance.GetGameTime(),op,truck:body.GetAbsOrigin(),speed:hullSpeed174,
        pawn:p.GetAbsOrigin(),pname:name(p),move:p.GetMoveType(),noclip:p.IsNoclipping(),eye,cam:p.GetCustomCamera().GetMode(),
        weapon:name(p.GetActiveWeapon()),knife:name(p.FindWeaponBySlot(2)),solids:solids.map(name),
        eyeRay:describe(Instance.TraceLine({start:eye,end,ignoreEntity:p})),
        withoutOwned:describe(Instance.TraceLine({start:eye,end,ignoreEntity:[p,...solids]}))});
    if(op==='away')p.Teleport({position:point(0,-450,-40),velocity:{x:0,y:0,z:0}});
    if(op==='bump')p.Teleport({position:point(0,-82,-42),velocity:{x:-Math.sin(yaw)*245,y:Math.cos(yaw)*245,z:0}});
    if(op==='face'){
        p.Teleport({position:point(0,-80,-42),velocity:{x:0,y:0,z:0}});
        p.SetEyeAngles({pitch:0,yaw:body.GetAbsAngles().yaw+90,roll:0});
    }
    if(op==='emit'){
        const eff=Instance.FindEntitiesByName('Zombie_Item_Boss_Hurt_Phys*').find(linked);
        if(eff?.IsValid())Instance.EntFireAtTarget({target:eff,input:'Explode',activator:p});
        else {Instance.Msg('[LMS174_CONTACT] '+JSON.stringify({error:'missing owned emitter'}));return;}
    }
    if(op==='drop-test-knife'){
        const knife=Instance.FindEntitiesByName('Zombie_Item_Boss_Knife*').find(e=>e.GetClassName()==='weapon_knife'&&!e.GetOwner());
        if(!knife){Instance.Msg('[LMS174_CONTACT] '+JSON.stringify({error:'no loose Alex knife'}));return;}
        knife.Teleport({position:point(0,-85,0),velocity:{x:-Math.sin(yaw)*245,y:Math.cos(yaw)*245,z:0}});
    }
    if(op==='barrel'||op==='pistol'){
        const e=op==='barrel'?Instance.FindEntityByName('stage1rockbarrels'):
            Instance.FindEntitiesByClass('weapon_hkp2000').find(w=>w.IsValid()&&!w.GetOwner());
        if(!e?.IsValid()||e.GetParent()?.IsValid()||(op==='barrel'&&e.GetClassName()!=='prop_physics')){
            Instance.Msg('[LMS174_CONTACT] '+JSON.stringify({error:'test object unavailable'}));return;
        }
        e.Teleport({position:point(0,-94,0),velocity:{x:-Math.sin(yaw)*300,y:Math.cos(yaw)*300,z:0}});
    }
    if(op==='drop-default-pistol'){
        const pistol=p.FindWeaponBySlot(1);
        if(pistol?.GetClassName()==='weapon_hkp2000'&&!pistol.GetEntityName())p.DropWeapon(pistol);
    }
    if(op==='grenade'){
        Instance.SpawnGrenadeProjectile({type:CSGrenadeType.HE,thrower:p,position:point(0,-100,0),
            velocity:{x:-Math.sin(yaw)*245,y:Math.cos(yaw)*245,z:0}});
    }
    Instance.Msg('[LMS174_CONTACT] '+JSON.stringify(snapshot()));
});

Console.RegisterCheatCommand('lms181_pickup_version',()=>Instance.Msg('[LMS181_VERSION] '+JSON.stringify({vehicle:'pickup',revision:'191',ready,physicsReady:physics164.ready,guard:stockGuard181.status()})));

