    },
    valid(player) { return alive(player) && [2,3].includes(player.GetTeamNumber()) && player.GetParent()===saved.get(player)?.parent; },
    read(player) {
        const lab=labDrive.read(player,Instance.GetGameTime(),alive(player)&&player.GetPlayerController()?.IsBot()===true&&controller.seats.get('Driver')===player);
        if(lab)return lab;
        const state=saved.get(player);
        const jump=player.IsInputPressed(CSInputs.JUMP), exitPressed=!!state&&jump&&!state.jumpHeld;
        if(state)state.jumpHeld=jump;
        return {forward:player.IsInputPressed(CSInputs.FORWARD),back:player.IsInputPressed(CSInputs.BACK),
            left:player.IsInputPressed(CSInputs.LEFT),right:player.IsInputPressed(CSInputs.RIGHT),
            brake:player.IsInputPressed(CSInputs.ATTACK2),hornPressed:player.WasInputJustPressed(CSInputs.ATTACK),
            exitPressed};
    },
    drive(forward, sideways, brake, forwardHeld) {
        if(!physics164.ready||!backend164alive()){physics164.stop();lastDrive=undefined;return;}
        if(brake){forward=0;sideways=0;forwardHeld=false;}
        const next=[forward,sideways,brake,forwardHeld];
        if (lastDrive && next.every((v,i)=>v===lastDrive[i])) return;
        if (brake && lastDrive && !lastDrive[2] && controller.seats.has('Driver')) emit('Sound_Brake','StartSound');
        for (const [axis,value] of [['Y',forward],['X',sideways]]) {
            // Initialize before applying signed scale. Source SDK Scale can itself
            // activate; CS2 behavior still needs engine verification.
            if (value!==0) emit('Thruster_'+axis,'Activate');
            emit('Thruster_'+axis,'Scale',String(value)); // Local ForceController FGD declares Scale(string).
            if (value===0) emit('Thruster_'+axis,'Deactivate');
        }
        if(!managedBrake82(brake?1:0)){physics164.stop();lastDrive=undefined;return;}
        emit('Hurt',forwardHeld?'Enable':'Disable');
        lastDrive=next;
    },
    horn(player) { emit('Sound_Horn','StartSound',undefined,player); },
    playerTeam(player) {return player.GetTeamNumber();},
    teamChanged(player,team) {
        if(!controller.destroyed)emit('Model','Color',team===2?'255 100 100':'255 255 255');
        // The two named team filters must be provided by the isolated sample assembly.
        Instance.EntFireAtTarget({target:body,input:'SetDamageFilter',
            value:team===2?'team_filter_humans':'team_filter_zombies',activator:player});
    },
    seatChanged(seat, occupied, player) {
        if(seat==='Driver'&&!occupied)labDrive.clear();
        if (seat==='Mech') {
            emit('Entrance_Teleport_Mech',occupied?'Disable':'Enable');
            return;
        }
        if (seat!=='Mech') emit('Button_'+seat,occupied?'Lock':'Unlock',undefined,player);
        if (seat!=='Driver') return;
        const audioToken=++audioGeneration;
        if(occupied) {
            engineGuids.clear();
            // Initial health=5 for both ambient_generic entities; playback
            // reinitialization on later boardings still needs engine comparison.
            engineVolume('Gas',5);engineVolume('Nogas',5);
        } else {
            engineVolume('Gas',0);engineVolume('Nogas',0);
        }
        soundCadence.setOccupied(occupied,Instance.GetGameTime());
        emit('Dust_*',occupied?'Start':'Stop'); // info_particle_system replaces excluded env_smokestack.
        for (const sound of ['Gas','Nogas']) emit('Sound_'+sound,occupied?'StartSound':'StopSound');
        if (occupied) {
            emit('Sound_Start','StartSound',undefined,player);
            Instance.Delay(0.02).then(()=>{
                if(audioToken!==audioGeneration || !ready || controller.seats.get('Driver')!==player) return;
                engineVolume('Gas',0.5); // p2 P1978 PlayerOn, delay 0.02.
            });
        } else engineGuids.clear();
    },
    wreck(removingHull=false) {
        managedBrake82(2);
