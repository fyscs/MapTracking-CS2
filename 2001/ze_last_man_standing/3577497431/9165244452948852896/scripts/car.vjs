    if(!labBot84(activator)||saved.has(activator)||activator.GetParent()?.IsValid())return;
    const marker=find('Entrance_Position_'+seat);
    if(marker?.IsValid())activator.Teleport({position:marker.GetAbsOrigin(),velocity:{x:0,y:0,z:0}});
});
Instance.OnScriptInput('LabAway84',({activator})=>{
    if(!labBot84(activator)||saved.has(activator)||activator.GetParent()?.IsValid()||!body?.IsValid())return;
    const p=body.GetAbsOrigin();activator.Teleport({position:{x:p.x+600,y:p.y+600,z:p.z+100},velocity:{x:0,y:0,z:0}});
});
Instance.OnScriptInput('LabMech84Tag',({activator})=>{
    if(!labBot84(activator)||saved.has(activator))return;
    if(!labNames84.has(activator))labNames84.set(activator,activator.GetEntityName());
    activator.SetEntityName('human_mech');
});
Instance.OnScriptInput('LabMech84Untag',({activator})=>{
    if(!labBot84(activator)||saved.has(activator)||!labNames84.has(activator))return;
    activator.SetEntityName(labNames84.get(activator));labNames84.delete(activator);
});
// Read-only snapshot requested by the console-only bot fixture; no admission bypass.
// Bounded bot-only diagnostic inputs. Refuse whenever a human is connected.
function contactBot91(activator) {
    if(!ready)return undefined;
    const bots=[];
    for(let i=0;i<64;i++) {
        const c=Instance.GetPlayerController(i);if(!c?.IsValid())continue;
        if(!c.IsBot())return undefined;
        const p=c.GetPlayerPawn();if(alive(p))bots.push(p);
    }
    if(alive(activator)&&bots.includes(activator))return activator;
    return bots.length===1?bots[0]:undefined;
}
for(const [label,type,sourceName,amount] of [
    ['own_crush',1,'Body',25],['wheel_crush',1,'FLWheel',25],
    ['own_bullet',2,'Body',7],['own_blast',64,'Body',7],
    ['own_sonic',512,'Body',7],['mixed',3,'Body',7],['self_crush',1,null,7],
    ['world_crush',1,'World',25],['world_sonic',512,'World',7]]) {
    Instance.OnScriptInput('LabContact91_'+label,({activator})=>{
        activator=contactBot91(activator);if(!activator)return;
        const source=sourceName==='World'?Instance.FindEntityByClass('worldent'):sourceName?find(sourceName):activator;
        if(!source?.IsValid())return;
        const before=activator.GetHealth();
        const applied=activator.TakeDamage({damage:amount,damageTypes:type,inflictor:source});
        Instance.Msg('[LMS_PICKUP_CONTACT91_TEST] '+JSON.stringify({label,before,after:activator.GetHealth(),applied,
            slot:activator.GetPlayerController()?.GetPlayerSlot(),synthetic:true}));
    });
}
Instance.OnScriptInput('LabGround91',({activator})=>{
    activator=contactBot91(activator);if(!activator)return;
    const ground=activator.GetGroundEntity();
    Instance.Msg('[LMS_PICKUP_GROUND91] '+JSON.stringify({slot:activator.GetPlayerController()?.GetPlayerSlot(),
        position:activator.GetAbsOrigin(),ground:ground?.GetEntityName(),kind:ground?.GetClassName(),
        parent:activator.GetParent()?.GetEntityName(),body:body.GetAbsOrigin(),angles:body.GetAbsAngles(),velocity:body.GetAbsVelocity()}));
});
Instance.OnScriptInput('LabRoof92',({activator})=>{
    activator=contactBot91(activator);if(!activator||saved.has(activator))return;
    const position=transformExit({x:48,y:24,z:95},body.GetAbsOrigin(),body.GetAbsAngles());
    activator.Teleport({position,velocity:{x:0,y:0,z:-200}});
});
let airSaved92=[],airUntil92=0;
function restoreAir92() {
    for(const [entity,position] of airSaved92)if(entity.IsValid()){
        entity.Teleport({position,velocity:{x:0,y:0,z:0},angularVelocity:{x:0,y:0,z:0}});
        Instance.EntFireAtTarget({target:entity,input:'EnableMotion'});
    }
    airSaved92=[];airUntil92=0;
}
Instance.OnScriptInput('LabAir92On',({activator})=>{
    activator=contactBot91(activator);if(!activator||airSaved92.length)return;
    airUntil92=Instance.GetGameTime()+15;
    airSaved92=PHYSICS_BODIES.map(n=>{const e=find(n);return [e,e.GetAbsOrigin()];});
    for(const [entity,p] of airSaved92){
        Instance.EntFireAtTarget({target:entity,input:'DisableMotion'});
        entity.Teleport({position:{...p,z:p.z+128},velocity:{x:0,y:0,z:0},angularVelocity:{x:0,y:0,z:0}});
    }
});
Instance.OnScriptInput('LabAir92Off',()=>{if(contactBot91(undefined))restoreAir92();});
Instance.OnScriptInput('LabExit92Probe',({activator})=>{
    activator=contactBot91(activator);if(!activator)return;
    const previous=saved.get(activator);if(!previous)return;
    const context=exitContext(activator,previous);
    Instance.Msg('[LMS_PICKUP_EXIT92_PROBE] '+JSON.stringify({context,
        candidates:exitCandidates(context).map(c=>({local:c.local,result:probeExit(activator,c)??null}))}));
});
Instance.OnScriptInput('LabState83',()=>{
    const info=player=>({valid:player.IsValid(),alive:alive(player),
        slot:player.IsValid()?player.GetPlayerController()?.GetPlayerSlot():undefined});
    const seated=controller.seats.get('Driver');
