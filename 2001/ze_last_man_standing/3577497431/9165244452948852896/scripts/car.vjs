                stockGuard181.release(player);
                player.SetEntityName(state.stockName181);player.SetParent(undefined);player.SetMoveType(state.moveType);
                player.Teleport({position:state.position,velocity:{x:0,y:0,z:0}});saved.delete(player);return false;
            }
        }
        return true;
    },
    detach(player, seat, reason) {
        const previous=saved.get(player);
        if (!player.IsValid()) {stockGuard181.release(player);saved.delete(player);pendingExits.delete(player);return true;}
        // Respawns and another mechanic may have already taken ownership of this pawn.
        const parent=player.GetParent();
        if(parent?.IsValid() && parent!==previous?.parent) {
            stockGuard181.release(player);
            if(previous?.stockName181!==undefined&&player.GetEntityName()==='lms_pickup_driver186')player.SetEntityName(previous.stockName181);
            saved.delete(player);pendingExits.delete(player);return true;
        }
