let lastExit190=null;
// Requested exits never wait for the truck to stop or for a grounded landing.
// Prefer the existing exit region, then clear space on the other side/roof.
// If every candidate is blocked, release in place; never keep the seat locked.
function chooseExit190(context,grounded,clear,current){
    const landing=selectExit(context,grounded);
    if(landing)return {position:landing,mode:'grounded'};
    const candidates=exitCandidates(context);
    for(const c of candidates)if(clear(c.expected))return {position:c.expected,mode:'airborne_clear'};
    if(finitePosition(context.center)&&context.angles){
        for(const c of candidates){
            const local={...c.local,y:-c.local.y};
            const p=transformExit(local,context.center,context.angles);
            if(clear(p))return {position:p,mode:'opposite_clear'};
        }
        for(const z of [100,136,172]){
            const p={x:current.x,y:current.y,z:context.center.z+z};
            if(clear(p))return {position:p,mode:'above_clear'};
        }
    }
    return {position:undefined,mode:'release_in_place'};
}
function requestedExit190(player,previous,seat){
    const context=exitContext(player,previous,seat);
    const ignore=[player,...Instance.FindEntitiesByName(PREFIX+'*')];
    const from=seatEyeTarget90(seat)??player.GetEyePosition();
    const clear=p=>{
        if(!clearPosition(player,p))return false;
        const path=Instance.TraceLine({start:from,end:{...p,z:p.z+64},ignoreEntity:ignore});
        return !path.startedInSolid&&!path.didHit;
    };
    return chooseExit190(context,c=>probeExit(player,c),clear,player.GetAbsOrigin());
}
const adapter = {
    killOccupants:killPickupOccupants189,
    pendingValid(player) {return alive(player)&&!player.GetParent()?.IsValid();},
    playerSlot(player) {return player.GetPlayerController()?.GetPlayerSlot();},
    pendingDriverChanged(pending,player) {
        emit('Button_Driver',pending||controller.seats.has('Driver')?'Lock':'Unlock',undefined,player);
    },
    guardFault(error) {Instance.Msg('LMS pickup driver admission failed; driving disabled for this request.');},
    eligible(player, seat) {
        if (!ready || !physics164.ready || !backend164alive() || !body?.IsValid() || !alive(player) || ![2,3].includes(player.GetTeamNumber())) return false;
        if (seat === 'Mech' && player.GetEntityName() !== 'human_mech') return false;
        const marker = find('Entrance_Position_' + seat);
        // 160 is a provisional sample admission distance, not a recovered p2 parameter.
