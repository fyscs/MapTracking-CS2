const {TANK_COMBAT} = __axp_0;
// Keep the precision reticles independent from the seat HUD; both seats share the tank clock and counter.
function updateCrewStatus(hud,seat,tank,time) {
  if (!hud) return;
  const gunner=seat.role==='gunner';
  const integrity=tank.remaining+' / '+TANK_COMBAT.durability[tank.team];
  if (seat.hpText!==integrity) {
    hud.SetDialogVariableStringForPlayer(seat.slot,'HullValue','durability',integrity);
    seat.hpText=integrity;
  }
  if(tank.team===3){
    const automatic=tank.repairRequired===0;
    const count=automatic?'最后幸存者':tank.repairNear+' / '+tank.repairRequired;
    if(seat.autoRepairShown!==automatic){
      hud.SetHasClassForPlayer(seat.slot,'AutoRepairHint','Shown',automatic);
      seat.autoRepairShown=automatic;
    }
    const status=tank.hullHP[3]===TANK_COMBAT.durability[3]?'无需维修':
      tank.repairAt===null?'等待维修人员':Math.max(0,Math.ceil(tank.repairAt-time))+' 秒后 +1 HP';
    if(seat.repairCount!==count){
      hud.SetDialogVariableStringForPlayer(seat.slot,'RepairCount','repaircount',count);
      seat.repairCount=count;
    }
    if(seat.repairStatus!==status){
      hud.SetDialogVariableStringForPlayer(seat.slot,'RepairState','repairstate',status);
      seat.repairStatus=status;
    }
  }
  if(!seat.statusVisible)hud.SetHasClassForPlayer(seat.slot,'CrewStatus','Human',tank.team===3);
  if (gunner) {
    const ticks=Math.max(0,Math.ceil((tank.nextShot-time)*10));
    if (ticks!==seat.reloadTicks) {
      const text=ticks===0?'已就绪':(ticks/10).toFixed(1)+' 秒';
      hud.SetDialogVariableStringForPlayer(seat.slot,'ReloadValue','loading',text);
      if (!seat.statusVisible || (ticks===0)!==(seat.reloadTicks===0))
        hud.SetHasClassForPlayer(seat.slot,'ReloadValue','Ready',ticks===0);
      seat.reloadTicks=ticks;
    }
  }
  if (!seat.statusVisible) {
    hud.SetHasClassForPlayer(seat.slot,'ReloadRow','Gunner',gunner);
    hud.SetHasClassForPlayer(seat.slot,'CrewStatus','Mounted',true);
    seat.statusVisible=true;
  }
}

return {updateCrewStatus};
})();
