  else if(action==='MapUnlock147'){locked=false;entry();}
  else if(action==='MapClose147'){closed=true;crew?.clear('map_close');commands.clear();physics.stop();entry();}
  else if(action==='MapEject147'){crew?.clear('map_eject');commands.clear();physics.stop();}
  else if(action==='MapKillHumanCrew147'){
    for(const [p] of [...(crew?.mounted||[])])if(p.IsValid()&&p.GetTeamNumber()===3){crew.release(p,'map_execute',true);p.SetHealth(-1);}
  } else if(action==='MapRampEnter147'){if(data.caller)ramps.add(data.caller);}
  else if(action==='MapRampLeave147'){if(data.caller)ramps.delete(data.caller);}
}
function tick(){
  if(!ready||mapRetired)return;
  if(carry){
    if(!carry.holder.IsValid()){retireForMap();carry=null;return;}
    move(carry.source,pose(carry.holder),carry.bodies);
  } else if(parked&&tank.seats.driver&&!locked&&!closed){parked=false;physics.motion(true);}
  entry();
}
return {
  run,tick,blocked:()=>parked||!!carry,ramps:()=>ramps.size>0,
  reset(){locked=false;closed=false;parked=false;carry=null;ramps.clear();},
  flush(){for(const [a,d] of pending.splice(0))run(a,d);},
  status:()=>({locked,closed,parked,carried:!!carry,ramps:ramps.size})
};
})();
for(const name of ['MapStage1Spawn147','MapStage1Extreme147','MapStage4Spawn147','MapStage5Spawn147','MapStage5Lift147','MapCarry147','MapPark147','MapWake147','MapLock147','MapUnlock147','MapClose147','MapEject147','MapKillHumanCrew147','MapRampEnter147','MapRampLeave147'])
  Instance.OnScriptInput(name,data=>{try{story147.run(name,data);}catch(e){stop(e);}});

// A short lease and explicit acknowledgement keep armed admission fail-closed.

// CS2Fixes 2.1-lms164 heartbeat; stock CS2Fixes does not implement this channel.
// Resolve the unique point_script: Valve exposes no GetSelf method.
function scriptEntity164(){
    const matches=Instance.FindEntitiesByName('lms_ax_manager');
    return matches.length===1 && matches[0]?.IsValid() && matches[0].GetClassName()==='point_script' ? matches[0] : undefined;
}
// Uses ONLY the upstream CS2Fixes point_viewcontrol Disarm flag (128).
// Does not destroy, drop or replace weapons. Input is still read from CSInputs.
class StockSeatGuard {
    constructor(api,manager){
        this.api=api;this.manager=manager;this.seats=new Map();this.botProbes=false;this.escapedAttacks=0;
        const attack=({weapon})=>{
            const pawn=weapon?.GetOwner();
            if(pawn&&this.seats.has(pawn)){
                this.escapedAttacks++;
                api.Msg('[LMS181_ATTACK_ESCAPED] '+JSON.stringify({manager,slot:pawn.GetPlayerController()?.GetPlayerSlot(),weapon:weapon.GetClassName()}));
            }
        };
        api.OnGunFire(attack);
        api.OnKnifeAttack(attack);
    }
    supported(){return typeof this.api.EntFireAtTarget==='function';}
    eligible(p){
        const c=p?.IsValid()?p.GetPlayerController():null;
        return !!c&&p.IsAlive()&&c.IsConnected()&&c.GetPlayerPawn()===p&&(!c.IsBot()||this.botProbes);
    }
    acquire(p,position){
        if(this.seats.has(p))return this.valid(p);
        if(!this.eligible(p))return false;
        const target=p.GetEntityName(),slot=p.GetPlayerController().GetPlayerSlot();
        const proxies=this.api.FindEntitiesByName('LMS_SeatDisarm186_'+target);
        const pawns=this.api.FindEntitiesByName(target);
        const anchors=this.api.FindEntitiesByName('LMS_SeatCamera187_'+target);
        if(anchors.length!==1||!anchors[0]?.IsValid()||anchors[0].GetClassName()!=='prop_dynamic'||anchors[0].GetParent()?.IsValid()||proxies.length!==1||!proxies[0]?.IsValid()||proxies[0].GetClassName()!=='logic_relay'||pawns.length!==1||pawns[0]!==p){
            this.api.Msg('[LMS187_SEAT_GUARD_MISSING] '+JSON.stringify({manager:this.manager,target,slot}));
            return false;
        }
        const proxy=proxies[0],bot=p.GetPlayerController().IsBot();
        // Upstream refuses bots. They still exercise the same map lookup and seating path.
        const anchor=anchors[0];
        anchor.SetColor({r:255,g:255,b:255,a:0});
        anchor.Teleport({position,angles:p.GetEyeAngles()});
        this.seats.set(p,{proxy,target,bot,anchor});
        try{if(!bot)this.api.EntFireAtTarget({target:proxy,input:'EnableCamera',activator:p});}
        catch(e){this.seats.delete(p);throw e;}
        this.api.Msg('[LMS187_SEAT_GUARD] '+JSON.stringify({manager:this.manager,target,slot,bot}));
        return true;
    }
    ownsView(p){const seat=this.seats.get(p);return !!seat&&!seat.bot;}
    viewPosition(p){return this.ownsView(p)?this.seats.get(p).anchor.GetAbsOrigin():undefined;}
    move(p,position){const seat=this.seats.get(p);if(seat?.anchor.IsValid())seat.anchor.Move({position,angles:p.GetEyeAngles()});}
    valid(p){
        const state=this.seats.get(p);
        return !!state&&this.eligible(p)&&state.proxy.IsValid()&&state.anchor.IsValid()&&p.GetEntityName()===state.target;
    }
    release(p){
        const state=this.seats.get(p);
        if(!state)return;
        this.seats.delete(p);
        if(!state.bot&&state.proxy.IsValid()&&p?.IsValid()){
            this.api.EntFireAtTarget({target:state.proxy,input:'DisableCamera',activator:p});
        }
    }
    reset(){for(const p of [...this.seats.keys()])this.release(p);}
    status(){return {backend:'official_cs2fixes_point_viewcontrol',runtimeAcknowledgement:false,
        cameraAndAttackHumanTestPending:true,escapedAttacks:this.escapedAttacks,seats:this.seats.size,botProbes:this.botProbes};}
}

const stockGuard181=new StockSeatGuard(Instance,'tank');
function resetBackend164(){stockGuard181.reset();}
const backend164alive=()=>!!scriptEntity164()&&stockGuard181.supported();
const guard147={
    admit:(_role,p)=>stockGuard181.eligible(p),
    valid:p=>stockGuard181.valid(p),release:p=>stockGuard181.release(p),
    tick(){for(const p of [...stockGuard181.seats.keys()])if(!stockGuard181.valid(p))crew?.release(p,'stock_guard_lost',true);},
    clear:()=>stockGuard181.reset()
};

function emitTelemetry(tag='manual'){
  const pose=entity=>({origin:entity.GetAbsOrigin(),angles:entity.GetAbsAngles()});
  const bodies=Object.fromEntries(['root','front','rear'].map(key=>{
    const entity=physics.entities[key];return [key,{...pose(entity),velocity:entity.GetAbsVelocity(),angularVelocity:entity.GetAbsAngularVelocity()}];
  }));
  const parts=Object.fromEntries(['live:Hull','live:Turret','live:Gun','live:Barrel','wreck:Hull','wreck:Turret','wreck:Barrel'].map(key=>
    [key,{...pose(binding.parts[key]),requestedVisible:binding.visible.get(key)===true}]));
  // Engine Msg truncates long lines near 2 KB. Emit individually bounded records.
  const frame=++telemetrySerial;
  for(const [key,value] of Object.entries(bodies))Instance.Msg('[AX_BODY] '+JSON.stringify({frame,key,...value}));
  for(const [key,value] of Object.entries(parts))Instance.Msg('[AX_PART] '+JSON.stringify({frame,key,...value}));
  Instance.Msg('[AX_TELEMETRY] '+JSON.stringify({frame,tag,time:now(),command:commands.sample(now()),destroyed:tank.destroyed,
    previewYaw,previewPitch,roundActive,controllerPlan:physics.lastPlan,samplePhase:'after_visual_update',runtimeMass:'unavailable_in_public_script_API'}));
}
const probeActions={
  sample:tag=>pendingSamples.push(tag),report:value=>Instance.Msg('[AX_PROBE] '+JSON.stringify(value)),
  input:name=>{
    Instance.Msg('[AX_PROBE] '+JSON.stringify({kind:'send_input',name,time:now()}));
    const found=Instance.FindEntitiesByName('lms_ax_manager');if(found.length!==1)throw Error('Probe manager missing');
    Instance.EntFireAtTarget({target:found[0],input:'RunScriptInput',value:name});
  }
};
const probe=COURSE_PROBE!=='none'?new CourseProbe(probeActions,COURSE_PROBE,()=>({position:anchor.GetAbsOrigin(),angles:physics.bodyAngles()}))
  :AUTO_PROBE?new ProbeSequence(probeActions):null;
function readPose(){return poseFromSource(anchor.GetAbsOrigin(),physics.bodyAngles(),previewYaw,previewPitch);}
function draw(time,shot=null){
  if(!mapRetired)lastPose=readPose();
  const result=visuals.update(time,lastPose);binding.apply(result);binding.applyTeamColor(tank.team);
  wreckFx.update(time,result.phase);
  entryMarkers?.sync(tank,roundActive&&crew.active);
  if(crew&&result.parts&&['idle','firing'].includes(result.phase)){
    const ray=visualMuzzleRay(result.parts.Barrel);crew.updateSight(time,ray);
    if(shot){const gun=result.parts.Gun;const breech={x:40*gun[3],y:40*gun[7],z:40*gun[11]};
      shells.launch(shot,ray,breech,crew.mounted.keys());}
  }
}
function stop(error){
  entryMarkers?.sync(tank,false);
  wreckFx.clear();
  if(crew){crew.active=false;crew.clear('stopped');}
  guard147.clear();
  ready=false;roundActive=false;sweep=false;pendingSamples.length=0;commands.clear();physics.stop();
  visuals.recoil.cancel();visuals.death.cancelEffects();binding.hideAll();
  Instance.Msg('[AbramsX physics] stopped: '+String(error));
}
function reset(newRound=true){
  if(mapRetired&&!newRound)return;
  if(mapRetired){
    for(const key of ['root','front','rear'])physics.fire(key,'SetEnableCollisions','1');
    mapRetired=false;
  }
  if(newRound){story147.reset();guard147.clear();}
  // On a clock rewind, translate outstanding deadlines before releasing any more pawns.
  const time=now();
  if(tank.lastTime!==null&&time<tank.lastTime){
    tank.spawnUnlockAt=time+Math.max(0,tank.spawnUnlockAt-tank.lastTime);
    for(const role of ['driver','gunner']){
      tank.entryUnlockAt[role]=time+Math.max(0,tank.entryUnlockAt[role]-tank.lastTime);
    }
  }
  wreckFx.clear();
  if(shells)shells.active=null;
  if(crew){crew.clear('round_reset');crew.active=roundActive;}
  commands.clear();physics.stop();visuals.resetRound(newRound);previewYaw=0;previewPitch=0;sweep=false;lastTime=null;
  // Keep the current physical pose. Restoring a spawn pose while hinges are alive is not attempted.
  if(ready){tank.localPitch=2;previewPitch=2;physics.motion(roundActive);draw(now());}
}
function activate(){
  resetBackend164();
  try{
    if(crew){crew.active=false;crew.clear('reactivate');}
    anchor=physics.bind();
    binding.bind();wreckFx.bind();
    if(!isLab()&&!isFormal()){physics.motion(false);throw Error('Unsupported tank map: '+Instance.GetMapName()+'; expected full-map marker entities or a supported lab');}
    let hud=null;
    entryMarkers=null;
    if(isFormal()||mapName()==='lms_abramsx_pickup_lab'){
      if(Instance.FindEntitiesByName('lms_m1a2_nohurt').length!==1)throw Error('Missing tank crew damage filter');
      entryMarkers=new SeatMarkers(Instance);
      const found=Instance.FindEntitiesByName('lms_ax_sight_hud');
      if(found.length!==1||typeof found[0].SetHasClassForPlayer!=='function')throw Error('Gunner sight HUD missing');
      hud=found[0];if(typeof hud.SetDialogVariableStringForPlayer!=='function')throw Error('Per-player HUD variables unavailable');
      hud.Reset();Instance.Msg('[AX_SIGHT_HUD] bound revision125');
    }
    crew=isCrew()?new CrewBinding(Instance,{CSInputs,CSMoveType,CSGearSlot,CustomCameraMode},tank,anchor,value=>Instance.Msg('[AX_CREW] '+JSON.stringify(value)),hud,[...Object.values(binding.parts),...Object.values(physics.entities)],binding.parts['live:Hull'],()=>physics.bodyAngles()):null;
    const blast=Instance.FindEntitiesByName('lms_m1a2_125_shell_blast');
    if(blast.length!==1)throw Error('Missing repeatable shell explosion');
    const sounds=Instance.FindEntitiesByName('m1_127_fire_sound');
    if(sounds.length!==1||!sounds[0].IsValid())throw Error('Missing original cannon sound');
    cannonSound=sounds[0];
    const distant=Instance.FindEntitiesByName('m1_145_shell_distant');
    if(distant.length!==1||!distant[0].IsValid())throw Error('Missing original distant shell sound');
    shells=new TankShell(Instance,blast[0],[...Object.values(binding.parts),...Object.values(physics.entities)],distant[0],Instance.FindEntityByName('LMS173_ShellFX_Template'));
    anchor.SetHealth(1000000);
    ready=true;roundActive=true;reset();
    if(spawnRoot!==anchor){tank.lockSpawn(now());spawnRoot=anchor;}
    story147.flush();
    if(probe)probe.reset(now());Instance.SetNextThink(now());
    Instance.Msg('[M1A2 127] original drive bound');
  }catch(error){stop(error);}
}
function lab(action){
  if(!ready||!roundActive||!isLab()){Instance.Msg('[AbramsX physics] lab input rejected.');return;}
  if(crew?.occupied()){Instance.Msg('[AbramsX physics] preview control rejected while occupied.');return;}
  try{action(now());}catch(error){stop(error);}
}
Instance.OnActivate(activate);
Instance.SetThink(()=>{
  if(!ready)return;
  try{
    const time=now();if(!anchor.IsValid()&&!mapRetired)retireForMap();
    if(lastTime!==null&&time<lastTime)reset();
    if(lastTime!==null&&time-lastTime>DRIVE.lease)commands.clear();
    if(probe&&roundActive)probe.tick(time);
    story147.tick();guard147.tick();
    let shot=null;
    if(roundActive)shells.tick(time);
    if(crew&&roundActive&&!tank.destroyed){
      const hadCrew=crew.occupied(),result=crew.tick(time),controlled=hadCrew||crew.occupied();
      if(controlled){commands.clear();sweep=false;previewYaw=result.localTurretYaw;previewPitch=result.localTurretPitch;}
      if(!story147.blocked())physics.apply(controlled?result.drive:commands.sample(time),time,!!tank.seats.driver||(!controlled&&commands.from>=0));if(result.shot){shot=result.shot;fireRecoilAndSound(shot,time);Instance.Msg('[AX_CREW_SHOT] '+JSON.stringify({id:shot.id,time}));}
    }else if(roundActive&&!tank.destroyed&&!story147.blocked())physics.apply(commands.sample(time),time);
    if(sweep&&!tank.destroyed&&lastTime!==null)previewYaw=(previewYaw+Math.min(.1,time-lastTime)*tank.config.yawRate)%360;
    draw(time,shot);for(const tag of pendingSamples)emitTelemetry(tag);pendingSamples.length=0;
    lastTime=time;Instance.SetNextThink(time+(crew?1/128:1/60));
  }catch(error){stop(error);}
});
// Round restart replaces prop entities while the point_script may survive.
Instance.OnRoundStart(activate);
Instance.OnRoundEnd(()=>{guard147.clear();roundActive=false;entryMarkers?.sync(tank,false);wreckFx.clear();if(crew){crew.active=false;crew.clear('round_end');}sweep=false;commands.clear();physics.stop();});
Instance.OnScriptReload({before:()=>{stop('script_reload');return {};},after:()=>activate()});
for(const name of ['DriveForward','DriveReverse','DriveLeft','DriveRight','DriveStop'])Instance.OnScriptInput(name,()=>lab(time=>{
  if(tank.destroyed)return;commands.request(name,time);if(name==='DriveStop')physics.stop();
  if(probe)Instance.Msg('[AX_INPUT] '+JSON.stringify({name,time}));
}));
Instance.OnScriptInput('DriveStatus',()=>lab(time=>{draw(time);emitTelemetry();}));
Instance.OnScriptInput('PreviewFire',()=>lab(time=>{
  if(tank.destroyed||time<tank.nextShot)return;tank.nextShot=time+tank.config.cooldown;
  fireRecoilAndSound({id:`${tank.id}:${tank.epoch}:${++tank.serial}`,time},time);draw(time);
}));
function destroyZombie(time){
  if(tank.destroyed)return;
  commands.clear();physics.stop();physics.motion(false);sweep=false;
  const result=visuals.beginDestruction({kind:'zombie_durability_zero',epoch:tank.epoch,teamAtDeath:2,
    remainingDurability:0,roundActive,time,pose:readPose()});
  if(result.accepted){binding.apply({...result,phase:'destroying'});wreckFx.start(time);}
}
Instance.OnScriptInput('PreviewZombieDestroy',()=>lab(destroyZombie));
Instance.OnScriptInput('PreviewReset',()=>lab(()=>{if(tank.hullHP[2]>0)reset(false);}));
// RCON on a dedicated server may have no issuing player for ent_fire.
// Dispatch only the existing, unoccupied-lab preview inputs.
Console.RegisterCheatCommand('m1_wreck_preview',args=>{
  const action={turn:'PreviewTurret45',destroy:'PreviewZombieDestroy',reset:'PreviewReset',fire:'PreviewFire'}[args.trim()];
  if(typeof action!=='string'||!ready||!isLab()||crew?.occupied())return;
  const manager=Instance.FindEntitiesByName('lms_ax_manager')[0];
  Instance.EntFireAtTarget({target:manager,input:'RunScriptInput',value:action});
});
function retireForMap(){
  if(!ready||!roundActive||mapRetired)return;
  mapRetired=true;guard147.clear();
  const time=now();
  commands.clear();physics.stop();sweep=false;shells.active=null;tank.repairAt=null;
  if(anchor.IsValid())lastPose=readPose();
  crew?.clear('map_retire');
  for(const key of ['root','front','rear']){
    if(!physics.entities[key]?.IsValid())continue;
    physics.fire(key,'DisableMotion');
    physics.fire(key,'SetEnableCollisions','0');
  }
  if(!tank.destroyed){
    const result=visuals.beginDestruction({kind:'map_retire',epoch:tank.epoch,roundActive,time,pose:lastPose});
    if(result.accepted){binding.apply({...result,phase:'destroying'});wreckFx.start(time);}
  }
  entryMarkers?.sync(tank,false);
}
Instance.OnScriptInput('MapRetire',retireForMap);

function ejectDepletedCrew(time){
  const team=tank.team;
  commands.clear();physics.stop();sweep=false;
  try{crew.clear('hull_depleted');}finally{if(team===2)destroyZombie(time);}
}
Instance.OnScriptInput('CoreDeplete',()=>{
  if(!ready||!roundActive||tank.destroyed||!tank.team)return;
  tank.hullHP[tank.team]=0;
  ejectDepletedCrew(now());
});

Instance.OnScriptInput('HullHit',({activator,caller})=>{
  if(!roundActive||!ready||!crew||!tank.team||caller!==anchor||!activator?.IsValid())return;
  const attacker=activator.GetPlayerController?activator:activator.GetOwner();
  if(!attacker?.IsValid()||!attacker.GetPlayerController||!tank.hullHit(attacker.GetTeamNumber()))return;
  if(tank.remaining>0)return;
  ejectDepletedCrew(now());
});
Instance.OnScriptInput('PreviewTurret45',()=>lab(time=>{if(tank.destroyed)return;previewYaw=45;previewPitch=0;sweep=false;draw(time);}));
Instance.OnScriptInput('PreviewPitch',()=>lab(time=>{if(tank.destroyed)return;previewPitch=-6;draw(time);}));
Instance.OnScriptInput('PreviewSweep',()=>lab(()=>{if(!tank.destroyed)sweep=!sweep;}));
for(const [name,role] of [['EnterDriver','driver'],['EnterGunner','gunner']])Instance.OnScriptInput(name,({activator})=>{
  if(crew&&activator?.GetPlayerController)crew.enter(role,activator);
});
for(const event of ['OnPlayerReset','OnPlayerTeamChanged','OnPlayerKill'])Instance[event](({player})=>crew?.release(player,event,true));
// The map I/O filter is queued. Cover the admission frame with the native pre-damage callback.
Instance.OnModifyPlayerDamage(({player})=>{if(crew?.mounted.has(player))return {abort:true};});
Instance.OnPlayerDisconnect(({playerSlot})=>crew?.disconnect(playerSlot));
Instance.OnBeginRoundRestart(()=>{guard147.clear();ready=false;roundActive=false;entryMarkers?.sync(tank,false);wreckFx.clear();if(crew){crew.active=false;crew.clear('round_restart');}commands.clear();physics.stop();});
Instance.OnPlayerChat(({player,text})=>{
  if(!crew||!player)return;const p=player.GetPlayerPawn();
  if(text==='/tank driver')crew.enter('driver',p);
  if(text==='/tank gunner')crew.enter('gunner',p);
});
// Empty-lab telemetry and the same finite lease used by the driving buttons.
Console.RegisterCheatCommand('m1_drive_sample',args=>lab(time=>{
  const name=args.trim();
  if (['DriveForward','DriveReverse','DriveLeft','DriveRight','DriveForwardLeft','DriveForwardRight','DriveNeutral','DriveStop'].includes(name)) commands.request(name,time);
  Instance.Msg('[M1_DRIVE] '+JSON.stringify({time,pos:anchor.GetAbsOrigin(),angles:physics.bodyAngles(),velocity:anchor.GetAbsVelocity(),front:physics.entities.front.GetAbsOrigin(),rear:physics.entities.rear.GetAbsOrigin(),scale:physics.lastPlan}));
}));
Console.RegisterCheatCommand('ax_crew_status',()=>{
  if(!crew||!ready||!anchor?.IsValid())return;
  Instance.Msg('[AX_CREW_STATUS] '+JSON.stringify({driveRevision:147,story:story147.status(),mapRetired,spawnLockSeconds:__axp_0.TANK_COMBAT.spawnLockSeconds,spawnUnlockAt:tank.spawnUnlockAt,spawnLockRemaining:Math.max(0,tank.spawnUnlockAt-now()),hullHP:tank.hullHP,repair:{near:tank.repairNear,required:tank.repairRequired,alive:tank.repairAlive,next:tank.repairAt},entryCooldownSeconds:__axp_0.TANK_COMBAT.entryCooldown,entryUnlockAt:tank.entryUnlockAt,seatResetSeconds:0.1,entryMarkers:entryMarkers?.visible,rollSupport:'tracks',exitInput:'jump',precisionAim:'player',gunnerPitchRate:tank.config.pitchRate,time:now(),seats:crew.status(),root:anchor.GetAbsOrigin(),angles:physics.bodyAngles(),yaw:previewYaw,pitch:previewPitch,
    players:Instance.GetAllPlayerControllers().filter(c=>c.IsConnected()).map(c=>({slot:c.GetPlayerSlot(),bot:c.IsBot(),team:c.GetPlayerPawn()?.GetTeamNumber(),alive:c.GetPlayerPawn()?.IsAlive()}))}));
});
Console.RegisterCheatCommand('ax_sight_status',()=>{
  if(!crew||!ready)return;
  Instance.Msg('[AX_SIGHT_STATUS] '+JSON.stringify({revision:127,time:now(),wreckStarted:wreckFx.startTime,wreckFlash:wreckFx.flashed,destroyed:tank.destroyed,wreckShown:binding.visible.get('wreck:Hull'),firePoint:wreckFx.entities.fire_2.GetAbsOrigin(),durability:tank.remaining,nextShot:tank.nextShot,projectionBaseFov:90,
    slots:[...crew.sight.slots].map(([slot,s])=>({slot,active:s.active,sample:s.sample}))}));
});
// Diagnostic build only: synthetic inputs are restricted to bots, with no humans connected.
// The local RCON launcher enables test controls explicitly. No server convar needs
// to be exposed to the map script. Public rounds start with the controls disabled.
let localTestEnabled173=false;
Instance.OnScriptInput('EnableLocalAcceptance173',({activator,caller})=>{
  if(!activator?.IsValid()&&(!caller?.IsValid()||caller.GetClassName()==='worldspawn')){localTestEnabled173=true;stockGuard181.botProbes=true;}
});
Console.RegisterCheatCommand('ax_crew_probe',args=>{
  if(!CREW_PROBE&&!localTestEnabled173)return;
  if(!crew)return;const controllers=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected());
  if(controllers.some(c=>!c.IsBot()))throw Error('Bot-only diagnostic refuses human clients');
  const [action,slotText,role='driver']=args.trim().split(/\s+/),c=controllers.find(c=>c.GetPlayerSlot()===Number(slotText)),p=c?.GetPlayerPawn();
  if(action==='mount'&&p&&Object.hasOwn(CREW_ENTRY,role)){if(!isFormal())p.DestroyWeapons();
    const entry=CREW_ENTRY[role];p.Teleport({position:crew.world({...entry,z:role==='driver'?4:entry.z+3}),velocity:{x:0,y:0,z:0}});crew.enter(role,p);
  }
  if(action==='exit'&&p)crew.release(p,'diagnostic_exit');
  if(action==='clear'){crew.clear('diagnostic_clear');crew.override=null;}
  if(action==='input'){
    const start=now(),duration=Math.min(3,Math.max(0,Number(slotText)||0));
    crew.override=(seat,_p,time)=>time-start<duration?(seat==='driver'?{forward:true,left:role==='turn',back:false,right:false}:{aim:{x:0,y:1,z:.3},firePressed:time-start<.04}):{forward:false,back:false,left:false,right:false,firePressed:false};
  }
});

// R163 diagnostics do not grant admission or change health/physics.
function auditDeploy163(){
  const names=['lms_ax_manager','v_model1','lms_ax_01_roller_front','lms_ax_01_roller_rear','lms_m1a2_nohurt','lms_ax_sight_hud','lms_m1a2_125_shell_blast','m1_127_fire_sound','m1_145_shell_distant','LMS_Tank_Guard_Request147'];
  const found=Object.fromEntries(names.map(n=>[n,Instance.FindEntitiesByName(n).filter(e=>e.IsValid()).map(e=>({cls:e.GetClassName(),position:e.GetAbsOrigin()}))]));
  Instance.Msg('[LMS_DEPLOY163_TANK] '+JSON.stringify({map:Instance.GetMapName(),formal:isFormal(),lab:isLab(),ready,roundActive,mapRetired,story:story147.status(),found,admissionBackend:'official CS2Fixes + map seats181',mapControllerReady:backend164alive(),protection:stockGuard181.status()}));
}
Console.RegisterCheatCommand('ax_deploy_audit163',auditDeploy163);
Instance.OnScriptInput('Audit163',auditDeploy163);

Console.RegisterCheatCommand('lms181_tank_version',()=>Instance.Msg('[LMS181_VERSION] '+JSON.stringify({vehicle:'tank',revision:'187',ready,formal:isFormal(),guard:stockGuard181.status()})));

Instance.Msg("[LMS181_TANK] official-backend compatibility candidate; human protection test pending");
