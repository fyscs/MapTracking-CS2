import {Instance,Console,CSMoveType,CSDamageTypes,CSDamageFlags} from 'cs_script/point_script';

const RULES = Object.freeze({capacity:2, recharge:30, armDelay:1.5, damage:1000, hold:3, height:216, rise:0.25});

// Ammo belongs to the artifact weapon, never to the player or a global name.
class Magazine {
  constructor(now=0){this.ammo=RULES.capacity;this.due=null;this.busy=false;this.notice='';this.noticeUntil=now;}
  update(now){
    let added=0;
    while(this.due!==null && now>=this.due && this.ammo<RULES.capacity){
      this.ammo++;added++;this.due=this.ammo<RULES.capacity?this.due+RULES.recharge:null;
    }
    if(added){this.notice='自然补充 +'+added;this.noticeUntil=now+2;}
    return added;
  }
  spend(now){this.update(now);if(this.ammo<=0)return false;this.ammo--;if(this.due===null)this.due=now+RULES.recharge;return true;}
  recover(now){this.update(now);if(this.ammo>=RULES.capacity)return false;this.ammo++;if(this.ammo===RULES.capacity)this.due=null;this.notice='已回收 +1';this.noticeUntil=now+2;return true;}
  remaining(now){this.update(now);return this.due===null?0:Math.max(0,this.due-now);}
}

const magazines=new Map(), mines=new Set(), blasts=new Set(), lifts=new Map(), landGuards=new Map();
const visibleSlots=new Set();let hud=null,paused=false,nextScan=0,nextHud=0;
const zero=()=>({x:0,y:0,z:0}), pos=e=>({...e.GetAbsOrigin()}), now=()=>Instance.GetGameTime();
const valid=e=>!!e?.IsValid(), alive=e=>valid(e)&&e.GetClassName()==='player'&&e.IsAlive();
const named=(e,n)=>valid(e)&&e.GetEntityName().startsWith(n);
const own=w=>valid(w)?w.GetOwner():undefined;
const ct=p=>alive(p)&&p.GetTeamNumber()===3, zombie=p=>alive(p)&&p.GetTeamNumber()===2;
const distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);
function fire(target,input,value,delay=0){if(valid(target))Instance.EntFireAtTarget({target,input,value,delay});}
function removeAll(entities){for(const e of entities||[])if(valid(e))e.Remove();}
function log(message){Instance.Msg('[MINE150] '+message);}
function isMineWeapon(weapon){
  return valid(weapon)&&typeof weapon.GetOwner==='function'&&
    (magazines.has(weapon)||named(weapon,'Weapon_Mine_Weapon')||
     (weapon.GetClassName()==='weapon_deagle'&&Instance.FindEntitiesByName('Weapon_Mine_UI*').some(e=>e.GetParent()===weapon)));
}
function ensure(weapon){
  if(!isMineWeapon(weapon))return null;
  let record=magazines.get(weapon);
  if(!record){record={weapon,stock:new Magazine(now()),buttonUntil:0};magazines.set(weapon,record);}
  return record;
}
function weaponFor(caller){
  if(isMineWeapon(caller))return caller;
  const parent=valid(caller)?caller.GetParent():undefined;
  return isMineWeapon(parent)?parent:undefined;
}
function updateHud(time){
  if(!valid(hud))hud=Instance.FindEntityByName('LMS_Mine_Hud150');
  if(!valid(hud))return;
  const seen=new Set();
  for(const {weapon,stock} of magazines.values()){
    const player=own(weapon);if(!ct(player)||tankOccupant173(player))continue;
    const slot=player.GetPlayerController()?.GetPlayerSlot();if(slot===undefined)continue;
    const left=stock.remaining(time);seen.add(slot);
    hud.SetDialogVariableStringForPlayer(slot,'MineStock','stock',stock.ammo+' / '+RULES.capacity);
    hud.SetDialogVariableStringForPlayer(slot,'MineRecharge','recharge',left>0?'下一枚：'+left.toFixed(1)+' 秒':'库存已满');
    hud.SetDialogVariableStringForPlayer(slot,'MineNotice','notice',time<stock.noticeUntil?stock.notice:'');
    hud.SetHasClassForPlayer(slot,'MinePanel','Visible',true);
  }
  for(const slot of visibleSlots)if(!seen.has(slot))hud.ResetForPlayer(slot);
  visibleSlots.clear();for(const slot of seen)visibleSlots.add(slot);
}
function hideHud(){if(valid(hud))hud.Reset();visibleSlots.clear();}
function disconnect(record){for(const id of record.connections||[])if(id!==undefined)Instance.DisconnectOutput(id);record.connections=[];}
function closeMine(mine){
  if(mine.closed)return false;
  mine.closed=true;mines.delete(mine);disconnect(mine);removeAll(mine.entities);return true;
}
function recover(mine,player){
  if(mine.closed||now()<mine.armAt||!ct(player)||own(mine.weapon)!==player)return;
  const record=magazines.get(mine.weapon);if(!record||!record.stock.recover(now()))return;
  closeMine(mine);nextHud=0;
}
// The blast owns movement until its deadline. Input capture belongs only to the
// mine layout and the affected slot. Other layouts retain their own capture.
function releaseLift(player,fallProtection=true){
  const lift=lifts.get(player);
  if(!lift)return;
  lifts.delete(player);
  try{
    if(alive(player) && !player.GetParent() && player.GetMoveType()===CSMoveType.NONE){
      player.SetMoveType(lift.move);
      player.Teleport({velocity:zero()});
      if(fallProtection)landGuards.set(player,{until:now()+2,slot:lift.slot});
    }
  }finally{
    if(lift.ownsCapture && valid(hud))hud.SetInputCaptureEnabled(lift.slot,false);
  }
}
function liftPlayer(player,time){
  if(!zombie(player)||player.GetParent())return;
  const previous=lifts.get(player);
  if(previous){previous.until=Math.max(previous.until,time+RULES.hold);return;}
  const move=player.GetMoveType();
  if(move===CSMoveType.NONE||move===CSMoveType.NOCLIP||move===CSMoveType.OBSERVER)return;
  const controller=player.GetPlayerController();
  if(!controller?.IsConnected()||controller.GetPlayerPawn()!==player)return;
  const start=pos(player);
  const ground=Instance.TraceLine({start:{...start,z:start.z+4},end:{...start,z:start.z-512},ignoreEntity:player,ignorePlayers:true});
  const floor=ground.didHit&&!ground.startedInSolid?ground.end.z:start.z;
  const target={...start,z:Math.max(start.z,Math.min(start.z+RULES.height,floor+RULES.height))};
  const sweep=Instance.TracePlayer({start,end:target,player,isDucked:player.IsDucked()});
  if(sweep.startedInSolid)return;
  if(sweep.didHit)target.z=Math.max(start.z,sweep.end.z-2);
  const slot=controller.GetPlayerSlot();
  const record={move,slot,start,target,last:start,at:time,until:time+RULES.hold,ownsCapture:false};
  lifts.set(player,record);
  try{
    if(!controller.IsBot()){
      if(!valid(hud))throw Error('Mine HUD unavailable for attack input capture');
      if(!hud.IsInputCaptureEnabled(slot)){
        record.ownsCapture=true;
        hud.SetInputCaptureEnabled(slot,true);
      }
    }
    player.SetMoveType(CSMoveType.NONE);
    player.Teleport({velocity:zero()});
  }catch(e){releaseLift(player,false);throw e;}
}
function updateLifts(time){
  for(const [player,lift] of lifts){
    if(!zombie(player)||player.GetPlayerController()?.GetPlayerSlot()!==lift.slot){releaseLift(player,false);continue;}
    if(player.GetParent()||player.GetMoveType()!==CSMoveType.NONE){releaseLift(player,false);continue;}
    // A map teleport wins over this transient effect; never drag the player back across stages.
    if(distance(pos(player),lift.last)>96){releaseLift(player);continue;}
    if(time>=lift.until){releaseLift(player);continue;}
    const t=Math.min(1,(time-lift.at)/RULES.rise);
    const goal={...lift.start,z:lift.start.z+(lift.target.z-lift.start.z)*t};
    const sweep=Instance.TracePlayer({start:pos(player),end:goal,player,isDucked:player.IsDucked()});
    if(sweep.startedInSolid){releaseLift(player);continue;}
    if(sweep.didHit)goal.z=Math.max(pos(player).z,sweep.end.z-2);
    player.Move({position:goal,velocity:zero()});lift.last={...goal};
  }
  for(const [player,guard] of landGuards)if(!alive(player)||time>=guard.until||player.GetPlayerController()?.GetPlayerSlot()!==guard.slot)landGuards.delete(player);
}
function blastTouch(blast,player){
  if(blast.closed||!zombie(player)||blast.victims.has(player))return;
  blast.victims.add(player);
  const damage={damage:RULES.damage,damageTypes:CSDamageTypes.GENERIC,
    damageFlags:CSDamageFlags.IGNORE_ARMOR|CSDamageFlags.SUPPRESS_PHYSICS_FORCE,inflictor:blast.trigger};
  if(ct(blast.placer))damage.attacker=blast.placer;
  if(valid(blast.weapon))damage.weapon=blast.weapon;
  // One direct hit, no radial falloff, no original trigger_hurt or physics-explosion damage.
  const dealt=player.TakeDamage(damage);
  if(zombie(player)&&dealt>0)liftPlayer(player,now());
}
function detonate(mine){
  if(mine.closed)return;
  const origin=valid(mine.model)?pos(mine.model):mine.last;
  const template=Instance.FindEntityByName('LMS_Mine_Blast_Template150');
  if(!valid(template)||typeof template.ForceSpawn!=='function'){log('Missing blast template; mine disabled');closeMine(mine);return;}
  const blast={entities:[],connections:[],victims:new Set(),placer:mine.placer,weapon:mine.weapon,closed:false,expires:now()+0.18};
  // Close before creating anything else, making recovery, damage and simultaneous contacts mutually exclusive.
  closeMine(mine);
  try{
    blast.entities=template.ForceSpawn(origin,{pitch:0,yaw:0,roll:0})||[];
    blast.trigger=blast.entities.find(e=>named(e,'LMS_Mine_BlastTouch150'));
    if(!valid(blast.trigger))throw Error('Blast volume not returned');
    blast.connections.push(Instance.ConnectOutput(blast.trigger,'OnStartTouch',({activator})=>blastTouch(blast,activator)));
    fire(blast.trigger,'Enable',undefined,0.01);fire(blast.trigger,'Disable',undefined,0.15);
    for(const e of blast.entities){
      if(named(e,'LMS_Mine_Particle150'))fire(e,'Start');
      if(named(e,'LMS_Mine_Sound150'))fire(e,'StartSound');
      if(named(e,'LMS_Mine_Shake150'))fire(e,'StartShake');
    }
    fire(Instance.FindEntityByName('Global_Explosion_Distant'),'StartSound');blasts.add(blast);
  }catch(error){disconnect(blast);removeAll(blast.entities);log('Blast failed: '+String(error));}
}
function place({caller,activator}){
  if(paused||!ct(activator))return;
  const weapon=weaponFor(caller),record=ensure(weapon),time=now();
  if(!record||own(weapon)!==activator||record.stock.busy||time<record.buttonUntil)return;
  record.stock.update(time);record.buttonUntil=time+0.1;
  if(record.stock.ammo<1){record.stock.notice='库存不足，等待补充';record.stock.noticeUntil=time+1;return;}
  const template=Instance.FindEntityByName('Weapon_Mine_Projectile_Template');
  const marker=Instance.FindEntitiesByName('Weapon_Mine_Projectile_Spawner*').find(e=>e.GetParent()===weapon);
  if(!valid(template)||typeof template.ForceSpawn!=='function'||!valid(marker)){log('Missing mine template or weapon spawn marker');return;}
  record.stock.busy=true;let entities=[],mine;
  try{
    entities=template.ForceSpawn(pos(marker),marker.GetAbsAngles())||[];
    const find=n=>entities.find(e=>named(e,n));
    const root=find('Weapon_Mine_Projectile_Physbox'),model=find('Weapon_Mine_Projectile_Model'),touch=find('Weapon_Mine_Projectile_Trigger'),pickup=find('Weapon_Mine_Projectile_Trigger_Pickup');
    // Trigger prefix also matches pickup. Select exact base/suffix rather than the first prefix result.
    const trigger=entities.find(e=>named(e,'Weapon_Mine_Projectile_Trigger')&&!named(e,'Weapon_Mine_Projectile_Trigger_Pickup'));
    if(![root,model,trigger,pickup].every(valid))throw Error('Incomplete projectile spawn');
    mine={weapon,placer:activator,entities,root,model,trigger,pickup,connections:[],closed:false,armAt:time+RULES.armDelay,armed:false,last:pos(model)};
    mine.connections.push(Instance.ConnectOutput(root,'OnBreak',()=>detonate(mine)));
    mine.connections.push(Instance.ConnectOutput(trigger,'OnStartTouch',({activator})=>{if(now()>=mine.armAt&&zombie(activator))detonate(mine);}));
    mine.connections.push(Instance.ConnectOutput(pickup,'OnStartTouch',({activator})=>recover(mine,activator)));
    mine.connections.push(Instance.ConnectOutput(pickup,'OnTrigger',({activator})=>recover(mine,activator)));
    if(!record.stock.spend(time))throw Error('Stock reservation failed');
    mines.add(mine);nextHud=0;
  }catch(error){if(mine)disconnect(mine);removeAll(entities);log('Placement failed without spending stock: '+String(error));}
  finally{record.stock.busy=false;}
}
function clear(){
  for(const player of [...lifts.keys()])releaseLift(player,false);
  landGuards.clear();for(const mine of [...mines])closeMine(mine);
  for(const blast of blasts){blast.closed=true;disconnect(blast);removeAll(blast.entities);}blasts.clear();
  magazines.clear();hideHud();
}
function tick(){
  const time=now();
  try{
    updateLifts(time);
    if(!paused){
      if(time>=nextScan){
        for(const e of Instance.FindEntitiesByName('Weapon_Mine_Weapon*'))ensure(e);
        // CS2 clears weapon targetname on pickup. Retain identity through the parented item button.
        for(const e of Instance.FindEntitiesByName('Weapon_Mine_UI*'))ensure(e.GetParent());
        nextScan=time+0.2;
      }
      for(const [weapon,record] of magazines){
        if(!valid(weapon)){magazines.delete(weapon);for(const mine of [...mines])if(mine.weapon===weapon)closeMine(mine);continue;}
        record.stock.update(time);
      }
      for(const mine of [...mines]){
        if(!valid(mine.root)||!valid(mine.model)){closeMine(mine);continue;}mine.last=pos(mine.model);
        if(!mine.armed&&time>=mine.armAt){mine.armed=true;fire(mine.root,'DisableMotion');fire(mine.trigger,'Enable');fire(mine.pickup,'Enable');}
      }
      if(time>=nextHud){updateHud(time);nextHud=time+0.1;}
    }
    for(const blast of blasts)if(time>=blast.expires){blast.closed=true;disconnect(blast);removeAll(blast.entities);blasts.delete(blast);}
  }catch(error){log('Tick failed; restoring controlled players: '+String(error));for(const p of [...lifts.keys()])releaseLift(p);}
  finally{Instance.SetNextThink(time+0.02);}
}
Instance.OnActivate(()=>{paused=false;hud=Instance.FindEntityByName('LMS_Mine_Hud150');hideHud();Instance.SetNextThink(now());log('Ready: 2 charges, 30s recharge, original 512-unit damage cube');});
Instance.SetThink(tick);
Instance.OnScriptInput('Place',place);
Instance.OnWeaponPickup(({weapon})=>{ensure(weapon);nextHud=0;});
Instance.OnWeaponDrop(()=>{nextHud=0;});
Instance.OnPlayerKill(({player})=>{releaseLift(player,false);landGuards.delete(player);nextHud=0;});
Instance.OnPlayerReset(({player})=>{releaseLift(player,false);landGuards.delete(player);nextHud=0;});
Instance.OnPlayerTeamChanged(({player})=>{releaseLift(player);nextHud=0;});
Instance.OnPlayerDisconnect(({playerSlot})=>{
  for(const [player,lift] of lifts)if(lift.slot===playerSlot)releaseLift(player,false);
  for(const [player,guard] of landGuards)if(guard.slot===playerSlot)landGuards.delete(player);
  if(valid(hud))hud.ResetForPlayer(playerSlot);visibleSlots.delete(playerSlot);
});
Instance.OnModifyPlayerDamage(event=>{
  if(lifts.has(event.attacker))return {abort:true};
  if((event.damageTypes&CSDamageTypes.FALL)!==0 && now()<(landGuards.get(event.player)?.until||0))return {abort:true};
});
Instance.OnPlayerLand(({player})=>{const guard=landGuards.get(player);if(guard)guard.until=Math.min(guard.until,now()+0.1);});
Instance.OnRoundEnd(()=>{paused=true;clear();});
Instance.OnBeginRoundRestart(()=>{paused=true;clear();});
Instance.OnRoundStart(()=>{clear();paused=false;nextScan=0;Instance.SetNextThink(now());});
Instance.OnScriptReload({before:()=>{paused=true;clear();},after:()=>{paused=false;hideHud();Instance.SetNextThink(now());}});
Console.RegisterCheatCommand('mine150_status',()=>log(JSON.stringify({weapons:[...magazines.values()].map(r=>({ammo:r.stock.ammo,remaining:r.stock.remaining(now()),owner:own(r.weapon)?.GetPlayerController()?.GetPlayerSlot()})),mines:mines.size,blasts:blasts.size,lifts:lifts.size,visibleSlots:[...visibleSlots]})));

// The tank assigns one of these names only after admission; each exit path restores the prior name.
function tankOccupant173(pawn) {
    const name=pawn?.GetEntityName();
    return name==='lms_tank_crew147_driver'||name==='lms_tank_crew147_gunner';
}
