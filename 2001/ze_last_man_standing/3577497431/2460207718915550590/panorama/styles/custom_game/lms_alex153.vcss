.AlexRoot {
    width:100%;
    height:100%;
}
#AlexOwner {
    horizontal-align:right;
    vertical-align:center;
    margin-right:5%;
    margin-top:24%;
    width:370px;
    padding:12px 16px;
    flow-children:down;
    background-color:#151b24ed;
    border-left:3px solid #e88273;
    visibility:collapse;
}
#AlexGlobal {
    horizontal-align:center;
    vertical-align:top;
    margin-top:15%;
    width:420px;
    padding:10px 18px;
    flow-children:down;
    background-color:#151b24e8;
    border-top:2px solid #e88273;
    visibility:collapse;
}
#AlexOwner.Visible,#AlexGlobal.Visible {
    visibility:visible;
}
.Title {
    color:#efaa9e;
    font-size:21px;
    font-weight:bold;
    margin-bottom:6px;
}
.Controls {
    color:#f3e8d5;
    font-size:17px;
    margin-bottom:10px;
}
.Row {
    width:100%;
    height:29px;
}
.Key {
    color:#bbcad8;
    font-size:17px;
    vertical-align:center;
}
.Value {
    color:#f2e9de;
    font-size:17px;
    font-weight:bold;
    horizontal-align:right;
    vertical-align:center;
}
.SkillRow {
    width:100%;
    height:38px;
}
.Selected {
    color:#f4ba76;
    font-size:25px;
    font-weight:bold;
    horizontal-align:right;
    vertical-align:center;
}
.Health {
    color:#a3e78f;
}
.Defeated .Health {
    color:#ff7777;
}
.Divider {
    width:100%;
    height:1px;
    background-color:#60708066;
    margin-top:8px;
    margin-bottom:8px;
}
.Record .Key,.Record .Value {
    color:#8fa2b4;
    font-size:15px;
}
.Current .Key,.Current .Value {
    color:#edb3a8;
}
.GlobalTitle {
    color:#efaa9e;
    font-size:17px;
    font-weight:bold;
    horizontal-align:center;
    margin-bottom:4px;
}
.GlobalRow {
    width:100%;
    height:25px;
}
.TimerRow {
    width:100%;
    height:36px;
}
.Timer {
    color:#f4ba76;
    font-size:27px;
    font-weight:bold;
    horizontal-align:right;
    vertical-align:center;
}
.Warning {
    color:#bac5cf;
    font-size:15px;
    horizontal-align:center;
    margin-top:4px;
}
.Urgent .Timer {
    color:#ff7777;
}
.Urgent {
    border-top:2px solid #ff7777;
}
.HUD_SCOREBOARD_VISIBLE #AlexOwner,.HUD_BUYMENU_VISIBLE #AlexOwner,.HUD_TEAMMENU_VISIBLE #AlexOwner,.HUD_ENDOFMATCH_VISIBLE #AlexOwner,.HUD_TEAMINTRO_VISIBLE #AlexOwner,.HUD_SCOREBOARD_VISIBLE #AlexGlobal,.HUD_BUYMENU_VISIBLE #AlexGlobal,.HUD_TEAMMENU_VISIBLE #AlexGlobal,.HUD_ENDOFMATCH_VISIBLE #AlexGlobal,.HUD_TEAMINTRO_VISIBLE #AlexGlobal {
    visibility:collapse;
}
