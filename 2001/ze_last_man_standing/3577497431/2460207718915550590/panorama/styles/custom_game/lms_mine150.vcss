.MineRoot {
    width:100%;
    height:100%;
}
#MinePanel {
    opacity:0;
    width:292px;
    horizontal-align:right;
    vertical-align:center;
    margin-right:36px;
    margin-top:220px;
    padding:16px;
    flow-children:down;
    background-color:#111b25e8;
    border:1px solid #71938888;
    border-radius:6px;
}
#MinePanel.Visible {
    opacity:1;
}
.Title {
    font-size:18px;
    font-weight:bold;
    color:#a7e9c0;
    margin-bottom:10px;
}
.Row {
    width:100%;
    flow-children:right;
}
.Key {
    font-size:18px;
    color:#cbd5df;
    width:160px;
}
.Value {
    font-size:24px;
    color:#ffffff;
    font-weight:bold;
}
.Timer {
    font-size:18px;
    color:#ffc979;
    margin-top:8px;
}
.Notice {
    font-size:16px;
    color:#95f0ae;
    height:24px;
    margin-top:5px;
}
.Hint {
    font-size:14px;
    color:#b3c1cd;
    margin-top:5px;
}
.HUD_SCOREBOARD_VISIBLE #MinePanel,.HUD_BUYMENU_VISIBLE #MinePanel,.HUD_TEAMMENU_VISIBLE #MinePanel,.HUD_ENDOFMATCH_VISIBLE #MinePanel,.HUD_TEAMINTRO_VISIBLE #MinePanel {
    opacity:0;
}
