/* Generated by StarDance */
/* https://github.com/Kxnrl */

.AxSightRoot {
    width: 100%;
    height: 100%;
    overflow: clip;
}
#AxSight {
    width: 100%;
    height: 100%;
    opacity: 0;
    overflow: clip;
}
#AxSight.Active {
    opacity: 1;
}
.GunCanvas {
    height: 100%;
    width: height-percentage(100%);
    horizontal-align: center;
    vertical-align: center;
    overflow: noclip;
    opacity: 0;
}
#AxSight.GunVisible .GunCanvas {
    opacity: 1;
}
.PositionLayer {
    width: 100%;
    height: 100%;
    overflow: noclip;
    transition-property: transform;
    transition-duration: 0.035s;
    transition-timing-function: linear;
}
.GunGlyph {
    width: 38px;
    height: 38px;
    horizontal-align: center;
    vertical-align: center;
    border: 2px solid #101510dd;
    border-radius: 50%;
}
.GunRing {
    width: 34px;
    height: 34px;
    horizontal-align: center;
    vertical-align: center;
    border: 2px solid #ffbd5a;
    border-radius: 50%;
}
.GunDot {
    width: 3px;
    height: 3px;
    horizontal-align: center;
    vertical-align: center;
    background-color: #ffbd5a;
    border: 1px solid #151510ee;
}
#AxSight.GunAligned .GunRing {
    border-color: #91ed68;
}
#AxSight.GunAligned .GunDot {
    background-color: #91ed68;
}
.PlayerAim {
    width: 28px;
    height: 28px;
    horizontal-align: center;
    vertical-align: center;
}
.Arm,.PlayerDot {
    background-color: #f6f9ff;
    border: 1px solid #111820ee;
}
.Left {
    width: 10px;
    height: 3px;
    horizontal-align: left;
    vertical-align: center;
}
.Right {
    width: 10px;
    height: 3px;
    horizontal-align: right;
    vertical-align: center;
}
.Top {
    width: 3px;
    height: 10px;
    horizontal-align: center;
    vertical-align: top;
}
.Bottom {
    width: 3px;
    height: 10px;
    horizontal-align: center;
    vertical-align: bottom;
}
.PlayerDot {
    width: 3px;
    height: 3px;
    horizontal-align: center;
    vertical-align: center;
}
.GunNotice {
    horizontal-align: center;
    vertical-align: center;
    margin-top: 80px;
    font-size: 16px;
    color: #ffcf92;
    text-shadow: 1px 1px 2px #000000;
    opacity: 0;
}
#AxSight.GunUnavailable .GunNotice {
    opacity: 1;
}
.HUD_SCOREBOARD_VISIBLE #AxSight,.HUD_BUYMENU_VISIBLE #AxSight,.HUD_TEAMMENU_VISIBLE #AxSight,.HUD_ENDOFMATCH_VISIBLE #AxSight,.HUD_TEAMINTRO_VISIBLE #AxSight {
    opacity: 0;
}
