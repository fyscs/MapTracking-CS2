import { Instance } from 'cs_script/point_script';

// Display only: the map owns all gameplay and round-ending outputs.

// 公共提示文案：左侧是地图使用的键名，右侧是游戏中显示的文字。
const objectives = {
    activatecoregenerator: '启动核心发电机',
    activategenerator: '启动发电机',
    activatethenuke: '启动核弹',
    coregenerator: '前往核心发电机',
    defeatboss: '打败他',
    factory: '刀片工厂',
    minifactionroom: '前往基因实验室',
    powerroom: '前往能源室',
    reinforcementseast: '东侧增援抵达',
    reinforcementssouth: '南侧增援抵达',
    reinforcementswest: '西侧增援抵达',
    synchronizeeastgenerator: '同步东侧发电机',
    synchronizenorthgenerator: '同步北侧发电机',
    synchronizesouthgenerator: '同步南侧发电机',
    synchronizewestgenerator: '同步西侧发电机',
    weaponsroom: '前往武器库'
};

const cores = {
    coredamaged: '核心受损',
    destiny: '世界的命运系于你手，你当如何选择？',
    overloading: '超载核心',
    sacrifice: '净化装置启动',
    savetheworld: '最后一位人类选择拯救世界',
    survive: '坚守阵地',
    getout: '立即撤离'
};

// 每项依次为倒计时秒数、事件说明。
const messages = {
    stage_1_end: [80, '启动发电机'],
    stage4_part1: [80, '等待增援抵达'],
    stage4_end: [80, '守住阵地'],
    stage5_end: [40, '启用净化装置']
};

const stages = [
    '热身回合',
    '第一关 死亡公路',
    '第二关 被遗忘的工厂',
    '第三关 致命实验室',
    '第四关 最终一战',
    '终焉 虚无亦或是救赎',
    '全图通关'
];

const fields = [
    'Stage', 'Mode', 'Objective', 'Checkpoint',
    'Core', 'Charge', 'Timer', 'Destruction'
];

const now = () => Instance.GetGameTime();

const initial = () => ({
    stageUntil: 0,
    modeUntil: 0,
    goalUntil: 0,
    checkUntil: 0,
    coreUntil: 0,
    chargeUntil: 0,
    stage: '',
    mode: '',
    supreme: false,
    objective: '',
    objectiveDead: false,
    checkpoint: '已抵达检查点',
    checkpointOn: false,
    core: '',
    redDead: false,
    charge: 0,
    charging: false,
    end: null,
    caption: '',
    captionEnd: 0,
    totalEnd: null,
    totalOn: false
});

let state = initial(),
    hud = null,
    cache = new Map();

const input = (key, fn) => Instance.OnScriptInput(key, fn);

// 关卡与任务目标
for (let i = 0; i < stages.length; i++)
    input('Stage' + i, () => {
        state.stage = stages[i];
        state.stageUntil = now() + 25;
        if (i === 5) {
            state.totalOn = false;
            state.totalEnd = null;
        }
    });

input('ShowStage', () => {
    if (!state.stage) state.stage = stages[0];
    state.stageUntil = now() + 25;
});

for (const [k, v] of Object.entries(objectives))
    input('Goal_' + k, () => {
        if (!state.objectiveDead) {
            state.objective = v;
            state.goalUntil = now() + 8;
        }
    });

input('GoalHide', () => {
    state.objective = '';
});

input('GoalKill', () => {
    state.objective = '';
    state.objectiveDead = true;
});

// 阶段完成与检查点
input('CheckStage', () => {
    state.checkpoint = '关卡完成';
});

input('CheckPoint', () => {
    state.checkpoint = '已抵达检查点';
});

input('CheckShow', () => {
    state.checkpointOn = true;
    state.checkUntil = now() + 6;
});

input('CheckHide', () => {
    state.checkpointOn = false;
});

// 核心状态与难度提示
for (const [k, v] of Object.entries(cores))
    input('Core_' + k, () => {
        state.coreUntil = now() + 5;
        state.core = state.redDead && ['coredamaged', 'overloading'].includes(k)
            ? ''
            : v;
    });

input('CoreRedKill', () => {
    state.redDead = true;
    if ([cores.coredamaged, cores.overloading].includes(state.core))
        state.core = '';
});

input('Supreme', () => {
    state.supreme = true;
    if (state.mode) state.mode = '全事件极限模式';
});

input('ExtremeShow', () => {
    state.modeUntil = now() + 10;
    state.mode = state.supreme ? '全事件极限模式' : '极限模式';
});

// 事件倒计时与全图毁灭倒计时
for (const n of [20, 40, 60, 80])
    input('Timer' + n, () => {
        state.end = now() + n;
    });

for (const [k, [n, label]] of Object.entries(messages))
    input('Event_' + k, () => {
        state.end = now() + n;
        state.caption = label;
        state.captionEnd = state.end;
    });

input('TimerCancel', () => {
    state.end = null;
    state.caption = '';
});

input('CaptionHide', () => {
    state.caption = '';
});

input('TotalShow', () => {
    state.totalOn = true;
});

input('TotalBegin', () => {
    state.totalEnd = now() + 540;
});

input('TotalOff', () => {
    state.totalOn = false;
    state.totalEnd = null;
});

// 核心充能
// Read the live stage counter; Hammer adds 0.5 per charge pulse.
let chargeCounter = null;
let chargeLinks = [];
let nextChargeBind = 0;

function releaseChargeCounter() {
    for (const id of chargeLinks) Instance.DisconnectOutput(id);
    chargeLinks = [];
    chargeCounter = null;
    nextChargeBind = 0;
}

function bindChargeCounter(t) {
    if (chargeCounter?.IsValid() || t < nextChargeBind) return;
    releaseChargeCounter();
    nextChargeBind = t + 0.5;
    const name = 'stage_5_core_charge_counter';
    const e = Instance.FindEntityByName(name)
        || Instance.FindEntityByName('[PR#]' + name);
    if (!e?.IsValid()) return;
    chargeCounter = e;
    const sync = ({ value }) => {
        if (chargeCounter !== e || value == null || value === '') return;
        const v = Number(value);
        if (Number.isFinite(v))
            state.charge = Math.min(100, Math.max(0, Math.floor(v)));
    };
    for (const output of ['OutValue', 'OnGetValue']) {
        const id = Instance.ConnectOutput(e, output, sync);
        if (id !== undefined) chargeLinks.push(id);
    }
    Instance.EntFireAtTarget({ target: e, input: 'GetValue' });
}

input('ChargeShow', () => {
    state.charging = true;
    state.chargeUntil = now() + 600;
    bindChargeCounter(now());
});

input('ChargeHide', () => {
    state.charging = false;
});

for (let n = 10; n <= 100; n += 10)
    input('Charge' + n, () => {
        if (!chargeCounter?.IsValid()) state.charge = n;
    });

// 组合实际显示的文字；倒计时和充能的前缀也在这里。
function view(t) {
    const left = state.end === null ? null : Math.ceil(state.end - t),
        long = state.totalEnd === null
            ? null
            : Math.max(0, Math.ceil(state.totalEnd - t));

    return {
        Stage: t < state.stageUntil ? state.stage : '',
        Mode: t < state.modeUntil ? state.mode : '',
        Objective: t >= state.goalUntil
            ? ''
            : state.objective && '目标 ' + state.objective,
        Checkpoint: t < state.checkUntil && state.checkpointOn
            ? state.checkpoint
            : '',
        Core: t < state.coreUntil ? state.core : '',
        Charge: t < state.chargeUntil && state.charging
            ? '核心充能 ' + state.charge + '%'
            : '',
        Timer: left !== null && left >= 0
            ? (state.caption && t < state.captionEnd
                ? state.caption
                : '倒计时')
                + ' ' + String(left).padStart(2, '0') + ' 秒'
            : '',
        Destruction: state.totalOn && long !== null
            ? '核弹计时 ' + Math.floor(long / 60)
                + ':' + String(long % 60).padStart(2, '0')
            : ''
    };
}

function reset() {
    releaseChargeCounter();
    state = initial();
    cache.clear();
    if (hud?.IsValid()) hud.Reset();
}

// 同一显示位的优先级，以及每个玩家的界面更新。
function tick() {
    const t = now();
    try {
        if (!hud?.IsValid()) {
            hud = Instance.FindEntityByName('LMS_PublicHud');
            cache.clear();
        }
        if (!hud?.IsValid()) return;

        if (state.charging) bindChargeCounter(t);
        const v = view(t);
        if (v.Core) v.Stage = '';

        for (let i = 0; i < 64; i++) {
            const c = Instance.GetPlayerController(i);
            if (!c?.IsConnected()) {
                cache.delete(i);
                continue;
            }

            let prev = cache.get(i);
            if (!prev || prev.c !== c) {
                hud.ResetForPlayer(i);
                prev = { c };
                cache.set(i, prev);
            }

            for (const f of fields) {
                if (prev[f] === v[f]) continue;
                if (v[f])
                    hud.SetDialogVariableStringForPlayer(i, f, 'value', v[f]);
                hud.SetHasClassForPlayer(i, f, 'Shown', !!v[f]);
                prev[f] = v[f];
            }
        }
    } finally {
        Instance.SetNextThink(t + .15);
    }
}

Instance.SetThink(tick);

Instance.OnActivate(() => {
    hud = null;
    cache.clear();
    Instance.SetNextThink(now());
});

Instance.OnBeginRoundRestart(reset);

Instance.OnPlayerDisconnect(({ playerSlot }) => cache.delete(playerSlot));

Instance.OnScriptReload({
    before: () => {
        releaseChargeCounter();
        return { ...state };
    },
    after: data => {
        state = { ...initial(), ...data };
        hud = null;
        cache.clear();
        Instance.SetNextThink(now());
    }
});
