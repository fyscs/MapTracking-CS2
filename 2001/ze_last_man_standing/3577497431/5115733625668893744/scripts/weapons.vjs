const weaponAudio186=new WeaponAudio({
  start(key,position){
    const [e]=instantiate('Audio186_'+key,position,{pitch:0,yaw:0,roll:0},['point_soundevent']);
    const id=++audioSerial186,links=[];
    try{
      links.push(Entities.ConnectOutput({target:e,output:'SoundEventGuid',callback:({value})=>audioLog186('guid',{id,key,value})}));
      links.push(Entities.ConnectOutput({target:e,output:'OnSoundFinished',callback:()=>audioLog186('finished',{id,key})}));
      if(key.startsWith('Fire'))send(e,'SetSourceEntity','LMS_AC130_Muzzle'+key.slice(4)+'_161');
      audioLog186('start',{id,key,event:AUDIO186[key].event,position});
      send(e,'StartSound');return {e,id,key,links};
    }catch(error){for(const link of links)if(link!==undefined)Entities.DisconnectOutput(link);if(valid(e))e.Remove();throw error;}
  },
  stop({e,id,key,links}){
    if(valid(e)){send(e,'StopSound');send(e,'Kill',undefined,undefined,.05);}
    for(const link of links)if(link!==undefined)Entities.DisconnectOutput(link);
    audioLog186('stop',{id,key});
  },
  error(error){audioErrors186++;Instance.Msg('[AC186_AUDIO_ERROR] '+String(error));}
});
