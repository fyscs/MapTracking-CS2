224.221302],"left":-1,"right":-1},{"min":[10.159051,817.291401,224.221301],"max":[29.375069,821.594897,239.251746],"left":-1,"right":-1}],"parts":{"carriage25":{"mins":[-0.9842533469200134,-20.078704833984375,-9.251968383789062],"maxs":[22.244094848632812,10.433074951171875,9.448822021484375]},"barrel25":{"mins":[-53.14960479736328,-9.251981735229492,-6.692909240722656],"maxs":[2.2372071839527052e-07,6.692934513092041,9.251976013183594]},"carriage40":{"mins":[-5.5118184089660645,-19.09449005126953,-10.236213684082031],"maxs":[30.314964294433594,12.401573181152344,11.023635864257812]},"barrel40":{"mins":[-74.80316162109375,-6.771650314331055,-6.771644592285156],"maxs":[2.3232379930959723e-07,6.771655082702637,6.7716522216796875]},"carriage105":{"mins":[1.5747917890548706,-27.559038162231445,-18.11023712158203],"maxs":[53.14961242675781,27.559051513671875,25.9842529296875]},"barrel105":{"mins":[-124.80314636230469,-15.15746784210205,-12.795272827148438],"maxs":[3.3558040968273417e-07,15.157474517822266,12.795280456542969]}}};
// Original Stage 4 resources/tint/stopped propellers retained. Two original
// blasts now follow actual contact (0 / +0.8 seconds), not an airborne timeout.
const CRASH185={explosions:[0,.8],particle:'particles/lms_particles_new/custom_particle_067.vpcf'};
let wreck185=null,lastWreck185={phase:'idle'},wreckMotion192=null;
const wreckEffects185=[];
const vecOK192=v=>!!v&&['x','y','z'].every(k=>Number.isFinite(v[k]));
function resetWreckMotion192(){wreckMotion192=null;}
function observeWreckMotion192(t){
  if(!valid(refs.root)||wreck185||!canUseAircraft())return;
  const origin={...refs.root.GetAbsOrigin()},previous=wreckMotion192;
  if(previous&&previous.entity===refs.root&&t>previous.time&&t-previous.time<=.25){
    const dt=t-previous.time,d=sub(origin,previous.origin),speed=Math.hypot(d.x,d.y,d.z)/dt;
    // Reject placement teleports and stale samples, never convert them to inertia.
    wreckMotion192={entity:refs.root,time:t,origin,velocity:speed<=4096?{x:d.x/dt,y:d.y/dt,z:d.z/dt}:null};
  }else if(!previous||previous.entity!==refs.root||t>previous.time)
    wreckMotion192={entity:refs.root,time:t,origin,velocity:null};
}
function captureWreckMotion192(t=now()){
  if(!valid(refs.root))return null;
  const origin={...refs.root.GetAbsOrigin()},angles={...refs.root.GetAbsAngles()};
  const engine=refs.root.GetAbsVelocity();
  if(vecOK192(engine)&&Math.hypot(engine.x,engine.y,engine.z)>.01&&Math.hypot(engine.x,engine.y,engine.z)<=4096)
    return {origin,angles,velocity:{...engine},velocitySource:'entity_velocity'};
  const m=wreckMotion192;
  if(m&&m.entity===refs.root&&t>=m.time&&t-m.time<=.25&&vecOK192(m.velocity)&&Math.hypot(...['x','y','z'].map(k=>origin[k]-m.origin[k]))<=.01)
    return {origin,angles,velocity:{...m.velocity},velocitySource:'recent_position_samples'};
  // Stationary standalone labs/held intro have no flight momentum. The opted-in
  // route supplies its exact tangent separately; do not invent speed for a prop.
  return {origin,angles,velocity:{x:0,y:0,z:0},velocitySource:'stationary_or_unavailable'};
}
function aircraftVisualParts185(){return [...new Set([refs.root,...Object.values(stations).flatMap(s=>[s.carriage,s.barrel])])].filter(valid);}
function removeWreckEffect185(parts){
  for(const e of parts)if(valid(e))send(e,e.GetClassName()==='point_soundevent'?'StopSound':'Stop');
  remove(parts);
}
function clearWreck185(){
  if(wreck185)remove(wreck185.parts.map(p=>p.entity));
  for(const f of wreckEffects185)removeWreckEffect185(f.parts);
  wreckEffects185.length=0;wreck185=null;lastWreck185={phase:'idle'};resetWreckMotion192();
}
function worldHull192(id,mins,maxs,angles,offset,scale=1){
  if(!Number.isFinite(scale)||scale<=0)throw Error('Invalid crash model scale');
  const basis=axes(angles),points=[];
  for(const x of [mins[0],maxs[0]])for(const y of [mins[1],maxs[1]])for(const z of [mins[2],maxs[2]])
    points.push(add(offset,rotate({x:x*scale,y:y*scale,z:z*scale},basis),1));
  // 1 unit covers trace slop and the <= 0.1 unit chord error of 32 Hz gravity.
  const low={},high={};for(const k of ['x','y','z']){low[k]=Math.min(...points.map(p=>p[k]))-1;high[k]=Math.max(...points.map(p=>p[k]))+1;}
  return {id,mins:low,maxs:high};
}
function wreckHulls192(snapshot,parts){
  const scale=refs.root.GetModelScale();
  const nodes=CRASH_HULLS192.nodes,cache=new Map();
  // Transform only nodes that the broad-phase traversal actually visits.
  const node=i=>{if(!cache.has(i)){const b=nodes[i];cache.set(i,{...worldHull192('cell_'+i,b.min,b.max,snapshot.angles,{x:0,y:0,z:0},scale),left:b.left,right:b.right});}return cache.get(i);};
  const hulls=[];
  for(const p of parts){
    if(p.entity===refs.root)continue;
    const name=p.entity.GetModelName().split('/').at(-1).replace(/\.vmdl(?:_c)?$/,'');
    const bounds=CRASH_HULLS192.parts[name];if(!bounds)throw Error('Unknown aircraft part bounds: '+name);
    hulls.push(worldHull192(name,bounds.mins,bounds.maxs,p.angles,sub(p.origin,snapshot.origin),p.entity.GetModelScale()));
  }
  return {nodes,node,root:CRASH_HULLS192.root,parts:hulls};
}
function sweepWreck192(w,start,end){
  let first={didHit:false,startedInSolid:false,fraction:1};
  const ignore=w.parts.map(p=>p.entity).filter(valid);
  const pending=[w.hulls.root,...w.hulls.parts];let queries=0;
  while(pending.length){
    const item=pending.pop(),hull=typeof item==='number'?w.hulls.node(item):item;
    const tr=Instance.TraceBox({start,end,mins:hull.mins,maxs:hull.maxs,ignorePlayers:true,traceHitboxes:false,ignoreEntity:ignore});
    queries++;
    if(!tr.startedInSolid&&!tr.didHit)continue;
    if(hull.left>=0){
      // Empty space inside a broad bound is expected. Only leaf-cell contact
      // is authoritative; an internal startedInSolid must never stop the craft.
      if(!tr.startedInSolid&&first.didHit&&tr.fraction>=first.fraction)continue;
      pending.push(hull.right,hull.left);continue;
    }
    if(tr.startedInSolid)return {didHit:true,startedInSolid:true};
    if(!Number.isFinite(tr.fraction)||tr.fraction<0||tr.fraction>1||!vecOK192(tr.normal))throw Error('Malformed hull contact');
    if(first.didHit&&tr.fraction>=first.fraction)continue;
    const root={x:start.x+(end.x-start.x)*tr.fraction,y:start.y+(end.y-start.y)*tr.fraction,z:start.z+(end.z-start.z)*tr.fraction};
    const point={};
    // Plane-support point of the conservative contact cell. In components
    // tangent to the plane, use the face centre (not an arbitrary box corner).
    for(const k of ['x','y','z'])point[k]=root[k]+(tr.normal[k]>.0001?hull.mins[k]:tr.normal[k]<-.0001?hull.maxs[k]:(hull.mins[k]+hull.maxs[k])/2);
    first={didHit:true,startedInSolid:false,fraction:tr.fraction,point,normal:{...tr.normal},hull:hull.id};
  }
  w.traceQueries=(w.traceQueries||0)+queries;w.maxQueriesPerSweep=Math.max(w.maxQueriesPerSweep||0,queries);
  return first;
}
function beginWreck185(snapshot=captureWreckMotion192()){
  if(wreck185||!valid(refs.root)||!snapshot)return false;
  // Restore the authored stopped-blade pose before the original static wreck
  // hulls take over. This changes neither the route tangent nor its inertia.
  setAircraftPropellers208(false);
  const parts=aircraftVisualParts185().map(entity=>({entity,origin:{...entity.GetAbsOrigin()},angles:{...entity.GetAbsAngles()}}));
  const w={start:now(),origin:{...snapshot.origin},snapshot,parts,emitted:0,bursts:[],errors:[]};
  w.hulls=wreckHulls192(snapshot,parts);
  // Absolute poses were captured before detaching. Parent motion must not add
  // a second transform when the individual gun assemblies are moved below.
  for(const p of parts){p.entity.SetParent(undefined);p.entity.Teleport({position:p.origin,angles:p.angles,velocity:{x:0,y:0,z:0},angularVelocity:{x:0,y:0,z:0}});}
  w.motion=new GroundCrashMotion192(snapshot,(a,b)=>sweepWreck192(w,a,b));
  wreck185=w;resetWreckMotion192();tickWreck185(now());return true;
}
function tickWreck185(t){
  for(let i=wreckEffects185.length-1;i>=0;i--)if(t>=wreckEffects185[i].until){removeWreckEffect185(wreckEffects185[i].parts);wreckEffects185.splice(i,1);}
  const w=wreck185;if(!w)return;
  if(!valid(refs.root)){clearWreck185();return;}
  const elapsed=Math.max(0,t-w.start),frame=w.motion.update(elapsed),delta=sub(frame.position,w.origin);
  for(const p of w.parts)if(valid(p.entity)){
    p.entity.Move({position:add(p.origin,delta,1)});p.entity.SetColor({r:15,g:15,b:15,a:frame.alpha});
  }
  if(frame.reason&&!w.loggedFailure){w.loggedFailure=true;w.errors.push(frame.reason);Instance.Msg('[AC192] crash unresolved '+frame.reason);}
  while(frame.impact&&w.emitted<CRASH185.explosions.length&&frame.impactAge+1e-6>=CRASH185.explosions[w.emitted]){
    const scheduled=CRASH185.explosions[w.emitted++],position=add(frame.impact.point,frame.impact.normal,8);
    try{
      const parts=instantiate('Crash185',position,{pitch:0,yaw:0,roll:0},['info_particle_system','point_soundevent']);
      wreckEffects185.push({parts,until:t+8});send(parts[0],'Start');send(parts[1],'StartSound');
      w.bursts.push({scheduled,actual:frame.impactAge,position,parts:parts.map(e=>e.GetClassName())});
    }catch(e){w.errors.push(String(e));Instance.Msg('[AC192] crash effect '+e);}
  }
  lastWreck185={...frame,elapsed,delta,velocity:w.snapshot.velocity,velocitySource:w.snapshot.velocitySource,
    hullNodes:w.hulls.nodes.length,traceQueries:w.traceQueries,maxQueriesPerSweep:w.maxQueriesPerSweep,
    bursts:w.bursts,errors:w.errors,parts:w.parts.filter(p=>valid(p.entity)).length};
  if(frame.complete){remove(w.parts.map(p=>p.entity));wreck185=null;lastWreck185.parts=0;}
}
Console.RegisterCheatCommand('ac185_crash_status',()=>{
  Instance.Msg('[AC192_CRASH] '+JSON.stringify({...lastWreck185,effects:wreckEffects185.length,
    damageEnabled:false,contactMethod:'24unit_leaf_hierarchy_sweep',entryAnimationKind:'exterior_flyby_only',exitAnimation:false},
    (_,v)=>typeof v==='number'?Math.round(v*10000)/10000:v));
});
// World-only destruction visuals must never delay restoration or player death.
let departure={phase:'ready',reason:null,generation:0,victimSlot:null,killed:false,restored:null};
let departingCrew=null;
let departingMotion192=null;
let aircraftDeployed195=false;
function canUseAircraft(){return departure.phase==='ready';}
function resetDepartureRound(){
  departingCrew=null;
  departingMotion192=null;
  aircraftDeployed195=false;
  departure={phase:'ready',reason:null,generation:departure.generation+1,victimSlot:null,killed:false,restored:null};
}
function requestDeparture(reason){
  if(!['fuel_empty','core_destroyed'].includes(reason)||!canUseAircraft())return false;
  if(reason==='core_destroyed'&&fuelEnd!==null&&now()>=fuelEnd)reason='fuel_empty';
  // A third break can arrive before selection/authentication completes. Cancel
  // admission, but do not crash a hidden aircraft that never entered the battle.
  if(reason==='core_destroyed'&&!aircraftDeployed195){
    deployment.pending=null;deployment.attempted=true;held=null;active=false;
    stopFlight192(now(),reason);
    departure={phase:'departed',reason,generation:departure.generation,victimSlot:null,killed:false,restored:null};
    Instance.Msg('[AC195] core destroyed before deployment; pending admission cancelled');
    return true;
  }
  const crew=seat;
  departingCrew=crew;
  departure={phase:'departing',reason,generation:departure.generation,
    victimSlot:crew?.slot??null,killed:false,restored:null};
  // Capture before stopping motion or restoring the occupant. Visual teardown
  // failures must never prevent restoration and the core-break death.
  departingMotion192=null;
  try{
    if(reason==='core_destroyed')departingMotion192=stopFlightForWreck192(now());
    else stopFlight192(now(),reason);
  }catch(error){
    stopFlight192(now(),reason);Instance.Msg('[AC192] motion capture failed: '+error);
  }
  deployment.pending=null;deployment.attempted=true;held=null;
  advanceDeparture();return true;
}
function advanceDeparture(){
  if(departure.phase!=='departing')return;
  const crew=departingCrew,reason=departure.reason;
  // Restore camera, HUD, temporary weapons and the original ammunition first.
  if(!leaveGunner(reason))return;
  const sameCrew=crew&&valid(crew.controller)&&crew.controller.IsConnected()&&
    crew.controller.GetPlayerPawn()===crew.p&&valid(crew.p)&&crew.p.GetPlayerController()===crew.controller;
  if(sameCrew&&alive(crew.p)){
    const weapon=crew.p.GetActiveWeapon();
    departure.restored={camera:crew.p.GetCustomCamera().GetMode(),seatDetached:!seat,
      position:crew.body?crew.p.GetAbsOrigin():null,bodyProtection:protectsGunnerDamage(crew.p),
      weapon:valid(weapon)?weapon.GetClassName():null,
      ammo:valid(weapon)&&[CSGearSlot.RIFLE,CSGearSlot.PISTOL].includes(weapon.GetData().GetGearSlot())?
        [weapon.GetClipAmmo(),weapon.GetReserveAmmo()]:null};
    if(reason==='core_destroyed'){crew.p.Kill();departure.killed=true;}
  }
  // Departure retires the aircraft only. Shells already launched have their own
  // world-space trajectory and must finish it even when the operator is dead.
  retireAircraftWeapons195();
  // World-only effect starts after body restoration/death; owns no player.
  if(reason==='core_destroyed'){
    try{if(!beginWreck185(departingMotion192))remove(aircraftVisualParts185());}
    catch(e){remove(aircraftVisualParts185());Instance.Msg('[AC185] visual start failed '+e);}
  }else remove(aircraftVisualParts185());
  active=false;departure.phase='departed';
  departingCrew=null;
  departingMotion192=null;
  Instance.Msg('[AC181_DEPARTURE] '+JSON.stringify(departure));
}
Console.RegisterCheatCommand('ac181_departure_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC181_DEPARTURE_STATUS] '+JSON.stringify({...departure,
    rootPresent:valid(refs.root),seatPresent:!!seat,pendingSelection:!!deployment.pending,
    animationImplemented:true,animationKind:'stage4_composite_visual'}));
});
// Identify a live connection independently of the slot or display name it uses.
class GunnerConnectionIdentities {
  constructor(saved) {
    this.nextSerial = saved?.nextSerial ?? 1;
    this.records = new Map((saved?.records ?? []).map(([slot, record]) => [slot, {...record}]));
  }

  connect(slot, controller) {
    if (!Number.isInteger(slot) || slot < 0 || !controller) return null;
    const existing = this.identity(slot, controller);
    if (existing !== null) return existing;

    const id = `connection-${this.nextSerial++}`;
    this.records.set(slot, {controller, id});
    return id;
  }

  disconnect(slot, controller) {
    const record = this.records.get(slot);
    if (record && (controller === undefined || record.controller === controller)) this.records.delete(slot);
  }

  identity(slot, controller) {
    const record = this.records.get(slot);
    return record && record.controller === controller ? record.id : null;
  }

  snapshot() {
    return {
      nextSerial: this.nextSerial,
      records: [...this.records].map(([slot, record]) => [slot, {...record}]),
    };
  }
}
let rotation=new GunnerRotation(),connectionIdentities=new GunnerConnectionIdentities();
let selectionBindings=[],selectionRelay=null;
const minDeploymentCT=12;
let populationBypass212=false;
function freshDeployment212(){return {attempted:false,pending:null,result:'idle',livingCTAtTrigger:null,eligibleCT:null,excludedCT:null,profile:null,populationBypassed:false};}
let deployment=freshDeployment212();
let labSelectionBots=false,labIdentitySerial=0;
const labIdentities=new Map();

let selectionCore216=null,selectionRetry216=0,selectionBindError216=null;
function connectedGunnerHumans(){
  return Instance.GetAllPlayerControllers().filter(c=>valid(c)&&c.IsConnected()&&!c.IsBot());
}
function gunnerConnectionStatus(){
  const humans=connectedGunnerHumans();
  const tracked=humans.filter(c=>connectionIdentities.identity(c.GetPlayerSlot(),c)!==null).length;
  return {mode:'native_connection',connected:humans.length,tracked};
}
function bindSelection(){
  const relay=unique('AC180_Deploy');
  const core=unique('stage_5_core_hit_relay');
  const fresh=[];
  try{
    if(!valid(relay))throw Error('deployment relay unavailable');
    for(const c of connectedGunnerHumans())connectionIdentities.connect(c.GetPlayerSlot(),c);
    const hooks=[
      [relay,'OnTrigger',()=>requestDeployment()],
      [relay,'OnUser1',()=>setPopulationBypass212(true)],
      [relay,'OnUser2',()=>setPopulationBypass212(false)],
      [relay,'OnUser3',()=>populationStatus212('status')],
      [relay,'OnUser4',()=>requestDeparture('core_destroyed')]
    ];
    if(valid(core)&&core.GetClassName()==='logic_relay')hooks.push([core,'OnUser4',()=>requestDeparture('core_destroyed')]);
    for(const [target,output,callback] of hooks){
      const id=Entities.ConnectOutput({target,output,callback});
      if(id===undefined)throw Error('cannot bind '+target.GetEntityName()+'.'+output);
      fresh.push(id);
    }
    for(const id of selectionBindings)Entities.DisconnectOutput(id);
    selectionBindings=fresh;selectionRelay=relay;selectionCore216=core;
    selectionBindError216=null;return true;
  }catch(error){
    for(const id of fresh)Entities.DisconnectOutput(id);
    const message=String(error);
    if(message!==selectionBindError216)Instance.Msg('[AC216_BIND] '+message);
    selectionBindError216=message;return false;
  }
}
function selectionMaintenance216(t){
  if(t<selectionRetry216)return;
  selectionRetry216=t+1;
  if(selectionBindError216||!selectionBindings.length||!valid(selectionRelay)||
    selectionRelay!==unique('AC180_Deploy')||selectionCore216!==unique('stage_5_core_hit_relay'))bindSelection();
}
function liveCandidate(c){
  return valid(c)&&c.IsConnected()&&(!c.IsBot()||labSelectionBots)&&operator(c.GetPlayerPawn());
}
function candidateIdentity(c){
  if(c.IsBot()&&labSelectionBots){
    if(!labIdentities.has(c))labIdentities.set(c,'lab-bot-'+(++labIdentitySerial));
    return labIdentities.get(c);
  }
  return connectionIdentities.connect(c.GetPlayerSlot(),c);
}
// Administrative ent_fire controls on the existing relay. No automatic map
// output enables this override. It changes only the minimum-population gate;
// item exclusions, connection rotation and departure still apply.
function populationStatus212(action,rearmed=false){
  Instance.Msg('[AC212_POPULATION] '+JSON.stringify({action,enabled:populationBypass212,
    effectiveMinimumCT:populationBypass212?1:minDeploymentCT,
    belowMinimumProfile:populationBypass212?'full_circle_60s':null,rearmed,
    attempted:deployment.attempted,pending:!!deployment.pending,result:deployment.result,
    livingCTAtTrigger:deployment.livingCTAtTrigger,populationBypassed:!!deployment.populationBypassed,
    profile:deployment.profile,departurePhase:departure.phase,aircraftDeployed:aircraftDeployed195,
    revision:228,identity:gunnerConnectionStatus(),bindingError:selectionBindError216,connections:selectionBindings.length}));
}
function setPopulationBypass212(enabled){
  populationBypass212=enabled;
  // Re-arm recoverable admission failures. A completed sortie or core shutdown
  // cannot be reopened by enabling the override.
  const rearmed=enabled&&canUseAircraft()&&!seat&&!deployment.pending&&!aircraftDeployed195&&
    deployment.attempted&&['no_living_ct','insufficient_living_ct','connection_unavailable','aircraft_unavailable','component_unavailable'].includes(deployment.result);
  if(rearmed)deployment=freshDeployment212();
  populationStatus212(enabled?'enabled':'disabled',!!rearmed);
}
function selectionLog(result){
  deployment.result=result;
  Instance.Msg('[AC180_SELECTION] '+JSON.stringify({result,cycle:rotation.cycle,awarded:rotation.used.size,
    livingCTAtTrigger:deployment.livingCTAtTrigger,minLivingCT:minDeploymentCT,
    eligibleCT:deployment.eligibleCT,excludedCT:deployment.excludedCT,profile:deployment.profile,
    populationBypassEnabled:populationBypass212,populationBypassed:!!deployment.populationBypassed}));
}
function requestDeployment(){
  if(!canUseAircraft()||deployment.attempted||seat){populationStatus212('deploy_blocked');return;}
  deployment.attempted=true;
  // Snapshot the players alive when the map condition is met. Later joins do
  // not join this draw; a selected player who dies does not cause a reroll.
  const roster=Instance.GetAllPlayerControllers().filter(liveCandidate);
  // Count ALL living CT in this snapshot, including previously awarded players.
  // Ordinary failed admission cannot be retried after later respawns/joins.
  deployment.livingCTAtTrigger=roster.length;
  if(!roster.length){selectionLog('no_living_ct');return;}
  deployment.profile=deploymentProfile206(roster.length);
  if(!deployment.profile&&populationBypass212){
    // Keep the low-population 60-second full-circle profile. The actual roster
    // count is retained; never invent extra players or admit bots/empty rosters.
    deployment.profile=deploymentProfile206(minDeploymentCT);
    deployment.populationBypassed=true;
  }
  if(!deployment.profile){selectionLog('insufficient_living_ct');return;}
  // The full-map component keeps its seven hidden models in a repeatable
  // template; do not spawn them before one of the two population gates succeeds.
  if(!active){
    try{ensureAircraft195();}catch(error){selectionLog('aircraft_unavailable');Instance.Msg('[AC195] '+String(error));return;}
  }
  const t=now();
  deployment.pending={roster,deadline:t+5,nextAdmission:t,draw:null,profile:deployment.profile};
  selectionTick(t);
}
function selectionTick(t){
  selectionMaintenance216(t);
  const pending=deployment.pending;if(!pending)return;
  if(!canUseAircraft()||!active){deployment.pending=null;selectionLog('component_unavailable');return;}
  // Try immediately and once more at the existing deadline. Between those
  // points, avoid repeating the entity scans on every tick if the camera fails.
  if(t<pending.nextAdmission&&t<pending.deadline)return;
  const blocked=scanGunnerExclusions(),living=pending.roster.filter(liveCandidate);
  const eligible=living.filter(c=>!gunnerExclusionReason(c.GetPlayerPawn(),blocked));
  deployment.eligibleCT=eligible.length;deployment.excludedCT=living.length-eligible.length;
  if(!eligible.length){deployment.pending=null;selectionLog('no_eligible_ct');return;}
  if(!pending.draw){
    // Rotation exhaustion is evaluated only over currently selectable players.
    const candidates=eligible.map(c=>({controller:c,id:candidateIdentity(c)}));
    const draw=rotation.choose(candidates);
    if(!draw.ok){
      deployment.pending=null;selectionLog(draw.reason);return;
    }
    pending.draw=draw;
  }
  const c=pending.draw.candidate.controller;
  if(!liveCandidate(c)||candidateIdentity(c)!==pending.draw.candidate.id){
    deployment.pending=null;selectionLog('selected_player_unavailable');return;
  }
  const p=c.GetPlayerPawn();
  // Ownership or tank admission can change while the camera is pending.
  if(gunnerExclusionReason(p,blocked)){
    deployment.pending=null;selectionLog('selected_player_ineligible');return;
  }
  if(beginGunner(p,pending.profile??deployment.profile,blocked)){
    if(!rotation.commit(pending.draw)){
      leaveGunner('selection_commit_failed');selectionLog('selection_commit_failed');
    }else selectionLog('awarded');
    deployment.pending=null;return;
  }
  if(t>=pending.deadline){deployment.pending=null;selectionLog('selected_camera_unavailable');}
  else pending.nextAdmission=t+.1;
}
function resetDeploymentRound(){selectionRetry216=0;populationBypass212=false;deployment=freshDeployment212();}
function selectionBeforeReload(){
  return {rotation:rotation.snapshot(),connectionIdentities:connectionIdentities.snapshot(),deployment,departure,aircraftDeployed195};
}
function selectionAfterReload(saved){
  populationBypass212=false;
  if(!saved)return;
  rotation=new GunnerRotation(saved.rotation);
  connectionIdentities=new GunnerConnectionIdentities(saved.connectionIdentities);
  deployment=saved.deployment;
  if(saved.departure)departure=saved.departure;
  aircraftDeployed195=!!saved.aircraftDeployed195;
}
Instance.OnPlayerDisconnect(({playerSlot})=>{
  connectionIdentities.disconnect(playerSlot);
  if(seat?.slot===playerSlot)leaveGunner('disconnect');
});
Instance.OnPlayerConnect(({player})=>{
  if(!valid(player)||player.IsBot())return;
  connectionIdentities.connect(player.GetPlayerSlot(),player);
  labSelectionBots=false;
});
Console.RegisterCheatCommand('ac180_selection_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC180_SELECTION_STATUS] '+JSON.stringify({cycle:rotation.cycle,awarded:rotation.used.size,
    attempted:deployment.attempted,pending:!!deployment.pending,result:deployment.result,
    livingCTAtTrigger:deployment.livingCTAtTrigger,minLivingCT:minDeploymentCT,
    eligibleCT:deployment.eligibleCT,excludedCT:deployment.excludedCT,profile:deployment.profile,
    identity:gunnerConnectionStatus(),labBots:labSelectionBots,seatSlot:seat?.slot,ready:valid(selectionRelay)}));
});
// Fixture opt-in is unavailable outside this lab or when a human is connected.
Console.RegisterCheatCommand('ac180_selection_lab',args=>{
  if(!valid(unique('AC176_Lab'))||Instance.GetAllPlayerControllers().some(c=>c.IsConnected()&&!c.IsBot()))return;
  const op=args.trim();
  if(op==='enable')labSelectionBots=true;
  if(op==='deploy'&&valid(selectionRelay))selectionRelay.FireInput({input:'Trigger'});
  if(op==='core_destroyed'&&valid(selectionRelay))selectionRelay.FireInput({input:'FireUser4'});
  if(op==='kill_selected'&&seat?.p?.IsValid())seat.p.Kill();
  if(op==='clear_ct')for(const c of Instance.GetAllPlayerControllers())if(operator(c.GetPlayerPawn()))c.GetPlayerPawn().Kill();
  if(op==='teams'){
    const bots=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected()&&c.IsBot()).sort((a,b)=>a.GetPlayerSlot()-b.GetPlayerSlot());
    bots.forEach((c,i)=>{const team=i<20?3:2;if(c.GetPlayerPawn()?.GetTeamNumber()!==team)c.JoinTeam(team);});
  }
  if(op==='count')Instance.Msg('[AC182_LAB_COUNT] '+JSON.stringify({
    livingCT:Instance.GetAllPlayerControllers().filter(c=>c.IsConnected()&&operator(c.GetPlayerPawn())).length
  }));
  if(op==='pair'){
    const bots=Instance.GetAllPlayerControllers().filter(c=>c.IsConnected()&&c.IsBot()).sort((a,b)=>a.GetPlayerSlot()-b.GetPlayerSlot());
    bots.forEach((c,i)=>{const team=i===0?3:2;if(c.GetPlayerPawn()?.GetTeamNumber()!==team)c.JoinTeam(team);});
  }
});

// Synchronous, cheat-protected administration: works through official !rcon.
Console.RegisterCheatCommand('ac216_status',()=>populationStatus212('status'));
Console.RegisterCheatCommand('ac216_population_bypass',args=>{
  const command=String(args||'status').trim().toLowerCase();
  if(command==='on')setPopulationBypass212(true);
  else if(command==='off')setPopulationBypass212(false);
  else if(command==='status')populationStatus212('status');
  else Instance.Msg('[AC216_USAGE] ac216_population_bypass on|off|status');
});
Console.RegisterCheatCommand('ac216_deploy',()=>{requestDeployment();populationStatus212('deploy_requested');});
// Shared by all three weapon stations and both 90/45 degree FOV modes.
// Source pitch is positive down. This is a server-side angle constraint, not a
// client bind, sensitivity, FOV, inventory or cinematic-camera modification.
const GUNNER_AIM_LIMITS195 = Object.freeze({yawHalfWidth:60,minPitch:10,maxPitch:75});
// Avoid repeatedly issuing absolute view-angle corrections while the client is
// acknowledging an earlier correction. These affect correction cadence only;
// the anchor and weapon ray still receive the exact common constrained angle.
const GUNNER_AIM_CORRECTION195 = Object.freeze({
  toleranceDegrees:.01,yawInsetDegrees:1.5,pitchInsetDegrees:1,minWriteInterval:.12
});

function gunnerYawDelta195(a,b){return ((a-b+180)%360+360)%360-180;}

function constrainGunshipAim195(requested,camera,core,fallback,recenter=false){
  const finite=v=>!!v&&[v.x,v.y,v.z].every(Number.isFinite);
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const hasCore=finite(camera)&&finite(core)&&Math.hypot(core.x-camera.x,core.y-camera.y)>.001;
  const centerYaw=hasCore?Math.atan2(core.y-camera.y,core.x-camera.x)*180/Math.PI:
    Number.isFinite(fallback?.yaw)?fallback.yaw:0;
  const centerPitch=hasCore?-Math.atan2(core.z-camera.z,Math.hypot(core.x-camera.x,core.y-camera.y))*180/Math.PI:
    Number.isFinite(fallback?.pitch)?fallback.pitch:30;
  const yaw=(!recenter&&Number.isFinite(requested?.yaw))?requested.yaw:centerYaw;
  const pitch=(!recenter&&Number.isFinite(requested?.pitch))?requested.pitch:centerPitch;
  const delta=gunnerYawDelta195(yaw,centerYaw);
  const offset=clamp(delta,-GUNNER_AIM_LIMITS195.yawHalfWidth,GUNNER_AIM_LIMITS195.yawHalfWidth);
  const angles={pitch:clamp(pitch,GUNNER_AIM_LIMITS195.minPitch,GUNNER_AIM_LIMITS195.maxPitch),
    yaw:gunnerYawDelta195(centerYaw+offset,0),roll:0};
  const changed=!requested||!Number.isFinite(requested.pitch)||!Number.isFinite(requested.yaw)||
    !Number.isFinite(requested.roll)||Math.abs(gunnerYawDelta195(angles.yaw,requested.yaw))>1e-6||
    Math.abs(angles.pitch-requested.pitch)>1e-6||Math.abs(requested.roll)>1e-6;
  return {angles,centerYaw:gunnerYawDelta195(centerYaw,0),centerPitch,yawOffset:offset,changed,hasCore};
}

function planGunnerEyeCorrection195(result,requested,time,state,recenter=false){
  const finiteAngle=a=>!!a&&[a.pitch,a.yaw,a.roll].every(Number.isFinite);
  const error=(a,b)=>finiteAngle(a)&&finiteAngle(b)?Math.max(Math.abs(a.pitch-b.pitch),
    Math.abs(gunnerYawDelta195(a.yaw,b.yaw)),Math.abs(a.roll-b.roll)):Infinity;
  const p=GUNNER_AIM_CORRECTION195;
  if(Number.isFinite(state.lastWriteAt)&&time<state.lastWriteAt){
    state.lastWriteAt=null;state.nextWriteAt=null;state.requested=null;state.target=null;state.writes=0;
  }
  const significant=error(requested,result.angles)>p.toleranceDegrees;
  const canWrite=Number.isFinite(time)&&(!Number.isFinite(state.nextWriteAt)||time>=state.nextWriteAt);
  const write=(recenter||significant)&&(recenter||canWrite);
  let angles={...result.angles};
  if(write){
    if(!recenter&&finiteAngle(requested)){
      const offset=gunnerYawDelta195(requested.yaw,result.centerYaw);
      if(offset < -GUNNER_AIM_LIMITS195.yawHalfWidth)
        angles.yaw=gunnerYawDelta195(result.centerYaw-GUNNER_AIM_LIMITS195.yawHalfWidth+p.yawInsetDegrees,0);
      else if(offset > GUNNER_AIM_LIMITS195.yawHalfWidth)
        angles.yaw=gunnerYawDelta195(result.centerYaw+GUNNER_AIM_LIMITS195.yawHalfWidth-p.yawInsetDegrees,0);
      if(requested.pitch<GUNNER_AIM_LIMITS195.minPitch)angles.pitch=GUNNER_AIM_LIMITS195.minPitch+p.pitchInsetDegrees;
      else if(requested.pitch>GUNNER_AIM_LIMITS195.maxPitch)angles.pitch=GUNNER_AIM_LIMITS195.maxPitch-p.pitchInsetDegrees;
    }
    state.lastWriteAt=time;state.nextWriteAt=time+p.minWriteInterval;
    state.requested=requested?{...requested}:null;state.target={...angles};state.writes=(state.writes||0)+1;
  }else if(!canWrite&&state.target&&error(requested,state.requested)<=p.toleranceDegrees){
    // Some engine reads can still contain the pre-correction angles in this
    // frame. Do not bounce the anchor back to the hard edge while awaiting ack.
    // Re-clamp the pending target against the moving core bearing every time.
    const offset=Math.max(-GUNNER_AIM_LIMITS195.yawHalfWidth,Math.min(GUNNER_AIM_LIMITS195.yawHalfWidth,
      gunnerYawDelta195(state.target.yaw,result.centerYaw)));
    angles={pitch:Math.max(GUNNER_AIM_LIMITS195.minPitch,Math.min(GUNNER_AIM_LIMITS195.maxPitch,state.target.pitch)),
      yaw:gunnerYawDelta195(result.centerYaw+offset,0),roll:0};
  }
  return {angles,write,significant};
}

// The view anchor, native custom camera and weapon ray all consume this result.
// Resolve the authored core marker on demand: do not use a stale world yaw while
// the aircraft advances along the route, and do not run during the flyby.
function gunnerViewAngles195(s,recenter=false){
  if(s!==seat||s?.phase!=='active'||!operator(s.p)||!valid(refs.root))return null;
  const marker=unique('AC184_CoreReturn'),core=valid(marker)?marker.GetAbsOrigin():null;
  const port=rotate({x:0,y:.8660254,z:-.5},axes(refs.root.GetAbsAngles()));
  const requested=s.p.GetEyeAngles();
  const result=constrainGunshipAim195(requested,cameraPosition(),core,angle(port),recenter);
  const correction=s.aimCorrection195??(s.aimCorrection195={writes:0});
  const decision=planGunnerEyeCorrection195(result,requested,now(),correction,recenter);
  if(decision.write)s.p.SetEyeAngles(decision.angles);
  s.aimLimit195={centerYaw:result.centerYaw,yawOffset:gunnerYawDelta195(decision.angles.yaw,result.centerYaw),
    pitch:decision.angles.pitch,clamped:result.changed,reference:result.hasCore?'core_marker':'port_fallback',
    requested:{...requested},correctionSent:decision.write,correctionCount:correction.writes,
    correctionAt:correction.lastWriteAt??null,correctionRequested:correction.requested??null};
  return decision.angles;
}
// Official CS2Fixes v2.1 point_viewcontrol FOV flag (64), no freeze or disarm.
// Its DisableCameraAll clears the actual view entity, even if the separate native
// CustomPlayerCamera still reports CONTROLLED_POSITION. Keep one viewcontrol
// attached for the entire active sortie and change only its FOV for RMB zoom.
const ZOOM187={fov:45,normalFov:90,controller:'AC187_ZoomControl',anchor:'AC187_ZoomAnchor'};
function prepareZoom187(s){
  s.zoomControl=unique(ZOOM187.controller);s.zoomAnchor=unique(ZOOM187.anchor);
  if(!valid(s.zoomControl)||!valid(s.zoomAnchor))throw Error('AC187 zoom entities missing');
  s.zoomControl.SetHealth(ZOOM187.normalFov);
  s.zoomed=false;s.zoomButton=!!s.p.IsInputPressed(CSInputs.ATTACK2);s.zoomViewRequested=false;
  s.zoomAnchor.SetColor({r:255,g:255,b:255,a:0});
  s.zoomAnchor.Teleport({position:cameraPosition(),angles:s.p.GetEyeAngles()});
}
function startGunnerView195(s){
  if(s!==seat||s.phase!=='active'||!operator(s.p)||!valid(s.zoomControl)||!valid(s.zoomAnchor))return false;
  const aim=gunnerViewAngles195(s);if(!aim)return false;
  s.zoomAnchor.Teleport({position:cameraPosition(),angles:aim});
  s.zoomControl.SetHealth(s.zoomed?ZOOM187.fov:ZOOM187.normalFov);
  if(!s.zoomViewRequested){send(s.zoomControl,'EnableCamera',undefined,s.p);s.zoomViewRequested=true;}
  return true;
}
function setZoom187(s,zoomed){
  if(s!==seat||s.phase!=='active'||!operator(s.p)||!valid(s.zoomControl)||!valid(s.zoomAnchor)||!s.zoomViewRequested)return false;
  if(s.zoomed===zoomed)return true;
  const aim=gunnerViewAngles195(s);if(!aim)return false;
  s.zoomAnchor.Teleport({position:cameraPosition(),angles:aim});
  // Health is the official FOV input; RunThink reads it every server tick.
  // Never disconnect the world-space view target merely to leave zoom.
  s.zoomControl.SetHealth(zoomed?ZOOM187.fov:ZOOM187.normalFov);
  s.zoomed=zoomed;s.nextDraw=0;
  return true;
}
function zoomButton187(s,pressed){
  const edge=pressed&&!s.zoomButton;s.zoomButton=pressed;
  if(edge)setZoom187(s,!s.zoomed);
}
function tickZoom187(s){
  if(!valid(s.zoomControl)||!valid(s.zoomAnchor)){leaveGunner('zoom_entity_lost');return false;}
  if(!s.zoomViewRequested){leaveGunner('gunner_view_not_started');return false;}
  // The official view target matches the native camera, including live mouse aim.
  const aim=gunnerViewAngles195(s);if(!aim)return false;
  s.zoomAnchor.Teleport({position:cameraPosition(),angles:aim});
  zoomButton187(s,!!s.p.IsInputPressed(CSInputs.ATTACK2));return true;
}
function releaseZoom187(s){
  if(!s)return;
  // DisableCameraAll cleans our single-seat controller even for death/disconnect,
  // where the official per-player DisableCamera input rejects a dead activator.
  if(s.zoomViewRequested&&valid(s.zoomControl))send(s.zoomControl,'DisableCameraAll');
  s.zoomViewRequested=false;s.zoomed=false;s.zoomButton=false;
}
Console.RegisterCheatCommand('ac187_zoom_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  const s=seat;
  Instance.Msg('[AC187_ZOOM] '+JSON.stringify({requested:s?.zoomed??false,fov:ZOOM187.fov,
    normalFov:ZOOM187.normalFov,ordinaryUsesPlayerDesiredFov:false,exitRestoresPlayerDesiredFov:true,
    viewControlRequested:s?.zoomViewRequested??false,controllerHealth:s&&valid(s.zoomControl)?s.zoomControl.GetHealth():null,slot:s?.slot,kind:s?.kind,camera:s?.camera?.GetMode(),
    anchor:s&&valid(s.zoomAnchor)?s.zoomAnchor.GetAbsOrigin():null,
    anchorAngles:s&&valid(s.zoomAnchor)?s.zoomAnchor.GetAbsAngles():null,
    eye:s?.p?.GetEyeAngles(),hud:s?.cache.get('ZoomHint'),
    officialBackendRejectsBot:s?.controller?.IsBot(),clientFovReadable:false}));
});
Console.RegisterCheatCommand('ac195_camera_status',()=>{
  if(!valid(unique('AC195_TestMode')))return;
  const s=seat,pose=e=>valid(e)?e.GetAbsOrigin():null;
  Instance.Msg('[AC195_CAMERA] '+JSON.stringify({phase:s?.phase??null,slot:s?.slot,zoomed:s?.zoomed??false,
    viewControlRequested:s?.zoomViewRequested??false,viewEntityReadable:false,
    nativeMode:s&&valid(s.camera)?s.camera.GetMode():null,nativeCamera:pose(s?.camera),
    viewTarget:pose(s?.zoomAnchor),body:pose(s?.p),
    anchorAngles:s&&valid(s.zoomAnchor)?s.zoomAnchor.GetAbsAngles():null,eye:s?.p?.GetEyeAngles(),
    requestedFov:s?.zoomed?ZOOM187.fov:ZOOM187.normalFov,
    controllerHealth:s&&valid(s.zoomControl)?s.zoomControl.GetHealth():null,
    expectedControllerSpawnflags:64,freeze:false,disarm:false,clientFovReadable:false,
    aimLimitState:s?.aimLimit195??null,aimLimits:GUNNER_AIM_LIMITS195,aimCorrection:GUNNER_AIM_CORRECTION195},
    (_,v)=>typeof v==='number'?Math.round(v*10000)/10000:v));
});
// Exercise the exact right-button edge handler only in an empty, bot-only lab.
Console.RegisterCheatCommand('ac187_zoom_lab',args=>{
  if(!valid(unique('AC176_Lab'))||!seat||Instance.GetAllPlayerControllers().some(c=>c.IsConnected()&&!c.IsBot()))return;
  if(args.trim()==='press'){zoomButton187(seat,true);zoomButton187(seat,true);}
  if(args.trim()==='release')zoomButton187(seat,false);
});
