      const sight=this.world.sight(shot.muzzle,this.world.center(victim),shot.actor);
      if(sight.startedInSolid||(sight.didHit&&sight.hitEntity!==victim))continue;
      const dealt=this.world.damage(victim,w.damage,shot,w);
