}
function visibilityProbePose195(e){
  return valid(e)?{position:e.GetAbsOrigin(),angles:e.GetAbsAngles(),color:e.GetColor?.()??null,scale:e.GetModelScale?.()??null}:null;
}
function visibilityProbeStatus195(){
  try{
    const p=visibilityProbe195;
    return {...lastVisibilityProbe195,armed:visibilityProbeArmed195,running:!!p,mode:p?.mode??visibilityProbeMode195,
      phase:seat?.phase??null,probe:p?visibilityProbePose195(p.entity):null,
      original:p?visibilityProbePose195(p.root):null,
      sameOriginal:!!p&&refs.root===p.root,parentAttached:p?.mode==='parent'&&valid(p.root)?p.root.GetParent()===p.entity:false,
      meaning:'creation-path A/B only; client transmission and rendering unobserved'};
  }catch(error){return {armed:visibilityProbeArmed195,error:visibilityProbeError195(error)};}
}
function clearVisibilityProbe195(reason='cancelled'){
  // Also cancel an armed-but-not-yet-started probe on every lifecycle boundary.
  visibilityProbeArmed195=false;
  const p=visibilityProbe195;visibilityProbe195=null;
  if(!p)return;
  if(p.mode==='parent'){
    const errors=[];
    try{
      if(valid(p.root)&&p.root.GetParent()===p.entity){
        // Restore the CURRENT world pose; never rewind a moving aircraft.
        const pose={position:p.root.GetAbsOrigin(),angles:p.root.GetAbsAngles()};
        p.root.SetParent(valid(p.originalParent)?p.originalParent:undefined);
        p.root.Teleport(pose);
      }
    }catch(error){errors.push('detach: '+visibilityProbeError195(error));}
    let stillParented=true;
    try{stillParented=valid(p.root)&&p.root.GetParent()===p.entity;}catch(error){errors.push('parent_check: '+visibilityProbeError195(error));}
    if(stillParented){
      // Do not delete a parent while the actual aircraft is still attached.
      // Retry from tick, or remove the helper once normal teardown removes root.
      p.cleanupPending=true;visibilityProbe195=p;
      lastVisibilityProbe195={...lastVisibilityProbe195,result:'cleanup_deferred',reason,errors};return;
    }
    try{if(valid(p.entity))p.entity.Remove();}catch(error){errors.push('remove: '+visibilityProbeError195(error));}
    lastVisibilityProbe195={...lastVisibilityProbe195,result:errors.length?'cleared_with_errors':'cleared',reason,clearedTime:now(),errors};return;
  }
  const errors=[];
  try{if(valid(p.entity))p.entity.Remove();}catch(error){errors.push('remove: '+visibilityProbeError195(error));}
  try{
    // Never touch a newly spawned generation or an externally recolored root.
    // releaseFlyby calls this before departure copies the original into a wreck.
    if(p.hidden&&refs.root===p.root&&valid(p.root)){
      const c=p.root.GetColor(),h=p.hiddenColor;
      if(['r','g','b','a'].every(k=>c[k]===h[k]))p.root.SetColor({...c,a:p.originalColor.a});
    }
  }catch(error){errors.push('restore: '+visibilityProbeError195(error));}
  lastVisibilityProbe195={...lastVisibilityProbe195,result:'cleared',reason,
    clearedTime:now(),errors};
}
function beginVisibilityParent195(t){
  visibilityProbeArmed195=false;
  const root=refs.root,s=seat;
  try{
    if(!valid(root)||s?.phase!=='intro'||!s.intro)throw Error('intro/root unavailable');
    if(Instance.FindEntitiesByName(VISIBILITY_PARENT_NAME195).some(valid))throw Error('parent helper already exists');
    const originalParent=root.GetParent();
    if(valid(originalParent))throw Error('aircraft already parented; refusing to change another hierarchy');
    const parts=typeof aircraftVisualParts185==='function'?aircraftVisualParts185():[root];
    const poses=parts.filter(valid).map(e=>({e,position:e.GetAbsOrigin(),angles:e.GetAbsAngles()}));
    const pose={position:root.GetAbsOrigin(),angles:root.GetAbsAngles()};
    const props={classname:'info_target',targetname:VISIBILITY_PARENT_NAME195,spawnflags:2,
      origin:pose.position,angles:{pitch:0,yaw:0,roll:0}};
    const made=Entities.Spawn([props]);
    const entity=made?.find(e=>valid(e)&&e.GetEntityName()===VISIBILITY_PARENT_NAME195);
    visibilityProbe195={mode:'parent',entity,root,seat:s,intro:s.intro,originalParent,props,createdTime:t};
    if(made?.length!==1||!valid(entity)||entity.GetClassName()!=='info_target')throw Error('parent spawn incomplete');
    root.SetParent(entity);root.Teleport(pose);
    for(const item of poses){
      const pos=item.e.GetAbsOrigin(),ang=item.e.GetAbsAngles();
      if(Math.hypot(...['x','y','z'].map(k=>pos[k]-item.position[k]))>.05||
        ['pitch','yaw','roll'].some(k=>Math.abs(((ang[k]-item.angles[k]+540)%360)-180)>.05))throw Error('parent changed a part world pose');
    }
    if(root.GetParent()!==entity)throw Error('parent assignment not retained');
    lastVisibilityProbe195={result:'parent_attached',createdTime:t,props,verifiedParts:poses.length};
    visibilityProbeLog195(visibilityProbeStatus195());
  }catch(error){
    clearVisibilityProbe195('parent_start_failed');
    lastVisibilityProbe195={...lastVisibilityProbe195,result:visibilityProbe195?'cleanup_deferred':'parent_start_failed',error:visibilityProbeError195(error)};
    visibilityProbeLog195(lastVisibilityProbe195);
  }
}
function beginVisibilityProbe195(t){
  if(visibilityProbeMode195==='parent'){beginVisibilityParent195(t);return;}
  visibilityProbeArmed195=false;
  const root=refs.root,s=seat;
  let p=null;
  try{
    if(!valid(root)||s?.phase!=='intro'||!s.intro)throw Error('intro/root unavailable');
    if(Instance.FindEntitiesByName(VISIBILITY_PROBE_NAME195).some(valid))throw Error('probe name already exists');
    const model=root.GetModelName(),color={...root.GetColor()},scale=root.GetModelScale();
    // Current authored airframe has scale 1. Refuse a future changed scale rather
    // than guess an undocumented model-scale key and compare unequal geometry.
    if(model!=='models/lms_aircraft/ac178/airframe.vmdl'||scale!==1)throw Error('unexpected airframe model/scale');
    const props={classname:'prop_dynamic',targetname:VISIBILITY_PROBE_NAME195,
      model,origin:{...root.GetAbsOrigin()},angles:{...root.GetAbsAngles()},
      clientSideEntity:0,spawnflags:2048,StartDisabled:false,renderamt:0,
      rendercolor:color.r+' '+color.g+' '+color.b,solid:0,disableshadows:1,
      fademindist:-1,fademaxdist:0};
    const made=Entities.Spawn([props]);
    // The request contains exactly one entity. Never remove unrelated results.
    const entity=made?.find(e=>valid(e)&&e.GetEntityName()===VISIBILITY_PROBE_NAME195);
    p={entity,root,seat:s,intro:s.intro,hidden:false,originalColor:color,
      hiddenColor:{...color,a:0},props,createdTime:t};
    visibilityProbe195=p;
    if(made?.length!==1||!valid(entity)||entity.GetClassName()!=='prop_dynamic')throw Error('direct spawn incomplete');
    entity.SetColor({...color,a:255});
    send(entity,'DisableCollision');
    if(entity.GetModelName()!==model||entity.GetModelScale()!==scale)throw Error('direct model mismatch');
    // Set owned state before the call, so cleanup can undo a mutating-then-
    // throwing API. The original stays visible until the probe is initialized.
    p.hidden=true;root.SetColor(p.hiddenColor);
    lastVisibilityProbe195={result:'spawned',createdTime:t,props};
    visibilityProbeLog195(visibilityProbeStatus195());
  }catch(error){
    clearVisibilityProbe195('spawn_failed');
    lastVisibilityProbe195={...lastVisibilityProbe195,result:'spawn_failed',error:visibilityProbeError195(error)};
    visibilityProbeLog195(lastVisibilityProbe195);
  }
}
function tickVisibilityProbe195(t){
  // Fully isolated: an experimental diagnostic must never enter native tick's
  // gameplay-error catch, which tears down the actual gunner and weapon state.
  try{
    if(visibilityProbe195?.cleanupPending){clearVisibilityProbe195('deferred_parent_cleanup');return;}
    if(!valid(unique('AC195_TestMode'))){clearVisibilityProbe195('test_marker_missing');return;}
    if(visibilityProbeArmed195&&seat?.phase==='intro')beginVisibilityProbe195(t);
    const p=visibilityProbe195;if(!p)return;
    if(seat!==p.seat||seat?.intro!==p.intro||seat?.phase!=='intro'||refs.root!==p.root||
        !valid(p.root)||!valid(p.entity)){clearVisibilityProbe195('intro_or_entity_changed');return;}
    // The parent helper stays stationary; normal flight owns all actual motion.
    // Neither diagnostic changes players, cameras, weapon state or fuel.
    if(p.mode==='parent'){
      if(p.root.GetParent()!==p.entity)clearVisibilityProbe195('parent_changed');
    }else p.entity.Teleport({position:p.root.GetAbsOrigin(),angles:p.root.GetAbsAngles()});
  }catch(error){
    clearVisibilityProbe195('probe_tick_failed');
    lastVisibilityProbe195={...lastVisibilityProbe195,error:visibilityProbeError195(error)};
    visibilityProbeLog195(lastVisibilityProbe195);
  }
}
Console.RegisterCheatCommand('ac195_visibility_probe',args=>{
  try{
    const action=String(args||'status').trim().toLowerCase();
    if(action==='off'){clearVisibilityProbe195('console_off');visibilityProbeLog195(visibilityProbeStatus195());return;}
    if(!valid(unique('AC195_TestMode')))return;
    if(action==='direct'||action==='parent'){
      if(typeof introCameraArm195!=='undefined'&&(introCameraArm195||introCameraProbe195)){visibilityProbeLog195({result:'intro_camera_probe_conflict'});return;}
      const busy=seat||cinema188||wreck185||deployment.pending||departure.phase==='departing'||
        (aircraftDeployed195&&departure.phase!=='departed');
      if(busy||visibilityProbe195){visibilityProbeLog195({result:'rejected_busy'});return;}
      visibilityProbeMode195=action;visibilityProbeArmed195=true;lastVisibilityProbe195={result:'armed',createdTime:null,armedTime:now()};
    }else if(action!=='status'){visibilityProbeLog195({result:'usage',usage:'direct | parent | off | status'});return;}
    visibilityProbeLog195(visibilityProbeStatus195());
  }catch(error){visibilityProbeLog195({result:'command_error',error:visibilityProbeError195(error)});}
});
// One-shot native-camera diagnostic. It never changes the normal cinema path.
// Public APIs cannot read the plugin's player list or actual client view entity.
let introCameraArm195=null,introCameraProbe195=null;
let lastIntroCameraProbe195={result:'disabled'};
function introCameraProbeLog195(row){try{Instance.Msg('[AC195_INTRO_CAMERA] '+JSON.stringify(row));}catch(_){} }
function singleIntroHuman195(){
  const humans=Instance.GetAllPlayerControllers().filter(c=>valid(c)&&c.IsConnected()&&!c.IsBot());
  return humans.length===1?humans[0]:null;
}
function introCameraIdentity195(c,p){return valid(c)&&c.IsConnected()&&c.GetPlayerPawn()===p&&operator(p)&&p.GetPlayerController()===c;}
function introCameraProbeState195(){
  return {...lastIntroCameraProbe195,armed:!!introCameraArm195,running:!!introCameraProbe195,
    slot:(introCameraProbe195||introCameraArm195)?.controller.GetPlayerSlot()??null,
    meaning:'native-only intro A/B; client view entity and rendering are not readable'};
}
function clearIntroCameraProbe195(reason){
  if(introCameraArm195||introCameraProbe195)lastIntroCameraProbe195={...lastIntroCameraProbe195,result:'cleared',reason,time:now()};
  introCameraArm195=null;introCameraProbe195=null;
}
function takeIntroCameraProbe195(owner){
  const arm=introCameraArm195;if(!arm)return false;
  // Consume before validation: a rejected attempt must never affect a later sortie.
  introCameraArm195=null;
  const reason=!valid(unique('AC195_TestMode'))?'test_marker_missing':
    now()<arm.readyAt?'controller_cleanup_not_settled':
    singleIntroHuman195()!==arm.controller?'single_human_changed':
    owner.controller!==arm.controller||owner.p!==arm.p||!introCameraIdentity195(arm.controller,arm.p)?'pawn_changed':
    valid(priorView188(owner.p))||owner.p.GetParent()?'other_camera_or_parent':
    owner.zoomViewRequested?'zoom_already_requested':
    !owner.body||owner.body.move!==CSMoveType.WALK?'not_unmounted_at_entry':
    visibilityProbeArmed195||visibilityProbe195?'visibility_probe_conflict':null;
  if(reason){lastIntroCameraProbe195={result:'rejected_start',reason,time:now(),normalFallback:true};introCameraProbeLog195(lastIntroCameraProbe195);return false;}
  introCameraProbe195={...arm,owner,start:now()};
  lastIntroCameraProbe195={result:'started',time:now(),slot:owner.slot,cleanupReadyAt:arm.readyAt};
  introCameraProbeLog195(introCameraProbeState195());return true;
}
function validIntroCameraProbe195(owner){
  const p=introCameraProbe195;
  return !!p&&p.owner===owner&&valid(unique('AC195_TestMode'))&&singleIntroHuman195()===p.controller&&
    introCameraIdentity195(p.controller,p.p)&&!valid(priorView188(p.p))&&!p.p.GetParent();
}
Console.RegisterCheatCommand('ac195_intro_camera',args=>{
  try{
    const action=String(args||'status').trim().toLowerCase();
    if(action==='off'){
      const running=!!introCameraProbe195;clearIntroCameraProbe195('console_off');
      if(running&&cinema188?.nativeOnly195)leaveGunner('intro_camera_probe_off');
      introCameraProbeLog195(introCameraProbeState195());return;
    }
    if(!valid(unique('AC195_TestMode')))return;
    if(action==='native'){
      const busy=seat||cinema188||wreck185||deployment.pending||departure.phase==='departing'||
        (aircraftDeployed195&&departure.phase!=='departed');
      const c=singleIntroHuman195(),p=valid(c)?c.GetPlayerPawn():null;
      const camera=operator(p)?p.GetCustomCamera():null;
      const controls=[unique('AC187_ZoomControl'),unique('AC188_IntroControl')];
      const reason=busy?'sortie_busy':visibilityProbeArmed195||visibilityProbe195?'visibility_probe_conflict':
        !c||!introCameraIdentity195(c,p)?'requires_one_live_ct_human':
        !valid(camera)||camera.GetMode()!==CustomCameraMode.DISABLED?'native_camera_busy':
        p.GetParent()||p.GetMoveType()!==CSMoveType.WALK||valid(priorView188(p))?'player_mounted_or_other_view':
        controls.some(e=>!valid(e))?'own_controllers_missing':null;
      if(reason){introCameraProbeLog195({result:'rejected_arm',reason});return;}
      // Only our two single-aircraft controllers, while idle. Allow their queued
      // Disable inputs to finish BEFORE native mode is activated at the button.
      for(const e of controls)send(e,'DisableCameraAll');
      introCameraArm195={controller:c,p,camera,readyAt:now()+.1};
      lastIntroCameraProbe195={result:'armed',time:now(),readyAt:introCameraArm195.readyAt};
    }else if(action!=='status'){introCameraProbeLog195({result:'usage',usage:'native | off | status'});return;}
    introCameraProbeLog195(introCameraProbeState195());
  }catch(error){clearIntroCameraProbe195('command_error');introCameraProbeLog195({result:'command_error',error:String(error).slice(0,180)});}
});
// AC195 visual only. The combat volume and damage solver never read this result.
// The dedicated particle joins CP0 and CP1; it has no free-flight tracer child.
const TRACER25_VISUAL195 = Object.freeze({
  effect:'particles/lms_ac130_195/tracer25_endpoint195.vpcf',
  stopAfter:0.025, removeAfter:0.20
});

// Keep the same world-space shot axis as the combat solver. A failed/solid trace
// must not become a full-range visual through a wall. io.trace ignores players
// intentionally: the original minigun volume can affect several T players.
function launch25mmVisual195(shot, range, io) {
  const finite=v=>!!v&&[v.x,v.y,v.z].every(Number.isFinite);
  if(!finite(shot?.muzzle)||!finite(shot?.direction)||!Number.isFinite(range)||range<=0)
    return null;
  const length=Math.hypot(shot.direction.x,shot.direction.y,shot.direction.z);
  if(length<1e-9)return null;
  const direction={x:shot.direction.x/length,y:shot.direction.y/length,z:shot.direction.z/length};
  const start={...shot.muzzle};
  const far={x:start.x+direction.x*range,y:start.y+direction.y*range,z:start.z+direction.z*range};
  const ray=io.trace(start,far,shot.actor);
  if(!ray||ray.startedInSolid||!finite(ray.end))return null;
  const delta={x:ray.end.x-start.x,y:ray.end.y-start.y,z:ray.end.z-start.z};
  const distance=delta.x*direction.x+delta.y*direction.y+delta.z*direction.z;
  const offAxis=Math.hypot(delta.x-direction.x*distance,delta.y-direction.y*distance,delta.z-direction.z*distance);
  // Reject malformed adapter results rather than inventing a different endpoint.
  // Source trace rounding at large world coordinates is allowed up to 0.25 unit.
  if(distance<0.01||distance>range+0.25||offAxis>0.25)return null;
  const end={...ray.end};
  const parts=io.spawn(start,direction);
  if(!Array.isArray(parts)||parts.length!==2)throw Error('Incomplete AC195 25mm visual template');
  // Register lifetime first, so an entity-input failure cannot leak this pair.
  io.retire(parts,TRACER25_VISUAL195.removeAfter,io.time()+TRACER25_VISUAL195.stopAfter);
  parts[0].Teleport({position:end});
  io.start(parts[1]);
  return {start,end,direction,distance,didHit:!!ray.didHit};
}
import {Instance,Console,Entities,CSDamageTypes,CSDamageFlags,CSGearSlot,CSInputs,CSMoveType,CustomCameraMode} from 'cs_script/point_script';

// The airframe root supplies the live three-dimensional pose for each station.
const now=()=>Instance.GetGameTime(),valid=e=>!!e?.IsValid();
const alive=e=>valid(e)&&e.GetClassName()==='player'&&e.IsAlive();
const enemy=e=>alive(e)&&e.GetTeamNumber()===SETTINGS.enemyTeam;
const operator=e=>alive(e)&&e.GetTeamNumber()===SETTINGS.operatorTeam;
const unique=n=>{const es=Instance.FindEntitiesByName(n).filter(valid);return es.length===1?es[0]:null;};
const send=(e,input,value,activator,delay=0)=>{if(valid(e))Instance.EntFireAtTarget({target:e,input,value,activator,caller:refs.manager,delay});};
const angle=d=>({pitch:-Math.atan2(d.z,Math.hypot(d.x,d.y))*180/Math.PI,yaw:Math.atan2(d.y,d.x)*180/Math.PI,roll:0});
const forward=a=>({x:Math.cos(a.pitch*Math.PI/180)*Math.cos(a.yaw*Math.PI/180),y:Math.cos(a.pitch*Math.PI/180)*Math.sin(a.yaw*Math.PI/180),z:-Math.sin(a.pitch*Math.PI/180)});
const add=(p,d,n)=>({x:p.x+d.x*n,y:p.y+d.y*n,z:p.z+d.z*n});
const visuals=new Map(),effects=new Set();let serial=0,active=false,held=null;
const refs={muzzles:{}};
let retryBindAt=0,roundRestarting=false;
// Explicit resource warming only. CSPrecache acknowledges resource loading on
// server/clients; it does not acknowledge spawned entities or rendered frames.
const AIRCRAFT_MODEL_RESOURCES195=Object.freeze([
  'models/lms_aircraft/ac178/airframe.vmdl',
  ...['25','40','105'].flatMap(k=>['models/lms_aircraft/ac178/carriage'+k+'.vmdl','models/lms_aircraft/ac178/barrel'+k+'.vmdl'])
]);
let assetPrecache195=null,assetPrecacheGeneration195=0,assetPrecacheError195=null;
function precacheAssets195(previous=assetPrecache195){
  let next;
  try{
    next=Instance.Precache({resources:[...new Set([
      ...AIRCRAFT_MODEL_RESOURCES195,
      ...Array.from({length:4},(_,i)=>'particles/lms_ac188/flyby_smoke'+i+'.vpcf'),
      CRASH185.particle,...Object.values(WEAPONS).flatMap(w=>[w.model,w.muzzleFx,w.trailFx,w.impactFx]).filter(Boolean)
    ])]});
  }catch(error){assetPrecacheError195=String(error).slice(0,160);assetPrecache195=previous;return;}
  if(!next){assetPrecacheError195='precache_handle_unavailable';assetPrecache195=previous;return;}
  assetPrecache195=next;assetPrecacheGeneration195++;assetPrecacheError195=null;
  // Tools reload returns the old handle through OnScriptReload memory. Acquire
  // the new request before releasing it; ordinary round resets keep this handle.
  if(previous&&previous!==next)try{previous.Release();}
    catch(error){assetPrecacheError195='prior_handle_release: '+String(error).slice(0,130);}
}
function precacheProbe195(method,...args){
  if(!assetPrecache195)return null;
  try{return assetPrecache195[method](...args);}
  catch(error){return {error:String(error).slice(0,160)};}
}
Console.RegisterCheatCommand('ac195_asset_status',()=>{
  if(!valid(unique('AC195_TestMode'))&&!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC195_ASSETS] '+JSON.stringify({time:now(),handlePresent:!!assetPrecache195,
    generation:assetPrecacheGeneration195,aircraftModelCount:AIRCRAFT_MODEL_RESOURCES195.length,
    serverLoading:precacheProbe195('IsServerLoading'),serverLoaded:precacheProbe195('IsServerLoaded'),
    allLoaded:precacheProbe195('IsLoadedForAll'),error:assetPrecacheError195,
    meaning:'resource loading only; entity transmission and client rendering unobserved'}));
  for(const c of Instance.GetAllPlayerControllers())if(valid(c)&&c.IsConnected()){
    const slot=c.GetPlayerSlot();
    Instance.Msg('[AC195_ASSET_CLIENT] '+JSON.stringify({time:now(),slot,bot:c.IsBot(),
      loading:precacheProbe195('IsClientLoading',slot),loaded:precacheProbe195('IsClientLoaded',slot)}));
  }
});
function instantiate(name,position,angles,classes){
  const tpl=unique('LMS_AC130_Template_'+name);
  const parts=valid(tpl)?tpl.ForceSpawn(position,angles)||[]:[];
  const sorted=classes.map(cls=>parts.find(e=>valid(e)&&e.GetClassName()===cls));
  if(parts.length!==classes.length||sorted.some(e=>!e)){
    remove(parts);throw Error('Incomplete AC130 template '+name);
  }
  return sorted;
}
function remove(es){for(const e of es)if(valid(e))e.Remove();}
function transient(es,seconds,stopAt=null){const fx={es,until:now()+seconds,stopAt,stopped:false};effects.add(fx);return fx;}
function cleanFx(time){for(const fx of effects){if(!fx.stopped&&fx.stopAt!==null&&time>=fx.stopAt){fx.stopped=true;for(const e of fx.es)if(valid(e)&&e.GetClassName()==='info_particle_system')send(e,'Stop');}if(time>=fx.until){remove(fx.es);effects.delete(fx);}}}
// The six gun props are separate entities, not part of the airframe root's
// collision identity. Exclude the entire battery and its visual shells from
// weapon traces. Map geometry, unrelated props and target players still block.
function weaponTraceIgnore195(actor){
  const own=[actor,refs.root,...Object.values(refs.muzzles),
    ...Object.values(stations).flatMap(s=>[s.carriage,s.barrel]),...(refs.weaponViewAnchors||[])];
  // Only this battery's camera helpers: never hide/filter arbitrary map props.
  if(typeof seat!=='undefined'&&seat)own.push(seat.camera,seat.zoomAnchor);
  if(typeof visibilityProbeEntity195==='function')own.push(visibilityProbeEntity195());
  for(const parts of visuals.values())for(const e of parts)
    if(valid(e)&&e.GetClassName()==='prop_dynamic')own.push(e);
  return [...new Set(own.filter(valid))];
}
function disableWeaponVisualCollision195(parts){
  // These are authored solid=0. Reassert the native prop input after spawning
  // so visual animation never becomes a second, competing projectile solver.
  for(const e of parts)if(valid(e)&&e.GetClassName()==='prop_dynamic')send(e,'DisableCollision');
}
const weaponTraceDiagnostics195={serial:0,records:[],lastFire:null,nextWarning:-Infinity};
function weaponTraceEntity195(e){
  if(!valid(e))return null;
  const cls=e.GetClassName();
  return {classname:cls,name:cls==='player'?'':String(e.GetEntityName?.()||'').slice(0,96),
    position:e.GetAbsOrigin(),world:typeof e.IsWorld==='function'?e.IsWorld():null,
    model:typeof e.GetModelName==='function'?String(e.GetModelName()).slice(0,192):null,
    modelScale:typeof e.GetModelScale==='function'?e.GetModelScale():null};
}
function weaponTraceSnapshot195(tr){
  return {didHit:!!tr.didHit,startedInSolid:!!tr.startedInSolid,fraction:tr.fraction??null,
    end:tr.end??null,normal:tr.normal??null,hitEntity:weaponTraceEntity195(tr.hitEntity)};
}
function printWeaponTrace195(tag,value){
  Instance.Msg(tag+' '+JSON.stringify(value,(_,v)=>typeof v==='number'&&Number.isFinite(v)?Math.round(v*10000)/10000:v));
}
function traceWeapon195(start,end,actor,context){
  const ignoreEntity=weaponTraceIgnore195(actor);
  const tr=Instance.TraceLine({start,end,ignoreEntity,traceHitboxes:true});
  const shot=context?.shot,kind=shot?.kind??context?.kind;
  if(['40','105'].includes(kind)&&(tr.didHit||tr.startedInSolid)){
    const travel=shot?.travel??0;
    const step=tr.end?Math.hypot(tr.end.x-start.x,tr.end.y-start.y,tr.end.z-start.z):0;
    const row={serial:++weaponTraceDiagnostics195.serial,time:now(),kind,phase:context.phase,
      shotId:shot?.id??null,start:{...start},requestedEnd:{...end},muzzle:shot?.muzzle??context?.muzzle??null,
      travelBefore:travel,travelAtHit:travel+step,ignoreCount:ignoreEntity.length,
      hitWasInIgnoreList:!!tr.hitEntity&&ignoreEntity.includes(tr.hitEntity),...weaponTraceSnapshot195(tr)};
    weaponTraceDiagnostics195.records.push(row);
    if(weaponTraceDiagnostics195.records.length>32)weaponTraceDiagnostics195.records.shift();
    // Keep normal impacts in the diagnostic buffer. Repeated failed shots
    // against the same obstruction must not flood the dedicated-server log.
    if((tr.startedInSolid||context.phase==='barrel')&&row.time>=weaponTraceDiagnostics195.nextWarning){
      weaponTraceDiagnostics195.nextWarning=row.time+1;
      printWeaponTrace195('[AC195_SHOT_TRACE]',row);
    }
  }
  return tr;
}
const world={
  liveOperator:operator,liveEnemy:enemy,
  available:()=>active&&canUseAircraft()&&!roundRestarting,
  trace:traceWeapon195,
  sight:(start,end,actor)=>Instance.TraceLine({start,end,ignoreEntity:weaponTraceIgnore195(actor),ignorePlayers:true}),
  players:()=>Instance.GetAllPlayerControllers().filter(c=>c.IsConnected()).map(c=>c.GetPlayerPawn()).filter(valid),
  volumeTargets:(s,w)=>{
    // Adapt the mech's ~80-unit trigger cross-section to a swept volume. Trace
    // player collision hulls; ignore already tested players so a crowd is hit,
    // while map geometry/solid props still block the sweep. No 25mm blast sphere.
    const ignore=weaponTraceIgnore195(s.actor),targets=[],end=add(s.muzzle,s.direction,SETTINGS.range);
    const limit=world.players().length+1;
    for(let i=0;i<limit;i++){
      const tr=Instance.TraceSphere({start:s.muzzle,end,radius:w.beamRadius,ignoreEntity:ignore,traceHitboxes:false});
      if(!tr.didHit||tr.startedInSolid||!valid(tr.hitEntity)||tr.hitEntity.GetClassName()!=='player'||ignore.includes(tr.hitEntity))break;
      ignore.push(tr.hitEntity);if(enemy(tr.hitEntity))targets.push(tr.hitEntity);
    }
    return targets;
  },
  center:p=>{const o=p.GetAbsOrigin(),eye=p.GetEyePosition();return {x:o.x,y:o.y,z:(o.z+eye.z)/2};},
  launch:(s,w)=>{
    if(w.muzzleFx){
      const visual=launch25mmVisual195(s,SETTINGS.range,{
        trace:world.sight,spawn:(p,d)=>instantiate('25',p,angle(d),['info_target','info_particle_system']),
        retire:transient,time:now,start:e=>send(e,'Start')
      });
      if(!visual)throw Error('No valid unobstructed 25mm visual segment');
    }else{
      const parts=instantiate(s.kind,s.position,angle(s.direction),['prop_dynamic','info_particle_system']);
      visuals.set(s.id,parts);
      disableWeaponVisualCollision195(parts);
      parts[1].Teleport({position:add(s.position,s.direction,w.trailOffset||0)});
      send(parts[1],'Start');
    }
  },
  move:s=>{for(const e of visuals.get(s.id)||[])if(valid(e))e.Teleport({position:e.GetClassName()==='info_particle_system'?add(s.position,s.direction,WEAPONS[s.kind].trailOffset||0):s.position,angles:angle(s.direction)});},
  close:s=>{for(const e of visuals.get(s.id)||[])if(valid(e)){if(e.GetClassName()==='info_particle_system'&&effects.size<96){send(e,'Stop');transient([e],2.0);}else e.Remove();}visuals.delete(s.id);},
  impact:(s,w,point)=>{weaponAudio186.impact(s.kind,point,now());if(w.impactFx&&effects.size<96)try{
    const parts=instantiate('Impact'+s.kind,point,{pitch:0,yaw:0,roll:0},['info_particle_system']);
    transient(parts,w.fxSeconds);send(parts[0],'Start');
  }catch(e){Instance.Msg('[AC130176] visual impact failed: '+e);}},
  damage:(p,damage,s)=>{
    const before=p.GetHealth();
    const result=p.TakeDamage({damage,damageTypes:s.kind==='25'?CSDamageTypes.SONIC:CSDamageTypes.BLAST,
      damageFlags:CSDamageFlags.IGNORE_ARMOR|CSDamageFlags.SUPPRESS_PHYSICS_FORCE,
      attacker:operator(s.actor)?s.actor:undefined,inflictor:valid(refs.manager)?refs.manager:undefined});
    const lost=valid(p)?before-p.GetHealth():0;
    if(Instance.GetMapName()==='lms_ac130_range176')
        Instance.Msg('[AC176_DAMAGE] '+JSON.stringify({kind:s.kind,slot:valid(p)?p.GetPlayerController()?.GetPlayerSlot():undefined,before,lost,result}));
    return Math.max(lost,Number.isFinite(result)?result:0);
  },
  slow:(p,kind,time)=>applyGunSlow(p,kind,time)
};
const battery=new Battery(world);
function bind(){
  refs.manager=unique('LMS_AC130_Weapons161');refs.root=unique('LMS_AC130_Root161');
  refs.weaponViewAnchors=['AC187_ZoomAnchor','AC188_CinemaActive'].map(unique)
    .filter(e=>valid(e)&&e.GetClassName()==='prop_dynamic');
  for(const key of Object.keys(WEAPONS))refs.muzzles[key]=unique('LMS_AC130_Muzzle'+key+'_161');
  active=[refs.manager,refs.root,...Object.values(refs.muzzles)].every(valid)&&bindStations();
  if(active)disableWeaponVisualCollision195(weaponTraceIgnore195());
  retryBindAt=now()+1;bindCinema188();
  if(active)Instance.Msg('[AC130161] weapon service bound');
}
function authorized(input,kind){return operator(input.activator)&&valid(input.caller)&&['LMS_AC130_Control161','LMS_AC130_Test'+kind+'_161'].includes(input.caller.GetEntityName());}
function aimStation(kind,p){
  if(!active||!operator(p))return;
  if(seat?.phase!=='active'||seat.p!==p||seat.kind!==kind)return;
  const aim=gunnerViewAngles195(seat);if(!aim)return;
  const eye=cameraPosition();
  const ray=Instance.TraceLine({start:eye,end:add(eye,forward(aim),SETTINGS.range),ignoreEntity:weaponTraceIgnore195(p),traceHitboxes:true});
  if(!ray.startedInSolid)return positionStation(kind,now(),ray.end);
}
function shoot(kind,p){
  if(!seatCanShoot(kind,p))return {ok:false,reason:'seat_or_fuel'};
  const pose=aimStation(kind,p);
  if(!pose)return {ok:false,reason:'no_port_side_aim'};
  const t=now(),muzzle=refs.muzzles[kind].GetAbsOrigin();
  const result=battery.fire(kind,p,muzzle,pose.dir,t,pose.pivot);
  if(result.ok||!['cooldown','reloading'].includes(result.reason))
    weaponTraceDiagnostics195.lastFire={time:t,kind,ok:result.ok,reason:result.reason??null,
      shotId:result.id??null,muzzle:{...muzzle},pivot:{...pose.pivot},direction:{...pose.dir}};
  if(result.ok){
    weaponAudio186.fire(kind,muzzle,t);
    const s=stations[kind];s.lastFire=t;
    positionStation(kind,t);
    s.lastShot={time:t,muzzle,dir:pose.dir,pivot:s.carriage.GetAbsOrigin(),
      kickedBreech:breechPosition(kind,s),kickedTip:s.barrel.GetAbsOrigin()};
  }
  return result;
}
// Read-only diagnostics for the isolated full-map test. Each message is a single
// shot/probe, keeping RCON replies below its per-message truncation threshold.
Console.RegisterCheatCommand('ac195_weapon_trace_status',()=>{
  if(!valid(unique('AC195_TestMode')))return;
  printWeaponTrace195('[AC195_SHOT_STATUS]',{time:now(),lastFire:weaponTraceDiagnostics195.lastFire,
    retainedHits:weaponTraceDiagnostics195.records.length,serial:weaponTraceDiagnostics195.serial});
  for(const row of weaponTraceDiagnostics195.records)printWeaponTrace195('[AC195_SHOT_TRACE]',row);
});
Console.RegisterCheatCommand('ac195_weapon_collision_probe',()=>{
  if(!valid(unique('AC195_TestMode')))return;
  const s=typeof seat!=='undefined'?seat:null;
  if(!s||s.phase!=='active'||!operator(s.p)||!valid(refs.root)||!valid(refs.muzzles[s.kind])){
    printWeaponTrace195('[AC195_COLLISION_PROBE]',{active:false,time:now()});return;
  }
  const ignoreEntity=weaponTraceIgnore195(s.p),eye=cameraPosition(),muzzle=refs.muzzles[s.kind].GetAbsOrigin();
  const eyeEnd=add(eye,forward(s.p.GetEyeAngles()),SETTINGS.range);
  const cameraTrace=Instance.TraceLine({start:eye,end:eyeEnd,ignoreEntity,traceHitboxes:true});
  const pivot=stations[s.kind].carriage.GetAbsOrigin();
  const axisEnd=add(muzzle,forward(refs.muzzles[s.kind].GetAbsAngles()),SETTINGS.range);
  printWeaponTrace195('[AC195_COLLISION_PROBE]',{active:true,time:now(),kind:s.kind,eye,pivot,muzzle,
    ignoreCount:ignoreEntity.length});
  const ignored=ignoreEntity.map(e=>({classname:e.GetClassName(),name:e.GetClassName()==='player'?'':String(e.GetEntityName?.()||'').slice(0,96)}));
  for(let i=0;i<ignored.length;i+=8)printWeaponTrace195('[AC195_COLLISION_PROBE_IGNORE]',{offset:i,entities:ignored.slice(i,i+8)});
  for(const [phase,start,end,trace] of [
    ['camera',eye,eyeEnd,cameraTrace],['barrel',pivot,muzzle,null],
    ['muzzle_to_aim',muzzle,cameraTrace.end,null],['barrel_axis',muzzle,axisEnd,null]
  ])if(end)printWeaponTrace195('[AC195_COLLISION_PROBE_TRACE]',{phase,start,requestedEnd:end,
    ...weaponTraceSnapshot195(trace||Instance.TraceLine({start,end,ignoreEntity,traceHitboxes:true}))});
});
for(const kind of Object.keys(WEAPONS)){
  Instance.OnScriptInput('Aim'+kind,input=>{if(authorized(input,kind))aimStation(kind,input.activator);});
  Instance.OnScriptInput('Fire'+kind,input=>{if(authorized(input,kind))Instance.Msg('[AC130161] '+JSON.stringify({kind,...shoot(kind,input.activator)}));});
  // For the later gunner controller: renew at least every 0.25s while held. No catch-up bursts.
  Instance.OnScriptInput('Hold'+kind,input=>{if(authorized(input,kind))held={kind,actor:input.activator,until:now()+0.25};});
}
function nativeHurtName(entity){
  return entity.GetEntityName().replace(/^\[PR#\]/,'').split('&')[0].replace(/_\d+$/,'');
}
Instance.OnPlayerDamage(({player,inflictor,damage,damageTypes})=>{
  // Match direct flame contact. Ignition and unrelated fire use different inflictors.
  if(!(damageTypes&CSDamageTypes.BURN)||damage<=0||roundRestarting)return;
  if(!valid(inflictor)||inflictor.GetClassName()!=='trigger_hurt'||
     nativeHurtName(inflictor)!=='Human_Item_Mech_Hurt_Fire')return;
  if(enemy(player)&&player.GetHealth()>0)applyGunSlow(player,'mechFlame',now());
});
// The tank reports actual health loss only for its own Stage 5 trigger instances.
Instance.OnScriptInput('TankShellSlow238',({activator,caller})=>{
  if(roundRestarting||!alive(activator)||!valid(caller)||caller.GetClassName()!=='trigger_hurt')return;
  const name=nativeHurtName(caller);
  if(name!=='LMS203_TankDamage'&&name!=='LMS203_TankDamageH')return;
  if(activator.GetTeamNumber()===2||activator.GetTeamNumber()===3)applyGunSlow(activator,'tank',now());
});
Instance.OnScriptInput('TankDefenseSlow247',({activator,caller})=>{
  if(roundRestarting||!alive(activator)||!valid(caller)||caller.GetClassName()!=='point_script'||
    caller.GetEntityName()!=='lms_ax_manager')return;
  const team=activator.GetTeamNumber();
  if(team===2||team===3)applyGunSlow(activator,'tankDefense',now());
});
Instance.OnScriptInput('StopFire',({activator,caller})=>{if(valid(caller)&&caller.GetEntityName()==='LMS_AC130_Control161'&&held?.actor===activator)held=null;});
function retireAircraftWeapons195(){held=null;weaponAudio186.stopLoop();stopEngineSmoke188();}
// Full cleanup is reserved for round/script boundaries. Departure must retain
// projectiles, impact effects, one-shot sounds and remaining slow durations.
function clear(reset=false){retireAircraftWeapons195();weaponAudio186.clear();battery.clear();for(const f of effects)remove(f.es);effects.clear();if(reset)battery.reset(now());clearGunSlows();weaponTraceDiagnostics195.nextWarning=-Infinity;}
function tickAircraftProjectiles(t){
  // Several impacts can land on the same player within this tick. Apply the
  // strongest combined modifier once, then keep the original refresh cadence.
  batchingGunSlows=true;
  try{battery.tick(t);}finally{batchingGunSlows=false;}
  maintainGunSlows(t);
}
function tick(){const t=now();try{if(!roundRestarting&&canUseAircraft()&&!active&&t>=retryBindAt)bind();
if(active){if(!valid(refs.root)||!valid(refs.manager)){active=false;retireAircraftWeapons195();}else{
  if(canUseAircraft()){
  tickFlight192(t);observeWreckMotion192(t);
  const introElapsed=seat?.phase==='intro'&&seat.intro?t-seat.intro.start:null;
  for(const k of Object.keys(WEAPONS))positionStation(k,t,null,introElapsed);
  if(held&&operator(held.actor)&&t<held.until)shoot(held.kind,held.actor);else held=null;
  }else held=null;
}}
// Flight simulation does not depend on the aircraft or its occupant surviving.
if(!roundRestarting){tickAircraftProjectiles(t);tickTestScene195(t);}
tickCore188(t);gunnerTick(t);if(typeof tickVisibilityProbe195==='function')tickVisibilityProbe195(t);selectionTick(t);tickWreck185(t);tickAudio186(t);cleanFx(t);}catch(e){leaveGunner('tick_error');held=null;weaponAudio186.clear();battery.clear();Instance.Msg('[AC130161] tick stopped: '+e);}finally{Instance.SetNextThink(t+1/64);}}
Instance.SetThink(tick);
Instance.OnActivate(()=>{precacheAssets195();bind();bindSelection();battery.reset(now());Instance.SetNextThink(now());});
Instance.OnBeginRoundRestart(()=>{if(typeof clearVisibilityProbe195==='function')clearVisibilityProbe195('round_restart');if(typeof clearIntroCameraProbe195==='function')clearIntroCameraProbe195('round_restart');beginTestSceneRound195();knownCTItemWeapons.clear();leaveGunner('round_restart');resetFlight192();resetCinemaClock188();clearWreck185();resetDeploymentRound();roundRestarting=true;active=false;clear(true);});
Instance.OnRoundStart(()=>{if(typeof clearVisibilityProbe195==='function')clearVisibilityProbe195('round_start');if(typeof clearIntroCameraProbe195==='function')clearIntroCameraProbe195('round_start');leaveGunner('round_start');resetFlight192();resetCinemaClock188();clearWreck185();fuelEnd=null;resetDeploymentRound();resetDepartureRound();roundRestarting=false;clear(true);bind();bindSelection();testSceneRoundStart195();Instance.SetNextThink(now());});
Instance.OnScriptReload({before:()=>{if(typeof clearVisibilityProbe195==='function')clearVisibilityProbe195('script_reload');if(typeof clearIntroCameraProbe195==='function')clearIntroCameraProbe195('script_reload');leaveGunner('script_reload');stopFlight192(now(),'script_reload');clearWreck185();active=false;clear();return {...selectionBeforeReload(),fuelEnd192:fuelEnd,assetPrecache195};},after:memory=>{precacheAssets195(memory?.assetPrecache195);selectionAfterReload(memory);resetFlight192();fuelEnd=Number.isFinite(memory?.fuelEnd192)?memory.fuelEnd192:null;bind();bindSelection();Instance.SetNextThink(now());}});
// No Reload input or player reload-key binding: only an empty magazine reloads.
Console.RegisterCheatCommand('ac130_weapon_status',()=>Instance.Msg('[AC130162] '+JSON.stringify({active,shots:battery.shots.size,effects:effects.size,ready:battery.ready,magazines:battery.status(now()),settings:WEAPONS})));
Console.RegisterCheatCommand('ac178_mount_status',()=>{
  if(!active||!valid(unique('AC176_Lab')))return;
  const entries=Object.fromEntries(Object.entries(stations).map(([k,s])=>[k,{pivot:s.carriage.GetAbsOrigin(),
    breech:breechPosition(k,s),muzzle:s.barrel.GetAbsOrigin(),angles:s.barrel.GetAbsAngles(),shot:s.lastShot}]));
  // RCON truncates individual engine messages at 2047 bytes. Four decimals
  // retains sub-unit precision for the independent mesh and recoil checks.
  Instance.Msg('[AC178_MOUNTS] '+JSON.stringify({time:now(),origin:refs.root.GetAbsOrigin(),angles:refs.root.GetAbsAngles(),entries},
    (_,v)=>typeof v==='number'?Math.round(v*10000)/10000:v));
});
