    if(time+1e-8<this.ready[kind]||time<this.switchAt)return {ok:false,reason:'cooldown'};
    if(w.damageMode!=='mech_volume'&&this.shots.size>=SETTINGS.maxProjectiles)return {ok:false,reason:'projectile_limit'};
    if(!finiteVec(muzzle)||!finiteVec(origin))return {ok:false,reason:'invalid_origin'};
    let dir;try{dir=normalize(direction);}catch{return {ok:false,reason:'invalid_aim'};}
    const barrel=this.world.trace(origin,muzzle,actor,{phase:'barrel',kind,muzzle,origin});
    if(barrel.startedInSolid||barrel.didHit)return {ok:false,reason:'blocked_muzzle'};
    const shot={id:`${this.epoch}:${++this.serial}`,kind,actor,position:{...muzzle},muzzle:{...muzzle},direction:dir,time,travel:0,closed:false};
