const TANK_CREW_NAMES=new Set(['lms_tank_crew147_driver','lms_tank_crew147_gunner']);
// Identity belongs to the weapon entity, never a slot, nickname or past holder.
const knownCTItemWeapons=new Map();
const ctItemsById=new Map(CT_ITEMS.map(item=>[item.id,item]));
const ctItemsByWeaponClass=new Map();
for(const item of CT_ITEMS){
  if(!ctItemsByWeaponClass.has(item.weaponClass))ctItemsByWeaponClass.set(item.weaponClass,[]);
  ctItemsByWeaponClass.get(item.weaponClass).push(item);
}
function ctItemNameMatches(entity,base){
  if(!valid(entity))return false;
  const name=entity.GetEntityName();
  return name===base||name.startsWith(base+'&');
}
function rememberCTItemWeapon(weapon,item){
  if(!valid(weapon)||weapon.GetClassName()!==item.weaponClass)return;
  if(!knownCTItemWeapons.has(weapon))knownCTItemWeapons.set(weapon,new Set());
  knownCTItemWeapons.get(weapon).add(item.id);
}
function trackPickedUpCTItem({weapon}){
  if(!valid(weapon))return;
  const items=ctItemsByWeaponClass.get(weapon.GetClassName());
  if(!items)return;
  // Observe only the picked-up weapon. Map templates can add a name suffix,
  // and a pickup can clear the weapon name while leaving its child intact.
  for(const item of items){
    if(ctItemNameMatches(weapon,item.weapon))rememberCTItemWeapon(weapon,item);
    else for(const marker of item.anchors)
      for(const anchor of Instance.FindEntitiesByName(marker.name+'*'))
        if(ctItemNameMatches(anchor,marker.name)&&anchor.GetClassName()===marker.className&&anchor.GetParent()===weapon)
          rememberCTItemWeapon(weapon,item);
  }
}
function scanGunnerExclusions(){
  for(const item of CT_ITEMS){
    for(const weapon of Instance.FindEntitiesByName(item.weapon+'*'))
      if(ctItemNameMatches(weapon,item.weapon))rememberCTItemWeapon(weapon,item);
    // Pickup may clear the weapon targetname. Parented controls/models retain
    // their item identity, including templates spawned after map activation.
    for(const marker of item.anchors)
      for(const anchor of Instance.FindEntitiesByName(marker.name+'*'))
        if(ctItemNameMatches(anchor,marker.name)&&anchor.GetClassName()===marker.className)
          rememberCTItemWeapon(anchor.GetParent(),item);
  }
  const blocked=new Map();
  for(const [weapon,ids] of knownCTItemWeapons){
    if(!valid(weapon)){knownCTItemWeapons.delete(weapon);continue;}
    const owner=weapon.GetOwner();if(!operator(owner))continue;
    for(const id of ids){
      const item=ctItemsById.get(id);
      if(item.allowed)continue;
      if(!blocked.has(owner))blocked.set(owner,[]);
      blocked.get(owner).push('item:'+id);
    }
  }
  return blocked;
}
function gunnerExclusionReason(pawn,blocked){
  if(!operator(pawn))return 'not_living_ct';
  if(TANK_CREW_NAMES.has(pawn.GetEntityName()))return 'tank_crew';
  return blocked.get(pawn)?.[0]??null;
}
function mayAcquireGunner(pawn){return !gunnerExclusionReason(pawn,scanGunnerExclusions());}
Instance.OnWeaponPickup(trackPickedUpCTItem);
Console.RegisterCheatCommand('ac183_candidate_status',()=>{
  const blocked=scanGunnerExclusions();
  for(const controller of Instance.GetAllPlayerControllers()){
    if(!valid(controller)||!controller.IsConnected()||!operator(controller.GetPlayerPawn()))continue;
    const pawn=controller.GetPlayerPawn();
    Instance.Msg('[AC183_CANDIDATE] '+JSON.stringify({slot:controller.GetPlayerSlot(),
      bot:controller.IsBot(),exclusion:gunnerExclusionReason(pawn,blocked),items:blocked.get(pawn)??[]}));
  }
});
// Own only the changes made for this operator; never recreate an artifact weapon.
const protectedGunnerBodies=new Map();
let lastBodyExit=null;
const bodyZero=()=>({x:0,y:0,z:0});
function sameGunnerBody(s){
  return valid(s.p)&&valid(s.controller)&&s.controller.IsConnected()&&
    s.controller.GetPlayerPawn()===s.p&&s.p.GetPlayerController()===s.controller;
}
function bodyHull(){return {mins:{x:-16,y:-16,z:0},maxs:{x:16,y:16,z:72}};}
function clearBodyPoint(p,position){
  const hit=Instance.TraceBox({...bodyHull(),start:position,end:position,ignoreEntity:p});
  return hit.startedInSolid===false&&hit.didHit===false;
}
function coreReturnPoint(p){
  const marker=unique('AC184_CoreReturn');if(!valid(marker))return null;
  const q=marker.GetAbsOrigin();
  const hit=Instance.TraceBox({...bodyHull(),start:{...q,z:q.z+64},end:{...q,z:q.z-256},
    ignoreEntity:p,ignorePlayers:true});
  if(hit.startedInSolid||!hit.didHit||!hit.end||!(hit.normal?.z>=.7))return null;
  // Preserve the core's exact horizontal centre, even when the lowest slot is occupied.
  for(const height of [2,76,150]){
    const candidate={x:q.x,y:q.y,z:hit.end.z+height};
    if(clearBodyPoint(p,candidate))return candidate;
  }
  return null;
}
function ownedGunnerWeapons(s){
  const weapons=new Set(gunSlots.map(slot=>s.p.FindWeaponBySlot(slot.gear)).filter(valid));
  for(const weapon of knownCTItemWeapons.keys())if(valid(weapon)&&weapon.GetOwner()===s.p)weapons.add(weapon);
  return weapons;
}
function hideBodyEntity(s,entity){
  if(!valid(entity)||typeof entity.GetColor!=='function'||typeof entity.SetColor!=='function')return;
  const color=entity.GetColor();
  if(!s.body.colors.has(entity))s.body.colors.set(entity,color.a);
  if(color.a!==0)entity.SetColor({...color,a:0});
}
function hideGunnerInventory(s){
  const weapons=ownedGunnerWeapons(s);hideBodyEntity(s,s.p);
  for(const weapon of weapons)hideBodyEntity(s,weapon);
  // Hide attached visible artifact parts; do not delete, detach or disable their controls.
  for(const cls of ['prop_dynamic','prop_dynamic_override','func_button','func_physbox'])
    for(const entity of Instance.FindEntitiesByClass(cls)){
      if(!valid(entity))continue;
      let parent=entity.GetParent();const seen=new Set();
      for(let depth=0;valid(parent)&&depth<8&&!seen.has(parent);depth++){
        if(weapons.has(parent)||parent===s.p){hideBodyEntity(s,entity);break;}
        seen.add(parent);parent=parent.GetParent();
      }
    }
}
function isolateGunnerBody(s){
  const hold=unique('AC184_Hold'),returnPoint=coreReturnPoint(s.p);
  if(!valid(hold)||!returnPoint||s.p.GetParent()||s.p.GetMoveType()!==CSMoveType.WALK)
    throw Error('operator room/core return unavailable or player already mounted');
  const holdPoint={...hold.GetAbsOrigin()};
  if(!clearBodyPoint(s.p,holdPoint))throw Error('operator room is obstructed');
  s.body={entry:{...s.p.GetAbsOrigin()},move:s.p.GetMoveType(),holdPoint,returnPoint,
    colors:new Map(),nextPin:0,returnBlockedLogged:false};
  protectedGunnerBodies.set(s.p,s);
  s.p.SetMoveType(CSMoveType.NONE);
  s.p.Teleport({position:holdPoint,velocity:bodyZero()});
  hideGunnerInventory(s);
}
function maintainGunnerBody(s,t){
  if(!s.body||!sameGunnerBody(s)||!alive(s.p))return;
  const p=s.p.GetAbsOrigin(),h=s.body.holdPoint;
  if(t>=s.body.nextPin||Math.hypot(p.x-h.x,p.y-h.y,p.z-h.z)>8||s.p.GetMoveType()!==CSMoveType.NONE){
    s.p.SetMoveType(CSMoveType.NONE);s.p.Teleport({position:h,velocity:bodyZero()});
    hideGunnerInventory(s);s.body.nextPin=t+.1;
  }
}
function planBodyReturn(s,reason){
  if(!s.body||!sameGunnerBody(s)||!alive(s.p))return {position:null};
  if(reason==='entry_failed')return {position:s.body.entry};
  const point=coreReturnPoint(s.p);
  if(point)return {position:point};
  if(reason==='fuel_empty'){
    if(!s.body.returnBlockedLogged){
      Instance.Msg('[AC184] Core return obstructed; keep operator protected and retry.');s.body.returnBlockedLogged=true;
    }
    return null;
  }
  // A core-break victim must return before immediate death. The last checked
  // core point is retained even if the marker/geometry was removed by that event.
  return {position:reason==='core_destroyed'?s.body.returnPoint:s.body.entry};
}
function returnGunnerBody(s,plan,reason){
  if(!s.body)return;
  if(plan.position&&sameGunnerBody(s)&&alive(s.p))s.p.Teleport({position:plan.position,velocity:bodyZero()});
  if(valid(s.p))s.p.SetMoveType(s.body.move);
  for(const [entity,alpha] of s.body.colors)if(valid(entity)){
    const color=entity.GetColor();if(color.a===0)entity.SetColor({...color,a:alpha});
  }
  protectedGunnerBodies.delete(s.p);
  lastBodyExit={reason,returned:!!plan.position,position:valid(s.p)?s.p.GetAbsOrigin():null,
    protected:false,originalWeaponRetained:valid(s.original)&&s.original.GetOwner()===s.p};
}
function protectsGunnerDamage(player){
  const s=protectedGunnerBodies.get(player);return !!s&&sameGunnerBody(s)&&alive(player);
}
Console.RegisterCheatCommand('ac184_body_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC184_BODY] '+JSON.stringify({protectedCount:protectedGunnerBodies.size,
    current:seat?.body&&{position:seat.p.GetAbsOrigin(),hold:seat.body.holdPoint,core:seat.body.returnPoint,
      protected:protectsGunnerDamage(seat.p),move:seat.p.GetMoveType(),alpha:seat.p.GetColor().a,
      originalWeaponRetained:valid(seat.original)&&seat.original.GetOwner()===seat.p,
      originalAlpha:valid(seat.original)?seat.original.GetColor().a:null},last:lastBodyExit}));
});
// Destructive probes are restricted to the occupied bot seat in the independent lab.
Console.RegisterCheatCommand('ac184_body_probe',args=>{
  if(!valid(unique('AC176_Lab'))||!seat?.body||!protectsGunnerDamage(seat.p)||
    Instance.GetAllPlayerControllers().some(c=>c.IsConnected()&&!c.IsBot()))return;
  if(args.trim()==='damage'){
    const before=seat.p.GetHealth();
    seat.p.TakeDamage({damage:1000000,damageTypes:CSDamageTypes.BLAST,inflictor:refs.manager});
    Instance.Msg('[AC184_PROBE] '+JSON.stringify({probe:'damage',before,after:seat?.p.GetHealth()}));
  }
  if(args.trim()==='displace'){
    seat.p.SetMoveType(CSMoveType.WALK);
    seat.p.Teleport({position:{x:200,y:200,z:40},velocity:bodyZero()});
    Instance.Msg('[AC184_PROBE] '+JSON.stringify({probe:'displace',position:seat.p.GetAbsOrigin()}));
  }
});
// Pure, world-space crash motion. These are visual adaptation values, not
// aircraft specifications or recovered Stage 4 physics settings.
const CRASH_MOTION192 = Object.freeze({
  gravity:800, stepSeconds:1/32, stepDistance:48, maxFallSeconds:8,
  maxStepsPerTick:128, fadeAfterImpact:4, removeAfterImpact:5, abortFadeSeconds:.5
});
const crashVector192=v=>!!v&&['x','y','z'].every(k=>Number.isFinite(v[k]));
const crashCopy192=v=>({x:v.x,y:v.y,z:v.z});
const crashMix192=(a,b,f)=>({x:a.x+(b.x-a.x)*f,y:a.y+(b.y-a.y)*f,z:a.z+(b.z-a.z)*f});

/** Gravity adds downward velocity without deleting inherited horizontal
 * momentum. Orientation stays at the captured heading, as in the original
 * rigid C130 crash: no pitch-up tail collision with the low sky ceiling.
 * sweep(start,end) must return {didHit,startedInSolid,fraction,point,normal}.
 * TraceBox.end is a hull origin, NOT a surface point; the adapter handles it.
 * Every segment is swept, including during a frame hitch. No landing at Z=0.
 */
class GroundCrashMotion192 {
  constructor(snapshot,sweep,options={}){
    if(!crashVector192(snapshot?.origin)||!crashVector192(snapshot?.velocity)||typeof sweep!=='function')
      throw Error('Invalid crash snapshot or sweep');
    this.config={...CRASH_MOTION192,...options};
    for(const key of Object.keys(CRASH_MOTION192))if(!Number.isFinite(this.config[key])||this.config[key]<=0)
      throw Error('Invalid crash option '+key);
    if(this.config.removeAfterImpact<=this.config.fadeAfterImpact)throw Error('Invalid impact fade');
    this.origin=crashCopy192(snapshot.origin);this.velocity=crashCopy192(snapshot.velocity);
    this.sweep=sweep;this.position=crashCopy192(this.origin);this.phase='falling';
    this.simulated=0;this.clock=0;this.impact=null;this.impactClock=null;this.abortClock=null;
    this.reason=null;this.sweeps=0;this.catchingUp=false;
  }
  at(t){return {x:this.origin.x+this.velocity.x*t,y:this.origin.y+this.velocity.y*t,
    z:this.origin.z+this.velocity.z*t-.5*this.config.gravity*t*t};}
  abort(reason,t){this.phase='aborted';this.reason=reason;this.abortClock=t;}
  update(elapsed){
    if(!Number.isFinite(elapsed)||elapsed<this.clock)throw Error('Crash clock moved backwards');
    this.clock=elapsed;
    if(this.phase==='falling'){
      const target=Math.min(elapsed,this.config.maxFallSeconds);let budget=this.config.maxStepsPerTick;
      // A zero-length launch sweep detects an already obstructed placement.
      if(!this.sweeps){
        let initial;try{initial=this.sweep(this.position,this.position);this.sweeps++;}catch(e){this.abort('trace_error: '+e,elapsed);}
        if(this.phase==='falling'&&(!initial||typeof initial.startedInSolid!=='boolean'||typeof initial.didHit!=='boolean'))this.abort('invalid_trace',elapsed);
        else if(this.phase==='falling'&&initial.startedInSolid)this.abort('started_in_solid',elapsed);
      }
      while(this.phase==='falling'&&this.simulated<target-1e-9&&budget-->0){
        const speed=Math.hypot(this.velocity.x,this.velocity.y,this.velocity.z-this.config.gravity*this.simulated);
        const dt=Math.min(this.config.stepSeconds,this.config.stepDistance/(speed+this.config.gravity*this.config.stepSeconds),target-this.simulated);
        const next=this.at(this.simulated+dt);let hit;
        try{hit=this.sweep(this.position,next);this.sweeps++;}catch(e){this.abort('trace_error: '+e,elapsed);break;}
        if(!hit||typeof hit.startedInSolid!=='boolean'||typeof hit.didHit!=='boolean'){this.abort('invalid_trace',elapsed);break;}
        if(hit.startedInSolid){this.abort('started_in_solid',elapsed);break;}
        if(hit.didHit){
          if(!Number.isFinite(hit.fraction)||hit.fraction<0||hit.fraction>1||!crashVector192(hit.point)||!crashVector192(hit.normal)){
            this.abort('invalid_contact',elapsed);break;
          }
          this.position=crashMix192(this.position,next,hit.fraction);this.simulated+=dt*hit.fraction;
          this.impact={point:crashCopy192(hit.point),normal:crashCopy192(hit.normal),hull:hit.hull??null,
            flightSeconds:this.simulated,position:crashCopy192(this.position)};
          // Start visual timings when contact is presented, not in skipped time.
          this.impactClock=elapsed;this.phase='impacted';break;
        }
        this.position=next;this.simulated+=dt;
      }
      this.catchingUp=this.phase==='falling'&&this.simulated<target-1e-9;
      if(this.phase==='falling'&&!this.catchingUp&&this.simulated>=this.config.maxFallSeconds-1e-9)
        this.abort('no_surface_within_fall_limit',elapsed);
    }
    const impactAge=this.impactClock===null?null:Math.max(0,elapsed-this.impactClock);
    let alpha=255;
    if(this.phase==='impacted'){
      alpha=Math.round(255*Math.min(1,Math.max(0,(this.config.removeAfterImpact-impactAge)/(this.config.removeAfterImpact-this.config.fadeAfterImpact))));
      if(impactAge>=this.config.removeAfterImpact)this.phase='complete';
    }else if(this.phase==='aborted'){
      alpha=Math.round(255*Math.max(0,1-(elapsed-this.abortClock)/this.config.abortFadeSeconds));
      if(!alpha)this.phase='complete';
    }
    return {phase:this.phase,position:crashCopy192(this.position),alpha,complete:this.phase==='complete',
      impact:this.impact,impactAge,reason:this.reason,simulated:this.simulated,sweeps:this.sweeps,catchingUp:this.catchingUp};
  }
}
