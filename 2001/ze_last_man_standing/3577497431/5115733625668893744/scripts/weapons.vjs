});

// Freeze this choice at the core's qualifying second-break event, before item
// exclusions. A later death/join must not alter an admitted sortie's clock.
function deploymentProfile206(livingCT){
  if(!Number.isInteger(livingCT)||livingCT<12)return null;
  return Object.freeze(livingCT<20?
    {mode:'full_circle',durationSeconds:60,sweepRadians:2*Math.PI}:
    {mode:'half_circle',durationSeconds:30,sweepRadians:Math.PI});
}

const FLIGHT_ROUTES = Object.freeze([
  Object.freeze({id:1,name:'blue',startRadians:Math.PI}), // west -> south -> east
  Object.freeze({id:2,name:'green',startRadians:0})        // east -> north -> west
]);

function finite(value,label){
  if(typeof value!=='number'||!Number.isFinite(value))throw new TypeError(label+' must be finite');
  return value;
}
function positive(value,label){
  finite(value,label);
  if(value<=0)throw new RangeError(label+' must be positive');
  return value;
}
function flightProfile(overrides={}){
  const center={...DEFAULT_FLIGHT_PROFILE.center,...overrides.center};
  const p={...DEFAULT_FLIGHT_PROFILE,...overrides,center};
  finite(center.x,'center.x');finite(center.y,'center.y');finite(p.altitude,'altitude');
  positive(p.radius,'radius');positive(p.durationSeconds,'durationSeconds');
  positive(p.sweepRadians,'sweepRadians');
  if(p.sweepRadians>2*Math.PI)throw new RangeError('sweepRadians exceeds one circle');
  return Object.freeze({...p,center:Object.freeze(center)});
}

/** Stateless analytic arc. Negative/overrun elapsed time clamps to endpoints.
 *  No banking: the root altitude is constant. All dimensions use Source units.
 */
function calculateRoutePose(routeId,elapsedSeconds,overrides={}){
  const route=FLIGHT_ROUTES.find(r=>r.id===routeId);
  if(!route)throw new RangeError('routeId must be 1 or 2');
  finite(elapsedSeconds,'elapsedSeconds');
  const p=flightProfile(overrides);
  const elapsed=Math.max(0,Math.min(p.durationSeconds,elapsedSeconds));
  const progress=elapsed/p.durationSeconds,theta=route.startRadians+p.sweepRadians*progress;
  // Exact cardinal endpoints avoid accumulated drift and tiny sin(pi) residues.
  const exactEnd=progress===1&&(p.sweepRadians===Math.PI||p.sweepRadians===2*Math.PI);
  const startCos=routeId===1?-1:1;
  const cos=progress===0?startCos:exactEnd?startCos*(p.sweepRadians===Math.PI?-1:1):Math.cos(theta);
  const sin=progress===0||exactEnd?0:Math.sin(theta);
  const yaw=((theta*180/Math.PI+90)%360+360)%360;
  return Object.freeze({
    routeId,routeName:route.name,progress,elapsedSeconds:elapsed,
    durationSeconds:p.durationSeconds,sweepRadians:p.sweepRadians,
    remainingSeconds:p.durationSeconds-elapsed,fuelFraction:1-progress,
    position:Object.freeze({x:p.center.x+p.radius*cos,y:p.center.y+p.radius*sin,z:p.altitude}),
    angles:Object.freeze({pitch:0,yaw,roll:0})
  });
}

/** One sortie per reset. This class never calls an engine API.
 *
 * prepare(): draw once and park at the start for the entire cinematic.
 * startActive(now): begin the route and fuel deadline using one shared timestamp.
 * sample(now): apply the pose only when writePose is true. At natural completion
 *   the exact endpoint is emitted once; then finished=true and writePose=false.
 * stop(now, reason): freeze the analytic pose immediately and return writePose=false.
 *   The caller must stop its root writer before handing transforms to a wreck effect.
 * reset(): release the draw, clock, stop state and endpoint latch for a new round.
 *
 * Player death/disconnect need not stop an already active sortie: keep sampling
 * this controller independently of the occupant. Engine teardown/reload should
 * stop it explicitly; never restart a sortie implicitly or replenish fuel.
 */
class FlightRouteController{
  constructor(overrides={},random=Math.random){
    if(typeof random!=='function')throw new TypeError('random must be a function');
    this.profile=flightProfile(overrides);this.random=random;this.reset();
  }
  reset(){
    this.phase='idle';this.routeId=null;this.startAt=null;this.fuelEnd=null;
    this.stopReason=null;this._lastTime=null;this._pose=null;
    return this.snapshot();
  }
  snapshot(writePose=false){
    return Object.freeze({
      ...this._pose,routeId:this.routeId,phase:this.phase,startAt:this.startAt,fuelEnd:this.fuelEnd,
      stopReason:this.stopReason,writePose,
      finished:this.phase==='finished',stopped:this.phase==='stopped'
    });
  }
  prepare(){
    if(this.phase!=='idle')return this.snapshot(this.phase==='intro');
    const draw=this.random();
    if(!Number.isFinite(draw)||draw<0||draw>=1)throw new RangeError('random must return a number in [0,1)');
    this.routeId=draw<.5?1:2;this.phase='intro';
    this._pose=calculateRoutePose(this.routeId,0,this.profile);
    return this.snapshot(true);
  }
  startActive(now){
    finite(now,'now');
    if(this.phase==='idle')throw new Error('prepare() must precede startActive()');
    if(this.phase!=='intro')return false;
    if(this._lastTime!==null&&now<this._lastTime)throw new RangeError('clock moved backwards; reset before a new timeline');
    const deadline=now+this.profile.durationSeconds;
    if(!Number.isFinite(deadline)||deadline<=now)throw new RangeError('timestamp cannot represent the flight duration');
    this.startAt=now;this.fuelEnd=deadline;this._lastTime=now;this.phase='active';
    return true;
  }
  _checkClock(now){
    finite(now,'now');
    if(this._lastTime!==null&&now<this._lastTime)throw new RangeError('clock moved backwards; reset before a new timeline');
  }
  sample(now){
    this._checkClock(now);
    if(this.phase==='idle'||this.phase==='finished'||this.phase==='stopped')return this.snapshot(false);
    this._lastTime=now;
    if(this.phase==='intro')return this.snapshot(true);
    this._pose=calculateRoutePose(this.routeId,now-this.startAt,this.profile);
    if(now>=this.fuelEnd)this.phase='finished';
    return this.snapshot(true);
  }
  stop(now,reason='core_destroyed'){
    this._checkClock(now);
    if(typeof reason!=='string'||!reason.trim())throw new TypeError('stop reason must be a nonempty string');
    if(this.phase==='idle'||this.phase==='finished'||this.phase==='stopped')return this.snapshot(false);
    if(this.phase==='active')this._pose=calculateRoutePose(this.routeId,now-this.startAt,this.profile);
    this._lastTime=now;this.phase='stopped';this.stopReason=reason;
    return this.snapshot(false);
  }
}
// Optional native adapter. Only an authored AC192_RouteEnabled marker enables
// the Stage 5 world coordinates; the old standalone lab remains stationary.
let flight192=null,flightRoot192=null,flightWritten192=null;
function rememberFlightPose192(frame){
  flightWritten192={position:{...frame.position},angles:{...frame.angles}};
}
function ownsFlightPose192(origin,angles){
  if(!flightWritten192)return false;
  const p=flightWritten192.position,a=flightWritten192.angles;
  return ['x','y','z'].every(k=>Number.isFinite(origin[k])&&Math.abs(origin[k]-p[k])<=.001)&&
    ['pitch','yaw','roll'].every(k=>Number.isFinite(angles[k])&&Math.abs(((angles[k]-a[k]+180)%360+360)%360-180)<=.001);
}
function resetFlight192(){
  stopEngineSmoke188();
  flight192=null;flightRoot192=null;flightWritten192=null;resetWreckMotion192();
}
function prepareFlight192(profile={}){
  if(!valid(unique('AC192_RouteEnabled')))return false;
  if(!valid(refs.root))throw Error('route root unavailable');
  if(flight192){
    if(flightRoot192!==refs.root||flight192.phase!=='intro')throw Error('route already active or stopped; reset required');
    return true;
  }
  flight192=new FlightRouteController(profile);flightRoot192=refs.root;
  const frame=flight192.prepare();
  refs.root.Teleport({position:frame.position,angles:frame.angles,velocity:{x:0,y:0,z:0}});
  rememberFlightPose192(frame);
  // The entry placement is a teleport, never physical momentum.
  resetWreckMotion192();
  return true;
}
function startFlight192(t){
  if(!flight192)return null;
  if(flightRoot192!==refs.root||!valid(refs.root))throw Error('route root changed before handoff');
  if(!flight192.startActive(t)&&flight192.phase!=='active')throw Error('route cannot resume after stopping');
  return flight192.fuelEnd;
}
function tickFlight192(t){
  if(!flight192||!canUseAircraft()||!active||roundRestarting)return;
  if(flightRoot192!==refs.root||!valid(refs.root)||!valid(unique('AC192_RouteEnabled'))){
    stopFlight192(t,'route_entity_lost');return;
  }
  const frame=flight192.sample(t);
  if(frame.writePose){
    refs.root.Teleport({position:frame.position,angles:frame.angles});
    moveEngineSmoke188(frame.position,frame.angles);
    rememberFlightPose192(frame);
  }
  // gunnerTick owns departure, after this exact endpoint and the gun mounts
  // have been updated. It uses the same deadline returned by startFlight192.
}
function stopFlight192(t,reason){
  stopEngineSmoke188();
  if(!flight192)return;
  try{flight192.stop(t,reason);}catch(error){
    // A clock reset must not leave a transform writer alive during teardown.
    flight192=null;flightRoot192=null;flightWritten192=null;
    Instance.Msg('[AC192_FLIGHT] route stop: '+error);
  }
}
function stopFlightForWreck192(t){
  let motion;
  try{
    if(flight192?.phase==='active'&&flightRoot192===refs.root&&valid(refs.root)&&
        t>=flight192.startAt&&t<flight192.fuelEnd){
      const origin={...refs.root.GetAbsOrigin()},angles={...refs.root.GetAbsAngles()};
      if(ownsFlightPose192(origin,angles)){
        // A core input can arrive between route ticks. Use the actual last
        // written pose, rather than advancing its direction into virtual time.
        const p=flight192.profile,omega=p.sweepRadians/p.durationSeconds;
        const dx=origin.x-p.center.x,dy=origin.y-p.center.y;
        motion={origin,angles,velocity:{x:-omega*dy,y:omega*dx,z:0},velocitySource:'route_analytic'};
      }else{
        // An external teleport or turn revoked this writer's pose ownership.
        // Discard old sampled route velocity before reading current engine motion.
        resetWreckMotion192();motion=captureWreckMotion192(t);
      }
    }else motion=captureWreckMotion192(t);
  }finally{stopFlight192(t,'core_destroyed');}
  return motion;
}
// Upstream CS2Fixes KeyValues "runspeed" writes m_flVelocityModifier.
// Keep the separate ZE "speed" multiplier untouched.
const gunSlows=new Map();
const slowRules={...WEAPONS,
  tank:{slowMultiplier:0.7,slowSeconds:4},
  mechFlame:{slowMultiplier:0.7,slowSeconds:2},
  tankDefense:{slowMultiplier:0.7,slowSeconds:2}};
const gunSlowKinds=Object.keys(slowRules).sort((a,b)=>slowRules[a].slowMultiplier-slowRules[b].slowMultiplier);
const gunSlowInputs=new Map(gunSlowKinds.map(kind=>[kind,'runspeed '+slowRules[kind].slowMultiplier]));
let batchingGunSlows=false;
function applyGunSlow(p,kind,t){
  let state=gunSlows.get(p);
  if(!state){state={ends:{},kind:null,next:0};gunSlows.set(p,state);}
  if(kind==='tank')state.tankTeam=p.GetTeamNumber();
  if(kind==='tankDefense')state.defenseTeam=p.GetTeamNumber();
  state.ends[kind]=Math.max(state.ends[kind]??0,t+slowRules[kind].slowSeconds);
  if(!batchingGunSlows)updateGunSlow(p,state,t);
}
function updateGunSlow(p,state,t){
  const aircraftTarget=enemy(p);
  const tankTarget=state.tankTeam!==undefined&&alive(p)&&p.GetTeamNumber()===state.tankTeam;
  let strongest=null;
  for(const kind of gunSlowKinds){
    if(t>=state.ends[kind]||state.ends[kind]===undefined)continue;
    if(kind==='tankDefense'){
      if(alive(p)&&p.GetTeamNumber()===state.defenseTeam){strongest=kind;break;}
    }else if(kind==='tank'?tankTarget:aircraftTarget){strongest=kind;break;}
  }
  if(strongest===null){releaseGunSlow(p);return;}
  if(strongest!==state.kind||t>=state.next){
    send(p,'KeyValues',gunSlowInputs.get(strongest),p);
    state.kind=strongest;state.next=t+1/64;
  }
}
function releaseGunSlow(p){
  if(gunSlows.delete(p)&&valid(p))send(p,'KeyValues','runspeed 1',p);
}
function maintainGunSlows(t){for(const [p,s] of gunSlows)updateGunSlow(p,s,t);}
function clearGunSlows(){for(const p of gunSlows.keys())releaseGunSlow(p);}
// One award per connection per rotation, across rounds of this map session.
class GunnerRotation {
  constructor(saved){
    this.cycle=Number.isInteger(saved?.cycle)&&saved.cycle>0?saved.cycle:1;
    this.used=new Set(Array.isArray(saved?.used)?saved.used:[]);
  }
  choose(candidates,random=Math.random){
    if(!candidates.length)return {ok:false,reason:'no_living_ct'};
    // A candidate must still belong to a known connection at the time of the draw.
    if(candidates.some(c=>!c.id))return {ok:false,reason:'connection_unavailable'};
    const unique=[...new Map(candidates.map(c=>[c.id,c])).values()];
    let eligible=unique.filter(c=>!this.used.has(c.id));
    const reset=eligible.length===0;
    if(reset)eligible=unique;
    const value=random();
    if(!Number.isFinite(value)||value<0||value>=1)throw Error('invalid random draw');
    return {ok:true,candidate:eligible[Math.floor(value*eligible.length)],reset,cycle:this.cycle};
  }
  commit(draw){
    if(!draw?.ok||draw.cycle!==this.cycle||(!draw.reset&&this.used.has(draw.candidate.id)))return false;
    if(draw.reset){this.used.clear();this.cycle++;}
    this.used.add(draw.candidate.id);return true;
  }
  snapshot(){return {cycle:this.cycle,used:[...this.used]};}
}

