function introStationPitch(k, elapsed) {
  const raw=(elapsed-FLYBY_TRANSITION195.holdSeconds)*FLYBY188.fps-FLYBY188.preFrames;
  const aft=k==='105', samples=aft?flybyAftPitch:flybyForwardPitch;
  const last=samples.length-1;
  const f=Math.max(0,Math.min(last,raw)), i=Math.min(Math.floor(f),last-1);
  const delta=samples[i]+(samples[i+1]-samples[i])*(f-i);
  const tail=Math.max(0,Math.min(1,1-(raw-last)/FLYBY188.postFrames));
  const gain=aft?1:k==='40'?.7:.45;
  return stationRestPitch+delta*gain*tail;
}
function portStationDirection(pitch) {
  const p=rad(pitch);
  return {x:0,y:Math.cos(p),z:-Math.sin(p)};
}

function bindStations(){
  for(const k of Object.keys(WEAPONS)){
    const s={carriage:unique('AC178_Carriage'+k),barrel:refs.muzzles[k],
      localDir:portStationDirection(stationRestPitch),lastFire:-Infinity,lastShot:null};
    if(!valid(s.carriage)||!valid(s.barrel))return false;
    stations[k]=s;
  }
  return true;
}
function positionStation(k,t,aim=null,introElapsed=null){
  const s=stations[k],g=MOUNTS[k];
  if(!s||![refs.root,s.carriage,s.barrel,refs.muzzles[k]].every(valid))return;
  const b=axes(refs.root.GetAbsAngles());
  const offset=rotate({x:g.pivot[0],y:g.pivot[1],z:g.pivot[2]},b);
  const pivot=add(refs.root.GetAbsOrigin(),offset,1);
  if(aim){
    const v=sub(aim,pivot);
    if(dot(v,b[1])<=0 || Math.hypot(v.x,v.y,v.z)<=g.length)return;
    const d=normalize(v);
    s.localDir={x:dot(d,b[0]),y:dot(d,b[1]),z:dot(d,b[2])};
  }
  const localDir=!aim&&introElapsed!==null?portStationDirection(introStationPitch(k,introElapsed)):s.localDir;
  const dir=rotate(localDir,b),a=orient(dir,b[2]);
  const [stroke,duration]=recoilProfiles[k];
  // The shot starts at the pre-kick tip. Only the sliding barrel recoils.
  const elapsed=t-s.lastFire;
  const kick=elapsed>=0 && elapsed<duration ? stroke*(1-elapsed/duration)**2 : 0;
  const breech=add(pivot,dir,-kick),muzzle=add(breech,dir,g.length);
  s.carriage.Teleport({position:pivot,angles:a});
  s.barrel.Teleport({position:muzzle,angles:a});
  return {pivot,muzzle,dir,kick};
}
function breechPosition(k,s){
  return add(s.barrel.GetAbsOrigin(),forward(s.barrel.GetAbsAngles()),-MOUNTS[k].length);
}
