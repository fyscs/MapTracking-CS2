// Original official CS2Fixes viewcontrol (freeze + FOV, never Disarm).
// Existing vehicle cameras are restored by their original proxy, without reboarding.
let cinema188=null,lastCinema188={phase:'idle'},coreClock188=0,coreClockAt188=null;
const coreDue188=[];
let introSoundGuid188=null,coreValue188=null;
const cinemaLinks188=[];
const ENGINE_SMOKE_OFFSETS188=[[7.77,-3.39,5.98],[14.89,-3.97,3.92],
  [-7.77,-3.39,5.98],[-14.89,-3.97,3.92]].map(([y,z,x])=>({
    x:x*FLYBY188.scale+FLYBY188.offset[0],y:y*FLYBY188.scale,z:z*FLYBY188.scale+FLYBY188.offset[2]
  }));
let engineSmoke188=[];
function stopEngineSmoke188(){
  const emitters=engineSmoke188;
  engineSmoke188=[];
  for(const entity of emitters){
    try{send(entity,'StopPlayEndCap');}
    catch(error){Instance.Msg('[AC188] engine smoke stop failed: '+error);}
  }
}
function moveEngineSmoke188(origin,angles){
  if(!engineSmoke188.length)return;
  const basis=axes(angles);
  try{
    for(const [index,entity] of engineSmoke188.entries())if(valid(entity))
      entity.Teleport({position:add(origin,rotate(ENGINE_SMOKE_OFFSETS188[index],basis),1),angles});
  }catch(error){
    stopEngineSmoke188();
    Instance.Msg('[AC188] engine smoke movement failed: '+error);
  }
}
function bindCinema188(){
  for(const link of cinemaLinks188)Entities.DisconnectOutput(link);cinemaLinks188.length=0;
  for(const [target,output,callback] of [
    [unique('AC188_Engine'),'SoundEventGuid',({value})=>{introSoundGuid188=value;}],
    [unique('stage_5_core_counter'),'OutValue',({value})=>{coreValue188=Number(value);}],
    [unique('stage_5_core_counter'),'OnGetValue',({value})=>{coreValue188=Number(value);}],
    // Nuclear time keeps running by user request. If it expires during the shot,
    // release cinematic protection before the original end-of-stage kill outputs.
    [unique('stage_end_explosion_working'),'OnTrigger',()=>{if(cinema188)leaveGunner('stage_nuclear_end');}]
  ])if(valid(target)){
    const link=Entities.ConnectOutput({target,output,callback});if(link!==undefined)cinemaLinks188.push(link);
  }
}
function coreTime188(t){
  if(coreClockAt188!==null&&!cinema188)coreClock188+=Math.max(0,t-coreClockAt188);
  coreClockAt188=t;return coreClock188;
}
for(const [name,delay] of [['CoreTick188',0],['CoreDelayedTick188',.1]])
  Instance.OnScriptInput(name,({caller,activator})=>{
    if(caller!==unique('stage_5_core_counter_timer'))return;
    coreDue188.push({at:coreTime188(now())+delay,activator,caller});
  });
function tickCore188(t){
  const clock=coreTime188(t);if(cinema188)return;
  for(let i=0;i<coreDue188.length;){
    const e=coreDue188[i];if(e.at>clock){i++;continue;}
    coreDue188.splice(i,1);
    if(valid(e.caller))Instance.EntFireAtName({name:'stage_5_core_counter',input:'Subtract',value:1,caller:e.caller,activator:valid(e.activator)?e.activator:undefined});
  }
}
function resetCinemaClock188(){coreDue188.length=0;coreClock188=0;coreClockAt188=null;}
function priorView188(p){
  const name=p.GetEntityName(),vehicle=unique('LMS_SeatDisarm186_'+name);
  if(valid(vehicle))return vehicle;
  // Verified original knife pickup I/O assigns these names and cameras.
  const item=name==='human_mech'?'Human_Item_Mech':name==='zombie_boss'?'Zombie_Item_Boss':null;
  if(!item)return null;
  const knife=unique(item+'_Knife'),camera=unique(item+'_Cam');
  return valid(knife)&&knife.GetOwner()===p&&valid(camera)?camera:null;
}
function enrollCinema188(c){
  const p=c.GetPlayerPawn();if(!valid(p)||cinema188.watchers.has(p))return;
  const camera=p.GetCustomCamera();if(!valid(camera))return;
  const slot=c.GetPlayerSlot(),name=p.GetEntityName();
  // A respawn/reconnect can reuse a slot during the shot. Do not inherit our own
  // temporary capture as the new pawn's pre-existing state and leave it locked.
  for(const old of cinema188.watchers.values())if(old.slot===slot&&old.p!==p){
    if(valid(old.hud))old.hud.SetInputCaptureEnabled(slot,old.capture);
    cinema188.watchers.delete(old.p);
  }
  const proxy=priorView188(p);
  const s={p,c,slot,camera,hud:cinema188.hud,cache:new Map(),intro:{},mode:camera.GetMode(),
    cameraPose:{position:camera.GetAbsOrigin(),angles:camera.GetAbsAngles()},eye:{...p.GetEyeAngles()},
    position:p.GetAbsOrigin(),velocity:p.GetAbsVelocity(),move:p.GetMoveType(),
    capture:cinema188.hud.IsInputCaptureEnabled(slot),proxy:valid(proxy)?proxy:null,alive:p.IsAlive()};
  cinema188.watchers.set(p,s);
  s.hud.SetInputCaptureEnabled(slot,true);
  if(cinema188.nativeOnly195&&p===cinema188.owner.p)camera.SetMode(CustomCameraMode.DISABLED);
  camera.SetMode(CustomCameraMode.CONTROLLED);
  if(s.alive){p.SetMoveType(CSMoveType.NONE);p.Teleport({velocity:bodyZero()});}
  if(s.alive&&!c.IsBot()&&!cinema188.nativeOnly195)send(cinema188.control,'EnableCamera',undefined,p);
}
function beginCinema188(owner){
  if(cinema188)throw Error('global cinematic already active');
  const control=unique('AC188_IntroControl'),marker=unique('AC188_CinemaActive'),engine=unique('AC188_Engine');
  if(!valid(control)||!valid(marker)||!valid(engine))throw Error('global cinematic entities unavailable');
  if(!valid(unique('AC188_CorePauseWired')))throw Error('core timer pause wiring missing; refusing an incomplete intro');
  const nativeOnly195=typeof takeIntroCameraProbe195==='function'&&takeIntroCameraProbe195(owner);
  coreTime188(now());
  cinema188={owner,control,marker,engine,hud:owner.hud,watchers:new Map(),start:now(),timer:unique('stage_5_core_counter_timer'),nativeOnly195};
  marker.SetHealth(1);send(cinema188.timer,'PauseTimer');
  for(const c of Instance.GetAllPlayerControllers())if(c.IsConnected())enrollCinema188(c);
  engineSmoke188=ENGINE_SMOKE_OFFSETS188.map((_,i)=>{
    const entity=unique('AC188_Smoke'+i);
    if(!valid(entity))throw Error('missing engine smoke '+i);
    return entity;
  });
  moveEngineSmoke188(refs.root.GetAbsOrigin(),refs.root.GetAbsAngles());
  for(const entity of engineSmoke188)send(entity,'Start');
  engine.Teleport({position:refs.root.GetAbsOrigin()});send(engine,'StartSound');
}
function updateCinema188(f){
  if(!cinema188)return;
  if(cinema188.nativeOnly195&&!validIntroCameraProbe195(cinema188.owner)){leaveGunner('intro_camera_probe_changed');return;}
  for(const c of Instance.GetAllPlayerControllers())if(c.IsConnected())enrollCinema188(c);
  for(const s of cinema188.watchers.values()){
    if(!valid(s.p)||!valid(s.c)||!s.c.IsConnected()||s.c.GetPlayerPawn()!==s.p)continue;
    s.camera.Teleport({position:f.position,angles:f.angles});
    if(s.alive&&s.p.IsAlive()){
      s.p.SetMoveType(CSMoveType.NONE);s.p.Teleport({position:s.position,velocity:bodyZero()});
      // Official point_viewcontrol owns a prop view entity, while its GetEyeAngles
      // hook reads the pawn's v_angle. Keep that angle on the same authored shot;
      // moving the native custom camera alone does not update this second path.
      s.p.SetEyeAngles({...f.angles});
    }
    drawFlyby188(s,f.fade);
  }
}
function cinemaProtects188(event){return !!cinema188&&(cinema188.watchers.has(event.player)||cinema188.watchers.has(event.attacker));}
function releaseCinema188(reason){
  const c=cinema188;if(!c)return;
  // Stop plugin camera first; then restore the original vehicle view if present.
  if(!c.nativeOnly195)send(c.control,'DisableCameraAll');send(c.engine,'StopSound');
  // The same four emitters keep running across the successful camera handoff.
  if(reason!=='complete')stopEngineSmoke188();
  const errors=[];const attempt=f=>{try{f();}catch(e){errors.push(String(e));}};
  for(const s of c.watchers.values()){
    attempt(()=>{if(valid(s.hud)){s.hud.SetInputCaptureEnabled(s.slot,s.capture);showClass(s,'IntroShade','On',false);
      if(s.intro.shade!==undefined)showClass(s,'IntroShade','Shade'+s.intro.shade,false);}});
    if(!valid(s.p)||!valid(s.c)||!s.c.IsConnected()||s.c.GetPlayerPawn()!==s.p)continue;
    attempt(()=>{if(valid(s.camera)&&s.camera.GetMode()===CustomCameraMode.CONTROLLED){s.camera.Teleport(s.cameraPose);s.camera.SetMode(s.mode);}});
    if(s.alive&&s.p.IsAlive()){
      attempt(()=>{s.p.SetEyeAngles(s.eye);if(s.p.GetMoveType()===CSMoveType.NONE){s.p.SetMoveType(s.move);s.p.Teleport({velocity:s.velocity});}});
      if(!['stage_nuclear_end','round_end','round_restart','round_start'].includes(reason)&&valid(s.proxy)&&!s.c.IsBot())
        attempt(()=>send(s.proxy,'EnableCamera',undefined,s.p));
    }
  }
  attempt(()=>{if(valid(c.marker))c.marker.SetHealth(0);});
  const elapsed=now()-c.start;coreTime188(now());cinema188=null;
  if(typeof clearIntroCameraProbe195==='function')clearIntroCameraProbe195(reason);
  // Pausing an inactive timer never enables it; UnpauseTimer resumes its prior state.
  attempt(()=>send(c.timer,'UnpauseTimer'));
  lastCinema188={phase:'released',reason,elapsed,watchers:c.watchers.size,errors,soundGuid:introSoundGuid188};
  if(errors.length)Instance.Msg('[AC188_RESTORE_ERROR] '+JSON.stringify(errors));
}
Console.RegisterCheatCommand('ac188_cinema_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC188_CINEMA] '+JSON.stringify(cinema188?{phase:'playing',clock:coreClock188,pending:coreDue188.length,coreValue:coreValue188,soundGuid:introSoundGuid188,
    watchers:[...cinema188.watchers.values()].map(s=>({slot:s.slot,team:s.p.GetTeamNumber(),camera:s.camera.GetMode(),capture:s.hud.IsInputCaptureEnabled(s.slot),move:s.p.GetMoveType(),position:s.p.GetAbsOrigin()})),
    smoke:engineSmoke188.length,nuclearPaused:false}:{...lastCinema188,coreValue:coreValue188,clock:coreClock188,bindings:cinemaLinks188.length}));
});
Console.RegisterCheatCommand('ac188_core_lab',args=>{
  if(!valid(unique('AC176_Lab'))||Instance.GetAllPlayerControllers().some(c=>c.IsConnected()&&!c.IsBot()))return;
  const counter=unique('stage_5_core_counter'),timer=unique('stage_5_core_counter_timer');
  if(args.trim()==='start')send(timer,'Enable');
  if(args.trim()==='reset'){send(timer,'Disable');send(counter,'SetValue',200);}
  send(counter,'GetValue');
});
Console.RegisterCheatCommand('ac188_sky_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  Instance.Msg('[AC188_SKY] '+JSON.stringify({cameras:Instance.FindEntitiesByClass('sky_camera').filter(valid).map(e=>e.GetAbsOrigin()),
    normal:Instance.FindEntitiesByName('normal_sky').filter(valid).length,extreme:Instance.FindEntitiesByName('extreme_sky').filter(valid).length,
    mountains:Instance.FindEntitiesByName('stages_skybox_mountains').filter(valid).length,
    clouds:Instance.FindEntitiesByName('stages_clouds').filter(valid).length}));
});
// Exterior flyby only. Body isolation precedes it; fuel begins after handoff.
let lastFlyby188={phase:'idle'};
const FLYBY_TRANSITION195=Object.freeze({holdSeconds:.6,fadeInSeconds:.3});
const FLYBY_DURATION195=FLYBY188.duration+FLYBY_TRANSITION195.holdSeconds;
function flybyQuat188(a,b,t){
  let d=a.reduce((v,x,i)=>v+x*b[i],0),other=d<0?b.map(x=>-x):b;
  d=Math.max(-1,Math.min(1,Math.abs(d)));
  const theta=Math.acos(d),sn=Math.sin(theta);
  const u=sn>.000001?Math.sin((1-t)*theta)/sn:1-t,v=sn>.000001?Math.sin(t*theta)/sn:t;
  const q=a.map((x,i)=>x*u+other[i]*v),n=Math.hypot(...q);return q.map(x=>x/n);
}
function flybyRotate188(q,v){
  const [w,x,y,z]=q,[a,b,c]=v;
  const tx=2*(y*c-z*b),ty=2*(z*a-x*c),tz=2*(x*b-y*a);
  return [a+w*tx+y*tz-z*ty,b+w*ty+z*tx-x*tz,c+w*tz+x*ty-y*tx];
}
function flybyFrame188(elapsed){
  // Give freshly spawned aircraft entities a short full-black preparation
  // interval. Delay the original timeline rather than discarding early frames.
  const playElapsed=Math.max(0,elapsed-FLYBY_TRANSITION195.holdSeconds);
  const raw=playElapsed*FLYBY188.fps-FLYBY188.preFrames;
  const f=Math.max(0,Math.min(FLYBY188.frames.length-1,raw));
  const i=Math.min(Math.floor(f),FLYBY188.frames.length-2),mix=f-i;
  const a=FLYBY188.frames[i],b=FLYBY188.frames[i+1];
  const p=a.slice(0,3).map((v,k)=>v+(b[k]-v)*mix),q=flybyQuat188(a.slice(3),b.slice(3),mix);
  const convert=v=>({x:v[2],y:v[0],z:v[1]});
  const position=convert(p);
  for(const [i,k] of ['x','y','z'].entries())position[k]=position[k]*FLYBY188.scale+FLYBY188.offset[i];
  const entrance=Math.max(0,Math.min(1,1-playElapsed/FLYBY_TRANSITION195.fadeInSeconds));
  const exit=Math.max(0,Math.min(1,(raw-170)/FLYBY188.postFrames));
  const fade=Math.max(entrance,exit);
  return {position,q,forward:convert(flybyRotate188(q,[0,0,-1])),up:convert(flybyRotate188(q,[0,1,0])),
    sample:f,fade,playElapsed,preparing:elapsed<FLYBY_TRANSITION195.holdSeconds,complete:elapsed>=FLYBY_DURATION195};
}
function flybyPose188(elapsed){
  const f=flybyFrame188(elapsed),basis=axes(refs.root.GetAbsAngles());
  // Keep the original sight direction, but remove the source clip's camera
  // banking in aircraft-local space. Its horizon follows the fuselage's up
  // axis, including a pitched/banked root, rather than inheriting a Dutch angle.
  const localAngles=angle(f.forward);localAngles.roll=0;
  // Retain restrained pitch/yaw vibration; roll shake would tilt that horizon.
  const strength=Math.sin(Math.PI*Math.max(0,Math.min(1,f.playElapsed/FLYBY188.duration)));
  localAngles.pitch+=Math.sin(f.playElapsed*59)*.18*strength;
  localAngles.yaw+=Math.sin(f.playElapsed*43)*.12*strength;
  const level=axes(localAngles);
  const angles=orient(rotate(level[0],basis),rotate(level[2],basis));
  if(Math.abs(angles.roll)<1e-8)angles.roll=0;
  return {...f,position:add(refs.root.GetAbsOrigin(),rotate(f.position,basis),1),angles};
}
function drawFlyby188(s,shade){
  showClass(s,'Gunner','Active',false);showClass(s,'IntroShade','On',true);
  const pct=Math.round(shade*100);
  if(s.intro.shade!==pct){
    if(s.intro.shade!==undefined)showClass(s,'IntroShade','Shade'+s.intro.shade,false);
    showClass(s,'IntroShade','Shade'+pct,true);s.intro.shade=pct;
  }
}
function beginFlyby188(s){
  if(s!==seat||!valid(refs.root)||!valid(s.zoomAnchor)||!valid(s.zoomControl))throw Error('exterior flyby unavailable');
  s.intro={start:now(),shade:undefined};s.phase='intro';held=null;
  drawFlyby188(s,1);
  s.camera.SetMode(CustomCameraMode.CONTROLLED);s.ownedCamera=true;s.ownedCameraMode=CustomCameraMode.CONTROLLED;
  const f=flybyPose188(0);s.camera.Teleport({position:f.position,angles:f.angles});
  s.zoomAnchor.Teleport({position:f.position,angles:f.angles});
  beginCinema188(s);updateCinema188(f);
  lastFlyby188={phase:'playing',elapsed:0,playElapsed:0,preparing:true,sample:0};
  return true;
}
function releaseFlyby188(s,reason){
  if(typeof clearVisibilityProbe195==='function')clearVisibilityProbe195(reason);
  if(typeof clearIntroCameraProbe195==='function')clearIntroCameraProbe195(reason);
  if(!s?.intro)return;
  const elapsed=now()-s.intro.start;
  const nativeOnly195=typeof cinema188!=='undefined'&&cinema188?.nativeOnly195;
  releaseCinema188(reason);
  if(valid(s.zoomControl)){if(!nativeOnly195)send(s.zoomControl,'DisableCameraAll');s.zoomControl.SetHealth(ZOOM187.fov);}
  if(valid(s.hud)){
    showClass(s,'IntroShade','On',false);
    if(s.intro.shade!==undefined)showClass(s,'IntroShade','Shade'+s.intro.shade,false);
  }
  s.intro=null;lastFlyby188={phase:reason==='complete'?'complete':'interrupted',reason,elapsed};
}
function tickFlyby188(s,t){
  if(s.camera.GetMode()!==CustomCameraMode.CONTROLLED||!valid(s.zoomAnchor)||!valid(s.zoomControl)){
    leaveGunner('intro_camera_lost');return;
  }
  const f=flybyPose188(t-s.intro.start);
  if(f.complete){releaseFlyby188(s,'complete');startActiveGunner188(s,t);return;}
  s.camera.Teleport({position:f.position,angles:f.angles});
  s.zoomAnchor.Teleport({position:f.position,angles:f.angles});updateCinema188(f);
  lastFlyby188={phase:'playing',elapsed:t-s.intro.start,playElapsed:f.playElapsed,preparing:f.preparing,
    sample:f.sample,position:f.position,angles:f.angles};
}
// Explicit console diagnostics only: never invoked by the flight Think and never
// used to change a camera, visibility, physics, admission or control state.
function traceFlybySight195(anchor){
  if(!valid(anchor)||!valid(refs.root)||seat?.phase!=='intro')return;
  const start=anchor.GetAbsOrigin(),basis=axes(refs.root.GetAbsAngles());
  // Center of the actual exported airframe render bounds, in Source local units.
  const center=add(refs.root.GetAbsOrigin(),rotate({x:-55.9828186,y:0,z:243.676128},basis),1);
  const parts=aircraftVisualParts185(),ignoreEntity=[...parts,anchor];
  const targets=[['airframe_bounds_center',center],...Object.entries(stations)
    .filter(([,s])=>valid(s.carriage)).map(([kind,s])=>['carriage'+kind,s.carriage.GetAbsOrigin()])];
  for(const [target,end] of targets){
    const hit=Instance.TraceLine({start,end,ignoreEntity,ignorePlayers:true});
    const e=valid(hit.hitEntity)?hit.hitEntity:null;
    Instance.Msg('[AC195_FLYBY_SIGHT] '+JSON.stringify({time:now(),target,start,requestedEnd:end,
      didHit:!!hit.didHit,startedInSolid:!!hit.startedInSolid,fraction:hit.fraction??null,
      end:hit.end??null,normal:hit.normal??null,ignoreOwnParts:parts.length,
      hit:e?{name:String(e.GetEntityName()).slice(0,96),classname:String(e.GetClassName()).slice(0,64),position:e.GetAbsOrigin()}:null,
      meaning:'server collision ray; not client visibility or render confirmation'}));
  }
}
Console.RegisterCheatCommand('ac188_intro_status',()=>{
  if(!valid(unique('AC176_Lab'))&&!valid(unique('AC195_TestMode')))return;
  Instance.Msg('[AC188_INTRO] '+JSON.stringify({...lastFlyby188,seatPhase:seat?.phase,
    duration:FLYBY_DURATION195,originalClipDuration:FLYBY188.duration,transition:FLYBY_TRANSITION195,
    fuelEnd,camera:seat?.camera?.GetMode(),cameraPosition:seat?.camera?.GetAbsOrigin(),
    bodyProtected:seat?protectsGunnerDamage(seat.p):false,interiorIncluded:false}));
  // Read-only, separate short rows: server poses/colors can be checked during
  // the real 3 s clip without claiming that they prove client transmission.
  if(valid(unique('AC195_TestMode'))){
    for(const e of aircraftVisualParts185())Instance.Msg('[AC195_FLYBY_MODEL] '+JSON.stringify({
      time:now(),name:e.GetEntityName(),position:e.GetAbsOrigin(),angles:e.GetAbsAngles(),
      scale:e.GetModelScale(),color:e.GetColor()}));
    const anchor=unique('AC187_ZoomAnchor'),control=unique('AC188_IntroControl');
    Instance.Msg('[AC195_FLYBY_VIEW] '+JSON.stringify({time:now(),phase:seat?.phase,
      officialIntroControl:valid(control),introControlHealth:valid(control)?control.GetHealth():null,cinemaActive:!!cinema188,
      anchor:valid(anchor)?{position:anchor.GetAbsOrigin(),angles:anchor.GetAbsAngles()}:null,
      native:valid(seat?.camera)?{position:seat.camera.GetAbsOrigin(),angles:seat.camera.GetAbsAngles(),mode:seat.camera.GetMode()}:null,
      pawn:valid(seat?.p)?{position:seat.p.GetAbsOrigin(),eyePosition:seat.p.GetEyePosition(),eyeAngles:seat.p.GetEyeAngles()}:null,
      eyePositionSource:'Entity.GetEyePosition',actualClientViewEntityReadable:false,
      requestedFov:FLYBY188.requestedFov,clientRenderingVerified:false}));
    traceFlybySight195(anchor);
  }
});
const gunSlots=[
  {kind:'105',gear:CSGearSlot.RIFLE,item:'weapon_mp9'},
  {kind:'40',gear:CSGearSlot.PISTOL,item:'weapon_hkp2000'},
  {kind:'25',gear:CSGearSlot.KNIFE,item:'weapon_knife'}
];
const fuelCapacity=30;
let seat=null,fuelEnd=null;
let lastExit='';
function restoreGunnerNativeHud195(s){
  if(!s.nativeHudHidden)return;
  // There is no public getter for the previous HUD mask. Restore normal visible
  // HUD only on the same pawn that this seat hid, never a replacement pawn.
  if(valid(s.p))send(s.p,'SetHUDVisibility','1',s.p);
  s.nativeHudHidden=false;
}
function fuelReading(end,t,capacity=fuelCapacity){
  const seconds=Math.max(0,Math.min(capacity,end-t));
  return {seconds,pct:Math.ceil(seconds*100/capacity),low:seconds>0&&seconds<capacity*.20};
}
function cameraPosition(){
  // Port-side sensor beyond every gun's compiled geometry envelope (Y <=235.253).
  // Guns remain visible in the world, but sit behind this outward-facing view.
  return add(refs.root.GetAbsOrigin(),rotate({x:80,y:320,z:75},axes(refs.root.GetAbsAngles())),1);
}
function showClass(s,id,cls,value){
  const key=id+'.'+cls;
  if(s.cache.get(key)===value)return;
  s.hud.SetHasClassForPlayer(s.slot,id,cls,value);s.cache.set(key,value);
}
function showText(s,id,key,value){
  if(s.cache.get(id)===value)return;
  s.hud.SetDialogVariableStringForPlayer(s.slot,id,key,value);s.cache.set(id,value);
}
function drawGunner(s,t){
  const fuel=fuelReading(fuelEnd,t,s.fuelCapacity),mag=battery.status(t);
  showClass(s,'Gunner','Active',true);
  showClass(s,'LowFuel','On',fuel.low);showClass(s,'FuelFill','Low',fuel.low);
  if(s.pct!==fuel.pct){
    if(s.pct!==undefined)showClass(s,'FuelFill','Pct'+s.pct,false);
    showClass(s,'FuelFill','Pct'+fuel.pct,true);s.pct=fuel.pct;
  }
  showText(s,'FuelTime','fuel',Math.ceil(fuel.seconds)+' s');
  showText(s,'ZoomHint','zoom',s.zoomed?'还原视野':'放大视野');
  showText(s,'Calibre','calibre',s.kind+' mm');
  for(const {kind} of gunSlots){
    showClass(s,'Sight'+kind,'On',kind===s.kind);showClass(s,'Card'+kind,'On',kind===s.kind);
    const a=mag[kind];
    showText(s,'Ammo'+kind,'ammo',a.rounds===null?'∞':a.rounds+' / '+a.capacity);
    showText(s,'Load'+kind,'loading',a.reloading?'装填 '+(Math.ceil(a.reloadRemaining*10)/10).toFixed(1)+' s':'');
  }
}
function leaveGunner(reason){
  weaponAudio186.stopLoop();
  const s=seat;if(!s)return true;
  if(s.phase==='intro'||s.phase==='fitting'||
      ['round_start','round_restart','script_reload','round_end','stage_nuclear_end'].includes(reason))
    stopFlight192(now(),reason);
  releaseFlyby188(s,reason);
  if(s.exiting)return false;
  s.exitReason=reason;
  const bodyPlan=planBodyReturn(s,reason);
  if(!bodyPlan){s.phase='return_pending';held=null;return false;}
  s.exiting=true;held=null;lastExit=reason;
  releaseZoom187(s);
  function clean(f){try{f();}catch(e){Instance.Msg('[AC179] release '+reason+' '+e);}}
  clean(()=>{if(valid(s.hud))s.hud.ResetForPlayer(s.slot);});
  clean(()=>{if(s.ownedCamera&&valid(s.camera)&&s.camera.GetMode()===s.ownedCameraMode){
    s.camera.SetMode(CustomCameraMode.DISABLED);
    if(operator(s.p))s.p.SetEyeAngles(s.oldAim);
  }});
  for(const [weapon,ammo] of s.ammo)clean(()=>{
    if(!valid(weapon))return;
    if(weapon.GetClipAmmo()===0)weapon.SetClipAmmo(ammo.clip);
    if(weapon.GetReserveAmmo()===0)weapon.SetReserveAmmo(ammo.reserve);
  });
  for(const w of s.loans)clean(()=>{if(valid(w))w.Remove();});
  clean(()=>{if(operator(s.p)&&valid(s.original)&&s.original.GetOwner()===s.p)s.p.SwitchToWeapon(s.original);});
  // Damage protection remains until after the actual body teleport and restoration.
  try{restoreGunnerNativeHud195(s);returnGunnerBody(s,bodyPlan,reason);}catch(e){
    s.exiting=false;s.phase='return_pending';Instance.Msg('[AC184] body restoration pending: '+e);return false;
  }
  seat=null;
  return true;
}
function beginGunner(p,profile=null,blocked=null){
  if(!canUseAircraft()||seat||!operator(p)||!active||(fuelEnd!==null&&now()>=fuelEnd))return false;
  if(gunnerExclusionReason(p,blocked??scanGunnerExclusions()))return false;
  const camera=p.GetCustomCamera(),hud=unique('AC179_HUD'),controller=p.GetPlayerController();
  if(!valid(controller)||!valid(camera)||camera.GetMode()!==CustomCameraMode.DISABLED||!valid(hud))return false;
  const s={p,controller,slot:controller.GetPlayerSlot(),hud,camera,kind:'105',phase:'fitting',
    oldAim:p.GetEyeAngles(),original:p.GetActiveWeapon(),loans:[],ammo:new Map(),cache:new Map(),
    nextDraw:0,ownedCamera:false,nativeHudHidden:false,
    sortieProfile:profile,fuelCapacity:profile?.durationSeconds??fuelCapacity};
  seat=s;activateGunner(s);return seat===s&&['intro','active'].includes(s.phase);
}
function activateGunner(s){
  s.phase='fitting';
  try{
    prepareZoom187(s);
    isolateGunnerBody(s);
    // Keep the native HUD available: 1/2/3 are the client's native weapon-slot
    // commands, not CSInputs. Whole-HUD hiding can also suppress that selector.
    // The public map API has no supported crosshair-only visibility control.
    for(const slot of gunSlots){
      if(valid(s.p.FindWeaponBySlot(slot.gear)))continue;
      s.p.GiveNamedItem(slot.item,false);
      const w=s.p.FindWeaponBySlot(slot.gear);
      if(!valid(w)||w.GetOwner()!==s.p)throw Error('missing gear slot '+slot.kind);
      s.loans.push(w);
    }
    // Use the game's normal selectable gear slots without firing the carrier's guns.
    for(const slot of gunSlots.slice(0,2)){
      const w=s.p.FindWeaponBySlot(slot.gear);
      s.ammo.set(w,{clip:w.GetClipAmmo(),reserve:w.GetReserveAmmo()});
      w.SetClipAmmo(0);w.SetReserveAmmo(0);
    }
    hideGunnerInventory(s);
    s.p.SwitchToWeapon(s.p.FindWeaponBySlot(gunSlots[0].gear));
    prepareFlight192(s.sortieProfile??{});
    setAircraftVisible195(true);
    if(!beginFlyby188(s))startActiveGunner188(s,now());
    aircraftDeployed195=true;
  }catch(e){Instance.Msg('[AC179] enter '+e);leaveGunner('entry_failed');if(!aircraftDeployed195)setAircraftVisible195(false);}
}
function startActiveGunner188(s,t){
  const routeEnd=startFlight192(t);
  s.camera.Teleport({position:cameraPosition()});
  s.camera.SetMode(CustomCameraMode.CONTROLLED_POSITION);s.ownedCamera=true;s.ownedCameraMode=CustomCameraMode.CONTROLLED_POSITION;
  // Ignore a right button held during the cinematic until a new press occurs.
  s.zoomButton=!!s.p.IsInputPressed(CSInputs.ATTACK2);s.zoomed=false;
  if(routeEnd!==null)fuelEnd=routeEnd;
  else if(fuelEnd===null)fuelEnd=t+s.fuelCapacity;
  s.phase='active';
  gunnerViewAngles195(s,true);
  if(!startGunnerView195(s))throw Error('gunner world camera unavailable');
  battery.select(s.kind,t);drawGunner(s,t);
}
Instance.OnScriptInput('EnterGunner',({activator,caller})=>{
  // Free E-key boarding is a test-lab feature only; formal maps must draw a crew member.
  if(valid(unique('AC176_Lab'))&&!deployment.attempted&&valid(caller)&&caller===unique('AC179_Board'))beginGunner(activator);
});
Instance.OnModifyPlayerDamage(event=>{
  if(cinemaProtects188(event))return {abort:true};
  if(protectsGunnerDamage(event.player))return {abort:true};
  // The map炮 uses the manager as inflictor; held firearms, knives and grenades do not.
  if(seat&&event.attacker===seat.p&&event.inflictor!==refs.manager&&
    (event.weapon||event.inflictor?.GetClassName().startsWith('weapon_')))return {abort:true};
});
function selectedGear(s){
  const w=s.p.GetActiveWeapon();
  return valid(w)?gunSlots.find(g=>g.gear===w.GetData().GetGearSlot()):undefined;
}
function hideGunnerViewModels195(s){
  if(!s.body)return;
  const weapons=ownedGunnerWeapons(s);
  // These engine class names exist in the local official server binary. Only
  // entities positively owned by this pawn or its retained weapon are touched.
  for(const cls of ['viewmodel','predicted_viewmodel','csgo_viewmodel'])
    for(const entity of Instance.FindEntitiesByClass(cls)){
      if(!valid(entity))continue;
      const owner=entity.GetOwner();
      if(owner===s.p||weapons.has(owner))hideBodyEntity(s,entity);
    }
}
function syncGunnerWeapon195(s,t){
  const weapon=s.p.GetActiveWeapon(),chosen=valid(weapon)?gunSlots.find(g=>g.gear===weapon.GetData().GetGearSlot()):undefined;
  if(!chosen)return undefined;
  const changed=weapon!==s.lastWeapon195;
  if(changed){
    // Weapon deploy can create a new viewmodel or restore weapon alpha. Refresh
    // visibility on this observed switch, rather than waiting for the 0.1s pin.
    hideGunnerInventory(s);s.visibilityUntil195=t+.1;
    s.lastWeapon195=weapon;s.slotChanges195=(s.slotChanges195||0)+1;
  }
  if(s.body){hideBodyEntity(s,weapon);if(t<=(s.visibilityUntil195??-Infinity))hideGunnerViewModels195(s);}
  if(chosen.kind!==s.kind){s.kind=chosen.kind;battery.select(s.kind,t);s.nextDraw=0;}
  return chosen;
}
function queueGunnerSlotSync195(s){
  if(s.slotSyncQueued195)return;
  s.slotSyncQueued195=true;
  // Valve exposes no weapon-switch event. This second observation is after
  // weapon/entity Think, so a switch later in this tick does not wait a frame.
  Instance.QueueAfterThinks(()=>{
    s.slotSyncQueued195=false;
    if(seat!==s||s.phase!=='active'||s.exiting||!canUseAircraft()||!operator(s.p)||
      !valid(s.controller)||s.controller.GetPlayerPawn()!==s.p)return;
    const t=now();if(fuelEnd===null||t>=fuelEnd)return;
    try{
      const before=s.kind;syncGunnerWeapon195(s,t);
      if(s.kind!==before){drawGunner(s,t);s.nextDraw=t+.05;}
    }catch(error){Instance.Msg('[AC195] weapon visibility sync failed: '+error);leaveGunner('weapon_visibility_error');}
  });
}
function seatCanShoot(kind,p){
  return canUseAircraft()&&seat?.phase==='active'&&seat.p===p&&seat.kind===kind&&now()<fuelEnd&&operator(p)&&selectedGear(seat)?.kind===kind;
}
function gunnerTick(t){
  if(departure.phase==='departing'){
    if(seat)maintainGunnerBody(seat,t);advanceDeparture();return;
  }
  // The sortie clock continues even if its operator dies or disconnects.
  if(canUseAircraft()&&fuelEnd!==null&&t>=fuelEnd){requestDeparture('fuel_empty');return;}
  const s=seat;if(!s)return;
  if(!active||!valid(refs.root)||!valid(s.controller)||s.controller.GetPlayerPawn()!==s.p||!operator(s.p)||
    !valid(s.camera)||!valid(s.hud)){leaveGunner('operator_or_camera_lost');return;}
  maintainGunnerBody(s,t);
  if(s.phase==='intro'){tickFlyby188(s,t);return;}
  if(s.phase==='return_pending'){leaveGunner(s.exitReason||'return_pending');return;}
  if(s.phase!=='active')return;
  if(s.camera.GetMode()!==CustomCameraMode.CONTROLLED_POSITION){leaveGunner('camera_changed');return;}
  gunnerViewAngles195(s);
  s.camera.Teleport({position:cameraPosition()});
  if(!tickZoom187(s))return;
  const chosen=syncGunnerWeapon195(s,t);queueGunnerSlotSync195(s);
  if(chosen){
    if(s.p.IsInputPressed(CSInputs.ATTACK))shoot(s.kind,s.p);else aimStation(s.kind,s.p);
  }else if(!valid(s.p.FindWeaponBySlot(gunSlots.find(g=>g.kind===s.kind).gear))){
    leaveGunner('slot_lost');return;
  }else if(valid(s.p.GetActiveWeapon())){
    s.p.SwitchToWeapon(s.p.FindWeaponBySlot(gunSlots.find(g=>g.kind===s.kind).gear));
  }
  if(t>=s.nextDraw){drawGunner(s,t);s.nextDraw=t+.05;}
}
for(const event of ['OnPlayerReset','OnPlayerKill','OnPlayerTeamChanged'])
  Instance[event](({player})=>{if(seat?.p===player)leaveGunner(event);});
Instance.OnWeaponDrop(({weapon,dropper})=>{
  if(seat?.p===dropper&&!seat.exiting&&gunSlots.some(g=>g.gear===weapon.GetData().GetGearSlot()))leaveGunner('weapon_dropped');
});
Instance.OnRoundEnd(()=>{stopEngineSmoke188();leaveGunner('round_end');});
Console.RegisterCheatCommand('ac179_gunner_status',()=>{
  if(!valid(unique('AC176_Lab')))return;
  const s=seat;
  Instance.Msg('[AC179] '+JSON.stringify({time:now(),end:fuelEnd,lastExit,phase:s?.phase,slot:s?.slot,
    kind:s?.kind,zoomed:s?.zoomed,camera:s?.camera?.GetMode(),pos:s?.camera?.GetAbsOrigin(),loans:s?.loans.length,nativeHudHidden:s?.nativeHudHidden??false,
    hud:s&&{active:s.cache.get('Gunner.Active'),sight:gunSlots.filter(g=>s.cache.get('Sight'+g.kind+'.On')).map(g=>g.kind),
      fuel:s.pct,warning:s.cache.get('LowFuel.On'),ammo:gunSlots.map(g=>s.cache.get('Ammo'+g.kind)),
      loading:gunSlots.map(g=>s.cache.get('Load'+g.kind))}}));
});
// Temporary full-map trial only. Keep the chosen test mode in this point_script
// instance across round callbacks; never write addon save data or restart a round.
// A first real player's BeginMatch recreates Hammer entities after initial setup.
const testScene195={mode:null,generation:0,phase:'unselected',loadedAt:null,upperAt:null,
  upper:null,setupAt:null,deadline:null,recovered:false,nextCheck:0,reason:null,setupRequested:false,setupConfirmed:false,
  loadGeneration:null,entitiesDeadline:null,entitiesReadyAt:null,nextResolve:0,entityCounts:null,missing:[],upperReceipt:null,upperArmed:false,upperFallbackAt:null};
function testSceneEnabled195(){return valid(unique('AC195_TestMode'));}
function testSceneCaller195(input,name){
  return testSceneEnabled195()&&valid(input?.caller)&&input.caller===unique(name);
}
function testSceneState195(detail=false){
  const {mode,generation,phase,loadedAt,upperAt,reason,setupConfirmed,entitiesReadyAt,entityCounts,missing}=testScene195;
  const state={mode,generation,phase,loadedAt,entitiesReadyAt,upperAt,reason,setupConfirmed};
  return detail?{...state,entityCounts,missing,upperReceiptAt:testScene195.upperReceipt?.at??null}:state;
}
function testScenePhase195(phase,reason=null){
  testScene195.phase=phase;testScene195.reason=reason;
  const label=unique('AC195_TestDeploy_Label');
  if(valid(label))send(label,'SetMessage',phase==='ready'?'E - AC130 TEST':
    phase==='failed'?'TEST NOT READY':'WAIT - PREPARING TEST');
  Instance.Msg('[AC195_SCENE] '+JSON.stringify({time:now(),...testSceneState195(true)}));
}
function resetTestSceneProgress195(){
  Object.assign(testScene195,{generation:testScene195.generation+1,loadedAt:null,upperAt:null,
    upper:null,setupAt:null,deadline:null,recovered:false,nextCheck:0,reason:null,setupRequested:false,setupConfirmed:false,
    loadGeneration:null,entitiesDeadline:null,entitiesReadyAt:null,nextResolve:0,entityCounts:null,missing:[],upperReceipt:null,upperArmed:false,upperFallbackAt:null});
}
function selectTestScene195(mode,input){
  if(!testSceneCaller195(input,'AC195_Setup'+mode))return;
  const s=testScene195,continuing=s.mode===mode&&
    ['waiting_setup','waiting_stage_load','waiting_stage_entities','waiting_upper_defense'].includes(s.phase);
  if(s.mode===mode&&s.setupConfirmed)return; // Duplicate acknowledgement cannot erase an early upper receipt.
  // A fast original stage load may precede the deferred mode relay. Retain that
  // current-round acknowledgement, but never treat it as mode confirmation.
  if(!continuing)resetTestSceneProgress195();s.mode=mode;s.setupConfirmed=true;
  testScene195.deadline=now()+120;
  testScenePhase195(s.loadedAt===null?'waiting_stage_load':'waiting_stage_entities');
  s.nextResolve=0;resolveTestSceneEntities195(now());
}
function beginTestSceneRound195(){
  // Do not clear mode: the native script instance owns map-session state.
  // This cancels old geometry handles and deadlines, not map entities or players.
  if(!testScene195.mode)return;
  resetTestSceneProgress195();testScenePhase195('round_cleanup');
}
function testSceneRoundStart195(){
  if(!testSceneEnabled195()||!testScene195.mode)return;
  resetTestSceneProgress195();testScene195.setupAt=now()+.25;testScene195.deadline=now()+120;
  testScenePhase195('waiting_setup');
}
function testSceneLoaded195(input){
  if(!testSceneCaller195(input,'vpkloading_loadunload5')||!testScene195.mode||roundRestarting)return;
  if(!['waiting_setup','waiting_stage_load'].includes(testScene195.phase))return;
  const s=testScene195;
  if(s.loadedAt!==null)return; // Duplicate load notifications cannot extend the bounded wait.
  s.loadedAt=now();s.loadGeneration=s.generation;s.entitiesDeadline=now()+8;s.nextResolve=0;
  if(s.phase!=='waiting_setup')testScenePhase195('waiting_stage_entities');
  resolveTestSceneEntities195(now());
}
function resolveTestSceneEntities195(t){
  const s=testScene195;
  if(s.loadedAt===null||s.loadGeneration!==s.generation||s.entitiesReadyAt!==null||t<s.nextResolve)return;
  s.nextResolve=t+.05;
  const upperMatches=Instance.FindEntitiesByName('AC195_StartUpperDefense').filter(valid);
  const pendingMatches=Instance.FindEntitiesByName('AC195_SetupPending').filter(valid);
  s.entityCounts={upper:upperMatches.length,pending:pendingMatches.length};
  s.missing=[];
  if(upperMatches.length!==1)s.missing.push('AC195_StartUpperDefense');
  if(pendingMatches.length!==1)s.missing.push('AC195_SetupPending');
  if(s.missing.length){
    s.reason='waiting_unique_stage_entities';
    if(t>s.entitiesDeadline)testScenePhase195('failed','load_entities_visibility_timeout');
    return;
  }
  if(!s.setupConfirmed)return; // An early load must not swallow the selected mode relay.
  s.upper=upperMatches[0];s.entitiesReadyAt=t;s.reason=null;
  const receipt=s.upperReceipt;
  if(receipt&&receipt.generation===s.generation&&receipt.mode===s.mode&&
      valid(receipt.caller)&&receipt.caller===s.upper){
    acceptTestSceneUpper195(receipt.at);return;
  }
  s.upperReceipt=null;armTestSceneUpper195();
}
function armTestSceneUpper195(){
  const s=testScene195,pending=unique('AC195_SetupPending');
  if(s.upperArmed||!s.setupConfirmed||!valid(s.upper)||!valid(pending))return;
  s.upperArmed=true;send(pending,'SetValue','1');testScenePhase195('waiting_upper_defense');
  // The original loader +1s Test may run before its upper relay is registered.
  // Always schedule one bounded fallback; a delayed script load acknowledgement
  // must not make us mistakenly assume that the original Test is still pending.
  // A received upper acknowledgement cancels the need for this fallback.
  s.upperFallbackAt=Math.max(now(),s.loadedAt+1.25);
}
function testSceneUpperStarted195(input){
  const s=testScene195,name='AC195_StartUpperDefense',caller=input?.caller;
  if(!testSceneEnabled195()||!s.mode||roundRestarting||!valid(caller)||
      !['waiting_setup','waiting_stage_load','waiting_stage_entities','waiting_upper_defense'].includes(s.phase))return;
  const expected=unique(name);
  if(valid(expected)){if(caller!==expected)return;}
  else if(caller.GetEntityName()!==name||caller.GetClassName()!=='logic_relay')return;
  // When the lookup registry is not ready, retain the receipt only. It does not
  // authorize readiness until the deferred unique-entity check matches caller.
  if(s.upperReceipt?.caller===caller&&s.upperReceipt.generation===s.generation)return;
  s.upperReceipt={caller,at:now(),generation:s.generation,mode:s.mode};
  if(s.entitiesReadyAt!==null&&s.setupConfirmed&&caller===s.upper)acceptTestSceneUpper195(now());
  else {s.nextResolve=0;resolveTestSceneEntities195(now());}
}
function acceptTestSceneUpper195(at){
  testScene195.upperAt=at;testScene195.deadline=at+35;testScene195.upperFallbackAt=null;
  testScenePhase195('waiting_lift_cleanup');
}
// Historical live rays through the temporary core clip, all above visible arena
// geometry. A timed Disable is not sufficient evidence that shooting is clear.
const TEST_CORE_CLIP_RAYS195=[
  [{x:-102.0242,y:-6932.2842,z:15702.3623},{x:-26.6507,y:-6898.4785,z:15654.8916}],
  [{x:9314.2146,y:-2276.0122,z:15702.3622},{x:9242.4473,y:-2315.8123,z:15653.959}],
  [{x:8635.3448,y:-1592.5192,z:15671.6523},{x:8585.1558,y:-1631.2436,z:15662.8496}]
];
function testSceneGeometry195(){
  for(const [start,end] of TEST_CORE_CLIP_RAYS195){
    const hit=Instance.TraceLine({start,end,ignorePlayers:true});
    if(hit.startedInSolid||hit.didHit)return {clear:false,reason:'flight_corridor_obstructed',
      hit:valid(hit.hitEntity)?hit.hitEntity.GetEntityName():null};
  }
  const hold=unique('AC184_Hold');
  if(!valid(hold))return {clear:false,reason:'operator_room_marker_missing'};
  const holdPoint=hold.GetAbsOrigin(),holdRoom=Instance.TraceBox({...bodyHull(),
    start:holdPoint,end:holdPoint,ignorePlayers:true});
  if(holdRoom.startedInSolid||holdRoom.didHit)return {clear:false,reason:'operator_room_obstructed'};
  const marker=unique('AC184_CoreReturn');
  if(!valid(marker))return {clear:false,reason:'return_marker_missing'};
  const p=marker.GetAbsOrigin(),floor=Instance.TraceBox({...bodyHull(),
    start:{...p,z:p.z+64},end:{...p,z:p.z-256},ignorePlayers:true});
  if(floor.startedInSolid||!floor.didHit||!floor.end||!floor.normal||floor.normal.z<.55)
    return {clear:false,reason:'return_floor_unavailable'};
  const feet={...floor.end,z:floor.end.z+2};
  const room=Instance.TraceBox({...bodyHull(),start:feet,end:feet,ignorePlayers:true});
  return room.startedInSolid||room.didHit?{clear:false,reason:'return_hull_obstructed'}:{clear:true};
}
function testSceneReady195(){
  return !testSceneEnabled195()||(testScene195.phase==='ready'&&valid(testScene195.upper)&&
    testScene195.upper===unique('AC195_StartUpperDefense'));
}
function tickTestScene195(t){
  if(!testSceneEnabled195()||!testScene195.mode||roundRestarting)return;
  const s=testScene195;
  if(s.phase==='ready'||s.phase==='failed'||s.phase==='round_cleanup')return;
  if(s.deadline!==null&&t>s.deadline)return testScenePhase195('failed',s.reason||'test_scene_setup_timeout');
  if(s.phase==='waiting_setup'&&t>=s.setupAt){
    const setup=unique('AC195_Setup'+s.mode),pending=unique('AC195_SetupPending');
    if(!valid(setup)||!valid(pending))return;
    // Change phase before queuing the input: at most one setup request per round.
    s.setupRequested=true;testScenePhase195('waiting_stage_load');send(pending,'SetValue','1');send(setup,'Trigger');
  }
  if(['waiting_setup','waiting_stage_load','waiting_stage_entities'].includes(s.phase))resolveTestSceneEntities195(t);
  if(s.phase==='waiting_upper_defense'&&s.upperFallbackAt!==null&&t>=s.upperFallbackAt){
    s.upperFallbackAt=null;
    const pending=unique('AC195_SetupPending');
    if(!valid(s.upper)||s.upper!==unique('AC195_StartUpperDefense')||!valid(pending))
      return testScenePhase195('failed','stage_replaced_before_upper_acknowledgement');
    // At most once per generation. The branch clears itself; an already-fired
    // upper relay is self-disabled, so a late acknowledgement cannot replay it.
    send(pending,'SetValue','1');send(pending,'Test');
  }
  if(s.phase!=='waiting_lift_cleanup'||t<s.upperAt+25.25)return;
  if(!valid(s.upper)||s.upper!==unique('AC195_StartUpperDefense'))
    return testScenePhase195('failed','stage_replaced_during_setup');
  if(!s.recovered){
    const floor=unique('stage_5_top_core_tunnel_effect');
    if(!valid(floor))return testScenePhase195('failed','return_floor_entity_missing');
    s.recovered=true;s.nextCheck=t+.1;send(floor,'TurnOn');send(floor,'EnableCollision',undefined,undefined,.01);
    return;
  }
  if(t<s.nextCheck)return;s.nextCheck=t+.25;
  const geometry=testSceneGeometry195();
  if(geometry.clear)testScenePhase195('ready');
  else s.reason=geometry.reason+(geometry.hit?':'+geometry.hit:'');
}
Instance.OnScriptInput('TestSceneNormal195',input=>selectTestScene195('Normal',input));
Instance.OnScriptInput('TestSceneExtreme195',input=>selectTestScene195('Extreme',input));
Instance.OnScriptInput('TestSceneStageLoaded195',testSceneLoaded195);
Instance.OnScriptInput('TestSceneUpperStarted195',testSceneUpperStarted195);
Console.RegisterCheatCommand('ac195_scene_status',()=>{
  if(testSceneEnabled195())Instance.Msg('[AC195_SCENE] '+JSON.stringify({time:now(),...testSceneState195(true),ready:testSceneReady195()}));
});
// Temporary authored-button test path. Without AC195_TestMode it is inert;
// formal population profiles, item exclusions and account lottery remain in force.
const AIRCRAFT_NAMES195=['LMS_AC130_Root161',...['25','40','105'].flatMap(k=>['AC178_Carriage'+k,'LMS_AC130_Muzzle'+k+'_161'])];
// Native model animation owns the four propeller bones. The root entity and
// sequence are cached so repeated reveals never restart the 0.5-second loop.
const PROPELLER_ANIMATIONS208=Object.freeze({flight:'propellers_flight208',stopped:'propellers_stopped208'});
let propellerAnimationRoot208=null,propellerAnimation208=null;
function setAircraftPropellers208(running){
  const root=refs.root;if(!valid(root))return false;
  const sequence=running?PROPELLER_ANIMATIONS208.flight:PROPELLER_ANIMATIONS208.stopped;
  if(propellerAnimationRoot208===root&&propellerAnimation208===sequence)return true;
  send(root,'SetDefaultAnimation',sequence);send(root,'SetAnimation',sequence);
  propellerAnimationRoot208=root;propellerAnimation208=sequence;return true;
}
function setAircraftVisible195(shown){
  if(shown)for(const kind of Object.keys(WEAPONS))positionStation(kind,now());
  // Template props now spawn enabled with alpha 0. A direct color state avoids
  // coupling reveal to the prop's disabled/NoDraw input state. Preserve RGB.
  for(const e of aircraftVisualParts185()){
    const color=e.GetColor(),alpha=shown?255:0;
    if(color.a!==alpha)e.SetColor({...color,a:alpha});
  }
  setAircraftPropellers208(shown);
}
function testCaller195(input,name){
  if(!valid(unique('AC195_TestMode'))||!valid(input?.caller)||input.caller!==unique(name)||input.caller.GetClassName()!=='func_button')return false;
  const p=input.activator,c=operator(p)?p.GetPlayerController():null;
  return valid(c)&&c.IsConnected()&&c.GetPlayerPawn()===p;
}
function testLog195(result,detail={}){Instance.Msg('[AC195_TEST] '+JSON.stringify({result,time:now(),...detail}));return false;}
function testBodyPreflight195(p){
  const hold=unique('AC184_Hold'),parent=p.GetParent(),camera=p.GetCustomCamera();
  const moveType=p.GetMoveType(),cameraMode=valid(camera)?camera.GetMode():null;
  const returnPoint=coreReturnPoint(p),holdClear=valid(hold)?clearBodyPoint(p,hold.GetAbsOrigin()):false;
  const reason=!valid(hold)?'operator_room_marker_missing':!returnPoint?'core_return_unavailable':
    parent?'player_parented':moveType!==CSMoveType.WALK?'player_not_walking':!holdClear?'operator_room_obstructed':
    !valid(camera)?'camera_unavailable':cameraMode!==CustomCameraMode.DISABLED?'camera_in_use':
    !valid(unique('AC179_HUD'))?'hud_unavailable':null;
  return {reason,moveType,parented:!!parent,cameraMode,holdClear,returnPoint};
}
function ensureAircraft195(){
  const groups=AIRCRAFT_NAMES195.map(n=>Instance.FindEntitiesByName(n).filter(valid));
  if(groups.some(g=>g.length>1))throw Error('duplicate named aircraft parts');
  if(groups.some(g=>g.length!==1)){
    const template=unique('AC195_AircraftTemplate');
    if(!valid(template))throw Error('repeatable aircraft template missing');
    // All names belong to this component, and the caller already ensured there
    // is no occupied aircraft or moving wreck. Remove any incomplete old set.
    remove(groups.flat());
    const made=template.ForceSpawn()||[];
    if(made.length!==AIRCRAFT_NAMES195.length||AIRCRAFT_NAMES195.some(n=>!valid(unique(n)))){
      remove(made);throw Error('incomplete repeatable aircraft template');
    }
  }
  bind();if(!active)throw Error('aircraft rebinding failed');
}
function testDeploy195(input){
  if(!testCaller195(input,'AC195_TestDeploy'))return false;
  if(!testSceneReady195())return testLog195('upper_defense_not_ready',{scene:testSceneState195()});
  if(seat||cinema188||wreck185||departure.phase==='departing'||deployment.pending||
      (aircraftDeployed195&&departure.phase!=='departed'))return testLog195('sortie_or_cleanup_busy');
  // Preserve the real safety restrictions. The local button bypasses only the
  // map trigger/population and random identity draw, never inventory ownership.
  if(!mayAcquireGunner(input.activator))return testLog195('holder_or_tank_excluded');
  try{
    // Read-only preview of the unchanged admission checks; activateGunner repeats
    // the real checks immediately before it takes ownership of the player's body.
    const preflight=testBodyPreflight195(input.activator);
    if(preflight.reason)return testLog195('preflight_rejected',preflight);
    clearWreck185();retireAircraftWeapons195();battery.reset(now(),{preserveProjectiles:true});
    resetFlight192();resetDepartureRound();resetDeploymentRound();fuelEnd=null;
    ensureAircraft195();
    deployment.attempted=true;
    if(!beginGunner(input.activator))return testLog195('gunner_setup_failed');
    deployment.result='test_button_awarded';
    Instance.Msg('[AC195_TEST] '+JSON.stringify({result:deployment.result,slot:seat.slot,time:now()}));
    return true;
  }catch(error){Instance.Msg('[AC195_TEST] '+String(error));return false;}
}
Instance.OnScriptInput('TestDeploy195',testDeploy195);
Instance.OnScriptInput('TestDestroy195',input=>{
  if(!testCaller195(input,'AC195_TestDestroy')||!aircraftDeployed195)return;
  requestDeparture('core_destroyed');
});
function bodyEntityDiagnostic195(entity){
  if(!valid(entity))return null;
  const classname=entity.GetClassName();
  return {classname:classname.slice(0,64),name:['player','cs_player_controller'].includes(classname)?null:entity.GetEntityName().slice(0,128),origin:entity.GetAbsOrigin()};
}
function bodyTraceDiagnostic195(trace){
  return {didHit:trace.didHit,startedInSolid:trace.startedInSolid,fraction:trace.fraction??null,
    end:trace.end??null,normal:trace.normal??null,hitEntity:bodyEntityDiagnostic195(trace.hitEntity)};
}
// Explicit, read-only diagnostic. It never changes admission, player positions,
// collision or camera state, and does not run in the normal Think loop.
Console.RegisterCheatCommand('ac195_hold_status',()=>{
  if(!valid(unique('AC195_TestMode')))return;
  const marker=unique('AC184_Hold');
  const emit=(kind,value)=>Instance.Msg('[AC195_HOLD] '+JSON.stringify({kind,time:now(),...value}));
  if(!valid(marker))return emit('missing',{marker:'AC184_Hold'});
  const p=marker.GetAbsOrigin(),center={...p,z:p.z+64};
  emit('standing',{marker:p,trace:bodyTraceDiagnostic195(Instance.TraceBox({
    ...bodyHull(),start:p,end:p,ignorePlayers:true}))});
  for(const [label,axis,delta] of [['left','x',-256],['right','x',256],
    ['back','y',-256],['front','y',256],['floor','z',-256],['roof','z',256]]){
    const end={...center,[axis]:center[axis]+delta};
    emit('wall',{label,start:center,end,trace:bodyTraceDiagnostic195(Instance.TraceLine({
      start:center,end,ignorePlayers:true}))});
  }
  const spawns=['info_player_counterterrorist','info_player_terrorist']
    .flatMap(c=>Instance.FindEntitiesByClass(c)).filter(valid)
    .map(e=>e.GetAbsOrigin()).filter(q=>q.x<-10000&&q.y>8000&&q.z<-15000);
  let blocked=0;const clear=[];
  for(const q of spawns){
    const start={...q,z:q.z+64},trace=Instance.TraceLine({start,end:center,ignorePlayers:true});
    if(trace.didHit&&!trace.startedInSolid)blocked++;else if(clear.length<3)clear.push({start,trace:bodyTraceDiagnostic195(trace)});
  }
  emit('waiting_area',{spawnChecks:spawns.length,blocked,unexpected:clear,
    collisionChecksOnly:true,clientRenderingVerified:false});
});
function logBodyDiagnostic195(row){
  const {originalReturnTrace,returnClearance,verticalProbes,...summary}=row;
  const emit=(kind,data)=>{
    const value={kind,time:row.time,slot:row.slot,...data};
    const prefix='[AC195_BODY_DIAGNOSTIC] ',json=JSON.stringify(value);
    if(prefix.length+json.length<1800){Instance.Msg(prefix+json);return;}
    // Defensive bounded JSON chunks for unexpected engine values. A normal
    // summary/trace is already below this limit, including capped entity names.
    const chunks=[];let start=0;
    while(start<json.length){
      let end=Math.min(json.length,start+1000);
      while(JSON.stringify(json.slice(start,end)).length>1400)end--;
      chunks.push(json.slice(start,end));start=end;
    }
    for(let i=0;i<chunks.length;i++)Instance.Msg(prefix+JSON.stringify({kind:'chunk',record:kind,time:row.time,slot:row.slot,index:i,total:chunks.length,json:chunks[i]}));
  };
  emit('summary',summary);
  if(originalReturnTrace)emit('originalReturnTrace',originalReturnTrace);
  for(const clearance of returnClearance||[])emit('returnClearance',clearance);
  for(const probe of verticalProbes||[])emit('verticalProbe',probe);
}
Console.RegisterCheatCommand('ac195_body_diagnostic',()=>{
  if(!valid(unique('AC195_TestMode')))return;
  const marker=unique('AC184_CoreReturn'),hold=unique('AC184_Hold');
  for(const controller of Instance.GetAllPlayerControllers()){
    if(!valid(controller)||!controller.IsConnected()||controller.IsBot())continue;
    const p=controller.GetPlayerPawn(),row={time:now(),slot:controller.GetPlayerSlot(),playerPresent:valid(p)};
    try{
      if(valid(p)){
        const camera=p.GetCustomCamera();
        Object.assign(row,{team:p.GetTeamNumber(),alive:p.IsAlive(),moveType:p.GetMoveType(),
          parent:bodyEntityDiagnostic195(p.GetParent()),cameraMode:valid(camera)?camera.GetMode():null,
          position:p.GetAbsOrigin(),coreReturnPoint:coreReturnPoint(p),
          hold:bodyEntityDiagnostic195(hold),holdClear:valid(hold)?clearBodyPoint(p,hold.GetAbsOrigin()):false,
          coreReturnMarker:bodyEntityDiagnostic195(marker)});
        if(valid(marker)){
          const q=marker.GetAbsOrigin(),options={...bodyHull(),start:{...q,z:q.z+64},end:{...q,z:q.z-256},ignoreEntity:p,ignorePlayers:true};
          const exact=Instance.TraceBox(options);
          row.originalReturnTrace={traceStart:options.start,traceEnd:options.end,...bodyTraceDiagnostic195(exact)};
          row.returnClearance=[];
          if(exact.didHit&&exact.end)for(const height of [2,76,150]){
            const position={x:q.x,y:q.y,z:exact.end.z+height};
            row.returnClearance.push({height,position,...bodyTraceDiagnostic195(Instance.TraceBox({...bodyHull(),start:position,end:position,ignoreEntity:p}))});
          }
          row.verticalProbes=[];
          for(const offset of [-32,0,64,144,256,512,1024]){
            const start={...q,z:q.z+offset},end={...q,z:q.z-512};
            const common={start,end,ignoreEntity:p,ignorePlayers:true};
            row.verticalProbes.push({offset,start,end,line:bodyTraceDiagnostic195(Instance.TraceLine(common)),
              box:bodyTraceDiagnostic195(Instance.TraceBox({...bodyHull(),...common}))});
          }
        }
      }
    }catch(error){row.error=String(error).slice(0,256);}
    logBodyDiagnostic195(row);
  }
});
