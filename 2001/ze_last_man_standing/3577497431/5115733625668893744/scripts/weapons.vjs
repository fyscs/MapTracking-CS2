    (s.p.IsInputPressed(CSInputs.ATTACK)||(held?.kind==='25'&&held.actor===s.p&&t<held.until)));
  weaponAudio186.tick(t,continuing,valid(refs.muzzles['25'])?refs.muzzles['25'].GetAbsOrigin():null);
}
