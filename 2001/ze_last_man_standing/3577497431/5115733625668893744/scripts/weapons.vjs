// Opt-in, one-intro A/B diagnostic, restricted to the temporary AC195 test map.
// Entities.Spawn does NOT document PVS/spawn-group guarantees. A visible probe
// would compare the creation paths; it is not a production transmission fix.
const VISIBILITY_PROBE_NAME195='AC195_VisibilityProbe_Airframe';
const VISIBILITY_PARENT_NAME195='AC195_VisibilityProbe_Parent';
let visibilityProbe195=null,visibilityProbeArmed195=false;
let visibilityProbeMode195='direct';
let lastVisibilityProbe195={result:'disabled',createdTime:null};
function visibilityProbeError195(error){return String(error).slice(0,180);}
function visibilityProbeEntity195(){
  try{return valid(visibilityProbe195?.entity)?visibilityProbe195.entity:null;}catch(_){return null;}
}
function visibilityProbeLog195(value){
