class WeaponAudio {
  constructor(io){this.io=io;this.voices=new Set();this.loop=null;this.last25=-Infinity;this.nextRetry=0;}
  stop(v){if(!v)return;this.voices.delete(v);if(this.loop===v)this.loop=null;
    try{this.io.stop(v.handle);}catch(e){this.io.error(e);}}
