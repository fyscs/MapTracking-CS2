// 导入模块
import { Instance, CSGearSlot } from "cs_script/point_script";

// 阵营常量（CS2 中 CT = 3，T = 2）
const TEAM_CT = 3;
const TEAM_T = 2;

/**
 * 从实体中获取玩家 Pawn。
 * 兼容 activator 为 CSPlayerController 或 CSPlayerPawn 的情况。
 * @param {Entity} entity
 * @returns {CSPlayerPawn | undefined}
 */
function getPlayerPawn(entity) {
    Instance.Msg("[strip] getPlayerPawn: 开始解析实体");

    if (!entity) {
        Instance.Msg("[strip] getPlayerPawn: 实体为 null/undefined，返回");
        return undefined;
    }

    Instance.Msg(`[strip] getPlayerPawn: 实体类名 = ${entity.GetClassName()}`);

    if (!entity.IsValid()) {
        Instance.Msg("[strip] getPlayerPawn: 实体已失效 (IsValid=false)，返回");
        return undefined;
    }

    // 如果传入的是控制器，则获取其控制的 Pawn
    if (typeof entity.GetPlayerPawn === 'function') {
        Instance.Msg("[strip] getPlayerPawn: 检测到控制器，尝试获取 PlayerPawn");
        const pawn = entity.GetPlayerPawn();
        if (!pawn) {
            Instance.Msg("[strip] getPlayerPawn: 控制器没有绑定的 Pawn");
            return undefined;
        }
        if (!pawn.IsValid()) {
            Instance.Msg("[strip] getPlayerPawn: Pawn 已失效");
            return undefined;
        }
        Instance.Msg(`[strip] getPlayerPawn: 成功获取 Pawn，类名 = ${pawn.GetClassName()}`);
        return pawn;
    }

    // 否则假设传入的已经是 Pawn
    Instance.Msg("[strip] getPlayerPawn: 传入的已经是 Pawn");
    return entity;
}

/**
 * 剥离玩家身上的近战武器（刀）。
 * @param {CSPlayerPawn} playerPawn
 */
function stripKnife(playerPawn) {
    Instance.Msg("[strip] stripKnife: 进入");

    if (!playerPawn) {
        Instance.Msg("[strip] stripKnife: playerPawn 为空，返回");
        return;
    }
    if (!playerPawn.IsValid()) {
        Instance.Msg("[strip] stripKnife: playerPawn 已失效，返回");
        return;
    }

    // 查找近战武器槽位中的武器
    Instance.Msg(`[strip] stripKnife: 查找 KNIFE 槽位 (CSGearSlot.KNIFE=${CSGearSlot.KNIFE})`);
    const knife = playerPawn.FindWeaponBySlot(CSGearSlot.KNIFE);

    if (!knife) {
        Instance.Msg("[strip] stripKnife: 未找到近战武器（返回 undefined），不做处理");
        return;
    }
    if (!knife.IsValid()) {
        Instance.Msg("[strip] stripKnife: 找到的近战武器已失效，不做处理");
        return;
    }

    Instance.Msg(`[strip] stripKnife: 找到近战武器类名 = ${knife.GetClassName()}，准备销毁`);
    playerPawn.DestroyWeapon(knife);
    Instance.Msg("[strip] stripKnife: 已调用 DestroyWeapon");
}

// 注册 striphuman 输入：仅当玩家为 CT 时剥离近战武器
Instance.OnScriptInput("striphuman", (inputData) => {
    Instance.Msg("[strip] >>> 收到输入 striphuman");
    Instance.Msg(`[strip] striphuman: inputData = ${JSON.stringify({
        hasCaller: !!inputData?.caller,
        hasActivator: !!inputData?.activator,
    })}`);

    const activator = inputData?.activator;
    if (!activator) {
        Instance.Msg("[strip] striphuman: activator 为空，无法判断玩家，返回");
        return;
    }

    const pawn = getPlayerPawn(activator);
    if (!pawn) {
        Instance.Msg("[strip] striphuman: 未能获取到玩家 Pawn，返回");
        return;
    }

    const team = pawn.GetTeamNumber();
    Instance.Msg(`[strip] striphuman: 玩家阵营 = ${team} (需要 CT=${TEAM_CT})`);

    if (team === TEAM_CT) {
        Instance.Msg("[strip] striphuman: 阵营匹配 CT，执行剥离");
        stripKnife(pawn);
    } else {
        Instance.Msg("[strip] striphuman: 阵营不匹配，跳过");
    }
});

// 注册 stripzombie 输入：仅当玩家为 T 时剥离近战武器
Instance.OnScriptInput("stripzombie", (inputData) => {
    Instance.Msg("[strip] >>> 收到输入 stripzombie");
    Instance.Msg(`[strip] stripzombie: inputData = ${JSON.stringify({
        hasCaller: !!inputData?.caller,
        hasActivator: !!inputData?.activator,
    })}`);

    const activator = inputData?.activator;
    if (!activator) {
        Instance.Msg("[strip] stripzombie: activator 为空，无法判断玩家，返回");
        return;
    }

    const pawn = getPlayerPawn(activator);
    if (!pawn) {
        Instance.Msg("[strip] stripzombie: 未能获取到玩家 Pawn，返回");
        return;
    }

    const team = pawn.GetTeamNumber();
    Instance.Msg(`[strip] stripzombie: 玩家阵营 = ${team} (需要 T=${TEAM_T})`);

    if (team === TEAM_T) {
        Instance.Msg("[strip] stripzombie: 阵营匹配 T，执行剥离");
        stripKnife(pawn);
    } else {
        Instance.Msg("[strip] stripzombie: 阵营不匹配，跳过");
    }
});

Instance.Msg("[strip] 脚本已加载，striphuman / stripzombie 输入已注册");