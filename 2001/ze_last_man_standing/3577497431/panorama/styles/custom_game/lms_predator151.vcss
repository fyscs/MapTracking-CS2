/* Generated by StarDance */
/* https://github.com/Kxnrl */

.PredatorRoot {
    width:100%;
    height:100%;
}
#PredatorPanel {
    horizontal-align:right;
    vertical-align:center;
    margin-right:5%;
    margin-top:24%;
    width:370px;
    padding:12px 16px;
    flow-children:down;
    background-color:#101922ed;
    border-left:3px solid #e4b568;
    visibility:collapse;
}
#PredatorPanel.Visible {
    visibility:visible;
}
.Title {
    color:#e4b568;
    font-size:18px;
    font-weight:bold;
    margin-bottom:7px;
}
.EnergyRow {
    width:100%;
    height:39px;
}
.Key {
    color:#c6d2da;
    font-size:17px;
    vertical-align:center;
}
.EnergyValue {
    horizontal-align:right;
    vertical-align:center;
    color:#ffffff;
    font-size:29px;
    font-weight:bold;
}
.EnergyValue.Low {
    color:#ffca77;
}
.EnergyBar {
    width:100%;
    height:9px;
    flow-children:right;
    margin-top:4px;
    margin-bottom:12px;
}
.Cell {
    width:17px;
    height:8px;
    margin-right:3px;
    background-color:#34424d;
}
.Cell.Filled {
    background-color:#e4b568;
}
.Row {
    width:100%;
    height:29px;
}
.Value {
    horizontal-align:right;
    vertical-align:center;
    color:#ffca77;
    font-size:17px;
    font-weight:bold;
}
.Value.Ready {
    color:#a3e78f;
}
.Value.Health {
    color:#a3e78f;
}
.Value.Health.Low {
    color:#ff7777;
}
#PredCloak {
    color:#aab9c5;
}
#PredCloak.Active {
    color:#a3e78f;
}
.Hint {
    font-size:13px;
    color:#91a5b4;
    margin-top:5px;
}
.Divider {
    width:100%;
    height:1px;
    background-color:#60708066;
    margin-top:11px;
    margin-bottom:9px;
}
.Status {
    color:#e4b568;
    font-size:18px;
    font-weight:bold;
}
.Detail {
    color:#b7c7d2;
    font-size:15px;
    margin-top:4px;
}
#PredatorPanel.Armed {
    border-left:3px solid #ff6767;
    background-color:#281419f2;
}
.Armed .Status {
    color:#ff7777;
    font-size:21px;
}
.Armed .Detail {
    color:#ffd6a5;
    font-weight:bold;
}
.Armed .Hint {
    visibility:collapse;
}
.HUD_SCOREBOARD_VISIBLE #PredatorPanel,.HUD_BUYMENU_VISIBLE #PredatorPanel,.HUD_TEAMMENU_VISIBLE #PredatorPanel,.HUD_ENDOFMATCH_VISIBLE #PredatorPanel,.HUD_TEAMINTRO_VISIBLE #PredatorPanel {
    visibility:collapse;
}
