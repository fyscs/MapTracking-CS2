import { Instance } from "cs_script/point_script";

/** 别看啦，这只是个本地测试用的小脚本 **/
Instance.OnScriptInput("rename01", (inputData) => {
    const player = inputData.activator;

    if (!player || !player.IsValid()) {
        Instance.Msg("[rename_player] rename01: 未找到有效玩家实体");
        return;
    }

    player.SetEntityName("Human_Item_0001");

    const name = player.GetEntityName();
    Instance.Msg("[rename_player] rename01: 已重命名为 -> " + name);
});

Instance.OnScriptInput("rename02", (inputData) => {
    const player = inputData.activator;

    if (!player || !player.IsValid()) {
        Instance.Msg("[rename_player] rename02: 未找到有效玩家实体");
        return;
    }

    player.SetEntityName("Zombie_Item_0001");

    const name = player.GetEntityName();
    Instance.Msg("[rename_player] rename02: 已重命名为 -> " + name);
});
