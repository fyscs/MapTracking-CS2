import {Instance,Console,CSDamageFlags,CSMoveType} from 'cs_script/point_script';
// UI state only: never spends energy, changes attacks, removes a knife, or activates a skill.
const RULES151={capacity:16,plasmaCost:2,plasmaThreshold:4,plasmaCooldown:.25,jumpCooldown:2.5,suicideDelay:7};
class PredatorHudState {
  constructor(){this.energy=null;this.health=null;this.maxHealth=2500;this.plasmaUntil=0;this.jumpUntil=0;this.suicideAt=null;this.controlOff=false;this.retired=false;}
  setHealth(value,max){if(Number.isFinite(max)&&max>0)this.maxHealth=max;if(Number.isFinite(value))this.health=Math.max(0,value);}
  setEnergy(value){
    if(value===undefined||value===null||value==='')return;
    const n=Number(value);if(Number.isFinite(n))this.energy=Math.max(0,Math.min(16,n));
  }
  fired(time){this.plasmaUntil=time+RULES151.plasmaCooldown;}
  jumped(time){this.jumpUntil=time+RULES151.jumpCooldown;}
  suicide(time){if(this.suicideAt===null)this.suicideAt=time;this.controlOff=true;}
  view(time,alpha,{plasma=true,jump=true,invisible=true}={}){
    const armed=this.suicideAt!==null,energy=this.energy===null?'同步中':`${Number(this.energy.toFixed(1))} / 16`;
    const remaining=t=>Math.max(0,t-time),timer=t=>remaining(t)>0?`${remaining(t).toFixed(1)} 秒`:'就绪';
    const locked=this.controlOff||armed;
    const plasmaText=locked?'操作禁用':!plasma?'不可用':remaining(this.plasmaUntil)>0?timer(this.plasmaUntil):this.energy===null?'同步中':this.energy<4?'能量不足 · 需 4':'就绪 · 消耗 2';
    const jumpText=locked?'操作禁用':!jump?'不可用':timer(this.jumpUntil);
    const cloakKnown=Number.isFinite(alpha),cloaked=cloakKnown&&alpha<128;
    const cloakText=!cloakKnown?'待同步':cloaked?'正在生效':!invisible?'不可用':'未生效';
    const detonation=armed?Math.max(0,this.suicideAt+7-time):null;
    return {energy,health:this.health===null?'同步中':`${Math.ceil(this.health)} / ${Math.ceil(this.maxHealth)}`,healthLow:this.health!==null&&this.health<=this.maxHealth*.25,
      bars:this.energy===null?0:Math.floor(this.energy),low:this.energy!==null&&this.energy<4,
      plasma:plasmaText,plasmaReady:plasmaText.startsWith('就绪'),jump:jumpText,jumpReady:jumpText==='就绪',
      cloak:cloakText,cloaked,armed,
      status:armed?'启用自爆，操作禁用':this.controlOff?'操作禁用':'自爆：AA → DD（快速连按）',
      detail:armed?(detonation>0?`引爆倒计时 ${detonation.toFixed(1)} 秒`:'正在引爆'):'先快速双击 A，再快速双击 D'};
  }
}

const PREFIX='Zombie_Item_Predator_',records=new Map(),visible=new Set(),cache=new Map();
let hud=null,paused=false,ending=false,nextScan=0,serial=0;
const blasts=new Set(),zero=()=>({x:0,y:0,z:0});
const valid=e=>!!e?.IsValid(),now=()=>Instance.GetGameTime();
const livingT=p=>valid(p)&&p.GetClassName()==='player'&&p.IsAlive()&&p.GetTeamNumber()===2;
const unique=name=>{const all=Instance.FindEntitiesByName(name).filter(valid);return all.length===1?all[0]:null;};
const fire=(target,input,value,delay=0)=>{if(valid(target))Instance.EntFireAtTarget({target,input,value,delay});};
const PARTS=['Action_Selector','Ammo_Reload','AvailablePlasma','Cloack_On','Energy','Health','Invisible','UI','Plasma_Maker','Movement','Plasma','Jump_Sound','Jump','Jump2','Knife_Trigger','Model_Run','Model','SoundPlasma','SoundLaugh','SoundPickUp','Suicide_1','Suicide_2','Suicide_Maker'];
function disconnect(r){for(const id of r.connections)Instance.DisconnectOutput(id);r.connections=[];}
function hook(r,target,output,fn){if(valid(target)){const id=Instance.ConnectOutput(target,output,fn);if(id!==undefined)r.connections.push(id);}}
function bind(model){
  const weapon=model.GetParent();if(!valid(weapon)||!weapon.GetClassName().startsWith('weapon_knife'))return;
  if(records.has(weapon))return;
  const r={model,weapon,state:new PredatorHudState(),connections:[],owner:null,blockedOwner:null,nextPoll:0,
    energy:unique(PREFIX+'Energy'),plasma:unique(PREFIX+'Plasma'),jump:unique(PREFIX+'Jump')||unique(PREFIX+'Jump2'),
    invisible:unique(PREFIX+'Invisible'),suicide:unique(PREFIX+'Suicide_2'),ui:unique(PREFIX+'UI'),health:unique(PREFIX+'Health'),
    maker:unique(PREFIX+'Suicide_Maker'),laugh:unique(PREFIX+'SoundLaugh'),parts:PARTS.map(s=>unique(PREFIX+s)).filter(valid),job:null};
  // Normal map templates retain their exact names. Refuse ambiguous controllers instead of mixing owners.
  if(!r.energy)return;
  records.set(weapon,r);
  hook(r,r.energy,'OutValue',({value})=>r.state.setEnergy(value));
  hook(r,r.energy,'OnGetValue',({value})=>r.state.setEnergy(value));
  hook(r,r.plasma,'OnTrigger',()=>r.state.fired(now()));
  hook(r,r.jump,'OnLessThan',()=>r.state.jumped(now()));
  hook(r,r.suicide,'OnLessThan',()=>arm(r,'manual'));
  hook(r,r.health,'OnBreak',()=>arm(r,'destroyed'));
  hook(r,r.ui,'OnCase01',()=>{if(r.state.suicideAt===null)r.state.controlOff=false;});
  hook(r,r.ui,'OnCase02',()=>{r.state.controlOff=true;});
  hook(r,weapon,'OnUser4',()=>{if(r.state.suicideAt===null)r.state.retired=true;});
  fire(r.energy,'GetValue');
}
function arm(r,cause){
  if(paused)return;
  if(r.job){if(cause==='destroyed'){r.state.setHealth(0);anchorJob(r,true);killOperator(r.job);}return;}
  if(ending)return;
  if(!valid(r.model)){Instance.Msg('[PRED151] Cannot arm: model missing before activation');return;}
  const time=now(),position={...r.model.GetAbsOrigin()},angles={...r.model.GetAbsAngles()};
  const blastPosition=valid(r.maker)?{...r.maker.GetAbsOrigin()}:{...position,z:position.z+48};
  const blastAngles=valid(r.maker)?{...r.maker.GetAbsAngles()}:angles;
  r.owner=(valid(r.weapon)?r.weapon.GetOwner():null)??r.owner;
  const follow=cause==='manual'&&valid(r.owner)&&r.owner.IsAlive()&&r.owner!==r.blockedOwner;
  r.job={id:++serial,cause,position,angles,blastPosition,blastAngles,due:time+RULES151.suicideDelay,nextTry:0,done:false,owner:r.owner,slot:valid(r.owner)?r.owner.GetPlayerController()?.GetPlayerSlot():undefined,ownerLifeEnded:!valid(r.owner)||!r.owner.IsAlive(),follow};
  r.state.suicide(time);
  if(cause==='destroyed')r.state.setHealth(0);else if(valid(r.health))r.state.setHealth(r.health.GetHealth(),r.health.GetMaxHealth());
  // Bind to the original pawn so a dropped or holstered knife cannot take the statue away.
  r.model.SetParent(follow?r.owner:undefined);r.model.SetEntityName('LMS_Predator_Armed151_'+r.job.id);
  r.model.SetMoveType(CSMoveType.NONE);r.model.Teleport({position,angles,velocity:zero(),angularVelocity:zero()});
  r.model.SetColor({r:255,g:255,b:255,a:255});
  fire(r.model,'SetDefaultAnimation','roofidle2');fire(r.model,'SetAnimation','roofidle2');
  if(valid(r.laugh)){r.laugh.SetParent(r.model);fire(r.laugh,'StartSound');}
  // Original armed branch reveals the player and deactivates the artifact's input bridge.
  if(valid(r.owner))r.owner.SetColor({r:255,g:255,b:255,a:255});
  fire(r.ui,'Deactivate');
  fire(r.weapon,'ToggleCanBePickedUp'); // Original template starts with CanBePickedUp = 1.
  // Preserve the knife during countdown; destroy only the captured artifact after detonation.
  // Keep health for the HUD; it can break again without restarting this job.
  for(const e of r.parts)if(e!==r.model&&e!==r.health&&e!==r.laugh&&e!==r.maker)fire(e,'Kill',undefined,.01);
  if(valid(r.health)&&cause!=='destroyed')fire(r.health,'SetDamageFilter','filter_nothing');
  Instance.Msg('[PRED151] Armed '+JSON.stringify({id:r.job.id,cause,due:r.job.due,position}));
  if(cause==='destroyed')killOperator(r.job);
}
function killOperator(j){
  if(j.ownerLifeEnded||!valid(j.owner)||!j.owner.IsAlive())return;
  j.owner.TakeDamage({damage:Math.max(1,j.owner.GetHealth()+1),damageFlags:CSDamageFlags.FORCE_DEATH|CSDamageFlags.IGNORE_ARMOR|CSDamageFlags.SUPPRESS_DAMAGE_MODIFICATION});
}
function armInput({caller},cause){
  scan();
  // Only the exact source entity may arm its artifact; never resolve by an arbitrary player slot.
  const r=[...records.values()].find(r=>(cause==='destroyed'?r.health:r.suicide)===caller);
  if(r)arm(r,cause);else Instance.Msg('[PRED151] Arm input has no matching artifact');
}
function cleanup(r){
  disconnect(r);
  for(const e of r.parts)if(valid(e))e.Remove();
  // Do not confiscate a knife from a different/new life that picked up the spent artifact.
  if(valid(r.weapon)){const owner=r.weapon.GetOwner();if(!valid(owner)||!owner.IsAlive())r.weapon.Remove();}
  records.delete(r.weapon);
}
function capturePose(r){
  const j=r.job;
  if(!valid(r.model)||r.model.GetParent()!==j.owner)return;
  j.position={...r.model.GetAbsOrigin()};j.angles={...r.model.GetAbsAngles()};
  j.blastPosition=valid(r.maker)?{...r.maker.GetAbsOrigin()}:{...j.position,z:j.position.z+48};
  j.blastAngles=valid(r.maker)?{...r.maker.GetAbsAngles()}:{...j.angles};
}
function anchorJob(r,sample){
  const j=r.job;
  if(!j?.follow)return;
  if(sample)capturePose(r);
  j.follow=false;
  if(valid(r.model)){
    r.model.SetParent(undefined);
    r.model.Teleport({position:j.position,angles:j.angles,velocity:zero(),angularVelocity:zero()});
  }
}
function updateJob(r,time){
  const j=r.job;if(!j||j.done)return;
  if(j.follow){
    if(!valid(j.owner)||!j.owner.IsAlive()||j.owner.GetPlayerController()?.GetPlayerPawn()!==j.owner){
      anchorJob(r,false);j.ownerLifeEnded=true;
    }else capturePose(r);
  }
  if(time<j.due||time<j.nextTry)return;
  const template=unique('Spawn_Nuke_Template');
  // The original shared nuke retains its own damage, brush bounds, particles, sound and I/O.
  const made=valid(template)?template.ForceSpawn(j.blastPosition,j.blastAngles):undefined;
  if(!made?.length){j.nextTry=time+1;Instance.Msg('[PRED151] Nuke spawn failed; latched countdown retained for retry');return;}
  j.done=true;blasts.add({entities:made,until:time+3});
  // Never kill a respawned player or a new holder. The old graph targeted an unrelated relay.
  killOperator(j);
  Instance.Msg('[PRED151] Detonated '+JSON.stringify({id:j.id,cause:j.cause,time,position:j.blastPosition,spawned:made.length}));
  // Remove the statue only after the engine has spawned the nuke entities.
  cleanup(r);
}
function scan(){for(const m of Instance.FindEntitiesByName(PREFIX+'Model*'))if(valid(m)&&m.GetEntityName()===PREFIX+'Model')bind(m);}
function text(slot,id,key,value){const c=`${slot}:${id}:${key}`;if(cache.get(c)!==value){hud.SetDialogVariableStringForPlayer(slot,id,key,value);cache.set(c,value);}}
function cls(slot,id,key,value){const c=`${slot}:${id}:class:${key}`;if(cache.get(c)!==value){hud.SetHasClassForPlayer(slot,id,key,value);cache.set(c,value);}}
function hide(slot){if(valid(hud))hud.ResetForPlayer(slot);visible.delete(slot);for(const key of [...cache.keys()])if(key.startsWith(slot+':'))cache.delete(key);}
function paint(slot,v){
  text(slot,'PredEnergy','energy',v.energy);text(slot,'PredPlasma','plasma',v.plasma);text(slot,'PredJump','jump',v.jump);
  text(slot,'PredCloak','cloak',v.cloak);text(slot,'PredStatus','status',v.status);text(slot,'PredDetail','detail',v.detail);
  text(slot,'PredHealth','health',v.health);cls(slot,'PredHealth','Low',v.healthLow);
  cls(slot,'PredEnergy','Low',v.low);cls(slot,'PredPlasma','Ready',v.plasmaReady);cls(slot,'PredJump','Ready',v.jumpReady);
  cls(slot,'PredCloak','Active',v.cloaked);cls(slot,'PredatorPanel','Armed',v.armed);
  for(let i=1;i<=16;i++)cls(slot,'PredCell'+i,'Filled',i<=v.bars);
  cls(slot,'PredatorPanel','Visible',true);
}
function clear(){for(const r of [...records.values()]){if(r.job)cleanup(r);else disconnect(r);}records.clear();for(const b of blasts)for(const e of b.entities)if(valid(e))e.Remove();blasts.clear();for(const slot of [...visible])hide(slot);cache.clear();}
function tick(){
  const time=now(),seen=new Set();
  try{
    if(!valid(hud)){
      const replacement=unique('LMS_Predator_Hud151');
      if(replacement!==hud){hud=replacement;cache.clear();visible.clear();}
    }
    if(!paused){
      if(!ending&&time>=nextScan){scan();nextScan=time+.1;}
      for(const [weapon,r] of records){
        // Armed jobs survive owner death, drop/disconnect and removal of the original knife.
        if(r.job){updateJob(r,time);if(r.job.done)continue;}
        if(ending)continue;
        if(r.job===null&&(!valid(weapon)||!valid(r.model))){disconnect(r);records.delete(weapon);continue;}
        const owner=r.job?r.job.owner:weapon.GetOwner();if(owner!==r.owner){r.owner=owner;r.blockedOwner=null;}
        if(!livingT(owner)||owner===r.blockedOwner||r.state.retired)continue;
        const slot=owner.GetPlayerController()?.GetPlayerSlot();if(slot===undefined)continue;
        if(valid(r.energy)&&time>=r.nextPoll){fire(r.energy,'GetValue');r.nextPoll=time+.25;}
        if(!r.job&&valid(r.health))r.state.setHealth(r.health.GetHealth(),r.health.GetMaxHealth());
        const alpha=valid(r.model)&&typeof r.model.GetColor==='function'?r.model.GetColor()?.a:undefined;
        const v=r.state.view(time,alpha,{plasma:valid(r.plasma),jump:valid(r.jump),invisible:valid(r.invisible)});
        if(valid(hud)&&!tankOccupant173(owner)){paint(slot,v);seen.add(slot);}
      }
      for(const b of [...blasts])if(time>=b.until){for(const e of b.entities)if(valid(e)){if(e.GetClassName()==='info_particle_system')fire(e,'DestroyImmediately');fire(e,'Kill',undefined,.01);}blasts.delete(b);}
    }
    for(const slot of [...visible])if(!seen.has(slot))hide(slot);
    for(const slot of seen)visible.add(slot);
  }catch(error){for(const slot of [...visible])hide(slot);Instance.Msg('[PRED_HUD151] '+String(error));}
  finally{Instance.SetNextThink(time+.05);}
}
function resetPlayer(player,endLife=true,sample=false){for(const r of records.values())if(r.owner===player){r.blockedOwner=player;if(r.job&&endLife){anchorJob(r,sample);r.job.ownerLifeEnded=true;}}const slot=player?.GetPlayerController()?.GetPlayerSlot();if(slot!==undefined)hide(slot);}
Instance.OnActivate(()=>{hud=unique('LMS_Predator_Hud151');if(valid(hud))hud.Reset();paused=false;ending=false;nextScan=0;Instance.SetNextThink(now());});
Instance.SetThink(tick);Instance.OnScriptInput('Scan',()=>{nextScan=0;scan();});
Instance.OnScriptInput('ArmManual',input=>armInput(input,'manual'));
Instance.OnScriptInput('ArmDestroyed',input=>armInput(input,'destroyed'));
Instance.OnWeaponPickup(({weapon})=>{scan();const r=records.get(weapon);if(r)r.blockedOwner=null;});
Instance.OnWeaponDrop(()=>{Instance.SetNextThink(now());});
Instance.OnPlayerKill(({player})=>resetPlayer(player,true,true));Instance.OnPlayerReset(({player})=>resetPlayer(player));
Instance.OnPlayerTeamChanged(({player})=>{
  resetPlayer(player,false);
  // Team notification may follow pickup. Death/reset remain blocked.
  for(const r of records.values())if(!r.job&&!r.state.retired&&r.owner===player&&livingT(player))r.blockedOwner=null;
  nextScan=0;
});Instance.OnPlayerDisconnect(({playerSlot})=>{
  for(const r of records.values())if(r.job?.slot===playerSlot){anchorJob(r,false);r.job.ownerLifeEnded=true;}
  hide(playerSlot);
});
// A victory announcement must not cancel an already armed statue. Only the actual round reset does.
Instance.OnRoundEnd(()=>{ending=true;for(const slot of [...visible])hide(slot);});Instance.OnBeginRoundRestart(()=>{paused=true;clear();});
Instance.OnRoundStart(()=>{clear();paused=false;ending=false;nextScan=0;Instance.SetNextThink(now());});
Instance.OnScriptReload({before:()=>{paused=true;clear();},after:()=>{
  hud=unique('LMS_Predator_Hud151');if(valid(hud))hud.Reset();
  cache.clear();visible.clear();paused=false;ending=false;nextScan=0;Instance.SetNextThink(now());
}});
Console.RegisterCheatCommand('predator151_status',()=>Instance.Msg('[PRED_HUD151] '+JSON.stringify({visible:[...visible],records:[...records.values()].map(r=>({owner:r.owner?.GetPlayerController()?.GetPlayerSlot(),energy:r.state.energy,plasmaUntil:r.state.plasmaUntil,jumpUntil:r.state.jumpUntil,suicideAt:r.state.suicideAt,controlOff:r.state.controlOff}))})));
Console.RegisterCheatCommand('predator174_job',()=>Instance.Msg('[PRED174_JOB] '+JSON.stringify(
  [...records.values()].filter(r=>r.job).map(r=>({id:r.job.id,cause:r.job.cause,follow:r.job.follow,
    due:r.job.due,time:now(),lifeEnded:r.job.ownerLifeEnded,model:valid(r.model)?r.model.GetAbsOrigin():null,
    pawn:valid(r.job.owner)?r.job.owner.GetAbsOrigin():null,parentIsOwner:valid(r.model)&&r.model.GetParent()===r.job.owner,
    blast:r.job.blastPosition})))));

// Read-only: explains a hidden panel without changing artifact ownership/lifecycle.
function auditPredator163(){
  const describe=e=>!valid(e)?null:{name:e.GetEntityName(),cls:e.GetClassName()};
  const owners=[...records.values()].map(r=>({model:describe(r.model),weapon:describe(r.weapon),owner:describe(r.owner),team:valid(r.owner)?r.owner.GetTeamNumber():null,alive:valid(r.owner)?r.owner.IsAlive():false,blocked:r.owner===r.blockedOwner,retired:r.state.retired,armed:!!r.job}));
  const models=Instance.FindEntitiesByName(PREFIX+'Model*').filter(valid).map(e=>({entity:describe(e),parent:describe(e.GetParent())}));
  const names=['LMS_Predator_Hud_Manager151','LMS_Predator_Hud151',PREFIX+'Energy',PREFIX+'Knife',PREFIX+'UI'];
  const found=Object.fromEntries(names.map(n=>[n,Instance.FindEntitiesByName(n).filter(valid).map(describe)]));
  Instance.Msg('[LMS_DEPLOY163_PREDATOR] '+JSON.stringify({map:Instance.GetMapName(),paused,ending,visible:[...visible],hud:describe(hud),hudSetters:valid(hud)&&typeof hud.SetHasClassForPlayer==='function'&&typeof hud.SetDialogVariableStringForPlayer==='function',found,models,owners,clientPixelsVerified:false}));
}
Console.RegisterCheatCommand('predator_deploy_audit163',auditPredator163);
