import { Instance, CSInputs } from "cs_script/point_script";

let Game_Text_Ent = null;

function GetGameTextEnt() 
{
    if(!Game_Text_Ent) 
    {
        Game_Text_Ent = Instance.FindEntityByName("custom_hud");
    }
    return Game_Text_Ent;
}

Instance.SetNextThink(Instance.GetGameTime());

Instance.OnScriptInput("Text_reset", () => {
    const hud = GetGameTextEnt();
    hud.SetDialogVariableString("game_text_id","text","");
});

