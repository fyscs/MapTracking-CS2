// s2ts v0.6.1 (精简修复版) - 增加 !setarm 指令
import { Instance, CSPlayerPawn } from 'cs_script/point_script';

// ---------- 工具函数 ----------
const utils = {
    printl(a) { Instance.Msg(a); },
    command(a, delay = 0.00) { this.EntFire("server", "Command", a, delay); },
    EntFire(name = "", input = "", value = "", delay = 0.0, caller = undefined, activator = undefined) {
        Instance.EntFireAtName({ name, input, value, delay, caller, activator });
    },
    EntFireByHandle(target, input = "", value = "", delay = 0.0, caller = undefined, activator = undefined) {
        if (target == undefined) return;
        Instance.EntFireAtTarget({ target, input, value, delay, caller, activator });
    },
    GetRandomIntBetween(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; },
    SplitString(a, divide) { return a.split(divide); },
};

// ---------- 常量 ----------
const ttick = 0.015625;
const tips = [
    "指令成功执行",
    "tips: !setmodel <@me/@all> <模型路径> //切换人物模型",
];
const tips_delay = 60;
const C = { ttick, tips, tips_delay };

// ---------- 延时系统 ----------
const onTicks = [];
let delayActions = [];
function tickCallback() {
    for (const cb of onTicks) cb();
    delayActions = delayActions.filter(act => {
        if (act.targetTime > Instance.GetGameTime()) return true;
        act.resolve();
        return false;
    });
}
function delay(seconds) {
    const targetTime = Instance.GetGameTime() + seconds;
    return new Promise(resolve => delayActions.push({ targetTime, resolve }));
}

// ---------- 异步辅助 ----------
var __awaiter = (undefined && undefined.__awaiter) || function (thisArg, _arguments, P, generator) {
    function adopt(value) { return value instanceof P ? value : new P(function (resolve) { resolve(value); }); }
    return new (P || (P = Promise))(function (resolve, reject) {
        function fulfilled(value) { try { step(generator.next(value)); } catch (e) { reject(e); } }
        function rejected(value) { try { step(generator["throw"](value)); } catch (e) { reject(e); } }
        function step(result) { result.done ? resolve(result.value) : adopt(result.value).then(fulfilled, rejected); }
        step((generator = generator.apply(thisArg, _arguments || [])).next());
    });
};

// ---------- 玩家类 ----------
class Player {
    constructor(id) {
        this.id = id;
        this.controller = undefined;
        this.pawn = undefined;
        this.model = "";
    }

    updateController() { this.controller = Instance.GetPlayerController(this.id); }
    getController() { this.updateController(); return this.controller; }

    updatePawn() { this.pawn = this.getController()?.GetPlayerPawn(); }
    getPawn() { this.updatePawn(); return this.pawn; }

    updateModel(params) { this.model = params; }
    getModel() { return this.model; }

    setModel() {
        const pawn = this.getPawn();
        if (pawn) pawn.SetModel(this.model);
    }

    onPlayerReset() {
        switch (this.getController()?.GetTeamNumber()) {
            case 2:
                this.updateModel("characters/models/tm_phoenix/tm_phoenix.vmdl");
                break;
            case 3:
                this.updateModel("characters/models/ctm_sas/ctm_sas.vmdl");
                break;
        }
    }
}

// ---------- 全局玩家列表 ----------
const players = [];

function initializePlayerSystem() {
    for (let j = 0; j <= 64; j++) {
        if (!Instance.GetPlayerController(j)) continue;
        if (!players[j]) players[j] = new Player(j);
        players[j]?.onPlayerReset();
    }
}

// ========== 聊天指令 ==========
Instance.OnPlayerChat((event) => {
    const text = event.text;
    const activatorId = event.player?.GetPlayerSlot();
    if (activatorId === undefined) return;

    const arr = utils.SplitString(text, " ");

    // ---------- 新增指令：!setarm ----------
    if (arr[0] === "!setarm") {
        if (arr[2] === undefined || arr[2] === "" || arr.length !== 3) {
            tips_screen("用法: !setarm <@me/@all> <手臂模型路径>");
            tips_chat("用法: !setarm <@me/@all> <手臂模型路径>");
            return;
        }

        switch (arr[1]) {
            case "@me":
                if (players[activatorId]) {
                    const pawn = players[activatorId].getPawn();
                    if (pawn) {
                        pawn.SetArmModel(arr[2]);
                        tips_screen("手臂模型已更换");
                        tips_chat("手臂模型已更换");
                    }
                }
                break;
            case "@all":
                for (let j = 0; j <= 64; j++) {
                    if (!Instance.GetPlayerController(j)) continue;
                    if (players[j]) {
                        const pawn = players[j].getPawn();
                        if (pawn) {
                            pawn.SetArmModel(arr[2]);
                        }
                    }
                }
                tips_screen("已为所有玩家更换手臂模型");
                tips_chat("已为所有玩家更换手臂模型");
                break;
            default:
                tips_screen("用法: !setarm <@me/@all> <手臂模型路径>");
                tips_chat("用法: !setarm <@me/@all> <手臂模型路径>");
                return;
        }
        return; // 防止继续处理下面的 !setmodel
    }

    // ---------- 原有指令：!setmodel ----------
    if (arr[0] === "!setmodel") {
        if (arr[2] === undefined || arr[2] === "" || arr.length !== 3) {
            tips_screen(C.tips[1]);
            tips_chat(C.tips[1]);
            return;
        }

        switch (arr[1]) {
            case "@me":
                if (players[activatorId]) {
                    players[activatorId].updateModel(arr[2]);
                    players[activatorId].setModel();
                }
                break;
            case "@all":
                for (let j = 0; j <= 64; j++) {
                    if (!Instance.GetPlayerController(j)) continue;
                    if (players[j]) {
                        players[j].updateModel(arr[2]);
                        players[j].setModel();
                    }
                }
                break;
            default:
                tips_screen(C.tips[1]);
                tips_chat(C.tips[1]);
                return;
        }
        tips_screen(C.tips[0]);
        tips_chat(C.tips[0]);
    }
});

// ========== Tips 显示与定时广播 ==========
function tips_screen(info) {
    Instance.DebugScreenText({
        text: info,
        x: 1,
        y: 972,
        duration: 5.0,
        color: { r: 255, g: 0, b: 0, a: 255 }
    });
}

function tips_chat(info) {
    utils.command("say " + info?.toString(), C.ttick * 20);
}

function ads_broadcast() {
    return __awaiter(this, void 0, void 0, function* () {
        yield delay(C.tips_delay);
        const num = utils.GetRandomIntBetween(1, C.tips.length - 1);
        tips_chat(C.tips[num]);
        tips_screen(C.tips[num]);
        ads_broadcast();
    });
}

// ---------- 生命周期事件 ----------
Instance.OnScriptReload({
    after: () => {
        utils.printl("模型脚本重载");
        initializePlayerSystem();
    },
});

Instance.OnRoundStart(() => {
    players.length = 0;
    initializePlayerSystem();
});

Instance.OnPlayerReset(({ player }) => {
    const j = player.GetPlayerController()?.GetPlayerSlot();
    if (j === undefined || !Instance.GetPlayerController(j)) return;
    if (!players[j]) players[j] = new Player(j);
    players[j]?.onPlayerReset();
});

Instance.OnPlayerDisconnect((event) => {
    const slot = event.playerSlot;
    players[slot] = undefined;
});

// ---------- 启动 ----------
Instance.Msg("精简修复版模型更换脚本已加载（含 !setarm 支持）");
initializePlayerSystem();
ads_broadcast();

Instance.SetThink(() => {
    tickCallback();
    Instance.SetNextThink(Instance.GetGameTime() + 1.0 / 128);
});
Instance.SetNextThink(Instance.GetGameTime());