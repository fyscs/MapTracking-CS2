import { Instance } from "cs_script/point_script";

Instance.OnScriptInput("SetLeaderContext", (_input) => {
    let players = Instance.GetAllPlayerControllers();
    if (!players || players.length === 0) {
        return;
    }

    for (let p of players) {
        let pawn = p.GetPlayerPawn();
        if (pawn) {
            Instance.EntFireAtTarget({ target: "!Activator", input: "RemoveContext", value: "leader" });
        }
    }
    let topPlayer = null;
    let maxScore = -1;
    for (let p of players) {
        let score = p.GetScore();
        if (score > maxScore) {
            maxScore = score;
            topPlayer = p;
        }
    }

    if (topPlayer) {
        let pawn = topPlayer.GetPlayerPawn();
        if (pawn) {
            Instance.EntFireAtTarget({ 
                target: "!Activator", 
                input: "AddContext", 
                value: "leader:1"
            });
        }

        Instance.EntFireAtName({ 
            name: "axe_weapon", 
            input: "FireUser1", 
            activator: topPlayer.GetPlayerPawn() 
        });
        Instance.EntFireAtName({ 
            name: "axe_ui", 
            input: "Activate", 
            activator: topPlayer
        });
    }
});