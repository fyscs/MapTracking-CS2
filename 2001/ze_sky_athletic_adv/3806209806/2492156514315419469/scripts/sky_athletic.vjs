];

// General
Instance.OnRoundStart(() => {
	Console.Log(`[SAScript] RoundStart`);

	if(!script_ent?.IsValid())
		script_ent = Instance.FindEntityByName(script_ent_name);

	if(!counter_ent?.IsValid())
		counter_ent = Instance.FindEntityByName(counter_ent_name);

	if(!dest_ent?.IsValid())
		dest_ent = Instance.FindEntityByName(dest_ent_name);

	Instance.ConnectOutput(counter_ent, "OutValue", ({ value }) => {
		const i_value = Math.trunc(Number(value));

		if (!Number.isFinite(i_value) || i_value <= 0 || i_value > 8)
			return;

		level = i_value;
		if (i_value === 8)
			rtv_count = 3;
	});

	Instance.EntFireAtName({ name: "lr_warn", input: "CancelPending" });
	ResetLayer();
});

// Input
Instance.OnScriptInput("SpawnTele", (event) => {
	const client = event.activator;

	if (!(client instanceof CSPlayerPawn))
        return;

	const value = Math.floor(Math.random() * spawntele_pos.length);
	const dest = spawntele_pos[value];

	client.Teleport({ position: dest, angles: { pitch: 0, yaw: 90, roll: 0 } });
});

Instance.OnScriptInput("StripKnife", (event) => {
	const client = event.activator;
	client.DestroyWeapon(client.FindWeaponBySlot(CSGearSlot.KNIFE));
});

Instance.OnScriptInput("LayerLoadUnload", () => {
	const nowstage = stage;
	Instance.EntFireAtName({ name: "wl_stage" + nowstage, input: "FireUser1" });
	if (![1, 2, 8, 9, 15, 16, 18, 19, 22, 23, 24, 25].includes(nowstage))
		Instance.EntFireAtName({ name: "wl_stage" + (nowstage - 2), input: "FireUser2" });

	stage++;
});

Instance.OnScriptInput("EndRTV", () => {
	rtv_count = 0;
});

Instance.OnScriptInput("Lv8Stuck1", (event) => {
	const client = event.activator;

	if (!(client instanceof CSPlayerPawn))
        return;

	client.Teleport({ position: { x: 10970, y: -4868, z: -1224 }, angles: { pitch: 0, yaw: 90, roll: 0 } });
});

