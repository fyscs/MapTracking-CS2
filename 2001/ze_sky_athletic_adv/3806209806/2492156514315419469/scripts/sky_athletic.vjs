function SpawnItems() {
	const ent_heal = Instance.FindEntityByName("health template2");
	const ent_bheal = Instance.FindEntityByName("health template");
	const ent_burn = Instance.FindEntityByName("burning template");
	const ent_push = Instance.FindEntityByName("push template");
	const ent_cold = Instance.FindEntityByName("cold template");

	if (level === 2)
	{
		ent_bheal.ForceSpawn({ x: 10978, y: -2576, z: -1237 });
		ent_burn.ForceSpawn({ x: 8139, y: -4492, z: -1375 });
