import { Instance, CSPlayerPawn, CSGearSlot, Console } from "cs_script/point_script";

const script_ent_name = "ps_script";
let script_ent = null;
const counter_ent_name = "mc_level";
let counter_ent = null;
const dest_ent_name = "tdes2";
let dest_ent = null;

let level = 0;
let rtv_count = 3;
let stage = 1;

const spawntele_pos = [
	{ x: 11135,  y: -12547,  z: -15350 },
    { x: 10944,  y: -12547,  z: -15350 },
    { x: 11008,  y: -12547,  z: -15350 },
