// Function
function ResetLayer() {
	for (let i = 1; i < 26; i++) {
		Instance.EntFireAtName({ name: "wl_stage" + i, input: "FireUser2", delay: i * 0.05 });
	}

	if (level > 0 && (level !== 8 || rtv_count > 0))
	{
		Instance.EntFireAtName({ name: "spawn_teleport", input: "Enable" });
		Instance.EntFireAtName({ name: "fog", input: "SetFarZ", value: "7000" });
	}
	StartLevel();
}

