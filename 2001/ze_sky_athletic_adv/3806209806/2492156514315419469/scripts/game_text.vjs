import { CustomHudLayout, Entity, Instance } from "cs_script/point_script";

const LAYOUT_NAME = "game_text_layout";
const CHANNEL_COUNT = 4;
const STYLES = [ "StyleDefault", "StyleInfo", "StyleWarning", "StyleSuccess", "StyleDanger",
					"StyleLarge", "StyleSmall", "Stylelightblue", "Stylepink", "Styleblue" ];

// General
Instance.OnScriptInput("HideAll", () => HideAllGameText());

Instance.OnPlayerDisconnect(({ playerSlot }) => {
	playerVersions.delete(playerSlot);
	playerPositionOverrides.delete(playerSlot);
});

Instance.OnPlayerActivate(({ player }) => {
	const layout = getLayout();
	if (!layout) return;
	const playerSlot = player.GetPlayerSlot();
	playerVersions.delete(playerSlot);
	for (let channel = 1; channel <= CHANNEL_COUNT; channel++) {
		clearPlayerOverridesForChannel(layout, playerSlot, channel);
	}
});

// game_text
Instance.OnScriptInput("call_test", () => {
	ShowGameText({
		text: "game_text test",
		channel: 1,
		duration: 3,
		posX: 0.5,
		posY: 0.13,
		style: "StyleDefault",
	});
});

