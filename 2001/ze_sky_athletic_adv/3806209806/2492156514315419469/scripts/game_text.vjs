// overlay
Instance.OnScriptInput("crasher_overlay", async () => {
	const layout = getLayout();
	if (!layout) return;

	const version = ++imageVersion;
	layout.SetHasClass("crasher_overlay", "ImageHidden", false);

	await Instance.Delay(1);
	if (imageVersion !== version) return;

	layout.SetHasClass("crasher_overlay", "ImageHidden", true);
});

// Function
/** @type {CustomHudLayout | undefined} */
let cachedLayout;
const allPlayerVersions = [0, 0, 0, 0];
let imageVersion = 0;
/** @type {Map<number, number[]>} */
const playerVersions = new Map();
const globalPositionClasses = Array.from({ length: CHANNEL_COUNT }, () => ({ x: "PositionX050", y: "PositionY050" }));
/** @type {Map<number, Map<number, { x: Set<string>, y: Set<string> }>>} */
const playerPositionOverrides = new Map();

function getLayout() {
	if (!(cachedLayout instanceof Entity) || !cachedLayout.IsValid()) {
		const entity = Instance.FindEntityByName(LAYOUT_NAME);
		if (!(entity instanceof CustomHudLayout)) {
			Instance.Msg(`[game_text] custom_hud_layout '${LAYOUT_NAME}' was not found.`);
			return undefined;
		}
		cachedLayout = entity;
	}
	return cachedLayout;
}

/**
 * @param {number} channel
 */
function clampChannel(channel) {
	return Math.max(1, Math.min(CHANNEL_COUNT, Math.trunc(channel || 1)));
}

function normalizeDuration(duration) {
	return Math.max(0.1, Number.isFinite(duration) ? duration : 3);
}

function versionsForPlayer(playerSlot) {
	let versions = playerVersions.get(playerSlot);
	if (!versions) {
		versions = [0, 0, 0, 0];
		playerVersions.set(playerSlot, versions);
	}
	return versions;
}

function setClass(layout, playerSlot, panelId, className, enabled) {
	if (playerSlot === undefined) {
		layout.SetHasClass(panelId, className, enabled);
	} else {
		layout.SetHasClassForPlayer(playerSlot, panelId, className, enabled);
	}
}

function setMessage(layout, playerSlot, labelId, text) {
	if (playerSlot === undefined) {
		layout.SetDialogVariableString(labelId, "message", text);
	} else {
		layout.SetDialogVariableStringForPlayer(playerSlot, labelId, "message", text);
	}
}

function applyPreset(layout, playerSlot, panelId, style) {
	for (const className of STYLES) {
		setClass(layout, playerSlot, panelId, className, className === style);
	}
}

function positionClass(axis, value) {
	if (!Number.isFinite(value))
		throw new TypeError(`HUD ${axis} position must be a finite number`);
	const step = Math.round(Math.max(0, Math.min(1, value)) * 100);
	return `Position${axis}${String(step).padStart(3, "0")}`;
}

function spacerIds(channel, axis) {
	const sides = axis === "x" ? ["left", "right"] : ["top", "bottom"];
	return sides.map(side => `channel${channel}_${side}_spacer`);
}

function clearPositionOverrides(layout, playerSlot, channel) {
	const channels = playerPositionOverrides.get(playerSlot);
	const applied = channels?.get(channel);
	if (!applied) return;
	for (const axis of ["x", "y"]) {
		for (const panelId of spacerIds(channel, axis)) {
			for (const className of applied[axis])
				layout.SetHasClassForPlayer(playerSlot, panelId, className);
		}
	}
	channels.delete(channel);
	if (channels.size === 0) playerPositionOverrides.delete(playerSlot);
}

function setPosition(layout, playerSlot, channel, posX, posY) {
	const next = { x: positionClass("X", posX), y: positionClass("Y", posY) };
	const global = globalPositionClasses[channel - 1];
	if (playerSlot === undefined) {
		for (const axis of ["x", "y"]) {
			if (global[axis] === next[axis]) continue;
			for (const panelId of spacerIds(channel, axis)) {
				layout.SetHasClass(panelId, global[axis], false);
				layout.SetHasClass(panelId, next[axis], true);
			}
			global[axis] = next[axis];
		}
		return;
	}

	clearPositionOverrides(layout, playerSlot, channel);
	const applied = { x: new Set([global.x, next.x]), y: new Set([global.y, next.y]) };
	for (const axis of ["x", "y"]) {
		for (const panelId of spacerIds(channel, axis)) {
			layout.SetHasClassForPlayer(playerSlot, panelId, global[axis], false);
			layout.SetHasClassForPlayer(playerSlot, panelId, next[axis], true);
		}
	}
	let channels = playerPositionOverrides.get(playerSlot);
	if (!channels) {
		channels = new Map();
		playerPositionOverrides.set(playerSlot, channels);
	}
	channels.set(channel, applied);
}

function clearPlayerOverridesForChannel(layout, playerSlot, channel) {
	const panelId = `channel${channel}`;
	layout.SetHasClassForPlayer(playerSlot, panelId, "Hidden");
	clearPositionOverrides(layout, playerSlot, channel);
	for (const className of STYLES) {
		layout.SetHasClassForPlayer(playerSlot, panelId, className);
	}
	layout.SetDialogVariableStringForPlayer(playerSlot, `${panelId}_text`, "message");
}

function clearAllPlayerOverridesForChannel(layout, channel) {
	for (const player of Instance.GetAllPlayerControllers()) {
		if (!player.IsConnected()) continue;
		const slot = player.GetPlayerSlot();
		versionsForPlayer(slot)[channel - 1]++;
		clearPlayerOverridesForChannel(layout, slot, channel);
	}
}

/**
 * @param {{
 *   text: string,
 *   playerSlot?: number,
 *   channel?: number,
 *   duration?: number,
 *   posX?: number, // 0 = left, 1 = right; 0.01 increments
 *   posY?: number, // 0 = top, 1 = bottom; 0.01 increments
 *   style?: "StyleDefault" | "StyleInfo" | "StyleWarning" | "StyleSuccess" | "StyleDanger" | "StyleLarge" | "StyleSmall" | "Stylelightblue" | "Stylepink" | "Styleblue"
 * }} config
 */
export async function ShowGameText(config) {
	const layout = getLayout();
	if (!layout) return;

	const channel = clampChannel(config.channel ?? 1);
	const channelIndex = channel - 1;
	const panelId = `channel${channel}`;
	const labelId = `${panelId}_text`;
	const playerSlot = config.playerSlot;
	const posX = config.posX ?? 0.5;
	const posY = config.posY ?? 0.5;
	const style = STYLES.includes(config.style ?? "") ? config.style : "StyleDefault";
	const duration = normalizeDuration(config.duration ?? 3);
	const versions = playerSlot === undefined ? allPlayerVersions : versionsForPlayer(playerSlot);
	const version = ++versions[channelIndex];

	if (playerSlot === undefined) {
		clearAllPlayerOverridesForChannel(layout, channel);
	}

	setClass(layout, playerSlot, panelId, "Hidden", true);
	setMessage(layout, playerSlot, labelId, String(config.text ?? ""));
	setPosition(layout, playerSlot, channel, posX, posY);
	applyPreset(layout, playerSlot, panelId, style);

	await Instance.Delay(0.05);
	if (versions[channelIndex] !== version) return;
	setClass(layout, playerSlot, panelId, "Hidden", false);

	await Instance.Delay(duration);
	if (versions[channelIndex] !== version) return;
	setClass(layout, playerSlot, panelId, "Hidden", true);
}

/** @param {number} [playerSlot] */
export function HideAllGameText(playerSlot) {
	const layout = getLayout();
	if (!layout) return;
	const versions = playerSlot === undefined ? allPlayerVersions : versionsForPlayer(playerSlot);

	for (let index = 0; index < CHANNEL_COUNT; index++) {
		versions[index]++;
		if (playerSlot === undefined) {
			clearAllPlayerOverridesForChannel(layout, index + 1);
		}
		setClass(layout, playerSlot, `channel${index + 1}`, "Hidden", true);
	}
}
