.Root {
    width: 100%;
    height: 100%;
}
.CinematicContainer {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    background-color: #000000FF;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}
.CinematicContainer.Hidden {
    opacity: 0.0;
}
.CinematicImage {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    opacity: 0.0;
    transform: translate3d(0px, 0px, 0px);
    transition-property: opacity, transform;
    transition-duration: 0.5s, 0.04s;
    transition-timing-function: ease-out, linear;
}
#cinematic_image_01.CinematicImageVisible,#cinematic_image_02.CinematicImageVisible,#cinematic_image_03.CinematicImageVisible,#cinematic_image_04.CinematicImageVisible,#cinematic_image_05.CinematicImageVisible {
    opacity: 1.0;
}
.CinematicImage.ShakeLeft {
    transform: translate3d(-8px, 0px, 0px);
}
.CinematicImage.ShakeRight {
    transform: translate3d(8px, 0px, 0px);
}
.CinematicImage.ShakeUp {
    transform: translate3d(0px, -8px, 0px);
}
.CinematicImage.ShakeDown {
    transform: translate3d(0px, 8px, 0px);
}
.CinematicImage.ShakeUpLeft {
    transform: translate3d(-8px, -8px, 0px);
}
.CinematicImage.ShakeUpRight {
    transform: translate3d(8px, -8px, 0px);
}
.CinematicImage.ShakeDownLeft {
    transform: translate3d(-8px, 8px, 0px);
}
.CinematicImage.ShakeDownRight {
    transform: translate3d(8px, 8px, 0px);
}
.CinematicLetterbox {
    width: 100%;
    height: 100px;
    background-color: #000000FF;
    horizontal-align: center;
}
.CinematicLetterboxTop {
    vertical-align: top;
}
.CinematicLetterboxBottom {
    vertical-align: bottom;
}
.CinematicDialogue {
    width: 100%;
    height: 180px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 100px;
    flow-children: down;
    background-color: gradient( linear, 0% 0%, 0% 100%, from(rgba(0, 0, 0, 0.15)), color-stop(0.25, rgba(0, 0, 0, 0.55)), color-stop(1.0, rgba(0, 0, 0, 0.80)) );
}
.CinematicDialogue.Hidden {
    visibility: collapse;
}
.CinematicDialogue.Visible {
    visibility: visible;
}
.CinematicCharacterName {
    horizontal-align: center;
    font-size: 24px;
    font-weight: bold;
    color: #FFD98A;
    text-shadow: 0px 2px 4px #000000, 0px 0px 6px #000000;
}
.CinematicDialogueDivider {
    width: 420px;
    height: 1px;
    horizontal-align: center;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(rgba(115, 152, 181, 0)), color-stop(0.5, rgba(183, 217, 242, 0.8)), to(rgba(115, 152, 181, 0)) );
}
.CinematicDialogueText {
    horizontal-align: center;
    margin-top: 8px;
    font-size: 36px;
    font-weight: bold;
    color: white;
    text-align: center;
    text-shadow: 0px 2px 4px #000000, 0px 0px 8px #000000;
}
.CinematicLogOverlay {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    background-color: #000000B8;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
.CinematicLogOverlay.Hidden {
    opacity: 0.0;
    visibility: collapse;
}
.CinematicLogPanel {
    width: 1160px;
    height: 620px;
    horizontal-align: center;
    vertical-align: center;
    border: 0px;
    border-radius: 0px;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(rgba(16, 24, 32, 0)), color-stop(0.07, rgba(16, 24, 32, 0.72)), color-stop(0.93, rgba(16, 24, 32, 0.72)), to(rgba(16, 24, 32, 0)) );
    padding: 40px 55px;
    flow-children: down;
}
.CinematicLogTitle {
    width: 100%;
    horizontal-align: center;
    font-size: 30px;
    font-weight: bold;
    color: #E4E8EC;
    text-align: center;
    text-shadow: 0px 2px 4px #000000;
}
.CinematicLogDivider {
    width: 100%;
    height: 1px;
    horizontal-align: center;
    margin-top: 20px;
    margin-bottom: 28px;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(rgba(115, 152, 181, 0)), color-stop(0.5, rgba(183, 217, 242, 0.8)), to(rgba(115, 152, 181, 0)) );
}
.CinematicLogViewport {
    width: 100%;
    height: fill-parent-flow(1.0);
    overflow: clip;
}
.CinematicLogText {
    width: 100%;
    height: fit-children;
    font-size: 22px;
    font-weight: normal;
    color: #E1E5E9;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    text-shadow: 0px 1px 3px #000000;
    transform: translate3d(0px, 0px, 0px);
    transition-property: transform, opacity;
    transition-duration: 2.0s, 0.2s;
    transition-timing-function: linear, ease-out;
}
