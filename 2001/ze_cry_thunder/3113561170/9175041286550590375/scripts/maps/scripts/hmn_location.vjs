// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";


/* =========================================================
   Location HUD
   ========================================================= */

let locationHud = null;


/* =========================================================
   ロケーション登場SE
   ========================================================= */

// マップ側に配置するambient_genericの名前
const LOCATION_SOUND_NAME = "location_pip";


/* =========================================================
   ロケーション定義
   ========================================================= */


// ----------------------------------------------
// Location 01
// ----------------------------------------------

const LOCATION_01_TITLE =
    "THE NAMELESS BRIDGE";

const LOCATION_01_TEXT =
    "- 名も無き大橋 -";


// ----------------------------------------------
// Location 02
// ----------------------------------------------

const LOCATION_02_TITLE =
    "SAMPLE";

const LOCATION_02_TEXT =
    "- 名前 -";


// ----------------------------------------------
// Location 03
// ----------------------------------------------

const LOCATION_03_TITLE =
    "SAMPLE";

const LOCATION_03_TEXT =
    "- 名前 -";


/* =========================================================
   表示時間設定
   ========================================================= */

// HUD表示開始後、登場SEを鳴らすまで
const INITIAL_DELAY = 0.05;

// 日本語ロケーション名を表示するまで
const TEXT_DELAY = 0.45;

// 日本語名表示後、ラインを表示するまで
const LINE_DELAY = 0.25;

// ライン表示後、英語名を表示するまで
const TITLE_DELAY = 0.20;


/* =========================================================
   退場時間設定
   ========================================================= */

// 英語名を消してからラインを消すまで
const EXIT_LINE_DELAY = 0.10;

// ラインを消してから日本語名を消すまで
const EXIT_TEXT_DELAY = 0.12;

// 日本語名を消してからHUD全体を消すまで
const EXIT_CONTAINER_DELAY = 0.25;


/* =========================================================
   完全表示時間
   ========================================================= */

// 全要素が表示された後、その状態を維持する時間
const DISPLAY_TIME = 3.0;


/* =========================================================
   ロケーション再生セッション
   ========================================================= */

let locationSession = 0;


/* =========================================================
   HUD取得
   ========================================================= */

function GetLocationHud()
{
    if (
        locationHud !== null &&
        locationHud.IsValid()
    )
    {
        return locationHud;
    }


    const entities =
        Instance.FindEntitiesByName(
            "hmn_location_hud"
        );


    if (
        !entities ||
        entities.length === 0
    )
    {
        Instance.Msg(
            "ERROR: hmn_location_hud not found"
        );

        return null;
    }


    locationHud = entities[0];

    return locationHud;
}


/* =========================================================
   全プレイヤー取得
   ========================================================= */

function GetPlayers()
{
    return Instance.GetAllPlayerControllers();
}


/* =========================================================
   ロケーション登場SE
   ========================================================= */

function PlayLocationPip()
{
    // マップ上のlocation_pipを取得
    const sound =
        Instance.FindEntityByName(
            LOCATION_SOUND_NAME
        );


    // 音用Entityが存在しない場合
    if (!sound)
    {
        Instance.Msg(
            "ERROR: location_pip not found"
        );

        return;
    }


    // ambient_genericを再生
    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}


/* =========================================================
   1人のプレイヤーに表示
   ========================================================= */

function ShowLocationForPlayer(
    playerSlot,
    title,
    text
)
{
    const hud = GetLocationHud();

    if (!hud)
    {
        return;
    }


    /* -----------------------------------------------------
       表示前に各要素を非表示へ戻す
       ----------------------------------------------------- */

    hud.SetHasClassForPlayer(
        playerSlot,
        "location_text",
        "DialogueHidden",
        true
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "location_line",
        "DialogueHidden",
        true
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "location_title",
        "DialogueHidden",
        true
    );


    /* -----------------------------------------------------
       ロケーション名を設定
       ----------------------------------------------------- */

    // 英語
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "location_title",
        "location_title",
        title
    );


    // 日本語
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "location_text",
        "location_text",
        text
    );


    /* -----------------------------------------------------
       HUD表示開始
       ----------------------------------------------------- */

    hud.SetHasClassForPlayer(
        playerSlot,
        "location_container",
        "Hidden",
        false
    );
}


/* =========================================================
   全プレイヤーに表示
   ========================================================= */

async function ShowLocationForAllPlayers(
    title,
    text
)
{
    /* -----------------------------------------------------
       新しい表示セッション
       ----------------------------------------------------- */

    locationSession++;

    const mySession =
        locationSession;


    /* -----------------------------------------------------
       全員にHUDを表示
       ----------------------------------------------------- */

    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        ShowLocationForPlayer(
            playerSlot,
            title,
            text
        );
    }


    /* -----------------------------------------------------
       エンブレムの代わりに
       ロケーション登場SEを再生
       ----------------------------------------------------- */

    await Instance.Delay(
        INITIAL_DELAY
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    PlayLocationPip();


    /* -----------------------------------------------------
       日本語ロケーション名
       ----------------------------------------------------- */

    await Instance.Delay(
        TEXT_DELAY
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_text",
            "DialogueHidden",
            false
        );
    }


    /* -----------------------------------------------------
       ライン
       ----------------------------------------------------- */

    await Instance.Delay(
        LINE_DELAY
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_line",
            "DialogueHidden",
            false
        );
    }


    /* -----------------------------------------------------
       英語ロケーション名
       ----------------------------------------------------- */

    await Instance.Delay(
        TITLE_DELAY
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_title",
            "DialogueHidden",
            false
        );
    }


    /* -----------------------------------------------------
       完全表示状態を維持
       ----------------------------------------------------- */

    await Instance.Delay(
        DISPLAY_TIME
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    /* -----------------------------------------------------
       英語名を消す
       ----------------------------------------------------- */

    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_title",
            "DialogueHidden",
            true
        );
    }


    await Instance.Delay(
        EXIT_LINE_DELAY
    );


    /* -----------------------------------------------------
       ラインを消す
       ----------------------------------------------------- */

    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_line",
            "DialogueHidden",
            true
        );
    }


    await Instance.Delay(
        EXIT_TEXT_DELAY
    );


    /* -----------------------------------------------------
       日本語名を消す
       ----------------------------------------------------- */

    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        const hud =
            GetLocationHud();


        if (!hud)
        {
            continue;
        }


        hud.SetHasClassForPlayer(
            playerSlot,
            "location_text",
            "DialogueHidden",
            true
        );
    }


    await Instance.Delay(
        EXIT_CONTAINER_DELAY
    );


    if (
        mySession !==
        locationSession
    )
    {
        return;
    }


    /* -----------------------------------------------------
       HUD全体を非表示
       ----------------------------------------------------- */

    HideLocationForAllPlayers();
}


/* =========================================================
   1人のHUDを非表示
   ========================================================= */

function HideLocationForPlayer(
    playerSlot
)
{
    const hud =
        GetLocationHud();


    if (!hud)
    {
        return;
    }


    // 日本語名
    hud.SetHasClassForPlayer(
        playerSlot,
        "location_text",
        "DialogueHidden",
        true
    );


    // ライン
    hud.SetHasClassForPlayer(
        playerSlot,
        "location_line",
        "DialogueHidden",
        true
    );


    // 英語名
    hud.SetHasClassForPlayer(
        playerSlot,
        "location_title",
        "DialogueHidden",
        true
    );


    // HUD全体
    hud.SetHasClassForPlayer(
        playerSlot,
        "location_container",
        "Hidden",
        true
    );
}


/* =========================================================
   全プレイヤーのHUDを非表示
   ========================================================= */

function HideLocationForAllPlayers()
{
    for (const controller of GetPlayers())
    {
        if (!controller)
        {
            continue;
        }


        const playerSlot =
            controller.GetPlayerSlot();


        HideLocationForPlayer(
            playerSlot
        );
    }
}


/* =========================================================
   Hammer → RunScriptInput
   ========================================================= */


// ----------------------------------------------
// Location 01
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowLocation01",
    () =>
    {
        ShowLocationForAllPlayers(
            LOCATION_01_TITLE,
            LOCATION_01_TEXT
        );
    }
);


// ----------------------------------------------
// Location 02
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowLocation02",
    () =>
    {
        ShowLocationForAllPlayers(
            LOCATION_02_TITLE,
            LOCATION_02_TEXT
        );
    }
);


// ----------------------------------------------
// Location 03
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowLocation03",
    () =>
    {
        ShowLocationForAllPlayers(
            LOCATION_03_TITLE,
            LOCATION_03_TEXT
        );
    }
);


// ----------------------------------------------
// 強制非表示
// ----------------------------------------------

Instance.OnScriptInput(
    "HideLocation",
    () =>
    {
        // 現在の再生を無効化
        locationSession++;

        HideLocationForAllPlayers();
    }
);