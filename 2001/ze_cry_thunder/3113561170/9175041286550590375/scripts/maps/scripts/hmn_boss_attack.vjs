// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";


/* =========================================================
   基本設定
   ========================================================= */

// Boss Attack HUDのEntity名
const HUD_NAME = "hmn_boss_attack_hud";

// 攻撃SEのEntity名
const ATTACK_SOUND_NAME = "boss_attack_pip";


/* =========================================================
   表示時間
   ========================================================= */

// 攻撃HUDを表示している時間
const ATTACK_DISPLAY_TIME = 3.0;

// HUD表示開始から攻撃SEを再生するまでの待ち時間
const ATTACK_INITIAL_DELAY = 0.05;


/* =========================================================
   攻撃データ
   ========================================================= */

const ATTACK_DATA =
{
    // 攻撃01：通常ウィンドウ
    boss_attack01:
    {
        name: "災厄の波動",
        englishName: "WAVES OF DISASTER",
        danger: false
    },

    // 攻撃02：通常ウィンドウ
    boss_attack02:
    {
        name: "ゼニスドライヴ",
        englishName: "ZENITH DRIVE",
        danger: false
    },

    // 攻撃03：危険ウィンドウ
    boss_attack03:
    {
        name: "アッシュ・トゥ・アッシュ",
        englishName: "ASHES TO ASHES",
        danger: true
    }
};


/* =========================================================
   HUDキャッシュ
   ========================================================= */

let attackHud = null;


/* =========================================================
   HUD取得
   ========================================================= */

function GetAttackHud()
{
    // HUDが未取得、または無効なら再取得
    if (
        attackHud === null ||
        !attackHud.IsValid()
    )
    {
        const entities =
            Instance.FindEntitiesByName(
                HUD_NAME
            );

        if (
            !entities ||
            entities.length === 0
        )
        {
            Instance.Msg(
                "ERROR: hmn_boss_attack_hud not found"
            );

            return null;
        }

        attackHud = entities[0];
    }

    return attackHud;
}


/* =========================================================
   全プレイヤー処理
   ========================================================= */

function ForEachPlayer(callback)
{
    for (
        const controller
        of Instance.GetAllPlayerControllers()
    )
    {
        if (!controller)
            continue;

        callback(
            controller.GetPlayerSlot()
        );
    }
}


/* =========================================================
   攻撃SE再生
   ========================================================= */

function PlayAttackPip()
{
    const sound =
        Instance.FindEntityByName(
            ATTACK_SOUND_NAME
        );

    // SE用Entityが見つからない場合
    if (!sound)
    {
        Instance.Msg(
            "ERROR: boss_attack_pip not found"
        );

        return;
    }

    // ambient_genericの音を再生
    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}


/* =========================================================
   攻撃ウィンドウ切り替え
   ========================================================= */

function SetAttackWindow(
    hud,
    danger
)
{
    ForEachPlayer(
        (playerSlot) =>
        {
            // -----------------------------------------
            // 通常攻撃ウィンドウ
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowHidden",
                danger
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowVisible",
                !danger
            );


            // -----------------------------------------
            // 危険攻撃ウィンドウ
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowHidden",
                !danger
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowVisible",
                danger
            );
        }
    );
}


/* =========================================================
   攻撃表示
   ========================================================= */

async function ShowBossAttack(attackId)
{
    const hud = GetAttackHud();

    if (!hud)
        return;


    // -----------------------------------------
    // 攻撃データ取得
    // -----------------------------------------

    const attack =
        ATTACK_DATA[attackId];

    if (!attack)
    {
        Instance.Msg(
            "ERROR: Unknown boss attack: " +
            attackId
        );

        return;
    }


    // -----------------------------------------
    // 攻撃ウィンドウ選択
    // -----------------------------------------

    SetAttackWindow(
        hud,
        attack.danger
    );


    // -----------------------------------------
    // 日本語・英語テキストを表示状態へ
    // -----------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_name",
                "DialogueHidden",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_english",
                "DialogueHidden",
                false
            );
        }
    );


    // -----------------------------------------
    // 日本語攻撃名を設定
    // -----------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "attack_name",
                "attack_name",
                attack.name
            );
        }
    );


    // -----------------------------------------
    // 英語攻撃名を設定
    // -----------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "attack_english",
                "attack_english",
                attack.englishName
            );
        }
    );


    // -----------------------------------------
    // HUD表示開始
    //
    // ウィンドウ・日本語・英語を同時に表示
    // -----------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                false
            );
        }
    );


    // -----------------------------------------
    // 初期待機
    // -----------------------------------------

    await Instance.Delay(
        ATTACK_INITIAL_DELAY
    );


    // -----------------------------------------
    // 攻撃SE再生
    // -----------------------------------------

    PlayAttackPip();

    Instance.Msg(
        "BossAttack: " +
        attackId
    );


    // -----------------------------------------
    // 表示時間を維持
    // -----------------------------------------

    await Instance.Delay(
        ATTACK_DISPLAY_TIME
    );


    // -----------------------------------------
    // HUD退場
    // -----------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                true
            );
        }
    );

    Instance.Msg(
        "BossAttack: Hidden"
    );
}


/* =========================================================
   強制非表示
   ========================================================= */

function HideBossAttack()
{
    const hud = GetAttackHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            // -----------------------------------------
            // HUD全体を非表示
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                true
            );


            // -----------------------------------------
            // テキストを初期状態へ戻す
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_name",
                "DialogueHidden",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_english",
                "DialogueHidden",
                true
            );


            // -----------------------------------------
            // 通常ウィンドウを初期状態へ戻す
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowHidden",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowVisible",
                true
            );


            // -----------------------------------------
            // 危険ウィンドウを初期状態へ戻す
            // -----------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowHidden",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowVisible",
                false
            );
        }
    );


    Instance.Msg(
        "BossAttack: Hidden"
    );
}


/* =========================================================
   Hammerから呼び出すScript Input
   ========================================================= */

// 攻撃01：災厄の波動
Instance.OnScriptInput(
    "boss_attack01",
    () =>
    {
        ShowBossAttack(
            "boss_attack01"
        );
    }
);


// 攻撃02：ゼニスドライヴ
Instance.OnScriptInput(
    "boss_attack02",
    () =>
    {
        ShowBossAttack(
            "boss_attack02"
        );
    }
);


// 攻撃03：アッシュ・トゥ・アッシュ
Instance.OnScriptInput(
    "boss_attack03",
    () =>
    {
        ShowBossAttack(
            "boss_attack03"
        );
    }
);


// 強制非表示
Instance.OnScriptInput(
    "HideBossAttack",
    () =>
    {
        HideBossAttack();
    }
);