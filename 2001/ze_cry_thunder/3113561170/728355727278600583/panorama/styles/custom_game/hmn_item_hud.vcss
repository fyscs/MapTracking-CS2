/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.ItemContainer {
    width: 525px;
    height: 225px;
    horizontal-align: left;
    vertical-align: top;
    margin-left: 320px;
    margin-top: 120px;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(#0A111CBB), color-stop(0.45, #0A111CBB), to(#0A111C03) );
    border: 0px solid #FFFFFF01;
    border-radius: 6px;
    padding: 16px;
    flow-children: down;
    overflow: clip;
    opacity: 0.0;
    transform: translateX(24px);
    transition-property: opacity, transform;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}
.ItemContainer.Hidden {
    visibility: collapse;
    opacity: 0.0;
    transform: translateX(24px);
}
.ItemContainer.Visible {
    visibility: visible;
    opacity: 1.0;
    transform: translateX(0px);
}
.ItemContainer.ItemFadeOut {
    opacity: 0.0;
    transform: translateX(24px);
    transition-duration: 0.45s;
    transition-timing-function: ease-in;
}
.ItemContent {
    width: 100%;
    height: 100%;
    flow-children: down;
}
.ItemName {
    width: 100%;
    height: 34px;
    color: #FFD65A;
    font-size: 25px;
    font-weight: bold;
    text-shadow: 1px 1px 3px #000000;
    margin-bottom: 3px;
    opacity: 0.0;
    transform: translateX(20px);
    transition-property: opacity, transform;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.ItemNameLine {
    width: 0px;
    height: 2px;
    background-color: #FFD65A;
    opacity: 0.0;
    margin-top: 1px;
    margin-bottom: 7px;
    transition-property: width, opacity;
    transition-duration: 0.40s;
    transition-timing-function: ease-out;
}
#item_name_line.ItemNameLineVisible {
    width: 180px;
    opacity: 0.45;
}
.ItemDescription {
    width: 100%;
    height: 25px;
    color: #E5E8EF;
    font-size: 15px;
    text-shadow: 1px 1px 2px #000000;
    margin-bottom: 3px;
}
.ItemSeparator {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.30);
    margin-top: 12px;
    margin-bottom: 12px;
    opacity: 0.0;
    transition-property: opacity;
    transition-duration: 0.30s;
    transition-timing-function: ease-out;
}
.ItemSeparator.ItemSeparatorVisible {
    opacity: 1.0;
}
.ItemInfo {
    width: 100%;
    height: 25px;
    color: #65D68A;
    font-size: 15px;
    font-weight: bold;
    text-shadow: 1px 1px 2px #000000;
    margin-bottom: 5px;
}
#item_name.ItemNameReset {
    opacity: 0.0;
    transform: translateX(20px);
    transition: none;
}
#item_name.ItemNameVisible {
    opacity: 1.0;
    transform: translateX(0px);
    transition-property: opacity, transform;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.ItemDescription,.ItemInfo {
    opacity: 0.0;
    transform: translateX(16px);
    transition-property: opacity, transform;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.ItemDetailReset {
    opacity: 0.0;
    transform: translateX(16px);
    transition: none;
}
.ItemDetailVisible {
    opacity: 1.0;
    transform: translateX(0px);
    transition-property: opacity, transform;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
