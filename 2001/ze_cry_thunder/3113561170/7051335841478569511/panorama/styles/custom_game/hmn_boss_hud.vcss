.Root {
    width: 100%;
    height: 100%;
}
.BossFlash {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    background-color: #FFFFFFFF;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}
.BossFlash.Hidden {
    opacity: 0.0;
}
.BossContainer {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-out;
}
.BossContainer.Hidden {
    opacity: 0.0;
}
.BossContent {
    width: 1100px;
    height: 430px;
    horizontal-align: center;
    vertical-align: center;
}
#boss_emblem {
    width: 430px;
    height: 430px;
    horizontal-align: center;
    vertical-align: center;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}
.BossContainer.Hidden #boss_emblem {
    opacity: 0.0;
    transform: scale3d(0.82, 0.82, 1.0);
}
.BossText {
    width: 1100px;
    height: 190px;
    horizontal-align: center;
    vertical-align: center;
    transform: translateY(8px);
    flow-children: down;
}
.BossName {
    width: 100%;
    horizontal-align: center;
    text-align: center;
    font-size: 50px;
    font-weight: bold;
    color: #FFE4D4FF;
    letter-spacing: 1px;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 5px #000000FF;
    white-space: nowrap;
}
.BossName.DialogueHidden {
    opacity: 0.0;
    transform: scale3d(0.96, 0.96, 1.0);
}
.BossLine {
    width: 800px;
    height: 2px;
    horizontal-align: center;
    margin-top: 10px;
    margin-bottom: 6px;
    background-color: #FFD0B8FF;
    opacity: 1.0;
    transform: scaleX(1.0);
    transition-property: opacity, transform;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
.BossLine.DialogueHidden {
    opacity: 0.0;
    transform: scaleX(0.0);
}
.BossEnglish {
    width: 100%;
    height: 36px;
    horizontal-align: center;
    text-align: center;
    margin-top: 4px;
    font-size: 28px;
    color: #FFE9DCFF;
    opacity: 0.90;
    transform: scale3d(1.0, 1.0, 1.0);
    text-shadow: 0px 0px 3px #000000FF, 0px 0px 8px #000000FF;
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    white-space: nowrap;
}
.BossEnglish.DialogueHidden {
    opacity: 0.0;
    transform: scale3d(0.97, 0.97, 1.0);
}
