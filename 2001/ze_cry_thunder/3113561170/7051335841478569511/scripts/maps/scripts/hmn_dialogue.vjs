    "EnableEnglish",
    () =>
    {
        currentLanguage = "en";
        Instance.Msg("Dialogue language: English");
    }
);


// 日本語モードへ切り替え
Instance.OnScriptInput(
    "EnableJapanese",
    () =>
    {
        currentLanguage = "ja";
        Instance.Msg("Dialogue language: Japanese");
    }
);
