/* =========================================================
   HUD取得
   ========================================================= */

function GetDialogueHud()
{
    // 未取得、または無効になっている場合は再取得
    if (
        dialogueHud === null ||
        !dialogueHud.IsValid()
    )
    {
        dialogueHud =
            Instance.FindEntitiesByName(HUD_NAME)[0];
    }

    return dialogueHud;
}


/* =========================================================
   全プレイヤー処理
   ========================================================= */

function ForEachPlayer(callback)
{
    for (
        const controller
        of Instance.GetAllPlayerControllers()
    )
    {
        if (!controller)
        {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        callback(playerSlot);
    }
}


/* =========================================================
   テキスト変数設定
   ========================================================= */

function SetSlotText(
    hud,
    playerSlot,
    slot,
    name,
    message
)
{
    const nameVariable =
        "name_0" + slot;

    const messageVariable =
        "message_0" + slot;

    // キャラクター名
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        nameVariable,
        nameVariable,
        name
    );

    // セリフ本文
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        messageVariable,
        messageVariable,
        message
    );
}


/* =========================================================
   CSSクラス操作
   ========================================================= */

function SetSlotClass(
    hud,
    playerSlot,
    slot,
    className,
    enabled
)
{
    hud.SetHasClassForPlayer(
        playerSlot,
        "dialogue_slot_0" + slot,
        className,
        enabled
    );
}


/* =========================================================
   立ち絵切り替え
   ========================================================= */

function SetPortrait(
    hud,
    slot,
    character
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitA",
            character === "A"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitB",
            character === "B"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitC",
            character === "C"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitD",
            character === "D"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitE",
            character === "E"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitF",
            character === "F"
        );
    });
}


/* =========================================================
   話者状態の切り替え
   ========================================================= */

function SetSpeakerState(
    hud,
    slot,
    active
)
{
    ForEachPlayer((playerSlot) =>
    {
        // まず両方の状態を解除
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueSpeakerActive",
            false
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueSpeakerInactive",
            false
        );

        // 発言中・非発言中を設定
        if (active)
        {
            SetSlotClass(
                hud,
                playerSlot,
                slot,
                "DialogueSpeakerActive",
                true
            );
        }
        else
        {
            SetSlotClass(
                hud,
                playerSlot,
                slot,
                "DialogueSpeakerInactive",
                true
            );
        }
    });
}


/* =========================================================
   スロット状態管理
   ========================================================= */

// スロットの状態クラス一覧
const SLOT_STATES =
[
    "DialogueTop",
    "DialogueBottom",
    "DialogueStaging",
    "DialogueLeaving",
    "DialogueMovingUp",
    "DialogueEntering"
];


/* ---------------------------------------------------------
   スロット状態をすべて解除
   --------------------------------------------------------- */

function ClearSlotStates(
    hud,
    playerSlot,
    slot
)
{
    for (const state of SLOT_STATES)
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            false
        );
    }
}


/* ---------------------------------------------------------
   アニメーション付き状態切り替え
   --------------------------------------------------------- */

function SetSlotState(
    hud,
    slot,
    state
)
{
    ForEachPlayer((playerSlot) =>
    {
        // 即時切り替えを有効化
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            true
        );

        // 古い状態を解除
        ClearSlotStates(
            hud,
            playerSlot,
            slot
        );

        // 新しい状態を設定
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            true
        );

        // 即時切り替えを解除
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            false
        );
    });
}


/* ---------------------------------------------------------
   即時状態切り替え
   --------------------------------------------------------- */

function SetSlotStateInstant(
    hud,
    slot,
    state
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            true
        );

        ClearSlotStates(
            hud,
            playerSlot,
            slot
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            true
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            false
        );
    });
}


/* =========================================================
   テキスト設定
   ========================================================= */

function SetText(
    hud,
    slot,
    name,
    message
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotText(
            hud,
            playerSlot,
            slot,
            name,
            message
        );
    });
}


/* =========================================================
   HUD表示・非表示
   ========================================================= */

// HUDを表示
function ShowHud(hud)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            0,
            "DialogueFadeOut",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "Hidden",
            false
        );
    });
}


// HUDを非表示
function HideHud(hud)
{
    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "Hidden",
            true
        );
    });
}


/* =========================================================
   空きスロット検索
   ========================================================= */

function FindUnusedSlot(a, b)
{
    if (a !== 1 && b !== 1)
    {
        return 1;
    }

    if (a !== 2 && b !== 2)
    {
        return 2;
    }

    return 3;
}


/* =========================================================
   スロット初期化
   ========================================================= */

function ResetSlots(hud)
{
    for (
        let slot = 1;
        slot <= 3;
        slot++
    )
    {
        // テキストをクリア
        SetText(
            hud,
            slot,
            "",
            ""
        );

        // 立ち絵を初期状態に戻す
        SetPortrait(
            hud,
            slot,
            "A"
        );

        // 話者状態をリセット
        SetSpeakerState(
            hud,
            slot,
            false
        );

        // スロットを待機状態へ戻す
        SetSlotStateInstant(
            hud,
            slot,
            "DialogueStaging"
        );
    }
}


/* =========================================================
   最初の台詞を表示
   ========================================================= */

async function ShowFirstDialogue(
    name,
    message,
    portrait,
    isFinal
)
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }

    const session =
        dialogueSession;

    // 全スロットを初期化
    ResetSlots(hud);

    // スロット03に最初の台詞を設定
    SetText(
        hud,
        3,
        name,
        message
    );

    SetPortrait(
        hud,
        3,
        portrait
    );

    SetSpeakerState(
        hud,
        3,
        true
    );

    // 会話SE
    PlayDialoguePip();

    // スロットを待機状態に設定
    SetSlotState(
        hud,
        3,
        "DialogueStaging"
    );

    // HUDを表示
    ShowHud(hud);

    await Instance.Delay(0.05);

    // 会話がクリアされていれば中断
    if (session !== dialogueSession)
    {
        return;
    }

    // 最初の台詞を下段に表示
    SetSlotState(
        hud,
        3,
        "DialogueBottom"
    );

    await Instance.Delay(
        ANIMATION_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    // スロット配置を更新
    hasDialogue = true;

    topSlot = 0;
    bottomSlot = 3;
    stagingSlot = 1;

    // 最後の台詞なら自動非表示へ
    if (isFinal)
    {
        await AutoHideDialogue(
            hud,
            session
        );
    }
}


/* =========================================================
   台詞1件の処理
   ========================================================= */

async function ProcessDialogue(
    character,
    message,
    isFinal,
    language
)
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }


    /* -----------------------------------------------------
       キャラクター情報取得
       ----------------------------------------------------- */

    const characterTable =
        language === "en"
            ? CHARACTERS_EN
            : CHARACTERS;

    const characterData =
        characterTable[character];

    if (!characterData)
    {
        Instance.Msg(
            "ERROR: Character not found: " +
            character
        );

        return;
    }

    const name =
        characterData.name;

    const portrait =
        characterData.portrait;

    const session =
        dialogueSession;


    /* -----------------------------------------------------
       最初の台詞
       ----------------------------------------------------- */

    if (!hasDialogue)
    {
        await ShowFirstDialogue(
            name,
            message,
            portrait,
            isFinal
        );

        return;
    }


    /* -----------------------------------------------------
       上段がまだ存在しない場合
       ----------------------------------------------------- */

    if (topSlot === 0)
    {
        const oldBottom =
            bottomSlot;

        const newSlot =
            stagingSlot;

        const newStaging =
            FindUnusedSlot(
                oldBottom,
                newSlot
            );

        // 新しい台詞を設定
        SetText(
            hud,
            newSlot,
            name,
            message
        );

        SetPortrait(
            hud,
            newSlot,
            portrait
        );

        PlayDialoguePip();

        // 話者状態を更新
        SetSpeakerState(
            hud,
            oldBottom,
            false
        );

        SetSpeakerState(
            hud,
            newSlot,
            true
        );

        // 既存の台詞を上へ移動
        SetSlotState(
            hud,
            oldBottom,
            "DialogueMovingUp"
        );

        // 新しい台詞を登場させる
        SetSlotState(
            hud,
            newSlot,
            "DialogueEntering"
        );

        await Instance.Delay(
            ANIMATION_TIME
        );

        if (session !== dialogueSession)
        {
            return;
        }

        // アニメーション後の配置を確定
        SetSlotStateInstant(
            hud,
            oldBottom,
            "DialogueTop"
        );

        SetSlotStateInstant(
            hud,
            newSlot,
            "DialogueBottom"
        );

        SetSlotStateInstant(
            hud,
            newStaging,
            "DialogueStaging"
        );

        topSlot =
            oldBottom;

        bottomSlot =
            newSlot;

        stagingSlot =
            newStaging;

        if (isFinal)
        {
            await AutoHideDialogue(
                hud,
                session
            );
        }

        return;
    }


    /* -----------------------------------------------------
       3スロットを使用する通常状態
       ----------------------------------------------------- */

    const oldTop =
        topSlot;

    const oldBottom =
        bottomSlot;

    const newSlot =
        stagingSlot;

    // 新しい台詞を設定
    SetText(
        hud,
        newSlot,
        name,
        message
    );

    SetPortrait(
        hud,
        newSlot,
        portrait
    );

    PlayDialoguePip();

    // 話者状態を更新
    SetSpeakerState(
        hud,
        oldTop,
        false
    );

    SetSpeakerState(
        hud,
        oldBottom,
        false
    );

    SetSpeakerState(
        hud,
        newSlot,
        true
    );

    // 最上段の台詞を退場させる
    SetSlotState(
        hud,
        oldTop,
        "DialogueLeaving"
    );

    // 下段の台詞を上へ移動
    SetSlotState(
        hud,
        oldBottom,
        "DialogueMovingUp"
    );

    // 新しい台詞を登場させる
    SetSlotState(
        hud,
        newSlot,
        "DialogueEntering"
    );

    await Instance.Delay(
        ANIMATION_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    // 次の配置を計算
    const newTop =
        oldBottom;

    const newBottom =
        newSlot;

    const newStaging =
        oldTop;

    // アニメーション後の配置を確定
    SetSlotStateInstant(
        hud,
        newTop,
        "DialogueTop"
    );

    SetSlotStateInstant(
        hud,
        newBottom,
        "DialogueBottom"
    );

    SetSlotStateInstant(
        hud,
        newStaging,
        "DialogueStaging"
    );

    // スロット管理変数を更新
    topSlot =
        newTop;

    bottomSlot =
        newBottom;

    stagingSlot =
        newStaging;

    // 最後の台詞なら自動非表示へ
    if (isFinal)
    {
        await AutoHideDialogue(
            hud,
            session
        );
    }
}


/* =========================================================
   台詞キューへの追加
   ========================================================= */

function AddDialogue(
    character,
    message,
    isFinal = false,
    language = currentLanguage
)
{
    dialogueQueue.push(
    {
        character: character,
        message: message,
        isFinal: isFinal,
        language: language
    });

    ProcessDialogueQueue();
}


/* =========================================================
   台詞キュー処理
   ========================================================= */

async function ProcessDialogueQueue()
{
    // すでに処理中なら二重起動しない
    if (processingQueue)
    {
        return;
    }

    processingQueue = true;

    // キューに残っている台詞を順番に処理
    while (dialogueQueue.length > 0)
    {
        const dialogue =
            dialogueQueue.shift();

        await ProcessDialogue(
            dialogue.character,
            dialogue.message,
            dialogue.isFinal,
            dialogue.language
        );

        // 最後の台詞以外は次の台詞まで待機
        if (!dialogue.isFinal)
        {
            await Instance.Delay(
                DIALOGUE_DISPLAY_DELAY
            );
        }
    }

    processingQueue = false;
}


/* =========================================================
   シナリオ再生
   ========================================================= */

function PlayScenario(scenarioName)
{
    // シナリオ開始時点の言語を確定する
    // 英語訳がない場合はシナリオ全体を日本語で再生する
    const scenarioLanguage =
        currentLanguage === "en" &&
        SCENARIOS_EN[scenarioName]
            ? "en"
            : "ja";

    const scenario =
        scenarioLanguage === "en"
            ? SCENARIOS_EN[scenarioName]
            : SCENARIOS[scenarioName];

    // シナリオの存在確認
    if (!scenario)
    {
        Instance.Msg(
            "ERROR: Scenario not found: " +
            scenarioName
        );

        return;
    }

    // 空のシナリオを確認
    if (scenario.length === 0)
    {
        Instance.Msg(
            "ERROR: Scenario is empty: " +
            scenarioName
        );

        return;
    }

    // シナリオ内の台詞を順番にキューへ追加
    for (
        let i = 0;
        i < scenario.length;
        i++
    )
    {
        const dialogue =
            scenario[i];

        const isFinal =
            i === scenario.length - 1;

        AddDialogue(
            dialogue.character,
            dialogue.message,
            isFinal,
            scenarioLanguage
        );
    }
}


/* =========================================================
   自動非表示
   ========================================================= */

async function AutoHideDialogue(
    hud,
    session
)
{
    // 最後の台詞を表示しておく
    await Instance.Delay(
        AUTO_HIDE_DELAY
    );

    if (session !== dialogueSession)
    {
        return;
    }

    // フェードアウト開始
    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            true
        );
    });

    await Instance.Delay(
        AUTO_HIDE_FADE_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    // 会話状態をリセット
    hasDialogue = false;

    topSlot = 0;
    bottomSlot = 0;
    stagingSlot = 1;

    // HUDを非表示にする
    HideHud(hud);

    // フェードアウトクラスを解除
    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            false
        );
    });

    // スロットを初期状態に戻す
    ResetSlots(hud);
}


/* =========================================================
   会話クリア
   ========================================================= */

function ClearDialogue()
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }

    // 実行中の非同期処理を無効化
    dialogueSession++;

    // 未再生の台詞を破棄
    dialogueQueue.length = 0;

    // 会話状態をリセット
    hasDialogue = false;

    topSlot = 0;
    bottomSlot = 0;
    stagingSlot = 1;

    // HUDを初期化して非表示にする
    ResetSlots(hud);
    HideHud(hud);
}


/* =========================================================
   効果音
   ========================================================= */

function PlayDialoguePip()
{
    const sound =
        Instance.FindEntityByName(
            "dialogue_pip"
        );

    if (!sound)
    {
        Instance.Msg(
            "dialogue_pip NOT FOUND"
        );

        return;
    }

    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}


