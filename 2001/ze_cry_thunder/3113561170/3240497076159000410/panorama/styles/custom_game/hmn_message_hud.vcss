.Root {
    width: 100%;
    height: 100%;
}
.MessageContainer {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}
.MessageContainer.Hidden {
    opacity: 0.0;
}
.MessageContent {
    width: 1100px;
    height: 190px;
    horizontal-align: center;
    vertical-align: center;
    transform: translateY(8px);
    flow-children: down;
}
.MessageTitle {
    width: 100%;
    height: 52px;
    horizontal-align: center;
    vertical-align: center;
    text-align: center;
    font-size: 42px;
    font-weight: bold;
    color: #FFFFFFFF;
    letter-spacing: 2px;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    text-shadow: 2px 2px 2px #000000FF, 2px 15px 5px #000000FF;
    white-space: nowrap;
}
.MessageTitle.MessageHidden {
    opacity: 0.0;
    transform: scale3d(0.96, 0.96, 1.0);
}
.MessageLine {
    width: 850px;
    height: 2px;
    horizontal-align: center;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(#FFFFFF00), color-stop(0.15, #FFFFFFFF), color-stop(0.85, #FFFFFFFF), to(#FFFFFF00) );
    opacity: 1.0;
    transform: scaleX(1.0);
    transition-property: opacity, transform;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}
.MessageLine.MessageHidden {
    opacity: 0.0;
    transform: scaleX(0.0);
}
.MessageText {
    width: 100%;
    height: 34px;
    min-height: 34px;
    horizontal-align: center;
    text-align: center;
    font-size: 25px;
    color: #D4DCE8FF;
    letter-spacing: 1px;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    text-shadow: 2px 2px 3px #000000FF, 2px 15px 8px #000000FF;
    white-space: nowrap;
}
.MessageText.MessageHidden {
    opacity: 0.0;
    transform: scale3d(0.97, 0.97, 1.0);
}
#message_line_bottom {
    margin-top: 24px;
}
.MessageTitle.EnglishTitle {
    transform: translateY(8px) scale3d(1.0, 1.0, 1.0);
}
.MessageTitle.EnglishTitle.MessageHidden {
    transform: translateY(8px) scale3d(0.96, 0.96, 1.0);
}
.MessageText.EnglishText {
    transform: translateY(8px) scale3d(1.0, 1.0, 1.0);
}
.MessageText.EnglishText.MessageHidden {
    transform: translateY(8px) scale3d(0.97, 0.97, 1.0);
}
