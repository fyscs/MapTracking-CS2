};

/* =========================================================
   ログスクロール設定
   ========================================================= */

// 表示中のログID
let currentLogId = null;

// スクロール処理のセッション管理
let logScrollSession = 0;

// スクロール動作時間
const LOG_SCROLL_INITIAL_DELAY = 4.0;
const LOG_SCROLL_DURATION = 2.0;
const LOG_SCROLL_BOTTOM_WAIT = 3.0;
const LOG_SCROLL_RETURN_DURATION = 2.0;
const LOG_SCROLL_TOP_WAIT = 3.0;

// スクロール距離の制限
const LOG_SCROLL_STEP = 100;
const LOG_SCROLL_MAX = 1500;

/* =========================================================
   ログスクロール制御
   ========================================================= */

// ---------------------------------------------------------
// スクロール位置の即時リセット
// ---------------------------------------------------------

function ResetLogScroll() {

    const hud = GetCinematicHud();

    if (!hud) return;

    ForEachPlayer((playerSlot) => {

        // 先頭位置へ即座に戻す
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_log_text",
            "LogScrollReset",
            true
        );

        // フェードアウトを解除
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_log_text",
            "LogFadeOut",
            false
        );

        // すべてのスクロール距離クラスを解除
        for (
            let distance = LOG_SCROLL_STEP;
            distance <= LOG_SCROLL_MAX;
            distance += LOG_SCROLL_STEP
        ) {

            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogAutoScroll" + distance,
                false
            );
        }
    });
}

// ---------------------------------------------------------
// 自動スクロール
// ---------------------------------------------------------

async function StartLogAutoScroll(distance) {

    const mySession = logScrollSession;

    // ログ表示後の待機
    await Instance.Delay(LOG_SCROLL_INITIAL_DELAY);

    if (mySession !== logScrollSession) return;

    // スクロール不要
    if (!distance || distance <= 0) {
        Instance.Msg("Cinematic Log: No Scroll Needed");
        return;
    }

    const hud = GetCinematicHud();

    if (!hud) return;

    // 100px単位に切り上げ、最大値を制限
    const scrollAmount = Math.min(
        Math.ceil(distance / LOG_SCROLL_STEP) * LOG_SCROLL_STEP,
        LOG_SCROLL_MAX
    );

    const scrollClass = "LogAutoScroll" + scrollAmount;

    Instance.Msg(`Cinematic Log: Auto Scroll ${scrollAmount}px`);

    // =====================================================
    // スクロールと文章リセットを繰り返す
    // =====================================================

    while (mySession === logScrollSession) {

        // -------------------------------------------------
        // 下方向へスクロール
        // -------------------------------------------------

        ForEachPlayer((playerSlot) => {

            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogScrollReset",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogFadeOut",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                scrollClass,
                true
            );
        });

        await Instance.Delay(LOG_SCROLL_DURATION);

        if (mySession !== logScrollSession) return;

        // -------------------------------------------------
        // 下端で停止
        // -------------------------------------------------

        await Instance.Delay(LOG_SCROLL_BOTTOM_WAIT);

        if (mySession !== logScrollSession) return;

        // -------------------------------------------------
        // 文章をフェードアウト
        // -------------------------------------------------

        ForEachPlayer((playerSlot) => {

            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogFadeOut",
                true
            );
        });

        await Instance.Delay(0.25);

        if (mySession !== logScrollSession) return;

        // -------------------------------------------------
        // 非表示中に文章を先頭へリセット
        // -------------------------------------------------

        ForEachPlayer((playerSlot) => {

            // スクロール距離クラスを解除
            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                scrollClass,
                false
            );

            // 先頭位置へ即座に戻す
            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogScrollReset",
                true
            );
        });

        await Instance.Delay(0.05);

        if (mySession !== logScrollSession) return;

        // -------------------------------------------------
        // 文章をフェードイン
        // -------------------------------------------------

        ForEachPlayer((playerSlot) => {

            // 即時リセット状態を解除
            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogScrollReset",
                false
            );

            // フェードアウトを解除
            hud.SetHasClassForPlayer(
                playerSlot,
                "cinematic_log_text",
                "LogFadeOut",
                false
            );
        });

        await Instance.Delay(0.25);

        if (mySession !== logScrollSession) return;

        // -------------------------------------------------
        // 先頭で停止
        // -------------------------------------------------

        await Instance.Delay(LOG_SCROLL_TOP_WAIT);

        if (mySession !== logScrollSession) return;
    }
}

/* =========================================================
   ログ表示管理
   ========================================================= */

// ---------------------------------------------------------
// ログ表示
// ---------------------------------------------------------

function ShowLog(logId) {

    const hud = GetCinematicHud();

    if (!hud) return;

    const log = LOG_CONFIG[logId];

    if (!log) return;

    // 以前のスクロール処理を無効化
    logScrollSession++;

    currentLogId = logId;

    // 表示言語に応じたタイトルと本文
    const logTitle =
        dialogueLanguage === "English"
            ? log.titleEnglish
            : log.titleJapanese;

    const logText =
        dialogueLanguage === "English"
            ? log.textEnglish
            : log.textJapanese;

    // スクロール位置を初期化
    ResetLogScroll();

    ForEachPlayer((playerSlot) => {

        // ログタイトル
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "cinematic_log_title",
            "log_title",
            logTitle
        );

        // ログ本文
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "cinematic_log_text",
            "log_text",
            logText
        );

        // ログ表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_log_overlay",
            "Hidden",
            false
        );
    });

        // 表示言語に応じたスクロール距離
        const scrollDistance =
            dialogueLanguage === "English"
                ? log.scrollDistanceEnglish
                : log.scrollDistanceJapanese;

        // 言語別に設定した距離で自動スクロール
        StartLogAutoScroll(scrollDistance);

    Instance.Msg(`Cinematic Log: ${logId}`);
}

// ---------------------------------------------------------
// ログ非表示
// ---------------------------------------------------------

function HideLog() {

    logScrollSession++;
    currentLogId = null;

    const hud = GetCinematicHud();

    if (!hud) return;

    // スクロール位置を初期化
    ResetLogScroll();

    ForEachPlayer((playerSlot) => {

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_log_overlay",
            "Hidden",
            true
        );
    });

    Instance.Msg("Cinematic Log: Hide");
}

// ---------------------------------------------------------
// ログ言語切り替え時の再表示
// ---------------------------------------------------------

function RefreshLog() {

    if (currentLogId === null) return;

    ShowLog(currentLogId);
}

/* =========================================================
   Hammer入力登録：セリフ
   ========================================================= */

// セリフIDから入力名を自動登録
for (const dialogueId of Object.keys(DIALOGUE_CONFIG)) {

    const number = dialogueId.replace("dialogue", "");
    const inputName = "ShowDialogue" + number;

    Instance.OnScriptInput(inputName, () => {
        ShowDialogue(dialogueId);
    });
}

// セリフ非表示
Instance.OnScriptInput("HideDialogue", () => {
    HideDialogue();
});

/* =========================================================
   Hammer入力登録：ログ
   ========================================================= */

// ログIDから入力名を自動登録
for (const logId of Object.keys(LOG_CONFIG)) {

    const number = logId.replace("log", "");
    const inputName = "ShowLog" + number;

    Instance.OnScriptInput(inputName, () => {
        ShowLog(logId);
    });
}

// ログ非表示
Instance.OnScriptInput("HideLog", () => {
    HideLog();
});

/* =========================================================
   Hammer入力登録：言語切り替え
   ========================================================= */

// 日本語に切り替え
Instance.OnScriptInput("EnableJapanese", () => {

    dialogueLanguage = "Japanese";

    RefreshDialogue();
    RefreshLog();
});

// 英語に切り替え
Instance.OnScriptInput("EnableEnglish", () => {

    dialogueLanguage = "English";

    RefreshDialogue();
    RefreshLog();
});

/* =========================================================
   Hammer入力登録：画像切り替え
   ========================================================= */

// 画像IDから入力名を自動登録
for (let i = 0; i < CINEMATIC_IMAGE_IDS.length; i++) {

    const imageId = CINEMATIC_IMAGE_IDS[i];

    const inputName = "ShowCinematic" +
        String(i + 1).padStart(2, "0");

    Instance.OnScriptInput(inputName, () => {
        SetCinematicImage(imageId);
    });
}

/* =========================================================
   Hammer入力登録：シネマティック表示
   ========================================================= */

// シネマティック表示
Instance.OnScriptInput("ShowCinematic", () => {
    ShowCinematic();
});

// シネマティック非表示
Instance.OnScriptInput("HideCinematic", () => {
    HideCinematic();
});

/* =========================================================
   Hammer入力登録：揺れ演出
   ========================================================= */

// 揺れ開始
Instance.OnScriptInput("ShakeCinematic", () => {
    ShakeCinematic();
});

// 揺れ停止
Instance.OnScriptInput("ShakeStopCinematic", () => {
    ShakeStopCinematic();
});

/* =========================================================
   Hammer入力登録：ホワイトフラッシュ
   ========================================================= */

Instance.OnScriptInput("FlashCinematic", () => {
    FlashCinematic();
});
