// ログを追加するときは、ここに項目を追加する
//
// 設定項目
// titleJapanese : 日本語タイトル
// titleEnglish  : 英語タイトル
// scrollDistance : スクロール距離（100px単位・最大1500px）
// textJapanese  : 日本語本文
// textEnglish   : 英語本文

const LOG_CONFIG = {

    log01: {
        titleJapanese: "古い記録",
        titleEnglish: "ANCIENT RECORD",

