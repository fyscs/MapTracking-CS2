import { Instance, Entities } from "cs_script/point_script";

/* =========================================================
   基本設定
   ========================================================= */

// HUDエンティティ名
const HUD_NAME = "hmn_cinematic_hud";

// 使用するシネマティック画像
const CINEMATIC_IMAGE_IDS = [
    "cinematic_image_01",
    "cinematic_image_02",
    "cinematic_image_03",
    "cinematic_image_04",
    "cinematic_image_05"
];

// セリフの文字送り間隔
const TYPEWRITER_INTERVAL = 0.03;

// =========================================================
// シネマティック画像の揺れ設定
// =========================================================

// 揺れの間隔
const CINEMATIC_SHAKE_INTERVAL = 0.04;

// 揺れ方向
const CINEMATIC_SHAKE_CLASSES = [
    "ShakeLeft",
    "ShakeRight",
    "ShakeUp",
    "ShakeDown",
    "ShakeUpLeft",
    "ShakeUpRight",
    "ShakeDownLeft",
    "ShakeDownRight"
];

// 揺れ処理のセッション管理
let cinematicShakeSession = 0;

/* =========================================================
   シネマティック：ホワイトフラッシュ設定
   ========================================================= */

// フラッシュ表示時間
const CINEMATIC_FLASH_DURATION = 0.08;

// フェードアウト時間
const CINEMATIC_FLASH_FADE_DURATION = 0.25;

// フラッシュ処理のセッション管理
let cinematicFlashSession = 0;

/* =========================================================
   HUD取得・共通処理
   ========================================================= */

// HUDエンティティ
let cinematicHud = null;

// ---------------------------------------------------------
// HUD取得
// ---------------------------------------------------------

function GetCinematicHud() {

    if (cinematicHud === null || !cinematicHud.IsValid()) {

        const entities = Entities.FindByName(HUD_NAME);

        if (!entities || entities.length === 0) {
            Instance.Msg("ERROR: hmn_cinematic_hud not found");
            return null;
        }

        cinematicHud = entities[0];
    }

    return cinematicHud;
}

// ---------------------------------------------------------
// 全プレイヤーに処理
// ---------------------------------------------------------

function ForEachPlayer(callback) {

    for (const controller of Instance.GetAllPlayerControllers()) {

        if (!controller) continue;

        callback(controller.GetPlayerSlot());
    }
}

// ---------------------------------------------------------
// セリフ効果音
// ---------------------------------------------------------

function PlayCinematicDialogueSound() {

    const sound = Entities.FindByName(
        "cinematic_dialogue_pip"
    );

    if (!sound || sound.length === 0) {
        Instance.Msg("ERROR: cinematic_dialogue_pip not found");
        return;
    }

    sound[0].FireInput({
        input: "PlaySound"
    });
}

/* =========================================================
   シネマティック画像表示
   ========================================================= */

// ---------------------------------------------------------
// 画像切り替え
// ---------------------------------------------------------

function SetCinematicImage(imageId) {

    const hud = GetCinematicHud();

    if (!hud) return;

    if (!CINEMATIC_IMAGE_IDS.includes(imageId)) {
        Instance.Msg(`ERROR: Invalid cinematic image: ${imageId}`);
        return;
    }

    ForEachPlayer((playerSlot) => {

        // 登録画像をすべて非表示
        for (const id of CINEMATIC_IMAGE_IDS) {

            hud.SetHasClassForPlayer(
                playerSlot,
                id,
                "CinematicImageVisible",
                false
            );
        }

        // 指定画像を表示
        hud.SetHasClassForPlayer(
            playerSlot,
            imageId,
            "CinematicImageVisible",
            true
        );

        // シネマティック本体を表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_container",
            "Hidden",
            false
        );
    });

    Instance.Msg(`Cinematic: ${imageId}`);
}

/* =========================================================
   シネマティック画像：揺れ制御
   ========================================================= */

// ---------------------------------------------------------
// 揺れクラスの設定
// ---------------------------------------------------------

function SetCinematicShakeClass(shakeClass) {

    const hud = GetCinematicHud();

    if (!hud) return;

    ForEachPlayer((playerSlot) => {

        // すべての画像に同じ揺れ状態を適用
        // 画像切り替え時にも位置を一致させる
        for (const imageId of CINEMATIC_IMAGE_IDS) {

            // 以前の揺れ方向を解除
            for (const className of CINEMATIC_SHAKE_CLASSES) {

                hud.SetHasClassForPlayer(
                    playerSlot,
                    imageId,
                    className,
                    false
                );
            }

            // 新しい揺れ方向を設定
            if (shakeClass !== null) {

                hud.SetHasClassForPlayer(
                    playerSlot,
                    imageId,
                    shakeClass,
                    true
                );
            }
        }
    });
}

// ---------------------------------------------------------
// 揺れ開始
// ---------------------------------------------------------

async function ShakeCinematic() {

    // 以前の揺れ処理を無効化
    cinematicShakeSession++;

    const mySession = cinematicShakeSession;

    Instance.Msg("Cinematic: Shake Start");

    // ランダムな方向へ揺らし続ける
    while (mySession === cinematicShakeSession) {

        const randomIndex = Math.floor(
            Math.random() * CINEMATIC_SHAKE_CLASSES.length
        );

        const shakeClass =
            CINEMATIC_SHAKE_CLASSES[randomIndex];

        SetCinematicShakeClass(shakeClass);

        await Instance.Delay(CINEMATIC_SHAKE_INTERVAL);
    }
}

// ---------------------------------------------------------
// 揺れ停止
// ---------------------------------------------------------

function ShakeStopCinematic() {

    // 実行中の揺れ処理を無効化
    cinematicShakeSession++;

    // 揺れクラスをすべて解除
    SetCinematicShakeClass(null);

    Instance.Msg("Cinematic: Shake Stop");
}

/* =========================================================
   シネマティック：ホワイトフラッシュ制御
   ========================================================= */

// ---------------------------------------------------------
// ホワイトフラッシュ
// ---------------------------------------------------------

async function FlashCinematic() {

    const hud = GetCinematicHud();

    if (!hud) return;

    // 以前のフラッシュ処理を無効化
    cinematicFlashSession++;

    const mySession = cinematicFlashSession;

    // 全プレイヤーにフラッシュを表示
    ForEachPlayer((playerSlot) => {

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_flash",
            "Hidden",
            false
        );
    });

    // 白色表示
    await Instance.Delay(CINEMATIC_FLASH_DURATION);

    if (mySession !== cinematicFlashSession) return;

    // フェードアウト開始
    ForEachPlayer((playerSlot) => {

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_flash",
            "Hidden",
            true
        );
    });

    Instance.Msg("Cinematic: Flash");
}

// ---------------------------------------------------------
// シネマティック表示
// ---------------------------------------------------------

function ShowCinematic() {

    SetCinematicImage("cinematic_image_01");
}

// ---------------------------------------------------------
// シネマティック非表示
// ---------------------------------------------------------

function HideCinematic() {

    currentLogId = null;
    logScrollSession++;

    const hud = GetCinematicHud();

    if (!hud) return;

    // ログスクロールをリセット
    ResetLogScroll();

    ForEachPlayer((playerSlot) => {

        // シネマティックを非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_container",
            "Hidden",
            true
        );

        // ログを非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_log_overlay",
            "Hidden",
            true
        );
    });

    Instance.Msg("Cinematic: Hide");
}

