/* =========================================================
   セリフ表示管理
   ========================================================= */

// 表示中のセリフID
let currentDialogueId = null;

// セリフ表示セッション
let dialogueSession = 0;

// 表示言語
let dialogueLanguage = "Japanese";

// ---------------------------------------------------------
// セリフ表示
// ---------------------------------------------------------

async function ShowDialogue(dialogueId) {

    const hud = GetCinematicHud();

    if (!hud) return;

    const dialogue = DIALOGUE_CONFIG[dialogueId];

    if (!dialogue) return;

    dialogueSession++;

    const mySession = dialogueSession;

    currentDialogueId = dialogueId;

    // 表示言語に応じた名前と本文
    const characterName =
        dialogueLanguage === "English"
            ? dialogue.nameEnglish
            : dialogue.nameJapanese;

    const dialogueText =
        dialogueLanguage === "English"
            ? dialogue.textEnglish
            : dialogue.textJapanese;

    // セリフ表示音
    PlayCinematicDialogueSound();

    // 全プレイヤーの表示を初期化
    ForEachPlayer((playerSlot) => {

        // キャラクター名
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "cinematic_character_name",
            "character_name",
            characterName
        );

        // セリフ本文を空にする
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "cinematic_dialogue_text",
            "dialogue_text",
            ""
        );

        // セリフ表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_dialogue",
            "Hidden",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_dialogue",
            "Visible",
            true
        );
    });

    await Instance.Delay(0.03);

    if (mySession !== dialogueSession) return;

    const characters = Array.from(dialogueText);

    let displayedText = "";

    // 文字送り
    for (const character of characters) {

        if (mySession !== dialogueSession) return;

        displayedText += character;

        ForEachPlayer((playerSlot) => {

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "cinematic_dialogue_text",
                "dialogue_text",
                displayedText
            );
        });

        await Instance.Delay(TYPEWRITER_INTERVAL);
    }

    Instance.Msg(`Cinematic Dialogue: ${dialogueId}`);
}

// ---------------------------------------------------------
// セリフ非表示
// ---------------------------------------------------------

function HideDialogue() {

    dialogueSession++;
    currentDialogueId = null;

    const hud = GetCinematicHud();

    if (!hud) return;

    ForEachPlayer((playerSlot) => {

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_dialogue",
            "Visible",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "cinematic_dialogue",
            "Hidden",
            true
        );
    });

    Instance.Msg("Cinematic Dialogue: Hide");
}

// ---------------------------------------------------------
// セリフ言語切り替え時の再表示
// ---------------------------------------------------------

function RefreshDialogue() {

    if (currentDialogueId === null) return;

    ShowDialogue(currentDialogueId);
}

