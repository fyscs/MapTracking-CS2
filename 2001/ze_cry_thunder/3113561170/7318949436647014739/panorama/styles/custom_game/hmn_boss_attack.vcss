.Root {
    width: 100%;
    height: 100%;
}
.AttackContainer {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: top;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}
.AttackContainer.Hidden {
    opacity: 0.0;
}
.AttackContent {
    width: 718px;
    height: 142px;
    horizontal-align: center;
    margin-top: 80px;
    opacity: 1.0;
    transform: translateY(0px) scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}
.AttackContainer.Hidden .AttackContent {
    opacity: 0.0;
    transform: translateY(-32px) scale3d(0.93, 0.93, 1.0);
}
.AttackWindow {
    width: 768px;
    height: 192px;
    horizontal-align: center;
    vertical-align: center;
    opacity: 1.0;
}
.AttackWindowVisible {
    opacity: 1.0;
}
.AttackWindowHidden {
    opacity: 0.0;
}
.AttackText {
    width: 100%;
    height: 110px;
    horizontal-align: center;
    vertical-align: center;
    flow-children: down;
    transform: translateY(2px);
}
.AttackName {
    width: 100%;
    horizontal-align: center;
    text-align: center;
    font-size: 40px;
    font-weight: bold;
    color: #FFFFFFFF;
    letter-spacing: 1px;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 6px #000000FF;
    white-space: nowrap;
}
.AttackName.DialogueHidden {
    opacity: 0.0;
    transform: scale3d(0.96, 0.96, 1.0);
}
.AttackEnglish {
    width: 100%;
    height: 28px;
    horizontal-align: center;
    text-align: center;
    margin-top: 4px;
    font-size: 20px;
    color: #FFFFFFFF;
    opacity: 0.82;
    letter-spacing: 1px;
    transform: scale3d(0.97, 0.97, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 6px #000000FF;
    white-space: nowrap;
}
.AttackEnglish.DialogueHidden {
    opacity: 0.0;
    transform: scale3d(0.97, 0.97, 1.0);
}
