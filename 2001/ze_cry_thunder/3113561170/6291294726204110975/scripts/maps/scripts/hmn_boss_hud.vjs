// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";


/* =========================================================
   基本設定
   ========================================================= */

// Boss HUDのEntity名
const HUD_NAME = "hmn_boss_hud";

// Boss登場時に鳴らす共通SEのEntity名
const BOSS_SOUND_NAME = "boss_pip";


/* =========================================================
   Boss表示タイミング
   ========================================================= */

// Boss HUDを表示してから自動退場するまでの時間
const BOSS_DISPLAY_TIME = 5.0;

// エンブレム表示開始後、Boss登場SEを鳴らすまでの時間
const BOSS_INITIAL_DELAY = 0.05;

// 日本語Boss名を表示するまでの時間
const BOSS_NAME_DELAY = 0.45;

// 日本語名表示後、ラインを表示するまでの時間
const BOSS_LINE_DELAY = 0.25;

// ライン表示後、英語名を表示するまでの時間
const BOSS_ENGLISH_DELAY = 0.20;


/* =========================================================
   Boss退場タイミング
   ========================================================= */

// 英語名を消してからラインを消すまで
const EXIT_LINE_DELAY = 0.10;

// ラインを消してから日本語名を消すまで
const EXIT_NAME_DELAY = 0.12;

// 日本語名を消してからHUD全体を消すまで
const EXIT_CONTAINER_DELAY = 0.25;


/* =========================================================
   Bossデータ
   ========================================================= */

const BOSS_DATA =
{
    boss01:
    {
        name: "ファントム・アンザローネ",
        englishName: "PHANTOM ANZALONE"
    },

    boss02:
    {
        name: "ビホールダー",
        englishName: "BEHOLDER"
    },

    boss03:
    {
        name: "ボス03",
        englishName: "SAMPLE03"
    },

    boss04:
    {
        name: "ボス04",
        englishName: "SAMPLE04"
    },

    boss05:
    {
        name: "ボス05",
        englishName: "SAMPLE05"
    }
};


/* =========================================================
   Boss HUDキャッシュ
   ========================================================= */

let bossHud = null;


/* =========================================================
   Boss HUDを取得
   ========================================================= */

function GetBossHud()
{
    // 既に取得済みで有効なら、そのまま使用
    if (bossHud === null || !bossHud.IsValid())
    {
        const entities =
            Instance.FindEntitiesByName(HUD_NAME);

        if (!entities || entities.length === 0)
        {
            Instance.Msg(
                "ERROR: hmn_boss_hud not found"
            );

            return null;
        }

        bossHud = entities[0];
    }

    return bossHud;
}


/* =========================================================
   Boss登場時の白フラッシュ
   ========================================================= */

async function FlashBossScreen()
{
    const hud = GetBossHud();

    if (!hud)
        return;


    /* -----------------------------------------------------
       白フラッシュ開始
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_flash",
            "Hidden",
            false
        );
    });


    /* -----------------------------------------------------
       画面全体をしっかり白くする
       -----------------------------------------------------
       一瞬だけ完全な白画面を維持する。
       ----------------------------------------------------- */

    await Instance.Delay(0.30);


    /* -----------------------------------------------------
       白フラッシュ終了
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_flash",
            "Hidden",
            true
        );
    });
}


/* =========================================================
   Boss登場SEを再生
   ========================================================= */

function PlayBossPip()
{
    // マップ上のboss_pipを取得
    const sound =
        Instance.FindEntityByName(
            BOSS_SOUND_NAME
        );

    // boss_pipが存在しない場合
    if (!sound)
    {
        Instance.Msg(
            "ERROR: boss_pip not found"
        );

        return;
    }

    // ambient_genericの音を再生
    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}


/* =========================================================
   全プレイヤーへ処理
   ========================================================= */

function ForEachPlayer(callback)
{
    for (const controller of Instance.GetAllPlayerControllers())
    {
        if (!controller)
            continue;

        callback(controller.GetPlayerSlot());
    }
}


/* =========================================================
   Boss登場演出
   ========================================================= */

async function ShowBossEncounter(bossId)
{
    const hud = GetBossHud();

    if (!hud)
        return;


    /* -----------------------------------------------------
       Bossデータを取得
       ----------------------------------------------------- */

    const boss = BOSS_DATA[bossId];

    if (!boss)
    {
        Instance.Msg(
            "ERROR: Unknown boss: " + bossId
        );

        return;
    }


    /* -----------------------------------------------------
       表示前にテキストを非表示へ戻す
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_name",
            "DialogueHidden",
            true
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_line",
            "DialogueHidden",
            true
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_english",
            "DialogueHidden",
            true
        );
    });


    /* -----------------------------------------------------
       白フラッシュをリセット
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_flash",
            "Hidden",
            true
        );
    });


    /* -----------------------------------------------------
       Boss名を設定
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "boss_name",
            "boss_name",
            boss.name
        );

        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "boss_english",
            "boss_english",
            boss.englishName
        );
    });


    /* -----------------------------------------------------
       Boss HUD表示開始
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_container",
            "Hidden",
            false
        );
    });


    /* -----------------------------------------------------
       エンブレム出現＋白フラッシュ＋Boss登場SE
       ----------------------------------------------------- */

    await Instance.Delay(BOSS_INITIAL_DELAY);


    // 画面を一瞬だけ白く光らせる
    FlashBossScreen();


    // Boss登場SE
    PlayBossPip();


    Instance.Msg(
        "BossEncounter: " +
        bossId
    );


    /* -----------------------------------------------------
       テキスト演出
       ----------------------------------------------------- */

    (async () =>
    {
        // 日本語Boss名を表示
        await Instance.Delay(BOSS_NAME_DELAY);

        ForEachPlayer((playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "boss_name",
                "DialogueHidden",
                false
            );
        });


        // ラインを表示
        await Instance.Delay(BOSS_LINE_DELAY);

        ForEachPlayer((playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "boss_line",
                "DialogueHidden",
                false
            );
        });


        // 英語Boss名を表示
        await Instance.Delay(BOSS_ENGLISH_DELAY);

        ForEachPlayer((playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "boss_english",
                "DialogueHidden",
                false
            );
        });
    })();


    /* -----------------------------------------------------
       一定時間後に自動退場
       ----------------------------------------------------- */

    (async () =>
    {
        await Instance.Delay(BOSS_DISPLAY_TIME);

        HideBossEncounterAnimated();
    })();
}


/* =========================================================
   Boss退場演出
   ========================================================= */

async function HideBossEncounterAnimated()
{
    const hud = GetBossHud();

    if (!hud)
        return;


    /* -----------------------------------------------------
       英語Boss名を消す
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_english",
            "DialogueHidden",
            true
        );
    });


    await Instance.Delay(EXIT_LINE_DELAY);


    /* -----------------------------------------------------
       ラインを消す
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_line",
            "DialogueHidden",
            true
        );
    });


    await Instance.Delay(EXIT_NAME_DELAY);


    /* -----------------------------------------------------
       日本語Boss名を消す
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_name",
            "DialogueHidden",
            true
        );
    });


    await Instance.Delay(EXIT_CONTAINER_DELAY);


    /* -----------------------------------------------------
       Boss HUD全体を消す
       ----------------------------------------------------- */

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_container",
            "Hidden",
            true
        );

        // 念のため白フラッシュも非表示に戻す
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_flash",
            "Hidden",
            true
        );
    });


    Instance.Msg(
        "BossEncounter: Hidden"
    );
}


/* =========================================================
   Boss HUD強制非表示
   ========================================================= */

function HideBossEncounter()
{
    const hud = GetBossHud();

    if (!hud)
        return;


    ForEachPlayer((playerSlot) =>
    {
        // HUD全体を非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_container",
            "Hidden",
            true
        );

        // 白フラッシュも非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_flash",
            "Hidden",
            true
        );

        // 日本語Boss名を非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_name",
            "DialogueHidden",
            true
        );

        // ラインを非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_line",
            "DialogueHidden",
            true
        );

        // 英語Boss名を非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "boss_english",
            "DialogueHidden",
            true
        );
    });


    Instance.Msg(
        "BossEncounter: Hidden"
    );
}


/* =========================================================
   Hammerから呼び出すBossイベント
   ========================================================= */


// Boss01
Instance.OnScriptInput(
    "boss01",
    () =>
    {
        ShowBossEncounter("boss01");
    }
);


// Boss02
Instance.OnScriptInput(
    "boss02",
    () =>
    {
        ShowBossEncounter("boss02");
    }
);


// Boss03
Instance.OnScriptInput(
    "boss03",
    () =>
    {
        ShowBossEncounter("boss03");
    }
);


// Boss04
Instance.OnScriptInput(
    "boss04",
    () =>
    {
        ShowBossEncounter("boss04");
    }
);


// Boss05
Instance.OnScriptInput(
    "boss05",
    () =>
    {
        ShowBossEncounter("boss05");
    }
);


/* =========================================================
   Boss HUD強制非表示
   Hammerから HideBossEncounter を送ると実行
   ========================================================= */

Instance.OnScriptInput(
    "HideBossEncounter",
    () =>
    {
        HideBossEncounter();
    }
);