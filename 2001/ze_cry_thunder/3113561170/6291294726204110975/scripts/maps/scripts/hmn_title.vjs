import { Instance } from "cs_script/point_script";


const HUD_NAME =
    "hmn_title_hud";


let titleHud = null;


// ============================================================
// 現在表示するタイトル情報
// ============================================================

let currentTitle =
{
    english: "CRY THUNDER",
    japanese: "紅蓮の憂鬱",

    description01:
        "家族に頼まれていたお使いを終わらせ、渓谷橋に辿り着いた元勇者。",

    description02:
        "だがこの大橋は危険故に夜の渡橋が許されていない。",

    description03:
        "しかし、今の彼には疲労でそんなことも考える時間もないようだ...",

    specialThanks:
        "SPECIAL THANKS",

    serverName:
        "LUPERCALIA SERVER"
};


// ============================================================
// タイトルHUDを取得
// ============================================================

function GetTitleHud()
{
    if (
        titleHud === null ||
        !titleHud.IsValid()
    )
    {
        const entities =
            Instance.FindEntitiesByName(
                HUD_NAME
            );

        if (
            !entities ||
            entities.length === 0
        )
        {
            Instance.Msg(
                "ERROR: hmn_title_hud not found"
            );

            return null;
        }

        titleHud = entities[0];
    }

    return titleHud;
}


// ============================================================
// 全プレイヤーに処理
// ============================================================

function ForEachPlayer(callback)
{
    for (
        const controller
        of Instance.GetAllPlayerControllers()
    )
    {
        if (!controller)
            continue;

        callback(
            controller.GetPlayerSlot()
        );
    }
}


// ============================================================
// 背景を初期位置へリセット
// ============================================================

function ResetBackground()
{
    const hud =
        GetTitleHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_background_panel",
                "BackgroundMove",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_background_panel",
                "BackgroundReset",
                true
            );
        }
    );
}


// ============================================================
// 背景スクロール開始
// ============================================================

function StartBackgroundMove()
{
    const hud =
        GetTitleHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_background_panel",
                "BackgroundReset",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_background_panel",
                "BackgroundMove",
                true
            );
        }
    );


    Instance.Msg(
        "Title: Background Move"
    );
}


// ============================================================
// 文字アニメーションを初期状態へ戻す
//
// ※ タイトルが完全に消えた後にだけ実行する
// ============================================================

function ResetTitleTextAnimation()
{
    const hud =
        GetTitleHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_english",
                "TitleEnglishVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_japanese",
                "TitleJapaneseVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_01",
                "TitleDescriptionFirstVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_02",
                "TitleDescriptionVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_03",
                "TitleDescriptionVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_special_thanks",
                "TitleSpecialThanksVisible",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_server_name",
                "TitleServerNameVisible",
                false
            );
        }
    );


    Instance.Msg(
        "Title: Text Animation Reset"
    );
}


// ============================================================
// タイトル情報を設定
// ============================================================

function SetTitleData(
    english,
    japanese,
    description01,
    description02,
    description03,
    specialThanks,
    serverName
)
{
    currentTitle =
    {
        english:
            english,

        japanese:
            japanese,

        description01:
            description01,

        description02:
            description02,

        description03:
            description03,

        specialThanks:
            specialThanks,

        serverName:
            serverName
    };
}


// ============================================================
// Title01
// ============================================================

function SelectTitle01()
{
    SetTitleData(
        "CRY THUNDER",
        "紅蓮の憂鬱",

        "家族に頼まれていたお使いを終わらせ、渓谷橋に辿り着いた元勇者。",
        "だがこの大橋は危険故に夜の渡橋が許されていない。",
        "しかし、今の彼には疲労でそんなことも考える時間もないようだ...",

        "SPECIAL THANKS",
        "LUPERCALIA SERVER"
    );


    Instance.Msg(
        "Title: Title01 Selected"
    );


    ShowTitle();
}


// ============================================================
// Title02
// ============================================================

function SelectTitle02()
{
    SetTitleData(
        "TEST SCENE 02",
        "テストシーン02",

        "これはTitle02のテストです。",
        "シーンごとに内容を変更できます。",
        "演出そのものはTitle01と共通です。",

        "SPECIAL THANKS",
        "LUPERCALIA SERVER"
    );


    Instance.Msg(
        "Title: Title02 Selected"
    );


    ShowTitle();
}


// ============================================================
// タイトル表示
// ============================================================

async function ShowTitle()
{
    const hud =
        GetTitleHud();

    if (!hud)
        return;


    ResetBackground();

    await Instance.Delay(0.1);


    // 現在のタイトル情報を全プレイヤーへ設定

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_english",
                "title_english",
                currentTitle.english
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_japanese",
                "title_japanese",
                currentTitle.japanese
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_description_01",
                "title_description_01",
                currentTitle.description01
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_description_02",
                "title_description_02",
                currentTitle.description02
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_description_03",
                "title_description_03",
                currentTitle.description03
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_special_thanks",
                "title_special_thanks",
                currentTitle.specialThanks
            );

            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "title_server_name",
                "title_server_name",
                currentTitle.serverName
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_container",
                "Hidden",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_fade",
                "Hidden",
                false
            );
        }
    );


    // ========================================================
    // タイトル開始音
    // ========================================================

    Instance.EntFireAtName(
        "title_pip",
        "PlaySound"
    );


    Instance.Msg(
        "Title: ShowTitle"
    );


    await Instance.Delay(0.3);


    // ========================================================
    // 暗転解除
    // ========================================================

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_fade",
                "Hidden",
                true
            );
        }
    );


    StartBackgroundMove();


    // ========================================================
    // 英語タイトル出現
    // ========================================================

    await Instance.Delay(0.2);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_english",
                "TitleEnglishVisible",
                true
            );
        }
    );


    // 英語タイトル出現SE

    Instance.EntFireAtName(
        "title_text_pip",
        "PlaySound"
    );


    Instance.Msg(
        "Title: English Title Visible"
    );


    // ========================================================
    // 日本語タイトル出現
    //
    // ※ 日本語タイトルにはSEを鳴らさない
    // ========================================================

    await Instance.Delay(0.35);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_japanese",
                "TitleJapaneseVisible",
                true
            );
        }
    );


    Instance.Msg(
        "Title: Japanese Title Visible"
    );


    // ========================================================
    // 説明文1行目
    // ========================================================

    await Instance.Delay(0.45);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_01",
                "TitleDescriptionFirstVisible",
                true
            );
        }
    );


    // 説明文SE

    Instance.EntFireAtName(
        "title_text_pip",
        "PlaySound"
    );


    Instance.Msg(
        "Title: Description 01 Visible"
    );


    // ========================================================
    // 説明文2行目
    // ========================================================

    await Instance.Delay(0.12);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_02",
                "TitleDescriptionVisible",
                true
            );
        }
    );


    // 説明文SE

    Instance.EntFireAtName(
        "title_text_pip",
        "PlaySound"
    );


    Instance.Msg(
        "Title: Description 02 Visible"
    );


    // ========================================================
    // 説明文3行目
    // ========================================================

    await Instance.Delay(0.12);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_description_03",
                "TitleDescriptionVisible",
                true
            );
        }
    );


    // 説明文SE

    Instance.EntFireAtName(
        "title_text_pip",
        "PlaySound"
    );


    Instance.Msg(
        "Title: Description 03 Visible"
    );


    // ========================================================
    // SPECIAL THANKS
    // ========================================================

    await Instance.Delay(0.35);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_special_thanks",
                "TitleSpecialThanksVisible",
                true
            );
        }
    );


    Instance.Msg(
        "Title: Special Thanks Visible"
    );


    // ========================================================
    // サーバー名
    // ========================================================

    await Instance.Delay(0.2);


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_server_name",
                "TitleServerNameVisible",
                true
            );
        }
    );


    Instance.Msg(
        "Title: Server Name Visible"
    );


    await Instance.Delay(3.0);


    // ========================================================
    // 終了時の暗転開始
    // ========================================================

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_fade",
                "Hidden",
                false
            );
        }
    );


    Instance.Msg(
        "Title: Fade Out"
    );


    await Instance.Delay(1.0);


    await HideTitle();


    Instance.Msg(
        "Title: Auto Hide"
    );
}


// ============================================================
// タイトル非表示
// ============================================================
//
// まずTitleContainerを消す。
// その後、フェードアウト完了を待ってから
// 文字アニメーションのVisibleクラスを解除する。
// ============================================================

async function HideTitle()
{
    const hud =
        GetTitleHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_container",
                "Hidden",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "title_background_panel",
                "BackgroundMove",
                false
            );
        }
    );


    // TitleContainer transition 0.8s + 余裕0.1s

    await Instance.Delay(0.9);


    ResetTitleTextAnimation();


    ResetBackground();


    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "title_fade",
                "Hidden",
                false
            );
        }
    );


    Instance.Msg(
        "Title: HideTitle"
    );
}


// ============================================================
// Hammer
// RunScriptInput → Title01
// ============================================================

Instance.OnScriptInput(
    "Title01",
    () =>
    {
        SelectTitle01();
    }
);


// ============================================================
// Hammer
// RunScriptInput → Title02
// ============================================================

Instance.OnScriptInput(
    "Title02",
    () =>
    {
        SelectTitle02();
    }
);


// ============================================================
// Hammer
// RunScriptInput → HideTitle
// ============================================================

Instance.OnScriptInput(
    "HideTitle",
    () =>
    {
        HideTitle();
    }
);