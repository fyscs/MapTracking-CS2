/* Scenario05 */

Instance.OnScriptInput(
    "Scenario05",
    () =>
    {
        PlayScenario(
            "Scenario05"
        );
    }
);


/* 会話クリア */

Instance.OnScriptInput(
    "ClearDialogue",
    () =>
    {
        ClearDialogue();
    }
);

/* ラウンド切り替え時リセット */

Instance.OnScriptInput(
    "ResetDialogue",
    () =>
    {
        ClearDialogue();
    }
);

function PlayDialoguePip()
{
    const sound = Instance.FindEntityByName("dialogue_pip");

    if (!sound)
    {
        Instance.Msg("dialogue_pip NOT FOUND");
        return;
    }

    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}