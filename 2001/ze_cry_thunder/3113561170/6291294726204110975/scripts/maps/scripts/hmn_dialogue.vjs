/* =========================================================
   HUD取得
   ========================================================= */

function GetDialogueHud()
{
    if (
        dialogueHud === null ||
        !dialogueHud.IsValid()
    )
    {
        dialogueHud =
            Instance.FindEntitiesByName(HUD_NAME)[0];
    }

    return dialogueHud;
}


/* =========================================================
   全プレイヤー処理
   ========================================================= */

function ForEachPlayer(callback)
{
    for (const controller of Instance.GetAllPlayerControllers())
    {
        if (!controller)
        {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        callback(playerSlot);
    }
}


/* =========================================================
   テキスト
   ========================================================= */

function SetSlotText(
    hud,
    playerSlot,
    slot,
    name,
    message
)
{
    const nameVariable =
        "name_0" + slot;

    const messageVariable =
        "message_0" + slot;

    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        nameVariable,
        nameVariable,
        name
    );

    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        messageVariable,
        messageVariable,
        message
    );
}


/* =========================================================
   CSSクラス
   ========================================================= */

function SetSlotClass(
    hud,
    playerSlot,
    slot,
    className,
    enabled
)
{
    hud.SetHasClassForPlayer(
        playerSlot,
        "dialogue_slot_0" + slot,
        className,
        enabled
    );
}


/* =========================================================
   ポートレート
   ========================================================= */

function SetPortrait(
    hud,
    slot,
    character
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitA",
            character === "A"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitB",
            character === "B"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitC",
            character === "C"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitD",
            character === "D"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitE",
            character === "E"
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "ShowPortraitF",
            character === "F"
        );
    });
}


/* =========================================================
   話者状態
   ========================================================= */

function SetSpeakerState(
    hud,
    slot,
    active
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueSpeakerActive",
            false
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueSpeakerInactive",
            false
        );

        if (active)
        {
            SetSlotClass(
                hud,
                playerSlot,
                slot,
                "DialogueSpeakerActive",
                true
            );
        }
        else
        {
            SetSlotClass(
                hud,
                playerSlot,
                slot,
                "DialogueSpeakerInactive",
                true
            );
        }
    });
}


/* =========================================================
   スロット状態
   ========================================================= */

function ClearSlotStates(
    hud,
    playerSlot,
    slot
)
{
    const states =
    [
        "DialogueTop",
        "DialogueBottom",
        "DialogueStaging",
        "DialogueLeaving",
        "DialogueMovingUp",
        "DialogueEntering"
    ];

    for (const state of states)
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            false
        );
    }
}


function SetSlotState(
    hud,
    slot,
    state
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            true
        );

        ClearSlotStates(
            hud,
            playerSlot,
            slot
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            true
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            false
        );
    });
}


function SetSlotStateInstant(
    hud,
    slot,
    state
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            true
        );

        ClearSlotStates(
            hud,
            playerSlot,
            slot
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            state,
            true
        );

        SetSlotClass(
            hud,
            playerSlot,
            slot,
            "DialogueInstant",
            false
        );
    });
}


/* =========================================================
   テキスト設定
   ========================================================= */

function SetText(
    hud,
    slot,
    name,
    message
)
{
    ForEachPlayer((playerSlot) =>
    {
        SetSlotText(
            hud,
            playerSlot,
            slot,
            name,
            message
        );
    });
}


/* =========================================================
   HUD表示・非表示
   ========================================================= */

function ShowHud(hud)
{
    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "Hidden",
            false
        );
    });
}


function HideHud(hud)
{
    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "Hidden",
            true
        );
    });
}


/* =========================================================
   空きスロット検索
   ========================================================= */

function FindUnusedSlot(a, b)
{
    if (a !== 1 && b !== 1)
    {
        return 1;
    }

    if (a !== 2 && b !== 2)
    {
        return 2;
    }

    return 3;
}


/* =========================================================
   スロットリセット
   ========================================================= */

function ResetSlots(hud)
{
    for (let slot = 1; slot <= 3; slot++)
    {
        SetText(
            hud,
            slot,
            "",
            ""
        );

        SetPortrait(
            hud,
            slot,
            "A"
        );

        SetSpeakerState(
            hud,
            slot,
            false
        );

        SetSlotStateInstant(
            hud,
            slot,
            "DialogueStaging"
        );
    }
}


/* =========================================================
   最初の台詞
   ========================================================= */

async function ShowFirstDialogue(
    name,
    message,
    portrait,
    isFinal
)
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }

    const session =
        dialogueSession;

    ResetSlots(hud);

    SetText(
        hud,
        3,
        name,
        message
    );

    SetPortrait(
        hud,
        3,
        portrait
    );

    SetSpeakerState(
        hud,
        3,
        true
    );

    PlayDialoguePip();

    SetSlotState(
        hud,
        3,
        "DialogueStaging"
    );

    ShowHud(hud);

    await Instance.Delay(0.05);

    if (session !== dialogueSession)
    {
        return;
    }

    SetSlotState(
        hud,
        3,
        "DialogueBottom"
    );

    await Instance.Delay(
        ANIMATION_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    hasDialogue = true;

    topSlot = 0;
    bottomSlot = 3;
    stagingSlot = 1;

    if (isFinal)
    {
        await AutoHideDialogue(
            hud,
            session
        );
    }
}


/* =========================================================
   台詞1件の処理
   ========================================================= */

async function ProcessDialogue(
    character,
    message,
    isFinal
)
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }


    /* -----------------------------------------------------
       キャラクター情報取得
       ----------------------------------------------------- */

    const characterData =
        CHARACTERS[character];

    if (!characterData)
    {
        Instance.Msg(
            "ERROR: Character not found: " +
            character
        );

        return;
    }

    const name =
        characterData.name;

    const portrait =
        characterData.portrait;

    const session =
        dialogueSession;


    /* -----------------------------------------------------
       最初の台詞
       ----------------------------------------------------- */

    if (!hasDialogue)
    {
        await ShowFirstDialogue(
            name,
            message,
            portrait,
            isFinal
        );

        return;
    }


    /* -----------------------------------------------------
       まだ上段スロットが存在しない場合
       ----------------------------------------------------- */

    if (topSlot === 0)
    {
        const oldBottom =
            bottomSlot;

        const newSlot =
            stagingSlot;

        const newStaging =
            FindUnusedSlot(
                oldBottom,
                newSlot
            );

        SetText(
            hud,
            newSlot,
            name,
            message
        );

        SetPortrait(
            hud,
            newSlot,
            portrait
        );

        PlayDialoguePip();

        SetSpeakerState(
            hud,
            oldBottom,
            false
        );

        SetSpeakerState(
            hud,
            newSlot,
            true
        );

        SetSlotState(
            hud,
            oldBottom,
            "DialogueMovingUp"
        );

        SetSlotState(
            hud,
            newSlot,
            "DialogueEntering"
        );

        await Instance.Delay(
            ANIMATION_TIME
        );

        if (session !== dialogueSession)
        {
            return;
        }

        SetSlotStateInstant(
            hud,
            oldBottom,
            "DialogueTop"
        );

        SetSlotStateInstant(
            hud,
            newSlot,
            "DialogueBottom"
        );

        SetSlotStateInstant(
            hud,
            newStaging,
            "DialogueStaging"
        );

        topSlot =
            oldBottom;

        bottomSlot =
            newSlot;

        stagingSlot =
            newStaging;

        if (isFinal)
        {
            await AutoHideDialogue(
                hud,
                session
            );
        }

        return;
    }


    /* -----------------------------------------------------
       3スロット目まで使用している通常状態
       ----------------------------------------------------- */

    const oldTop =
        topSlot;

    const oldBottom =
        bottomSlot;

    const newSlot =
        stagingSlot;

    SetText(
        hud,
        newSlot,
        name,
        message
    );

    SetPortrait(
        hud,
        newSlot,
        portrait
    );

    PlayDialoguePip();

    SetSpeakerState(
        hud,
        oldTop,
        false
    );

    SetSpeakerState(
        hud,
        oldBottom,
        false
    );

    SetSpeakerState(
        hud,
        newSlot,
        true
    );

    SetSlotState(
        hud,
        oldTop,
        "DialogueLeaving"
    );

    SetSlotState(
        hud,
        oldBottom,
        "DialogueMovingUp"
    );

    SetSlotState(
        hud,
        newSlot,
        "DialogueEntering"
    );

    await Instance.Delay(
        ANIMATION_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    const newTop =
        oldBottom;

    const newBottom =
        newSlot;

    const newStaging =
        oldTop;

    SetSlotStateInstant(
        hud,
        newTop,
        "DialogueTop"
    );

    SetSlotStateInstant(
        hud,
        newBottom,
        "DialogueBottom"
    );

    SetSlotStateInstant(
        hud,
        newStaging,
        "DialogueStaging"
    );

    topSlot =
        newTop;

    bottomSlot =
        newBottom;

    stagingSlot =
        newStaging;

    if (isFinal)
    {
        await AutoHideDialogue(
            hud,
            session
        );
    }
}


/* =========================================================
   台詞追加
   ========================================================= */

function AddDialogue(
    character,
    message,
    isFinal = false
)
{
    dialogueQueue.push(
    {
        character: character,
        message: message,
        isFinal: isFinal
    });

    ProcessDialogueQueue();
}


/* =========================================================
   台詞キュー処理
   ========================================================= */

async function ProcessDialogueQueue()
{
    if (processingQueue)
    {
        return;
    }

    processingQueue = true;

    while (dialogueQueue.length > 0)
    {
        const dialogue =
            dialogueQueue.shift();

        await ProcessDialogue(
            dialogue.character,
            dialogue.message,
            dialogue.isFinal
        );

        if (!dialogue.isFinal)
        {
            await Instance.Delay(
                DIALOGUE_DISPLAY_DELAY
            );
        }
    }

    processingQueue = false;
}


/* =========================================================
   シナリオ再生
   ========================================================= */

function PlayScenario(scenarioName)
{
    const scenario =
        SCENARIOS[scenarioName];

    if (!scenario)
    {
        Instance.Msg(
            "ERROR: Scenario not found: " +
            scenarioName
        );

        return;
    }

    if (scenario.length === 0)
    {
        Instance.Msg(
            "ERROR: Scenario is empty: " +
            scenarioName
        );

        return;
    }

    for (
        let i = 0;
        i < scenario.length;
        i++
    )
    {
        const dialogue =
            scenario[i];

        const isFinal =
            i === scenario.length - 1;

        AddDialogue(
            dialogue.character,
            dialogue.message,
            isFinal
        );
    }
}


/* =========================================================
   自動非表示
   ========================================================= */

async function AutoHideDialogue(
    hud,
    session
)
{
    await Instance.Delay(
        AUTO_HIDE_DELAY
    );

    if (session !== dialogueSession)
    {
        return;
    }

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            true
        );
    });

    await Instance.Delay(
        AUTO_HIDE_FADE_TIME
    );

    if (session !== dialogueSession)
    {
        return;
    }

    hasDialogue = false;

    topSlot = 0;
    bottomSlot = 0;
    stagingSlot = 1;

    HideHud(hud);

    ForEachPlayer((playerSlot) =>
    {
        hud.SetHasClassForPlayer(
            playerSlot,
            "dialogue_container",
            "DialogueFadeOut",
            false
        );
    });

    ResetSlots(hud);
}


/* =========================================================
   会話クリア
   ========================================================= */

function ClearDialogue()
{
    const hud = GetDialogueHud();

    if (!hud)
    {
        Instance.Msg(
            "ERROR: hmn_dialogue_hud not found"
        );

        return;
    }

    dialogueSession++;

    dialogueQueue.length = 0;

    hasDialogue = false;

    topSlot = 0;
    bottomSlot = 0;
    stagingSlot = 1;

    ResetSlots(hud);

    HideHud(hud);
}


/* =========================================================
   RunScriptInput
   ========================================================= */


/* Scenario01 */

Instance.OnScriptInput(
    "Scenario01",
    () =>
    {
        PlayScenario(
            "Scenario01"
        );
    }
);


