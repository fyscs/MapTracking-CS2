// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";


// ==================================================
// Custom HUD
// ==================================================

const HUD_NAME =
    "hmn_boss_attack_hud";


// ==================================================
// 攻撃SE
// ==================================================

const ATTACK_SOUND_NAME =
    "boss_attack_pip";


// ==================================================
// 表示時間
// ==================================================

// 攻撃HUDを表示している時間
const ATTACK_DISPLAY_TIME = 3.0;


// ==================================================
// 最初の表示待ち時間
// ==================================================

const ATTACK_INITIAL_DELAY = 0.05;


// ==================================================
// 攻撃データ
// ==================================================

const ATTACK_DATA =
{
    // ----------------------------------------------
    // 攻撃01
    // ----------------------------------------------

    boss_attack01:
    {
        name:
            "災厄の波動",

        englishName:
            "WAVES OF DISASTER",

        danger:
            false
    },


    // ----------------------------------------------
    // 攻撃02
    // ----------------------------------------------

    boss_attack02:
    {
        name:
            "ゼニスドライヴ",

        englishName:
            "ZENITH DRIVE",

        danger:
            false
    },

    // ----------------------------------------------
    // 攻撃03
    // ----------------------------------------------

    boss_attack03:
    {
        name:
            "アッシュ・トゥ・アッシュ",

        englishName:
            "ASHES TO ASHES",

        danger:
            true
    }
};


// ==================================================
// HUD取得
// ==================================================

let attackHud = null;


function GetAttackHud()
{
    if (
        attackHud === null ||
        !attackHud.IsValid()
    )
    {
        const entities =
            Instance.FindEntitiesByName(
                HUD_NAME
            );

        if (
            !entities ||
            entities.length === 0
        )
        {
            Instance.Msg(
                "ERROR: hmn_boss_attack_hud not found"
            );

            return null;
        }

        attackHud = entities[0];
    }

    return attackHud;
}


// ==================================================
// 全プレイヤー処理
// ==================================================

function ForEachPlayer(callback)
{
    for (
        const controller
        of Instance.GetAllPlayerControllers()
    )
    {
        if (!controller)
            continue;

        callback(
            controller.GetPlayerSlot()
        );
    }
}


// ==================================================
// 攻撃SE再生
// ==================================================

function PlayAttackPip()
{
    const sound =
        Instance.FindEntityByName(
            ATTACK_SOUND_NAME
        );

    if (!sound)
    {
        Instance.Msg(
            "ERROR: boss_attack_pip not found"
        );

        return;
    }

    Instance.EntFireAtTarget(
        sound,
        "PlaySound"
    );
}


// ==================================================
// ウィンドウ切り替え
// ==================================================

function SetAttackWindow(
    hud,
    danger
)
{
    ForEachPlayer(
        (playerSlot) =>
        {
            // --------------------------------------
            // 通常攻撃ウィンドウ
            // --------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowHidden",
                danger
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowVisible",
                !danger
            );


            // --------------------------------------
            // 危険攻撃ウィンドウ
            // --------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowHidden",
                !danger
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowVisible",
                danger
            );
        }
    );
}


// ==================================================
// 攻撃表示
// ==================================================

async function ShowBossAttack(
    attackId
)
{
    const hud =
        GetAttackHud();

    if (!hud)
        return;


    // ----------------------------------------------
    // 攻撃データ取得
    // ----------------------------------------------

    const attack =
        ATTACK_DATA[attackId];


    if (!attack)
    {
        Instance.Msg(
            "ERROR: Unknown boss attack: "
            + attackId
        );

        return;
    }


    // ----------------------------------------------
    // ウィンドウを選択
    // ----------------------------------------------

    SetAttackWindow(
        hud,
        attack.danger
    );


    // ----------------------------------------------
    // 日本語・英語を最初から表示状態にする
    // ----------------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_name",
                "DialogueHidden",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_english",
                "DialogueHidden",
                false
            );
        }
    );


    // ----------------------------------------------
    // 日本語攻撃名
    // ----------------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "attack_name",
                "attack_name",
                attack.name
            );
        }
    );


    // ----------------------------------------------
    // 英語攻撃名
    // ----------------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetDialogVariableStringForPlayer(
                playerSlot,
                "attack_english",
                "attack_english",
                attack.englishName
            );
        }
    );


    // ----------------------------------------------
    // HUD表示
    //
    // ウィンドウ・日本語・英語を
    // すべて同時に表示
    // ----------------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                false
            );
        }
    );


    // ----------------------------------------------
    // 少しだけ待つ
    // ----------------------------------------------

    await Instance.Delay(
        ATTACK_INITIAL_DELAY
    );


    // ----------------------------------------------
    // 攻撃SE
    // ----------------------------------------------

    PlayAttackPip();


    Instance.Msg(
        "BossAttack: "
        + attackId
    );


    // ----------------------------------------------
    // 表示維持
    // ----------------------------------------------

    await Instance.Delay(
        ATTACK_DISPLAY_TIME
    );


    // ----------------------------------------------
    // ウィンドウ・文字を同時に退場
    // ----------------------------------------------

    ForEachPlayer(
        (playerSlot) =>
        {
            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                true
            );
        }
    );


    Instance.Msg(
        "BossAttack: Hidden"
    );
}


// ==================================================
// 強制非表示
// ==================================================

function HideBossAttack()
{
    const hud =
        GetAttackHud();

    if (!hud)
        return;


    ForEachPlayer(
        (playerSlot) =>
        {
            // --------------------------------------
            // HUD全体を非表示
            // --------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_container",
                "Hidden",
                true
            );


            // --------------------------------------
            // 文字も初期状態へ戻す
            // --------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_name",
                "DialogueHidden",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_english",
                "DialogueHidden",
                true
            );


            // --------------------------------------
            // ウィンドウも初期状態へ戻す
            // --------------------------------------

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowHidden",
                false
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_normal",
                "AttackWindowVisible",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowHidden",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "attack_window_danger",
                "AttackWindowVisible",
                false
            );
        }
    );


    Instance.Msg(
        "BossAttack: Hidden"
    );
}


// ==================================================
// Hammer → RunScriptInput
// ==================================================


// ----------------------------------------------
// Boss Attack 01
// ----------------------------------------------

Instance.OnScriptInput(
    "boss_attack01",
    () =>
    {
        ShowBossAttack(
            "boss_attack01"
        );
    }
);


// ----------------------------------------------
// Boss Attack 02
// ----------------------------------------------

Instance.OnScriptInput(
    "boss_attack02",
    () =>
    {
        ShowBossAttack(
            "boss_attack02"
        );
    }
);


// ----------------------------------------------
// Boss Attack 03
// ----------------------------------------------

Instance.OnScriptInput(
    "boss_attack03",
    () =>
    {
        ShowBossAttack(
            "boss_attack03"
        );
    }
);


// ----------------------------------------------
// 強制非表示
// ----------------------------------------------

Instance.OnScriptInput(
    "HideBossAttack",
    () =>
    {
        HideBossAttack();
    }
);