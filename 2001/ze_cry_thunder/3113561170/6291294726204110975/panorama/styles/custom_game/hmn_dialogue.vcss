.Root {
    width: 100%;
    height: 100%;
}
#dialogue_container {
    width: 800px;
    height: 220px;
    horizontal-align: left;
    vertical-align: bottom;
    margin-left: 20px;
    margin-bottom: 485px;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}
#dialogue_container.Hidden {
    visibility: collapse;
    opacity: 0.0;
}
#dialogue_container.DialogueFadeOut {
    opacity: 0.0;
}
.DialogueViewport {
    width: 100%;
    height: 220px;
    overflow: noclip;
}
.DialogueTrack {
    width: 100%;
    height: 330px;
    flow-children: down;
}
.DialogueSlot {
    width: 100%;
    height: 100px;
    margin-bottom: 10px;
    flow-children: right;
    opacity: 1.0;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(#00000038), color-stop(0.75, #00000038), to(#00000003) );
    border: 1px solid #FFFFFF01;
    border-radius: 6px;
    overflow: clip;
    transition-property: transform, opacity;
    transition-duration: 0.65s;
    transition-timing-function: cubic-bezier(0.22, 0.75, 0.25, 1.0);
}
.Portrait {
    width: 200px;
    height: 200px;
    margin-left: 10px;
    margin-right: 15px;
    vertical-align: center;
    opacity: 0.72;
    opacity-mask: url("s2r://panorama/images/custom_game/portrait_fade_mask_200_png.vtex");
    transform: scale3d(0.97, 0.97, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
.DialogueSlot.DialogueSpeakerActive .Portrait {
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
}
.DialogueSlot.DialogueSpeakerInactive .Portrait {
    opacity: 0.62;
    transform: scale3d(0.97, 0.97, 1.0);
}
.DialogueText {
    width: fill-parent-flow(1.0);
    height: 100%;
    flow-children: down;
    vertical-align: center;
    padding-left: 4px;
    padding-right: 14px;
    padding-top: 0px;
    padding-bottom: 0px;
}
.Name {
    font-size: 24px;
    color: white;
    margin-bottom: 2px;
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 6px #000000FF;
    transition-property: color, font-size, opacity, text-shadow;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.Message {
    font-size: 20px;
    color: white;
    opacity: 0.0;
    transform: translateY(4px);
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 8px #000000FF;
    transition-property: opacity, transform;
    transition-duration: 0.30s;
    transition-delay: 0.08s;
    transition-timing-function: ease-out;
    line-height: 20px;
}
.DialogueSlot.DialogueTop .Message,.DialogueSlot.DialogueBottom .Message,.DialogueSlot.DialogueMovingUp .Message,.DialogueSlot.DialogueEntering .Message {
    opacity: 1.0;
    transform: translateY(0px);
}
.DialogueSlot.DialogueLeaving .Message {
    opacity: 0.0;
    transform: translateY(-3px);
}
