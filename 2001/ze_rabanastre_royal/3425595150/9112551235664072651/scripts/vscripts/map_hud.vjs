import { Instance } from "cs_script/point_script";

const HUD_ENTITY_NAME = "map_hud";          
const OP_MAX = 10;                          
const FADE_STEP_DT = 0.05;                  

let hud = null;
let opLevel = 0;                            
let fadeTarget = 0;                         
let fading = false;                         

function applyOp() {
    if (!hud || !hud.IsValid()) return;
    for (let i = 0; i <= OP_MAX; i++) {
        hud.SetHasClass("Map_Hud_root", "Op" + i, i === opLevel);
    }
}

function onThink() {
    const gt = Instance.GetGameTime();
    let nextT = -1;

if (fading) {
        if (opLevel < fadeTarget) opLevel++;
        else if (opLevel > fadeTarget) opLevel--;
        applyOp();
        if (opLevel !== fadeTarget) {
            nextT = gt + FADE_STEP_DT;      
        } else {
            fading = false;
            if (opLevel === 0 && hud && hud.IsValid()) {
                hud.SetHasClass("Map_Hud_root", "Visible", false);
            }
        }
    }

if (lyrPlaying) {
        const now = gt - songStart;
        while (evIdx < events.length && events[evIdx].t <= now) {
            try {
                events[evIdx].fn();
            } catch (e) {
                Instance.Msg("[MAP_HUD] 歌词事件异常 idx=" + evIdx + ": " + e);
            }
            evIdx++;
        }
        if (evIdx < events.length) {
            const t = songStart + events[evIdx].t;
            if (nextT < 0 || t < nextT) nextT = t;
        }
    }

if (kwPlaying) {
        const now = gt - kwStart;
        while (kwIdx < kwEvents.length && kwEvents[kwIdx].t <= now) {
            try {
                kwEvents[kwIdx].fn();
            } catch (e) {
                Instance.Msg("[MAP_HUD] 图片歌词事件异常 idx=" + kwIdx + ": " + e);
            }
            kwIdx++;
        }
        if (kwIdx < kwEvents.length) {
            const t = kwStart + kwEvents[kwIdx].t;
            if (nextT < 0 || t < nextT) nextT = t;
        }
    }

if (nextT > 0) {
        Instance.SetNextThink(nextT > gt + 0.02 ? nextT : gt + 0.02);
    }
}

function kickThink() {
    Instance.SetNextThink(Instance.GetGameTime() + 0.02);
}

function startFade(target) {
    fadeTarget = target;
    if (!fading) {
        fading = true;
        kickThink();
    }
}

function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        Instance.Msg("[MAP_HUD] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

Instance.OnScriptInput("info_start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    if (hud && hud.IsValid()) hud.SetHasClass("Map_Hud_root", "Visible", true);
    if (opLevel === 0) applyOp();           
    startFade(OP_MAX);
});

Instance.OnScriptInput("info_end", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    startFade(0);
});

Instance.OnScriptInput("test", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    if (fadeTarget === OP_MAX) {
        startFade(0);                       
    } else {
        if (hud && hud.IsValid()) hud.SetHasClass("Map_Hud_root", "Visible", true);
        if (opLevel === 0) applyOp();
        startFade(OP_MAX);                  
    }
});

Instance.OnRoundStart(() => {
    fading = false;
    opLevel = 0;
    fadeTarget = 0;
    if (hud && hud.IsValid()) {
        hud.SetHasClass("Map_Hud_root", "Visible", false);
        applyOp();
        hideStages();
    }
    stopLyrics();
    kwStop();
});

const STAGE_IDS = ["1", "2", "3", "4", "zm"];

function showStage(id) {
    if (!hud || !hud.IsValid()) return;
    for (const s of STAGE_IDS) {
        hud.SetHasClass("Stage_root_" + s, "Visible", s === id);
    }
}

function hideStages() {
    if (!hud || !hud.IsValid()) return;
    for (const s of STAGE_IDS) {
        hud.SetHasClass("Stage_root_" + s, "Visible", false);
    }
}

Instance.OnScriptInput("stage1", () => { if (!hud || !hud.IsValid()) findHud(); showStage("1"); });
Instance.OnScriptInput("stage2", () => { if (!hud || !hud.IsValid()) findHud(); showStage("2"); });
Instance.OnScriptInput("stage3", () => { if (!hud || !hud.IsValid()) findHud(); showStage("3"); });
Instance.OnScriptInput("stage4", () => { if (!hud || !hud.IsValid()) findHud(); showStage("4"); });
Instance.OnScriptInput("stage_zm", () => { if (!hud || !hud.IsValid()) findHud(); showStage("zm"); });
Instance.OnScriptInput("stage_hide", () => { hideStages(); });

const JP_SLOTS = 41;                        
const CN_SLOTS = 24;                        
const END_HIDE_DELAY = 1.5;                 
const LINE_HIDE_DELAY = 3.0;                
const FILL_STEPS = 25;                      
const STEP_DT    = 0.04;                    

let lyrPlaying = false;
let playRun = 0;
let songStart = 0;
let events = [];
let evIdx = 0;
let curLine = -1;
const jpFill = [];
const cnFill = [];
for (let i = 0; i <= JP_SLOTS; i++) jpFill.push(0);
for (let i = 0; i <= CN_SLOTS; i++) cnFill.push(0);

function cls(id, name, on) {
    if (hud && hud.IsValid()) hud.SetHasClass(id, name, on);
}

function setText(prefix, i, ch) {
    if (!hud || !hud.IsValid()) return;
    if (ch === "") ch = " ";
    const v = prefix + "_c" + i;
    hud.SetDialogVariableString(prefix + "_slot_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_base_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_top_" + i, v, ch);
}

function setJpSize(count, isEng) {
    cls("lyric_jp", "Eng", !!isEng);
    cls("lyric_jp", "SizeB", !isEng && count > 20 && count <= 30);
    cls("lyric_jp", "SizeC", !isEng && count > 30);
}

function engWidthClass(ch) {
    const code = ch.charCodeAt(0);
    if (code >= 65 && code <= 90) {
        if (code === 77 || code === 87) return "EW-w";
        if (code === 73 || code === 74) return "EW-n";
        return "EW-m";
    }
    if (code >= 97 && code <= 122) {
        if (code === 109 || code === 119) return "EW-w";
        if ("iljtf".indexOf(ch) >= 0) return "EW-n";
        return "EW-m";
    }
    if (ch === "." || ch === "," || ch === "'" || ch === "!" || ch === ":" || ch === ";") return "EW-n";
    return "EW-m";
}

function showLine(idx) {
    const line = LYRICS[idx];
    curLine = idx;
    cls("Lyrics_root", "Visible", true);    

for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
    for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);

const jpN = Math.min(line.jp.length, JP_SLOTS);
    const cnN = Math.min(line.cn.length, CN_SLOTS);
    try {
        for (let i = 1; i <= JP_SLOTS; i++) {
            const used = i <= jpN;
            cls("jp_slot_" + i, "Hidden", !used);
            const isSpc = used && line.jp[i - 1][2] === " ";
            cls("jp_slot_" + i, "Spc", isSpc);
            const ew = (used && !isSpc) ? engWidthClass(line.jp[i - 1][2]) : "";
            cls("jp_slot_" + i, "EW-n", ew === "EW-n");
            cls("jp_slot_" + i, "EW-m", ew === "EW-m");
            cls("jp_slot_" + i, "EW-w", ew === "EW-w");
            setText("jp", i, used ? line.jp[i - 1][2] : " ");
        }
        for (let i = 1; i <= CN_SLOTS; i++) {
            const used = i <= cnN;
            cls("cn_slot_" + i, "Hidden", !used);
            setText("cn", i, used ? line.cn[i - 1][2] : " ");
        }
    } catch (e) {
        Instance.Msg("[MAP_HUD] 写字异常: " + e);
    }

let asciiCnt = 0, letterCnt = 0;
    for (let k = 0; k < line.jp.length && k < JP_SLOTS; k++) {
        const ch = line.jp[k][2];
        if (!ch || ch === " ") continue;
        letterCnt++;
        const code = ch.charCodeAt(0);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) asciiCnt++;
    }
    setJpSize(jpN, letterCnt > 0 && asciiCnt * 2 > letterCnt);
}

function setFillStep(isJp, slotIdx, step) {
    if (step < 0) step = 0;
    if (step > FILL_STEPS) step = FILL_STEPS;
    const arr = isJp ? jpFill : cnFill;
    if (arr[slotIdx] === step) return;
    const clipId = (isJp ? "jp_clip_" : "cn_clip_") + slotIdx;
    if (arr[slotIdx] > 0) cls(clipId, "F" + arr[slotIdx], false);
    if (step > 0) cls(clipId, "F" + step, true);
    arr[slotIdx] = step;
}

function addFillEvents(c, slot, isJp, lineIdx) {
    const dur = c[1] - c[0];
    if (dur <= 0.001) {
        events.push({ t: c[0], p: 1, fn: ((s2, j2, li) => () => { if (li === curLine) setFillStep(j2, s2, FILL_STEPS); })(slot, isJp, lineIdx) });
        return;
    }
    let n = Math.round(dur / STEP_DT);
    if (n < 4) n = 4;
    if (n > FILL_STEPS) n = FILL_STEPS;
    const dt = dur / n;
    for (let i = 1; i <= n; i++) {
        const step = Math.round(i * FILL_STEPS / n);
        events.push({ t: c[0] + i * dt, p: 1, fn: ((s2, j2, st, li) => () => { if (li === curLine) setFillStep(j2, s2, st); })(slot, isJp, step, lineIdx) });
    }
}

function makeLineHide(li) {
    return function () {
        if (li === curLine) cls("Lyrics_root", "Visible", false);
    };
}

function buildEvents() {
    events = [];
    for (let i = 0; i < LYRICS.length; i++) {
        const line = LYRICS[i];
        events.push({ t: line.t0, p: 0, fn: (li => () => showLine(li))(i) });
        for (let k = 0; k < line.jp.length; k++) addFillEvents(line.jp[k], k + 1, true, i);

if (line.align === false) {
            for (let k = 0; k < line.cn.length; k++) addFillEvents(line.cn[k], k + 1, false, i);
        } else if (line.cn.length > 0 && line.jp.length > 0) {
            const jpS = line.jp[0][0];
            let jpE = jpS;
            for (const c of line.jp) if (c[1] > jpE) jpE = c[1];
            const cnS = line.cn[0][0];
            let cnE = cnS;
            for (const c of line.cn) if (c[1] > cnE) cnE = c[1];
            const k2 = (cnE > cnS && jpE > jpS) ? (jpE - jpS) / (cnE - cnS) : 1;
            for (let k = 0; k < line.cn.length; k++) {
                const c = line.cn[k];
                addFillEvents(k2 === 1 ? c : [jpS + (c[0] - cnS) * k2, jpS + (c[1] - cnS) * k2, c[2]], k + 1, false, i);
            }
        } else {
            for (let k = 0; k < line.cn.length; k++) addFillEvents(line.cn[k], k + 1, false, i);
        }
        let lineEnd = line.t0;
        for (const c of line.jp) if (c[1] > lineEnd) lineEnd = c[1];
        events.push({ t: lineEnd + LINE_HIDE_DELAY, p: 2, fn: makeLineHide(i) });
    }
    const last = LYRICS[LYRICS.length - 1];
    let end = last.t0;
    for (const c of last.jp) if (c[1] > end) end = c[1];
    for (const c of last.cn) if (c[1] > end) end = c[1];
    events.push({ t: end + END_HIDE_DELAY, p: 2, fn: () => { stopLyrics(); } });
    events.sort((a, b) => (a.t - b.t) || (a.p - b.p));
}

function stopLyrics() {
    lyrPlaying = false;
    curLine = -1;
    evIdx = events.length;
    playRun++;
    if (hud && hud.IsValid()) {
        hud.SetHasClass("Lyrics_root", "Visible", false);
    }
}

Instance.OnScriptInput("music_start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    kwStop();
    kwBuild();
    kwIdx = 0;
    kwPlaying = true;
    kwStart = Instance.GetGameTime();
    kickThink();
    Instance.Msg("[MAP_HUD] music_start 图片歌词演示");
});

Instance.OnScriptInput("music_end", () => {
    kwStop();
    stopLyrics();
    Instance.Msg("[MAP_HUD] music_end");
});

