const KW_END_T = 114.0;   
let kwPlaying = false;
let kwStart = 0;
let kwEvents = [];
let kwIdx = 0;
let kwUnitNow = 0;

let kwCurW = new Array(14).fill(0);   

function setKwSweep(u, p) {
    if (p < 0) p = 0;
    if (p > 400) p = 400;
    const sw = "Kw_sweep_" + u;
    if (kwCurW[u]) cls(sw, "W" + kwCurW[u], false);
    if (p > 0) cls(sw, "W" + p, true);
    kwCurW[u] = p;
}

function kwShowUnit(u) {
    for (let i = 1; i <= KW_UNITS.length; i++) cls("Kw_box_" + i, "Hidden", i !== u);
    kwUnitNow = u;
}

function kwBuild() {
    kwEvents = [];
    for (let i = 0; i < KW_UNITS.length; i++) {
        const n = i + 1;
        const showT = KW_UNITS[i][0];
        kwEvents.push({ t: showT, fn: ((nn) => () => {
            cls("Kw_root", "Visible", true);
            kwShowUnit(nn);
        })(n) });
        for (const e of KW_UNITS[i][1]) {
            kwEvents.push({ t: e[0], fn: ((nn, p) => () => {
                if (kwUnitNow === nn) setKwSweep(nn, p);
            })(n, e[1]) });
        }
    }
    kwEvents.push({ t: KW_END_T, fn: () => { kwStop(); } });
    kwEvents.sort((a, b) => a.t - b.t);
}

function kwStop() {
    kwPlaying = false;
    kwIdx = kwEvents.length;
    if (hud && hud.IsValid()) {
        hud.SetHasClass("Kw_root", "Visible", false);
    }
}

for (let i = 1; i <= KW_UNITS.length; i++) {
    Instance.OnScriptInput("kwunit" + i, ((nn) => () => {
        if (!hud || !hud.IsValid()) findHud();
        if (!hud) return;
        cls("Kw_root", "Visible", true);
        kwShowUnit(nn);
        setKwSweep(nn, 400);
        Instance.Msg("[MAP_HUD] kwunit" + nn + "：应看到该单元整行蓝图");
    })(i));
}

Instance.OnScriptInput("kwtest", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    cls("Kw_root", "Visible", true);
    kwShowUnit(1);
    setKwSweep(1, 200);
    Instance.Msg("[MAP_HUD] kwtest：第1单元左半蓝右半暗");
});

Instance.OnScriptInput("kwfull", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    cls("Kw_root", "Visible", true);
    kwShowUnit(1);
    setKwSweep(1, 400);
    Instance.Msg("[MAP_HUD] kwfull：第1单元双层完全重叠，不应露白");
});

Instance.OnScriptInput("kwdimonly", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    cls("Kw_root", "Visible", true);
    kwShowUnit(1);
    setKwSweep(1, 0);
    hud.SetHasClass("Kw_dim_1", "Hidden", false);
    Instance.Msg("[MAP_HUD] kwdimonly：只应看到白图");
});
Instance.OnScriptInput("kwblueonly", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    cls("Kw_root", "Visible", true);
    kwShowUnit(1);
    hud.SetHasClass("Kw_dim_1", "Hidden", true);
    setKwSweep(1, 400);
    Instance.Msg("[MAP_HUD] kwblueonly：只应看到蓝图");
});

const LYRICS = [
];

Instance.SetThink(onThink);
