import * as CS from "cs_script/point_script";

const Instance = CS.Instance;
const Console = CS.Console;
const CSGearSlot = CS.CSGearSlot;

const log = (typeof Console !== "undefined" && Console.Log)
    ? Console.Log.bind(Console)
    : Instance.Msg.bind(Instance);

function asPawn(ent) {
    if (!ent) return undefined;
    try { if (typeof ent.IsValid === "function" && !ent.IsValid()) return undefined; } catch (e) { }
    if (typeof ent.GetPlayerPawn === "function") return ent.GetPlayerPawn();
    if (typeof ent.GetPlayerController === "function") {
        return ent.GetPlayerController()?.GetPlayerPawn();
    }
    return ent;
}

function findKnife(pawn) {
    let knife = undefined;
    try { knife = pawn.FindWeaponBySlot(CSGearSlot.KNIFE); } catch (e) { }
    if (!knife) {
        try { knife = pawn.FindWeapon("weapon_knife"); } catch (e) { }
    }
    return knife || undefined;
}

function destroyKnife(pawn, tag) {
    const knife = findKnife(pawn);
    if (!knife) {
        log("[DROP] " + tag + ": this player has no knife");
        return false;
    }
    pawn.DestroyWeapon(knife);
    log("[DROP] " + tag + ": knife destroyed");
    return true;
}

Instance.OnScriptInput("DropWeapon", ({ activator }) => {

    if (activator?.IsValid()) {
        const player = activator;
        const player_c = player?.GetPlayerController();
        const player_p = player_c?.GetPlayerPawn();
        const active_weapon = player_p?.GetActiveWeapon();
        if (active_weapon) {
            player_p?.DropWeapon(active_weapon);
        }
    }
});

Instance.OnScriptInput("drop_knife", ({ activator }) => {
    const pawn = asPawn(activator);
    if (!pawn) { log("[DROP] drop_knife: no activator player"); return; }
    destroyKnife(pawn, "drop_knife");
});
