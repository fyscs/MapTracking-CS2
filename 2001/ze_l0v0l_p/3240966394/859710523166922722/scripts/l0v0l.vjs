import { Instance } from 'cs_script/point_script'

let l0v0lWeapon

Instance.OnScriptInput("RegisterL0v0lWeapon", () => {
    l0v0lWeapon = Instance.FindEntityByName("l0v0l_elite")
})

Instance.OnScriptInput("CheckL0v0l", (context) => {
    if (context.activator.FindWeaponBySlot(1)){
        let playerPistol = context.activator.FindWeaponBySlot(1)
        if (playerPistol == l0v0lWeapon){
            Instance.EntFireAtName({name: "lvl6_branch", input: "SetValue", value: 0})
        }
    }
})

Instance.OnScriptInput("BossExplosion", (context) => {
    let maker = Instance.FindEntityByName("bosslvl3_exp1_maker")
    let relay = Instance.FindEntityByName("bosslvl3_exp1_relay")
    maker.Teleport({position: context.activator.GetAbsOrigin()})
    Instance.EntFireAtTarget({target: relay, input: "Trigger", delay: 0.05})
})
