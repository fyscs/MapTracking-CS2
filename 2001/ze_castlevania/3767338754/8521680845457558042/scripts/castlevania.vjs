            Boss_Angle_backup = "CorrectAngle_minus90_Boss3";
            Instance.EntFireAtTarget({ target: script_ent, input: "RunScriptInput", value: "CorrectAngle_minus90_Boss3", delay: 0.10 });
            Boss_Angle_retries--;

            const pos = Boss_Angle_bossphys.GetAbsOrigin();
