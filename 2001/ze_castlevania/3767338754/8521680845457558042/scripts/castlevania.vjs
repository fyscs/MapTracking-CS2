});

Instance.OnScriptInput("Npc_Archer_LaunchingArrow", ({caller, activator}) => {
    if(caller?.IsValid())
    {
        const caller_name = caller?.GetEntityName();
        const suffix = caller_name.slice(caller_name.lastIndexOf("_"));
