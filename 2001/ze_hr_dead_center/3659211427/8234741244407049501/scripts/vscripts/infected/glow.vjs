import { BaseModelEntity, CSPlayerPawn, Instance, PointTemplate, Entity } from "cs_script/point_script";

/**
 * 高亮脚本
 * 此脚本由皮皮猫233编写
 * 2026/7/18
 */

/** @type {Map<CSPlayerPawn, Entity[]>} */
const players = new Map();
const Colors = [
    { r: 255, g: 0, b: 0 },
    { r: 255, g: 150, b: 0 },
];

for (const color of Colors) {
    Instance.OnScriptInput(`Glow(${color.r}, ${color.g}, ${color.b})`, (inputData) => Glow(/** @type {CSPlayerPawn|undefined} */ (inputData.activator), color));
}

Instance.OnScriptInput("Unglow", (inputData) => {
    const player = /** @type {CSPlayerPawn|undefined} */ (inputData.activator);
    if (!player || !player.IsValid()) return;
    if (!players.has(player)) return;
    const entities = players.get(player);
    if (!entities) return;
    for (const entity of entities) Instance.EntFireAtTarget({ target: entity, input: "Kill" });
    players.delete(player);
});

/**
 * 高亮
 * @param {CSPlayerPawn|undefined} player 
 * @param {import("cs_script/point_script").ColorArg} color 
 */
function Glow(player, color) {
    if (!player || !player.IsValid()) return;
    if (players.has(player)) return;
    const temp = /** @type {PointTemplate} */ (Instance.FindEntityByName("glow_model_temp"));
    const entities1 = temp.ForceSpawn(player.GetAbsOrigin(), player.GetAbsAngles());
    if (!entities1) return;
    const entities2 = /** @type {BaseModelEntity[]} */ (temp.ForceSpawn(player.GetAbsOrigin(), player.GetAbsAngles()));
    if (!entities2) return;
    const model1 = entities1[0];
    const model2 = entities2[0];
    players.set(player, [model1, model2]);
    Instance.EntFireAtTarget({ target: model1, input: "FollowEntity", value: "!activator", activator: player });
    Instance.EntFireAtTarget({ target: model2, input: "FollowEntity", value: "!activator", activator: model1 });
    model2.SetModel(player.GetModelName());
    model2.Glow(color);
}