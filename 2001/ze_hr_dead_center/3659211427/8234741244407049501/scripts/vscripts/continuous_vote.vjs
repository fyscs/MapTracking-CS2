import { Instance } from "cs_script/point_script";

/**
 * 连关投票脚本
 * 此脚本由皮皮猫233编写
 * 2026/7/5
 */

let voteToggle = false;
const votePlayers = new Set();

Instance.OnPlayerReset(() => {
    if (voteToggle) return;
    const players = Instance.FindEntitiesByClass("player");
    if (players.length >= 55) {
        Instance.ServerCommand('say **人数达到投票人数，在聊天框输入"!lg"来进行连关开启投票，投票人数超过35人将直接开启连关模式**');
        voteToggle = true;
    }
});

Instance.OnPlayerChat((event) => {
    if (!voteToggle || !event.player || !event.player.IsValid()) return;
    if (event.text === "!lg" && !votePlayers.has(event.player)) {
        votePlayers.add(event.player.GetPlayerSlot());
        Instance.ServerCommand(`say **>> ${Sanitize(event.player.GetPlayerName())} <<想要开启连关模式，当前票数${votePlayers.size}/35**`);
        if (votePlayers.size >= 35) EndVote();
    }
});

Instance.OnPlayerDisconnect((event) => {
    votePlayers.delete(event.playerSlot);
});

/**
 * 投票结算
 */
function EndVote() {
    Instance.EntFireAtName({ name: "stage_continuous_init_branch", input: "SetValueTest", value: 1 });
    Instance.EntFireAtName({ name: "continuous_vote_script", input: "Kill" });
}

/**
 * 移除常见危险字符防止注入
 * @param {string} str 
 * @returns 
 */
function Sanitize(str) {
    return str.replace(/[";`$\\\n\r]/g, ""); // 
}