// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

/* ze_scp — game_text → custom_hud_layout (Map_Hud).
 *
 * Карта вызывает:  Map_Script > RunScriptInput > <имя game_text>   (вместо <game_text> > Display)
 * Тексты лежат статикой в scp_hud.xml, скрипт только переключает классы.
 *
 *  game_text        все/активатор  канал  y     holdtime   → панель
 *  mapbytext        все            3      0.2   4          hud_mapbytext
 *  mapbytext_2      все            4      0.3   4          hud_mapbytext_2
 *  layer_text       все            3      0.0   ∞          hud_layer (L1, глобальный класс)
 *  layer2_text      активатор      3      0.0   ∞          hud_layer (L2, класс игрока)
 *  layer3_text      активатор      3      0.0   ∞          hud_layer (L3)
 *  layer4_text      активатор      3      0.0   ∞          hud_layer (L4)
 *  layer5_text      активатор      3      0.0   ∞          hud_layer (L5)
 *  layerExit_text   активатор      3      0.0   ∞          hud_layer (LExit)
 *  106_dem_text     активатор      3      0.0   ∞          hud_layer (D106)
 *
 * Все layer-тексты на одном канале и в одном месте экрана, поэтому это одна панель: новый текст заменяет старый,
 * как в game_text. На игрока держится максимум одна запись (текущий класс), старая снимается.
 */

const SCRIPT_NAME = "Map_Script";
const HUD_NAME = "Map_Hud";

// ---------------------------------------------------------------- ядро

let ROUND_ID = 0;
let SELF_ENT = undefined;
let HUD_ENT = undefined;

function Self()
{
    if(!SELF_ENT?.IsValid()) SELF_ENT = Instance.FindEntityByName(SCRIPT_NAME);
    return SELF_ENT;
}

function Hud()
{
    if(!HUD_ENT?.IsValid()) HUD_ENT = Instance.FindEntityByName(HUD_NAME);
    return HUD_ENT;
}

// Задержка через очередь I/O на самого себя — чистится на рестарте раунда
const LATER_QUEUE = [];
let LATER_SEQ = 0;

function Later(delay, fn)
{
    const self = Self();
    if(!self) return;
    const d = Math.max(0, Number(delay) || 0);
    LATER_QUEUE.push({ time: Instance.GetGameTime() + d, seq: LATER_SEQ++, round: ROUND_ID, fn });
    Instance.EntFireAtTarget({ target: self, input: "RunScriptInput", value: "__later", delay: d });
}

Instance.OnScriptInput("__later", () => {
    const now = Instance.GetGameTime() + 0.005;
    const due = [];
    for(let i = LATER_QUEUE.length - 1; i >= 0; i--)
    {
        const c = LATER_QUEUE[i];
        if(c.round !== ROUND_ID) { LATER_QUEUE.splice(i, 1); continue; }
        if(c.time <= now) { due.push(c); LATER_QUEUE.splice(i, 1); }
    }
    due.sort((a, b) => (a.time - b.time) || (a.seq - b.seq));
    for(const c of due)
    {
        try { c.fn(); }
        catch(e) { Instance.Msg(`[scp_hud] ${e}`); }
    }
});

function SlotOf(pawn)
{
    if(!pawn?.IsValid() || typeof pawn.GetPlayerController !== "function") return undefined;
    return (pawn.GetPlayerController() ?? pawn.GetOriginalPlayerController())?.GetPlayerSlot();
}

// ---------------------------------------------------------------- тексты на время (все игроки)

const TIMED_TEXTS = {
    mapbytext:   { panel: "hud_mapbytext",   fadein: 1.5, hold: 4 },
    mapbytext_2: { panel: "hud_mapbytext_2", fadein: 1.5, hold: 4 },
};
const TIMED_TOK = {};

function ShowTimed(name)
{
    const t = TIMED_TEXTS[name];
    const h = Hud();
    if(!t || !h) return;
    const tok = (TIMED_TOK[name] ?? 0) + 1;
    TIMED_TOK[name] = tok;
    h.SetHasClass(t.panel, "Visible", true);
    Later(t.fadein + t.hold, () => {
        if(TIMED_TOK[name] === tok) Hud()?.SetHasClass(t.panel, "Visible", false);
    });
}

// ---------------------------------------------------------------- layer-тексты (holdtime 1000000)

const LAYER_PANEL = "hud_layer";
const LAYER_TEXTS = {
    layer_text:     { cls: "L1",    all: true },
    layer2_text:    { cls: "L2",    all: false },
    layer3_text:    { cls: "L3",    all: false },
    layer4_text:    { cls: "L4",    all: false },
    layer5_text:    { cls: "L5",    all: false },
    layerExit_text: { cls: "LExit", all: false },
    "106_dem_text": { cls: "D106",  all: false },
};
const LAYER_CLASSES = Object.values(LAYER_TEXTS).map((t) => t.cls);
const PLAYER_LAYER = new Map();//slot → класс, выставленный игроку

function ShowLayer(name, activator)
{
    const t = LAYER_TEXTS[name];
    const h = Hud();
    if(!t || !h) return;
    if(t.all)
    {
        //spawnflags 1: всем игрокам — заменяет и личные тексты на этом канале
        for(const c of LAYER_CLASSES) h.SetHasClass(LAYER_PANEL, c, c === t.cls);
        for(const [slot, cls] of PLAYER_LAYER) h.SetHasClassForPlayer(slot, LAYER_PANEL, cls);
        PLAYER_LAYER.clear();
        return;
    }
    const slot = SlotOf(activator);
    if(slot === undefined) return;
    const prev = PLAYER_LAYER.get(slot);
    if(prev === t.cls) return;
    if(prev) h.SetHasClassForPlayer(slot, LAYER_PANEL, prev);
    h.SetHasClassForPlayer(slot, LAYER_PANEL, t.cls, true);
    PLAYER_LAYER.set(slot, t.cls);
}

// ---------------------------------------------------------------- входы

for(const name in TIMED_TEXTS) Instance.OnScriptInput(name, () => ShowTimed(name));
for(const name in LAYER_TEXTS) Instance.OnScriptInput(name, ({ activator }) => ShowLayer(name, activator));

// ---------------------------------------------------------------- SCP-173: замирает, пока на него смотрит хоть один CT

const SCP173_NAME = "scp173_player";
const SCP173_TICK = 0.1;            // период проверки, с
const SCP173_RADIUS = 800;          // дальность, юниты
const SCP173_MAX_ANGLE = 40;        // макс. угол между взглядом и направлением на 173, градусы
const SCP173_TRACE_HEIGHTS = [16, 48, 72]; // точки на модели (над origin), до которых идёт трейс из глаз
const SCP173_SPEED_SEEN = "0";      // кто-то из CT смотрит
const SCP173_SPEED_FREE = "3";      // никто не смотрит
const SCP173_SPEED_RESET = "1";     // перестал быть scp173_player / рестарт раунда

const SCP173_COS = Math.cos(SCP173_MAX_ANGLE * Math.PI / 180);
let SCP173_OWNER = undefined;       // scp173_player, которому последний раз выставили speed
let SCP173_FROZEN = undefined;      // true = SCP173_SPEED_SEEN, false = SCP173_SPEED_FREE

function Forward(ang)
{
    const p = ang.pitch * Math.PI / 180;
    const y = ang.yaw * Math.PI / 180;
    return { x: Math.cos(p) * Math.cos(y), y: Math.cos(p) * Math.sin(y), z: -Math.sin(p) };
}

//CT видит 173: в радиусе, в пределах угла и хотя бы одна точка модели не закрыта стеной
function CanSee(pawn, target)
{
    const eye = pawn.GetEyePosition();
    const base = target.GetAbsOrigin();
    const fwd = Forward(pawn.GetEyeAngles());
    for(const h of SCP173_TRACE_HEIGHTS)
    {
        const pt = { x: base.x, y: base.y, z: base.z + h };
        const dx = pt.x - eye.x, dy = pt.y - eye.y, dz = pt.z - eye.z;
        const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if(dist > SCP173_RADIUS) continue;
        if(dist > 0.001 && (fwd.x * dx + fwd.y * dy + fwd.z * dz) / dist < SCP173_COS) continue;
        const tr = Instance.TraceLine({ start: eye, end: pt, ignoreEntity: [pawn, target], ignorePlayers: true });
        if(!tr.didHit || tr.hitEntity === target) return true;
    }
    return false;
}

function SetScp173Speed(owner, speed)
{
    if(!owner?.IsValid()) return;
    Instance.EntFireAtTarget({ target: owner, input: "KeyValue", value: `speed ${speed}` });
}

function Scp173Think()
{
    const found = Instance.FindEntityByName(SCP173_NAME);
    const owner = found?.IsValid() ? found : undefined;

    //scp173_player сменился (другой игрок / пропал) — старому вернуть обычную скорость
    if(SCP173_OWNER !== owner)
    {
        if(SCP173_OWNER?.IsValid() && SCP173_FROZEN !== undefined) SetScp173Speed(SCP173_OWNER, SCP173_SPEED_RESET);
        SCP173_OWNER = owner;
        SCP173_FROZEN = undefined;
    }
    if(!owner) return;

    let seen = false;
    for(const c of Instance.GetAllPlayerControllers())
    {
        if(!c?.IsValid() || !c.IsConnected()) continue;
        const pawn = c.GetPlayerPawn();
        if(!pawn?.IsValid() || !pawn.IsAlive() || pawn.GetTeamNumber() !== 3) continue;
        if(pawn === owner) continue;
        if(CanSee(pawn, owner)) { seen = true; break; }
    }

    if(seen !== SCP173_FROZEN)
    {
        SetScp173Speed(owner, seen ? SCP173_SPEED_SEEN : SCP173_SPEED_FREE);
        SCP173_FROZEN = seen;
    }
}

Instance.SetThink(() => {
    try { Scp173Think(); }
    catch(e) { Instance.Msg(`[scp_hud] 173: ${e}`); }
    Instance.SetNextThink(Instance.GetGameTime() + SCP173_TICK);
});
Instance.SetNextThink(Instance.GetGameTime() + SCP173_TICK);

// ---------------------------------------------------------------- раунды / игроки

// Полный сброс худа: снять все классы явно + Reset / ResetForPlayer
function ResetHud()
{
    const h = Hud();
    if(!h) return;
    //личные layer-классы игроков
    for(const [slot, cls] of PLAYER_LAYER) h.SetHasClassForPlayer(slot, LAYER_PANEL, cls);
    for(const c of Instance.GetAllPlayerControllers())
    {
        if(!c?.IsValid()) continue;
        const slot = c.GetPlayerSlot();
        for(const cls of LAYER_CLASSES) h.SetHasClassForPlayer(slot, LAYER_PANEL, cls);
        h.ResetForPlayer(slot);
    }
    //глобальные классы
    for(const cls of LAYER_CLASSES) h.SetHasClass(LAYER_PANEL, cls, false);
    for(const name in TIMED_TEXTS) h.SetHasClass(TIMED_TEXTS[name].panel, "Visible", false);
    h.Reset();
}

let ROUND_RESET_DONE = false;

function ResetRound()
{
    ROUND_ID++;
    LATER_QUEUE.length = 0;
    ResetHud();
    PLAYER_LAYER.clear();
    for(const k in TIMED_TOK) TIMED_TOK[k]++;
    if(SCP173_OWNER?.IsValid() && SCP173_FROZEN !== undefined) SetScp173Speed(SCP173_OWNER, SCP173_SPEED_RESET);
    SCP173_OWNER = undefined;
    SCP173_FROZEN = undefined;
    HUD_ENT = undefined;
    SELF_ENT = undefined;
}

Instance.OnActivate(() => {
    Self();
    Hud();
    Instance.SetNextThink(Instance.GetGameTime() + SCP173_TICK);
});

Instance.OnBeginRoundRestart(() => {
    ResetRound();
    ROUND_RESET_DONE = true;
});

Instance.OnRoundStart(() => {
    if(!ROUND_RESET_DONE) ResetRound();
    ROUND_RESET_DONE = false;
    Self();
    ResetHud();
});

Instance.OnPlayerDisconnect((event) => {
    Hud()?.ResetForPlayer(event.playerSlot);
    PLAYER_LAYER.delete(event.playerSlot);
});

Instance.OnPlayerReset((event) => {
    const player = event.player;
    if(player?.IsValid())
    {
        if(player === SCP173_OWNER)
        {
            Instance.EntFireAtTarget({ target: player, input: "KeyValue", value: "speed 1" });
            SCP173_OWNER = undefined;
            SCP173_FROZEN = undefined;
        }
        player.SetEntityName("player_none");
        Instance.EntFireAtTarget({ target: player, input: "Alpha", value: "255" });
        Instance.EntFireAtTarget({ target: player, input: "Color", value: "255 255 255" });
        Instance.EntFireAtTarget({ target: player, input: "KeyValue", value: "gravity 1" });
        Instance.EntFireAtTarget({ target: player, input: "SetScale", value: "1" });
        Instance.EntFireAtTarget({ target: player, input: "SetDamageFilter" });
        Instance.EntFireAtTarget({ target: player, input: "KeyValue", value: "friction 1.0" });
    }
});