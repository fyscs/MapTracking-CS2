/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
    flow-children: none;
}
#lyric_card {
    width: 76%;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 32px;
    flow-children: down;
    padding: 10px 22px 12px 22px;
    background-color: #07131ce8;
    border: 1px solid #56d8ffff;
    box-shadow: #000000cc 0px 3px 10px 0px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-in-out;
}
#lyric_card.Hidden {
    opacity: 0;
}
.AbyssImageStack {
    width: 100%;
    height: 260px;
    horizontal-align: center;
    margin-top: 0px;
    visibility: collapse;
    flow-children: none;
}
#lyric_card.ImageMode .AbyssImageStack {
    visibility: visible;
}
#lyric_card.ImageMode {
    background-color: #00000000;
    border: 0px solid #00000000;
    box-shadow: #00000000 0px 0px 0px 0px;
    padding: 0px;
}
#lyric_card.ImageMode .AbyssImageStack {
    margin-top: 0px;
}
#lyric_card.ImageMode .Debug,#lyric_card.ImageMode .Track,#lyric_card.ImageMode .Counter {
    visibility: collapse;
}
.Sheen {
    visibility: collapse;
}
.AbyssImage {
    horizontal-align: center;
    vertical-align: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}
.AbyssImage.Lit {
    opacity: 1;
}
.AbyssImage.Glow {
    opacity: 0.6;
}
.AbyssImageStack.NoFade .AbyssImage {
    transition-duration: 0s;
}
.AbyssImage.Hidden {
    visibility: collapse;
}
#lyric_card.ImageMode .LyricEnglish,#lyric_card.ImageMode .LyricChinese {
    visibility: collapse;
}
.Track {
    width: 100%;
    color: #77dcffff;
    font-size: 15px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
}
.Debug {
    width: 100%;
    color: #ffb84d;
    font-size: 14px;
    text-align: center;
}
.LyricEnglish {
    width: 100%;
    margin-top: 4px;
    color: #f4fbffff;
    font-size: 32px;
    font-weight: bold;
    text-align: center;
    text-shadow: 0px 2px 3px 2.0 #000000ff;
}
.LyricChinese {
    width: 100%;
    margin-top: 0px;
    color: #d6ecffff;
    font-size: 23px;
    font-weight: bold;
    text-align: center;
    text-shadow: 0px 2px 3px 2.0 #000000ff;
}
.Counter {
    width: 100%;
    margin-top: 3px;
    color: #aab9c5ff;
    font-size: 13px;
    text-align: center;
}
