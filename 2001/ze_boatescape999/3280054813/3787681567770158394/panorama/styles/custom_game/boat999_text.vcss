.level-hud {
    width: 100%;
    height: 100%;
}
.level-hud-inner {
    width: 100%;
    height: 100%;
    flow-children: none;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 8%;
}
.level-text {
    font-family: "Stratum 2";
    font-size: 24px;
    font-weight: bold;
    color: #ff0000;
    text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
    width: 100%;
    text-align: center;
    horizontal-align: center;
}
.hidden {
    visibility: collapse;
}
