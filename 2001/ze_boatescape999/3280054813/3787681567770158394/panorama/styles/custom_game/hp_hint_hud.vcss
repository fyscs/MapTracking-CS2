.hp-hint-hud {
    width: 100%;
    height: 100%;
}
.hp-hint-hud-inner {
    width: 100%;
    height: 100%;
    flow-children: none;
    horizontal-align: left;
    vertical-align: top;
    margin-left: 2%;
    margin-top: 30%;
}
.hp-hint-text {
    font-family: "Stratum 2";
    font-size: 32px;
    font-weight: bold;
    color: #ff0000;
    text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
    width: 100%;
    text-align: left;
    horizontal-align: left;
}
.hidden {
    visibility: collapse;
}
