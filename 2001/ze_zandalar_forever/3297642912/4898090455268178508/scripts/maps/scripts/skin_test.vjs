import { CSGearSlot, Instance } from "cs_script/point_script";

let player_pawn = null;// 皮肤玩家的pawn
const player_touch_hurt = 10;

// 删刀
//Instance.OnScriptInput("remove_knife", (inputData)=>{
//    inputData.activator.DestroyWeapon(inputData.activator.FindWeaponBySlot(CSGearSlot.KNIFE));
//});

Instance.OnScriptInput("skin_hurt", (inputData)=>{
    const health = player_pawn.GetHealth();
    if (health <= player_touch_hurt) Instance.EntFireAtTarget({target: player_pawn, input: "sethealth", value: 0});
    else player_pawn?.SetHealth(health - player_touch_hurt);
});

Instance.OnScriptInput("init_skin", (inputData)=>{
    player_pawn = inputData.activator;
    Instance.EntFireAtName({ name: "skin_trigger", input: "enable"});
});

Instance.OnRoundStart(() => {
    player_pawn = null;
})