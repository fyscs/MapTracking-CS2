.game_text_root {
    width: 100%;
    height: 100%;
}
.game_text {
    width: fit-children;
    height: fit-children;
    horizontal-align: left;
    vertical-align: top;
    visibility: collapse;
}
.game_text_scan_container {
    visibility: collapse;
    flow-children: down;
    width: fit-children;
    height: fit-children;
}
.game_text_scan_container.visible {
    visibility: visible;
}
.game_text_scan_row {
    flow-children: right;
    width: fit-children;
    height: fit-children;
}
.game_text_scan_text {
    width: fit-children;
    height: fit-children;
    color: #646464;
}
.game_text_scan_current_char {
    width: fit-children;
    height: fit-children;
}
.game_text_scan_char_base,.game_text_scan_char_fade {
    width: fit-children;
    height: fit-children;
}
.game_text_scan_char_base {
    color: #646464;
}
.game_text_scan_char_fade {
    color: #F06E00;
}
.game_text_label {
    width: fit-children;
    height: fit-children;
    font-size: 32px;
    font-weight: bold;
    text-shadow: 2px 2px 4px #000000;
}
.game_text.scan_mode .game_text_main {
    visibility: collapse;
}
.game_text.scan_mode .game_text_scan_container {
    visibility: visible;
}
.game_text.visible {
    visibility: visible;
}
.game_text_x_center {
    horizontal-align: center;
    margin-left: 0%;
    margin-right: 0%;
}
.game_text_y_center {
    vertical-align: center;
    margin-top: 0%;
}
.game_text_credits_container {
    visibility: collapse;
    width: fit-children;
    height: fit-children;
}
.game_text.credits_mode .game_text_credits_container {
    visibility: visible;
}
.game_text.credits_mode .game_text_main {
    visibility: collapse;
}
.game_text.credits_mode .game_text_scan_container {
    visibility: collapse;
}
.game_text_credits_base {
    color: #F06E00;
    opacity: 0.25;
}
.game_text_credits_text {
