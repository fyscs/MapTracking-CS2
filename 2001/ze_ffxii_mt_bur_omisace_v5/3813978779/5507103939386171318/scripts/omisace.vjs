import { CSInputs, Instance, Entity, CSGearSlot, CSDamageTypes, CSPlayerPawn } from 'cs_script/point_script';

const SCRIPT = "Map_Script"

let STAGE = 0;
let TONBERRY_TOYS = 0;

let BOSS_BASE = null;

const TARGET_DISTANCE = 3000;
const TICKRATE = 0.10;
let TARGET_TIME = 5.00;
let THRUSTER_FORWARD = 250;
let THRUSTER_SIDE = 15;

let target = null;
let target_time = 0.00;
let ticking = false;
let dead = false;

let is_fys = false;
const FYS_SKINS = ["maya", "gabranth"];

const SKINS_LIST = [
    { number: 1, path: "agents/models/waffel/maya/maya.vmdl",         flags: ["MAPPER"] },
    { number: 2, path: "agents/models/waffel/gabranth/gabranth.vmdl", flags: ["MAPPER", "SPONSOR"] },
];

const STEAM_IDS_LIST = {
    "76561197992553990":  ["MAPPER"],   // MALGO
    "76561198370596138":  ["MAPPER"],   // WAFFEL
    "76561198722034887":  ["MAPPER"],   // VXLENTINE
    "76561198190108077":  ["MAPPER"],   // KOEN
    "76561198411351805":  ["SPONSOR", "LASTIMS"],  // LASTIMS
    "76561199402945172":  ["SPONSOR"],  // 小小小栗帽
};

const SteamIdBySlot = new Map();
const PlayerInstancesMap = new Map();

class Player {
    constructor(player, controller, name, slot)
    {
        this.player = player;
        this.controller = controller;
        this.player_name = name;
        this.slot = slot;
        this.steamid = null;
        this.Mapper = false;
        this.Sponsor = false;
        this.Lastims = false;
        this.Skin = "";
        this.SkinVar = -1;
    }
}

Instance.OnActivate(async () => {
    let event_c = Instance.FindEntityByName("Map_Event_Listener");
    for(let i = 0; i < 100 && !event_c?.IsValid(); i++)
    {
        await Instance.Delay(0.01);
        event_c = Instance.FindEntityByName("Map_Event_Listener");
    }
    if(!event_c?.IsValid())
    {
        Instance.Msg("Map_Event_Listener not found!");
        return;
    }
    Instance.ConnectOutput(event_c, "OnEventFired", (value) => {
        const data = JSON.parse(value.value);

        const steamid = data.steam_id ?? null;
        const slot = data.userid ?? null;

        if(steamid && slot != null)
        {
            SteamIdBySlot.set(slot, steamid);
            ApplyPlayerFlags(slot, PlayerInstancesMap.get(slot));
        }
    });
});

Instance.OnPlayerReset((event) => {
    const player = event.player;
    if(!player?.IsValid()) return;

    const player_controller = player.GetPlayerController();
    const player_slot = player_controller?.GetPlayerSlot();
    if(player_slot == null) return;

    player.SetColor({ r: 255, g: 255, b: 255, a: 255 });
    Instance.EntFireAtTarget({ target: player, input: "KeyValue", value: "gravity 1" });
    Instance.EntFireAtTarget({ target: player, input: "SetScale", value: "1" });
    Instance.EntFireAtTarget({ target: player, input: "SetDamageFilter" });
    Instance.EntFireAtTarget({ target: player, input: "KeyValue", value: "friction 1.0" });

    let inst = PlayerInstancesMap.get(player_slot);
    if(!inst)
    {
        inst = new Player(player, player_controller, player_controller.GetPlayerName(), player_slot);
        PlayerInstancesMap.set(player_slot, inst);
    }
    inst.player = player;
    inst.controller = player_controller;
    inst.player_name = player_controller.GetPlayerName();

    ApplyPlayerFlags(player_slot, inst);

    if(inst.Skin != "" && player.GetTeamNumber() === 3)
    {
        const skin = inst.Skin;
        Instance.Delay(1.00).then(() => {
            if(player.IsValid() && player.IsAlive() && player.GetTeamNumber() === 3)
            {
                player.SetModel(ResolveSkinPath(skin));
                ApplySkinVar(player, inst, 0.20);
            }
        });
    }
});

Instance.OnPlayerChat((event) => {
    const player_controller = event.player;
    if(!player_controller?.IsValid()) return;

    const inst = PlayerInstancesMap.get(player_controller.GetPlayerSlot());
    if(!inst) return;

    const player_text = event.text.toLowerCase();

    if(player_text.includes("!m_skin"))
    {
        let num = Number(player_text.split(' ')[1]);
        if(!num && inst.Mapper) num = 1;
        if(!num && inst.Sponsor) num = 2;
        const skin = SKINS_LIST.find(item => item.number === num);
        if(!skin) return;
        if(!((inst.Mapper && skin.flags.includes("MAPPER")) || (inst.Sponsor && skin.flags.includes("SPONSOR")))) return;

        inst.Skin = skin.path;
        if(inst.player?.IsValid() && inst.player.IsAlive() && inst.player.GetTeamNumber() === 3)
        {
            inst.player.SetModel(ResolveSkinPath(skin.path));
            ApplySkinVar(inst.player, inst, 0.20);
        }
    }

    if(player_text.includes("!m_var"))
    {
        const bg = Number(player_text.split(' ')[1]);
        if(!Number.isInteger(bg) || bg < 0 || bg > 3) return;
        if(!(inst.Mapper || inst.Sponsor)) return;
        if(bg >= 2 && !inst.Lastims) return;

        inst.SkinVar = bg;
        if(inst.Skin != "" && inst.player?.IsValid() && inst.player.IsAlive() && inst.player.GetTeamNumber() === 3)
        {
            ApplySkinVar(inst.player, inst, 0.00);
        }
    }
});

function ApplySkinVar(player, inst, delay)
{
    const bg = inst.SkinVar >= 0 ? inst.SkinVar : (inst.Lastims ? 2 : -1);
    if(bg < 0) return;
    Instance.EntFireAtTarget({ target: player, input: "Skin", value: String(bg), delay: delay });
}

function ApplyPlayerFlags(slot, inst)
{
    if(!inst) return;

    const steamid = SteamIdBySlot.get(slot) ?? null;
    if(!steamid) return;

    inst.steamid = steamid;

    const flags = STEAM_IDS_LIST[steamid];
    if(!flags) return;

    inst.Mapper = flags.includes("MAPPER");
    inst.Sponsor = flags.includes("SPONSOR");
    inst.Lastims = flags.includes("LASTIMS");
}

Instance.OnScriptInput("SetFysSkins", () => {
    is_fys = true;
});

function ResolveSkinPath(path)
{
    if(!is_fys || !path) return path;

    for(const name of FYS_SKINS)
    {
        if(path.includes(name) && !path.includes("_fys"))
        {
            return path.replace(".vmdl", "_fys.vmdl");
        }
    }

    return path;
}

Instance.OnScriptInput("LoadStage", () => {
    Instance.EntFireAtName({ name: `Stage${STAGE}`, input: "Trigger", delay: 0.02 });
    Instance.EntFireAtName({ name: "LevelCow_Case", input: "InValue", value: TONBERRY_TOYS + 1, delay: 0.02 });
    if(STAGE == 1)
    {
        TARGET_TIME = 4.00;
        THRUSTER_FORWARD = 350;
        THRUSTER_SIDE = 10;
    }
    if(STAGE == 2)
    {
        TARGET_TIME = 5.00;
        THRUSTER_FORWARD = 350;
        THRUSTER_SIDE = 10;
    }
    if(STAGE == 4)
    {
        TARGET_TIME = 5.00;
        THRUSTER_FORWARD = 350;
        THRUSTER_SIDE = 10;
    }
});

Instance.OnScriptInput("SetStage1", () => {
    STAGE = 1;
});

Instance.OnScriptInput("SetStage2", () => {
    STAGE = 2;
});

Instance.OnScriptInput("SetStage3", () => {
    STAGE = 3;
});

Instance.OnScriptInput("SetStage4", () => {
    STAGE = 4;
});

Instance.OnScriptInput("SetStage5", () => {
    STAGE = 5;
});

Instance.OnScriptInput("TonberryAdd1", ({ caller, activator }) => {
    TONBERRY_TOYS++;
});

Instance.OnScriptInput("TonberryAdd10", ({ caller, activator }) => {
    TONBERRY_TOYS += 10;
});

Instance.OnScriptInput("TonberryQuestCheck", ({ caller, activator }) => {
    if(TONBERRY_TOYS == 0)
    {
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: "say **[Tonberry] Hello my friend I got lost and I am looking for a way back**" });
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: "say **[Tonberry] But I lost my Cactus Toys could you help we find them?**", delay: 3.00 });
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: "say **[Tonberry] Thanks as a gratitude I'll give you a small gift when you next time give back all toys**", delay: 6.00 });
    }
    if(TONBERRY_TOYS != 0 && TONBERRY_TOYS < 10)
    {
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: `say **[Tonberry] Still haven't found all the toys? You need to bring me ${10 - TONBERRY_TOYS} more toys**` });
    }
    if(TONBERRY_TOYS == 10)
    {
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: "say **[Tonberry] Thanks for your help now I can go back to my own**" });
        Instance.EntFireAtName({ name: "cmd", input: "Command", value: "say **[Tonberry] I will try to summon an item for you maybe it may be useful to you**", delay: 3.00 });
        Instance.EntFireAtName({ name: "Special_Event_Tonberry_Case", input: "PickRandom", delay: 6.00 });
    }
});

Instance.OnScriptInput("ApplyScore", ({ caller, activator }) => {
    if(activator?.IsValid() && activator.GetTeamNumber() === 3)
    {
        const player_controller = activator.GetPlayerController();
        if(STAGE < 4)
        {
            player_controller.AddScore(100);
        }
        if(STAGE == 4)
        {
            player_controller.AddScore(1000);
        }
    }
});

Instance.OnScriptInput("RefillAmmo", ({ caller, activator }) => {
    if(activator?.IsValid() && activator.IsAlive() && activator.GetTeamNumber() === 3)
    {
        const active_weapon = activator.GetActiveWeapon();
        if(active_weapon)
        {
            active_weapon.SetClipAmmo(150);
        }
    }
});

Instance.OnScriptInput("StartBoss", ({ caller, activator }) => {
    if(STAGE == 1)
    {
        BOSS_BASE = Instance.FindEntityByName("Solid_Paper_Phys");
    }
    if(STAGE == 2)
    {
        BOSS_BASE = Instance.FindEntityByName("Zodiark_Phys");
    }
    if(STAGE == 4)
    {
        BOSS_BASE = Instance.FindEntityByName("Ifrit_Phys");
    }
});

Instance.OnScriptInput("BossMoveStart", ({ caller, activator }) => {
	if(!ticking)
	{
		ticking = true;
        Instance.EntFireAtTarget({ target: BOSS_BASE, input: "EnableMotion" });
		Instance.EntFireAtName({ name: SCRIPT, input: "RunScriptInput", value: "Tick" });
	}
});

Instance.OnScriptInput("BossMoveStop", ({ caller, activator }) => {
	if(ticking)
	{
		ticking = false;
        Instance.EntFireAtTarget({ target: BOSS_BASE, input: "DisableMotion" });
	}
});

Instance.OnScriptInput("Tick", ({ caller, activator }) => {
	let spos = BOSS_BASE.GetAbsOrigin();
	if(ticking)
	{
		if(target == null || target.GetClassName() != "player" || target.GetTeamNumber() != 3 || target.GetHealth() <= 0)
		{
			Instance.EntFireAtName({ name: SCRIPT, input: "RunScriptInput", value: "TargetPlayer" });
		}
		else
		{
			MoveTo(spos, target.GetAbsOrigin());
			
			target_time += TICKRATE;
			if(target_time >= TARGET_TIME)
			{
				target = null;
			}
		}
	}
	Instance.EntFireAtName({ name: SCRIPT, input: "RunScriptInput", value: "Tick", delay: TICKRATE });
});

Instance.OnScriptInput("ZM_Warp_Fix", ({ activator }) => {
    if (activator instanceof CSPlayerPawn ) {
        const controller = activator.GetPlayerController();
        Instance.EntFireAtTarget({ target: activator, input: "KeyValues", value: "speed 0" });
        Instance.EntFireAtTarget({ target: activator, input: "KeyValues", value: "speed 1.15", delay: 6.00 });
    }
});

Instance.OnScriptInput("Knife_Stripper", ({ activator }) => {
    if (activator instanceof CSPlayerPawn) {
        const knife = activator.FindWeaponBySlot(CSGearSlot.KNIFE);
        activator.DestroyWeapon(knife);

    }
});

function MoveTo(selfPos, targetPos)
{
    let dir = null;
    let angDif = 0;
    let canMove = false;
    
    let currentVelocity = BOSS_BASE.GetAbsVelocity();
    let currentSpeed = Math.sqrt(
        currentVelocity.x * currentVelocity.x + 
        currentVelocity.y * currentVelocity.y
    );
    
    let isStuck = currentSpeed < 50 && !dead;
    
    if(!dead)
    {
        let forwardVec = GetForwardVector(BOSS_BASE.GetAbsAngles());
        
        let toTarget = {
            x: targetPos.x - selfPos.x,
            y: targetPos.y - selfPos.y,
            z: 0
        };
        
        let len = Math.sqrt(toTarget.x*toTarget.x + toTarget.y*toTarget.y);
        if(len > 0)
        {
            toTarget.x /= len;
            toTarget.y /= len;
        }
        
        let currentYaw = BOSS_BASE.GetAbsAngles().yaw + 180;
        let targetYaw = GetTargetYaw(selfPos, targetPos);
        
        angDif = targetYaw - currentYaw;
        while(angDif > 180) angDif -= 360;
        while(angDif < -180) angDif += 360;
        
        if(!isStuck)
		{
			// Instance.Msg("Not Stuck")
            dir = {
                x: forwardVec.x,
                y: forwardVec.y,
                z: 0
            };
        }
		else
		{
			// Instance.Msg("Stuck")
            dir = {
                x: -forwardVec.x * 0.5,
                y: -forwardVec.y * 0.5,
                z: 0
            };
            angDif = angDif * 2.0;
        }
    }
    
    if(!dir) {
        dir = { x: 0, y: 0, z: 0 };
    }
    
    let velocity = {
        x: dir.x * THRUSTER_FORWARD,
        y: dir.y * THRUSTER_FORWARD,
        z: 0
    };
    
    let angularVelocity = {
        x: 0,
        y: 0,
        z: angDif * THRUSTER_SIDE
    };
    
    BOSS_BASE.Teleport({ velocity: velocity, angularVelocity: angularVelocity });
};

Instance.OnScriptInput("TargetPlayer", ({ caller, activator }) => {
	target_time = 0.00;
	const players = GetValidPlayersCT();
	let ctcount = 0;
	let hlist = [];
	let humans = getPlayersInRadius(BOSS_BASE.GetAbsOrigin(), TARGET_DISTANCE, players);
	for(const human of humans)
	{
		ctcount++;
		hlist.push(human);
	}
	if(hlist.length > 0)
	{
		target = hlist[GetRandomNumber(0, hlist.length - 1)];
	}
});

Instance.OnRoundStart(() => {
	ResetScript();
});

Instance.OnRoundEnd(() => {
	ResetScript();
});

function ResetScript()
{
	BOSS_BASE = null;

    TARGET_TIME = 5.00;
	THRUSTER_FORWARD = 250;
	THRUSTER_SIDE = 15;

	target = null;
	target_time = 0.00;
	ticking = false;

    stopTextSequence(7);
};

function GetTargetYaw(start,target)
{
	let yaw = 0.00;
	let v = {x: start.x-target.x, y: start.y-target.y, z: start.z-target.z};
	let vl = Math.sqrt(v.x*v.x+v.y*v.y);
	if(vl == 0) return 0;
	yaw = 180 * Math.acos(v.x/vl)/3.14159;
	if(v.y < 0)
	{
		yaw =- yaw;
	}
	return yaw;
};

function GetDistance(v1,v2)
{
    return Math.sqrt((v1.x-v2.x)*(v1.x-v2.x)+(v1.y-v2.y)*(v1.y-v2.y)+(v1.z-v2.z)*(v1.z-v2.z));
};

function GetDistanceXY(v1,v2)
{
	return Math.sqrt((v1.x-v2.x)*(v1.x-v2.x)+(v1.y-v2.y)*(v1.y-v2.y));
};

function GetRandomNumber(min, max ) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
};

function GetRandomFloat(min, max, decimals = 2) {
    let num = min + Math.random() * (max - min);
    return Number(num.toFixed(decimals));
};

function IsValidPlayerTeam(player, team)
{
    return player != null && player?.IsValid() && player?.IsAlive() && player?.GetTeamNumber() == team
};

function GetValidPlayersCT() 
{
    return Instance.FindEntitiesByClass("player").filter(p => IsValidPlayerTeam(p, 3));
};

function GetValidPlayersT() 
{
    return Instance.FindEntitiesByClass("player").filter(p => IsValidPlayerTeam(p, 2));
};

function getPlayersInRadius(center, radius, team)
{
    const result = [];

    const players = team;

    for(const player of players) 
    {
        if(!player.IsValid() || !player.IsAlive()) continue;

        const pos = player.GetAbsOrigin();

        const dx = pos.x - center.x;
        const dy = pos.y - center.y;
        const dz = pos.z - center.z;

        const distSq = dx*dx + dy*dy + dz*dz;

        if(distSq <= radius * radius) 
        {
            result.push(player);
        }
    }

    return result;
};

function GetForwardVector(ang)
{
    const pitch = ang.pitch * Math.PI / 180;
    const yaw   = ang.yaw   * Math.PI / 180;

    const sp = Math.sin(pitch);
    const cp = Math.cos(pitch);

    const sy = Math.sin(yaw);
    const cy = Math.cos(yaw);

    const forward = {
        x: cp * cy,
        y: cp * sy,
        z: -sp,
    };

    return forward;
};

