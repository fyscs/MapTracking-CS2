    //  1   4  5  6  7
    //  2   8  9  10 11
    // set to identity
    constructor() {
        this.m.fill(0);
        this.m[0] = 1;
        this.m[5] = 1;
        this.m[10] = 1;
    }
    equals(mat2, tolerance = 1e-5) {
        for (let i = 0; i < 12; ++i) {
