Instance.OnScriptInput("TimerTick", () => {
    if (timer === undefined) {
        return;
    }
    if (time < 0) {
        timer = undefined;
        void fadeHudTextOut(timer_text.fadeOutTime ?? 0.25, timer_text.channel);
        return;
    }
    setHudText(getTimerText(timer, time--), timer_text.channel);
    EntFire(script_overkill, "RunScriptInput", "TimerTick", 1);
});
function startTimer(timerKind, seconds) {
    timer = timerKind;
    time = seconds;
    setText(getTimerText(timerKind, time--), timer_text);
    EntFire(script_overkill, "RunScriptInput", "TimerTick", 1);
}
function getTimerText(timerKind, seconds) {
    const formattedTime = formatTime(seconds);
    switch (timerKind) {
        case 'maze':
            return `Exit maze door closing in ${formattedTime}`;
        case 'elevator':
            return `Exit elevator leaving in ${formattedTime}`;
        case 'atomic':
            return `Atomic bomb arriving in ${formattedTime}`;
        case 'tower':
            return `Tower entrance closing in ${formattedTime}`;
    }
}
function formatTime(totalSeconds) {
    const seconds = Math.max(0, Math.floor(totalSeconds));
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes.toString().padStart(2, "0")}:${remainingSeconds
        .toString()
        .padStart(2, "0")}`;
}
