    posY: 0.8,
    duration: 0
};
Instance.OnScriptInput("ColdGreenEyes", async () => {
    const startingRound = roundGeneration;
    setText("Ever changing", { ...cold_green_eyes_lyrics, duration: 2 });
    await Instance.Delay(2.4);
    if (startingRound !== roundGeneration)
        return;
    setText("The knowing feeling", { ...cold_green_eyes_lyrics, duration: 2.5 });
    await Instance.Delay(2.75);
    if (startingRound !== roundGeneration)
        return;
    setText("Could make you fall from the dreamy skies", { ...cold_green_eyes_lyrics, duration: 5, fadeOutTime: 1 });
    await Instance.Delay(6.75);
    if (startingRound !== roundGeneration)
        return;
    setText("Suddenly the deepness can get true", { ...cold_green_eyes_lyrics, duration: 2.5 });
    await Instance.Delay(2.9);
    if (startingRound !== roundGeneration)
        return;
    setText("Where you live a life without a clue", { ...cold_green_eyes_lyrics, duration: 3 });
    await Instance.Delay(3.7);
    if (startingRound !== roundGeneration)
        return;
    setText("And you're looking into", { ...cold_green_eyes_lyrics, duration: 4, fadeOutTime: 1 });
    setHudTextAccent("\u00a0cold green eyes", 4);
});
