const script_overkill = "script_overkill";
let level = 1;
let warmup = true;
let first_round = true;
let time = 0;
const boss_tp_dest = new Vec3(-1280, 11904, 14384);
let roundGeneration = 0;
let imageSequenceRequestId = 0;
let overkillEffectRequestId = 0;
let freeze_lock = false;
let moly_lock = false;
const IMAGE_SEQUENCE_PANEL_IDS = [
    'image_kill',
    'image_them',
    'image_all',
];
const IMAGE_HIDDEN_CLASS = 'ImageHidden';
const IMAGE_DURATION = 0.5;
const IMAGE_FADE_DURATION = 0.1;
const OVERKILL_DIMMED_CLASS = 'OverkillDimmed';
const OVERKILL_PULSE_FADE_TIME = 1;
Instance.OnRoundStart(async () => {
    ++roundGeneration;
    clearKillThemAllImages();
    clearAllText();
    time = 0;
    timer = undefined;
    hurt_players = [];
    freeze_lock = false;
    moly_lock = false;
    if (!first_round) {
        warmup = false;
    }
    if (first_round) {
        first_round = false;
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say WARMUP");
        await Instance.Delay(5);
        Instance.ServerCommand("say Starting Game...");
        EntFire("map_param", "FireWinCondition", 10, 1);
        return;
    }
    EntFire("Level_Case", "InValue", level);
    const players = Instance.FindEntitiesByClass("player");
    for (const player of players) {
        const pistol = player.FindWeaponBySlot(CSGearSlot.PISTOL);
        const knife = player.FindWeaponBySlot(CSGearSlot.KNIFE);
        if (pistol !== undefined) {
            const class_name = pistol.GetClassName();
            if (class_name === "weapon_deagle") {
                player.DestroyWeapon(pistol);
                player.GiveNamedItem(class_name, true);
            }
        }
        if (knife !== undefined) {
            const class_name = knife.GetClassName();
            if (class_name === "weapon_knife") {
                player.DestroyWeapon(knife);
                player.GiveNamedItem(class_name, true);
            }
        }
    }
    // const math_counter1 = Instance.FindEntityByName("dogma_s_boss_hp");
    // const math_counter2 = Instance.FindEntityByName("overkill_s_boss_hp");
    // Instance.ConnectOutput(math_counter1, "OutValue", (inputData) => {
    //     print(inputData.value);
    // })
    // Instance.ConnectOutput(math_counter2, "OutValue", (inputData) => {
    //     print(inputData.value);
    // })
});
Instance.OnModifyPlayerDamage((event) => {
    if (warmup) {
        return { abort: true };
    }
    if (event.inflictor?.GetClassName() === "prop_physics") {
        return { abort: true };
    }
    if (event.damageTypes === CSDamageTypes.FALL) {
        return { abort: true };
    }
});
