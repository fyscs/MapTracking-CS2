Instance.OnScriptInput("ItemTick", (data) => {
    const item_name = data.caller.GetEntityName();
    if ((item_name === "moly_weapon" && moly_lock == true) ||
        (item_name === "z_freeze_weapon" && freeze_lock == true)) {
        return;
    }
    const parent = data.caller.GetParent();
    if (parent !== undefined && parent instanceof CSPlayerPawn) {
        if (parent.WasInputJustPressed(CSInputs.USE)) {
            EntFireTarget(data.caller, "FireUser1");
        }
    }
});
Instance.OnScriptInput("StartMissile", ({ caller }) => {
    const name = caller.GetEntityName();
    const suffix = name.match(/\d+$/)?.[0];
    EntFireTarget(caller, "SetSpeed", 100);
    EntFireTarget(caller, "Open");
    EntFireTarget(caller, "SetSpeed", 200, 3.5);
    EntFire("missile_prop" + suffix, "TurnOn");
    EntFire("missile_partic" + suffix, "Start");
});
Instance.OnScriptInput("ResetMissile", ({ caller }) => {
    const name = caller.GetEntityName();
    const suffix = name.match(/\d+$/)?.[0];
    EntFireTarget(caller, "Close");
    EntFire("missile_prop" + suffix, "TurnOff");
    EntFire("missile_partic" + suffix, "Stop");
});
Instance.OnScriptInput("EnableFogDark", (data) => {
    const fog = data.caller;
    EntFireTarget(fog, "SetFogEndDistance", 50000);
    EntFireTarget(fog, "Enable");
    let delay = 0;
    for (let end_dist = 50000; end_dist > 2000; end_dist -= 1000) {
        EntFireTarget(fog, "SetFogEndDistance", end_dist, delay);
        delay += 0.2;
    }
});
Instance.OnScriptInput("TeleportBoss", ({ activator }) => {
    const landmark = Instance.FindEntityByName("elevator_landmark");
    const vec = Vector3Utils.subtract(activator.GetAbsOrigin(), landmark.GetAbsOrigin());
    const velocity = activator.GetAbsVelocity();
    activator.Teleport({ position: Vector3Utils.add(boss_tp_dest, vec), velocity: new Vec3(velocity.x, velocity.y, 1000) });
    activator.SetHealth(200);
});
let hurt_players = [];
Instance.OnScriptInput("BlastHurt", async (data) => {
    const activator = data.activator;
    if (!(hurt_players.includes(activator))) {
        print("hit");
        hurt_players.push(activator);
        activator.TakeDamage({ damage: 15, damageTypes: CSDamageTypes.BURN });
        EntFireTarget(activator, "IgniteLifetime", 2);
        await Instance.Delay(1);
        removeObject(hurt_players, activator);
    }
});
