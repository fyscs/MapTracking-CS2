import { Instance, CSGearSlot } from 'cs_script/point_script';

Instance.OnScriptInput("StripPrimary", (data) => {
    const activator = data.activator;
    activator.DestroyWeapon(activator.FindWeaponBySlot(CSGearSlot.RIFLE));
});
Instance.OnScriptInput("StripSecondary", (data) => {
    const activator = data.activator;
    activator.DestroyWeapon(activator.FindWeaponBySlot(CSGearSlot.PISTOL));
});
Instance.OnScriptInput("StripGrenade", (data) => {
    const activator = data.activator;
    activator.DestroyWeapon(activator.FindWeaponBySlot(CSGearSlot.GRENADES));
});
