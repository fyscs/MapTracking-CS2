    new Vec3(13648, 11056, -1008), 300, new Vec3(13882, 10802, -1254),
    new Vec3(14256, 10080, -928), 500, new Vec3(14078, 9706, -1370),
    new Vec3(-1792, -11134, -379), 700, new Vec3(-519, -10734, -547)
];
Instance.OnScriptInput("PreventDelayAct1", () => {
