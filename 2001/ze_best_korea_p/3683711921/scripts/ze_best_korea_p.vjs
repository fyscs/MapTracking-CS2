        const yawInRad = (angle.yaw / 180) * Math.PI;
        const rollInRad = (angle.roll / 180) * Math.PI;
        const sinPitch = Math.sin(pitchInRad);
        const sinYaw = Math.sin(yawInRad);
        const sinRoll = Math.sin(rollInRad);
