    '"': [
        [1, 4, 1, 6],
        [3, 4, 3, 6],
    ],
    '\'': [[2, 4, 2, 6]],
    '`': [[1, 6, 2, 5]],
    '\\': [[0.5, 6, 3.5, 0]],
    '→': [
        [0, 3, 4, 3],
        [4, 3, 2, 5],
        [4, 3, 2, 1],
    ],
    '←': [
        [4, 3, 0, 3],
        [0, 3, 2, 5],
        [0, 3, 2, 1],
    ],
    '↑': [
        [2, 0, 2, 6],
        [2, 6, 0, 4],
        [2, 6, 4, 4],
    ],
    '↓': [
        [2, 6, 2, 0],
        [2, 0, 0, 2],
        [2, 0, 4, 2],
    ],
    '↗': [
        [0, 0, 4, 4],
        [4, 4, 4, 1],
        [4, 4, 1, 4],
    ],
    '↘': [
