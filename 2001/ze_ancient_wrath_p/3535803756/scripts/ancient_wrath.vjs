Instance.OnScriptInput("GiveAmmo", ({ activator }) => {
    if (!(activator instanceof CSPlayerPawn))
        return;
    const primary = activator.FindWeaponBySlot(CSGearSlot.RIFLE);
    const secondary = activator.FindWeaponBySlot(CSGearSlot.PISTOL);
