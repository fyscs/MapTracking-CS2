.ChatRoot {
    width: 100%;
    height: 100%;
}
.ChatContainer {
    width: 460px;
    height: fit-children;
    flow-children: up;
    horizontal-align: left;
    vertical-align: bottom;
    margin-left: 70%;
    margin-bottom: 2%;
}
.ChatLine {
    width: 100%;
    height: fit-children;
    color: white;
    font-family: Stratum2, Arial;
    font-size: 22px;
    text-shadow: 0px 0px 0px #000000;
    padding: 3px 12px;
    margin-bottom: -6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: linear;
}
.ChatLine.ChatHidden {
    opacity: 0;
}
.Root {
    width: 100%;
    height: 100%;
}
.TextChannel {
    width: 100%;
    height: 100%;
    flow-children: down;
}
.TextRow {
    width: 100%;
    height: fit-children;
    flow-children: right;
    overflow: noclip;
}
.HorizontalSpacer {
    height: 100%;
}
.VerticalSpacer {
    width: 100%;
}
.DynamicText {
    color: white;
    font-family: Stratum2, Arial;
    font-weight: bold;
    height: fit-children;
    opacity: 1;
    transition-property: opacity;
    transition-timing-function: linear;
}
.DynamicText.TextBox {
    background-color: #00000022;
    border-radius: 10px;
    padding: 0px 15px;
}
.DynamicText.FadedOut {
    opacity: 0;
}
