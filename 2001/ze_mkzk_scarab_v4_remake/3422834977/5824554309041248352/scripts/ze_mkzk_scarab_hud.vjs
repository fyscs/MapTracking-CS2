Instance.OnPlayerActivate(({ player }) => {
    resetPlayerHudOverrides(player.GetPlayerSlot());
});
Instance.OnPlayerDisconnect(({ playerSlot }) => {
    resetPlayerHudOverrides(playerSlot);
});

const CHAT_HUD_ENTITY_NAME = 'game_text_hud';
const CHAT_MAX_LINES = 5;
const CHAT_LINE_LIFETIME = 10;

let nextChatId = 0;
const chatMessages = [];

function getChatHud() {
    return Instance.FindEntityByName(CHAT_HUD_ENTITY_NAME);
}

function pushChatMessage(text) {
    if (!text) return;
    const id = ++nextChatId;
    chatMessages.unshift({ id, text });
    if (chatMessages.length > CHAT_MAX_LINES) {
        chatMessages.length = CHAT_MAX_LINES;
    }
    renderChat();
    void scheduleChatFade(id);
}

function renderChat() {
    const hud = getChatHud();
    if (!hud) return;
    for (let i = 0; i < CHAT_MAX_LINES; i++) {
        const lineId = `chat_line_${i + 1}`;
        if (i < chatMessages.length) {
            hud.SetDialogVariableString(lineId, 'chat', chatMessages[i].text);
            hud.SetHasClass(lineId, 'ChatHidden', false);
        } else {
            hud.SetHasClass(lineId, 'ChatHidden', true);
        }
    }
}

async function scheduleChatFade(id) {
    await Instance.Delay(CHAT_LINE_LIFETIME);
    const idx = chatMessages.findIndex((m) => m.id === id);
    if (idx < 0) return;
    chatMessages.splice(idx, 1);
    renderChat();
}

const playerScores = new Map();

function ensureScoreEntry(player) {
    const slot = player.GetPlayerSlot();
    let entry = playerScores.get(slot);
    if (!entry) {
        entry = { name: player.GetPlayerName(), score: 0, rewarded: false };
        playerScores.set(slot, entry);
    } else {
        entry.name = player.GetPlayerName();
    }
    return entry;
}

function checkReward(player, entry) {
    if (entry.score >= REWARD_SCORE && !entry.rewarded) {
        if (rewardCount >= MAX_REWARD_COUNT) return;
        entry.rewarded = true;
        rewardCount += 1;
        if (typeof player.AddMoneySpendableNow === 'function') {
            player.AddMoneySpendableNow(REWARD_MONEY);
        }
        rewardedPlayers.unshift(entry.name);
        renderLeaderboard();
    }
}

function ClearScores() {
    playerScores.clear();
    rewardedPlayers.length = 0;
    rewardCount = 0;
}

const RANK_LABELS = ['一', '二', '三'];
const REWARD_SCORE = 10;
const REWARD_MONEY = 50000;
const MAX_REWARD_COUNT = 2;
const rewardedPlayers = [];
let rewardCount = 0;

function renderLeaderboard() {
    const hud = getChatHud();
    if (!hud) return;
    const hasReward = rewardedPlayers.length > 0;

    // chat_line_1 常驻：有奖励播报奖励，无奖励播报规则提示
    if (hasReward) {
        const namesText = rewardedPlayers.join('和');
        hud.SetDialogVariableString('chat_line_1', 'chat', `   ${namesText}获得了金钱奖励`);
    } else {
        hud.SetDialogVariableString('chat_line_1', 'chat', `   前两名达到十杀的玩家获得金钱奖励`);
    }
    hud.SetHasClass('chat_line_1', 'ChatHidden', false);

    const sorted = [...playerScores.values()].sort((a, b) => b.score - a.score);
    for (let i = 0; i < 3; i++) {
        const lineId = `chat_line_${4 - i}`;
        if (i < sorted.length) {
            const { name, score } = sorted[i];
            hud.SetDialogVariableString(lineId, 'chat', `   第${RANK_LABELS[i]}名 ${score}杀 ${name}`);
        } else {
            hud.SetDialogVariableString(lineId, 'chat', `   第${RANK_LABELS[i]}名 0杀 未知玩家`);
        }
        hud.SetHasClass(lineId, 'ChatHidden', false);
    }

    // chat_line_5 预留，始终隐藏
    hud.SetHasClass('chat_line_5', 'ChatHidden', true);
}

Instance.OnScriptInput('ShowLeaderboard', () => {
    chatMessages.length = 0;
    renderLeaderboard();
});

/** 给 activator 加分，分值从 value 传入 */
Instance.OnScriptInput('AddScore', (inputData) => {
    const player = inputData?.activator;
    if (!player || !player.IsValid()) return;
    const controller = player.GetPlayerController();
    const entry = ensureScoreEntry(controller);
    entry.score += 1;
    checkReward(controller, entry);
});


export { clearAllText, clearText, clearTextPlayer, fadeHudTextIn, fadeHudTextOut, setHudText, setHudTextColor, setHudTextFadeDuration, setHudTextPosition, setHudTextSize, setText, setTextPlayer, setTimer, setTimerPlayer };
