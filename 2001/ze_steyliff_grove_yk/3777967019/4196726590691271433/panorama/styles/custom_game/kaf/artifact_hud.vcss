.hud-root {
    width: 100%;
    height: 100%;
    font-family: Stratum2, "Arial Unicode MS";
}
.Hidden {
    visibility: collapse;
}
.artifact-hud {
    width: 315px;
    height: 85px;
    horizontal-align: right;
    vertical-align: bottom;
    margin-right: 200px;
    margin-bottom: 84px;
    padding: 3px 8px 3px 8px;
    flow-children: down;
    background-color: #00356ba0;
    border-radius: 2px;
}
.artifact-hud Label {
    text-shadow: none;
}
.resource-block {
    width: 100%;
    height: 39.5px;
    flow-children: down;
}
.resource-header {
    width: 100%;
    height: 24px;
}
.info-value {
    width: fit-children;
    height: fit-children;
    horizontal-align: left;
    vertical-align: bottom;
    margin-left: 4px;
    text-align: left;
    color: #f5f7f5;
    font-size: 19px;
    font-weight: normal;
}
.player-name {
    width: 180px;
    text-overflow: ellipsis;
}
.skill-info {
    width: 190px;
    height: 100%;
    horizontal-align: left;
    flow-children: right;
}
.fusion-info {
    margin-left: 8px;
}
.resource-bar {
    width: 100%;
    height: 8px;
    margin-top: 4px;
    overflow: clip;
    background-color: #020b19e6;
}
.resource-fill {
    width: 0%;
    height: 100%;
    horizontal-align: left;
    transition-property: width;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.Magia-fill {
    background-color: #4ac9f2;
}
.Materia-fill {
    background-color: #4ac9f2;
