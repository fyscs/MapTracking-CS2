// Generated by StarDance
// https://github.com/Kxnrl

import { CSWeaponType, Instance } from "cs_script/point_script";

//个人HUD↓
const HUD_LAYOUT_NAME = "Map_artifact_hud_layout";
//全体HUD↓
const OVERVIEW_LAYOUT_NAME = "Map_artifact_all_hud_layout";
//轮询率
const POLL_INTERVAL = 0.5;
//聊天框输入什么可以显示所有hud
const OVERVIEW_CHAT_COMMAND = "hud";

const MAX_VALUE = 100;
const PICKUP_PAIR_WINDOW = 1;

//测试用↓ 打开之后没捡的元素也显示
const OVERVIEW_DEBUG = false;

const FUSIONS = {
    fusion1: "低级融合",
    fusion2: "普通融合",
    fusion3: "高级融合",
    fusion4: "究极融合",
};

const ARTIFACTS = [
    {
        id: "Blizzard",
        //拾取手枪时收到的指令
        pickup: "PickUpBlizzard",
        //融合添加来源 只有这个targetname发来的(fusion1/2/3/4)才会添加进融合
        //我没动别的脚本 如果要删worldtext的话记得留个同名relay什么的
        synthesis: "Item_Human_Blizzard_Synthesis_Text",
        //清除融合指令
        fusionClear: "blizzard_fusionclear",
        //魔法值读取的Counter
        MagiaCounter: "Item_Human_Blizzard_Magia_Counter",
        //元素值读取的Counter
        MateriaCounter: "Item_Human_Blizzard_Materia_Counter",
        //默认的技能(首次拾取)和升级后的技能
        defaultElement: "case01",
        //技能列表和输入指令
        elements: {
            case01: ["blizzard_case01", "> 结冰LV1 < ","消耗50魔力值20元素值"],
            case02: ["blizzard_case02", "> 冰冻LV2 < ","消耗65魔力值40元素值"],
            case03: ["blizzard_case03", "> 冰封LV3 < ","消耗80魔力值60元素值"],
        },
    },
    {
        id: "Fire",
        pickup: "PickUpFire",
        synthesis: "Item_Human_Fire_Synthesis_Text",
        fusionClear: "fire_fusionclear",
        MagiaCounter: "Item_Human_Fire_Magia_Counter",
        MateriaCounter: "Item_Human_Fire_Materia_Counter",
        defaultElement: "case01",
        elements: {
            case01: ["fire_case01", "> 火炎LV1 <","消耗50魔力值20元素值"],
            case02: ["fire_case02", "> 烈炎LV2 <","消耗65魔力值40元素值"],
            case03: ["fire_case03", "> 爆炎LV3 <","消耗80魔力值60元素值"],
        },
    },
    {
        id: "Thunder",
        pickup: "PickUpThunder",
        synthesis: "Item_Human_Thunder_Synthesis_Text",
        fusionClear: "thunder_fusionclear",
        MagiaCounter: "Item_Human_Thunder_Magia_Counter",
        MateriaCounter: "Item_Human_Thunder_Materia_Counter",
        defaultElement: "case01",
        elements: {
            case01: ["thunder_case01", "> 闪雷LV1 <","消耗50魔力值20元素值"],
            case02: ["thunder_case02", "> 震雷LV2 <","消耗65魔力值40元素值"],
            case03: ["thunder_case03", "> 暴雷LV3 <","消耗80魔力值60元素值"],
        },
    },
];

const RESOURCES = [
    ["Magia", "MagiaCounter", "Magia-fill"],
    ["Materia", "MateriaCounter", "Materia-fill"],
];
const states = ARTIFACTS.map((config) => ({
    ...config,
    initialized: false,
    fusion: "",
    element: config.defaultElement,
    Magia: MAX_VALUE,
    Materia: MAX_VALUE,
    holder: undefined,
    weapon: undefined,
    bars: { Magia: -1, Materia: -1 },
    connections: { Magia: new Set(), Materia: new Set() },
}));
const recentPickups = new Map();
const pendingPickups = new Map();
const overviewToggledPlayers = new Set();
let hudLayout;
let overviewLayout;
let overviewDefaultVisible = OVERVIEW_DEBUG;

function hud() {
    if (!hudLayout) {
        hudLayout = Instance.FindEntityByName(HUD_LAYOUT_NAME);
    }
    return hudLayout;
}

function overview() {
    if (!overviewLayout) {
        overviewLayout = Instance.FindEntityByName(OVERVIEW_LAYOUT_NAME);
    }
    return overviewLayout;
}

function findPlayer(source) {
    const owner = source?.GetOwner();
    for (const player of Instance.GetAllPlayerControllers()) {
        if (player.IsConnected() && (
            player === source
            || player.GetPlayerPawn() === source
            || player.GetObserverPawn() === source
            || player.GetPlayerPawn() === owner
        )) {
            return player;
        }
    }
    return undefined;
}

function setText(slot, panel, value) {
    hud()?.SetDialogVariableStringForPlayer(slot, panel, "value", value);
}

function renderOverview(state) {
    const id = state.id.toLowerCase();
    overview()?.SetDialogVariableString(`${id}-fusion`, "value", FUSIONS[state.fusion] ?? "");
    overview()?.SetDialogVariableString(
        `${id}-element`,
        "value",
        state.elements[state.element]?.[1] ?? "",
    );
    for (const [resource] of RESOURCES) {
        const value = Math.round(Math.max(0, Math.min(MAX_VALUE, state[resource])));
        overview()?.SetDialogVariableString(
            `${id}-${resource}`,
            "value",
            String(value).padStart(3, "0"),
        );
    }
}

function updateOverviewCard(state) {
    overview()?.SetHasClass(
        `${state.id.toLowerCase()}-card`,
        "Hidden",
        !OVERVIEW_DEBUG && state.holder === undefined,
    );
}

function setBar(state, resource, fill, force) {
    const value = Math.max(0, Math.min(MAX_VALUE, state[resource]));
    const step = Math.round(value);
    const previous = state.bars[resource];
    if (!force && previous === step) {
        return;
    }
    if (force) {
        for (let percent = 1; percent <= 100; percent += 1) {
            hud()?.SetHasClassForPlayer(state.holder, fill, `fill-${percent}`, false);
        }
    } else if (previous > 0) {
        hud()?.SetHasClassForPlayer(state.holder, fill, `fill-${previous}`, false);
    }
    if (step > 0) {
        hud()?.SetHasClassForPlayer(state.holder, fill, `fill-${step}`, true);
    }
    state.bars[resource] = step;
}

function render(state, force = false) {
    if (state.holder === undefined) {
        return;
    }
    setText(
        state.holder,
        "steam-id",
        state.elements[state.element]?.[2] ?? "",
    );
    setText(state.holder, "level", FUSIONS[state.fusion] ?? "");
    setText(state.holder, "element", state.elements[state.element]?.[1] ?? "");
    for (const [resource, , fill] of RESOURCES) {
        const value = Math.round(Math.max(0, Math.min(MAX_VALUE, state[resource])));
        setText(state.holder, resource, String(value).padStart(3, "0"));
        setBar(state, resource, fill, force);
    }
    hud()?.SetHasClassForPlayer(state.holder, "artifact-hud", "Hidden", false);
}

function hide(slot) {
    hud()?.SetHasClassForPlayer(slot, "artifact-hud", "Hidden", true);
}

function bind(state, slot, weapon) {
    for (const other of states) {
        if (other !== state && other.holder === slot) {
            other.holder = undefined;
            other.weapon = undefined;
            updateOverviewCard(other);
        }
    }
    if (state.holder !== undefined && state.holder !== slot) {
        hide(state.holder);
    }
    if (!state.initialized) {
        state.initialized = true;
        state.fusion = "";
        state.element = state.defaultElement;
    }
    state.holder = slot;
    state.weapon = weapon ?? state.weapon;
    state.bars.Magia = -1;
    state.bars.Materia = -1;
    render(state, true);
    updateOverviewCard(state);
    poll(state);
}

function pickup(state, event) {
    const player = findPlayer(event.activator) ?? findPlayer(event.caller);
    if (!player) {
        return;
    }
    const now = Instance.GetGameTime();
    const slot = player.GetPlayerSlot();
    const recent = recentPickups.get(slot);
    const currentOwnerSlot = state.weapon?.IsValid()
        ? state.weapon.GetOwner()?.GetPlayerController()?.GetPlayerSlot()
        : undefined;
    if (state.holder === slot && currentOwnerSlot === slot) {
        render(state, true);
        return;
    }
    const weapon = recent && now - recent.time <= PICKUP_PAIR_WINDOW
        ? recent.weapon
        : undefined;
    bind(state, slot, weapon);
    if (weapon) {
        recentPickups.delete(slot);
        pendingPickups.delete(slot);
    } else {
        pendingPickups.set(slot, { state, time: now });
    }
}

function poll(state) {
    for (const [resource, counterKey] of RESOURCES) {
        const counterName = state[counterKey];
        for (const counter of Instance.FindEntitiesByName(counterName)) {
            if (!state.connections[resource].has(counter)) {
                const id = Instance.ConnectOutput(counter, "OutValue", ({ value }) => {
                    const number = Number(value);
                    if (Number.isFinite(number)) {
                        state[resource] = number;
                        render(state);
                        renderOverview(state);
                    }
                });
                if (id !== undefined) {
                    state.connections[resource].add(counter);
                }
            }
        }
    }
}

function fusionTarget(event) {
    const callerName = event.caller?.GetEntityName();
    const byCaller = states.find((state) => state.synthesis === callerName);
    if (byCaller) {
        return byCaller;
    }
    const player = findPlayer(event.activator) ?? findPlayer(event.caller);
    const slot = player?.GetPlayerSlot();
    return slot === undefined ? undefined : states.find((state) => state.holder === slot);
}

function clearHolder(slot) {
    hide(slot);
    for (const state of states) {
        if (state.holder === slot) {
            state.holder = undefined;
            state.weapon = undefined;
            updateOverviewCard(state);
        }
    }
    recentPickups.delete(slot);
    pendingPickups.delete(slot);
}

function validateHolder(state) {
    if (state.holder === undefined) {
        return;
    }
    const slot = state.holder;
    const player = Instance.GetPlayerController(slot);
    const pawn = player?.GetPlayerPawn();
    const pending = pendingPickups.get(slot);
    const waitingForWeapon = !state.weapon
        && pending
        && Instance.GetGameTime() - pending.time <= PICKUP_PAIR_WINDOW;
    const weaponOwnerSlot = state.weapon?.IsValid()
        ? state.weapon.GetOwner()?.GetPlayerController()?.GetPlayerSlot()
        : undefined;
    if (
        !player?.IsConnected()
        || !pawn?.IsValid()
        || pawn.GetHealth() <= 0
        || pawn.GetTeamNumber() === 2
        || (!waitingForWeapon && weaponOwnerSlot !== slot)
    ) {
        clearHolder(slot);
    }
}

function reset(forceHidden = false) {
    recentPickups.clear();
    pendingPickups.clear();
    overviewToggledPlayers.clear();
    overviewDefaultVisible = !forceHidden && OVERVIEW_DEBUG;
    overview()?.SetHasClass("element-overview", "Hidden", !overviewDefaultVisible);
    for (const state of states) {
        Object.assign(state, {
            initialized: false,
            fusion: "",
            element: state.defaultElement,
            Magia: MAX_VALUE,
            Materia: MAX_VALUE,
            holder: undefined,
            weapon: undefined,
        });
        state.bars.Magia = -1;
        state.bars.Materia = -1;
        renderOverview(state);
        updateOverviewCard(state);
    }
    for (const player of Instance.GetAllPlayerControllers()) {
        if (player.IsConnected()) {
            const slot = player.GetPlayerSlot();
            hide(slot);
            overview()?.SetHasClassForPlayer(
                slot,
                "element-overview",
                "Hidden",
                !overviewDefaultVisible,
            );
        }
    }
}

for (const state of states) {
    Instance.OnScriptInput(state.pickup, (event) => pickup(state, event));
    Instance.OnScriptInput(state.fusionClear, () => {
        state.fusion = "";
        render(state);
        renderOverview(state);
    });
    for (const [element, [input]] of Object.entries(state.elements)) {
        Instance.OnScriptInput(input, () => {
            state.element = element;
            render(state);
        });
    }
}

for (const fusion of Object.keys(FUSIONS)) {
    Instance.OnScriptInput(fusion, (event) => {
        const state = fusionTarget(event);
        if (state) {
            state.fusion = fusion;
            render(state);
            renderOverview(state);
        }
    });
}

Instance.OnWeaponPickup(({ weapon }) => {
    if (weapon.GetData().GetType() !== CSWeaponType.PISTOL) {
        return;
    }
    const slot = weapon.GetOwner()?.GetPlayerController()?.GetPlayerSlot();
    if (slot === undefined) {
        return;
    }
    const now = Instance.GetGameTime();
    recentPickups.set(slot, { weapon, time: now });
    const pending = pendingPickups.get(slot);
    if (pending && now - pending.time <= PICKUP_PAIR_WINDOW) {
        bind(pending.state, slot, weapon);
        pendingPickups.delete(slot);
        recentPickups.delete(slot);
    } else if (pending) {
        pendingPickups.delete(slot);
    }
});

Instance.OnWeaponDrop(({ weapon, dropper }) => {
    const state = states.find((candidate) => candidate.weapon === weapon);
    if (!state) {
        return;
    }
    const slot = state.holder ?? dropper.GetPlayerController()?.GetPlayerSlot();
    if (slot !== undefined) {
        clearHolder(slot);
    }
});

Instance.OnPlayerChat(({ player, text }) => {
    if (!player || text.trim().toLowerCase() !== OVERVIEW_CHAT_COMMAND.toLowerCase()) {
        return;
    }
    const playerSlot = player.GetPlayerSlot();
    const toggled = !overviewToggledPlayers.has(playerSlot);
    if (toggled) {
        overviewToggledPlayers.add(playerSlot);
    } else {
        overviewToggledPlayers.delete(playerSlot);
    }
    overview()?.SetHasClassForPlayer(
        playerSlot,
        "element-overview",
        "Hidden",
        toggled ? overviewDefaultVisible : !overviewDefaultVisible,
    );
});
Instance.OnPlayerDisconnect(({ playerSlot }) => clearHolder(playerSlot));
Instance.OnRoundEnd(() => reset(true));
Instance.OnRoundStart(() => reset(true));
Instance.SetThink(() => {
    for (const state of states) {
        validateHolder(state);
        poll(state);
    }
    Instance.SetNextThink(Instance.GetGameTime() + POLL_INTERVAL);
});
Instance.OnActivate(() => {
    reset();
    Instance.SetNextThink(Instance.GetGameTime() + POLL_INTERVAL);
});
