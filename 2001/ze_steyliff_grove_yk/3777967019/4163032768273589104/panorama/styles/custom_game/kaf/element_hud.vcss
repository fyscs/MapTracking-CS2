/* Generated by StarDance */
/* https://github.com/Kxnrl */

.element-hud-root {
    width: 100%;
    height: 100%;
    font-family: Stratum2, "Arial Unicode MS";
}
.Hidden {
    visibility: collapse;
}
.element-overview {
    width: 315px;
    height: 160px;
    horizontal-align: right;
    vertical-align: bottom;
    margin-right: 200px;
    margin-bottom: 175px;
    flow-children: down;
}
.element-card {
    width: 100%;
    height: 50px;
    margin-bottom: 5px;
    padding: 3px 9px;
    flow-children: down;
    background-color: #00356ba0;
    border-radius: 2px;
}
.last-card {
    margin-bottom: 0;
}
.card-header,.card-values {
    width: 100%;
    height: 22px;
}
.card-values {
    flow-children: right;
}
.header-left {
    width: fit-children;
    height: 100%;
    horizontal-align: left;
    flow-children: right;
}
.value-half {
    width: 138px;
    height: 100%;
}
.element-title,.overview-info,.value-name,.resource-number,.value-divider {
    color: #f5f7f5;
    font-weight: normal;
    text-shadow: none;
}
.element-title {
    horizontal-align: left;
    vertical-align: center;
    font-size: 18px;
}
.overview-info {
    vertical-align: center;
    font-size: 19px;
}
.fusion-value {
    horizontal-align: right;
}
.Magia-group,.Materia-group {
    width: fit-children;
    height: 100%;
    flow-children: right;
    horizontal-align: center;
}
.value-name,.resource-number {
    vertical-align: bottom;
}
.value-name,.value-divider {
    font-size: 13px;
}
.resource-number {
    margin-left: 5px;
    font-size: 22px;
}
.value-divider {
    width: 21px;
    vertical-align: bottom;
    text-align: center;
    color: #b9d7ee;
}
