Instance.OnScriptInput("ApplyMegaElixirForAll", () => {
    debugLog("=== [ApplyMegaElixirForAll] 事件触发 ===");
    const players = Instance.FindEntitiesByClass("player");
    const healAmount = POTION_CONFIG.MegaElixir.healAmount;
    debugLog("[ApplyMegaElixirForAll] healAmount:", healAmount);

    let healedCount = 0;
    for (const player of players) {
        if (!isValidPlayer(player)) {
            continue;
        }
        if (player.GetHealth() <= 0 || player.GetTeamNumber() === 2) {
            debugLog("[ApplyMegaElixirForAll] 跳过玩家:", player.GetEntityName(), "健康:", player.GetHealth(), "队伍:", player.GetTeamNumber());
            continue;
        }

        const MaxHealth = player.GetMaxHealth();
        const oldHealth = player.GetHealth();
        const newHealth = Math.min(oldHealth + healAmount, MaxHealth);
        player.SetHealth(newHealth);
        debugLog("[ApplyMegaElixirForAll]", player.GetEntityName(), ":", oldHealth, "->", newHealth);
        healedCount++;
    }
    debugLog("[ApplyMegaElixirForAll] 治疗了", healedCount, "个玩家");
    RestoreItemManaAll();
});

function SetLevelAndSpawn(event, level) {
    debugLog("=== [SetLevelAndSpawn] level=", level, "===");
    const player = event.activator;
    if (!isValidPlayer(player)) {
        debugLog("[SetLevelAndSpawn] 玩家无效，返回");
        return;
    }

    const config = getConfig(player);
    if (!config) {
        debugLog("[SetLevelAndSpawn] 未找到玩家配置，返回");
        return;
    }

    const oldLevel = config.currentLevel;
    config.currentLevel = level;
    debugLog("[SetLevelAndSpawn] 等级变化:", oldLevel, "->", level);
    ForceSpawnLoop(player);
}

Instance.OnScriptInput("ForceSpawnLv1Item", (event) => SetLevelAndSpawn(event, 1));
Instance.OnScriptInput("ForceSpawnLv2Item", (event) => SetLevelAndSpawn(event, 2));
Instance.OnScriptInput("ForceSpawnLv3Item", (event) => SetLevelAndSpawn(event, 3));

Instance.OnScriptInput("ForceSpawnTempHurt", (event) => {
    debugLog("=== [ForceSpawnTempHurt] 事件触发 ===");
    ForceSpawnTemp(event.activator, 'hurt');
});

Instance.OnScriptInput("ForceSpawnTempTrigger", (event) => {
    debugLog("=== [ForceSpawnTempTrigger] 事件触发 ===");
    ForceSpawnTemp(event.activator, 'trigger');
});

function ResetHumanPotions() {
    const size = HumanItemsExplosionBuff.size;
    HumanItemsExplosionBuff.clear();
    debugLog("ResetHumanPotions: 清空了 HumanItemsExplosionBuff，之前大小=", size);
}

Instance.OnRoundStart(() => {
    debugLog("=== [OnRoundStart] 新回合开始 ===");
    ResetHumanPotions();
    debugLog("=== [OnRoundStart] 初始化完成 ===");
});

