import { Instance } from "cs_script/point_script";

// ============ DEBUG 配置 ============
const DEBUG = true;
const DEBUG_TAG = "[DEBUG]";

function debugLog(...args) {
    if (DEBUG) {
        const message = args.map(arg => {
            if (arg === null) return "null";
            if (arg === undefined) return "undefined";
            if (typeof arg === "object") {
                try {
                    return JSON.stringify(arg);
                } catch (e) {
                    return String(arg);
                }
            }
            return String(arg);
        }).join(" ");
        Instance.Msg(DEBUG_TAG + " " + message + "\n");
    }
}

// ============ 原有配置 ============
const POTION_CONFIG = {
    Elixir: {
        displayName: "圣灵药",
        healAmount: 50,
        manaAmount: 30,
        bufferAmount: 3
    },
    A_MegaElixir: {
        displayName: "高级圣灵药",
        healAmount: 75,
        manaAmount: 50,
        bufferAmount: 4
    },
    MegaElixir: {
        displayName: "终极圣灵药",
        healAmount: 175,
        manaAmount: 100,
        bufferAmount: 5
    },
    Ether: {
        displayName: "以太药",
        healAmount: 0,
        manaAmount: 20,
        bufferAmount: 2
    },
};

const SPECIAL_ITEM_CONFIG = {
    User_Blizzard: {
        counterName: "Item_Human_Blizzard_Magia_Counter",
        makerName: "Item_Human_Blizzard_Maker",
        synthesisName: "Item_Human_Blizzard_Synthesis_Text",
        currentLevel: 0,
        levels: [
            { hurtTemp: null, triggerTemp: null },
            { hurtTemp: "Item_Human_Blizzard_hurt_Template", triggerTemp: "Item_Human_Blizzard_Trigger_Template" },
            { hurtTemp: "Item_Human_Blizzara_hurt_Template", triggerTemp: "Item_Human_Blizzara_Trigger_Template" },
            { hurtTemp: "Item_Human_Blizzaga_hurt_Template", triggerTemp: "Item_Human_Blizzaga_Trigger_Template" }
        ]
    },
    User_Fire: {
        counterName: "Item_Human_Fire_Magia_Counter",
        makerName: "Item_Human_Fire_Maker",
        synthesisName: "Item_Human_Fire_Synthesis_Text",
        currentLevel: 0,
        levels: [
            { hurtTemp: null, triggerTemp: null },
            { hurtTemp: "Item_Human_Fire_hurt_Template", triggerTemp: "Item_Human_Fire_Trigger_Template" },
            { hurtTemp: "Item_Human_Fira_hurt_Template", triggerTemp: "Item_Human_Fira_Trigger_Template" },
            { hurtTemp: "Item_Human_Firaga_hurt_Template", triggerTemp: "Item_Human_Firaga_Trigger_Template" }
        ]
    },
    User_Thunder: {
        counterName: "Item_Human_Thunder_Magia_Counter",
        makerName: "Item_Human_Thunder_Maker",
        synthesisName: "Item_Human_Thunder_Synthesis_Text",
        currentLevel: 0,
        levels: [
            { hurtTemp: null, triggerTemp: null },
            { hurtTemp: "Item_Human_Thunder_hurt_Template", triggerTemp: "Item_Human_Thunder_Trigger_Template" },
            { hurtTemp: "Item_Human_Thundara_hurt_Template", triggerTemp: "Item_Human_Thundara_Trigger_Template" },
            { hurtTemp: "Item_Human_Thundaga_hurt_Template", triggerTemp: "Item_Human_Thundaga_Trigger_Template" }
        ]
    }
};

const HumanItemsExplosionBuff = new Map();

// ============ 原有函数（添加调试日志） ============

function isValidPlayer(player) {
    const valid = player && player.IsValid();
    if (!valid && DEBUG) {
        debugLog("isValidPlayer: 无效玩家", player ? `"${player.GetEntityName()}"` : "null");
    }
    return valid;
}

function splitName(name) {
    const parts = name ? name.split('_') : [];
    debugLog("splitName:", name, "=>", parts);
    return parts;
}

function getConfig(player) {
    if (!isValidPlayer(player)) {
        debugLog("getConfig: 玩家无效，返回 null");
        return null;
    }
    const name = player.GetEntityName();
    const config = name ? SPECIAL_ITEM_CONFIG[name] : null;
    debugLog("getConfig: 玩家名=", name, "配置=", config ? "找到" : "未找到");
    return config;
}

function AddMP(counterName, manaAmount) {
    debugLog("AddMP: counterName=", counterName, "manaAmount=", manaAmount);
    Instance.EntFireAtName({ name: counterName, input: "Add", value: manaAmount });
    debugLog("AddMP: EntFireAtName 已调用");
}

function RestoreItemMana(player, manaAmount) {
    debugLog("RestoreItemMana: 开始, manaAmount=", manaAmount);
    if (!isValidPlayer(player) || manaAmount <= 0) {
        debugLog("RestoreItemMana: 提前返回 (玩家无效或MP<=0)");
        return;
    }

    const config = getConfig(player);
    if (config) {
        debugLog("RestoreItemMana: 找到配置，调用 AddMP");
        AddMP(config.counterName, manaAmount);
    } else {
        debugLog("RestoreItemMana: 未找到玩家配置");
    }
}

function RestoreItemManaAll() {
    debugLog("RestoreItemManaAll: 开始给所有玩家恢复MP");
    for (const playerName in SPECIAL_ITEM_CONFIG) {
        const config = SPECIAL_ITEM_CONFIG[playerName];
        debugLog("RestoreItemManaAll: 给", playerName, "恢复 MP=", POTION_CONFIG.MegaElixir.manaAmount);
        AddMP(config.counterName, POTION_CONFIG.MegaElixir.manaAmount);
    }
}

function SynthesisItem(player, bufferAmount) {
    debugLog("SynthesisItem: bufferAmount=", bufferAmount);
    if (!isValidPlayer(player) || !player.GetEntityName()) {
        debugLog("SynthesisItem: 玩家无效或无名称，返回");
        return;
    }

    const config = getConfig(player);
    if (!config) {
        debugLog("SynthesisItem: 未找到玩家配置，返回");
        return;
    }

    HumanItemsExplosionBuff.set(player.GetEntityName(), bufferAmount);
    const inputName = `FireUser${bufferAmount - 1}`;
    debugLog("SynthesisItem: 设置buffer=", bufferAmount, "触发 input=", inputName);
    Instance.EntFireAtName({ name: config.synthesisName, input: inputName });
    debugLog("SynthesisItem: EntFireAtName 已调用");
}

function ForceSpawnLoop(player) {
    debugLog("ForceSpawnLoop: 开始");
    if (!isValidPlayer(player)) {
        debugLog("ForceSpawnLoop: 玩家无效，返回");
        return;
    }
    const bufferAmount = HumanItemsExplosionBuff.get(player.GetEntityName());
    debugLog("ForceSpawnLoop: bufferAmount=", bufferAmount);
    if (bufferAmount) {
        const config = SPECIAL_ITEM_CONFIG[player.GetEntityName()];
        if (config) {
            const inputName = `FireUser${bufferAmount - 1}`;
            debugLog("ForceSpawnLoop: 使用maker触发 input=", inputName);
            Instance.EntFireAtName({ name: config.makerName, input: inputName, activator: player });
			Instance.EntFireAtName({ name: config.synthesisName, input: "Disabie"});
            HumanItemsExplosionBuff.set(player.GetEntityName(), 0);
        } else {
            debugLog("ForceSpawnLoop: 未找到配置");
        }
    } else {
        debugLog("ForceSpawnLoop: 无buffer，调用 ForceSpawnTemp(trigger)");
        ForceSpawnTemp(player, 'trigger');
    }

}

function ForceSpawnTemp(player, type) {
    debugLog("ForceSpawnTemp: type=", type);
    if (!isValidPlayer(player)) {
        debugLog("ForceSpawnTemp: 玩家无效，返回");
        return;
    }

    const config = getConfig(player);
    if (!config || !config.levels) {
        debugLog("ForceSpawnTemp: 无配置或levels，返回");
        return;
    }

    const level = config.currentLevel;
    const templateName = config.levels[level]?.[type === 'hurt' ? 'hurtTemp' : 'triggerTemp'];
    debugLog("ForceSpawnTemp: level=", level, "templateName=", templateName);
    
    if (!templateName) {
        debugLog("ForceSpawnTemp: templateName为空，返回");
        return;
    }

    const template = Instance.FindEntityByName(templateName);
    if (!template) {
        debugLog("ForceSpawnTemp: 未找到模板实体", templateName);
        return;
    }

    const maker = Instance.FindEntityByName(config.makerName);
    if (!maker) {
        debugLog("ForceSpawnTemp: 未找到maker实体", config.makerName);
        return;
    }

    debugLog("ForceSpawnTemp: 执行 ForceSpawn 在位置", maker.GetAbsOrigin());
    template.ForceSpawn(maker.GetAbsOrigin());
}

// ============ 事件监听（添加调试日志） ============

Instance.OnScriptInput("PickUp", (event) => {
    debugLog("=== [PickUp] 事件触发 ===");
    const player = event.activator;
    if (!isValidPlayer(player)) {
        debugLog("[PickUp] 玩家无效，返回");
        return;
    }

    const buttonname = event.caller?.GetEntityName();
    debugLog("[PickUp] caller名称:", buttonname);
    
    if (!buttonname) {
        debugLog("[PickUp] buttonname为空，返回");
        return;
    }

    const parts = splitName(buttonname);
    const potionType = parts[2] === "A" ? `${parts[2]}_${parts[3]}` : parts[2];
    debugLog("[PickUp] potionType:", potionType);
    
    if (!potionType) {
        debugLog("[PickUp] potionType为空，返回");
        return;
    }

    const suffix = parts[parts.length - 1];
    const newname = `User_${potionType}_${suffix}`;
    debugLog("[PickUp] 新名称:", newname);

    const lastowner = Instance.FindEntityByName(newname);
    if (lastowner) {
        debugLog("[PickUp] 找到旧拥有者，重置为 User_None");
        lastowner.SetEntityName("User_None");
    }

    const oldName = player.GetEntityName();
    player.SetEntityName(newname);
    debugLog("[PickUp] 玩家名称已更改:", oldName, "->", newname);
});

Instance.OnScriptInput("Use", (event) => {
    debugLog("=== [Use] 事件触发 ===");
    const player = event.activator;
    if (!isValidPlayer(player)) {
        debugLog("[Use] 玩家无效，返回");
        return;
    }

    const playername = player.GetEntityName();
    const buttonname = event.caller?.GetEntityName();
    debugLog("[Use] 玩家名:", playername, "caller:", buttonname);

    if (!buttonname) {
        debugLog("[Use] buttonname为空，返回");
        return;
    }

    const parts = splitName(buttonname);
    const suffix = parts[parts.length - 1];
    const potionType = parts[2] === "A" ? `${parts[2]}_${parts[3]}` : parts[2];
    debugLog("[Use] potionType:", potionType, "suffix:", suffix);

    if (!potionType) {
        debugLog("[Use] potionType为空，返回");
        return;
    }

    const expectedName = `User_${potionType}_${suffix}`;
    debugLog("[Use] 期望玩家名:", expectedName);

    if (playername === expectedName) {
        debugLog("[Use] 匹配成功，触发 FireUser4");
        Instance.EntFireAtTarget({ target: event.caller, input: "FireUser4",activator: player});
    } else {
        debugLog("[Use] 不匹配，忽略");
    }
});

Instance.OnScriptInput("ApplyMana", (event) => {
    debugLog("=== [ApplyMana] 事件触发 ===");
    const player = event.activator;
    if (!isValidPlayer(player)) {
        debugLog("[ApplyMana] 玩家无效，返回");
        return;
    }

    const playerName = player.GetEntityName();
    debugLog("[ApplyMana] 玩家名:", playerName);

    if (!SPECIAL_ITEM_CONFIG[playerName]) {
        debugLog("[ApplyMana] 玩家不在特殊配置中，返回");
        return;
    }

    const triggername = event.caller?.GetEntityName();
    debugLog("[ApplyMana] trigger名称:", triggername);

    if (!triggername) {
        debugLog("[ApplyMana] triggername为空，返回");
        return;
    }

    const parts = splitName(triggername);
    const potionType = parts[2] === "A" ? `${parts[2]}_${parts[3]}` : parts[2];
    debugLog("[ApplyMana] potionType:", potionType);

    if (!potionType) {
        debugLog("[ApplyMana] potionType为空，返回");
        return;
    }

    const config = POTION_CONFIG[potionType];
    if (!config) {
        debugLog("[ApplyMana] 未找到药水配置:", potionType);
        return;
    }

    debugLog("[ApplyMana] 恢复MP:", config.manaAmount);
    RestoreItemMana(player, config.manaAmount);
});

Instance.OnScriptInput("Synthesis", (event) => {
    debugLog("=== [Synthesis] 事件触发 ===");
    const player = event.activator;
    if (!isValidPlayer(player)) {
        debugLog("[Synthesis] 玩家无效，返回");
        return;
    }

    const playerName = player.GetEntityName();
    debugLog("[Synthesis] 玩家名:", playerName);

    if (!SPECIAL_ITEM_CONFIG[playerName]) {
        debugLog("[Synthesis] 玩家不在特殊配置中，返回");
        return;
    }

    const triggername = event.caller?.GetEntityName();
    debugLog("[Synthesis] trigger名称:", triggername);

    if (!triggername) {
        debugLog("[Synthesis] triggername为空，返回");
        return;
    }

    const parts = splitName(triggername);
    const potionType = parts[2] === "A" ? `${parts[2]}_${parts[3]}` : parts[2];
    debugLog("[Synthesis] potionType:", potionType);

    if (!potionType) {
        debugLog("[Synthesis] potionType为空，返回");
        return;
    }

    const config = POTION_CONFIG[potionType];
    if (!config) {
        debugLog("[Synthesis] 未找到药水配置:", potionType);
        return;
    }

    debugLog("[Synthesis] bufferAmount:", config.bufferAmount);
    SynthesisItem(player, config.bufferAmount);
    debugLog("[Synthesis] 触发 FireUser4");
    Instance.EntFireAtTarget({ target: event.caller, input: "FireUser4" });
});

Instance.OnScriptInput("PickUpBlizzard", (event) => {
    debugLog("=== [PickUpBlizzard] 事件触发 ===");
    const player = event.activator;
    if (!player || !player.IsValid()) {
        debugLog("[PickUpBlizzard] 玩家无效，返回");
        return;
    }
    const oldName = player.GetEntityName();
    player.SetEntityName("User_Blizzard");
    debugLog("[PickUpBlizzard] 玩家名称已更改:", oldName, "-> User_Blizzard");
});

