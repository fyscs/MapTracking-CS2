/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
#compute_dialog {
    width: 800px;
    height: 700px;
    horizontal-align: center;
    vertical-align: middle;
    flow-children: down;
    padding: 30px;
    background-color: #050a08ee;
    border: 2px solid #00ff88;
    transition-property: opacity;
    transition-duration: 0.2s;
    opacity: 1;
}
#compute_dialog.Hidden {
    opacity: 0;
}
#compute_dialog.Success {
    border: 2px solid #00ff88;
    background-color: #04170dee;
}
#status_label.Success,#code_label.Success,#progress_label.Success {
    color: #00ff88;
}
#compute_dialog.Error {
    border: 2px solid #ff4444;
    background-color: #170404ee;
}
#status_label.Error,#code_label.Error,#progress_label.Error {
    color: #ff4444;
}
#display_panel {
    flow-children: down;
    horizontal-align: center;
    margin-bottom: 30px;
}
#status_label {
    horizontal-align: center;
    font-size: 24px;
    color: #7dffb8;
    letter-spacing: 6px;
    margin-bottom: 10px;
}
#code_label {
    horizontal-align: center;
    font-size: 120px;
    color: #ffffff;
    text-shadow: none;
    height: 160px;
    margin-bottom: 5px;
}
#progress_label {
    horizontal-align: center;
    font-size: 20px;
    color: #55aa88;
}
#keyboard_container {
    flow-children: down;
    horizontal-align: center;
}
.KeyRow {
    flow-children: right;
    horizontal-align: center;
    margin-bottom: 8px;
}
.KeyRow Button {
    width: 60px;
    height: 50px;
    margin: 0 4px;
    background-color: #0a1f15;
    border: 1px solid #00ff8866;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.KeyRow Button:hover {
    background-color: #00ff8844;
    border-color: #00ff88;
}
.KeyRow Button Label {
    horizontal-align: center;
    vertical-align: middle;
    font-size: 26px;
    color: #ccffee;
}
.FuncRow Button {
    width: 200px !important;
    background-color: #1a0a0a;
    border-color: #ff444466;
}
.FuncRow Button:hover {
    background-color: #ff444444;
    border-color: #ff4444;
}
.FuncRow Button Label {
    color: #ffcccc;
    font-size: 22px;
}
