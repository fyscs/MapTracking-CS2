/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
#bosshp-container {
    width: 620px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 110px;
    flow-children: down;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
#bosshp-container.Visible {
    opacity: 1.0;
    visibility: visible;
}
#bosshp-container.FadingOut {
    opacity: 0.0;
    visibility: visible;
}
#bosshp-container.Hidden {
    opacity: 0.0;
    visibility: collapse;
}
#bosshp-track {
    width: 100%;
    height: 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 2px;
}
#bosshp-shadow {
    height: 100%;
    background-color: rgba(255, 255, 255, 0.30);
    border-radius: 2px;
}
#bosshp-fill {
    height: 100%;
    background-color: #4ADE80;
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
#bosshp-fill.hp_high {
    background-color: #4ADE80;
}
#bosshp-fill.hp_mid {
    background-color: #FACC15;
}
#bosshp-fill.hp_low {
    background-color: #EF4444;
}
#bosshp-frame {
    width: 100%;
    padding: 8px 14px 10px 14px;
    background-color: rgba(6, 10, 14, 0.78);
    border: 1px solid rgba(120, 180, 255, 0.30);
    border-top: 2px solid rgba(120, 180, 255, 0.75);
    border-radius: 4px;
    flow-children: down;
}
#bosshp-header {
    width: 100%;
    height: 22px;
    margin-bottom: 7px;
    border-bottom: 1px solid rgba(120, 180, 255, 0.20);
}
#bosshp-title {
    width: 100%;
    text-align: left;
    font-size: 17px;
    letter-spacing: 2px;
    color: #E8F2FF;
    text-shadow: 1px 1px 3px #000000;
}
#bosshp-value {
    width: 100%;
    margin-top: 7px;
    text-align: right;
    font-size: 14px;
    color: #9FB6CC;
    text-shadow: 1px 1px 2px #000000;
}
