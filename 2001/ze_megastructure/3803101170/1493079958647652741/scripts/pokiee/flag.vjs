import { Instance, Entity, PointTemplate } from "cs_script/point_script";

// author: PokieeAkuno
// this script is only for temp random spawn
// region function may only work in 2D, 3D haven't tested yet and will not support

const AABBPOINT_CLASS_NAME = "info_target";
const FLAG_POINT_NAME_PATTERN = /^flag_point_([A-Za-z]+)$/i;

/**
 * 
 * @param {string} suffix 
 * @returns {number}
 */
function flagSuffixToOrder(suffix) {
    let order = 0;

    for (let i = 0; i < suffix.length; i++) {
        const code = suffix.toUpperCase().charCodeAt(i);

        // A = 65, Z = 90
        if (code < 65 || code > 90) {
            return Number.MAX_SAFE_INTEGER;
        }

        order = order * 26 + (code - 64);
    }

    return order;
}

function collectOrderedFlagPointEntries() {
    /**
     * @type {{
     *   entity: Entity,
     *   key: string,
     *   order: number,
     *   origin: { x: number, y: number, z: number }
     * }[]}
     */
    const entries = [];

    /** @type {Set<string>} */
    const usedKeys = new Set();

    for (const entity of Instance.FindEntitiesByClass(AABBPOINT_CLASS_NAME)) {
        if (!entity.IsValid()) {
            continue;
        }

        const name = entity.GetEntityName();
        const match = FLAG_POINT_NAME_PATTERN.exec(name);

        if (!match || !match[1]) {
            continue;
        }

        const key = match[1].toUpperCase();

        // prevent same name
        if (usedKeys.has(key)) {
            continue;
        }

        usedKeys.add(key);

        entries.push({
            entity,
            key,
            order: flagSuffixToOrder(key),
            origin: entity.GetAbsOrigin(),
        });
    }

    entries.sort((a, b) => {
        if (a.order !== b.order) {
            return a.order - b.order;
        }

        if (a.key < b.key) {
            return -1;
        }

        if (a.key > b.key) {
            return 1;
        }

        return 0;
    });

    return entries;
}

/**
 * 
 * @param {{ x: number, y: number, z: number }} pos 
 * @param {{ x: number, y: number, z: number }[]} vertices 
 * @returns {boolean}
 */
function isPointInPolygon2D(pos, vertices) {
    let inside = false;

    for (let i = 0, j = vertices.length - 1; i < vertices.length; j = i++) {
        const vi = vertices[i];
        const vj = vertices[j];

        const intersects =
            ((vi.y > pos.y) !== (vj.y > pos.y)) &&
            (pos.x < ((vj.x - vi.x) * (pos.y - vi.y)) / (vj.y - vi.y) + vi.x);

        if (intersects) {
            inside = !inside;
        }
    }

    return inside;
}

/**
 * @param {{ x: number, y: number, z: number }[]} vertices
 * @param {number} zTolerance
 */
function createFlagRegion(vertices, zTolerance = 96) {
    if (!Array.isArray(vertices) || vertices.length < 3) {
        return undefined;
    }

    let minX = Infinity;
    let maxX = -Infinity;
    let minY = Infinity;
    let maxY = -Infinity;
    let minZ = Infinity;
    let maxZ = -Infinity;

    for (const v of vertices) {
        if (v.x < minX) minX = v.x;
        if (v.x > maxX) maxX = v.x;
        if (v.y < minY) minY = v.y;
        if (v.y > maxY) maxY = v.y;
        if (v.z < minZ) minZ = v.z;
        if (v.z > maxZ) maxZ = v.z;
    }

    minZ -= zTolerance;
    maxZ += zTolerance;

    return {
        vertices,
        minX,
        maxX,
        minY,
        maxY,
        minZ,
        maxZ,

        /**
         * @param {{ x: number, y: number, z: number }} pos
         * @returns {boolean}
         */
        contains(pos) {
            if (pos.x < minX || pos.x > maxX) {
                return false;
            }

            if (pos.y < minY || pos.y > maxY) {
                return false;
            }

            if (pos.z < minZ || pos.z > maxZ) {
                return false;
            }

            return isPointInPolygon2D(pos, vertices);
        },

        /**
         * this is a debug function for mapper
         * 
         * @param {number} duration
         * @param {{ r: number, g: number, b: number, a?: number }} color
         */
        draw(duration = 10, color = { r: 0, g: 255, b: 0, a: 255 }) {
            for (let i = 0; i < vertices.length; i++) {
                const start = vertices[i];
                const end = vertices[(i + 1) % vertices.length];

                Instance.DebugLine({
                    start,
                    end,
                    duration,
                    color,
                });
            }
        },
    };
}

/** @type {Entity[]} */
let points = [];

/** @type {ReturnType<typeof createFlagRegion>} */
let flagRegion;

function rebuildFlagRegion() {
    const entries = collectOrderedFlagPointEntries();
    points = entries.map((entry) => entry.entity);

    const vertices = entries.map((entry) => entry.origin);
    flagRegion = createFlagRegion(vertices, 96);
    if (!flagRegion) return;
}

Instance.OnRoundStart(() => {
    rebuildFlagRegion();
    /*
    if (flagRegion) {
        flagRegion.draw(15);
    } else {
        rebuildFlagRegion();
    }
    */
})











const FLAG_SPAWN_TEMPLATE_NAME = "item_flag_temp";
const FLAG_SPAWN_RADIUS = 384;
const FLAG_SPAWN_GAP = 512;

const FLAG_SPAWN_MIN_CENTER_DISTANCE =
    FLAG_SPAWN_RADIUS + FLAG_SPAWN_GAP + FLAG_SPAWN_RADIUS;

const FLAG_SPAWN_KEEP_FULLY_INSIDE = true;

const FLAG_SPAWN_MAX_COUNT = 512;

const FLAG_SPAWN_BRIDSON_ATTEMPTS = 30;
const FLAG_SPAWN_SEED_ATTEMPTS = 4096;

const FLAG_SPAWNS_PER_TICK = 8;

const FLAG_SPAWN_USE_GROUND_TRACE = true;
const FLAG_SPAWN_TRACE_UP = 512;
const FLAG_SPAWN_TRACE_DOWN = 1024;
const FLAG_SPAWN_GROUND_OFFSET = 1;

/**
 * @typedef {{
 *   vertices: { x: number, y: number, z: number }[],
 *   minX: number,
 *   maxX: number,
 *   minY: number,
 *   maxY: number,
 *   minZ: number,
 *   maxZ: number,
 *   contains: (pos: { x: number, y: number, z: number }) => boolean,
 *   draw: (
 *     duration?: number,
 *     color?: { r: number, g: number, b: number, a?: number }
 *   ) => void
 * }} FlagRegionType
 */

/** @type {Entity[]} */
let spawnedFlagEntities = [];

let flagSpawnGeneration = 0;

/**
 * @param {{ x: number, y: number, z: number }} p
 * @param {{ x: number, y: number, z: number }} a
 * @param {{ x: number, y: number, z: number }} b
 * @returns {number}
 */
function flagSpawnDistanceSquaredToSegment2D(p, a, b) {
    const abx = b.x - a.x;
    const aby = b.y - a.y;
    const apx = p.x - a.x;
    const apy = p.y - a.y;

    const len2 = abx * abx + aby * aby;

    if (len2 === 0) {
        return apx * apx + apy * apy;
    }

    let t = (apx * abx + apy * aby) / len2;

    if (t < 0) {
        t = 0;
    } else if (t > 1) {
        t = 1;
    }

    const cx = a.x + abx * t;
    const cy = a.y + aby * t;

    const dx = p.x - cx;
    const dy = p.y - cy;

    return dx * dx + dy * dy;
}

/**
 * @param {{ x: number, y: number, z: number }} pos
 * @param {{ x: number, y: number, z: number }[]} vertices
 * @param {number} padding
 * @returns {boolean}
 */
function flagSpawnIsPointInsidePolygonWithPadding(pos, vertices, padding) {
    if (!isPointInPolygon2D(pos, vertices)) {
        return false;
    }

    if (padding <= 0) {
        return true;
    }

    const padding2 = padding * padding;

    for (let i = 0, j = vertices.length - 1; i < vertices.length; j = i++) {
        const dist2 = flagSpawnDistanceSquaredToSegment2D(
            pos,
            vertices[i],
            vertices[j]
        );

        if (dist2 < padding2) {
            return false;
        }
    }

    return true;
}

/**
 * @param {FlagRegionType} region
 * @param {number} minDistance
 * @param {number} padding
 * @param {number} maxPoints
 * @returns {{ x: number, y: number, z: number }[]}
 */
function generateFlagSpawnPoints(region, minDistance, padding, maxPoints) {
    const width = region.maxX - region.minX;
    const height = region.maxY - region.minY;

    if (width <= 0 || height <= 0 || maxPoints <= 0) {
        return [];
    }

    const cellSize = minDistance / Math.SQRT2;

    const gridWidth = Math.max(1, Math.ceil(width / cellSize));
    const gridHeight = Math.max(1, Math.ceil(height / cellSize));

    /** @type {number[]} */
    const grid = new Array(gridWidth * gridHeight).fill(-1);

    /** @type {{ x: number, y: number, z: number }[]} */
    const samples = [];

    /** @type {number[]} */
    const active = [];

    const minDistance2 = minDistance * minDistance;

    /**
     * @param {number} gx
     * @param {number} gy
     * @returns {number}
     */
    function gridIndex(gx, gy) {
        return gy * gridWidth + gx;
    }

    /**
     * @param {number} value
     * @param {number} max
     * @returns {number}
     */
    function clampGridIndex(value, max) {
        return Math.max(0, Math.min(max - 1, value));
    }

    /**
     * @param {{ x: number, y: number, z: number }} p
     * @returns {{ gx: number, gy: number }}
     */
    function toGrid(p) {
        const gx = clampGridIndex(
            Math.floor((p.x - region.minX) / cellSize),
            gridWidth
        );

        const gy = clampGridIndex(
            Math.floor((p.y - region.minY) / cellSize),
            gridHeight
        );

        return { gx, gy };
    }

    /**
     * @param {{ x: number, y: number, z: number }} p
     * @returns {boolean}
     */
    function hasNearbySample(p) {
        const { gx, gy } = toGrid(p);

        const x0 = Math.max(0, gx - 2);
        const x1 = Math.min(gridWidth - 1, gx + 2);
        const y0 = Math.max(0, gy - 2);
        const y1 = Math.min(gridHeight - 1, gy + 2);

        for (let y = y0; y <= y1; y++) {
            for (let x = x0; x <= x1; x++) {
                const sampleIndex = grid[gridIndex(x, y)];

                if (sampleIndex === -1) {
                    continue;
                }

                const s = samples[sampleIndex];

                const dx = p.x - s.x;
                const dy = p.y - s.y;

                if (dx * dx + dy * dy < minDistance2) {
                    return true;
                }
            }
        }

        return false;
    }

    /**
     * @param {{ x: number, y: number, z: number }} p
     * @returns {boolean}
     */
    function isValidPoint(p) {
        if (p.x < region.minX || p.x > region.maxX) {
            return false;
        }

        if (p.y < region.minY || p.y > region.maxY) {
            return false;
        }

        if (!flagSpawnIsPointInsidePolygonWithPadding(p, region.vertices, padding)) {
            return false;
        }

        return !hasNearbySample(p);
    }

    /**
     * @param {{ x: number, y: number, z: number }} p
     */
    function addSample(p) {
        samples.push(p);
        active.push(samples.length - 1);

        const { gx, gy } = toGrid(p);
        grid[gridIndex(gx, gy)] = samples.length - 1;
    }

    /**
     * @returns {{ x: number, y: number, z: number } | undefined}
     */
    function findSeed() {
        for (let i = 0; i < FLAG_SPAWN_SEED_ATTEMPTS; i++) {
            const p = {
                x: region.minX + Math.random() * width,
                y: region.minY + Math.random() * height,
                z: 0,
            };

            if (isValidPoint(p)) {
                return p;
            }
        }

        for (let gy = 0; gy < gridHeight; gy++) {
            for (let gx = 0; gx < gridWidth; gx++) {
                if (grid[gridIndex(gx, gy)] !== -1) {
                    continue;
                }

                const cellMinX = region.minX + gx * cellSize;
                const cellMaxX = Math.min(region.maxX, cellMinX + cellSize);

                const cellMinY = region.minY + gy * cellSize;
                const cellMaxY = Math.min(region.maxY, cellMinY + cellSize);

                if (cellMaxX <= cellMinX || cellMaxY <= cellMinY) {
                    continue;
                }

                for (let n = 0; n < 4; n++) {
                    const p = {
                        x: cellMinX + Math.random() * (cellMaxX - cellMinX),
                        y: cellMinY + Math.random() * (cellMaxY - cellMinY),
                        z: 0,
                    };

                    if (isValidPoint(p)) {
                        return p;
                    }
                }
            }
        }

        return undefined;
    }

    function expandFromActiveList() {
        while (active.length > 0 && samples.length < maxPoints) {
            const activeIndex = Math.floor(Math.random() * active.length);
            const center = samples[active[activeIndex]];

            let found = false;

            for (let i = 0; i < FLAG_SPAWN_BRIDSON_ATTEMPTS; i++) {
                const angle = Math.random() * Math.PI * 2;
                const distance = minDistance * (1 + Math.random());

                const p = {
                    x: center.x + Math.cos(angle) * distance,
                    y: center.y + Math.sin(angle) * distance,
                    z: 0,
                };

                if (isValidPoint(p)) {
                    addSample(p);
                    found = true;
                    break;
                }
            }

            if (!found) {
                active.splice(activeIndex, 1);
            }
        }
    }

    const firstSeed = findSeed();

    if (!firstSeed) {
        return [];
    }

    addSample(firstSeed);
    expandFromActiveList();

    while (samples.length < maxPoints) {
        const seed = findSeed();

        if (!seed) {
            break;
        }

        addSample(seed);
        expandFromActiveList();
    }

    return samples;
}

/**
 * @returns {PointTemplate | undefined}
 */
function findFlagTemplate() {
    const byName = Instance.FindEntityByName(FLAG_SPAWN_TEMPLATE_NAME);

    if (byName instanceof PointTemplate) {
        return byName;
    }

    for (const ent of Instance.FindEntitiesByClass("point_template")) {
        if (
            ent instanceof PointTemplate &&
            ent.GetEntityName() === FLAG_SPAWN_TEMPLATE_NAME
        ) {
            return ent;
        }
    }

    return undefined;
}

/**
 * @param {number} x
 * @param {number} y
 * @param {FlagRegionType} region
 * @returns {number}
 */
function getFlagSpawnZ(x, y, region) {
    const fallbackZ = (region.minZ + region.maxZ) * 0.5;

    if (!FLAG_SPAWN_USE_GROUND_TRACE) {
        return fallbackZ;
    }

    const trace = Instance.TraceLine({
        start: {
            x,
            y,
            z: region.maxZ + FLAG_SPAWN_TRACE_UP,
        },
        end: {
            x,
            y,
            z: region.minZ - FLAG_SPAWN_TRACE_DOWN,
        },
        ignorePlayers: true,
        ignoreEntity:
            spawnedFlagEntities.length > 0 ? spawnedFlagEntities : undefined,
    });

    if (trace.didHit) {
        return trace.end.z + FLAG_SPAWN_GROUND_OFFSET;
    }

    return fallbackZ;
}

async function spawnFlagItems() {
    const gen = ++flagSpawnGeneration;

    const template = findFlagTemplate();

    if (!template) return;
    if (!flagRegion) rebuildFlagRegion();

    if (!flagRegion) return;

    const region = flagRegion;

    const padding = FLAG_SPAWN_KEEP_FULLY_INSIDE ? FLAG_SPAWN_RADIUS : 0;

    const spawnPoints = generateFlagSpawnPoints(
        region,
        FLAG_SPAWN_MIN_CENTER_DISTANCE,
        padding,
        FLAG_SPAWN_MAX_COUNT
    );

    if (spawnPoints.length === 0) return;

    /** @type {{ x: number, y: number, z: number }[]} */
    const spawnedPositions = [];

    for (let i = 0; i < spawnPoints.length; i++) {
        if (gen !== flagSpawnGeneration) {
            return;
        }

        const p = spawnPoints[i];

        const z = getFlagSpawnZ(p.x, p.y, region);

        const origin = {
            x: p.x,
            y: p.y,
            z,
        };

        const yaw = Math.floor(Math.random() * 360);

        const spawned = template.ForceSpawn(origin, {
            pitch: 0,
            yaw,
            roll: 0,
        });

        if (spawned) {
            spawnedFlagEntities.push(...spawned);
            spawnedPositions.push(origin);
        }

        if ((i + 1) % FLAG_SPAWNS_PER_TICK === 0) {
            await Instance.Delay(0);
        }
    }

    if (gen !== flagSpawnGeneration) {
        return;
    }
}

Instance.OnScriptInput("flag_spawn_items", () => {
    void spawnFlagItems();
});

