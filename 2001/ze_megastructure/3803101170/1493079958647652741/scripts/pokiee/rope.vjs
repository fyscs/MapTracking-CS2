// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Entity, CSMoveType } from "cs_script/point_script";

const ROPE_SPEED = 512;
const APPROACH_SPEED = 512;
const LAUNCH_SPEED = 512;

/**
 * @typedef {Object} RopeState
 * @property {string} ropeId
 * @property {"approach" | "travel"} phase
 * @property {{ x: number, y: number, z: number }} from
 * @property {{ x: number, y: number, z: number }} to
 * @property {number} startTime
 * @property {number} duration
 * @property {{ x: number, y: number, z: number }} ropeStart
 * @property {{ x: number, y: number, z: number }} ropeEnd
 * @property {CSMoveType} savedMoveType
 */

/** @type {Map<Entity, RopeState>} */
const playerRopeMap = new Map();



Instance.OnScriptInput("rope", ({ caller, activator }) => {
    if (!caller || !caller.IsValid()) return;
    if (!activator || !activator.IsValid() || !activator.IsAlive()) return;
    if (playerRopeMap.has(activator)) return;

    const buttonName = caller.GetEntityName();
    const match = buttonName.match(/^rope_(\d+)_button$/);
    if (!match) return;

    const id = match[1];
    const startTarget = Instance.FindEntityByName(`rope_${id}_start`);
    const endTarget = Instance.FindEntityByName(`rope_${id}_end`);
    if (!startTarget || !endTarget) return;

    StartRopeMovement(activator, id, startTarget, endTarget);
});

Instance.OnScriptInput("derope", ({ caller }) => {
    if (!caller || !caller.IsValid()) return;

    const buttonName = caller.GetEntityName();
    const match = buttonName.match(/^rope_(\d+)_button$/);
    if (!match) return;

    const id = match[1];

    for (const [player, state] of playerRopeMap) {
        if (state.ropeId === id) {
            playerRopeMap.delete(player);

            if (player.IsValid() && player.IsAlive()) {
                endRopeControl(player, state.savedMoveType);

                player.Teleport({
                    velocity: zeroVelocity()
                });
            }
        }
    }
});

Instance.OnPlayerReset(({ player }) => {
    const state = playerRopeMap.get(player);
    if (!state) return;

    playerRopeMap.delete(player);

    if (player.IsValid() && player.IsAlive()) {
        endRopeControl(player, state.savedMoveType);
    }
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    const controller = Instance.GetPlayerController(playerSlot);
    if (!controller) return;

    const pawn = controller.GetPlayerPawn();
    if (!pawn) return;

    const state = playerRopeMap.get(pawn);
    if (!state) return;

    playerRopeMap.delete(pawn);

    if (pawn.IsValid() && pawn.IsAlive()) {
        endRopeControl(pawn, state.savedMoveType);
    }
});


Instance.SetThink(() => {
    if (playerRopeMap.size === 0) return;

    const now = Instance.GetGameTime();

    for (const [player, state] of playerRopeMap) {
        if (!player.IsValid() || !player.IsAlive()) {
            if (player.IsValid()) {
                endRopeControl(player, state.savedMoveType);
            }

            playerRopeMap.delete(player);
            continue;
        }

        const elapsed = now - state.startTime;
        const t = Math.min(elapsed / state.duration, 1.0);

        if (t >= 1.0) {
            if (state.phase === "approach") {
                player.Move({
                    position: state.to,
                    velocity: zeroVelocity()
                });

                TransitionToTravel(player, state);
            } else {
                FinishTravel(player, state);
                playerRopeMap.delete(player);
            }
        } else {
            const nextPos = {
                x: state.from.x + (state.to.x - state.from.x) * t,
                y: state.from.y + (state.to.y - state.from.y) * t,
                z: state.from.z + (state.to.z - state.from.z) * t
            };

            player.Move({
                position: nextPos,
                velocity: zeroVelocity()
            });
        }
    }

    if (playerRopeMap.size > 0) {
        Instance.SetNextThink(Instance.GetGameTime() + 0.02);
    }
});



/**
 * @param {Entity} player
 * @param {string} ropeId
 * @param {Entity} startTarget
 * @param {Entity} endTarget
 */
function StartRopeMovement(player, ropeId, startTarget, endTarget) {
    const startPos = startTarget.GetAbsOrigin();
    const endPos = endTarget.GetAbsOrigin();
    const playerPos = player.GetAbsOrigin();

    const savedMoveType = beginRopeControl(player);

    const dx = startPos.x - playerPos.x;
    const dy = startPos.y - playerPos.y;
    const dz = startPos.z - playerPos.z;
    const approachDistance = Math.sqrt(dx * dx + dy * dy + dz * dz);

    if (approachDistance > 1) {
        const duration = approachDistance / APPROACH_SPEED;

        playerRopeMap.set(player, {
            ropeId,
            phase: "approach",
            from: { x: playerPos.x, y: playerPos.y, z: playerPos.z },
            to: { x: startPos.x, y: startPos.y, z: startPos.z },
            startTime: Instance.GetGameTime(),
            duration,
            ropeStart: { x: startPos.x, y: startPos.y, z: startPos.z },
            ropeEnd: { x: endPos.x, y: endPos.y, z: endPos.z },
            savedMoveType
        });
    } else {
        const eyeAngles = player.GetEyeAngles();

        player.Move({
            position: { x: startPos.x, y: startPos.y, z: startPos.z },
            angles: { pitch: 0, yaw: eyeAngles.yaw, roll: 0 },
            velocity: zeroVelocity()
        });

        const travelDx = endPos.x - startPos.x;
        const travelDy = endPos.y - startPos.y;
        const travelDz = endPos.z - startPos.z;
        const travelDistance = Math.sqrt(
            travelDx * travelDx +
            travelDy * travelDy +
            travelDz * travelDz
        );

        const duration = travelDistance / ROPE_SPEED;

        playerRopeMap.set(player, {
            ropeId,
            phase: "travel",
            from: { x: startPos.x, y: startPos.y, z: startPos.z },
            to: { x: endPos.x, y: endPos.y, z: endPos.z },
            startTime: Instance.GetGameTime(),
            duration,
            ropeStart: { x: startPos.x, y: startPos.y, z: startPos.z },
            ropeEnd: { x: endPos.x, y: endPos.y, z: endPos.z },
            savedMoveType
        });
    }

    Instance.SetNextThink(Instance.GetGameTime());
}

/**
 * @param {Entity} player
 * @param {RopeState} state
 */
function TransitionToTravel(player, state) {
    const startPos = state.ropeStart;
    const endPos = state.ropeEnd;

    const dx = endPos.x - startPos.x;
    const dy = endPos.y - startPos.y;
    const dz = endPos.z - startPos.z;
    const totalDistance = Math.sqrt(dx * dx + dy * dy + dz * dz);
    const duration = totalDistance / ROPE_SPEED;

    const eyeAngles = player.GetEyeAngles();

    player.Move({
        position: {
            x: startPos.x,
            y: startPos.y,
            z: startPos.z
        },
        angles: {
            pitch: 0,
            yaw: eyeAngles.yaw,
            roll: 0
        },
        velocity: zeroVelocity()
    });

    state.phase = "travel";
    state.from = {
        x: startPos.x,
        y: startPos.y,
        z: startPos.z
    };
    state.to = {
        x: endPos.x,
        y: endPos.y,
        z: endPos.z
    };
    state.startTime = Instance.GetGameTime();
    state.duration = duration;
}

/**
 * @param {Entity} player
 * @param {RopeState} state
 */
function FinishTravel(player, state) {
    const endPos = state.ropeEnd;
    const eyeAngles = player.GetEyeAngles();
    const forward = getForwardVector(eyeAngles);

    endRopeControl(player, state.savedMoveType);

    player.Teleport({
        position: {
            x: endPos.x,
            y: endPos.y,
            z: endPos.z
        },
        velocity: {
            x: forward.x * LAUNCH_SPEED,
            y: forward.y * LAUNCH_SPEED,
            z: forward.z * LAUNCH_SPEED
        }
    });
}

// ===================== Utility =====================

/**
 * @param {{ pitch: number, yaw: number, roll: number }} ang
 * @returns {{ x: number, y: number, z: number }}
 */
function getForwardVector(ang) {
    const pitchRad = (ang.pitch / 180) * Math.PI;
    const yawRad = (ang.yaw / 180) * Math.PI;
    const x = Math.cos(pitchRad) * Math.cos(yawRad);
    const y = Math.cos(pitchRad) * Math.sin(yawRad);
    const z = -Math.sin(pitchRad);
    const len = Math.hypot(x, y, z) || 1;
    return { x: x / len, y: y / len, z: z / len };
}

function zeroVelocity() {
    return { x: 0, y: 0, z: 0 };
}

/**
 * @param {Entity} player
 */
function beginRopeControl(player) {
    const savedMoveType = player.GetMoveType();

    player.SetMoveType(CSMoveType.NOCLIP);
    player.Teleport({ velocity: zeroVelocity() });

    return savedMoveType;
}

/**
 * @param {Entity} player
 * @param {import("cs_script/point_script").CSMoveType} savedMoveType
 */
function endRopeControl(player, savedMoveType) {
    if (!player.IsValid()) return;

    player.SetMoveType(savedMoveType ?? CSMoveType.WALK);
}