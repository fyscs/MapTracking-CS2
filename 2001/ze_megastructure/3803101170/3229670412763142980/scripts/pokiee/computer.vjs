// @ts-nocheck
import { Instance, CSDamageTypes, CSDamageFlags } from "cs_script/point_script";

const CONFIG = {
    codeLength: 5,
    characters: "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    charDisplayTime: 1.0,
    charGapTime: 0.2,
    randomizeCharTime: true,
    randomCharTimeRange: 0.2,
    inputTimeLimit: 10.0,
    failDamage: 34,
    closeDelay: 2.0,
    globalBlacklist: true,
    announceFailures: true,
    allowedTeam: 0
};

let tokenCounter = 0;
const locks = new Map();
const sessions = new Map();
const hudCache = new Map();
const blacklist = new Set();

const SafeText = t => String(t).replace(/[^\w .-]/g, "").replace(/\s+/g, " ").trim() || "Player";

function GetInstanceIdFromEntity(e) {
    if (!e || typeof e.IsValid !== "function" || !e.IsValid()) return "default";
    const m = String(typeof e.GetEntityName === "function" ? e.GetEntityName() : "").match(/_(\d+)$/);
    return m ? m[1] : "default";
}

// default hud name is broken in some issue, you have to use the id suffix for the entity name to get the correct hud layout.
const GetHudName = id => id === "default" ? "computer_hud" : `computer_hud_${id}`;

function GetHudLayout(id) {
    const c = hudCache.get(id);
    if (c && typeof c.IsValid === "function" && c.IsValid() && typeof c.SetHasClassForPlayer === "function") return c;

    const l = Instance.FindEntityByName(GetHudName(id));
    if (l && typeof l.IsValid === "function" && l.IsValid() && typeof l.SetHasClassForPlayer === "function") {
        hudCache.set(id, l);
        return l;
    }

    hudCache.delete(id);
}

const GetSuccessRelayName = id => id === "default" ? "compute_success_relay" : `compute_success_relay_${id}`;
const LockInstance = (id, s) => locks.set(id, s);

function UnlockInstance(id, s) {
    if (locks.get(id) === s) locks.delete(id);
}

function GetPlayerSlotFromActivator(a) {
    if (!a || typeof a.IsValid !== "function" || !a.IsValid()) return -1;

    if (typeof a.GetPlayerSlot === "function") {
        const s = a.GetPlayerSlot();
        return Number.isInteger(s) ? s : -1;
    }

    if (typeof a.GetPlayerController === "function") {
        const c = a.GetPlayerController();
        if (c && typeof c.GetPlayerSlot === "function") {
            const s = c.GetPlayerSlot();
            return Number.isInteger(s) ? s : -1;
        }
    }

    return -1;
}

function GetPlayerActivator(s) {
    const c = Instance.GetPlayerController(s);
    if (!c) return;
    const p = typeof c.GetPlayerPawn === "function" ? c.GetPlayerPawn() : undefined;
    return p ?? c;
}

const IsBlacklisted = (id, s) => blacklist.has(CONFIG.globalBlacklist ? `global:${s}` : `${id}:${s}`);
const AddBlacklist = (id, s) => blacklist.add(CONFIG.globalBlacklist ? `global:${s}` : `${id}:${s}`);

function RemoveBlacklistForPlayer(s) {
    const x = `:${s}`;
    for (const k of Array.from(blacklist)) {
        if (k.endsWith(x)) blacklist.delete(k);
    }
}

function GenerateCode() {
    let c = "";
    for (let i = 0; i < CONFIG.codeLength; i++) {
        c += CONFIG.characters[Math.floor(Math.random() * CONFIG.characters.length)];
    }
    return c;
}

function FormatInput(i) {
    const s = String(i).slice(0, CONFIG.codeLength);
    const f = s.split("").join(" ");
    const e = "_ ".repeat(Math.max(0, CONFIG.codeLength - s.length)).trim();
    return `${f} ${e}`.trim();
}

function UpdateDisplay(s, status, code, progress) {
    const se = sessions.get(s);
    if (!se) return;

    const l = GetHudLayout(se.instanceId);
    if (!l) return;

    l.SetDialogVariableStringForPlayer(s, "display_panel", "status_text", status);
    l.SetDialogVariableStringForPlayer(s, "display_panel", "code_text", code);
    l.SetDialogVariableStringForPlayer(s, "display_panel", "progress_text", progress);
}

function SetResultClasses(s, success) {
    const se = sessions.get(s);
    if (!se) return;

    const l = GetHudLayout(se.instanceId);
    if (!l) return;

    for (const p of ["compute_dialog", "status_label", "code_label", "progress_label"]) {
        if (success === null) {
            l.SetHasClassForPlayer(s, p, "Success", false);
            l.SetHasClassForPlayer(s, p, "Error", false);
        } else {
            l.SetHasClassForPlayer(s, p, "Success", success);
            l.SetHasClassForPlayer(s, p, "Error", !success);
        }
    }
}

const ClearResultClasses = s => SetResultClasses(s, null);
const ApplyResultClasses = (s, ok) => SetResultClasses(s, ok);

Instance.OnScriptInput("compute", ({ caller, activator }) => {
    const id = GetInstanceIdFromEntity(caller);
    if (locks.has(id)) return;

    const s = GetPlayerSlotFromActivator(activator);
    if (s === -1) return;

    if (CONFIG.allowedTeam !== 0 && activator && typeof activator.GetTeamNumber === "function" && activator.GetTeamNumber() !== CONFIG.allowedTeam) return;
    if (sessions.has(s)) return;
    if (IsBlacklisted(id, s)) return;

    StartMemoryGame(id, s);
});

function StartMemoryGame(id, s) {
    if (locks.has(id) || sessions.has(s)) return;

    const l = GetHudLayout(id);
    if (!l) return;

    LockInstance(id, s);
    const token = ++tokenCounter;

    sessions.set(s, {
        instanceId: id,
        token,
        state: "revealing",
        code: GenerateCode(),
        input: "",
        timeLeft: CONFIG.inputTimeLimit
    });

    l.SetHasClassForPlayer(s, "compute_dialog", "Hidden", false);
    l.SetInputCaptureEnabled(s, true);

    ClearResultClasses(s);
    UpdateDisplay(s, "MEMORIZE", "", "");
    PlayRevealSequence(s, token);
}

async function PlayRevealSequence(s, token) {
    let se = sessions.get(s);
    if (!se) return;

    const l = GetHudLayout(se.instanceId);
    if (!l) return;

    for (let i = 0; i < se.code.length; i++) {
        se = sessions.get(s);
        if (!se || se.token !== token || se.state !== "revealing") return;

        UpdateDisplay(s, "MEMORIZE", se.code[i], `${i + 1} / ${se.code.length}`);

        let t = CONFIG.charDisplayTime;
        if (CONFIG.randomizeCharTime) t = Math.max(0.15, t + (Math.random() - 0.5) * 2 * CONFIG.randomCharTimeRange);

        await Instance.Delay(t);

        se = sessions.get(s);
        if (!se || se.token !== token || se.state !== "revealing") return;

        if (CONFIG.charGapTime > 0) {
            UpdateDisplay(s, "MEMORIZE", "•", "");
            await Instance.Delay(CONFIG.charGapTime);
        }
    }

    se = sessions.get(s);
    if (se && se.token === token && se.state === "revealing") EnterInputPhase(s);
}

function EnterInputPhase(s) {
    const se = sessions.get(s);
    if (!se) return;

    se.state = "input";
    se.input = "";
    se.timeLeft = CONFIG.inputTimeLimit;

    ClearResultClasses(s);
    UpdateDisplay(s, "ENTER CODE", FormatInput(se.input), `TIME: ${se.timeLeft}s`);
    StartInputCountdown(s, se.token);
}

async function StartInputCountdown(s, token) {
    let se = sessions.get(s);
    if (!se) return;

    if (se.timeLeft <= 0) {
        HandleTimeout(s);
        return;
    }

    while (se.timeLeft > 0) {
        await Instance.Delay(1);

        se = sessions.get(s);
        if (!se || se.token !== token || se.state !== "input") return;

        se.timeLeft--;
        UpdateDisplay(s, "ENTER CODE", FormatInput(se.input), `TIME: ${se.timeLeft}s`);
    }

    se = sessions.get(s);
    if (se && se.token === token && se.state === "input") HandleTimeout(s);
}

Instance.OnCustomHudClicked(event => {
    if (!event || !event.player || !event.layout) return;

    const id = GetInstanceIdFromEntity(event.layout);
    const s = typeof event.player.GetPlayerSlot === "function" ? event.player.GetPlayerSlot() : -1;
    if (s === -1) return;

    const se = sessions.get(s);
    if (!se || se.state !== "input" || se.instanceId !== id) return;

    const b = String(event.buttonId || "");

    if (b === "key_backspace") {
        if (se.input.length > 0) {
            se.input = se.input.slice(0, -1);
            UpdateDisplay(s, "ENTER CODE", FormatInput(se.input), `TIME: ${se.timeLeft}s`);
        }
        return;
    }

    if (b.startsWith("key_")) {
        const c = b.slice(4);

        if (c.length === 1 && CONFIG.characters.includes(c) && se.input.length < CONFIG.codeLength) {
            se.input += c;
            UpdateDisplay(s, "ENTER CODE", FormatInput(se.input), `TIME: ${se.timeLeft}s`);

            if (se.input.length === CONFIG.codeLength) CheckAnswer(s);
        }
    }
});

function CheckAnswer(s) {
    const se = sessions.get(s);
    if (!se) return;

    const ok = se.input === se.code;
    se.state = ok ? "success" : "fail";

    UpdateDisplay(s, ok ? "ACCESS GRANTED" : "ACCESS DENIED", ok ? se.code : se.input, ok ? "" : `CORRECT: ${se.code}`);
    ApplyResultClasses(s, ok);

    if (ok) {
        Instance.EntFireAtName({
            name: GetSuccessRelayName(se.instanceId),
            input: "Trigger",
            activator: GetPlayerActivator(s)
        });
    } else {
        AddBlacklist(se.instanceId, s);
        PunishPlayer(s, se.instanceId, "wrong code");
    }

    ScheduleClose(s, se.token);
}

function HandleTimeout(s) {
    const se = sessions.get(s);
    if (!se) return;

    se.state = "fail";

    UpdateDisplay(s, "TIME OUT", FormatInput(se.input), `CORRECT: ${se.code}`);
    ApplyResultClasses(s, false);

    AddBlacklist(se.instanceId, s);
    PunishPlayer(s, se.instanceId, "timeout");

    ScheduleClose(s, se.token);
}

function PunishPlayer(s, id, reason) {
    if (CONFIG.failDamage <= 0 && !CONFIG.announceFailures) return;

    const c = Instance.GetPlayerController(s);
    if (!c) return;

    const p = typeof c.GetPlayerPawn === "function" ? c.GetPlayerPawn() : undefined;

    if (p && typeof p.IsAlive === "function" && p.IsAlive() && CONFIG.failDamage > 0) {
        p.TakeDamage({
            damage: CONFIG.failDamage,
            damageTypes: CSDamageTypes.SHOCK,
            damageFlags: CSDamageFlags.IGNORE_ARMOR
        });
    }

    if (CONFIG.announceFailures) {
        Instance.EntFireAtName({ name: "console", input: "Command", value: `say ${SafeText(typeof c.GetPlayerName === "function" ? c.GetPlayerName() : `Player ${s}`)} failed computer puzzle, failure!` });
    }
}

function ScheduleClose(s, token) {
    Instance.Delay(CONFIG.closeDelay).then(() => {
        const se = sessions.get(s);
        if (se && se.token === token) CloseGame(s);
    });
}

function CloseGame(s) {
    const se = sessions.get(s);
    if (!se) return;

    const l = GetHudLayout(se.instanceId);

    if (l) {
        ClearResultClasses(s);
        l.SetHasClassForPlayer(s, "compute_dialog", "Hidden", true);
        l.SetInputCaptureEnabled(s, false);
    }

    UnlockInstance(se.instanceId, s);
    sessions.delete(s);
}

function CloseAllGames() {
    for (const s of Array.from(sessions.keys())) CloseGame(s);
    locks.clear();
}

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    if (sessions.has(playerSlot)) CloseGame(playerSlot);
    RemoveBlacklistForPlayer(playerSlot);
});

Instance.OnScriptInput("reset", () => {
    CloseAllGames();
    blacklist.clear();
    hudCache.clear();
});

Instance.OnScriptReload({
    before: () => {
        CloseAllGames();
        blacklist.clear();
        hudCache.clear();
        return null;
    }
});

Instance.RegisterCheatCommand("compute_time", args => {
    const v = parseFloat(args);
    if (!isNaN(v) && v > 0) {
        CONFIG.charDisplayTime = v;
        Instance.Msg(`[Computer] Char display time set to ${v}s`);
    }
});

Instance.RegisterCheatCommand("compute_gap", args => {
    const v = parseFloat(args);
    if (!isNaN(v) && v >= 0) {
        CONFIG.charGapTime = v;
        Instance.Msg(`[Computer] Char gap time set to ${v}s`);
    }
});

Instance.RegisterCheatCommand("compute_limit", args => {
    const v = parseFloat(args);
    if (!isNaN(v) && v >= 0) {
        CONFIG.inputTimeLimit = v;
        Instance.Msg(`[Computer] Input time limit set to ${v}s`);
    }
});

Instance.RegisterCheatCommand("compute_close_all", () => {
    CloseAllGames();
    Instance.Msg("[Computer] All computer sessions closed.");
});