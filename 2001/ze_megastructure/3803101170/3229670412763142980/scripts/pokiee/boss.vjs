async function spawnTemplatesInArena(templateEnt, counterName, minCount, maxCount, opts = {}) {
    const padding = opts.padding ?? 0;
    const attempts = opts.attempts ?? 32;
    const resetCounter = opts.resetCounter ?? false;
    const minSpacing = opts.minSpacing ?? BUTTON_MIN_SPACING;

    if (!templateEnt || !templateEnt.IsValid()) return 0;

    const bounds = bossArena.bounds;
    if (!bossArena.isReady || !bounds) return 0;

    isSkillExecuting = true;

    const count = minCount + Math.floor(Math.random() * (maxCount - minCount + 1));

    if (counterName) {
        if (resetCounter) {
            Instance.EntFireAtName({ name: counterName, input: "SetValue", value: 0 });
        }
        Instance.EntFireAtName({ name: counterName, input: "SetMaxValue", value: count });
    }

    const template = templateEnt;

    const spawnedPoints = opts.positions ?? [];
    const spawnedEntities = opts.entities ?? null;
    let spawned = 0;
    const minSpacing2 = minSpacing * minSpacing;

    for (let i = 0; i < count; i++) {

        let origin = null;

        for (let attempt = 0; attempt < attempts; attempt++) {
            const candidate = {
                x: bounds.minX + Math.random() * (bounds.maxX - bounds.minX),
                y: bounds.minY + Math.random() * (bounds.maxY - bounds.minY),
                z: bounds.minZ
            };

            const inside = padding > 0
                ? bossArena.containsWithPadding(candidate, padding)
                : bossArena.contains(candidate);
            if (!inside) continue;

            let tooClose = false;
            for (const p of spawnedPoints) {
                const dx = candidate.x - p.x;
                const dy = candidate.y - p.y;
                if (dx * dx + dy * dy < minSpacing2) {
                    tooClose = true;
                    break;
                }
            }
            if (tooClose) continue;

            origin = candidate;
            break;
        }

        if (!origin) continue;

        spawnedPoints.push(origin);
        const created = template.ForceSpawn(origin, { pitch: 0, yaw: Math.floor(Math.random() * 360), roll: 0 });
        if (spawnedEntities && created) {
            for (const ent of created) {
                if (ent && ent.IsValid()) spawnedEntities.push(ent);
            }
        }
        spawned++;
        await Instance.Delay(0);
    }

    if (counterName && spawned < count) {
        Instance.EntFireAtName({ name: counterName, input: "SetMaxValue", value: spawned });
    }

    return spawned;
}

async function skill1() {
    const template = ents.skill1Temp;
    if (!template) {
        endSkill();
        return;
    }

    Instance.EntFireAtName({ name: ENTITY_NAMES.skill1Particle, input: "Start" });

    const spawned = await spawnTemplatesInArena(
        template,
        "bossfight_skill_1_button_counter",
        6, 6,
        { padding: 256, attempts: 64, resetCounter: true }
    );

    if (spawned === 0) endSkill();
}

function skill2() {
    const TELEPORT_NAME = "bossfight_skill_2_teleport";

    const templateEnt = ents.skill2Temp;
    const basepoint = ents.skill2Basepoint;

    if (!templateEnt) {
        endSkill();
        return;
    }
    if (!basepoint) {
        endSkill();
        return;
    }

    const template = templateEnt;
    const spawned = template.ForceSpawn(basepoint.GetAbsOrigin(), basepoint.GetAbsAngles());

    let dest;
    if (spawned) {
        for (const ent of spawned) {
            if (ent.IsValid() && ent.GetEntityName() === TELEPORT_NAME) {
                dest = ent;
                break;
            }
        }
    }
    if (!dest) dest = Instance.FindEntityByName(TELEPORT_NAME);

    if (!dest || !dest.IsValid()) {
        endSkill();
        return;
    }

    const target = dest.GetAbsOrigin();
    for (const player of Instance.FindEntitiesByClass("player")) {
        if (!player.IsValid() || !player.IsAlive()) continue;
        if (player.GetTeamNumber() !== 3) continue;
        player.Teleport({ position: target });
    }
}

function skill3() {
    const bounds = bossArena.bounds;
    if (!bossArena.isReady || !bounds) {

        endSkill();
        return;
    }

    Instance.EntFireAtName({ name: ENTITY_NAMES.skill3Sound, input: "StartSound" });

    const ATTEMPTS = 64;

    for (const player of Instance.FindEntitiesByClass("player")) {
        if (!player.IsValid() || !player.IsAlive()) continue;
        if (player.GetTeamNumber() !== 3) continue;

        const from = player.GetAbsOrigin();
        if (!bossArena.containsXY(from)) continue;

        const minDist2 = SCATTER_MIN_DISTANCE * SCATTER_MIN_DISTANCE;

        let target = null;
        let best = null;
        let bestDist2 = -1;

        for (let attempt = 0; attempt < ATTEMPTS; attempt++) {
            const candidate = {
                x: bounds.minX + Math.random() * (bounds.maxX - bounds.minX),
                y: bounds.minY + Math.random() * (bounds.maxY - bounds.minY),
                z: bounds.minZ
            };
            if (!bossArena.containsWithPadding(candidate, SCATTER_EDGE_PADDING)) continue;

            const dx = candidate.x - from.x;
            const dy = candidate.y - from.y;
            const dist2 = dx * dx + dy * dy;

            if (dist2 >= minDist2) {
                target = { x: candidate.x, y: candidate.y, z: from.z };
                break;
            }

            if (dist2 > bestDist2) {
                bestDist2 = dist2;
                best = candidate;
            }
        }

        if (!target && best) target = { x: best.x, y: best.y, z: from.z };

        if (!target) continue;

        player.Teleport({ position: target });
    }

    endSkill();
}

async function skill4() {
    const template = ents.skill4DoorTemp;
    if (!template) {
        endSkill();
