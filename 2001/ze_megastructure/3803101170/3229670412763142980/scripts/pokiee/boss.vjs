    await Instance.Delay(0);

    for (const door of doors) {
        if (door.IsValid()) {
            Instance.EntFireAtTarget({ target: door, input: "Open" });
        }
    }
}

async function skill5() {
    const template = ents.skill5Temp;
    if (!template) {
        endSkill();
        return;
    }

    Instance.EntFireAtName({ name: ENTITY_NAMES.skill5Sound1, input: "StartSound" });
    Instance.EntFireAtName({ name: ENTITY_NAMES.skill5Sound2, input: "StartSound", delay: BOMB_DAMAGE_DELAY });

    const bombs = [];
    const spawned = await spawnTemplatesInArena(
        template,
        null,
        BOMB_MIN_COUNT, BOMB_MAX_COUNT,
        {
            padding: 256,
            attempts: 64,
            minSpacing: BOMB_MIN_SPACING,
            positions: bombs
        }
    );

    if (spawned === 0) {
        endSkill();
        return;
    }

    await Instance.Delay(BOMB_DAMAGE_DELAY);

    const radius = BOMB_DIAMETER / 2;
    const radius2 = radius * radius;

    for (const player of Instance.FindEntitiesByClass("player")) {
        if (!player.IsValid() || !player.IsAlive()) continue;

        const pos = player.GetAbsOrigin();
        let inBomb = false;
        for (const b of bombs) {
            const dx = pos.x - b.x;
            const dy = pos.y - b.y;
            if (dx * dx + dy * dy <= radius2) {
                inBomb = true;
                break;
            }
        }
        if (!inBomb) continue;

        player.TakeDamage({ damage: BOMB_DAMAGE, damageTypes: CSDamageTypes.GENERIC });
    }

    endSkill();
}

