        ]
    }
];

let bossFightActive = false;

let currentSkill = null;
let skillTimeoutAt = 0;

let nextSkillAt = 0;

let lastSkillName = null;

let bossHealthMultiplier = 1;

const SKILL_THINK_INTERVAL = 0.1;

const SKILL_WINDUP_TIME = 5.0;

const SKILL_GAP_TIME = 10.0;

function skillLoop() {
    if (!bossFightActive) return;

    Instance.SetNextThink(Instance.GetGameTime() + SKILL_THINK_INTERVAL);

    hudTick();

    if (isSkillExecuting) {
        if (currentSkill && Instance.GetGameTime() >= skillTimeoutAt) {
            if (currentSkill.skill.timeoutExecute) {
                currentSkill.skill.timeoutExecute();
            }
            endSkill();
        }
        return;
    }

    if (Instance.GetGameTime() < nextSkillAt) return;

    const fallback = [];
    const pool = [];
    for (const b of bosses) {
        if (!b.alive || !b.skillEnabled) continue;
        for (const s of b.skills) {
            const entry = { boss: b, skill: s };
            fallback.push(entry);
            if (s.name !== lastSkillName) pool.push(entry);
        }
    }

    if (fallback.length === 0) {
        if (!bosses.some(b => b.alive)) {
            bossFightActive = false;
        }
        return;
    }

    const candidates = pool.length > 0 ? pool : fallback;

    let totalWeight = 0;
    for (const c of candidates) totalWeight += c.skill.weight;

    let roll = Math.random() * totalWeight;

    let chosen = candidates[0];
    for (const c of candidates) {
        roll -= c.skill.weight;
        if (roll <= 0) {
            chosen = c;
            break;
        }
    }

    currentSkill = chosen;

    lastSkillName = chosen.skill.name;
    castSkill(chosen);
}

function endSkill() {
    isSkillExecuting = false;
    currentSkill = null;
    nextSkillAt = Instance.GetGameTime() + SKILL_GAP_TIME;
}

async function runSkillWindup(choice) {
    Instance.EntFireAtName({ name: ENTITY_NAMES.windupRelay, input: "Trigger" });
    await Instance.Delay(SKILL_WINDUP_TIME);
}

async function castSkill(choice) {
    isSkillExecuting = true;
    skillTimeoutAt = Infinity;

    try {
        await runSkillWindup(choice);

        if (!bossFightActive || currentSkill !== choice) return;

        skillTimeoutAt = choice.skill.timeCount < 0
            ? Infinity
            : Instance.GetGameTime() + choice.skill.timeCount;

        await choice.skill.execute();
    } catch (e) {
        endSkill();
    }
}

function bindBossPhys(boss) {
    const found = Instance.FindEntityByName(boss.physName);
    const next = (found && found.IsValid()) ? found : undefined;

    boss.phys = next;
    return next;
}

function bossModelName(boss) {
    return boss.physName.replace(/_phys$/, "_model");
}

function setBossModelGlow(boss, on) {
    if (!boss.model || !boss.model.IsValid()) {
        boss.model = undefined;
        if (!on) return;
        const found = Instance.FindEntityByName(bossModelName(boss));
        boss.model = (found && found.IsValid()) ? found : undefined;
        if (!boss.model) return;
    }

    try {
        if (on) boss.model.Glow();
        else boss.model.Unglow();
    } catch (e) { }
}

function activateBossHealth(boss) {
    const phys = bindBossPhys(boss);

    let ctCount = 0;
    for (const player of Instance.FindEntitiesByClass("player")) {
        if (player.IsValid() && player.IsAlive() && player.GetTeamNumber() === 3) {
            ctCount++;
        }
    }
    const health = Math.round((boss.baseHealth + boss.extendHealthPerCT * ctCount) * bossHealthMultiplier);

    if (!phys) return;

    phys.SetHealth(health);
    phys.SetMaxHealth(health);

    boss.activated = true;
    setBossModelGlow(boss, true);
}

function onBossDefeated(boss) {
    boss.alive = false;
    boss.skillEnabled = false;
    boss.phys = undefined;
    setBossModelGlow(boss, false);
}

function checkBossDefeats() {
    for (const boss of bosses) {
        if (!boss.alive || !boss.phys) continue;

        if (!boss.phys.IsValid()) {
            onBossDefeated(boss);
            continue;
        }

        let hp = 1;
        try {
            hp = boss.phys.GetHealth();
        } catch (e) {
            continue;
        }

        if (hp <= 0) onBossDefeated(boss);
    }
}

const HUD_ENTITY_NAME = "bosshp_hud";

const HUD_CONTAINER_ID = "bosshp-container";
const HUD_FILL_ID = "bosshp-fill";
const HUD_SHADOW_ID = "bosshp-shadow";
const HUD_TITLE_ID = "bosshp-title";
const HUD_VALUE_ID = "bosshp-value";
const HUD_NAME_VAR = "hpname";
const HUD_VALUE_VAR = "hpvalue";

const BOSS_DISPLAY_NAMES = {
    powersupply_1: "POWER SUPPLY I",
    powersupply_2: "POWER SUPPLY II",
    supercomputer_1: "SUPERCOMPUTER I",
    supercomputer_2: "SUPERCOMPUTER II",
    main: "MAIN CORE"
};

const HUD_WIDTH_CLASSES = [];
for (let i = 0; i <= 100; i++) {
    HUD_WIDTH_CLASSES.push("W" + String(i).padStart(3, "0"));
}

const HUD_STALL_TIMEOUT = 3.0;

const HUD_FADE_TIME = 0.6;

const HUD_SHADOW_LAG = 0.2;

const HUD_HIDDEN = 0;
const HUD_VISIBLE = 1;
const HUD_FADING = 2;

let hudLayout = undefined;

const hudPlayers = new Map();

const hudBossByHitName = new Map();
for (const boss of bosses) {
    hudBossByHitName.set(boss.physName, boss);
    hudBossByHitName.set("bossfight_part_" + boss.id + "_model", boss);
}

function getHudLayout() {
    if (hudLayout && hudLayout.IsValid()) return hudLayout;
    const found = Instance.FindEntityByName(HUD_ENTITY_NAME);
    hudLayout = (found && found.IsValid()) ? found : undefined;
    return hudLayout;
}

function hudSetClass(hud, slot, panelId, className, on) {
    try {
        hud.SetHasClassForPlayer(slot, panelId, className, on);
    } catch (e) { }
}

function hudSetVar(hud, slot, panelId, varName, value) {
    try {
        hud.SetDialogVariableStringForPlayer(slot, panelId, varName, value);
    } catch (e) { }
}

function hudApplyWidth(hud, slot, panelId, prevIdx, nextIdx) {
    if (nextIdx === prevIdx) return;
    if (nextIdx >= 0) hudSetClass(hud, slot, panelId, HUD_WIDTH_CLASSES[nextIdx], true);
    if (prevIdx >= 0) hudSetClass(hud, slot, panelId, HUD_WIDTH_CLASSES[prevIdx], false);
}

function hudSetPhase(hud, slot, ps, phase) {
    if (ps.phase === phase) return;
    ps.phase = phase;
    hudSetClass(hud, slot, HUD_CONTAINER_ID, "Hidden", phase === HUD_HIDDEN);
    hudSetClass(hud, slot, HUD_CONTAINER_ID, "FadingOut", phase === HUD_FADING);
    hudSetClass(hud, slot, HUD_CONTAINER_ID, "Visible", phase === HUD_VISIBLE);
}

function hudUpdateForPlayer(hud, slot, ps, boss, stats, now) {
    const hp = stats.hp;
    const maxHp = stats.maxHp;

    const pct = Math.max(0, Math.min(1, hp / maxHp));
    const idx = Math.round(pct * 100);

    hudApplyWidth(hud, slot, HUD_FILL_ID, ps.widthIdx, idx);
    ps.widthIdx = idx;

    if (idx < ps.shadowIdx) {
        if (ps.pendingShadowIdx !== idx) {
            ps.pendingShadowIdx = idx;
            ps.pendingShadowAt = now + HUD_SHADOW_LAG;
        }
    } else {
        ps.pendingShadowIdx = -1;
        hudApplyWidth(hud, slot, HUD_SHADOW_ID, ps.shadowIdx, idx);
        ps.shadowIdx = idx;
    }
    if (ps.pendingShadowIdx >= 0 && now >= ps.pendingShadowAt) {
        hudApplyWidth(hud, slot, HUD_SHADOW_ID, ps.shadowIdx, ps.pendingShadowIdx);
        ps.shadowIdx = ps.pendingShadowIdx;
        ps.pendingShadowIdx = -1;
    }

    const tier = pct > 0.60 ? 0 : (pct > 0.30 ? 1 : 2);
    if (ps.tier !== tier) {
        ps.tier = tier;
        hudSetClass(hud, slot, HUD_FILL_ID, "hp_high", tier === 0);
        hudSetClass(hud, slot, HUD_FILL_ID, "hp_mid", tier === 1);
        hudSetClass(hud, slot, HUD_FILL_ID, "hp_low", tier === 2);
    }

    const name = BOSS_DISPLAY_NAMES[boss.id] || boss.id;
    if (ps.name !== name) {
        ps.name = name;
        hudSetVar(hud, slot, HUD_TITLE_ID, HUD_NAME_VAR, name);
    }

    const valueText = `${Math.max(0, Math.round(hp))} / ${Math.round(maxHp)}   ${Math.round(pct * 100)}%`;
    if (ps.valueText !== valueText) {
        ps.valueText = valueText;
        hudSetVar(hud, slot, HUD_VALUE_ID, HUD_VALUE_VAR, valueText);
    }
}

function hudResetAll() {
    const hud = getHudLayout();
    if (hud) {
        for (const [slot, ps] of hudPlayers) {
            hudSetPhase(hud, slot, ps, HUD_HIDDEN);
            hudSetVar(hud, slot, HUD_TITLE_ID, HUD_NAME_VAR, "");
            hudSetVar(hud, slot, HUD_VALUE_ID, HUD_VALUE_VAR, "");
        }
    }
    hudPlayers.clear();
}

function hudTick() {
    if (hudPlayers.size === 0) return;

    const hud = getHudLayout();
    if (!hud) return;

    const now = Instance.GetGameTime();

    const statsByBoss = new Map();
    for (const boss of bosses) {
        if (!boss.activated || !boss.phys || !boss.phys.IsValid()) continue;
        try {
            const maxHp = boss.phys.GetMaxHealth();
            statsByBoss.set(boss, { hp: boss.phys.GetHealth(), maxHp: maxHp > 0 ? maxHp : 1 });
        } catch (e) { }
    }

    for (const controller of Instance.GetAllPlayerControllers()) {
        if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;

        const slot = controller.GetPlayerSlot();
        const ps = hudPlayers.get(slot);
        if (!ps) continue;

        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) {
            hudSetPhase(hud, slot, ps, HUD_HIDDEN);
            continue;
        }

        const stats = ps.boss ? statsByBoss.get(ps.boss) : undefined;
        if (!stats) {
            hudSetPhase(hud, slot, ps, HUD_HIDDEN);
            continue;
        }

        const idle = now - ps.lastHitAt;
        let phase = HUD_VISIBLE;
        if (idle > HUD_STALL_TIMEOUT + HUD_FADE_TIME) phase = HUD_HIDDEN;
        else if (idle > HUD_STALL_TIMEOUT) phase = HUD_FADING;

        hudSetPhase(hud, slot, ps, phase);
        if (phase === HUD_VISIBLE) hudUpdateForPlayer(hud, slot, ps, ps.boss, stats, now);
    }
}

Instance.OnBulletImpact(({ weapon, hitEntity }) => {
    if (!hitEntity) return;

    const boss = hudBossByHitName.get(hitEntity.GetEntityName());
    if (!boss || !boss.activated) return;

    const owner = weapon.GetOwner();
    if (!owner) return;

    const controller = owner.GetPlayerController();
    if (!controller || !controller.IsValid() || !controller.IsConnected()) return;

    const slot = controller.GetPlayerSlot();
    let ps = hudPlayers.get(slot);
    if (!ps) {
        ps = {
            boss: null,
            lastHitAt: 0,
            widthIdx: 100,
            shadowIdx: 100,
            pendingShadowIdx: -1,
            pendingShadowAt: 0,
            phase: -1,
            tier: -1,
            name: null,
            valueText: null
        };
        hudPlayers.set(slot, ps);
    }

    ps.boss = boss;
    ps.lastHitAt = Instance.GetGameTime();
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    hudPlayers.delete(playerSlot);
});

Instance.OnScriptInput("bossfight_start", () => {
    if (bossFightActive) return;

    resolveEntities();

    nextSkillAt = 0;

    bossFightActive = true;
    Instance.SetThink(skillLoop);
    Instance.SetNextThink(Instance.GetGameTime());
});

Instance.OnScriptInput("bossfight_stop", () => {
    bossFightActive = false;
    endSkill();
});

Instance.OnScriptInput("activate powersupply_1", () => {
    activateBossHealth(bosses[0]);
});

Instance.OnScriptInput("activate powersupply_2", () => {
    activateBossHealth(bosses[1]);
});

Instance.OnScriptInput("activate supercomputer_1", () => {
    activateBossHealth(bosses[2]);
});

Instance.OnScriptInput("activate supercomputer_2", () => {
    activateBossHealth(bosses[3]);
});

Instance.OnScriptInput("activate main", () => {
    activateBossHealth(bosses[4]);
});

function setBossHealthMultiplier(mult) {
    const ratio = mult / bossHealthMultiplier;
    bossHealthMultiplier = mult;

    if (ratio === 1) return;

    for (const boss of bosses) {
        if (!boss.activated || !boss.phys || !boss.phys.IsValid()) continue;

        try {
            const hp = boss.phys.GetHealth();
            const maxHp = boss.phys.GetMaxHealth();
            boss.phys.SetMaxHealth(Math.round(maxHp * ratio));
            boss.phys.SetHealth(Math.round(hp * ratio));
        } catch (e) { }
    }
}

Instance.OnScriptInput("hp x1.5", () => setBossHealthMultiplier(1.5));
Instance.OnScriptInput("hp x2", () => setBossHealthMultiplier(2));
Instance.OnScriptInput("hp x2.5", () => setBossHealthMultiplier(2.5));

Instance.OnScriptInput("bossdead", () => {
    checkBossDefeats();
});

Instance.OnScriptInput("skillcomplete", () => {
    if (!isSkillExecuting) return;
    endSkill();
});

Instance.OnScriptInput("buildarena", () => {
    bossArena.build();
});

function resetBossFight() {
    bossFightActive = false;
    endSkill();
    skillTimeoutAt = 0;

    lastSkillName = null;

    nextSkillAt = 0;

    hudResetAll();

    bossHealthMultiplier = 1;

    for (const boss of bosses) {
        boss.alive = true;

        boss.skillEnabled = boss.hasSkill;

        boss.activated = false;

        if (!boss.phys || !boss.phys.IsValid()) {
            boss.phys = undefined;
        }

        setBossModelGlow(boss, false);
        boss.model = undefined;
    }

}

Instance.OnRoundEnd(() => {
    resetBossFight();
});
