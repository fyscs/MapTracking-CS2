import { Instance, Entity, PointTemplate, CSDamageTypes } from "cs_script/point_script";

class BossArena {

    constructor(pointClass, namePattern) {
        this.pointClass = pointClass;
        this.namePattern = namePattern;

        this.vertices = [];

        this.bounds = null;
        this.isReady = false;
    }

    build() {

        const entries = [];

        const usedKeys = new Set();

        for (const entity of Instance.FindEntitiesByClass(this.pointClass)) {
            if (!entity.IsValid()) continue;
            const name = entity.GetEntityName();
            const match = this.namePattern.exec(name);
            if (!match || !match[1]) continue;
            const key = match[1].toUpperCase();
            if (usedKeys.has(key)) continue;
            usedKeys.add(key);
            entries.push({
                key,
                order: this._suffixToOrder(key),
                origin: entity.GetAbsOrigin()
            });
        }

        entries.sort((a, b) => a.order - b.order);
        this.vertices = entries.map(e => e.origin);

        if (this.vertices.length < 3) {
            this.isReady = false;
            return;
        }

        this._computeBounds();
        this.isReady = true;
    }

    contains(pos) {
        if (!this.isReady || !this.bounds) return false;
        if (pos.x < this.bounds.minX || pos.x > this.bounds.maxX ||
            pos.y < this.bounds.minY || pos.y > this.bounds.maxY ||
            pos.z < this.bounds.minZ || pos.z > this.bounds.maxZ) {
            return false;
        }
        return this._isPointInPolygon2D(pos);
    }

    containsXY(pos) {
        if (!this.isReady || !this.bounds) return false;
        if (pos.x < this.bounds.minX || pos.x > this.bounds.maxX ||
            pos.y < this.bounds.minY || pos.y > this.bounds.maxY) {
            return false;
        }
        return this._isPointInPolygon2D(pos);
    }

    containsWithPadding(pos, padding) {
        if (!this.contains(pos)) return false;
        if (padding <= 0) return true;
        const padding2 = padding * padding;
        for (let i = 0, j = this.vertices.length - 1; i < this.vertices.length; j = i++) {
            const dist2 = this._distanceSquaredToSegment2D(pos, this.vertices[i], this.vertices[j]);
            if (dist2 < padding2) return false;
        }
        return true;
    }

    _suffixToOrder(suffix) {
        let order = 0;
        for (let i = 0; i < suffix.length; i++) {
            const code = suffix.toUpperCase().charCodeAt(i);
            if (code < 65 || code > 90) return Number.MAX_SAFE_INTEGER;
            order = order * 26 + (code - 64);
        }
        return order;
    }

    _computeBounds() {
        let minX = Infinity, maxX = -Infinity;
        let minY = Infinity, maxY = -Infinity;
        let minZ = Infinity, maxZ = -Infinity;

        for (const v of this.vertices) {
            if (v.x < minX) minX = v.x;
            if (v.x > maxX) maxX = v.x;
            if (v.y < minY) minY = v.y;
            if (v.y > maxY) maxY = v.y;
            if (v.z < minZ) minZ = v.z;
            if (v.z > maxZ) maxZ = v.z;
        }

        this.bounds = { minX, maxX, minY, maxY, minZ, maxZ };
    }

    _isPointInPolygon2D(pos) {
        let inside = false;
        for (let i = 0, j = this.vertices.length - 1; i < this.vertices.length; j = i++) {
            const vi = this.vertices[i];
            const vj = this.vertices[j];
            const intersects = ((vi.y > pos.y) !== (vj.y > pos.y)) &&
                (pos.x < ((vj.x - vi.x) * (pos.y - vi.y)) / (vj.y - vi.y) + vi.x);
            if (intersects) inside = !inside;
        }
        return inside;
    }

    _distanceSquaredToSegment2D(p, a, b) {
        const abx = b.x - a.x;
        const aby = b.y - a.y;
        const apx = p.x - a.x;
        const apy = p.y - a.y;
        const len2 = abx * abx + aby * aby;
        if (len2 === 0) return apx * apx + apy * apy;
        let t = (apx * abx + apy * aby) / len2;
        if (t < 0) t = 0;
        else if (t > 1) t = 1;
        const cx = a.x + abx * t;
        const cy = a.y + aby * t;
        const dx = p.x - cx;
        const dy = p.y - cy;
        return dx * dx + dy * dy;
    }
}

