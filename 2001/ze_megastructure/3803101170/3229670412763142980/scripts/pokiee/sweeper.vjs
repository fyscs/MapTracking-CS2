import { Entity, Instance } from "cs_script/point_script";

const SWEEPER_MIN_FACTOR = 0.1;
const SWEEPER_MAX_FACTOR = 1.0;
const SWEEPER_MAX_DISTANCE = 1024;

/**
 * @param {{ x: number, y: number, z: number }} origin
 * @returns {number} 0.1 - 1.0
 */
function getSweeperFactor(origin) {
    const targets = Instance.FindEntitiesByClass("info_target").filter(ent =>
        ent.IsValid() && ent.GetEntityName().includes("item_flag_target"));
    if (targets.length === 0) return SWEEPER_MAX_FACTOR;

    let minDistSq = Infinity;
    for (const target of targets) {
        if (!target.IsValid()) continue;
        const pos = target.GetAbsOrigin();
        const dx = pos.x - origin.x;
        const dy = pos.y - origin.y;

        const distSq = dx * dx + dy * dy;
        if (distSq < minDistSq) minDistSq = distSq;
    }

    if (!isFinite(minDistSq)) return SWEEPER_MAX_FACTOR;

    const dist = Math.sqrt(minDistSq);
    const t = Math.min(dist / SWEEPER_MAX_DISTANCE, 1);
    return SWEEPER_MIN_FACTOR + t * (SWEEPER_MAX_FACTOR - SWEEPER_MIN_FACTOR);
}

/**
 * @param {number} factor 
 * @returns {"close"|"normal"|"far"}
 */
function getSweeperStage(factor) {
    if (factor < 0.3) return "close";
    if (factor < 0.6) return "normal";
    return "far"
}



class SweeperItem {
    /** @type {Map<string, SweeperItem>} */
    static instances = new Map();

    /** @param {Entity} relayEntity  */
    static connect(relayEntity) {
        if (!relayEntity.IsValid()) return;
        
        const relayName = relayEntity.GetEntityName();
        
        const basePrefix = relayName.replace("relay", "");
        
        const glock = Instance.FindEntityByName(relayName.replace("relay", "glock"));
        const model = Instance.FindEntityByName(relayName.replace("relay", "model"));
        const point = Instance.FindEntityByName(relayName.replace("relay", "point"));
        const soundTimer = Instance.FindEntityByName(relayName.replace("relay", "sound_timer"));
        const particle = Instance.FindEntityByName(relayName.replace("relay", "particle"));

        if (!glock?.IsValid()) return;
        
        const item = new SweeperItem(basePrefix, glock, model, point, soundTimer, particle);
        this.instances.set(basePrefix, item);
    }

    static resetAll() {
        for (const [key, item] of this.instances) {
            if (!item.glock.IsValid()) {
                this.instances.delete(key);
                continue;
            }

            item.reset();
        }
    }

    /**
     * 
     * @param {string} prefix 
     * @param {Entity} glock 
     * @param {Entity | undefined} model 
     * @param {Entity | undefined} point
     * @param {Entity | undefined} soundTimer 
     * @param {Entity | undefined} particle 
     */
    constructor(prefix, glock, model, point, soundTimer, particle){
        this.prefix = prefix;
        this.glock = glock;
        this.model = model;
        this.point = point;
        this.soundTimer = soundTimer;
        this.particle = particle;

        this.stage = "";
        this.timerEnabled = false;
    }

    reset() {
        this.stage = "";
        this.timerEnabled = false;
    }

    /**
     * @param {boolean} enabled 
     * @returns 
     */
    setTimerEnabled(enabled) {
        if (!this.soundTimer || !this.soundTimer.IsValid()) return;
        if (this.timerEnabled === enabled) return;

        this.timerEnabled = enabled;

        Instance.EntFireAtTarget({ target: this.soundTimer, input: enabled ? "Enable" : "Disable"});
    }

    update() {
        if (!this.model || !this.model.IsValid()) return;
        const owner = this.model.GetParent()?.GetOwner();

        if (!owner || !owner.IsValid() || !owner.IsAlive() || !this.point || !this.point.IsValid()) {
            this.stage = "";
            this.timerEnabled = false;
            return;
        }

        this.setTimerEnabled(true);

        const factor = getSweeperFactor(this.point.GetAbsOrigin());
        const stage = getSweeperStage(factor);
        if (stage !== this.stage) {
            this.stage = stage;
            this.onStageChange(stage);
        }
    }

    /**
     * @param {"close"|"normal"|"far"} stage 
     */
    onStageChange(stage) {
        if (!this.particle || !this.particle.IsValid()) return;
        if (!this.soundTimer || !this.soundTimer.IsValid()) return;
        switch (stage){
            case "close": {
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "1: 255 0 0"});
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "2: 0.2 0 0"});
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "RefireTime", value: 0.2 });
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "FireUser1"});
                break;
            }
            case "normal": {
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "1: 255 255 0"});
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "2: 0.7 0 0"});
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "RefireTime", value: 0.7 });
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "FireUser1"});
                break;
            }
            case "far": {
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "1: 0 255 0"});
                Instance.EntFireAtTarget({ target: this.particle, input: "SetControlPoint", value: "2: 1.2 0 0"});
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "RefireTime", value: 1.2 });
                Instance.EntFireAtTarget({ target: this.soundTimer, input: "FireUser1"});
                break;
            }
            default: break;
        }
    }
}

Instance.OnScriptInput("connect_sweeper", (event) => {
    if (event.caller) {
        SweeperItem.connect(event.caller);
    }
});

Instance.OnScriptInput("reset", () => SweeperItem.resetAll());
Instance.SetThink(() => {
    for (const item of SweeperItem.instances.values()) {
        item.update();
    }
    Instance.SetNextThink(Instance.GetGameTime() + 0.3);
});
Instance.SetNextThink(Instance.GetGameTime())