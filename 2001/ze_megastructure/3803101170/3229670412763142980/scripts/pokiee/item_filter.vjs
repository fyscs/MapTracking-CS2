import { Instance } from "cs_script/point_script";

// support temp name fixup

const ITEM_NAMES = ["item_tourch_glock", "item_sweeper_glock"];
const WEAPON_CLASS_NAME = "weapon_glock"

const weaponIds = new Map();
const holders = new Map();

/**
 * 
 * @param {string} entityName 
 * @returns 
 */
function matchItemName(entityName) {
    return ITEM_NAMES.some(name => entityName.includes(name));
}

function collectWeapons() {
    weaponIds.clear();
    holders.clear();

    for (const ent of Instance.FindEntitiesByClass(WEAPON_CLASS_NAME)) {
        if (ent.IsValid()) {
            const name = ent.GetEntityName();
            if (matchItemName(name)) {
                weaponIds.set(ent, name);
            }
        }
    }
}

Instance.OnScriptInput("refresh", () => {
    collectWeapons();
});

Instance.OnWeaponPickup(({ weapon }) => {
    if (!weapon?.IsValid() || !weaponIds.has(weapon)) return;
    const owner = weapon.GetOwner();
    if (owner?.IsValid()) {
        const itemId = weaponIds.get(weapon);
        holders.set(itemId, owner);
    }
});

Instance.OnWeaponDrop(({ weapon, dropper }) => {
    if (!weapon?.IsValid() || !weaponIds.has(weapon)) return;
    const itemId = weaponIds.get(weapon);
    const holder = holders.get(itemId);
    if (!holder?.IsValid() || holder === dropper) {
        holders.delete(itemId);
    }
});

Instance.OnPlayerReset(({ player }) => {
    for (const [itemId, holder] of holders) {
        if (holder === player) {
            holders.delete(itemId);
        }
    }
});

Instance.OnScriptInput("test item_tourch_glock", ({ caller, activator }) => {
    if (!caller?.IsValid()) return;
    if (!activator?.IsValid() || !activator.IsAlive()) return;

    for (const [itemId, holder] of holders) {
        if (itemId.includes("item_tourch_glock")) {
            if (!holder?.IsValid() || !holder.IsAlive()) {
                holders.delete(itemId);
                continue;
            }
            if (holder === activator) {
                Instance.EntFireAtTarget({ target: caller, input: "FireUser1" });
                return;
            }
        }
    }
});

Instance.OnScriptInput("test item_sweeper_glock", ({ caller, activator }) => {
    if (!caller?.IsValid()) return;
    if (!activator?.IsValid() || !activator.IsAlive()) return;

    for (const [itemId, holder] of holders) {
        if (itemId.includes("item_sweeper_glock")) {
            if (!holder?.IsValid() || !holder.IsAlive()) {
                holders.delete(itemId);
                continue;
            }
            if (holder === activator) {
                Instance.EntFireAtTarget({ target: caller, input: "FireUser1" });
                return;
            }
        }
    }
});