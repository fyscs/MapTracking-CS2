    baseBodyName: 'npc_thrower_body',

    baseHealthBoxName: 'npc_thrower_physm',

    baseModelName: 'npc_thrower_model2',

    baseHpTextName: 'npc_thrower_hptext',

    baseMakerName: 'npc_thrower_maker',

    aggroRange: 1800,

    turnStep: 8,

    aimTime: 1.0,

    attackCooldown: 2.5,

    targetPredictTime: 0.35,

    throwSpeed: 1000,

    throwGravity: 800,

    brickBaseName: 'npc_thrower_brick',

    brickLifetime: 5.0,

    // ★ 新增：从 Maker 周围多少距离内寻找 Brick
    brickSearchRadius: 300
};


const TYPE_CONFIG_MAP = {
    light: NPC_CONFIG_LIGHT,
    medium: NPC_CONFIG_MEDIUM,
    heavy: NPC_CONFIG_HEAVY,
    thrower: NPC_CONFIG_THROWER
};


let registeredBodies = [];






// ============================================================
// 注册单个普通 NPC
// ============================================================

function registerNPC(body, config) {
    try {
        if (body._npc_registered) {
            return false;
        }

        if (registeredBodies.includes(body)) {
            return false;
        }

        if (body._npc_interval) {
            clearInterval(body._npc_interval);
            body._npc_interval = null;
        }

        const bodyName = getEntityName(body);

        let suffix = "";

        const match = bodyName.match(/_(\d+)$/);

        if (match) {
            suffix = "_" + match[1];
        }


        // ====================================================
        // 找对应 Thruster
        // ====================================================

        let thrust_forward =
            Instance.FindEntityByName(
                config.baseThrustName +
                "_forward" +
                suffix
            );

        let thrust_left =
            Instance.FindEntityByName(
                config.baseThrustName +
                "_left" +
                suffix
            );

        let thrust_right =
            Instance.FindEntityByName(
                config.baseThrustName +
                "_right" +
                suffix
            );


        // 如果带 ID 的不存在，就尝试基础名字
        if (
            !thrust_forward ||
            !thrust_left ||
            !thrust_right
        ) {
            thrust_forward =
                Instance.FindEntityByName(
                    config.baseThrustName + "_forward"
                );

            thrust_left =
                Instance.FindEntityByName(
                    config.baseThrustName + "_left"
                );

            thrust_right =
                Instance.FindEntityByName(
                    config.baseThrustName + "_right"
                );
        }


        if (
            !thrust_forward ||
            !thrust_left ||
            !thrust_right
        ) {
            Instance.Msg(
                `⚠️ [${config.type}] 推力器缺失，跳过 ${bodyName}`
            );

            return false;
        }


        // ====================================================
        // 初始化 Thruster
        // ====================================================

        Instance.EntFireAtTarget({
            target: thrust_forward,
            input: "Activate"
        });

        Instance.EntFireAtTarget({
            target: thrust_left,
            input: "Activate"
        });

        Instance.EntFireAtTarget({
            target: thrust_right,
            input: "Activate"
        });

        Instance.EntFireAtTarget({
            target: thrust_forward,
            input: "Deactivate"
        });

        Instance.EntFireAtTarget({
            target: thrust_left,
            input: "Deactivate"
        });

        Instance.EntFireAtTarget({
            target: thrust_right,
            input: "Deactivate"
        });

        Instance.EntFireAtTarget({
            target: body,
            input: "Wake"
        });


        // ====================================================
        // 启动 NPC 追逐
        // ====================================================

        const interval =
            npc_chase(
                body,
                thrust_forward,
                thrust_left,
                thrust_right,
                config
            );

        body._npc_interval = interval;
        body._npc_registered = true;

        registeredBodies.push(body);

        Instance.Msg(
            `✅ [${config.type}] ${bodyName} 已注册 (速度: ${config.maxForward})`
        );


        // ====================================================
        // HP 显示
        // ====================================================

        let id = 0;

        let idMatch =
            bodyName.match(/_(\d+)$/);

        if (idMatch) {
            id =
                parseInt(
                    idMatch[1],
                    10
                );
        } else {

            idMatch =
                bodyName.match(/(\d+)$/);

            if (idMatch) {
                id =
                    parseInt(
                        idMatch[1],
                        10
                    );
            }
        }


        if (id > 0) {

            let healthBoxBase = '';
            let textBase = '';


            if (config === NPC_CONFIG_LIGHT) {

                healthBoxBase =
                    'npc_physm';

                textBase =
                    'npc_monster_healthtext';

            } else if (config === NPC_CONFIG_HEAVY) {

                healthBoxBase =
                    'npc_physm_heavy';

                textBase =
                    'npc_heavy_healthtext';

            } else {

                healthBoxBase =
                    'npc_physm';

                textBase =
                    'npc_healthtext';
            }


            const healthCandidates = [
                healthBoxBase + '_' + id,
                healthBoxBase + id
            ];

            let healthBox = null;


            for (const name of healthCandidates) {

                const ent =
                    Instance.FindEntityByName(name);

                if (
                    ent &&
                    ent.IsValid()
                ) {
                    healthBox = ent;
                    break;
                }
            }


            const textCandidates = [
                textBase + '_' + id,
                textBase + id
            ];

            let textEntity = null;


            for (const name of textCandidates) {

                const ent =
                    Instance.FindEntityByName(name);

                if (
                    ent &&
                    ent.IsValid()
                ) {
                    textEntity = ent;
                    break;
                }
            }


            if (
                healthBox &&
                healthBox.IsValid() &&
                textEntity &&
                textEntity.IsValid()
            ) {

                healthBox._textEntity =
                    textEntity;


                Instance.ConnectOutput(
                    healthBox,
                    'OnHealthChanged',
                    (stuff) => {

                        const box =
                            stuff.caller;

                        if (
                            !box ||
                            !box.IsValid()
                        ) {
                            return;
                        }


                        const text =
                            box._textEntity;

                        if (
                            !text ||
                            !text.IsValid()
                        ) {
                            return;
                        }


                        const health =
                            box.GetHealth
                                ? box.GetHealth()
                                : 0;


                        Instance.EntFireAtTarget({
                            target: text,
                            input: 'SetMessage',
                            value:
                                'HP: ' +
                                Math.floor(health)
                        });
                    }
                );


                const initHealth =
                    healthBox.GetHealth
                        ? healthBox.GetHealth()
                        : 0;


                Instance.EntFireAtTarget({
                    target: textEntity,
                    input: 'SetMessage',
                    value:
                        'HP: ' +
                        Math.floor(initHealth)
                });


                Instance.Msg(
                    `📊 血量显示绑定成功：${healthBox.GetEntityName()} → ${textEntity.GetEntityName()}`
                );

            } else {

                if (!healthBox) {
                    Instance.Msg(
                        `⚠️ 未找到血量箱（尝试了 ${healthCandidates.join('、')}）`
                    );
                }

                if (!textEntity) {
                    Instance.Msg(
                        `⚠️ 未找到血量文本（尝试了 ${textCandidates.join('、')}）`
                    );
                }
            }
        }

        return true;

    } catch (e) {

        Instance.Msg(
            `❌ 注册 ${config.type} NPC 时发生异常: ${e.message}`
        );

        return false;
    }
}


// ============================================================
// 普通 NPC 追逐
// ============================================================

function npc_chase(
    body,
    thrust_forward,
    thrust_left,
    thrust_right,
    config
) {

    let currentForwardThrust = 50;

    let sideActive = false;

    let smoothAngle = 0;

    let brakeActive = false;

    let brakeFrames = 0;

    let lastTurnDirection = 0;

    let lastPosition =
        body.GetAbsOrigin
            ? body.GetAbsOrigin()
            : new Vec3(0, 0, 0);

    let stuckCounter = 0;

    let hadTarget = false;


    const interval =
        setInterval(() => {

            if (
                !body?.IsValid() ||
                !thrust_forward?.IsValid() ||
                !thrust_left?.IsValid() ||
                !thrust_right?.IsValid()
            ) {

                clearInterval(interval);

                if (body) {
                    body._npc_interval = null;
                }

                Instance.Msg(
                    `🛑 [${config.type}] NPC 实体已销毁，停止追逐循环`
                );

                return;
            }


            // =================================================
            // 找最近的 CT（已移除视线检测）
            // =================================================

            const players =
                Instance.FindEntitiesByClass("player");

            let target = null;

            let minDist =
                NPC_AGGRO_RANGE;


            for (const player of players) {

                if (
                    player?.IsValid() &&
                    player.IsAlive() &&
                    player.GetTeamNumber() == 3
                ) {

                    const dist =
                        Vector3Utils.distance(
                            body.GetAbsOrigin(),
                            player.GetAbsOrigin()
                        );


                    if (dist >= minDist) {
                        continue;
                    }


                    // 视线检测已移除：不再因为遮挡而放弃目标


                    minDist = dist;

                    target = player;
                }
            }


            if (target) {

                if (!hadTarget) {

                    hadTarget = true;

                    if (
                        body &&
                        body.IsValid()
                    ) {

                        Instance.EntFireAtTarget({
                            target: body,
                            input: "FireUser2"
                        });
                    }
                }

            } else {

                hadTarget = false;
            }


            // =================================================
            // 没目标
            // =================================================

            if (!target) {

                Instance.EntFireAtTarget({
                    target: thrust_forward,
                    input: "Deactivate"
                });

                Instance.EntFireAtTarget({
                    target: thrust_left,
                    input: "Deactivate"
                });

                Instance.EntFireAtTarget({
                    target: thrust_right,
                    input: "Deactivate"
                });


                sideActive = false;
                brakeActive = false;
                lastTurnDirection = 0;
                stuckCounter = 0;


                lastPosition =
                    body.GetAbsOrigin
                        ? body.GetAbsOrigin()
                        : new Vec3(0, 0, 0);

                return;
            }


            Instance.EntFireAtTarget({
                target: body,
                input: "Wake"
            });


            let currentPos =
                body.GetAbsOrigin
                    ? body.GetAbsOrigin()
                    : new Vec3(0, 0, 0);


            let displacement =
                Vector3Utils.distance(
                    currentPos,
                    lastPosition
                );


            if (
                displacement <
                NPC_STUCK_THRESHOLD
            ) {
                stuckCounter++;
            } else {
                stuckCounter = 0;
            }


            lastPosition =
                currentPos;


            // =================================================
            // 卡死修正
            // =================================================

            if (
                stuckCounter >
                NPC_STUCK_FRAME_LIMIT
            ) {

                let bodyPos =
                    body.GetAbsOrigin
                        ? body.GetAbsOrigin()
                        : new Vec3(0, 0, 0);


                let targetPos =
                    target.GetAbsOrigin
                        ? target.GetAbsOrigin()
                        : new Vec3(0, 0, 0);


                let dirToTarget =
                    Vector3Utils.subtract(
                        targetPos,
                        bodyPos
                    );


                let horizontalDir =
                    new Vec3(
                        dirToTarget.x,
                        dirToTarget.y,
                        0
                    );


                if (
                    horizontalDir.length >
                    0.1
                ) {

                    let targetAng =
                        Vector3Utils.vectorAngles(
                            horizontalDir
                        );

                    body.Teleport(
                        null,
                        targetAng,
                        null
                    );
                }


                stuckCounter = 0;

                lastPosition =
                    body.GetAbsOrigin
                        ? body.GetAbsOrigin()
                        : new Vec3(0, 0, 0);
            }


            // =================================================
            // 预测目标位置
            // =================================================

            let targetPos =
                target.GetAbsOrigin
                    ? target.GetAbsOrigin()
                    : new Vec3(0, 0, 0);


            let targetVel =
                target.GetVelocity
                    ? target.GetVelocity()
                    : new Vec3(0, 0, 0);


            if (targetVel) {

                let predictedPos =
                    Vector3Utils.add(
                        targetPos,
                        Vector3Utils.scale(
                            targetVel,
                            NPC_PREDICT_TIME
                        )
                    );


                let delta =
                    Vector3Utils.subtract(
                        predictedPos,
                        body.GetAbsOrigin()
                    );


                if (
                    delta.length >
                    NPC_AGGRO_RANGE * 1.2
                ) {

                    predictedPos =
                        targetPos;
                }


                targetPos =
                    predictedPos;
            }


            // =================================================
            // 计算角度
            // =================================================

            let body_forward =
                getForwardVector(
                    body.GetAbsAngles()
                );


            let rawAngle =
                GetDirectionToTarget(
                    body.GetAbsOrigin(),
                    targetPos,
                    body_forward
                );


            smoothAngle =
                smoothAngle *
                NPC_SMOOTH_FACTOR +
                rawAngle *
                (1 - NPC_SMOOTH_FACTOR);


            let angleAbs =
                Math.abs(smoothAngle);


            let speedFactor =
                MathUtils.clamp(
                    1 -
                    (angleAbs / 90) *
                    0.75,
                    0.25,
                    1.0
                );


            if (
                minDist <
                300
            ) {

                speedFactor *=
                    MathUtils.clamp(
                        minDist / 300,
                        0.2,
                        1.0
                    );
            }


            let targetForward =
                Math.max(
                    80,
                    config.maxForward *
                    speedFactor
                );


            // =================================================
            // 前进推力
            // =================================================

            if (
                currentForwardThrust <
                targetForward
            ) {

                currentForwardThrust =
                    Math.min(
                        currentForwardThrust +
                        config.accel * 2,
                        targetForward
                    );

            } else if (
                currentForwardThrust >
                targetForward
            ) {

                currentForwardThrust =
                    Math.max(
                        targetForward,
                        currentForwardThrust -
                        config.accel * 4
                    );
            }


            currentForwardThrust =
                MathUtils.clamp(
                    currentForwardThrust,
                    50,
                    config.maxForward
                );


            Instance.EntFireAtTarget({
                target: thrust_forward,
                input: "KeyValues",
                value:
                    "Force " +
                    currentForwardThrust +
                    " 0 0"
            });


            Instance.EntFireAtTarget({
                target: thrust_forward,
                input: "Activate"
            });


            // =================================================
            // 转向
            // =================================================

            let speed =
                Vector3Utils.length(
                    body.GetVelocity
                        ? body.GetVelocity()
                        : new Vec3(0, 0, 0)
                );


            let sidePower =
                config.maxSide;


            if (
                angleAbs <
                20
            ) {

                sidePower =
                    config.maxSide *
                    (
                        0.2 +
                        0.8 *
                        (angleAbs / 20)
                    );
            }


            sidePower =
                Math.max(
                    config.minSide,
                    sidePower
                );


            if (
                smoothAngle >
                NPC_ANGLE_THRESHOLD
            ) {

                Instance.EntFireAtTarget({
                    target: thrust_right,
                    input: "KeyValues",
                    value:
                        "Force " +
                        sidePower +
                        " 0 0"
                });


                Instance.EntFireAtTarget({
                    target: thrust_right,
                    input: "Activate"
                });


                Instance.EntFireAtTarget({
                    target: thrust_left,
                    input: "Deactivate"
                });


                sideActive = true;

                lastTurnDirection = 1;

                brakeActive = false;


            } else if (
                smoothAngle <
                -NPC_ANGLE_THRESHOLD
            ) {

                Instance.EntFireAtTarget({
                    target: thrust_left,
                    input: "KeyValues",
                    value:
                        "Force " +
                        sidePower +
                        " 0 0"
                });


                Instance.EntFireAtTarget({
                    target: thrust_left,
                    input: "Activate"
                });


                Instance.EntFireAtTarget({
                    target: thrust_right,
                    input: "Deactivate"
                });


                sideActive = true;

                lastTurnDirection = -1;

                brakeActive = false;


            } else {

                // =================================================
                // 刹车 / 微调
                // =================================================

                if (speed > 100) {

                    if (
                        lastTurnDirection !== 0
                    ) {

                        if (!brakeActive) {

                            brakeActive = true;

                            brakeFrames =
                                NPC_BRAKE_DURATION;
                        }


                        if (
                            brakeFrames > 0
                        ) {

                            let brakePower =
                                config.brakeForce *
                                (
                                    currentForwardThrust /
                                    config.maxForward
                                );


                            if (
                                lastTurnDirection === 1
                            ) {

                                Instance.EntFireAtTarget({
                                    target: thrust_left,
                                    input: "KeyValues",
                                    value:
                                        "Force " +
                                        brakePower +
                                        " 0 0"
                                });


                                Instance.EntFireAtTarget({
                                    target: thrust_left,
                                    input: "Activate"
                                });


                                Instance.EntFireAtTarget({
                                    target: thrust_right,
                                    input: "Deactivate"
                                });


                            } else {

                                Instance.EntFireAtTarget({
                                    target: thrust_right,
                                    input: "KeyValues",
                                    value:
                                        "Force " +
                                        brakePower +
                                        " 0 0"
                                });


                                Instance.EntFireAtTarget({
                                    target: thrust_right,
                                    input: "Activate"
                                });


                                Instance.EntFireAtTarget({
                                    target: thrust_left,
                                    input: "Deactivate"
                                });
                            }


                            sideActive = true;

                            brakeFrames--;

                        } else {

                            Instance.EntFireAtTarget({
                                target: thrust_left,
                                input: "Deactivate"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_right,
                                input: "Deactivate"
                            });


                            sideActive = false;
                            brakeActive = false;
                            lastTurnDirection = 0;
                        }


                    } else {

                        if (sideActive) {

                            Instance.EntFireAtTarget({
                                target: thrust_left,
                                input: "Deactivate"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_right,
                                input: "Deactivate"
                            });


                            sideActive = false;
                        }
                    }


                } else {

                    if (
                        !sideActive &&
                        angleAbs > 2
                    ) {

                        let smallPower =
                            Math.max(
                                config.minSide,
                                sidePower * 0.3
                            );


                        if (
                            smoothAngle > 0
                        ) {

                            Instance.EntFireAtTarget({
                                target: thrust_right,
                                input: "KeyValues",
                                value:
                                    "Force " +
                                    smallPower +
                                    " 0 0"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_right,
                                input: "Activate"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_left,
                                input: "Deactivate"
                            });

                        } else {

                            Instance.EntFireAtTarget({
                                target: thrust_left,
                                input: "KeyValues",
                                value:
                                    "Force " +
                                    smallPower +
                                    " 0 0"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_left,
                                input: "Activate"
                            });


                            Instance.EntFireAtTarget({
                                target: thrust_right,
                                input: "Deactivate"
                            });
                        }


                        sideActive = true;

                        brakeActive = false;

                        lastTurnDirection = 0;


                    } else if (
                        sideActive &&
                        angleAbs < 1
                    ) {

                        Instance.EntFireAtTarget({
                            target: thrust_left,
                            input: "Deactivate"
                        });


                        Instance.EntFireAtTarget({
                            target: thrust_right,
                            input: "Deactivate"
                        });


                        sideActive = false;
                    }
                }
            }


            // =================================================
            // 到达目标
            // =================================================

            if (
                minDist < 20
            ) {

                Instance.EntFireAtTarget({
                    target: thrust_forward,
                    input: "Deactivate"
                });


                Instance.EntFireAtTarget({
                    target: thrust_left,
                    input: "Deactivate"
                });


                Instance.EntFireAtTarget({
                    target: thrust_right,
                    input: "Deactivate"
                });


                sideActive = false;
                brakeActive = false;
                lastTurnDirection = 0;

                stuckCounter = 0;

                lastPosition =
                    body.GetAbsOrigin
                        ? body.GetAbsOrigin()
                        : new Vec3(0, 0, 0);
            }

        },
            NPC_TICK * 1000
        );


    return interval;
}


function getForwardVector(ang) {

    const pitchRad =
        ang.pitch * Math.PI / 180;

    const yawRad =
        ang.yaw * Math.PI / 180;


    const x =
        Math.cos(pitchRad) *
        Math.cos(yawRad);

    const y =
        Math.cos(pitchRad) *
        Math.sin(yawRad);

    const z =
        -Math.sin(pitchRad);


    const len =
        Math.hypot(
            x,
            y,
            z
        ) || 1;


    return new Vec3(
        x / len,
        y / len,
        z / len
    );
}


function GetDirectionToTarget(
    origin,
    targetOrigin,
    forward
) {

    const delta =
        Vector3Utils.subtract(
            targetOrigin,
            origin
        );


    const cross =
        Vector3Utils.cross(
            forward,
            delta
        );


    const dot =
        Vector3Utils.dot(
            forward,
            delta
        );


    return (
        Math.atan2(
            cross.z,
            dot
        ) *
        180 /
        Math.PI
    );
}


// ============================================================
// 🧱 Thrower NPC
// ============================================================
//
// Hammer 结构：
//
// npc_thrower_body
//     prop_physics_multiplayer
//     ↓
//     ├── npc_thrower_physm
//     │      func_physbox      ← HP盒
//     │
//     ├── npc_thrower_model2
//     │      prop_model        ← 外观
//     │
//     ├── npc_thrower_hptext
//     │                       ← HP显示
//     │
//     └── npc_thrower_maker
//            env_entity_maker  ← 身前砖头生成点
//
// Brick Template：
//
// npc_thrower_brick
//     func_physbox             ← 隐形物理盒
//
// npc_thrower_brick_model
//     prop_model               ← 砖头外观
//
// npc_thrower_brick_hurt
//     trigger_hurt             ← 砖头伤害
//
// Brick Maker I/O：
//
// OnEntitySpawned
// → bakaboxjs
// → RunScriptInput
// → LaunchThrowerBrick
// → 0.20
// → No
//
// ============================================================



// ============================================================
// Thrower 状态
//
// 使用 Map，不再混用 .length / .push
// ============================================================

const registeredThrowers = new Map();


// ============================================================
// 安全实体遍历
// ============================================================

function getFirstEntitySafe() {

    if (
        typeof CBaseEntity !== "undefined" &&
        CBaseEntity.First
    ) {
        return CBaseEntity.First();
    }

    return null;
}


function getNextEntitySafe(ent) {

    if (
        typeof CBaseEntity !== "undefined" &&
        CBaseEntity.Next
    ) {
        return CBaseEntity.Next(ent);
    }

    return null;
}


// ============================================================
// 获取实体名字
// ============================================================

function getEntityName(ent) {

    if (!ent) {
        return "";
    }

    if (
        typeof ent.GetEntityName === "function"
    ) {
        return ent.GetEntityName();
    }

    if (
        typeof ent.GetName === "function"
    ) {
        return ent.GetName();
    }

    return "";
}


// ============================================================
// 根据基础名字 + ID 找实体
// ============================================================
//
// 注意：Point Template 会自动修改名字，所以：
// 1. 先精确找
// 2. 再通配符
// 3. 最后遍历实体
//
// ============================================================

function findThrowerEntity(baseName, id) {

    // --------------------------------------------------------
    // ① 精确名称
    // --------------------------------------------------------

    const exactNames = [
        `${baseName}_${id}`,
        `${baseName}${id}`
    ];

    for (
        const name
        of exactNames
    ) {

        const ent =
            Instance.FindEntityByName(name);

        if (
            ent &&
            ent.IsValid()
        ) {
            return ent;
        }
    }


    // --------------------------------------------------------
    // ② 通配符
    // --------------------------------------------------------

    const wildcard =
        Instance.FindEntityByName(
            `${baseName}*`
        );

    if (
        wildcard &&
        wildcard.IsValid()
    ) {

        return wildcard;
    }


    // --------------------------------------------------------
    // ③ 遍历实体
    // --------------------------------------------------------

    let current =
        getFirstEntitySafe();

    while (current) {

        if (
            current.IsValid()
        ) {

            const name =
                getEntityName(current);

            if (
                name &&
                name.indexOf(baseName) !== -1
            ) {

                return current;
            }
        }

        current =
            getNextEntitySafe(current);
    }


    return null;
}


// ============================================================
// 👁 NPC 与 CT 的视线判断
//
// 只判断：
// 中间有没有墙/实体
//
// 不判断视野角
// ============================================================

function npc_has_line_of_sight(
    npc,
    player
) {

    if (
        !npc?.IsValid() ||
        !player?.IsValid()
    ) {
        return false;
    }


    const npcOrigin =
        npc.GetAbsOrigin
            ? npc.GetAbsOrigin()
            : null;


    const playerOrigin =
        player.GetAbsOrigin
            ? player.GetAbsOrigin()
            : null;


    if (
        !npcOrigin ||
        !playerOrigin
    ) {
        return false;
    }


    // 从 NPC 稍微高一点的位置发射射线
    const start =
        new Vec3(
            npcOrigin.x,
            npcOrigin.y,
            npcOrigin.z + 32
        );


    // 优先使用玩家眼睛位置
    let end;


    if (
        typeof player.GetEyePosition === "function"
    ) {

        end =
            player.GetEyePosition();

    } else {

        end =
            new Vec3(
                playerOrigin.x,
                playerOrigin.y,
                playerOrigin.z + 32
            );
    }


    const trace =
        Instance.TraceLine({
            start: start,
            end: end,
            ignoreEntity: npc
        });


    if (
        !trace ||
        !trace.didHit
    ) {
        return true;
    }


    // 如果直接命中玩家，也算可见
    if (
        trace.hitEntity === player
    ) {
        return true;
    }


    return false;
}


// ============================================================
// Thrower 找目标
// ============================================================

function findThrowerTarget(body) {

    if (
        !body?.IsValid()
    ) {
        return null;
    }


    const players =
        Instance.FindEntitiesByClass("player");


    const bodyPos =
        body.GetAbsOrigin();


    let target =
        null;


    let minDist =
        NPC_CONFIG_THROWER.aggroRange;


    for (
        const player
        of players
    ) {

        if (
            !player?.IsValid() ||
            !player.IsAlive() ||
            player.GetTeamNumber() !== 3
        ) {
            continue;
        }


        const playerPos =
            player.GetAbsOrigin();


        const dist =
            Vector3Utils.distance(
                bodyPos,
                playerPos
            );


        if (
            dist >= minDist
        ) {
            continue;
        }


        // 视线检测已移除：不再因为有墙而放弃目标


        minDist =
            dist;


        target =
            player;
    }


    return target;
}


// ============================================================
// Thrower 面向目标
//
// 不使用 GetAbsAngles().rotateTowards()
// 因为 CS2 返回的角度对象不是我们自己的 Euler。
// ============================================================

function faceThrowerTarget(
    body,
    target
) {

    if (
        !body?.IsValid() ||
        !target?.IsValid()
    ) {
        return;
    }


    const bodyPos =
        body.GetAbsOrigin();


    const targetPos =
        target.GetAbsOrigin();


    const dx =
        targetPos.x -
        bodyPos.x;


    const dy =
        targetPos.y -
        bodyPos.y;


    if (
        Math.abs(dx) < 0.01 &&
        Math.abs(dy) < 0.01
    ) {
        return;
    }


    const targetYaw =
        Math.atan2(
            dy,
            dx
        ) *
        180 /
        Math.PI;


    const currentAngle =
        body.GetAbsAngles();


    const currentYaw =
        currentAngle.yaw;


    // ========================================================
    // 计算最短旋转角
    // ========================================================

    let deltaYaw =
        targetYaw -
        currentYaw;


    while (
        deltaYaw > 180
    ) {
        deltaYaw -= 360;
    }


    while (
        deltaYaw < -180
    ) {
        deltaYaw += 360;
    }


    const maxStep =
        NPC_CONFIG_THROWER.turnStep;


    let newYaw;


    if (
        Math.abs(deltaYaw) <= maxStep
    ) {

        newYaw =
            targetYaw;

    } else {

        newYaw =
            currentYaw +
            Math.sign(deltaYaw) *
            maxStep;
    }


    body.Teleport(
        null,
        {
            pitch: currentAngle.pitch,
            yaw: newYaw,
            roll: currentAngle.roll
        },
        null
    );
}


// ============================================================
// 计算砖头抛物线初速度
//
// 给定：
// start = 砖头出生位置
// target = 玩家预测位置
//
// 返回：
// {
//     x,
//     y,
//     z
// }
// ============================================================

function calculateThrowVelocity(
    start,
    target,
    speed,
    gravity
) {

    const dx =
        target.x -
        start.x;


    const dy =
        target.y -
        start.y;


    const dz =
        target.z -
        start.z;


    const horizontalDistance =
        Math.sqrt(
            dx * dx +
            dy * dy
        );


    // --------------------------------------------------------
    // 极近距离
    // --------------------------------------------------------

    if (
        horizontalDistance < 1
    ) {

        return {
            x: 0,
            y: 0,
            z: speed
        };
    }


    const v2 =
        speed *
        speed;


    const discriminant =
        v2 * v2 -
        gravity *
        (
            gravity *
            horizontalDistance *
            horizontalDistance +

            2 *
            dz *
            v2
        );


    // 默认 45° 抛物线
    let angle =
        45 *
        Math.PI /
        180;


    if (
        discriminant >= 0
    ) {

        const sqrtDisc =
            Math.sqrt(
                discriminant
            );


        // 低抛轨道
        const tanTheta =
            (
                v2 -
                sqrtDisc
            ) /
            (
                gravity *
                horizontalDistance
            );


        if (
            Number.isFinite(
                tanTheta
            ) &&
            tanTheta > 0
        ) {

            angle =
                Math.atan(
                    tanTheta
                );
        }
    }


    // --------------------------------------------------------
    // 限制抛物线角度
    // --------------------------------------------------------

    angle =
        Math.min(
            Math.max(
                angle,
                15 *
                Math.PI /
                180
            ),
            75 *
            Math.PI /
            180
        );


    const horizontalSpeed =
        speed *
        Math.cos(
            angle
        );


    const dirX =
        dx /
        horizontalDistance;


    const dirY =
        dy /
        horizontalDistance;


    return {

        x:
            dirX *
            horizontalSpeed,

        y:
            dirY *
            horizontalSpeed,

        z:
            speed *
            Math.sin(
                angle
            )
    };
}


// ============================================================
// 找距离 Maker 最近、尚未发射的砖头
// ============================================================
//
// 重点：
// 不要求砖头一定叫 npc_thrower_brick_96
// 只要名字包含 npc_thrower_brick 即可。
//
// ============================================================

// ============================================================
// 找刚刚由 Thrower Maker 生成的 Brick
//
// 方案：
// 1. 直接获取场上所有 func_physbox
// 2. 排除 Thrower 自己的 HP 盒 / 主体
// 3. 排除已经发射过的物理盒
// 4. 找离 Maker 最近的 func_physbox
//
// 不再依赖 Point Template 自动修改后的实体名字。
// ============================================================

function findFreshThrowerBrick(
    maker,
    body,
    healthBox
) {
    if (!maker?.IsValid()) {
        return null;
    }

    const makerPos =
        maker.GetAbsOrigin();

    const physboxes =
        Instance.FindEntitiesByClass(
            "func_physbox"
        );

    if (
        !physboxes ||
        physboxes.length === 0
    ) {
        return null;
    }

    let bestBrick = null;
    let bestDistance =
        NPC_CONFIG_THROWER.brickSearchRadius;

    for (
        const ent
        of physboxes
    ) {

        if (
            !ent?.IsValid()
        ) {
            continue;
        }

        // ----------------------------------------------------
        // 排除 Thrower 主体
        // ----------------------------------------------------

        if (
            body &&
            ent === body
        ) {
            continue;
        }

        // ----------------------------------------------------
        // 排除 Thrower HP 盒
        // ----------------------------------------------------

        if (
            healthBox &&
            ent === healthBox
        ) {
            continue;
        }

        // ----------------------------------------------------
        // 排除已经发射过的砖头
        // ----------------------------------------------------

        if (
            ent._thrower_launched
        ) {
            continue;
        }

        // ----------------------------------------------------
        // 必须有位置
        // ----------------------------------------------------

        if (
            typeof ent.GetAbsOrigin !== "function"
        ) {
            continue;
        }

        const entPos =
            ent.GetAbsOrigin();

        const distance =
            Vector3Utils.distance(
                makerPos,
                entPos
            );

        // ----------------------------------------------------
        // 找最近的 func_physbox
        // ----------------------------------------------------

        if (
            distance < bestDistance
        ) {
            bestDistance = distance;
            bestBrick = ent;
        }
    }

    if (
        bestBrick
    ) {

        Instance.Msg(
            `✅ [Thrower] 找到 Brick：${getEntityName(bestBrick)}`
        );

        Instance.Msg(
            `   Class = ${bestBrick.GetClassName ? bestBrick.GetClassName() : "Unknown"}`
        );

        Instance.Msg(
            `   Distance to Maker = ${bestDistance.toFixed(1)}`
        );

        return bestBrick;
    }

    return null;
}

// ============================================================
// Thrower HP 显示
// ============================================================

function bindThrowerHealth(
    id
) {

    const healthBox =
        findThrowerEntity(
            NPC_CONFIG_THROWER
                .baseHealthBoxName,
            id
        );


    const textEntity =
        findThrowerEntity(
            NPC_CONFIG_THROWER
                .baseHpTextName,
            id
        );


    if (
        !healthBox?.IsValid()
    ) {

        Instance.Msg(
            `⚠️ [Thrower] 找不到 HP 盒：${NPC_CONFIG_THROWER.baseHealthBoxName}`
        );

        return;
    }


    if (
        !textEntity?.IsValid()
    ) {

        Instance.Msg(
            `⚠️ [Thrower] 找不到 HP 文本：${NPC_CONFIG_THROWER.baseHpTextName}`
        );

        return;
    }


    healthBox._throwerHpText =
        textEntity;


    Instance.ConnectOutput(
        healthBox,
        "OnHealthChanged",
        (event) => {

            const box =
                event.caller;


            if (
                !box?.IsValid()
            ) {
                return;
            }


            const text =
                box._throwerHpText;


            if (
                !text?.IsValid()
            ) {
                return;
            }


            const hp =
                box.GetHealth
                    ? box.GetHealth()
                    : 0;


            Instance.EntFireAtTarget({
                target: text,
                input: "SetMessage",
                value:
                    "HP: " +
                    Math.floor(hp)
            });
        }
    );


    const initialHP =
        healthBox.GetHealth
            ? healthBox.GetHealth()
            : 0;


    Instance.EntFireAtTarget({
        target: textEntity,
        input: "SetMessage",
        value:
            "HP: " +
            Math.floor(initialHP)
    });


    Instance.Msg(
        `📊 [Thrower] HP绑定成功：${getEntityName(healthBox)} → ${getEntityName(textEntity)}`
    );
}


// ============================================================
// Thrower 注册
// ============================================================

function registerThrowerNPC(
    body,
    id
) {

    if (
        !body?.IsValid()
    ) {

        Instance.Msg(
            `❌ [Thrower] NPC主体无效：${id}`
        );

        return false;
    }


    if (
        registeredThrowers.has(id)
    ) {

        Instance.Msg(
            `⚠️ [Thrower] NPC ${id} 已经注册`
        );

        return false;
    }


    const maker =
        findThrowerEntity(
            NPC_CONFIG_THROWER
                .baseMakerName,
            id
        );


    if (
        !maker?.IsValid()
    ) {

        Instance.Msg(
            `❌ [Thrower] 找不到 Maker：${NPC_CONFIG_THROWER.baseMakerName}`
        );

        return false;
    }


    const healthBox =
        findThrowerEntity(
            NPC_CONFIG_THROWER.baseHealthBoxName,
            id
        );

    const data = {
        id: id,
        body: body,
        maker: maker,
        healthBox: healthBox,

        target: null,

        aimStartedAt: null,

        cooldownUntil: 0,

        pendingLaunch: false,

        pendingTarget: null,

        interval: null
    };


    registeredThrowers.set(
        id,
        data
    );


    // HP
    bindThrowerHealth(id);


    // ========================================================
    // AI Tick
    // ========================================================

    data.interval =
        setInterval(
            () => {

                if (
                    !data.body?.IsValid() ||
                    !data.maker?.IsValid()
                ) {

                    if (
                        data.interval
                    ) {

                        clearInterval(
                            data.interval
                        );
                    }


                    registeredThrowers.delete(
                        id
                    );

                    return;
                }


                const now =
                    Instance.GetGameTime();


                // =================================================
                // CD
                // =================================================

                if (
                    now <
                    data.cooldownUntil
                ) {
                    return;
                }


                // =================================================
                // 当前目标有效性（已移除视线检测）
                // =================================================

                if (
                    data.target
                ) {

                    if (
                        !data.target.IsValid() ||
                        !data.target.IsAlive() ||
                        data.target.GetTeamNumber() !== 3
                    ) {

                        data.target =
                            null;

                        data.aimStartedAt =
                            null;
                    }
                }


                // =================================================
                // 没目标 → 找目标
                // =================================================

                if (
                    !data.target
                ) {

                    data.target =
                        findThrowerTarget(
                            data.body
                        );


                    if (
                        !data.target
                    ) {
                        return;
                    }


                    data.aimStartedAt =
                        now;


                    Instance.Msg(
                        `🎯 [Thrower] ${id} 开始瞄准`
                    );
                }


                // =================================================
                // 持续面向目标
                // =================================================

                faceThrowerTarget(
                    data.body,
                    data.target
                );


                // =================================================
                // 瞄准时间
                // =================================================

                if (
                    data.aimStartedAt === null ||
                    now -
                    data.aimStartedAt <
                    NPC_CONFIG_THROWER
                        .aimTime
                ) {

                    return;
                }


                // =================================================
                // 最终确认（已移除视线检测）
                // =================================================

                if (
                    !data.target?.IsValid() ||
                    !data.target.IsAlive() ||
                    data.target.GetTeamNumber() !== 3
                ) {

                    data.target =
                        null;

                    data.aimStartedAt =
                        null;

                    return;
                }


                // =================================================
                // 保存此次攻击目标
                // =================================================

                const lockedTarget =
                    data.target;


                data.pendingLaunch =
                    true;


                data.pendingTarget =
                    lockedTarget;


                // =================================================
                // ForceSpawn Brick Maker
                // =================================================

                Instance.EntFireAtTarget({
                    target: data.maker,
                    input: "ForceSpawn"
                });


                Instance.Msg(
                    `🧱 [Thrower] ${id} ForceSpawn 砖头`
                );


                // =================================================
                // CD
                // =================================================

                data.cooldownUntil =
                    now +
                    NPC_CONFIG_THROWER
                        .attackCooldown;


                data.target =
                    null;

                data.aimStartedAt =
                    null;

            },

            NPC_TICK *
            1000
        );


    body._thrower_registered =
        true;

    body._thrower_data =
        data;

    body._thrower_interval =
        data.interval;


    Instance.Msg(
        `✅ [Thrower] NPC ${id} 注册成功`
    );


    return true;
}


// ============================================================
// 🧱 Thrower Brick 发射
//
// Hammer:
//
// OnEntitySpawned
// → bakaboxjs
// → RunScriptInput
// → LaunchThrowerBrick
// → 0.20
// → No
//
// 注意：
// OnEntitySpawned 的 caller / activator 是 Maker，
// 不是刚生成的 Brick。
//
// ============================================================

// ============================================================
// 🧱 Thrower Brick 发射
//
// Hammer:
//
// OnEntitySpawned
// → bakaboxjs
// → RunScriptInput
// → LaunchThrowerBrick
// → 0.20
// → No
//
// 注意：
// OnEntitySpawned 的 caller / activator 是 Maker。
// 真正的 Brick 需要通过 findFreshThrowerBrick() 找。
// ============================================================

Instance.OnScriptInput(
    "LaunchThrowerBrick",
    (stuff) => {

        Instance.Msg(
            "🧱 [Thrower] LaunchThrowerBrick 收到"
        );

        // ====================================================
        // 1. 获取触发这个事件的 Maker
        // ====================================================

        let eventMaker = null;

        if (
            stuff?.caller?.IsValid()
        ) {
            eventMaker = stuff.caller;
        }
        else if (
            stuff?.activator?.IsValid()
        ) {
            eventMaker = stuff.activator;
        }

        if (!eventMaker) {
            Instance.Msg(
                "❌ [Thrower] 没有获取到 Maker"
            );
            return;
        }

        Instance.Msg(
            `[Thrower] Event Maker = ${getEntityName(eventMaker)}`
        );


        // ====================================================
        // 2. 根据 Maker 找对应的 Thrower
        // ====================================================

        let data = null;

        for (
            const [
                id,
                thrower
            ]
            of registeredThrowers
        ) {

            if (
                !thrower?.body?.IsValid()
            ) {
                continue;
            }

            if (
                !thrower?.maker?.IsValid()
            ) {
                continue;
            }

            if (
                thrower.maker === eventMaker
            ) {

                data = thrower;
                break;
            }
        }

        if (!data) {
            Instance.Msg(
                `❌ [Thrower] 找不到对应的 Thrower：${getEntityName(eventMaker)}`
            );
            return;
        }


        // ====================================================
        // 3. 必须有正在等待发射的任务
        // ====================================================

        if (
            !data.pendingLaunch
        ) {

            Instance.Msg(
                `⚠️ [Thrower] ${data.id} 没有 pendingLaunch`
            );

            return;
        }


        // ====================================================
        // 4. 声明 Brick
        // ====================================================

        let brick = null;


        // ====================================================
        // 5. 先尝试 caller / activator
        //
        // 不过你目前已经测试过：
        // caller / activator = env_entity_maker
        //
        // 所以这里不会把 Maker 当砖头。
        // ====================================================

        const possibleEntities = [];

        if (
            stuff?.caller?.IsValid()
        ) {
            possibleEntities.push(
                stuff.caller
            );
        }

        if (
            stuff?.activator?.IsValid() &&
            stuff.activator !== stuff.caller
        ) {
            possibleEntities.push(
                stuff.activator
            );
        }


        for (
            const ent
            of possibleEntities
        ) {

            if (
                !ent?.IsValid()
            ) {
                continue;
            }

            const className =
                ent.GetClassName
                    ? ent.GetClassName()
                    : "";

            // 只有 func_physbox 才可能是 Brick
            if (
                className === "func_physbox"
            ) {

                // 不允许把 Thrower 自己的 HP 盒当成砖头
                if (
                    data.healthBox &&
                    ent === data.healthBox
                ) {
                    continue;
                }

                // 不允许把主体当砖头
                if (
                    ent === data.body
                ) {
                    continue;
                }

                brick = ent;
                break;
            }
        }


        // ====================================================
        // 6. caller / activator 不是 Brick
        //    → 从 Maker 附近寻找
        // ====================================================

        if (!brick) {

            brick =
                findFreshThrowerBrick(
                    data.maker,
                    data.body,
                    data.healthBox
                );
        }


        // ====================================================
        // 7. 第一次没找到
        //    → 延迟重试
        // ====================================================

        if (
            !brick ||
            !brick.IsValid()
        ) {

            Instance.Msg(
                "⚠️ [Thrower] Brick 暂时还没出现，开始重试"
            );

            let retryCount = 0;

            const retryFind = () => {

                if (
                    !data?.body?.IsValid()
                ) {
                    return;
                }

                if (
                    !data.pendingLaunch
                ) {
                    return;
                }

                retryCount++;

                brick =
                    findFreshThrowerBrick(
                        data.maker,
                        data.body,
                        data.healthBox
                    );


                if (
                    brick?.IsValid()
                ) {

                    launchThrowerBrickNow(
                        data,
                        brick
                    );

                    return;
                }


                if (
                    retryCount >= 10
                ) {

                    Instance.Msg(
                        `❌ [Thrower] ${data.id} 重试 ${retryCount} 次后仍然找不到 Brick`
                    );

                    data.pendingLaunch =
                        false;

                    data.pendingTarget =
                        null;

                    return;
                }


                setTimeout(
                    retryFind,
                    50
                );
            };


            setTimeout(
                retryFind,
                50
            );


            return;
        }


        // ====================================================
        // 8. 找到了 Brick
        // ====================================================

        launchThrowerBrickNow(
            data,
            brick
        );
    }
);


// ============================================================
// 实际发射 Brick
// ============================================================

function launchThrowerBrickNow(
    data,
    brick
) {

    if (
        !data?.body?.IsValid()
    ) {
        return;
    }


    if (
        !brick?.IsValid()
    ) {

        data.pendingLaunch =
            false;

        data.pendingTarget =
            null;

        return;
    }


    // ========================================================
    // 获取目标
    // ========================================================

    const target =
        data.pendingTarget;


    if (
        !target?.IsValid() ||
        !target.IsAlive() ||
        target.GetTeamNumber() !== 3
    ) {

        Instance.Msg(
            `⚠️ [Thrower] ${data.id} 的目标已经失效`
        );


        Instance.EntFireAtTarget({
            target: brick,
            input: "Kill"
        });


        data.pendingLaunch =
            false;

        data.pendingTarget =
            null;


        return;
    }


    // ========================================================
    // 获取目标位置
    // ========================================================

    let targetPos =
        target.GetAbsOrigin();

    // ★ 新增：抬高 60 单位
    targetPos =
        new Vec3(
            targetPos.x,
            targetPos.y,
            targetPos.z + 60
        );

    // ========================================================
    // 获取玩家速度
    // ========================================================

    let targetVelocity =
        new Vec3(
            0,
            0,
            0
        );


    if (
        typeof target.GetVelocity === "function"
    ) {

        targetVelocity =
            target.GetVelocity();
    }


    // ========================================================
    // 预测玩家位置
    // ========================================================

    if (
        targetVelocity
    ) {

        targetPos =
            Vector3Utils.add(
                targetPos,

                Vector3Utils.scale(
                    targetVelocity,

                    NPC_CONFIG_THROWER
                        .targetPredictTime
                )
            );
    }


    // ========================================================
    // Brick 起点
    // ========================================================

    const start =
        brick.GetAbsOrigin();


    // ========================================================
    // 计算抛物线速度
    // ========================================================

    const launchVelocity =
        calculateThrowVelocity(
            start,
            targetPos,

            NPC_CONFIG_THROWER
                .throwSpeed,

            NPC_CONFIG_THROWER
                .throwGravity
        );


    Instance.Msg(
        `[Thrower] ${data.id} 发射速度：` +
        `X=${launchVelocity.x.toFixed(1)} ` +
        `Y=${launchVelocity.y.toFixed(1)} ` +
        `Z=${launchVelocity.z.toFixed(1)}`
    );


    // ========================================================
    // 给真正的 Brick func_physbox 速度
    // ========================================================

    brick.Teleport({
        velocity:
            launchVelocity
    });


    // 标记这个物理盒已经是 Thrower 发出去的砖头
    brick._thrower_launched =
        true;


    // ========================================================
    // 清除等待状态
    // ========================================================

    data.pendingLaunch =
        false;

    data.pendingTarget =
        null;


    Instance.Msg(
        `🧱 [Thrower] ${data.id} 成功发射 Brick！`
    );


    // ========================================================
    // 5 秒保险删除
    // ========================================================

    setTimeout(
        () => {

            if (
                brick?.IsValid()
            ) {

                Instance.EntFireAtTarget({
                    target: brick,
                    input: "Kill"
                });
            }

        },

        NPC_CONFIG_THROWER
            .brickLifetime *
        1000
    );
}

// ============================================================
// Thrower 注册入口
//
// Hammer：
//
// npc_register_thrower
// OnSpawn
// → bakaboxjs
// → RunScriptInput
// → input_register_thrower_npc
// → 0.00
// → No
//
// ============================================================

Instance.OnScriptInput(
    "input_register_thrower_npc",
    (stuff) => {

        const caller =
            stuff.caller;


        if (
            !caller?.IsValid()
        ) {

            Instance.Msg(
                "❌ input_register_thrower_npc：没有有效 caller"
            );

            return;
        }


        const name =
            getEntityName(
                caller
            );


        const prefix =
            "npc_register_thrower_";


        if (
            !name.startsWith(
                prefix
            )
        ) {

            Instance.Msg(
                `❌ [Thrower] 无效注册器名称：${name}`
            );

            return;
        }


        const id =
            parseInt(
                name.substring(
                    prefix.length
                ),
                10
            );


        if (
            isNaN(id) ||
            id <= 0
        ) {

            Instance.Msg(
                `❌ [Thrower] 无效 ID：${name}`
            );

            return;
        }


        // ====================================================
        // 找 NPC 主体
        // ====================================================

        const body =
            findThrowerEntity(
                NPC_CONFIG_THROWER
                    .baseBodyName,
                id
            );


        // ====================================================
        // 找 Maker
        // ====================================================

        const maker =
            findThrowerEntity(
                NPC_CONFIG_THROWER
                    .baseMakerName,
                id
            );


        if (
            !body?.IsValid()
        ) {

            Instance.Msg(
                `❌ [Thrower] 找不到主体：${NPC_CONFIG_THROWER.baseBodyName}`
            );

            return;
        }


        if (
            !maker?.IsValid()
        ) {

            Instance.Msg(
                `❌ [Thrower] 找不到 Maker：${NPC_CONFIG_THROWER.baseMakerName}`
            );

            return;
        }


        // ====================================================
        // 注册
        // ====================================================

        registerThrowerNPC(
            body,
            id
        );
    }
);


// ============================================================
// Thrower 清理
// ============================================================

Instance.OnScriptInput(
    "input_cleanup_throwers",
    () => {

        for (
            const [
                id,
                data
            ]
            of registeredThrowers
        ) {

            if (
                data?.interval
            ) {

                clearInterval(
                    data.interval
                );
            }


            if (
                data?.aimTimer
            ) {

                clearTimeout(
                    data.aimTimer
                );
            }


            if (
                data?.body?.IsValid()
            ) {

                data.body._thrower_interval =
                    null;

                data.body._thrower_registered =
                    false;

                data.body._thrower_data =
                    null;

                data.body._thrower_pending_launch =
                    false;

                data.body._thrower_pending_target =
                    null;
            }
        }


        registeredThrowers.clear();


        Instance.Msg(
            "✅ [Thrower] 已清理所有 Thrower"
        );
    }
);
// ============================================================
// NPC 注册入口
// ============================================================

Instance.OnScriptInput(
    "input_register_npc",
    (stuff) => {

        const caller =
            stuff.caller;


        if (
            !caller ||
            !caller.IsValid()
        ) {

            Instance.Msg(
                "❌ input_register_npc: 没有有效的 caller（请确保由 logic_relay 触发）"
            );

            return;
        }


        const name =
            caller.GetEntityName
                ? caller.GetEntityName()
                : '';


        if (!name) {

            Instance.Msg(
                "❌ caller 没有 targetname"
            );

            return;
        }


        const prefix =
            "npc_register_";


        if (
            !name.startsWith(prefix)
        ) {

            Instance.Msg(
                `❌ 无效的 caller targetname: ${name}，应以 "npc_register_" 开头`
            );

            return;
        }


        const rest =
            name.substring(
                prefix.length
            );


        const parts =
            rest
                .split('_')
                .filter(
                    p =>
                        p.length > 0
                );


        if (
            parts.length < 2
        ) {

            Instance.Msg(
                `❌ 格式错误: ${name}，应包含类型和数字ID`
            );

            return;
        }


        const idStr =
            parts[
            parts.length - 1
            ];


        const id =
            parseInt(
                idStr,
                10
            );


        if (
            isNaN(id) ||
            id <= 0
        ) {

            Instance.Msg(
                `❌ 无效的 ID: ${idStr}，应为正整数`
            );

            return;
        }


        let typeRaw =
            parts
                .slice(0, -1)
                .join('_')
                .toLowerCase();


        typeRaw =
            typeRaw.replace(
                /_+$/,
                ''
            );


        const type =
            typeRaw.split('_')[0];


        const config =
            TYPE_CONFIG_MAP[type];


        if (!config) {

            Instance.Msg(
                `❌ 未知的NPC类型: ${type}（完整名称: ${name}）`
            );

            return;
        }


        // ====================================================
        // Thrower
        // ====================================================

        if (
            type === "thrower"
        ) {

            const bodyName =
                config.baseBodyName +
                "_" +
                id;


            const body =
                Instance.FindEntityByName(
                    bodyName
                );


            if (
                !body ||
                !body.IsValid()
            ) {

                Instance.Msg(
                    `⚠️ [Thrower] 未找到主体实体: ${bodyName}`
                );

                return;
            }


            const success =
                registerThrowerNPC(
                    body,
                    id
                );


            if (success) {

                Instance.Msg(
                    `✅ NPC thrower_${id} 注册成功`
                );

            } else {

                Instance.Msg(
                    `❌ NPC thrower_${id} 注册失败`
                );
            }


            return;
        }


        // ====================================================
        // 普通 NPC
        // ====================================================

        const bodyName =
            config.baseBodyName +
            "_" +
            id;


        const body =
            Instance.FindEntityByName(
                bodyName
            );


        if (
            !body ||
            !body.IsValid()
        ) {

            Instance.Msg(
                `⚠️ 未找到主体实体: ${bodyName}`
            );

            return;
        }


        const success =
            registerNPC(
                body,
                config
            );


        if (success) {

            Instance.Msg(
                `✅ NPC ${type}_${id} 注册成功`
            );

        } else {

            Instance.Msg(
                `❌ NPC ${type}_${id} 注册失败`
            );
        }
    }
);


// ============================================================
// 备用手动注册
// ============================================================

Instance.OnScriptInput(
    "input_init_npc",
    () => {

        let foundAny = false;


        const configs = [
            NPC_CONFIG_LIGHT,
            NPC_CONFIG_MEDIUM,
            NPC_CONFIG_HEAVY
        ];


        for (
            const config
            of configs
        ) {

            let body =
                Instance.FindEntityByName(
                    config.baseBodyName
                );


            if (
                body &&
                body.IsValid()
            ) {

                if (
                    registerNPC(
                        body,
                        config
                    )
                ) {

                    foundAny = true;
                }
            }
        }


        if (!foundAny) {

            Instance.Msg(
                "ℹ️ 未发现任何基础 NPC 主体（不带后缀）"
            );

        } else {

            Instance.Msg(
                "✅ 基础 NPC 注册完成（无后缀）"
            );
        }
    }
);


// ============================================================
// 🐉 Boss 系统
// ============================================================

const BOSS_MAX_FORWARD_THRUST = 900;
const BOSS_MAX_SIDE_THRUST = 400;
const BOSS_ACCELERATION_STEP = 15;
const BOSS_BRAKE_FORCE = 80;
const BOSS_BRAKE_DURATION = 3;
const BOSS_MIN_SIDE_THRUST = 100;

let bossData = null;

function getAliveCTCount() {
    let count = 0;
    const players = Instance.FindEntitiesByClass("player");
    for (const p of players) { if (p?.IsValid() && p.IsAlive() && p.GetTeamNumber() == 3) count++; }
    return count;
}
function deactivateAllThrusters() {
    if (!bossData) return;
    const { thrust_forward, thrust_left, thrust_right } = bossData;
    Instance.EntFireAtTarget({ target: thrust_forward, input: "Deactivate" });
    Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
    Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
}

function registerBossWithBody(body) {
    if (!body || !body.IsValid()) {
        Instance.Msg("❌ Boss 主体无效");
        return;
    }
    if (bossData) {
        if (bossData.interval) clearInterval(bossData.interval);
        bossData = null;
    }

    const bodyName = getEntityName(body);
    let suffix = "";
    const match = bodyName.match(/_(\d+)$/);
    if (match) suffix = "_" + match[1];

    let healthBox = Instance.FindEntityByName("boss_physbox" + suffix);
    if (!healthBox) healthBox = Instance.FindEntityByName("boss_physbox");
    if (!healthBox || !healthBox.IsValid()) {
        Instance.Msg(`⚠️ 未找到对应的 boss_physbox${suffix}`);
        return;
    }

    let thrust_forward = Instance.FindEntityByName("boss_thrust_forward" + suffix);
    let thrust_left = Instance.FindEntityByName("boss_thrust_left" + suffix);
    let thrust_right = Instance.FindEntityByName("boss_thrust_right" + suffix);
    if (!thrust_forward || !thrust_left || !thrust_right) {
        thrust_forward = Instance.FindEntityByName("boss_thrust_forward");
        thrust_left = Instance.FindEntityByName("boss_thrust_left");
        thrust_right = Instance.FindEntityByName("boss_thrust_right");
    }
    if (!thrust_forward || !thrust_left || !thrust_right) {
        Instance.Msg("⚠️ Boss 推力器缺失");
        return;
    }

    Instance.EntFireAtTarget({ target: thrust_forward, input: "Activate" });
    Instance.EntFireAtTarget({ target: thrust_left, input: "Activate" });
    Instance.EntFireAtTarget({ target: thrust_right, input: "Activate" });
    Instance.EntFireAtTarget({ target: thrust_forward, input: "Deactivate" });
    Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
    Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
    Instance.EntFireAtTarget({ target: body, input: "Wake" });

    const playerCount = getAliveCTCount();
    const BASE_HEALTH = 30000;
    const HEALTH_PER_PLAYER = 3000;
    const totalHealth = BASE_HEALTH + playerCount * HEALTH_PER_PLAYER;
    Instance.EntFireAtTarget({ target: healthBox, input: "sethealth", value: totalHealth });

    bossData = {
        body, healthBox, thrust_forward, thrust_left, thrust_right,
        currentTarget: null,
        hateTimer: 0,
        hateSwitchInterval: 7,
        baseHealth: BASE_HEALTH,
        healthPerPlayer: HEALTH_PER_PLAYER,
        maxHealth: totalHealth,
        currentHealth: totalHealth,
        isActive: true,
        lastPosition: body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0),
        stuckCounter: 0,
        interval: null,
    };
    if (bossData.interval) clearInterval(bossData.interval);
    bossData.interval = setInterval(() => bossAI(), 40);
    Instance.Msg(`✅ Boss 已注册，主体: ${bodyName}，受击盒: ${getEntityName(healthBox)}，初始血量 = ${totalHealth}（当前 CT：${playerCount} 人）`);
}

function bossAI() {
    if (!bossData || !bossData.isActive) return;
    const { body, thrust_forward, thrust_left, thrust_right } = bossData;
    if (!body?.IsValid() || !thrust_forward?.IsValid() || !thrust_left?.IsValid() || !thrust_right?.IsValid()) {
        clearInterval(bossData.interval);
        bossData = null;
        Instance.Msg("🛑 Boss 实体已失效，终止 AI");
        return;
    }

    const players = Instance.FindEntitiesByClass("player");
    const cts = [];
    for (const p of players) { if (p?.IsValid() && p.IsAlive() && p.GetTeamNumber() === 3) cts.push(p); }
    if (cts.length === 0) { deactivateAllThrusters(); return; }

    bossData.hateTimer += 0.04;
    if (bossData.hateTimer >= bossData.hateSwitchInterval) {
        bossData.hateTimer = 0;
        let candidates = cts.filter(p => p !== bossData.currentTarget);
        if (candidates.length > 0) {
            const bodyPos = body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0);
            let nearest = null, minDist = Infinity;
            for (const p of candidates) {
                const d = Vector3Utils.distance(bodyPos, p.GetAbsOrigin ? p.GetAbsOrigin() : new Vec3(0, 0, 0));
                if (d < minDist) { minDist = d; nearest = p; }
            }
            bossData.currentTarget = nearest;
        }
    } else {
        if (bossData.currentTarget) {
            if (!bossData.currentTarget.IsValid() || !bossData.currentTarget.IsAlive() || bossData.currentTarget.GetTeamNumber() !== 3) {
                bossData.currentTarget = cts.length > 0 ? cts[0] : null;
                bossData.hateTimer = 0;
            }
        } else {
            bossData.currentTarget = cts.length > 0 ? cts[0] : null;
            bossData.hateTimer = 0;
        }
    }
    if (!bossData.currentTarget) { deactivateAllThrusters(); return; }

    let currentForwardThrust = 100;
    let sideActive = false;
    let smoothAngle = 0;
    let brakeActive = false;
    let brakeFrames = 0;
    let lastTurnDirection = 0;

    let currentPos = body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0);
    let displacement = Vector3Utils.distance(currentPos, bossData.lastPosition);
    if (displacement < NPC_STUCK_THRESHOLD) bossData.stuckCounter++; else bossData.stuckCounter = 0;
    bossData.lastPosition = currentPos;

    if (bossData.stuckCounter > NPC_STUCK_FRAME_LIMIT) {
        let bodyPos = body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0);
        let targetPos = bossData.currentTarget.GetAbsOrigin ? bossData.currentTarget.GetAbsOrigin() : new Vec3(0, 0, 0);
        let dirToTarget = Vector3Utils.subtract(targetPos, bodyPos);
        let horizontalDir = new Vec3(dirToTarget.x, dirToTarget.y, 0);
        if (horizontalDir.length > 0.1) {
            let targetAng = Vector3Utils.vectorAngles(horizontalDir);
            body.Teleport(null, targetAng, null);
        }
        bossData.stuckCounter = 0;
        bossData.lastPosition = body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0);
    }

    let targetPos = bossData.currentTarget.GetAbsOrigin ? bossData.currentTarget.GetAbsOrigin() : new Vec3(0, 0, 0);
    let targetVel = bossData.currentTarget.GetVelocity ? bossData.currentTarget.GetVelocity() : new Vec3(0, 0, 0);
    if (targetVel) {
        let predictedPos = Vector3Utils.add(targetPos, Vector3Utils.scale(targetVel, NPC_PREDICT_TIME));
        let delta = Vector3Utils.subtract(predictedPos, body.GetAbsOrigin());
        if (delta.length > NPC_AGGRO_RANGE * 1.2) predictedPos = targetPos;
        targetPos = predictedPos;
    }

    let body_forward = getForwardVector(body.GetAbsAngles());
    let rawAngle = GetDirectionToTarget(body.GetAbsOrigin(), targetPos, body_forward);
    smoothAngle = smoothAngle * NPC_SMOOTH_FACTOR + rawAngle * (1 - NPC_SMOOTH_FACTOR);

    let angleAbs = Math.abs(smoothAngle);
    let speedFactor = MathUtils.clamp(1 - (angleAbs / 90) * 0.75, 0.25, 1.0);
    const distToTarget = Vector3Utils.distance(body.GetAbsOrigin(), targetPos);
    if (distToTarget < 300) speedFactor *= MathUtils.clamp(distToTarget / 300, 0.2, 1.0);
    let targetForward = Math.max(90, BOSS_MAX_FORWARD_THRUST * speedFactor);

    if (currentForwardThrust < targetForward) currentForwardThrust = Math.min(currentForwardThrust + BOSS_ACCELERATION_STEP * 2, targetForward);
    else if (currentForwardThrust > targetForward) currentForwardThrust = Math.max(targetForward, currentForwardThrust - BOSS_ACCELERATION_STEP * 4);
    currentForwardThrust = MathUtils.clamp(currentForwardThrust, 30, BOSS_MAX_FORWARD_THRUST);

    Instance.EntFireAtTarget({ target: thrust_forward, input: "KeyValues", value: "Force " + currentForwardThrust + " 0 0" });
    Instance.EntFireAtTarget({ target: thrust_forward, input: "Activate" });

    let speed = Vector3Utils.length(body.GetVelocity ? body.GetVelocity() : new Vec3(0, 0, 0));
    let sidePower = BOSS_MAX_SIDE_THRUST;
    if (angleAbs < 20) sidePower = BOSS_MAX_SIDE_THRUST * (0.2 + 0.8 * (angleAbs / 20));
    sidePower = Math.max(BOSS_MIN_SIDE_THRUST, sidePower);

    if (smoothAngle > NPC_ANGLE_THRESHOLD) {
        Instance.EntFireAtTarget({ target: thrust_right, input: "KeyValues", value: "Force " + sidePower + " 0 0" });
        Instance.EntFireAtTarget({ target: thrust_right, input: "Activate" });
        Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
        sideActive = true; lastTurnDirection = 1; brakeActive = false;
    } else if (smoothAngle < -NPC_ANGLE_THRESHOLD) {
        Instance.EntFireAtTarget({ target: thrust_left, input: "KeyValues", value: "Force " + sidePower + " 0 0" });
        Instance.EntFireAtTarget({ target: thrust_left, input: "Activate" });
        Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
        sideActive = true; lastTurnDirection = -1; brakeActive = false;
    } else {
        if (speed > 80) {
            if (lastTurnDirection !== 0) {
                if (!brakeActive) { brakeActive = true; brakeFrames = BOSS_BRAKE_DURATION; }
                if (brakeFrames > 0) {
                    let brakePower = BOSS_BRAKE_FORCE * (currentForwardThrust / BOSS_MAX_FORWARD_THRUST);
                    if (lastTurnDirection === 1) {
                        Instance.EntFireAtTarget({ target: thrust_left, input: "KeyValues", value: "Force " + brakePower + " 0 0" });
                        Instance.EntFireAtTarget({ target: thrust_left, input: "Activate" });
                        Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
                    } else {
                        Instance.EntFireAtTarget({ target: thrust_right, input: "KeyValues", value: "Force " + brakePower + " 0 0" });
                        Instance.EntFireAtTarget({ target: thrust_right, input: "Activate" });
                        Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
                    }
                    sideActive = true; brakeFrames--;
                } else {
                    Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
                    Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
                    sideActive = false; brakeActive = false; lastTurnDirection = 0;
                }
            } else {
                if (sideActive) {
                    Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
                    Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
                    sideActive = false;
                }
            }
        } else {
            if (!sideActive && angleAbs > 2) {
                let smallPower = Math.max(BOSS_MIN_SIDE_THRUST, sidePower * 0.3);
                if (smoothAngle > 0) {
                    Instance.EntFireAtTarget({ target: thrust_right, input: "KeyValues", value: "Force " + smallPower + " 0 0" });
                    Instance.EntFireAtTarget({ target: thrust_right, input: "Activate" });
                    Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
                } else {
                    Instance.EntFireAtTarget({ target: thrust_left, input: "KeyValues", value: "Force " + smallPower + " 0 0" });
                    Instance.EntFireAtTarget({ target: thrust_left, input: "Activate" });
                    Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
                }
                sideActive = true; brakeActive = false; lastTurnDirection = 0;
            } else if (sideActive && angleAbs < 1) {
                Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
                Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
                sideActive = false;
            }
        }
    }
    if (distToTarget < 20) {
        Instance.EntFireAtTarget({ target: thrust_forward, input: "Deactivate" });
        Instance.EntFireAtTarget({ target: thrust_left, input: "Deactivate" });
        Instance.EntFireAtTarget({ target: thrust_right, input: "Deactivate" });
        bossData.stuckCounter = 0;
        bossData.lastPosition = body.GetAbsOrigin ? body.GetAbsOrigin() : new Vec3(0, 0, 0);
    }
}

// ---------- Boss 注册入口 ----------
Instance.OnScriptInput("input_register_boss", (stuff) => {
    const caller = stuff.caller;
    if (!caller || !caller.IsValid()) {
        Instance.Msg("❌ input_register_boss: 没有有效的 caller（请确保由 logic_relay 触发）");
        return;
    }
    const name = caller.GetEntityName ? caller.GetEntityName() : '';
    if (!name) {
        Instance.Msg("❌ caller 没有 targetname");
        return;
    }

    const prefix = "boss_register";
    if (!name.startsWith(prefix)) {
        Instance.Msg(`❌ 无效的 caller targetname: ${name}，应以 "boss_register" 开头`);
        return;
    }

    let id = "";
    const rest = name.substring(prefix.length);
    const match = rest.match(/^_(\d+)$/);
    if (match) {
        const num = parseInt(match[1], 10);
        if (num > 0) id = "_" + num;
        else {
            Instance.Msg(`❌ 无效的 Boss ID: ${match[1]}，应为正整数`);
            return;
        }
    } else if (rest.length > 0) {
        Instance.Msg(`❌ 格式错误: ${name}，应为 boss_register 或 boss_register_<ID>`);
        return;
    }

    const bodyName = "boss_body" + id;
    const body = Instance.FindEntityByName(bodyName);
    if (!body || !body.IsValid()) {
        Instance.Msg(`⚠️ 未找到 Boss 主体: ${bodyName}`);
        return;
    }
    registerBossWithBody(body);
});

// ---------- 手动注册 Boss ----------
Instance.OnScriptInput("input_register_boss_manual", () => {
    let body = Instance.FindEntityByName("boss_body");
    if (!body || !body.IsValid()) {
        for (let i = 0; i <= 10; i++) {
            const candidate = Instance.FindEntityByName("boss_body_" + i);
            if (candidate) { body = candidate; break; }
        }
    }
    if (body && body.IsValid()) registerBossWithBody(body);
    else Instance.Msg("⚠️ 未找到任何 boss_body");
});

