    Instance.OnScriptInput("boss_SpawnBeams5True", () => {
        spawnBeams(5, true);
    });
    Instance.OnScriptInput("boss_SpawnColumns15", () => {
        spawnColumns(15);
    });
    Instance.OnScriptInput("boss_SpawnBombs8", () => {
        spawnBombs(8);
    });
    Instance.OnScriptInput("boss_SpawnColumns20", () => {
        spawnColumns(20);
    });
    Instance.OnScriptInput("boss_SpawnBeams8False", () => {
        spawnBeams(8, false);
    });
    Instance.OnScriptInput("boss_SpawnColumns12", () => {
        spawnColumns(12);
    });
    Instance.OnScriptInput("boss_SpawnRods40", () => {
        spawnRods(40);
    });
    Instance.OnScriptInput("boss_SpawnBombs10", () => {
        spawnBombs(10);
    });
    Instance.OnScriptInput("boss_SpawnBeams15False", () => {
        spawnBeams(15, false);
    });
    Instance.OnScriptInput("boss_SpawnColumns8", () => {
        spawnColumns(8);
    });
    Instance.OnScriptInput("boss_SpawnRods120", () => {
        spawnRods(120);
    });
    Instance.OnScriptInput("boss_SpawnColumns6", () => {
        spawnColumns(6);
    });
    Instance.OnScriptInput("boss_SpawnColumns3", () => {
        spawnColumns(3);
    });
    Instance.OnScriptInput("boss_SpawnBeams7True", () => {
        spawnBeams(7, true);
    });
    Instance.OnScriptInput("boss_SpawnBombs5", () => {
        spawnBombs(5);
    });
    Instance.OnScriptInput("boss_SpawnRods10", () => {
        spawnRods(10);
    });
    Instance.OnScriptInput("boss_SpawnBombs30", () => {
        spawnBombs(30);
    });
    Instance.OnScriptInput("boss_SpawnBeams8", () => {
        spawnBeams(8);
    });
    Instance.OnScriptInput("boss_SpawnBomb", (data) => {
        const activator = data.activator;
        if (activator.GetTeamNumber() != Team.T) {
            return;
        }
        const bomb_template = Entities.FindByName("templ_bomb")[0];
        let pos = activator.GetAbsOrigin();
        pos.z = _z - 480;
        const angle = { pitch: 0, yaw: 0, roll: 0 };
        bomb_template.ForceSpawn(pos, angle);
    });
    function spawnBombs(n) {
        const bomb_template = Entities.FindByName("templ_bomb")[0];
        for (let i = 0; i < n; i++) {
            const ang = getRandomInt(0, 360);
            const r = getRandomFloat(0, 7.8);
            const pos = new Vec3(_x + Math.cos(degreesToRadians(ang)) * 128 * r, _y + Math.sin(degreesToRadians(ang)) * 128 * r, _z - 480);
            bomb_template.FireInput({ input: "KeyValue", value: "origin " + pos.x + " " + pos.y + " " + pos.z, delay: Math.sqrt(i) });
            bomb_template.FireInput({ input: "ForceSpawn", delay: Math.sqrt(i) + 0.02 });
        }
    }
    function spawnRods(n) {
        const templ = Entities.FindByName("templ_boss_rod")[0];
        for (let i = 0; i < n; i++) {
            const ang = getRandomInt(0, 360);
            const r = getRandomInt(1, 8);
            const pos = new Vec3(_x + Math.cos(degreesToRadians(ang)) * (64 + 128 * r), _y + Math.sin(degreesToRadians(ang)) * (64 + 128 * r), _z - 432);
            templ.FireInput({ input: "KeyValue", value: "origin " + pos.x + " " + pos.y + " " + pos.z, delay: Math.sqrt(i) + 1 });
            templ.FireInput({ input: "KeyValue", value: "angles " + 0 + " " + ang + " " + 0, delay: Math.sqrt(i) + 1 });
            templ.FireInput({ input: "ForceSpawn", delay: Math.sqrt(i) + 1.05 });
        }
    }
    function spawnColumns(n) {
        let i = 0;
        while (n > 1) {
            const dir = getRandomInt(0, 3);
            let maker;
            let maker_pos;
            switch (dir) {
                case 0:
                    maker = Entities.FindByName("column_maker0")[0];
                    maker_pos = maker.GetAbsOrigin();
                    maker_pos.y = _y + getRandomFloat(-1024, 1024);
                    break;
                case 1:
                    maker = Entities.FindByName("column_maker1")[0];
                    maker_pos = maker.GetAbsOrigin();
                    maker_pos.x = _x + getRandomFloat(-1024, 1024);
                    break;
                case 2:
                    maker = Entities.FindByName("column_maker2")[0];
                    maker_pos = maker.GetAbsOrigin();
                    maker_pos.y = _y + getRandomFloat(-1024, 1024);
                    break;
                case 3:
                    maker = Entities.FindByName("column_maker3")[0];
                    maker_pos = maker.GetAbsOrigin();
                    maker_pos.x = _x + getRandomFloat(-1024, 1024);
                    break;
            }
            maker.FireInput({ input: "KeyValue", value: "origin " + maker_pos.x + " " + maker_pos.y + " " + maker_pos.z, delay: Math.sqrt(i) * 2 + 1 });
            maker.FireInput({ input: "ForceSpawn", delay: Math.sqrt(i) * 2 + 1.05 });
            i++;
            n--;
        }
    }
    function spawnBeams(n, mix = true) {
        let i = 0;
        while (n > 1) {
            const num = getRandomInt(0, 3);
            let z;
            if (mix && num === 1) {
                z = _z - 420;
            }
            else {
                z = _z - 480;
            }
            const dir = getRandomInt(0, 3);
            let maker;
            let maker_pos;
            switch (dir) {
                case 0:
                    maker = Entities.FindByName("beam_maker_0")[0];
                    maker_pos = maker.GetAbsOrigin();
                    break;
                case 1:
                    maker = Entities.FindByName("beam_maker_1")[0];
                    maker_pos = maker.GetAbsOrigin();
                    break;
                case 2:
                    maker = Entities.FindByName("beam_maker_2")[0];
                    maker_pos = maker.GetAbsOrigin();
                    break;
                case 3:
                    maker = Entities.FindByName("beam_maker_3")[0];
                    maker_pos = maker.GetAbsOrigin();
                    break;
            }
            maker_pos.z = z;
            maker.FireInput({ input: "KeyValue", value: "origin " + maker_pos.x + " " + maker_pos.y + " " + maker_pos.z, delay: Math.sqrt(i) * 3 + 1 });
            maker.FireInput({ input: "ForceSpawn", delay: Math.sqrt(i) * 3 + 1.05 });
            i++;
            n--;
        }
    }
    Instance.OnScriptInput("boss_SpawnTunnel", () => {
        let n = 15;
        let x = 0;
        let y = 0;
        const speed = 300;
        const templ = Entities.FindByName("templ_boss_tunnel")[0];
        while (n > 1) {
            if (x === 0) {
                x = _x;
                y = _y;
            }
            else {
                x += 90 * getRandomInt(-1, 1);
                y += 90 * getRandomInt(-1, 1);
            }
            templ.FireInput({ input: "KeyValue", value: "origin " + x + " " + y + " " + (_z + 1900), delay: (n) * 128.0 / speed * 3 });
            templ.FireInput({ input: "ForceSpawn", delay: (n) * 128.0 / speed * 3 + 0.05 });
            n--;
        }
    });
    function degreesToRadians(degrees) {
        return (degrees * Math.PI) / 180;
    }
    function getRandomFloat(min, max) {
        return Math.random() * (max - min) + min;
    }
    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }
})();
// bouncebox.js
(() => {
    Instance.OnScriptInput("bouncebox_spawnGoo", (context) => {
        const player = context.activator;
        if (player.GetTeamNumber() != Team.T)
            return;
        const temp = Entities.FindByName("bouncebox_goo_templ")[0];
        let pos = player.GetAbsOrigin();
        pos.z = -4607;
        temp.ForceSpawn(pos, new Euler(0, getRandomInt(0, 360), 0));
    });
    const min_x = -992;
    const max_x = -32;
    const min_y = -6112;
    const max_y = -5152;
    const z = -4592;
    const max_bounces = 5;
    let boxes = [];
    let bouncebox = false;
    let sounds = [];
    Instance.OnScriptInput("bouncebox_Start", () => {
        const temp = Entities.FindByName("bouncebox_templ")[0];
        const pos = new Vec3(max_x - 1, getRandomInt(min_y, max_y), z);
        const angle = new Euler(0, getRandomInt(0, 3) * 90, 0);
        temp.ForceSpawn(pos, angle);
    });
    Instance.OnScriptInput("bouncebox_SetInitVelocity", (context) => {
        const box = context.caller;
        box.bounces = 0;
        box.accel = 1.5;
        box.velocity = new Vec3(getRandomFloat(-45, -40), Math.random() > 0.5 ? getRandomFloat(-45, -40) : getRandomFloat(40, 45), 0);
        boxes.push(box);
        bouncebox = true;
    });
    Instance.OnScriptInput("bouncebox_StopBounceBox", () => {
        bouncebox = false;
        for (const box of boxes) {
            box.Remove();
        }
    });
    Instance.SetThink(() => {
        if (bouncebox) {
            for (const box of boxes) {
                if (box.IsValid()) {
                    const box_pos = box.GetAbsOrigin();
                    if (box.bounces > max_bounces) {
                        box.accel = 1;
                    }
                    if (box_pos.x <= min_x || box_pos.x >= max_x) {
                        box.velocity.x = -box.velocity.x * box.accel;
                        box.velocity.y *= box.accel;
                        box.bounces++;
                        playRandomSound();
                    }
                    if (box_pos.y <= min_y || box_pos.y >= max_y) {
                        box.velocity.x *= box.accel;
                        box.velocity.y = -box.velocity.y * box.accel;
                        box.bounces++;
                        playRandomSound();
                    }
                    box.Teleport({ velocity: box.velocity });
                }
            }
        }
        Instance.SetNextThink(Instance.GetGameTime());
    });
    Instance.SetNextThink(Instance.GetGameTime());
    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }
    function getRandomFloat(min, max) {
        return Math.random() * (max - min) + min;
    }
    function playRandomSound() {
        const i = getRandomInt(0, sounds.length - 1);
        sounds[i].FireInput({ input: "StartSound" });
    }
    onRoundStart(() => {
        boxes = [];
        bouncebox = false;
        sounds = Entities.FindByName("grunt_sound");
    });
})();
// crumble.js
(() => {
    const side = 10;
    const x = -10560;
    const y = -1856;
    const z = -8224;
    const h = 64;
    const l = 256;
    let plats = [];
    let plats_left = 0;
    let crumble = false;
    Instance.OnScriptInput("crumble_SpawnPlatform", () => {
        const templ = Entities.FindByName("templ_platform")[0];
        for (let i = 0; i < side; i++) {
            plats[i] = [];
            for (let j = 0; j < side; j++) {
                if (Vector3Utils.distance(new Vec3(i, j, 0), new Vec3(4.5, 4.5, 0)) > 7)
                    continue;
                const pos = new Vec3(x + i * l, y + j * l, z + h / 2);
                const plat = templ.ForceSpawn(pos, new Euler(0, 0, 0));
                plats[i][j] = plat[0];
                plats_left++;
            }
        }
        Entities.FireInput({ name: "script", input: "RunScriptInput", value: "crumble_Crumble", delay: 5 });
        crumble = true;
    });
    Instance.OnScriptInput("crumble_BackIn", () => {
        if (plats_left > 36) {
            Entities.FireInput({ name: "hudhint", input: "SetMessage", value: plats_left-- - 36 + " platforms left to win" });
            Entities.FireInput({ name: "show_hud", input: "CountPlayersInZone", delay: 0.02 });
        }
    });
    let delay = 1.5;
    let rate = 1.7;
    Instance.OnScriptInput("crumble_Crumble", () => {
        if (!crumble)
            return;
        if (plats_left <= 80)
            rate = 1.4;
        if (plats_left <= 65)
            delay = 1.2;
        if (plats_left <= 55) {
            rate = 0.5;
            delay = 1.0;
        }
        if (plats_left === 51) {
            Console.ServerCommand("say * * * 15 platforms more to win! * * *");
        }
        if (plats_left <= 36) {
            delay = 1.5;
            rate = 1.7;
            plats_left = 0;
            Entities.FireInput({ name: "main_teleport_*", input: "Disable" });
            Entities.FireInput({ name: "cr_teleport", input: "Enable", delay: 0.5 });
            Entities.FireInput({ name: "cr_music", input: "StopSound", delay: 10 });
            Entities.FireInput({ name: "vote_relay", input: "Trigger" });
            Entities.FireInput({ name: "cr_platform*", input: "Kill", delay: 10 });
            Entities.FireInput({ name: "hide_hud", input: "CountPlayersInZone" });
            return;
        }
        let cell = undefined;
        while (cell == undefined) {
            const i = getRandomInt(0, side - 1);
            const j = getRandomInt(0, side - 1);
            cell = plats[i][j];
            if (cell != undefined && cell.IsValid()) {
                cell.FireInput({ input: "Color", value: "255 0 0" });
                cell.FireInput({ input: "Break", delay: delay });
                Entities.FireInput({ name: "script", input: "RunScriptInput", value: "crumble_Crumble", delay: rate });
            }
            else {
                cell = undefined;
            }
            plats[i][j] = undefined;
        }
    });
    onRoundStart(() => {
        delay = 1.5;
        rate = 1.7;
        crumble = false;
        plats_left = 0;
        Entities.FireInput({ name: "hide_hud", input: "CountPlayersInZone" });
    });
    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }
})();
// explosion.js
(() => {
    const max_vertical_velocity = 500;
    const max_horizontal_velocity = 700;
    const vertical_boost = 1.6;
    const max_range = 200;
    Instance.OnScriptInput("explosion_Explode", (data) => {
        const player = data.activator;
        const trigger = data.caller;
        const player_origin = new Vec3(player.GetAbsOrigin());
        const trigger_origin = new Vec3(trigger.GetAbsOrigin());
        const distance = Vector3Utils.distance(player_origin, trigger_origin);
        if (distance > max_range) {
            return;
        }
        const player_vel = new Vec3(player.GetAbsVelocity());
        const dir = trigger_origin.directionTowards(player_origin);
        const mag = Math.sqrt(distance) / 5000;
        // add grenade push to current velocity and boost z component
        let speed = player_vel.add(new Vec3(dir.x / mag, dir.y / mag, dir.z / mag * vertical_boost));
        // clamp horizontal velocity according to max_horizontal_velocity
        if (speed.length2DSquared > Math.pow(max_horizontal_velocity, 2)) {
            const norm = Math.sqrt(Math.pow(speed.x, 2) + Math.pow(speed.y, 2));
            speed.x = speed.x * max_horizontal_velocity / norm;
            speed.y = speed.y * max_horizontal_velocity / norm;
        }
        // applying the minimum vertical velocity to lift the player from the ground (about 250 units/s)
        if (speed.z < 250) {
            speed.z = 350;
        }
        //clamp z velocity to max_vertical_velocity
        if (speed.z > max_vertical_velocity) {
            speed.z = max_vertical_velocity;
        }
        if (speed.z < -1 * max_vertical_velocity) {
            speed.z = -1 * max_vertical_velocity;
        }
        player.Teleport({ velocity: speed });
    });
    Instance.OnScriptInput("explosion_Spawn", (data) => {
        const template = Entities.FindByName("templ_bomb")[0];
        let activator_origin = data.activator.GetAbsOrigin();
        activator_origin.z += 0;
        template.ForceSpawn(data.activator.GetAbsOrigin(), new Euler(0, 0, 0));
    });
})();
// hp_manager.js
(() => {
    Instance.OnScriptInput("hp_manager_InitHealth", (data) => {
        const player = data.activator;
        if (player.IsValid() && player.GetTeamNumber() === Team.CT && player.GetHealth() > 0) {
            player.SetHealth(140);
            player.SetMaxHealth(140);
            player.SetArmor(100);
        }
    });
    Instance.OnScriptInput("hp_manager_SetMaxHP", (data) => {
        const player = data.activator;
        if (player.IsValid() && player.GetTeamNumber() === Team.CT && player.GetHealth() > 0) {
            player.SetMaxHealth(player.GetHealth());
        }
    });
    Instance.OnScriptInput("hp_manager_Punish", () => {
        const players = Entities.FindByClass("player");
        for (const player of players) {
            if (player.IsValid() && player.GetTeamNumber() === Team.CT && player.GetHealth() > 0) {
                let health = player.GetHealth();
                health = health * 0.8;
                if (health < 1) {
                    health = 1;
                }
                player.SetHealth(health + 1);
                player.SetMaxHealth(health);
                Entities.FireInput({ name: "dummy_hurt", input: "Hurt", activator: player, delay: 0.1 });
            }
        }
    });
    Instance.OnScriptInput("hp_manager_PunishActivator", (data) => {
        const player = data.activator;
        if (player.IsValid() && player.GetTeamNumber() === Team.CT && player.GetHealth() > 0) {
            let health = player.GetHealth();
            health = health * 0.8;
            if (health < 1) {
                health = 1;
            }
            player.SetHealth(health + 1);
            player.SetMaxHealth(health);
            Entities.FireInput({ name: "dummy_hurt", input: "Hurt", activator: player, delay: 0.1 });
        }
    });
    Instance.OnScriptInput("hp_manager_BossHealth", (data) => {
        const player = data.activator;
        if (player.IsValid() && player.GetTeamNumber() === Team.CT && player.GetHealth() > 0) {
            let health = player.GetHealth();
            health = health * 3;
            player.SetHealth(health);
            player.SetMaxHealth(health);
        }
    });
    Instance.OnModifyPlayerDamage((event) => {
        if (event.damageTypes === CSDamageTypes.FALL) {
            return { abort: true };
        }
    });
})();
// hudhint.js
(() => {
    let t = 0;
    let mode = "vote";
    Instance.OnScriptInput("hudhint_BackIn28", () => {
        backIn(28);
    });
    Instance.OnScriptInput("hudhint_BackIn20", () => {
        backIn(20);
    });
    Instance.OnScriptInput("hudhint_BackIn21", () => {
        backIn(21);
    });
    Instance.OnScriptInput("hudhint_BackIn30", () => {
        backIn(30);
    });
    Instance.OnScriptInput("hudhint_BackIn60", () => {
        backIn(60);
    });
    Instance.OnScriptInput("hudhint_BackIn70", () => {
        backIn(70);
    });
    Instance.OnScriptInput("hudhint_VoteEndsIn", () => {
        vote(25);
    });
    Instance.OnScriptInput("hudhint_TimeToWin", () => {
        timeToWin(145);
    });
    function backIn(n) {
        mode = "back";
        t = n;
        Entities.FireInput({ name: "script", input: "RunScriptInput", value: "hudhint_ShowTime" });
    }
    function vote(n) {
        mode = "vote";
        t = n;
        Entities.FireInput({ name: "script", input: "RunScriptInput", value: "hudhint_ShowTime" });
    }
    function timeToWin(n) {
        mode = "win";
        t = n;
        Entities.FireInput({ name: "script", input: "RunScriptInput", value: "hudhint_ShowTime" });
    }
    Instance.OnScriptInput("hudhint_ShowTime", () => {
        if (t < 1) {
            Entities.FireInput({ name: "hide_hud", input: "CountPlayersInZone" });
            return;
        }
        switch (mode) {
            case "back":
                Entities.FireInput({ name: "hudhint", input: "SetMessage", value: "Returning to spawn in " + t-- + " s" });
                break;
            case "vote":
                Entities.FireInput({ name: "hudhint", input: "SetMessage", value: "Vote ends in " + t-- + " seconds!" });
                break;
            case "win":
                Entities.FireInput({ name: "hudhint", input: "SetMessage", value: t-- + " seconds to win" });
                break;
        }
        Entities.FireInput({ name: "show_hud", input: "CountPlayersInZone", delay: 0.02 });
        Entities.FireInput({ name: "script", input: "RunScriptInput", value: "hudhint_ShowTime", delay: 1 });
    });
    Instance.OnScriptInput("hudhint_ShowHelp0", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 Press E to spawn a BOMB directly below you.");
    });
    Instance.OnScriptInput("hudhint_ShowHelp1", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 FIRE can HEAL you, but your max HP is REDUCED each time you fail to complete a map!.");
    });
    Instance.OnScriptInput("hudhint_ShowHelp2", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 BREAKABLE walls don't make any sound when hit, but they don't take long to break.");
    });
    Instance.OnScriptInput("hudhint_ShowHelp3", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 Keep an eye on the SKY!");
    });
    Instance.OnScriptInput("hudhint_ShowHelp4", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 The spooky SKULL from the ALTAR is REQUIRED to proceed in this level - Be sure to DEFEND EARLY!");
    });
    Instance.OnScriptInput("hudhint_ShowHelp5", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 Press E to spawn a BOMB directly below you - you can also use the SIDE RAMPS to get the humans on the way back!");
    });
    Instance.OnScriptInput("hudhint_ShowHelp6", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 Use your KNIFE on the platforms to CRUMBLE them.");
    });
    Instance.OnScriptInput("hudhint_ShowHelp7", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 The TOP path can be HARD to defend, consider admitting defeat and GOING to the LOWER BUNKER as a TEAM.");
    });
    Instance.OnScriptInput("hudhint_ShowHelp8", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 The TRAM only starts MOVING some seconds after someone REACHES the other side");
    });
    Instance.OnScriptInput("hudhint_ShowHelp9", () => {
        Console.ServerCommand("say \x02[\x07MOJOHINT\x02]\x05 Press E to spawn STICKY GOO directly below you.");
    });
    onRoundStart(() => {
        t = 0;
        Entities.FireInput({ name: "hide_hud", input: "CountPlayersInZone" });
    });
})();
