// votes.js
(() => {
    const mapnames = ["BOATLESS ESCAPE", "CURSED RITUAL", "VALLEY", "DEEP LEARNING"];
    const mgnames = ["CRUMBLE RUMBLE", "RAT MAZE", "SLIDE RACE", "BOUNCEBOX"];
    let mapnames_copy = [...mapnames];
    let mgnames_copy = [...mgnames];
    const x = [-5568, -5120, -4672];
    const y = -8840;
    const z = -2560;
    let stage = 0;
    let votes = [0, 0, 0];
    let ongoing_vote = false;
    let result_p = [0, 0, 0];
    Instance.OnScriptInput("votes_StartVote", () => {
        votes = [0, 0, 0];
        ongoing_vote = true;
        resetCharts();
        if (stage % 2 === 0) { // minigame
            if (stage === 6) {
                Entities.FireInput({ name: "end_relay", input: "Trigger", delay: 8 });
                Entities.FireInput({ name: "vote_relay", input: "CancelPending" });
                Entities.FireInput({ name: "worldtext*", input: "SetMessage", value: "" });
                return;
            }
            shuffleInPlace(mgnames_copy);
            for (let i = 0; i < 3; i++) {
                if (i < mgnames_copy.length) {
                    Entities.FireInput({ name: "worldtext" + (i + 1), input: "SetMessage", value: mgnames_copy[i] });
                    Entities.FireInput({ name: "main_vote_trigger_" + i, input: "Enable" });
                }
                else {
                    Entities.FireInput({ name: "worldtext" + (i + 1), input: "SetMessage", value: "" });
                    Entities.FireInput({ name: "main_vote_trigger_" + i, input: "Disable" });
                }
            }
            Console.ServerCommand("say * * * Choose the " + (stage === 0 ? "first" : "next") + " MINIGAME * * *");
        }
        else {
            shuffleInPlace(mapnames_copy);
            for (let i = 0; i < 3; i++) {
                if (i < mapnames_copy.length) {
                    Entities.FireInput({ name: "worldtext" + (i + 1), input: "SetMessage", value: mapnames_copy[i] });
                    Entities.FireInput({ name: "main_vote_trigger_" + i, input: "Enable" });
                }
                else {
                    Entities.FireInput({ name: "worldtext" + (i + 1), input: "SetMessage", value: "" });
                    Entities.FireInput({ name: "main_vote_trigger_" + i, input: "Disable" });
                }
            }
            Console.ServerCommand("say * * * Choose the " + (stage === 5 ? "LAST" : "next") + " MAP * * *");
        }
        Entities.FireInput({ name: "console", input: "Command", value: "say * * * STAND in your platform of choice by the time the countdown ENDS * * *", delay: 2 });
    });
    function shuffleInPlace(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]]; // swap
        }
        return arr;
    }
    Instance.OnScriptInput("votes_EndVote", () => {
        if (stage === 6)
            return;
        ongoing_vote = false;
        const votes_copy = [...votes];
        Entities.FireInput({ name: "main_vote_trigger_*", input: "Disable" });
        const total_votes = votes_copy.reduce((total, n) => total + n, 0);
        const win_index = indexOfMax(result_p);
        if (stage % 2 === 0) {
            Console.ServerCommand("say \x02[\x07MOJOVOTE\x02]\x05 " + mgnames_copy[win_index] + " won with " + votes_copy[win_index] + "/" + total_votes + " votes (" + result_p[win_index] + "%)");
            switch (mgnames_copy[win_index]) {
                case "CRUMBLE RUMBLE":
                    Entities.FireInput({ name: "cr_relay", input: "Trigger" });
                    break;
                case "RAT MAZE":
                    Entities.FireInput({ name: "maze_relay", input: "Trigger" });
                    break;
                case "SLIDE RACE":
                    Entities.FireInput({ name: "sr_relay", input: "Trigger" });
                    break;
                case "BOUNCEBOX":
                    Entities.FireInput({ name: "bouncebox_relay", input: "Trigger" });
                    break;
            }
            mgnames_copy.splice(win_index, 1);
        }
        else {
            Console.ServerCommand("say \x02[\x07MOJOVOTE\x02]\x05 " + mapnames_copy[win_index] + " won with " + votes_copy[win_index] + "/" + total_votes + " votes (" + result_p[win_index] + "%)");
            switch (mapnames_copy[win_index]) {
                case "BOATLESS ESCAPE":
                    Entities.FireInput({ name: "be_relay", input: "Trigger" });
                    break;
                case "CURSED RITUAL":
                    Entities.FireInput({ name: "mojo_relay", input: "Trigger" });
                    break;
                case "VALLEY":
                    Entities.FireInput({ name: "valley_relay", input: "Trigger" });
                    break;
                case "DEEP LEARNING":
                    Entities.FireInput({ name: "lava_relay", input: "Trigger" });
                    break;
            }
            mapnames_copy.splice(win_index, 1);
        }
        for (let i = 0; i < 3; i++) {
            Entities.FireInput({ name: "worldtext" + (i + 1), input: "SetMessage", value: "", delay: 5.05 });
            Entities.FireInput({ name: "main_chart_" + i + "_text", input: "SetMessage", value: "", delay: 5.05 });
        }
    });
    function indexOfMax(arr) {
        if (arr.length === 0)
            return -1;
        let maxIndex = 0;
        for (let i = 1; i < arr.length; i++) {
            if (arr[i] > arr[maxIndex]) {
                maxIndex = i;
            }
        }
        return maxIndex;
    }
    Instance.OnScriptInput("votes_IncrementStage", () => {
        stage++;
    });
    Instance.OnScriptInput("votes_AddVote1", () => {
        if (!ongoing_vote)
            return;
        votes[0]++;
        result_p = updateChart(votes);
    });
    Instance.OnScriptInput("votes_SubVote1", () => {
        if (!ongoing_vote)
            return;
        votes[0]--;
        result_p = updateChart(votes);
    });
    Instance.OnScriptInput("votes_AddVote2", () => {
        if (!ongoing_vote)
            return;
        votes[1]++;
        result_p = updateChart(votes);
    });
    Instance.OnScriptInput("votes_SubVote2", () => {
        if (!ongoing_vote)
            return;
        votes[1]--;
        result_p = updateChart(votes);
    });
    Instance.OnScriptInput("votes_AddVote3", () => {
        if (!ongoing_vote)
            return;
        votes[2]++;
        result_p = updateChart(votes);
    });
    Instance.OnScriptInput("votes_SubVote3", () => {
        if (!ongoing_vote)
            return;
        votes[2]--;
        result_p = updateChart(votes);
    });
    function updateChart(vote) {
        const vals = [...vote];
        const total = vals.reduce((s, v) => s + v, 0);
        if (total === 0)
            return [0, 0, 0];
        const raw = vals.map(v => (v / total) * 100);
        // Floor first so we only ever add back up to 100 (keeps rank intact)
        const EPS = 1e-9;
        const base = raw.map(v => Math.floor(v + EPS));
        let remainder = 100 - base.reduce((s, v) => s + v, 0);
        // Prepare indices 0..2; we’ll sort by raw desc, but randomize inside ties.
        const indices = [0, 1, 2];
        // Fisher–Yates shuffle for tie randomness
        const shuffle = (arr) => {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        };
        // Pair index with raw; pre-shuffle so equal-raw items end up in random order.
        const pairs = shuffle(indices.map(i => ({ i, r: raw[i] })));
        // Stable-ish sort by raw descending; equal raws keep the shuffled order.
        pairs.sort((x, y) => {
            if (Math.abs(x.r - y.r) < EPS)
                return 0; // keep pre-shuffled order on ties
            return y.r - x.r;
        });
        // Distribute leftover points from highest raw downwards (ties randomized)
        let k = 0;
        while (remainder > 0) {
            base[pairs[k % pairs.length].i] += 1;
            k++;
            remainder--;
        }
        // update the charts
        for (let i = 0; i < 3; i++) {
            const vec = { x: x[i], y: y, z: z + base[i] / 100 * 1024 };
            const chart = Entities.FindByName("main_chart_" + i)[0];
            chart.Teleport({ position: vec });
            Entities.FireInput({ name: "main_chart_" + i + "_text", input: "SetMessage", value: base[i] + "%" });
        }
        return [base[0], base[1], base[2]];
    }
    function resetCharts() {
        for (let i = 0; i < 3; i++) {
            const vec = { x: x[i], y: y, z: z };
            const chart = Entities.FindByName("main_chart_" + i)[0];
            chart.Teleport({ position: vec });
            Entities.FireInput({ name: "main_chart_" + i + "_text", input: "SetMessage", value: "00%" });
        }
    }
    onRoundStart(() => {
        mapnames_copy = [...mapnames];
        mgnames_copy = [...mgnames];
        stage = 0;
        votes = [0, 0, 0];
        ongoing_vote = false;
        result_p = [0, 0, 0];
        resetCharts();
    });
})();
// warmup.js
(() => {
    let first_round = true;
    Instance.OnScriptInput("warmup_EndWarmUp", () => {
        first_round = false;
    });
    onRoundStart(() => {
        if (first_round) {
            Entities.FireInput({ name: "wamrup_relay", input: "Trigger" });
            Entities.FireInput({ name: "script", input: "RunScriptInput", value: "warmup_EndWarmUp", delay: 10 });
            Entities.FireInput({ name: "map_parameters", input: "firewincondition", value: "10", delay: 30 });
        }
    });
})();
// Lava door displays use strings so SetMessage never receives a floating-point value.
(() => {
    const durations = [15, 12, 10, 16, 16];
    const started = durations.map(() => false);
    let roundGeneration = 0;
    async function countdown(index, generation) {
        for (let remaining = durations[index]; remaining >= 0; remaining--) {
            if (generation !== roundGeneration)
                return;
            Entities.FireInput({
                name: `lava_door_timer${index + 1}`,
                input: "SetMessage",
                value: String(remaining),
            });
            if (remaining > 0)
                await Instance.Delay(1);
        }
    }
    for (let index = 0; index < durations.length; index++) {
        Instance.OnScriptInput(`lava_StartDoorTimer${index + 1}`, () => {
            if (started[index])
                return;
            started[index] = true;
            void countdown(index, roundGeneration);
        });
    }
    onRoundStart(() => {
        roundGeneration++;
        started.fill(false);
    });
})();
Instance.OnRoundStart(() => {
    for (const callback of roundStartCallbacks)
        callback();
});
