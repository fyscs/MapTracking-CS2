        // per additional segment: handle-out, handle-in, anchor).
        if ((points.length - 1) % 3 !== 0) {
            Console.Log(`Curve.loadCurveFromString: invalid point count ${points.length}. Expected 1 + 3n (e.g. 4, 7, 10 ...).`);
            return undefined;
        }
        return new Curve({ CurvePoints: points, Resolution: resolution });
    }
