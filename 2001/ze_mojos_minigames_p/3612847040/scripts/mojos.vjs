// All minigames share the point_script named "script" (scripts/mojos.vjs).
// Input names use <original file>_<input> to keep each minigame independent.
// Keep a single engine round-start callback so every original reset runs.
const roundStartCallbacks = [];
function onRoundStart(callback) {
    roundStartCallbacks.push(callback);
}
// boatescape.js
(() => {
    let windDir = 219;
    Instance.OnScriptInput("boatescape_ChangeWindDir", () => {
        windDir += getRandomInt(-200, 200);
        if (Math.random() > 0.95) {
            windDir = getRandomInt(-500, 500);
        }
        windDir %= 360;
        Entities.FireInput({ name: "be_wind_strong", input: "SetPushDirection", value: "0 " + windDir + " 0" });
    });
    Instance.OnScriptInput("boatescape_Freeze", (data) => {
        const player = data.activator;
        const h = player.GetHealth() * 0.8;
        if (h >= 1) {
            const d = player.GetHealth() - h;
            const damage = {
                damage: d,
                damageTypes: 256, // SHOCK
            };
            player.TakeDamage(damage);
        }
        else {
            const damage = {
                damage: 1000,
                damageTypes: 256, // SHOCK
            };
            player.TakeDamage(damage);
        }
    });
    let start = 120;
    let end = 500;
    Instance.OnScriptInput("boatescape_LetItSnow", () => {
        start += getRandomInt(-10, 10);
        end += getRandomInt(-20, 20);
        Entities.FireInput({ name: "be_fog", input: "SetStartDist", value: start });
        Entities.FireInput({ name: "be_fog", input: "SetEndDist", value: end });
    });
    let walls = 1;
    let wall_templ = Entities.FindByName("be_wall_templ")[0];
    Instance.OnScriptInput("boatescape_Wall", (data) => {
        walls++;
        if (walls < 43) {
            let pos = wall_templ.GetAbsOrigin();
            pos.y += 64;
            wall_templ.Teleport({ position: pos });
            wall_templ.FireInput({ input: "ForceSpawn", delay: 0.02 });
        }
        data.caller.FireInput({ input: "Break", delay: 2 });
    });
    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }
    const zero_v = { x: 0, y: 0, z: 0 };
    Instance.OnScriptInput("boatescape_TeleportStart", (data) => {
        const destinations = Entities.FindByName("be_start_destination");
        const destination = destinations[getRandomInt(0, destinations.length - 1)];
        data.activator.Teleport({ position: destination.GetAbsOrigin(), angles: destination.GetAbsAngles(), velocity: zero_v });
    });
    onRoundStart(() => {
        windDir = 219;
        start = 120;
        end = 500;
        walls = 1;
        wall_templ = Entities.FindByName("be_wall_templ")[0];
    });
})();
