        data.activator.Teleport({ position: destination.GetAbsOrigin(), angles: destination.GetAbsAngles(), velocity: zero_v });
    });
    onRoundStart(() => {
        spawn_dest = Entities.FindByName("spawn_dest");
        Entities.FireInput({ name: "InitSpawn_trigger", input: "Enable", delay: 0.1 });
    });
    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }
})();
