                const mirrorMaxX = Math.max(anchorX, mirrorAnchorX) - 0.001;
                this._curvePoints[correspondingControlIndex] = new CurvePoint(Math.min(Math.max(reflected.x, mirrorMinX), mirrorMaxX), reflected.y);
