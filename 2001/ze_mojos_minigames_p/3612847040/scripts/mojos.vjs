    }
    static inverse(vector) {
        return new Vec2(-vector.x, -vector.y);
    }
    static distance(a, b) {
        return Math.sqrt(Vector2Utils.distanceSquared(a, b));
    }
    static distanceSquared(a, b) {
        return (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
    }
