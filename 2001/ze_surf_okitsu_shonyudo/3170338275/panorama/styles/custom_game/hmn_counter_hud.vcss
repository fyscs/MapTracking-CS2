.Root {
    width: 100%;
    height: 100%;
}
.CounterContainer {
    flow-children: down;
    width: 340px;
    height: fit-children;
    horizontal-align: right;
    vertical-align: top;
    margin-right: 10px;
    margin-top: 280px;
    opacity: 1.0;
}
.CounterWindow {
    flow-children: right;
    width: 100%;
    height: 76px;
    margin-bottom: 10px;
    padding: 10px;
    overflow: clip;
    background-color: #101820CC;
    border-radius: 14px;
}
.CounterIcon {
    vertical-align: center;
    margin-left: 10px;
    margin-right: 8px;
    opacity: 0.65;
}
#counter01_icon {
    width: 165px;
    height: 165px;
    transform: translateX(-25px) translateY(18px);
}
#counter02_icon {
    width: 165px;
    height: 165px;
    transform: translateX(-25px) translateY(18px);
}
#counter03_icon {
    width: 110px;
    height: 110px;
    transform: translateX(0px) translateY(0px);
}
#counter04_icon {
    width: 110px;
    height: 110px;
    transform: translateX(0px) translateY(0px);
}
#counter05_icon {
    width: 110px;
    height: 110px;
    transform: translateX(0px) translateY(0px);
}
.CounterContent {
    flow-children: down;
    width: fill-parent-flow(1.0);
    height: fit-children;
    vertical-align: center;
}
.CounterTitle {
    width: 100%;
    height: 25px;
    font-size: 16px;
    font-weight: bold;
