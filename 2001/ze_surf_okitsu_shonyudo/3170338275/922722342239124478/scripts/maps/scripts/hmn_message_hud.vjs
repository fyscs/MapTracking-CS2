// Generated by StarDance
// https://github.com/Kxnrl


import { Instance, Entities } from "cs_script/point_script";


/* =========================================================
   Message HUD
   ========================================================= */

// HUD管理Entity
const HUD_NAME = "hmn_message_hud";

let messageHud = null;

// 現在の表示言語
let messageLanguage = "Japanese";

// メッセージ再生セッション
let messageSession = 0;


/* =========================================================
   メッセージ定義
   ========================================================= */

// ----------------------------------------------
// Message 01
// ----------------------------------------------

const MESSAGE_01_TITLE_EN = "SUB-OBJECTIVE";
const MESSAGE_01_TITLE_JP = "サブ目標";

const MESSAGE_01_TEXT_EN = "Collect all Mr. S dolls and challenge the Secret Surf lazer!";
const MESSAGE_01_TEXT_JP = "せんせいの人形を全て手に入れ、シークレットサーフレーザーに挑もう！";


// ----------------------------------------------
// Message 02
// ----------------------------------------------

const MESSAGE_02_TITLE_EN = "DANGER";
const MESSAGE_02_TITLE_JP = "危険";

const MESSAGE_02_TEXT_EN = "The zombies will be released shortly!";
const MESSAGE_02_TEXT_JP = "まもなくゾンビが解放されます！";


// ----------------------------------------------
// Message 03
// ----------------------------------------------

const MESSAGE_03_TITLE_EN = "OBJECTIVE";
const MESSAGE_03_TITLE_JP = "目標";

const MESSAGE_03_TEXT_EN = "Split into two groups and activate the triggers!";
const MESSAGE_03_TEXT_JP = "二手に分かれてトリガーを押そう！";


// ----------------------------------------------
// Message 04
// ----------------------------------------------

const MESSAGE_04_TITLE_EN = "OBJECTIVE UPDATED";
const MESSAGE_04_TITLE_JP = "目標更新";

const MESSAGE_04_TEXT_EN = "A new Mr. S doll has been added!";
const MESSAGE_04_TEXT_JP = "新たなせんせいの人形が追加されました！";


/* =========================================================
   表示時間設定
   ========================================================= */

// HUD表示開始後、SE・ライン表示まで
const INITIAL_DELAY = 0.05;

// ライン表示後、タイトル表示まで
const TITLE_DELAY = 0.30;

// タイトル表示後、本文表示まで
const TEXT_DELAY = 0.30;

// タイプライターの文字送り間隔
const TYPEWRITER_INTERVAL = 0.035;

// 全文表示後の維持時間
const DISPLAY_TIME = 3.0;


/* =========================================================
   退場時間設定
   ========================================================= */

// ラインを消してから本文を消すまで
const EXIT_LINE_DELAY = 0.10;

// 本文を消してからタイトルを消すまで
const EXIT_TEXT_DELAY = 0.12;

// タイトルを消してからHUD全体を消すまで
const EXIT_TITLE_DELAY = 0.12;

// HUD全体を消す前の待機
const EXIT_CONTAINER_DELAY = 0.20;


/* =========================================================
   HUD取得
   ========================================================= */

function GetMessageHud() {

    if (
        messageHud !== null &&
        messageHud.IsValid()
    ) {
        return messageHud;
    }

    const entities =
        Entities.FindByName(HUD_NAME);

    if (
        !entities ||
        entities.length === 0
    ) {
        Instance.Msg(
            "ERROR: hmn_message_hud not found"
        );

        return null;
    }

    messageHud = entities[0];

    return messageHud;
}


/* =========================================================
   メッセージ登場SE
   ========================================================= */

// マップ側のambient_generic名
const MESSAGE_SOUND_NAME = "message_pip";


function PlayMessagePip() {

    const sounds =
        Entities.FindByName(
            MESSAGE_SOUND_NAME
        );

    const sound = sounds[0];

    if (!sound) {
        Instance.Msg(
            "ERROR: message_pip not found"
        );

        return;
    }

    sound.FireInput({
        input: "PlaySound"
    });
}


/* =========================================================
   プレイヤー取得
   ========================================================= */

function GetPlayers() {
    return Instance.GetAllPlayerControllers();
}


/* =========================================================
   全プレイヤーのHUDクラス変更
   ========================================================= */

function SetMessageClassForAllPlayers(
    panelId,
    className,
    state
) {

    const hud = GetMessageHud();

    if (!hud) {
        return;
    }

    for (const controller of GetPlayers()) {

        if (!controller) {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        hud.SetHasClassForPlayer(
            playerSlot,
            panelId,
            className,
            state
        );
    }
}


/* =========================================================
   全プレイヤーの本文更新
   ========================================================= */

function SetMessageTextForAllPlayers(text) {

    const hud = GetMessageHud();

    if (!hud) {
        return;
    }

    for (const controller of GetPlayers()) {

        if (!controller) {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "message_text",
            "message_text",
            text
        );
    }
}


/* =========================================================
   タイプライター表示
   ========================================================= */

async function TypeMessageForAllPlayers(
    text,
    mySession
) {

    // Unicode文字単位で分割
    const characters = Array.from(text);

    // 現在表示中の文字列
    let currentText = "";

    for (let i = 0; i < characters.length; i++) {

        // 古いセッションなら終了
        if (mySession !== messageSession) {
            return false;
        }

        currentText += characters[i];

        SetMessageTextForAllPlayers(
            currentText
        );

        // 最後の文字以外は待機
        if (i < characters.length - 1) {

            await Instance.Delay(
                TYPEWRITER_INTERVAL
            );
        }
    }

    return mySession === messageSession;
}


/* =========================================================
   1人のプレイヤーにメッセージを設定
   ========================================================= */

function ShowMessageForPlayer(
    playerSlot,
    title,
    language
) {

    const hud = GetMessageHud();

    if (!hud) {
        return;
    }

    // 各要素を非表示状態に戻す
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_line_top",
        "MessageHidden",
        true
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "message_title",
        "MessageHidden",
        true
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "message_text",
        "MessageHidden",
        true
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "message_line_bottom",
        "MessageHidden",
        true
    );

    // タイトル設定
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "message_title",
        "message_title",
        title
    );

    // 本文はタイプライターで表示するため空にする
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "message_text",
        "message_text",
        ""
    );

    // 英語タイトル位置調整クラス
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_title",
        "EnglishTitle",
        language === "English"
    );

    // 英語本文位置調整クラス
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_text",
        "EnglishText",
        language === "English"
    );

    // HUD表示開始
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_container",
        "Hidden",
        false
    );
}


/* =========================================================
   全プレイヤーにメッセージを表示
   ========================================================= */

async function ShowMessageForAllPlayers(
    titleEN,
    titleJP,
    textEN,
    textJP
) {

    // 新しいセッションを開始
    messageSession++;

    const mySession = messageSession;

    // 表示言語を決定
    const isEnglish =
        messageLanguage === "English";

    const title =
        isEnglish ? titleEN : titleJP;

    const text =
        isEnglish ? textEN : textJP;

    // 全プレイヤーにHUDを設定
    for (const controller of GetPlayers()) {

        if (!controller) {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        ShowMessageForPlayer(
            playerSlot,
            title,
            messageLanguage
        );
    }

    // SE再生前の待機
    await Instance.Delay(INITIAL_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    PlayMessagePip();

    // ライン表示前の待機
    await Instance.Delay(INITIAL_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // 上下ラインを同時に表示
    SetMessageClassForAllPlayers(
        "message_line_top",
        "MessageHidden",
        false
    );

    SetMessageClassForAllPlayers(
        "message_line_bottom",
        "MessageHidden",
        false
    );

    // タイトル表示まで待機
    await Instance.Delay(TITLE_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // タイトルを一括表示
    SetMessageClassForAllPlayers(
        "message_title",
        "MessageHidden",
        false
    );

    // 本文表示まで待機
    await Instance.Delay(TEXT_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // 本文を表示可能な状態にする
    SetMessageClassForAllPlayers(
        "message_text",
        "MessageHidden",
        false
    );

    // タイプライター開始
    const completed =
        await TypeMessageForAllPlayers(
            text,
            mySession
        );

    if (
        !completed ||
        mySession !== messageSession
    ) {
        return;
    }

    // 全文表示後、表示時間を維持
    await Instance.Delay(DISPLAY_TIME);

    if (mySession !== messageSession) {
        return;
    }

    // 上下ラインを同時に消す
    SetMessageClassForAllPlayers(
        "message_line_top",
        "MessageHidden",
        true
    );

    SetMessageClassForAllPlayers(
        "message_line_bottom",
        "MessageHidden",
        true
    );

    await Instance.Delay(EXIT_LINE_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // 本文を消す
    SetMessageClassForAllPlayers(
        "message_text",
        "MessageHidden",
        true
    );

    await Instance.Delay(EXIT_TEXT_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // タイトルを消す
    SetMessageClassForAllPlayers(
        "message_title",
        "MessageHidden",
        true
    );

    await Instance.Delay(EXIT_TITLE_DELAY);

    if (mySession !== messageSession) {
        return;
    }

    // HUD全体を非表示
    HideMessageForAllPlayers();
}


/* =========================================================
   1人のHUDを非表示
   ========================================================= */

function HideMessageForPlayer(playerSlot) {

    const hud = GetMessageHud();

    if (!hud) {
        return;
    }

    // 上側ライン
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_line_top",
        "MessageHidden",
        true
    );

    // タイトル
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_title",
        "MessageHidden",
        true
    );

    // 本文
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_text",
        "MessageHidden",
        true
    );

    // 下側ライン
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_line_bottom",
        "MessageHidden",
        true
    );

    // HUD全体
    hud.SetHasClassForPlayer(
        playerSlot,
        "message_container",
        "Hidden",
        true
    );
}


/* =========================================================
   全プレイヤーのHUDを非表示
   ========================================================= */

function HideMessageForAllPlayers() {

    for (const controller of GetPlayers()) {

        if (!controller) {
            continue;
        }

        const playerSlot =
            controller.GetPlayerSlot();

        HideMessageForPlayer(
            playerSlot
        );
    }
}


/* =========================================================
   Hammer → RunScriptInput
   ========================================================= */

// ----------------------------------------------
// Message 01
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowMessage01",
    () => {
        ShowMessageForAllPlayers(
            MESSAGE_01_TITLE_EN,
            MESSAGE_01_TITLE_JP,
            MESSAGE_01_TEXT_EN,
            MESSAGE_01_TEXT_JP
        );
    }
);


// ----------------------------------------------
// Message 02
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowMessage02",
    () => {
        ShowMessageForAllPlayers(
            MESSAGE_02_TITLE_EN,
            MESSAGE_02_TITLE_JP,
            MESSAGE_02_TEXT_EN,
            MESSAGE_02_TEXT_JP
        );
    }
);


// ----------------------------------------------
// Message 03
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowMessage03",
    () => {
        ShowMessageForAllPlayers(
            MESSAGE_03_TITLE_EN,
            MESSAGE_03_TITLE_JP,
            MESSAGE_03_TEXT_EN,
            MESSAGE_03_TEXT_JP
        );
    }
);


// ----------------------------------------------
// Message 04
// ----------------------------------------------

Instance.OnScriptInput(
    "ShowMessage04",
    () => {
        ShowMessageForAllPlayers(
            MESSAGE_04_TITLE_EN,
            MESSAGE_04_TITLE_JP,
            MESSAGE_04_TEXT_EN,
            MESSAGE_04_TEXT_JP
        );
    }
);


/* =========================================================
   言語切り替え
   ========================================================= */

// 英語
Instance.OnScriptInput(
    "EnableEnglish",
    () => {
        messageLanguage = "English";
    }
);

// 日本語
Instance.OnScriptInput(
    "EnableJapanese",
    () => {
        messageLanguage = "Japanese";
    }
);


/* =========================================================
   強制非表示
   ========================================================= */

Instance.OnScriptInput(
    "HideMessage",
    () => {

        // 現在の再生セッションを無効化
        messageSession++;

        HideMessageForAllPlayers();
    }
);
