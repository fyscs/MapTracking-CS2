const layout = Instance.FindEntitiesByName("countdown_hud")[0];
let titleToken = 0, subtitleToken = 0, countdownToken = 0, authorToken = 0, modeToken = 0;
let itemGlobalToken = 0;
const itemTokens = {};

function formatTime(sec) {
    const m = Math.floor(sec / 60), s = sec % 60;
    return `${m}M ${s}S`;
}

function resetHUD() {
    if (!layout) return;
    titleToken++;
    subtitleToken++;
    countdownToken++;
    authorToken++;
    modeToken++;
    itemGlobalToken++;
    layout.SetHasClass("title_label", "visible", false);
    layout.SetHasClass("subtitle_label", "visible", false);
    layout.SetHasClass("countdown_label", "visible", false);
    layout.SetHasClass("countdown_label", "warning", false);
    layout.SetHasClass("author_label", "visible", false);
    layout.SetHasClass("mode_label", "visible", false);
    layout.SetDialogVariableString("title_label", "title_text", "");
    layout.SetDialogVariableString("subtitle_label", "subtitle_text", "");
    layout.SetDialogVariableString("countdown_label", "countdown_text", "");
}

function showAuthor() {
    if (!layout) return;
    const token = ++authorToken;
    layout.SetDialogVariableString("author_label", "author_text", "ze_bioshock\nby DormantLemon");
    layout.SetHasClass("author_label", "visible", true);
    (async () => {
        await Instance.Delay(3);
        if (token === authorToken) layout.SetHasClass("author_label", "visible", false);
    })();
}

function showMode() {
    if (!layout) return;
    const token = ++modeToken;
    const text = "1999 mode\nCongratulations on beating the main map\n\n1999 is a challenge mode that spans all 4 locations\n\nIt's meant to be difficult\nand takes around 20minutes to complete\n\nGood luck and have fun";
    layout.SetDialogVariableString("mode_label", "mode_text", text);
    layout.SetHasClass("mode_label", "visible", true);
    (async () => {
        await Instance.Delay(10);
        if (token === modeToken) layout.SetHasClass("mode_label", "visible", false);
    })();
}

function showItemForPlayer(playerSlot, text, colorClass, duration = 5) {
    if (!layout) return;
    const playerToken = (itemTokens[playerSlot] || 0) + 1;
    itemTokens[playerSlot] = playerToken;
    const currentGlobal = itemGlobalToken;
    layout.SetDialogVariableStringForPlayer(playerSlot, "item_label", "item_text", text);
    const allColorClasses = ["color_red", "color_green", "color_blue", "color_cyan", "color_magenta", "color_yellow", "color_white", "color_orange", "color_purple"];
    for (const cls of allColorClasses) {
        layout.SetHasClassForPlayer(playerSlot, "item_label", cls, false);
    }
    if (colorClass) {
        layout.SetHasClassForPlayer(playerSlot, "item_label", colorClass, true);
    }
    layout.SetHasClassForPlayer(playerSlot, "item_label", "visible", true);
    (async () => {
        await Instance.Delay(duration);
        if (itemGlobalToken === currentGlobal && itemTokens[playerSlot] === playerToken) {
            layout.SetHasClassForPlayer(playerSlot, "item_label", "visible", false);
            layout.SetDialogVariableStringForPlayer(playerSlot, "item_label", "item_text", "");
        }
    })();
}

function showTitle(text, duration) {
    if (!layout) return;
    const token = ++titleToken;
    layout.SetDialogVariableString("title_label", "title_text", text);
    layout.SetHasClass("title_label", "visible", true);
    (async () => {
        await Instance.Delay(duration);
        if (token === titleToken) layout.SetHasClass("title_label", "visible", false);
    })();
}

function showSubtitle(text, duration) {
    if (!layout) return;
    const token = ++subtitleToken;
    layout.SetDialogVariableString("subtitle_label", "subtitle_text", text);
    layout.SetHasClass("subtitle_label", "visible", true);
    (async () => {
        await Instance.Delay(duration);
        if (token === subtitleToken) layout.SetHasClass("subtitle_label", "visible", false);
    })();
}

function startCountdown(seconds) {
    if (!layout) return;
    const token = ++countdownToken;
    const update = (rem) => {
        layout.SetDialogVariableString("countdown_label", "countdown_text", formatTime(rem));
        layout.SetHasClass("countdown_label", "visible", true);
        layout.SetHasClass("countdown_label", "warning", rem <= 5 && rem > 0);
    };
    update(seconds);
    (async () => {
        while (seconds > 0) {
            await Instance.Delay(1);
            if (token !== countdownToken) break;
            seconds--;
            if (seconds <= 0) {
                layout.SetHasClass("countdown_label", "visible", false);
                layout.SetHasClass("countdown_label", "warning", false);
            } else {
                update(seconds);
            }
        }
    })();
}

Instance.OnRoundStart(() => {
    resetHUD();
    showAuthor();
});

for (const cfg of TITLE_CONFIGS) {
    Instance.OnScriptInput(cfg.input, () => showTitle(cfg.text, cfg.duration));
}
for (const cfg of SUBTITLE_CONFIGS) {
    Instance.OnScriptInput(cfg.input, () => showSubtitle(cfg.text, cfg.duration));
}
for (const name of COUNTDOWN_INPUTS) {
    Instance.OnScriptInput(name, () => {
        const n = parseInt(name.substring(10), 10);
        if (n > 0) startCountdown(n);
    });
}

Instance.OnScriptInput("1999", showMode);

for (const cfg of ITEM_CONFIGS) {
    Instance.OnScriptInput(cfg.input, (data) => {
        let activator = data.activator;
        let playerSlot = -1;
        if (activator) {
            let controller = null;
            if (typeof activator.GetPlayerController === "function") {
                controller = activator.GetPlayerController();
            } else if (typeof activator.GetOriginalPlayerController === "function") {
                controller = activator.GetOriginalPlayerController();
            } else if (typeof activator.IsConnected === "function") {
                controller = activator;
            }
            if (controller && typeof controller.GetPlayerSlot === "function") {
                playerSlot = controller.GetPlayerSlot();
            }
        }
        if (playerSlot === -1) {
            Instance.Msg("错误：无法获取激活者玩家槽位");
            return;
        }
        showItemForPlayer(playerSlot, cfg.text, cfg.colorClass, 5);
    });
}

Instance.OnScriptInput("untitle", () => {
    if (!layout) return;
    titleToken++;
    subtitleToken++;
    layout.SetHasClass("title_label", "visible", false);
    layout.SetHasClass("subtitle_label", "visible", false);
    layout.SetDialogVariableString("title_label", "title_text", "");
    layout.SetDialogVariableString("subtitle_label", "subtitle_text", "");
});

Instance.OnScriptInput("uncount", () => {
    if (!layout) return;
    countdownToken++;
    layout.SetHasClass("countdown_label", "visible", false);
    layout.SetHasClass("countdown_label", "warning", false);
    layout.SetDialogVariableString("countdown_label", "countdown_text", "");
});