/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.BossHud {
    width: 100%;
    height: 100%;
    visibility: collapse;
    opacity: 0;
}
.BossHud.BossActive {
    visibility: visible;
    opacity: 1;
}
.BossIntro {
    width: 100%;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 140px;
    padding: 80px 0px;
    flow-children: down;
    overflow: noclip;
    opacity: 0;
}
.BossActive .BossIntro {
    animation-name: BossIntroReveal;
    animation-duration: 4.5s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
    animation-fill-mode: forwards;
}
.BossIntroName {
    horizontal-align: center;
    padding: 16px 40px;
    font-size: 84px;
    font-weight: bold;
    letter-spacing: 10px;
    text-transform: uppercase;
    color: #ff5a1f;
    text-shadow: 0px 0px 18px 4 #a80d00;
}
.BossIntroRule {
    horizontal-align: center;
    width: 520px;
    height: 2px;
    margin-top: 6px;
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#ff5a1f00), color-stop(0.5, #ff5a1f), to(#ff5a1f00));
}
@keyframes 'BossIntroReveal' {
    0% {
        opacity: 0;
        transform: scale3d(1.6, 1.6, 1) translateY(-20px);
    }
12% {
        opacity: 1;
        transform: scale3d(1, 1, 1) translateY(0px);
    }
75% {
        opacity: 1;
        transform: scale3d(1.04, 1.04, 1) translateY(0px);
    }
100% {
        opacity: 0;
        transform: scale3d(1.08, 1.08, 1) translateY(-10px);
    }
}
.BossBar {
    width: fit-children;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 40px;
    padding: 30px 40px;
    flow-children: down;
    overflow: noclip;
    opacity: 0;
}
.BossActive .BossBar {
    animation-name: BossBarIntro;
    animation-duration: 4.2s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
    animation-fill-mode: forwards;
}
@keyframes 'BossBarIntro' {
    0% {
        opacity: 0;
        transform: translateY(-30px);
    }
80% {
        opacity: 0;
        transform: translateY(-30px);
    }
100% {
        opacity: 1;
        transform: translateY(0px);
    }
}
.BossBarHeader {
    width: 760px;
    horizontal-align: center;
    flow-children: right;
    padding: 4px 4px 0px 0px;
}
.BossBarName {
    vertical-align: center;
    margin-left: 4px;
    padding: 4px 8px;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #f2e6d8;
    text-shadow: 0px 0px 6px 2 #000000;
}
.BossBarHpText {
    horizontal-align: right;
    vertical-align: center;
    padding: 4px 8px;
    font-size: 20px;
    font-weight: bold;
    color: #f2e6d8;
    text-shadow: 0px 0px 6px 2 #000000;
}
.BossBarShake {
    width: fit-children;
    horizontal-align: center;
    padding: 16px 20px;
    overflow: noclip;
}
.BossBarFrame {
    width: 760px;
    height: 22px;
    padding: 3px;
    background-color: #0b0507dd;
    border: 1px solid #ff5a1f66;
    border-radius: 3px;
    box-shadow: #000000cc 0px 0px 10px 2px;
}
.BossBarTrack {
    width: 100%;
    height: 100%;
    background-color: #2a0b0b;
    border-radius: 2px;
}
.BossBarTrail {
    width: 100%;
    height: 100%;
    background-color: #ffd9a0;
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-in;
}
.BossBarFill {
    width: 100%;
    height: 100%;
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#5c0a12), color-stop(0.6, #c41d12), to(#ff6a1f));
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
.BossBarShine {
    width: 100%;
    height: 40%;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#ffffff55), to(#ffffff00));
}
.BossBarFlash {
    width: 100%;
    height: 100%;
    background-color: #ffe2b8;
    border-radius: 2px;
    opacity: 0;
}
.Refilling .BossBarFill,.Refilling .BossBarTrail {
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}
.BossBarArmor {
    width: 0%;
    height: 100%;
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#5d636b), color-stop(0.7, #a9b0b8), to(#d9dee3));
    border-radius: 2px;
    opacity: 0;
    transition-property: width, opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}
.Phase2 .BossBarArmor {
    opacity: 1;
}
.BossBarArmorShine {
    width: 100%;
    height: 45%;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#ffffff88), to(#ffffff00));
}
.BossBarArmorEdge {
    width: 2px;
    height: 100%;
    horizontal-align: right;
    background-color: #ffffff;
    box-shadow: #ffffffaa 0px 0px 4px 1px;
}
.BossBarNotch {
    width: 2px;
    height: 100%;
    background-color: #0b0507aa;
    visibility: collapse;
}
.Phase2 .BossBarNotch {
    visibility: visible;
}
.BossBarNotch1 {
    margin-left: 12.5%;
}
.BossBarNotch2 {
    margin-left: 25%;
}
.BossBarNotch3 {
    margin-left: 37.5%;
}
.BossBarNotch4 {
    margin-left: 50%;
}
.BossBarNotch5 {
    margin-left: 62.5%;
}
.BossBarNotch6 {
    margin-left: 75%;
}
.BossBarNotch7 {
    margin-left: 87.5%;
}
.Enraged .BossBarFill {
    animation-name: BossEnragedPulse;
    animation-duration: 0.9s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}
.Enraged .BossBarFrame {
    border: 1px solid #ff2a1fcc;
}
@keyframes 'BossEnragedPulse' {
    0% {
        wash-color: #ff000000;
    }
50% {
        wash-color: #ff3a2a90;
    }
100% {
        wash-color: #ff000000;
    }
}
.HitA .BossBarShake {
    animation-name: BossHitShakeA;
    animation-duration: 0.25s;
    animation-iteration-count: 1;
}
.HitB .BossBarShake {
    animation-name: BossHitShakeB;
    animation-duration: 0.25s;
    animation-iteration-count: 1;
}
.HitA .BossBarFlash {
    animation-name: BossHitFlashA;
    animation-duration: 0.25s;
    animation-iteration-count: 1;
}
.HitB .BossBarFlash {
    animation-name: BossHitFlashB;
    animation-duration: 0.25s;
    animation-iteration-count: 1;
}
@keyframes 'BossHitShakeA' {
    0% {
        transform: translateX(-3px);
    }
50% {
        transform: translateX(3px);
    }
100% {
        transform: translateX(0px);
    }
}
@keyframes 'BossHitShakeB' {
    0% {
        transform: translateX(-3px);
    }
50% {
        transform: translateX(3px);
    }
100% {
        transform: translateX(0px);
    }
}
@keyframes 'BossHitFlashA' {
    0% {
        opacity: 0.35;
    }
100% {
        opacity: 0;
    }
}
@keyframes 'BossHitFlashB' {
    0% {
        opacity: 0.35;
    }
100% {
        opacity: 0;
    }
}
