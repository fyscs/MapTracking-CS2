"id":766046066,"timepoint":1683001860,"offset":9732,"lane":1},{"type":"single","id":576274585,"timepoint":1683001860,"offset":9744,"lane":0},{"type":"single","id":707052520,"timepoint":1683001860,"offset":9768,"lane":1},{"type":"single","id":1353018972,"timepoint":1683001860,"offset":9768,"lane":5},{"type":"single","id":2044619804,"timepoint":1683001860,"offset":9792,"lane":2},{"type":"single","id":1995295364,"timepoint":1683001860,"offset":9792,"lane":4},{"type":"single","id":179714452,"timepoint":1683001860,"offset":9816,"lane":3},{"type":"slide","id":1564436068,"slide":1443712623,"timepoint":1683001860,"offset":9840,"lane":2},{"type":"slide","id":1302316148,"slide":1443712623,"timepoint":1683001860,"offset":9888,"lane":2},{"type":"single","id":441990212,"timepoint":1683001860,"offset":9864,"lane":3},{"type":"single","id":1461960861,"timepoint":1683001860,"offset":9876,"lane":4},{"type":"slide","id":689039382,"slide":1827806999,"timepoint":1683001860,"offset":9888,"lane":5},{"type":"slide","id":937413242,"slide":1827806999,"timepoint":1683001860,"offset":9936,"lane":5},{"type":"single","id":326799223,"timepoint":1683001860,"offset":9912,"lane":4},{"type":"single","id":389837287,"timepoint":1683001860,"offset":9924,"lane":3},{"type":"slide","id":1773282065,"slide":1270087159,"timepoint":1683001860,"offset":9936,"lane":2},{"type":"slide","id":971926071,"slide":1270087159,"timepoint":1683001860,"offset":9984,"lane":2},{"type":"single","id":1468202634,"timepoint":1683001860,"offset":9960,"lane":3},{"type":"single","id":29783855,"timepoint":1683001860,"offset":9972,"lane":4},{"type":"slide","id":1050073600,"slide":89212623,"timepoint":1683001860,"offset":9984,"lane":5},{"type":"slide","id":1322885435,"slide":89212623,"timepoint":1683001860,"offset":10032,"lane":5},{"type":"single","id":278300773,"timepoint":1683001860,"offset":10008,"lane":2},{"type":"slide","id":1142105176,"slide":89212623,"timepoint":1683001860,"offset":10020,"lane":5},{"type":"single","id":553803952,"timepoint":1683001860,"offset":10032,"lane":1},{"type":"flick","id":800529479,"timepoint":1683001860,"offset":10056,"lane":2},{"type":"flick","id":1875783407,"timepoint":1683001860,"offset":10056,"lane":4},{"type":"flick","id":1545002270,"timepoint":1683001860,"offset":10104,"lane":3},{"type":"flick","id":1949124458,"timepoint":1683001860,"offset":10128,"lane":2},{"type":"flick","id":6867887,"timepoint":1683001860,"offset":10152,"lane":3},{"type":"flick","id":1106746167,"timepoint":1683001860,"offset":10176,"lane":4},{"type":"single","id":1650984330,"timepoint":1683001860,"offset":10200,"lane":2},{"type":"single","id":1048481958,"timepoint":1683001860,"offset":10224,"lane":2},{"type":"single","id":362820872,"timepoint":1683001860,"offset":10224,"lane":4},{"type":"single","id":1209499302,"timepoint":1683001860,"offset":10212,"lane":3},{"type":"flick","id":2125960620,"timepoint":1683001860,"offset":10248,"lane":5},{"type":"flick","id":1243139102,"timepoint":1683001860,"offset":10248,"lane":1},{"type":"single","id":686097381,"timepoint":1683001860,"offset":10200,"lane":4},{"type":"single","id":796812852,"timepoint":1683001860,"offset":10416,"lane":6},{"type":"single","id":1891667197,"timepoint":1683001860,"offset":10416,"lane":0},{"type":"single","id":458184304,"timepoint":1683001860,"offset":10428,"lane":5},{"type":"single","id":619903829,"timepoint":1683001860,"offset":10428,"lane":1},{"type":"single","id":1095339127,"timepoint":1683001860,"offset":10440,"lane":4},{"type":"single","id":1929510945,"timepoint":1683001860,"offset":10440,"lane":2},{"type":"single","id":371363382,"timepoint":1683001860,"offset":10452,"lane":3},{"type":"slide","id":226083809,"slide":468782168,"timepoint":1683001860,"offset":10560,"lane":3},{"type":"slide","id":1177401586,"slide":468782168,"timepoint":1683001860,"offset":10464,"lane":3},{"type":"single","id":1736402487,"timepoint":1683001860,"offset":10548,"lane":2},{"type":"single","id":440734045,"timepoint":1683001860,"offset":10572,"la