.Root {
    width: 100%;
    height: 100%;
}
.Hidden {
    visibility: collapse;
}
.HiddenOpacity {
    opacity: 0;
}
.PanelCard {
    background-color: #101a30f2;
    border: 1px solid #24365c;
    border-radius: 8px;
    overflow: clip;
    transition-property: background-color, border-color;
    transition-duration: 0.14s, 0.14s;
    transition-timing-function: ease-in-out, ease-in-out;
    transition-delay: 0s, 0s;
}
.BarTrack {
    width: 100%;
    height: 14px;
    background-color: #060a14f2;
    border: 1px solid #1d2b48;
    border-radius: 7px;
    overflow: clip;
}
.BarFill {
    width: 0%;
    height: 100%;
    background-color: #3d8bff;
    border-radius: 6px;
    transition-property: width;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
    transition-delay: 0s;
}
.BarValue {
    width: 100%;
    height: 100%;
    font-size: 10px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    vertical-align: center;
    letter-spacing: 0;
}
