.Btn {
    background-color: #16223ef2;
    border: 1px solid #2c4573;
    border-radius: 6px;
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-in-out, ease-in-out, ease-in-out;
    transition-delay: 0s, 0s, 0s;
}
.Btn Label {
    width: 100%;
    height: 100%;
    font-size: 13px;
    font-weight: bold;
    color: #d7e5ff;
    text-align: center;
    vertical-align: center;
}
.Btn:hover {
    background-color: #22355ef2;
    border-color: #3d6bbf;
}
.Btn:active {
    background-color: #2d4c86;
}
.Btn:disabled,.Btn.Disabled {
    opacity: 0.3;
}
.BtnPrimary {
    background-color: #2f6fd8;
    border-color: #5ea1ff;
}
.BtnPrimary Label {
    color: #ffffff;
    font-size: 15px;
    letter-spacing: 2px;
}
.BtnPrimary:hover {
    background-color: #3f83ee;
}
.BtnGhost {
    background-color: #131d33d9;
    border-color: #26375a;
}
.BtnWarn {
    background-color: #7a2530f2;
    border-color: #c04a56;
}
.Badge {
    font-size: 9px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    vertical-align: center;
    border-radius: 3px;
    padding: 2px 5px;
}
.TxtEllipsis {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: clip;
}
.TxtCenter {
    text-align: center;
    horizontal-align: center;
}
.TxtDim {
    color: #93a9c9;
}
.TxtGold {
    color: #f2c866;
}
.TxtBlue {
    color: #6fb0ff;
}
.ScrollViewport {
    overflow: clip;
}
.ScrollTrack {
    width: 100%;
    height: 8px;
    vertical-align: center;
    background-color: #0a1224cc;
    border: 1px solid #1d2b48;
    border-radius: 4px;
    overflow: clip;
}
.ScrollThumb {
    width: 25%;
    height: 100%;
    background-color: gradient( linear, 0% 0%, 100% 0%, from( #2f6fd8 ), to( #6fd8ff ) );
    border-radius: 4px;
    transform: translateX(0%);
    transition-property: transform;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
    transition-delay: 0s;
}
.st0 {
    transform: translateX(0%);
}
.st1 {
    transform: translateX(100%);
}
.st2 {
    transform: translateX(200%);
}
.st3 {
    transform: translateX(300%);
}
