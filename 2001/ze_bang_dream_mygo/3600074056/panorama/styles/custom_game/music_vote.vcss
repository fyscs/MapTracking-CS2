    border: 3px solid #5aa2ff;
    border-radius: 14px;
    box-shadow: #5aa2ff88 0px 0px 46px 8px;
}
.RevealImage {
    width: 100%;
    height: 100%;
    border-radius: 11px;
}
.RevealFrameRule {
    ignore-parent-flow: true;
    width: 100%;
    height: 3px;
    vertical-align: bottom;
    background-color: gradient( linear, 0% 0%, 100% 0%, from( #00000000 ), color-stop( 0.5, #8fd8ff ), to( #00000000 ) );
}
.RevealTitle {
    width: 100%;
    height: 48px;
    margin-top: 22px;
    font-size: 36px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    letter-spacing: 2px;
    text-shadow: 0px 0px 14px 1.0 #4f8fe0cc;
}
.RevealMeta {
    width: 100%;
    height: fit-children;
    margin-top: 8px;
    font-size: 14px;
    line-height: 24px;
    color: #a9bcd8;
    text-align: center;
    letter-spacing: 1px;
}
.HudRoot.RevealActive {
    background-color: #00000000;
    background-color: gradient( radial, 50% 50%, 0% 0%, 70% 70%, from( #0a1a34f2 ), to( #04060cf7 ) );
    border-color: #00000000;
    box-shadow: #00000000 0px 0px 0px 0px;
}
.HudRoot.RevealActive .TopBar,.HudRoot.RevealActive .HeadBar,.HudRoot.RevealActive .ToolBar,.HudRoot.RevealActive .CoverArea,.HudRoot.RevealActive .CoverLegend,.HudRoot.RevealActive .FooterBar {
    visibility: collapse;
}
@keyframes 'mv_pulse' {
    0% {
        opacity: 0.45;
    }
50% {
        opacity: 1;
    }
100% {
        opacity: 0.45;
    }
}
@keyframes 'mv_glow' {
    0% {
        opacity: 0.35;
    }
50% {
        opacity: 0.9;
    }
100% {
        opacity: 0.35;
    }
}
