.RevealOverlay {
    ignore-parent-flow: true;
    width: 100%;
    height: 100%;
    z-index: 90;
    flow-children: down;
    overflow: clip;
    background-color: #00000000;
    opacity: 1;
    pre-transform-scale2d: 1;
    transition-property: opacity, pre-transform-scale2d;
    transition-duration: 0.16s, 0.2s;
    transition-timing-function: ease-out, ease-out;
    transition-delay: 0s, 0s;
}
.RevealOverlay.PhaseEnlarge {
    pre-transform-scale2d: 1.14;
}
.RevealOverlay.PhaseShrink {
    pre-transform-scale2d: 0.66;
}
.RevealOverlay.PhaseHold {
    pre-transform-scale2d: 1;
}
.RevealOverlay.RevealFade {
    opacity: 0;
}
.RevealGlow {
    ignore-parent-flow: true;
    width: 100%;
    height: 100%;
    background-color: gradient( radial, 50% 45%, 0% 0%, 46% 46%, from( #4f8fe055 ), to( #00000000 ) );
