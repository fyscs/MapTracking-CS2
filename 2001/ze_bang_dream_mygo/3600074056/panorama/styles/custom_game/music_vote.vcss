.HudRoot {
    width: 1240px;
    height: 90%;
    horizontal-align: center;
    vertical-align: center;
    z-index: 100;
    flow-children: down;
    padding: 16px 18px 14px 18px;
    overflow: clip;
    background-color: #070b16fa;
    background-color: gradient( linear, 0% 0%, 100% 100%, from( #0a1024fa ), color-stop( 0.55, #070b16fa ), to( #120a1efa ) );
    border: 1px solid #22314f;
    border-radius: 12px;
    box-shadow: #000000c0 0px 6px 40px 6px;
    opacity: 1;
    pre-transform-scale2d: 1;
    transition-property: opacity, pre-transform-scale2d;
    transition-duration: 0.16s, 0.16s;
    transition-timing-function: ease-out, ease-out;
    transition-delay: 0s, 0s;
}
.HudRoot.Hidden {
    visibility: collapse;
    opacity: 0;
    pre-transform-scale2d: 0.97;
}
.TopBar {
