.RevealBackdrop {
    ignore-parent-flow: true;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.22;
}
.RevealScrim {
    ignore-parent-flow: true;
    width: 100%;
    height: 100%;
    background-color: gradient( radial, 50% 42%, 0% 0%, 74% 74%, from( #0a102488 ), color-stop( 0.5, #070b16cc ), to( #060a14f7 ) );
}
.RevealContent {
    width: 100%;
    height: fit-children;
    align: center center;
    flow-children: down;
}
.RevealInfo {
    width: 100%;
    height: fit-children;
    margin-top: 10px;
    flow-children: down;
}
.RevealDiffLine {
    width: fit-children;
    height: fit-children;
    horizontal-align: center;
    flow-children: right;
}
.RevealKey {
    width: fit-children;
    height: fit-children;
    font-size: 14px;
    color: #8296b5;
    vertical-align: middle;
}
.RevealStars {
    width: fit-children;
    height: fit-children;
    font-size: 15px;
    color: #ffcc33;
    letter-spacing: 2px;
    vertical-align: middle;
}
.RevealLine {
    width: 100%;
    height: fit-children;
    font-size: 14px;
    line-height: 22px;
    color: #a9bcd8;
    text-align: center;
    letter-spacing: 1px;
}
.RevealModeLine {
    color: #8fc0ff;
}
.RevealMusicAuthor,.RevealSponsor,.RevealTags {
    visibility: collapse;
}
.RevealOverlay.HasMusicAuthor .RevealMusicAuthor {
    visibility: visible;
}
.RevealOverlay.HasSponsor .RevealSponsor {
    visibility: visible;
}
.RevealOverlay.HasTags .RevealTags {
    visibility: visible;
}
.HudRoot.RandomMode.RevealActive {
    height: 90%;
}
.HudRoot.RevealActive .CoverWindow.RandomMode {
    height: fill-parent-flow( 1 );
}
