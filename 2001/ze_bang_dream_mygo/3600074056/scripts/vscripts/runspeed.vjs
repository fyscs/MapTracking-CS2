// Generated by StarDance
// https://github.com/Kxnrl

import { CSInputs, CSPlayerPawn, Instance } from "cs_script/point_script";

// ========== 配置参数 ==========
const CONFIG = {
    friction: 0.9,                  // 速度衰减因子（每帧乘数）
    maxAcceleration: 4000,          // 最大按键加速度（单位/秒^2）
    stableAcceleration: 3000,       // 稳定时的按键加速度（单位/秒^2）
    accelerationDecayRate: 8.0,     // 加速度衰减速率（1/秒）
};

const players = new Map();
let maxSpeed = 250;
let mainTaskId = 0;

for (let i = 1; i < 5; i += 0.1) {
    Instance.OnScriptInput("Speed " + i.toFixed(1), () => {
        CancelSpeed();
        maxSpeed = Math.round(250 * i);
        for (const player of Instance.FindEntitiesByClass("player")) {
            if (!player.IsValid()) continue;
            players.set(player, { simulatedVelocity: { x: 0, y: 0 }, accelerationTime: 0 });
        }
        mainTaskId = Delay(0, Main);
    });
}

Instance.OnRoundStart(() => {
    CancelSpeed();
    CancelDelay(mainTaskId);
});

Instance.OnPlayerJump((event) => {
    if (!players.has(event.player)) return;
    const velocity = players.get(event.player).simulatedVelocity;
    Instance.QueueAfterThinks(() => {
        velocity.z = event.player.GetAbsVelocity().z;
        event.player.Teleport({ velocity });
    });
});

/**
 * 主循环 - 每 1/64 秒执行一次
 */
function Main() {
    players.forEach(({ simulatedVelocity, accelerationTime }, player) => {
        if (!player.IsValid() || player.GetTeamNumber() !== 3) return;
        if (!Instance.IsFreezePeriod()) {
            if (player.GetGroundEntity()) {
                // 获取输入方向
                const keyAngles = GetAbsKeyAngles(player);
                let dirX = 0, dirY = 0;

                if (keyAngles) {
                    const yawRad = (keyAngles.yaw * Math.PI) / 180;
                    dirX = Math.cos(yawRad);
                    dirY = Math.sin(yawRad);
                }

                // 计算当前加速度大小（非线性）
                let accel = 0;
                if (
                    player.WasInputJustPressed(CSInputs.FORWARD) ||
                    player.WasInputJustPressed(CSInputs.BACK) ||
                    player.WasInputJustPressed(CSInputs.LEFT) ||
                    player.WasInputJustPressed(CSInputs.RIGHT)
                ) {
                    accelerationTime = 0;
                    accel = CONFIG.maxAcceleration * Math.exp(-CONFIG.accelerationDecayRate * accelerationTime) + CONFIG.stableAcceleration;
                } else if (keyAngles) {
                    accelerationTime += 1 / 64; // 累加帧时间
                    accel = CONFIG.maxAcceleration * Math.exp(-CONFIG.accelerationDecayRate * accelerationTime) + CONFIG.stableAcceleration;
                } else {
                    accelerationTime = 0;
                }

                // 更新模拟水平速度：先应用摩擦，再应用加速度
                simulatedVelocity.x = simulatedVelocity.x * CONFIG.friction + dirX * accel * (1 / 64);
                simulatedVelocity.y = simulatedVelocity.y * CONFIG.friction + dirY * accel * (1 / 64);

                // 限制最大水平速度
                const speed = Math.hypot(simulatedVelocity.x, simulatedVelocity.y);
                if (speed > maxSpeed) {
                    const scale = maxSpeed / speed;
                    simulatedVelocity.x *= scale;
                    simulatedVelocity.y *= scale;
                }

                // 获取玩家当前 Z 轴速度（保持原样）
                const zVel = player.GetAbsVelocity().z;

                // 设置玩家速度
                player.Teleport({ velocity: { x: simulatedVelocity.x, y: simulatedVelocity.y, z: zVel } });
            } else {
                Delay(1 / 64, () => {
                    // 玩家在空中：不干预速度，仅同步模拟速度为实际水平速度
                    if (!player || !player.IsValid()) return;
                    accelerationTime = 0;
                    const actualVel = player.GetAbsVelocity();
                    simulatedVelocity.x = actualVel.x;
                    simulatedVelocity.y = actualVel.y;
                });
            }
        }
    });
    mainTaskId = Delay(1 / 64, Main);
}

function CancelSpeed() {
    players.clear();
    maxSpeed = 250;
}

/**
 * 方向映射表
 * @type {Object<string, number>}
 */
const DirectionMap = {
    '0,0': NaN,
    '1,0': -90,
    '-1,0': 90,
    '0,1': 0,
    '0,-1': 180,
    '1,1': -45,
    '1,-1': -135,
    '-1,1': 45,
    '-1,-1': 135
};

/**
 * 获取当前玩家按键绝对方向
 * @param {CSPlayerPawn} player 
 * @returns {{pitch:number, yaw:number, roll:number}|null}
 */
function GetAbsKeyAngles(player) {
    const forward = player.IsInputPressed(CSInputs.FORWARD);
    const back = player.IsInputPressed(CSInputs.BACK);
    const left = player.IsInputPressed(CSInputs.LEFT);
    const right = player.IsInputPressed(CSInputs.RIGHT);
    let h = 0;
    let v = 0;
    if (left && !right) {
        h = -1;
    } else if (!left && right) {
        h = 1;
    }
    if (forward && !back) {
        v = 1;
    } else if (!forward && back) {
        v = -1;
    }
    const KeyAngleYaw = DirectionMap[`${h},${v}`];
    if (!Number.isNaN(KeyAngleYaw)) {
        return { pitch: 0, yaw: player.GetEyeAngles().yaw + KeyAngleYaw, roll: 0 };
    }
    return null;
}

// ========== 延迟任务系统（保持原有，未修改） ==========
/** @type {{ id: number, time: number, callback: () => void }[]} */
const thinkQueue = [];
/** @type {Map<number, { id: number, time: number, callback: () => void }>} */
const taskMap = new Map();
let nextTaskId = 1;

/**
 * 延迟执行函数
 * @param {number} delaySeconds 延迟的秒数
 * @param {() => void} callback 回调函数
 * @returns {number} 任务ID，可用于取消或重新调度
 */
function Delay(delaySeconds, callback) {
    const executeTime = Instance.GetGameTime() + delaySeconds;
    return QueueThink(executeTime, callback);
}

/**
 * 将think任务加入队列
 * @param {number} time 执行时间
 * @param {() => void} callback 回调函数
 * @returns {number} 任务ID
 */
function QueueThink(time, callback) {
    const id = nextTaskId++;
    const task = { id, time, callback };

    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= time) {
            insertIndex = i + 1;
            break;
        }
    }

    thinkQueue.splice(insertIndex, 0, task);
    taskMap.set(id, task);

    if (insertIndex === 0) {
        Instance.SetNextThink(time);
    }

    return id;
}

/**
 * 取消指定ID的延迟任务（若尚未执行）
 * @param {number} taskId 任务ID
 */
function CancelDelay(taskId) {
    const task = taskMap.get(taskId);
    if (!task) return;

    const index = thinkQueue.indexOf(task);
    if (index !== -1) {
        thinkQueue.splice(index, 1);
    }
    taskMap.delete(taskId);

    if (index === 0) {
        if (thinkQueue.length > 0) {
            Instance.SetNextThink(thinkQueue[0].time);
        }
    }
}

/**
 * 重新设置未执行任务的新延迟时间（从当前游戏时间开始计算）
 * @param {number} taskId 任务ID
 * @param {number} newDelaySeconds 新的延迟秒数
 * @returns {boolean} 是否修改成功（任务存在且未执行）
 */
function RescheduleDelay(taskId, newDelaySeconds) {
    const task = taskMap.get(taskId);
    if (!task) return false;

    const newTime = Instance.GetGameTime() + newDelaySeconds;

    if (task.time === newTime) return true;

    const index = thinkQueue.indexOf(task);
    if (index === -1) return false;
    thinkQueue.splice(index, 1);

    task.time = newTime;

    let insertIndex = 0;
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        if (thinkQueue[i].time <= newTime) {
            insertIndex = i + 1;
            break;
        }
    }
    thinkQueue.splice(insertIndex, 0, task);

    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }

    return true;
}

/**
 * Think循环处理函数
 */
function RunThinkQueue() {
    const currentTime = Instance.GetGameTime();

    while (thinkQueue.length > 0 && thinkQueue[0].time <= currentTime) {
        const task = thinkQueue.shift();
        if (!task) return;
        taskMap.delete(task.id);
        try {
            task.callback();
        } catch (e) {
            // 避免回调异常中断队列处理
        }
    }

    if (thinkQueue.length > 0) {
        Instance.SetNextThink(thinkQueue[0].time);
    }
}

// 设置Think循环
Instance.SetThink(RunThinkQueue);

/**
 * 创建一个循环延时任务
 * @param {number} times 总执行次数（必须 >= 1）
 * @param {number} intervalSeconds 每次执行的间隔秒数
 * @param {(current: number) => void} callback 每次执行时的回调，参数 current 表示当前是第几次执行（从 1 开始）
 * @returns {{ cancel: () => void, getRemaining: () => number }}
 */
function RepeatDelay(times, intervalSeconds, callback) {
    if (times <= 0) {
        return { cancel: () => { }, getRemaining: () => 0 };
    }

    let remaining = times;
    let currentTaskId = 0;
    let cancelled = false;

    const run = () => {
        if (cancelled) return;

        const current = times - remaining + 1;
        try {
            callback(current);
        } catch (e) {
            // 吞掉异常，避免中断后续循环
        }

        remaining--;
        if (remaining > 0 && !cancelled) {
            currentTaskId = Delay(intervalSeconds, run);
        } else {
            currentTaskId = 0;
        }
    };

    currentTaskId = Delay(intervalSeconds, run);

    return {
        cancel: () => {
            cancelled = true;
            if (currentTaskId !== 0) {
                CancelDelay(currentTaskId);
                currentTaskId = 0;
            }
        },
        getRemaining: () => remaining,
    };
}