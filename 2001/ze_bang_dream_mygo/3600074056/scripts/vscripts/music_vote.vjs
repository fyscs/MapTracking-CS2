const musicList = [haruhikage, encoder, namaeNoNaiKaibutsu, theTempest, tengokuJigokuguni, mayoiuta, hitoshizuku, beepBeepImASheep, theOtherSide, myDemons, mujinku, rrharil, terrasphere, dossolesHoliday, silhouetteDance, cornerstoneCorolla, refrain, imprisonedXII, tanebi, internetOverdose, feastOfMouse, hatedByLife, seeYouAgain, musicaCaelestis, kimitoatsumatteSeizaninaretara, jericho, oborozuki, tVsShark, yukiNoShizukuAmeNoOto, beethovenVirus, lOUDER, namelessPassion, daDongBei, maleFemale, iAlwaysDo, rageStrikes, distortedFate, takeRisshu, neoAspect, universalCollapse, miiro, mortalWithYou, nceSBurn, shukuseiLoliKamiRequiem, odysseus, fireBird, songIAm, braveShine, internetYamero, dearYou, gongXiFaCai, newYorkBackRaise, theFarSideStarSFarewell, theTaleOfACruelWorld, umapyoiDensetsu, raiseUpYourBat, suiHua, daKeJian, noMore, duvet, utakotoba, reverie, bye, ray, dieForYou, maWaRe, gris, sinosDeNatal, marenol, reloaded, welkius, goodForTune, bokuNoWaFuu, noObj, originalMe, gessou, barricades, cutieMewMewMagic, felysFinalRemix, nightDancer, pupa, theOtherSideOfParadise, tracenOndo, everythingWillFreeze, infinityHeaven1125x, inhuman, tianZhenDeXiangPi, zongZhuLianXieJi, bangYouDeJiu, aetherCrestAstralCelestial, apollo, deinosPhainein, designant, desultorySignals, entranceToTheChaos, exoplanetaryMirage, infiniteStrife, littleSilentSnow, liveFastDieYoung, rainOfConflictInARadiantAbyss, rivenPilgrimage, sargasso, smokeInside, xodus, huaYuYueTanDaoTui20Nian, tsukuyomiNiNaru, shinwa, zattouBokuraNoMachi, yuAiSiFengBan, aoNoSumika];

// 排序序列在脚本初始化时自动计算一次并填入
// 注意：cs_script VM 不支持 localeCompare（会触发 ICU error），改用纯字符串比较
const MusicListSequence = {
    newToOld: [...musicList].sort((a, b) => (b.date.getTime?.() || 0) - (a.date.getTime?.() || 0)),
    oldToNew: [...musicList].sort((a, b) => (a.date.getTime?.() || 0) - (b.date.getTime?.() || 0)),
    aToZ: [...musicList].sort((a, b) => cmpStr(String(a.name), String(b.name))),
    zToA: [...musicList].sort((a, b) => cmpStr(String(b.name), String(a.name))),
}

/**
 * @param {string} x 
 * @param {string} y 
 */
function cmpStr(x, y) {
    return x < y ? -1 : (x > y ? 1 : 0);
}

// ===== 投票 HUD 控制逻辑（custom_hud_layout） =====

/* ============================ 配置 ============================ */
const VOTE_CONFIG = {
    /** 投票持续时间（秒） */
    voteDuration: 30,
    /** 随机抽取候选数量 */
    maxRandomCandidates: 5,
};

/**
 * 每玩家 HUD 实体的「模板实体」targetname。
 * Hammer 里把 custom_hud_layout 包在这个 point_template 中：实体本身在 ForceSpawn
 * 之前并不存在于世界里，只能从 ForceSpawn 的返回值里取句柄。
 */
const HUD_LAYOUT_TEMP_NAME = "music_vote_layout_temp";
const HUD_PANEL_ID = "music_vote_root";
const HIDDEN_CLASS = "Hidden";
/**
 * HUD 刷新间隔（秒）。
 * ★ 1/16（每 4 个服务器 tick 才刷一次 HUD，原先是 1/64 = 每 tick 都刷）。
 *   每次 think 都要给「每名玩家」写一批 panorama 变量 / class，1/64 时 10 人局
 *   一秒就是 640 次整轮刷新，纯属浪费；降到 1/16 后调用量直接降到 1/4。
 *   这是安全的，因为：
 *   - 倒计时显示的是「整秒」，4Hz 刷新足够（最多晚 0.25s 才跳到下一格）；
 *   - 投票结束判定最多晚 0.25s（只是抽取动画晚 0.25s 开始，动画本身时长不变）；
 *   - 抽取动画的相位全部改成按「秒」算（见 REVEAL_PHASES），频闪节奏
 *     仍是 62.5ms 一张，和 1/64 时完全一致；
 *   - 点击响应是事件驱动的（OnCustomHudClicked 里同步重绘自己那块），
 *     只有「别人看到你的票数」这种广播最多晚 62.5ms；
 *   - 所有计时都用 Instance.GetGameTime()，没有任何逻辑依赖 tick 精度。
 */
const THINK_INTERVAL = 1 / 16;
/** custom_hud_layout 的 classname（从模板生成的一堆实体里靠它认人） */
const HUD_LAYOUT_CLASSNAME = "custom_hud_layout";

const MODE = { RANDOM: 0, NOMINATION: 1, FULL: 2 };

/* ---------------- 封面池结构（与 music_vote.xml 一一对应） ---------------- */
/** 每行几张卡（XML 里每行 6 张） */
const PER_ROW = 5;
/** 行数（XML 里 2 行） */
const ROW_COUNT = 2;
/**
 * 一页卡片数 = 6 x 2 = 12。
 * ★ 引擎对面板 id 总数有上限（超了会报 "The maximum number of panel ids has been
 *   reached"），所以卡片池固定只有这一页；翻页是把下一批曲目重新渲染进这 10 张卡，
 *   而不是把整个曲库枚举成卡片再平移轨道。
 */
const POOL_CAPACITY = ROW_COUNT * PER_ROW;
/**
 * 生成一张卡片的 id 表。
 * 注意：custom_hud_layout 只能把 dialog 变量设置到「实际存在的面板 id」上，
 * 因此变量要写到每个 Label 自己的 id（cover_000_title 等），不能写到不存在的
 * 上级容器（如 cover_000）。
 * 审核徽章 / NEW 徽章是静态 Label，靠槽位 class 显隐，没有 id。
 * @param {string} id 卡片前缀（cover_000 / cover_r0）
 * @param {number} row
 * @param {number} col
 */
function MakeTile(id, row, col) {
    return {
        id,
        slot: id + "_slot",
        img: id + "_img",
        btn: id + "_btn",
        row,
        col,
        txt: {
            title: id + "_title",
            stars: id + "_stars",
            noteauthor: id + "_noteauthor",
            musicauthor: id + "_musicauthor",
            sponsor: id + "_sponsor",
            tags: id + "_tags",
            votecount: id + "_votecount",
        },
        bar: id + "_barfill",
    };
}

/**
 * 池下标 -> 卡片 id 前缀：0 -> "cover_000"，11 -> "cover_011"
 * @param {number} i
 * @returns {string}
 */
function Pad3(i) {
    if (i < 10) return "cover_00" + i;
    if (i < 100) return "cover_0" + i;
    return "cover_" + i;
}

/**
 * 卡片池：数组下标 = 曲目序号（与 music_vote.xml 的枚举顺序一致）。
 * 行优先填卡：行 = floor(i / PER_ROW)，列 = i % PER_ROW，
 * 和 music_vote.xml 里从上到下、从左到右的枚举顺序一致。
 * @type {*}
 */
const TILES = [];
for (let i = 0; i < POOL_CAPACITY; i++) {
    TILES.push(MakeTile(Pad3(i), Math.floor(i / PER_ROW), i % PER_ROW));
}
/* 随机抽取模式不再单独开一套卡片：直接把 5 首候选渲染进池子的前 5 张卡，
   用 .CoverWindow.RandomMode 把它们放大成候选大卡 —— 池子卡片的贴图是验证过可用的。 */

/** 审核状态 class（渲染时需要清除的旧状态） */
const REVIEW_CLASSES = ["ReviewStable", "ReviewAlpha", "ReviewPerf"];
/** 宽度阶梯 class */
const WIDTH_CLASSES = [];
for (let i = 0; i <= 100; i += 5) WIDTH_CLASSES.push("w" + i);

/* ============================ 全局状态 ============================ */
/**
 * 每名玩家的专属 HUD 实体：slot -> CustomHudLayout。
 * ★ 一个实体只服务一名玩家；实体不存在（或已被清理）时由 GetLayoutFor 现生成。
 * @type {Map<number, CustomHudLayout>}
 */
const playerLayouts = new Map();
/**
 * 本轮投票「共享的曲目集合」（全玩家共用，顺序与玩家无关）：
 *   - 随机模式：SetRandomCandidates() 抽出的 5 首候选；
 *   - 其他模式：整个曲库 musicList（只用于票数统计 / 结束抽取，顺序没有意义）。
 * 玩家各自看到的排序与分页由 ListFor(slot) / PoolFor(slot) 决定，不体现在这里。
 * ★ 只读：不要原地 push / sort 这个数组。
 * @type {Note[]}
 */
let fullList = /** @type {Note[]} */ ([]);
let currentMode = MODE.RANDOM;
let voteActive = false;
let voteEnd = false;
let voteStartTime = 0;
let voteEndTime = 0;
/** 默认排序方式：每个玩家一开始都用它（单机时与原全局 sortKey 初值一致） */
const DEFAULT_SORT = "newToOld";
// 调试模式（显示模式切换按钮，正常由地图指定模式无需显示）
let debugMode = false;
// 每个玩家选中/已投的歌曲名
const playerSelected = /** @type {Map<number,string>} */ (new Map());
const playerVoted = /** @type {Map<number,string>} */ (new Map());
/* ---------------- 每玩家视图状态（页码 / 排序，互不影响） ---------------- */
/** 每玩家当前页码：slot -> 页码（0 起；缺省 0） */
const playerPage = /** @type {Map<number,number>} */ (new Map());
/** 每玩家当前排序 key：slot -> SORT_ORDER 中的一项（缺省 DEFAULT_SORT） */
const playerSort = /** @type {Map<number,string>} */ (new Map());
// 全局票数（name -> count）
const voteCounts = /** @type {Object<string, number>} */ ({});
// 提名（去重集合，按提名顺序）
const nominations = /** @type {Array<string>} */ ([]);
// 本帧需要重绘的玩家（避免每 tick 全量重绘）
const dirtySlots = /** @type {Set<number>} */ (new Set());

/** 卡片渲染缓存（按玩家槽位隔离）：避免重复写 dialog 变量 / class */
const POOL_TOTAL = TILES.length;
/** @type {Map<number, {sig: string[], bar: string[], cover: string[], state: string[][]}>} */
const renderCache = new Map();

/**
 * 取某个玩家的渲染缓存
 * @param {number} slot
 */
function CacheOf(slot) {
    let c = renderCache.get(slot);
    if (!c) {
        c = {
            sig: new Array(POOL_TOTAL).fill(""),
            bar: new Array(POOL_TOTAL).fill(""),
            cover: new Array(POOL_TOTAL).fill(""),
            state: /** @type {string[][]} */ (new Array(POOL_TOTAL).fill(null).map(() => [])),
        };
        renderCache.set(slot, c);
    }
    return c;
}

/**
 * 让所有玩家的卡片缓存失效（内容 / 票数变化时调用）
 * @param {number} [onlySlot]
 */
function InvalidateCache(onlySlot) {
    if (onlySlot === undefined) {
        for (const c of renderCache.values()) {
            for (let i = 0; i < POOL_TOTAL; i++) c.sig[i] = "";
        }
    } else {
        const c = renderCache.get(onlySlot);
        if (c) for (let i = 0; i < POOL_TOTAL; i++) c.sig[i] = "";
    }
}

/**
 * 切换模式时彻底丢弃缓存：两套卡片池的“空卡片”签名相同，
 * 不清空会导致随机模式的卡片残留旧文本。
 */
function ResetCache() {
    // ★ 只清内容签名，不能整个 clear()：
    //   cover/bar/state 记录的是「面板上现在挂着哪些 class」，清掉它们会让
    //   RenderCard 不再移除旧的封面 class，于是 cc_xxx 越积越多，
    //   CSS 里靠后的那条规则胜出 → 卡片显示上一轮的封面（贴图串图）。
    for (const c of renderCache.values()) {
        for (let i = 0; i < POOL_TOTAL; i++) c.sig[i] = "";
    }
}

/* ============================ 与 music_game.js 的通信 ============================ */
/** music_game.js 所在 point_script 实体的名字 */
const MUSIC_GAME_ENTITY = "music_game_script";

/**
 * 向 music_game.js 发送一个脚本输入（RunScriptInput）
 * @param {string} input - music_game.js 中注册的 ScriptInput 名
 */
function FireMusicGame(input) {
    Instance.EntFireAtName({ name: MUSIC_GAME_ENTITY, input: "RunScriptInput", value: input });
}

/**
 * 把中选曲目交给 music_game.js 解析。
 * 是否使用随机谱面由 music_game.js 判断：先发 "Random" 再发曲名。
 * @param {Note|null|undefined} note
 */
function SelectMusic(note) {
    if (!note) return;
    if (note.isRandom) FireMusicGame("Random");
    if (note.speed !== 1) Instance.EntFireAtName({ name: "music_game_runspeed" + note.speed + "_relay", input: "Trigger" });
    if (note.health !== 100) {
        for (const player of Instance.FindEntitiesByClass("player")) {
            if (!player.IsValid() || player.GetTeamNumber() !== 3) continue;
            player.SetMaxHealth(note.health);
            player.SetHealth(note.health);
        }
    }
    FireMusicGame(note.name);
}

/* ============================ 每玩家 HUD 实体管理 ============================ */
/** 生成失败只提示一次，避免每名玩家刷一条 */
let loggedLayoutError = false;

/**
 * @param {string} reason
 */
function LogLayoutError(reason) {
    if (loggedLayoutError) return;
    loggedLayoutError = true;
    Instance.Msg("[music_vote] " + reason);
}

/**
 * 用模板实体给一名玩家生成专属 HUD 实体。
 * ★ music_vote_layout_temp 是 point_template：custom_hud_layout 在 ForceSpawn 之前
 *   并不存在于世界里，所以只能从 ForceSpawn 的返回值里取句柄。
 * ★ 生成的实体是永久实体（不会随面板关闭 / 回合重置自动消失），不用了必须手动清理，
 *   清理只认 EntFire 的 Kill —— 见 KillLayout。
 * @param {number} slot
 * @returns {CustomHudLayout|undefined}
 */
function SpawnPlayerLayout(slot) {
    const temp = /** @type {PointTemplate|undefined} */ (Instance.FindEntityByName(HUD_LAYOUT_TEMP_NAME));
    if (!temp || !temp.IsValid()) {
        LogLayoutError("找不到模板实体 " + HUD_LAYOUT_TEMP_NAME + "（Hammer 里把 custom_hud_layout 包进 point_template）");
        return undefined;
    }
    /** @type {CustomHudLayout|undefined} */
    let layout = undefined;
    const spawned = temp.ForceSpawn();
    if (spawned) {
        for (const ent of spawned) {
            if (!ent || !ent.IsValid()) continue;
            if (ent.GetClassName() !== HUD_LAYOUT_CLASSNAME) continue;
            if (!layout) layout = /** @type {CustomHudLayout} */ (ent);
            // 模板里万一包了多个 layout，只留第一个，其余当场清掉，避免多出一块没人管的 HUD。
            // （模板里如果还包了别的辅助实体，这里不动它们，免得拆散地图作者的连线。）
            else Instance.EntFireAtTarget({ target: ent, input: "Kill" });
        }
    }
    if (!layout) {
        LogLayoutError("模板 " + HUD_LAYOUT_TEMP_NAME + " 没有生成 " + HUD_LAYOUT_CLASSNAME + " 实体");
        return undefined;
    }
    playerLayouts.set(slot, layout);
    // 新实体 = 全新的面板树：该 slot 的渲染缓存必须整个丢掉，
    // 否则缓存会以为封面 / 进度条 / 状态 class 已经写过了，卡片上什么都不会出现。
    renderCache.delete(slot);
    lastRevealCover.delete(slot);
    // ★ 关键不变量：实体级（= 所有玩家）先把根面板收起来，只有它主人的逐玩家覆写能看到它。
    //   （music_vote.xml 里 music_vote_root 初始就带 Hidden，这里再声明一次是兜底。）
    layout.SetHasClass(HUD_PANEL_ID, HIDDEN_CLASS, true);
    layout.SetInputCaptureEnabled(slot, false);
    return layout;
}

/**
 * 取某名玩家自己的 HUD 实体：没有（或已经被清理）时现生成一个。
 * @param {number} slot
 * @returns {CustomHudLayout|undefined}
 */
function GetLayoutFor(slot) {
    if (slot < 0) return undefined;
    const cached = playerLayouts.get(slot);
    if (cached) {
        if (cached.IsValid()) return cached;
        // 被别的途径清掉了（例如回合重置带走模板生成的实体）：丢掉死引用，重新生成
        playerLayouts.delete(slot);
        renderCache.delete(slot);
        lastRevealCover.delete(slot);
    }
    return SpawnPlayerLayout(slot);
}

/**
 * 清理某名玩家的专属 HUD 实体。
 * ★ 生成的实体是永久实体，必须手动清理；且只能用 EntFire 给它发 Kill（其它方式无效）。
 * @param {number} slot
 */
function KillLayout(slot) {
    const layout = playerLayouts.get(slot);
    // 先摘引用再清理，保证任何后续 GetLayoutFor 都会走「重新生成」而不是拿到死句柄
    playerLayouts.delete(slot);
    renderCache.delete(slot);
    lastRevealCover.delete(slot);
    if (!layout || !layout.IsValid()) return;
    // 先交还鼠标控制，免得玩家卡在指针模式
    layout.SetInputCaptureEnabled(slot, false);
    // ★ 只能这么清：EntFire 的 Kill input
    Instance.EntFireAtTarget({ target: layout, input: "Kill" });
}

/**
 * layout 是否确实是该 slot 自己的实体（防止写串到别人的 HUD 上）
 * @param {CustomHudLayout|undefined} layout
 * @param {number} slot
 * @returns {boolean}
 */
function OwnsLayout(layout, slot) {
    if (!layout || slot < 0) return false;
    if (playerLayouts.get(slot) !== layout) return false;
    return layout.IsValid();
}

/**
 * 设置根面板范围内的 dialog 变量。
 * ★ 每名玩家一个专属实体，直接写实体级（对所有玩家生效）的值即可 ——
 *   实体只对它的主人可见，不需要再产生 SetDialogVariableStringForPlayer 覆写。
 *   slot 形参留着不改调用点，同时用于校验 layout 归属。
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {string} name
 * @param {string} value
 */
function SetVar(layout, slot, name, value) {
    if (!OwnsLayout(layout, slot)) return;
    layout.SetDialogVariableString(HUD_PANEL_ID, name, value);
}

/**
 * 设置某个面板范围内的 dialog 变量
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {string} panelId
 * @param {string} name
 * @param {string} value
 */
function SetPanelVar(layout, slot, panelId, name, value) {
    if (!OwnsLayout(layout, slot)) return;
    layout.SetDialogVariableString(panelId, name, value);
}

/**
 * 给某个面板设置/移除 class
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {string} panelId
 * @param {string} className
 * @param {boolean} has
 */
function SetClass(layout, slot, panelId, className, has) {
    if (!OwnsLayout(layout, slot)) return;
    // 根面板的 Hidden 是「整块 HUD 的显隐」，只能写成该玩家自己的覆写：
    // 一旦写成实体级，所有玩家都会看到这个专属 HUD（见 SpawnPlayerLayout 注释）。
    if (panelId === HUD_PANEL_ID && className === HIDDEN_CLASS) {
        layout.SetHasClassForPlayer(slot, panelId, className, has);
        return;
    }
    layout.SetHasClass(panelId, className, has);
}

/**
 * 显示/隐藏主面板（只影响该玩家）
 * @param {number} slot
 * @param {boolean} shown
 */
function SetPanelShown(slot, shown) {
    const layout = GetLayoutFor(slot);
    if (!layout) return;
    SetClass(layout, slot, HUD_PANEL_ID, HIDDEN_CLASS, !shown);
    layout.SetInputCaptureEnabled(slot, shown);
}

/* ============================ 基础工具 ============================ */
/** 难度数字 -> ★☆ 字符串 */
/**
 * @param {number} n
 * @returns {string}
 */
function DifficultyText(n) {
    n = Number(n) || 1;
    let out = "";
    for (let i = 1; i <= 5; i++) out += (i <= n ? "★" : "☆");
    return out;
}

/**
 * revie 数字 -> 文本 + 配色 class
 * @param {number} state
 * @returns {{text: string, cls: string}}
 */
function ReviewInfo(state) {
    if (RevieState.STABLE !== undefined && state === RevieState.STABLE) return { text: "STABLE", cls: "ReviewStable" };
    if (RevieState.PERMORMENCE !== undefined && state === RevieState.PERMORMENCE) return { text: "PERF", cls: "ReviewPerf" };
    return { text: "ALPHA", cls: "ReviewAlpha" };
}

/**
 * 是否为 1 周内上新
 * @param {Note} note
 * @returns {boolean}
 */
/** 上新判定窗口（天）：基准往前这么多天内的算新谱 */
const NEW_WINDOW_DAYS = 7;
/** 上新基准（毫秒）= 曲库最新日期 与 当前时间 中较晚的一个 */
let newestChartMs = 0;

/** 当前时间（毫秒）；运行时若拿不到就返回 0 */
function NowMs() {
    if (typeof Date.now === "function") {
        const t = Date.now();
        if (t) return t;
    }
    const d = new Date();
    if (d && typeof d.getTime === "function") {
        const t = d.getTime();
        if (t) return t;
    }
    return 0;
}

/**
 * 重新计算「上新基准」。
 * ★ 必须遍历整个曲库（musicList），不能遍历 fullList：
 *   随机投票模式下 fullList 只有那 5 首候选，遍历它会把基准压到
 *   "候选里最新的那首"，于是很久以前的歌也被判成新谱。
 *   取 max(曲库最新日期, 今天) 则兼顾两种情况：
 *   - 正常情况：以今天为基准，只有最近 7 天内上架的才显示 NEW；
 *   - 数据里日期写在未来时：以那个未来日期为基准，不会整列误判。
 */
function ComputeNewestChart() {
    let max = 0;
    for (const n of musicList) {
        if (n && n.date instanceof Date) max = Math.max(max, n.date.getTime());
    }
    newestChartMs = Math.max(max, NowMs());
}

/**
 * 是否为上新谱面：日期落在「曲库最新日期」往前 NEW_WINDOW_DAYS 天内
 * @param {Note} note
 * @returns {boolean}
 */
function IsNew(note) {
    if (!note || !(note.date instanceof Date)) return false;
    if (!newestChartMs) return false;
    const diff = newestChartMs - note.date.getTime();
    return diff >= 0 && diff < NEW_WINDOW_DAYS * 24 * 60 * 60 * 1000;
}

/* ============================ 排序（每玩家独立） ============================ */
/**
 * 取某个玩家当前的排序 key（缺省 DEFAULT_SORT）
 * @param {number} slot
 * @returns {string}
 */
function GetSort(slot) {
    const k = playerSort.get(slot);
    return (k && SORT_ORDER.indexOf(k) >= 0) ? k : DEFAULT_SORT;
}

/**
 * 按给定排序方式返回完整曲库列表。
 * MusicListSequence 在脚本加载时就把 4 种顺序都排好了，这里是 O(1) 查表：
 * 不会每帧对 75 首重排，因此也不需要再按玩家缓存一份排序结果。
 * @param {string} key
 * @returns {Note[]}
 */
function GetSortedList(key) {
    return MusicListSequence[key] || musicList;
}

/**
 * 某个玩家当前排序下的完整曲库列表
 * @param {number} slot
 * @returns {Note[]}
 */
function ListFor(slot) {
    return GetSortedList(GetSort(slot));
}

/**
 * 某个玩家当前排序方式的中文名
 * @param {number} slot
 * @returns {string}
 */
function SortLabel(slot) {
    switch (GetSort(slot)) {
        case "newToOld": return "排序 · 新→旧";
        case "oldToNew": return "排序 · 旧→新";
        case "aToZ": return "排序 · A→Z";
        case "zToA": return "排序 · Z→A";
        default: return "排序 · A→Z";
    }
}

const SORT_ORDER = ["aToZ", "zToA", "newToOld", "oldToNew"];
/**
 * 循环切换「某个玩家」的排序方式（dir=1 下一项，-1 上一项），
 * 并把该玩家的页码重置回第 1 页；只影响该玩家。
 * @param {number} slot
 * @param {number} dir
 * @returns {string} 切换后的排序 key
 */
function CycleSort(slot, dir) {
    const i = SORT_ORDER.indexOf(GetSort(slot));
    const next = (i + dir + SORT_ORDER.length) % SORT_ORDER.length;
    playerSort.set(slot, SORT_ORDER[next]);
    playerPage.set(slot, 0);
    return SORT_ORDER[next];
}

/* ============================ 封面墙分页（每玩家独立） ============================ */
/** 当前模式的卡片池（随机模式复用同一池子） */
function ActiveTiles() {
    return TILES;
}

/**
 * 某个玩家当前页码（缺省 0；随机模式恒为 0）。
 * 越界时收敛到 [0, PageCount(slot)-1] 并写回，保证「页码文字」与「当前页曲目」永远一致。
 * @param {number} slot
 * @returns {number}
 */
function GetPage(slot) {
    const raw = playerPage.get(slot);
    let p = (typeof raw === "number" && raw >= 0) ? raw : 0;   // NaN 也走这里
    const pages = PageCount(slot);
    if (p > pages - 1) p = pages - 1;
    if (playerPage.get(slot) !== p) playerPage.set(slot, p);
    return p;
}

/** 某个玩家的总页数（随机模式只有一页） */
function PageCount(slot) {
    if (currentMode === MODE.RANDOM) return 1;
    return Math.max(1, Math.ceil(ListFor(slot).length / POOL_CAPACITY));
}

/**
 * 某个玩家当前页在它自己那份列表中的起始下标
 * @param {number} slot
 * @returns {number}
 */
function PageStart(slot) {
    return GetPage(slot) * POOL_CAPACITY;
}

/**
 * 某个玩家当前页要显示的曲目（长度恒为 POOL_CAPACITY，空槽位是 undefined
 * —— 渲染时会打 Hidden 收起，不占位）。
 * 随机模式例外：返回全场共享的 5 首候选，不分页。
 * 每次调用重建数组（最多 10 项）；排序用的是加载时预算好的表，这里不做重排。
 * @param {number} slot
 * @returns {Array<Note|undefined>}
 */
function PoolFor(slot) {
    const random = currentMode === MODE.RANDOM;
    const list = random ? fullList : ListFor(slot);
    const base = random ? 0 : PageStart(slot);
    const out = /** @type {Array<Note|undefined>} */ ([]);
    for (let i = 0; i < POOL_CAPACITY; i++) {
        const idx = base + i;
        out.push(idx < list.length ? list[idx] : undefined);
    }
    return out;
}

/**
 * 翻页（delta = ±1）：只改该玩家的页码，并只重绘该玩家
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {number} delta
 */
function GoPage(layout, slot, delta) {
    if (currentMode === MODE.RANDOM) return;
    const pages = PageCount(slot);
    let next = GetPage(slot) + delta;
    if (next < 0) next = pages - 1;          // 到头了绕回另一端
    if (next > pages - 1) next = 0;
    playerPage.set(slot, next);
    RefreshCards(layout, slot);
}

/* ============================ 渲染 ============================ */
/**
 * 取某首歌当前的票数与占比
 * @param {Note|undefined} note
 * @returns {{cnt: number, pct: number}}
 */
function VoteInfo(note) {
    if (!note) return { cnt: 0, pct: 0 };
    const cnt = voteCounts[note.name] || 0;
    if (currentMode === MODE.NOMINATION) return { cnt, pct: 0 };
    return { cnt, pct: renderVoteTotal > 0 ? (cnt / renderVoteTotal) * 100 : 0 };
}

/** 本轮渲染的全场总票数（RenderCards 开头刷新一次，避免每张卡都遍历全曲库） */
let renderVoteTotal = 0;

/**
 * 需要在下一次 think 里整体重绘一遍。
 * 原因：custom_hud_layout 里把某个面板由 Hidden 改成可见的同一次调用中，
 * 写在它子面板上的 class / dialog 变量会被丢掉（面板树重建），
 * 必须等下一帧再写一次才生效。随机模式那 5 张卡就是这么变空的。
 */
let redrawNextTick = false;

/**
 * 卡片内容签名：内容变化才重绘
 * @param {Note|undefined} note
 * @param {string} sel
 * @param {string} voted
 * @param {number} cnt
 * @param {string} barCls
 * @returns {string}
 */
function CardSignature(note, sel, voted, cnt, barCls) {
    if (!note) return "-";
    return note.name + "|" + sel + "|" + voted + "|" + cnt + "|" + barCls + "|" + String(IsNew(note)) + "|" + (note.sponsor || "");
}

/**
 * 渲染一张卡片
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {number} poolIndex - 在 tileSig 等缓存数组中的下标
 * @param {*} t - 卡片面板 id 组
 * @param {Note|undefined} note
 */
function RenderCard(layout, slot, poolIndex, t, note) {
    const sel = playerSelected.get(slot) || "";
    const voted = playerVoted.get(slot) || "";
    const vi = VoteInfo(note);
    const barCls = (note && currentMode !== MODE.NOMINATION)
        ? "w" + Math.min(100, Math.round(vi.pct / 5) * 5)
        : "w0";
    const sig = CardSignature(note, sel, voted, vi.cnt, barCls);
    const cache = CacheOf(slot);
    if (cache.sig[poolIndex] === sig) return;
    cache.sig[poolIndex] = sig;

    // ---- 状态 class ----
    const wanted = [];
    if (note) {
        const tags = (note.tags && note.tags.length) ? note.tags.map(t => "[" + t + "]").join("") : "";
        wanted.push("Hidden", false);
        wanted.push("HasTags", !!tags);
        wanted.push("HasSponsor", !!note.sponsor);
        wanted.push("IsNew", IsNew(note));
        wanted.push("Single", !!note.isSingle);
        wanted.push("Multi", !note.isSingle);
        // 信息行有内容才显示（空行会让卡片留白）
        wanted.push("HasMusicAuthor", !!note.musicAuthor);
        wanted.push("HasSponsor", !!note.sponsor);
        wanted.push("HasTags", !!(note.tags && note.tags.length));
        wanted.push("Selected", sel === note.name);
        wanted.push("VotedMine", voted === note.name);
        const rv = ReviewInfo(note.revie);
        wanted.push(rv.cls, true);
    } else {
        wanted.push("Hidden", true);
    }
    const prev = cache.state[poolIndex];
    for (let i = 0; i < prev.length; i += 2) {
        const name = prev[i];
        let still = false;
        for (let j = 0; j < wanted.length; j += 2) if (wanted[j] === name) { still = wanted[j + 1]; break; }
        if (!still) SetClass(layout, slot, t.slot, name, false);
    }
    for (let i = 0; i < wanted.length; i += 2) SetClass(layout, slot, t.slot, wanted[i], wanted[i + 1]);
    cache.state[poolIndex] = wanted;

    // ---- 进度条 ----
    if (cache.bar[poolIndex] !== barCls) {
        if (cache.bar[poolIndex]) SetClass(layout, slot, t.bar, cache.bar[poolIndex], false);
        SetClass(layout, slot, t.bar, barCls, true);
        cache.bar[poolIndex] = barCls;
    }

    // ---- 封面 class ----
    const coverCls = (note && note.name) ? "cc_" + note.name.toLowerCase() : "cc_none";
    if (cache.cover[poolIndex] !== coverCls) {
        if (cache.cover[poolIndex]) SetClass(layout, slot, t.img, cache.cover[poolIndex], false);
        SetClass(layout, slot, t.img, coverCls, true);
        cache.cover[poolIndex] = coverCls;
    }

    // ---- 文本（写到每个 Label 自己的 id 上） ----
    if (!note) {
        SetPanelVar(layout, slot, t.txt.title, "title", "");
        SetPanelVar(layout, slot, t.txt.stars, "stars", "");
        SetPanelVar(layout, slot, t.txt.noteauthor, "noteauthor", "");
        SetPanelVar(layout, slot, t.txt.musicauthor, "musicauthor", "");
        SetPanelVar(layout, slot, t.txt.sponsor, "sponsor", "");
        SetPanelVar(layout, slot, t.txt.tags, "tags", "");
        SetPanelVar(layout, slot, t.txt.votecount, "votecount", "");
        return;
    }
    const tags = (note.tags && note.tags.length) ? note.tags.map(t => "[" + t + "]").join("") : "";
    SetPanelVar(layout, slot, t.txt.title, "title", note.title || note.name);
    SetPanelVar(layout, slot, t.txt.stars, "stars", DifficultyText(note.difficulty));
    SetPanelVar(layout, slot, t.txt.noteauthor, "noteauthor", "谱师：" + (note.noteAuthor || "—"));
    SetPanelVar(layout, slot, t.txt.musicauthor, "musicauthor", "曲师：" + (note.musicAuthor || "—"));
    SetPanelVar(layout, slot, t.txt.sponsor, "sponsor", "感谢：" + (note.sponsor || "—"));
    SetPanelVar(layout, slot, t.txt.tags, "tags", "标签：" + (tags || "—"));
    if (currentMode === MODE.RANDOM) {
        SetPanelVar(layout, slot, t.txt.votecount, "votecount", vi.pct.toFixed(0) + "%  " + vi.cnt + "票");
    } else if (currentMode === MODE.NOMINATION) {
        SetPanelVar(layout, slot, t.txt.votecount, "votecount", "");
    } else {
        SetPanelVar(layout, slot, t.txt.votecount, "votecount", vi.cnt + " 票");
    }
}

/**
 * 重绘「该玩家」当前页的全部卡片
 * @param {CustomHudLayout} layout
 * @param {number} slot
 */
function RenderCards(layout, slot) {
    const tiles = ActiveTiles();
    const pool = PoolFor(slot);
    renderVoteTotal = TotalVotes();
    for (let i = 0; i < tiles.length; i++) {
        RenderCard(layout, slot, i, tiles[i], pool[i]);
    }
    UpdatePageUI(layout, slot);
}

/**
 * 重新按该玩家的排序 / 当前页铺一遍卡片并重绘（翻页、改排序、刷新时用）
 * @param {CustomHudLayout} layout
 * @param {number} slot
 */
function RefreshCards(layout, slot) {
    InvalidateCache(slot);
    RenderCards(layout, slot);
    UpdateHeadSub(layout, slot);
}

/**
 * 页码文字 + 翻页按钮可用状态（按该玩家的页数）
 * @param {CustomHudLayout} layout
 * @param {number} slot
 */
function UpdatePageUI(layout, slot) {
    if (currentMode === MODE.RANDOM) return;
    const pages = PageCount(slot);
    SetVar(layout, slot, "page_text", "第 " + (GetPage(slot) + 1) + " / " + pages + " 页");
    SetClass(layout, slot, "page_prev", "Disabled", pages <= 1);
    SetClass(layout, slot, "page_next", "Disabled", pages <= 1);
}

/**
 * 标题下的副信息（当前范围 / 总数 / 模式提示），按该玩家自己的排序与页码算
 * @param {CustomHudLayout} layout
 * @param {number} slot
 */
function UpdateHeadSub(layout, slot) {
    if (currentMode === MODE.RANDOM) {
        SetVar(layout, slot, "vote_sub", "");
        return;
    }
    const list = ListFor(slot);
    const page = GetPage(slot);
    const from = page * POOL_CAPACITY + 1;
    const to = Math.min(list.length, (page + 1) * POOL_CAPACITY);
    const tip = currentMode === MODE.NOMINATION ? "提名你自己想打的一首，结束后随机抽一首" : "投票选出本局要打的曲目";
    SetVar(layout, slot, "vote_sub", "当前 " + from + "-" + to + " / " + list.length + " 首  ·  第 " + (page + 1) + "/" + PageCount(slot) + " 页");
}

/**
 * 底部提示
 * @param {CustomHudLayout} layout
 * @param {number} slot
 */
/**
 * 当前票数最高的谱面（没人投票时提示暂无）
 * @returns {string}
 */
function TopVotedText() {
    let best = "";
    let bestN = 0;
    for (const n of fullList) {
        const c = voteCounts[n.name] || 0;
        if (c > bestN) { bestN = c; best = n.name; }
    }
    if (!bestN) return "暂无人投票";
    return "票数最高：" + FindNoteTitle(best) + "（" + bestN + " 票）";
}

/**
 * 
 * @param {CustomHudLayout} layout 
 * @param {number} slot 
 * @returns 
 */
function UpdateFootHint(layout, slot) {
    const voted = playerVoted.get(slot);
    const sel = playerSelected.get(slot);
    if (voted) {
        let msg;
        if (voted === "abstain") msg = "已选择随机（不指定曲目）";
        else if (currentMode === MODE.NOMINATION) msg = "已提名：" + FindNoteTitle(voted) + "  ·  当前已提名 " + nominations.length + " 首";
        else msg = "已投票：" + FindNoteTitle(voted) + "  ·  " + TopVotedText();
        SetVar(layout, slot, "foot_hint", msg);
        SetClass(layout, slot, "foot_hint", "Voted", true);
        SetClass(layout, slot, "action_vote", "Disabled", true);
        SetClass(layout, slot, "action_abstain", "Disabled", true);
        return;
    }
    SetClass(layout, slot, "foot_hint", "Voted", false);
    SetClass(layout, slot, "action_vote", "Disabled", !sel);
    SetClass(layout, slot, "action_abstain", "Disabled", false);
    // 左下角：提名模式显示已提名数量，其他模式显示当前票数最高的谱面
    const stat = currentMode === MODE.NOMINATION
        ? "当前已提名 " + nominations.length + " 首"
        : TopVotedText();
    if (sel) SetVar(layout, slot, "foot_hint", "已选中：" + FindNoteTitle(sel) + "  ·  " + stat);
    else SetVar(layout, slot, "foot_hint", stat);
}

/**
 * 当前总票数
 * @returns {number}
 */
function TotalVotes() {
    let t = 0;
    for (const n of fullList) t += (voteCounts[n.name] || 0);
    return t;
}

/**
 * 歌曲名 -> 标题
 * @param {string} name
 * @returns {string}
 */
function FindNoteTitle(name) {
    const n = musicList.find(x => x.name === name);
    return (n && (n.title || n.name)) || name;
}

/* ============================ 投票流程 ============================ */
/**
 * 开始一轮投票
 * @param {number} mode
 */
function StartVote(mode) {
    currentMode = mode;
    voteActive = true;
    voteEnd = false;
    voteStartTime = Instance.GetGameTime();
    voteEndTime = voteStartTime + VOTE_CONFIG.voteDuration;
    playerVoted.clear();
    playerSelected.clear();
    for (const k in voteCounts) delete voteCounts[k];
    nominations.length = 0;
    ResetCache();
    loggedLayoutError = false;
    if (mode === MODE.RANDOM) {
        SetRandomCandidates();
    } else {
        // 共享全集：每个玩家的排序 / 分页各自从它推导（顺序在这里没有意义）
        fullList = musicList;
    }
    ComputeNewestChart();
    // 所有玩家回到第 1 页 + 默认排序（清空 = 回落到 GetPage/GetSort 的缺省值）
    playerPage.clear();
    playerSort.clear();

    // 给每名玩家配一个专属 HUD 实体（没有就现生成）
    for (const controller of Instance.GetAllPlayerControllers()) {
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        // 还没连上的控制器不占实体：等他重生 / 连上时由 OnPlayerReset 补（见 EnsureLayoutForController）
        if (!controller.IsConnected()) { KillLayout(slot); continue; }
        const existing = playerLayouts.get(slot);
        // 复用旧实体（调试时中途切模式）才需要跑封面 class 兜底清理
        const reuse = !!(existing && existing.IsValid());
        const layout = GetLayoutFor(slot);
        if (!layout) continue;
        InitVoteUI(layout, slot, reuse);
    }
    // 关键：面板「由隐藏变可见」时，同一次调用里写下去的 class / dialog 变量会被丢掉，
    // 所以下一 tick 再整体重绘一次（随机模式那 5 张卡以前就是这么变空的）。
    redrawNextTick = true;
    Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);
}

/**
 * 初始化某名玩家的投票界面（开始投票时、投票中途连进来的玩家都走这里）。
 * @param {CustomHudLayout} layout 该玩家自己的实体
 * @param {number} slot
 * @param {boolean} cleanupCover 是否跑「清掉所有封面 class」的兜底清理：
 *   刚生成的实体是干净的面板树，不需要；只有复用旧实体时才要。
 */
function InitVoteUI(layout, slot, cleanupCover) {
    const isRandom = currentMode === MODE.RANDOM;
    playerSelected.set(slot, "");
    SetPanelShown(slot, true);
    SetVar(layout, slot, "vote_mode", ModeTitle());
    SetVar(layout, slot, "vote_title", HeadTitleText());
    SetVar(layout, slot, "vote_timer", Math.max(0, Math.ceil(voteEndTime - Instance.GetGameTime())) + "s");
    SetVar(layout, slot, "sort_label", SortLabel(slot));
    SetVar(layout, slot, "action_label", (currentMode === MODE.NOMINATION) ? "提名" : "投票");
    SetVar(layout, slot, "reveal_title", "");
    SetRevealInfo(layout, slot, undefined);
    if (cleanupCover) {
        // ★ 安全网：把卡片封面上可能残留的 cc_* class 全部清掉。
        //   ★ 这段以前被套在玩家循环里面，10 人就是 10×10×10×91 ≈ 9 万次调用，
        //     是多人时把服务器拖崩的元凶之一；现在只有复用旧实体时才跑，且每人只跑一遍。
        for (let i = 0; i < TILES.length; i++) {
            for (let k = 0; k < ALL_COVER_CLASSES.length; k++) SetClass(layout, slot, TILES[i].img, ALL_COVER_CLASSES[k], false);
            for (let k = 0; k < REVIEW_CLASSES.length; k++) SetClass(layout, slot, TILES[i].slot, REVIEW_CLASSES[k], false);
        }
    }
    // 面板显隐：封面窗口本身一直显示（抽取动画 / 随机模式都挂在它下面），
    // 用 RandomMode 收起封面墙、用 Nomination 收起票数条
    SetClass(layout, slot, "cover_window", HIDDEN_CLASS, false);
    SetClass(layout, slot, "cover_window", "RandomMode", isRandom);
    // 根面板也带上 RandomMode：随机模式下面板高度收紧到内容，避免上下大片留白
    SetClass(layout, slot, HUD_PANEL_ID, "RandomMode", isRandom);
    SetClass(layout, slot, "tool_bar", HIDDEN_CLASS, isRandom);
    SetClass(layout, slot, "mode_tabs", HIDDEN_CLASS, !debugMode);
    SetClass(layout, slot, HUD_PANEL_ID, "HideReview", isRandom);
    SetClass(layout, slot, "cover_window", "Nomination", currentMode === MODE.NOMINATION);
    SetClass(layout, slot, "close_btn", HIDDEN_CLASS, false);
    SetClass(layout, slot, HUD_PANEL_ID, "RevealActive", false);
    SetClass(layout, slot, "reveal_overlay", HIDDEN_CLASS, true);
    RenderCards(layout, slot);
    UpdateHeadSub(layout, slot);
    UpdateFootHint(layout, slot);
}

/**
 * 给一名玩家补一个专属 HUD 实体并按当前阶段初始化。
 * 投票 / 抽取动画进行中才用得上（中途连进来的玩家）。
 * @param {number} slot
 */
function AttachPlayer(slot) {
    if (slot < 0) return;
    if (!voteActive && !revealState.active) return;
    const layout = GetLayoutFor(slot);
    if (!layout) return;
    InitVoteUI(layout, slot, false);
    // 正在放抽取动画：把面板直接摆到结果形态，免得他只看到一块空的投票界面
    if (revealState.active) {
        const win = musicList.find(n => n.name === revealState.winner);
        ShowRevealFor(layout, slot, win, revealState.winnerTitle);
    }
}

/**
 * 每 tick 的兜底：给「已连接但手里还没有 HUD 实体」的玩家补一个。
 * 正常情况下 StartVote / OnPlayerReset 已经覆盖，这里只花一次 Map 查询的代价。
 */
function EnsurePlayerLayouts() {
    if (!voteActive && !revealState.active) return;
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (!controller || !controller.IsConnected()) continue;
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        const existing = playerLayouts.get(slot);
        if (existing && existing.IsValid()) continue;
        AttachPlayer(slot);
    }
}

/**
 * 随机模式：抽 5 首 stable 谱面
 */
function SetRandomCandidates() {
    const stable = musicList.filter(n => n.revie === RevieState.STABLE);
    const pool = [...stable];
    for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    fullList = pool.slice(0, VOTE_CONFIG.maxRandomCandidates);
}

/**
 * 当前模式的标题（顶部徽章）
 * @returns {string}
 */
function ModeTitle() {
    return currentMode === MODE.RANDOM ? "随机投票模式" :
        currentMode === MODE.NOMINATION ? "提名模式" : "全曲库投票模式";
}

/**
 * 大标题文本
 * @returns {string}
 */
function HeadTitleText() {
    return currentMode === MODE.RANDOM ? "选择一首想要游玩的曲子" :
        currentMode === MODE.NOMINATION ? "提名一首想要游玩的曲子" : "投票选择一首想要游玩的曲子";
}

/**
 * 投票倒计时刷新
 */
function OnVoteThink() {
    if (!voteActive) return;
    const now = Instance.GetGameTime();
    const remain = voteEndTime - now;
    if (!voteEnd) {
        for (const controller of Instance.GetAllPlayerControllers()) {
            const slot = controller.GetPlayerSlot();
            if (slot < 0) continue;
            // 倒计时只往「已经有专属实体」的玩家上写，缺实体的由 EnsurePlayerLayouts 补
            const layout = playerLayouts.get(slot);
            if (!layout || !layout.IsValid()) continue;
            SetVar(layout, slot, "vote_timer", Math.max(0, Math.ceil(remain)) + "s");
        }
    }
    // 只重绘标记为 dirty 的玩家（各自画到自己那块 HUD 上）
    if (dirtySlots.size) {
        for (const slot of dirtySlots) {
            const layout = GetLayoutFor(slot);
            if (!layout) continue;
            RenderCards(layout, slot);
            UpdateFootHint(layout, slot);
            UpdateHeadSub(layout, slot);
        }
        dirtySlots.clear();
    }
    if (remain <= 0 && !voteEnd) EndVote();
}

/**
 * 结束投票并抽出结果
 */
function EndVote() {
    if (voteEnd) return;
    voteEnd = true;
    let winner = "";
    let poolNames = [];
    if (currentMode === MODE.NOMINATION) {
        // 提名模式：可能中选的是「被提名的那几首」
        poolNames = nominations.slice();
        if (!poolNames.length) {
            // 没人提名（或都选了随机）时，等于从整个曲库随机抽一首，
            // 所以候选池就是全部曲目 —— 不能只取一首，否则抽取动画不会频闪
            poolNames = fullList.map(n => n.name);
        }
        winner = poolNames.length ? poolNames[Math.floor(Math.random() * poolNames.length)] : "";
    } else if (currentMode === MODE.RANDOM) {
        // 随机模式：候选固定是那 5 首，但中选曲仍按票数定 ——
        // 票数最高者中选，平票在其中随机；没人投票才纯随机抽一首。
        let max = 0;
        for (const n of fullList) max = Math.max(max, voteCounts[n.name] || 0);
        const tied = fullList.filter(n => (voteCounts[n.name] || 0) === max && max > 0);
        const pool = (tied.length ? tied : fullList);
        poolNames = fullList.map(n => n.name);   // 频闪候选 = 这 5 首
        winner = pool.length ? pool[Math.floor(Math.random() * pool.length)].name : "";
    } else {
        // 全曲库投票：只有平票最高的那几首可能中选
        let max = 0;
        for (const n of fullList) max = Math.max(max, voteCounts[n.name] || 0);
        const tied = fullList.filter(n => (voteCounts[n.name] || 0) === max && max > 0);
        const pool = (tied.length ? tied : fullList);
        poolNames = pool.map(n => n.name);
        winner = poolNames.length ? poolNames[Math.floor(Math.random() * poolNames.length)] : "";
    }
    revealPoolNames = poolNames;
    RevealWinner(winner);
}



/* ============================ 抽取动画 ============================ */
// 抽取动画状态机（tick 的含义见 THINK_INTERVAL，相位判断一律按「秒」算）
let revealState = { active: false, tick: 0, winner: "", winnerTitle: "" };

/**
 * 抽取动画「候选之间频闪」开关。
 * 置 false 就只显示中选曲（不再反复改 background-image），
 * 排查崩溃 / 贴图异常时可以一键关掉。
 */
const REVEAL_FLICKER_ENABLED = true;
/**
 * 轮播时每几秒换一张候选。
 * 0.0625s = 16 张/秒，和原来 1/64 间隔下「每 4 tick 换一张」完全一致 ——
 * 所以把 THINK_INTERVAL 提到 1/16 后，频闪的观感没有任何变化。
 */
const REVEAL_FLICKER_TIME = 0.0625;
/** 频闪时最多参与轮播的候选数（贴图开销考虑，池子比它大时只取前几首+中选曲） */
const REVEAL_MAX_CANDIDATES = 8;

/**
 * 抽取动画各阶段的时间点（秒，从动画开始算）。
 * ★ 全部按秒定义：THINK_INTERVAL 怎么调都不会改变动画的实际时长。
 *   括号里是原来 1/64 间隔下的 tick 数。
 */
const REVEAL_PHASES = {
    CYCLE_END: 96 / 64,     // 1.50s 快速轮播（96 tick）
    SHRINK_END: 112 / 64,   // 1.75s 定格 winner（112 tick）
    HOLD_END: 400 / 64,     // 6.25s 停留展示（400 tick）
    FADE_END: 430 / 64,     // 6.72s 淡出（430 tick）
};
/** 进入动画的前这么多秒里强制重写封面 class（≈ 原来 16 tick） */
const REVEAL_FORCE_TIME = 0.25;

/** 全部封面 class（用于一次性清理覆盖层上的残留） */
const ALL_COVER_CLASSES = ["cc_none", ...musicList.map(n => "cc_" + n.name.toLowerCase())];

/** 覆盖层上一次的封面 class（按玩家槽位隔离，避免多人轮播互相污染） */
const lastRevealCover = /** @type {Map<number,string>} */ (new Map());

/**
 * 本次抽取参与轮播的候选（最多 5 首，中选曲排在最后）。
 * 只取「封面墙上当前这一页」的曲目：这些贴图已经加载过，
 * 轮播反复换图不会像遍历整个曲库那样把贴图搞乱。
 * @type {Note[]}
 */
let revealCandidates = [];

/** 本次抽取「可能中选」的曲名（平票者 / 被提名者 / 随机候选），由 EndVote 写入 */
let revealPoolNames = [];

/**
 * 给所有「已经有专属 HUD」的玩家各执行一次 fn(layout, slot)。
 * 不在这里现生成实体：这两个命令是调试用的，没必要为没在投票的玩家凭空造 HUD。
 * @param {(layout: CustomHudLayout, slot: number) => void} fn
 */
function ForEachSlot(fn) {
    for (const controller of Instance.GetAllPlayerControllers()) {
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        const layout = playerLayouts.get(slot);
        if (!layout || !layout.IsValid()) continue;
        fn(layout, slot);
    }
}

/**
 * 组装本次抽取的候选集合（抽取开始时调用一次）
 */
function BuildRevealCandidates() {
    const winName = revealState.winner;
    const winnerNote = musicList.find(n => n.name === winName);
    const out = [];
    // 只从「可能中选的曲目」里取（平票者 / 被提名者 / 随机候选），
    // 不再把封面墙当前页的曲目都拿来闪。
    for (const name of revealPoolNames) {
        if (name === winName) continue;
        const n = musicList.find(m => m.name === name);
        if (!n) continue;
        if (out.length >= REVEAL_MAX_CANDIDATES - 1) break;
        out.push(n);
    }
    if (winnerNote) out.push(winnerNote);   // 中选曲排在最后
    revealCandidates = out;
}

/**
 * 设置抽取覆盖层显示的封面（按玩家记录，保证多人时状态确定）
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {Note} [note]
 * @param {boolean} [force] 忽略缓存强制重写一次
 */
function SetRevealCover(layout, slot, note, force, frameOnly) {
    const cls = (note && note.name) ? "cc_" + note.name.toLowerCase() : "cc_none";
    const prev = lastRevealCover.get(slot) || "";
    if (prev === cls && !force) return;
    for (const panel of (frameOnly ? ["reveal_img"] : ["reveal_img", "reveal_bg"])) {
        if (prev) SetClass(layout, slot, panel, prev, false);
        else for (const name of ALL_COVER_CLASSES) SetClass(layout, slot, panel, name, false);
        SetClass(layout, slot, panel, cls, true);
    }
    lastRevealCover.set(slot, cls);
}

function RevealWinner(winnerName) {
    voteActive = false;
    const winnerNote = musicList.find(n => n.name === winnerName);
    const winnerTitle = (winnerNote && (winnerNote.title || winnerNote.name)) || winnerName || "";
    lastRevealCover.clear();
    for (const controller of Instance.GetAllPlayerControllers()) {
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        // 每个玩家画到自己的实体上；缺实体的（提前关过面板 / 中途连进来）现补一个
        const layout = GetLayoutFor(slot);
        if (!layout) continue;
        ShowRevealFor(layout, slot, winnerNote, winnerTitle);
    }
    SelectMusic(winnerNote);
    revealState = { active: true, tick: 0, winner: winnerName, winnerTitle };
    BuildRevealCandidates();
    Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);
}

/**
 * 把某名玩家的面板摆成「抽取结果」形态
 * @param {CustomHudLayout} layout
 * @param {number} slot
 * @param {Note|undefined} winnerNote
 * @param {string} winnerTitle
 */
function ShowRevealFor(layout, slot, winnerNote, winnerTitle) {
    if (!layout || !layout.IsValid()) return;
    SetVar(layout, slot, "vote_title", winnerTitle);
    SetVar(layout, slot, "vote_mode", "本曲为");
    SetVar(layout, slot, "reveal_title", winnerTitle);
    SetRevealInfo(layout, slot, winnerNote);
    SetClass(layout, slot, HUD_PANEL_ID, HIDDEN_CLASS, false);
    layout.SetInputCaptureEnabled(slot, false);
    SetClass(layout, slot, "close_btn", HIDDEN_CLASS, true);
    SetClass(layout, slot, HUD_PANEL_ID, "RevealActive", true);
    SetClass(layout, slot, "reveal_overlay", HIDDEN_CLASS, false);
    SetClass(layout, slot, "reveal_overlay", "PhaseEnlarge", false);
    SetClass(layout, slot, "reveal_overlay", "PhaseShrink", false);
    SetClass(layout, slot, "reveal_overlay", "PhaseHold", false);
    SetClass(layout, slot, "reveal_overlay", "RevealFade", false);
    SetRevealCover(layout, slot, winnerNote || (fullList.length ? fullList[0] : undefined));
}

/**
 * 抽取结果的副标题
 * @param {Note|undefined} note
 * @returns {string}
 */
function SetRevealInfo(layout, slot, note) {
    // 和封面墙卡片一样逐行显示：每项一个 Label。
    // （dialog 变量不做富文本解析，所以不能用 <br> 拼多行，只能一行一个面板）
    if (!note) {
        SetVar(layout, slot, "reveal_stars", "");
        SetVar(layout, slot, "reveal_noteauthor", "");
        SetVar(layout, slot, "reveal_musicauthor", "");
        SetVar(layout, slot, "reveal_sponsor", "");
        SetVar(layout, slot, "reveal_tags", "");
        SetVar(layout, slot, "reveal_mode", "");
        return;
    }
    SetVar(layout, slot, "reveal_stars", DifficultyText(note.difficulty));
    SetVar(layout, slot, "reveal_noteauthor", "谱师：" + (note.noteAuthor || "—"));
    SetVar(layout, slot, "reveal_musicauthor", "曲师：" + (note.musicAuthor || "—"));
    SetVar(layout, slot, "reveal_sponsor", "感谢：" + (note.sponsor || "—"));
    SetVar(layout, slot, "reveal_tags", "标签：" + (note.tags && note.tags.length ? note.tags.map(t => "[" + t + "]").join("") : "—"));
    SetVar(layout, slot, "reveal_mode", note.isSingle ? "单人" : "多人");
    // 没有内容的行收起来，不留空行
    SetClass(layout, slot, "reveal_overlay", "HasMusicAuthor", !!note.musicAuthor);
    SetClass(layout, slot, "reveal_overlay", "HasSponsor", !!note.sponsor);
    SetClass(layout, slot, "reveal_overlay", "HasTags", !!(note.tags && note.tags.length));
}

/**
 * 抽取动画每 tick
 */
function OnRevealThink() {
    revealState.tick++;
    // 用「秒」判断阶段：THINK_INTERVAL 改了也不会影响动画实际时长
    const t = revealState.tick * THINK_INTERVAL;
    // 覆盖层刚由隐藏变可见：头 0.25s 强制重写封面 class，避免和面板显隐同帧写入被丢掉
    const force = t <= REVEAL_FORCE_TIME;
    // 本 tick 实际画到了几块 HUD：一个都没有（全掉线）时也要把状态机收掉
    let served = 0;
    for (const controller of Instance.GetAllPlayerControllers()) {
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        // 每名玩家画到自己的实体上（缺实体的由 EnsurePlayerLayouts 兜底）
        const layout = GetLayoutFor(slot);
        if (!layout) continue;
        served++;
        if (t <= REVEAL_PHASES.CYCLE_END) {
            // 候选之间快速轮播（16 张/秒，见 REVEAL_FLICKER_TIME）：
            // 只在本页候选里换图 —— 这些贴图已加载过，不会像遍历整个曲库那样串图。
            const cands = revealCandidates;
            const winIdx = cands.findIndex(n => n.name === revealState.winner);
            let idx = winIdx >= 0 ? winIdx : 0;
            if (REVEAL_FLICKER_ENABLED && cands.length > 1) {
                idx = Math.floor(t / REVEAL_FLICKER_TIME) % cands.length;
            }
            const shown = cands[idx];
            // 轮播期间只换大封面，整屏背景板留到定格时再换：每帧贴图改写量减半
            SetRevealCover(layout, slot, shown, force, true);
            if (shown) {
                SetVar(layout, slot, "reveal_title", shown.title || shown.name);
                SetRevealInfo(layout, slot, shown);
            }
            SetClass(layout, slot, "reveal_overlay", "PhaseEnlarge", true);
            SetClass(layout, slot, "reveal_overlay", "PhaseShrink", false);
            SetClass(layout, slot, "reveal_overlay", "PhaseHold", false);
        } else if (t <= REVEAL_PHASES.SHRINK_END) {
            const win = musicList.find(n => n.name === revealState.winner) || revealCandidates[revealCandidates.length - 1];
            SetRevealCover(layout, slot, win, force);
            SetVar(layout, slot, "reveal_title", revealState.winnerTitle);
            SetRevealInfo(layout, slot, win);
            SetClass(layout, slot, "reveal_overlay", "PhaseEnlarge", false);
            SetClass(layout, slot, "reveal_overlay", "PhaseShrink", true);
            SetClass(layout, slot, "reveal_overlay", "PhaseHold", false);
        } else if (t <= REVEAL_PHASES.HOLD_END) {
            SetClass(layout, slot, "reveal_overlay", "PhaseEnlarge", false);
            SetClass(layout, slot, "reveal_overlay", "PhaseShrink", false);
            SetClass(layout, slot, "reveal_overlay", "PhaseHold", true);
        } else if (t <= REVEAL_PHASES.FADE_END) {
            SetClass(layout, slot, "reveal_overlay", "PhaseHold", false);
            SetClass(layout, slot, "reveal_overlay", "RevealFade", true);
        } else {
            SetClass(layout, slot, "close_btn", HIDDEN_CLASS, false);
            SetClass(layout, slot, HUD_PANEL_ID, "RevealActive", false);
            SetClass(layout, slot, "reveal_overlay", HIDDEN_CLASS, true);
            SetPanelShown(slot, false);
            revealState.active = false;
            voteActive = false;
        }
    }
    // 一个玩家都没服务到（全掉线了）也要收掉状态机，否则 think 会永远停在这一阶段
    if (!served && t > REVEAL_PHASES.FADE_END) revealState.active = false;
    // ★ 投票 + 抽取动画都结束了：专属 HUD 实体不再需要，统一清理
    //   （永久实体必须手动清；这里连「已经没有控制器的槽位」一起收干净）
    if (t > REVEAL_PHASES.FADE_END) KillAllLayouts();
}

/**
 * 把所有还在的专属 HUD 实体清掉
 */
function KillAllLayouts() {
    for (const slot of Array.from(playerLayouts.keys())) KillLayout(slot);
}

/* ============================ 点击处理 ============================ */
/**
 * 点击封面：选中 / 取消选中。
 * 注意：这里不再试听 —— 客户端 stopsound 停不掉正在播放的音乐，
 * 试听会把上一首叠在下一首上，索性只做选中。
 * @param {number} slot
 * @param {Note|undefined} note
 */
function OnSelectCover(slot, note) {
    const layout = GetLayoutFor(slot);
    if (!layout || !note) return;
    const isSelected = playerSelected.get(slot) === note.name;
    playerSelected.set(slot, isSelected ? "" : note.name);
    // 选中态通过签名缓存自动刷新；这里让本玩家缓存失效强制重绘
    InvalidateCache(slot);
    RenderCards(layout, slot);
    UpdateFootHint(layout, slot);
    dirtySlots.add(slot);
}

/**
 * 记录一次投票
 * @param {number} slot
 */
function CastVote(slot) {
    const sel = playerSelected.get(slot) || "";
    if (!sel) return;
    if (currentMode === MODE.NOMINATION) {
        if (!nominations.includes(sel)) nominations.push(sel);
    } else {
        voteCounts[sel] = (voteCounts[sel] || 0) + 1;
    }
    playerVoted.set(slot, sel);
    BroadcastDirty(slot);
}

/**
 * 弃权（交给随机）
 * @param {number} slot
 */
function Abstain(slot) {
    if (playerVoted.has(slot)) return;
    playerVoted.set(slot, "abstain");
    BroadcastDirty(slot);
}

/**
 * 票数变化：让所有玩家下一帧重绘
 * @param {number} exceptSlot
 */
function BroadcastDirty(exceptSlot) {
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (!controller.IsConnected()) continue;      // 已断线的槽位没有 HUD 可重绘
        const s = controller.GetPlayerSlot();
        if (s < 0) continue;
        dirtySlots.add(s);
    }
    if (exceptSlot >= 0) dirtySlots.add(exceptSlot);
}


/* ============================ 事件 ============================ */
Instance.OnScriptInput("StartRandom", () => StartVote(MODE.RANDOM));
Instance.OnScriptInput("StartNomination", () => StartVote(MODE.NOMINATION));
Instance.OnScriptInput("StartFull", () => StartVote(MODE.FULL));
Instance.OnScriptInput("EndVote", () => EndVote());
Instance.OnScriptInput("ToggleDebug", () => ToggleDebug());

/**
 * 切换调试模式（显示/隐藏模式切换按钮）
 */
function ToggleDebug() {
    debugMode = !debugMode;
    for (const controller of Instance.GetAllPlayerControllers()) {
        const slot = controller.GetPlayerSlot();
        if (slot < 0) continue;
        const layout = playerLayouts.get(slot);
        if (!layout || !layout.IsValid()) continue;
        SetClass(layout, slot, "mode_tabs", HIDDEN_CLASS, !debugMode);
    }
    Instance.Msg("[music_vote] debugMode=" + debugMode);
}



// 唯一 Think：根据当前状态路由到倒计时或抽取动画
Instance.SetThink(MainThink);
Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);



function MainThink() {
    // 投票 / 抽取期间新连进来的玩家：补一个专属 HUD 实体
    EnsurePlayerLayouts();
    if (redrawNextTick) {
        redrawNextTick = false;
        if (voteActive || revealState.active) {
            ResetCache();
            for (const controller of Instance.GetAllPlayerControllers()) {
                const slot = controller.GetPlayerSlot();
                if (slot < 0) continue;
                const layout = GetLayoutFor(slot);
                if (!layout) continue;
                // 面板「由隐藏变可见」是玩家级覆写，同帧一起写下去也可能被丢掉，这里再声明一次
                SetPanelShown(slot, true);
                RenderCards(layout, slot);
                // 再声明一次封面 class：面板刚显示出来时偶发贴图没换上（表现为串图/空白），
                // 隔一帧重写一次同样的 class 就能补上。
                const tiles = ActiveTiles();
                const pool = PoolFor(slot);
                for (let i = 0; i < tiles.length; i++) {
                    const n = pool[i];
                    if (n) SetClass(layout, slot, tiles[i].img, "cc_" + n.name.toLowerCase(), true);
                }
                UpdateHeadSub(layout, slot);
                UpdateFootHint(layout, slot);
            }
        }
    }
    if (revealState.active) {
        OnRevealThink();
    } else if (voteActive) {
        OnVoteThink();
    }
    Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);
}

Instance.OnActivate(() => {
    const temp = Instance.FindEntityByName(HUD_LAYOUT_TEMP_NAME);
    Instance.Msg("[music_vote] controller active, songs=" + musicList.length + ", tiles=" + TILES.length +
        ", 模板 " + HUD_LAYOUT_TEMP_NAME + "=" + (temp && temp.IsValid() ? "OK" : "缺失"));
});

/**
 * 给「手里还没有专属 HUD」的玩家补一块。
 * ★ 触发点用 OnPlayerReset（玩家复活 / 换边 / 回合重启都会走），
 *   实测 OnPlayerActivate 会漏掉一部分连接（本图里靠它补 HUD 会有人看不到界面）。
 * 已经有实体时直接返回 —— 否则每次重生都会把界面重新初始化一遍，
 * 会清掉玩家已经选中的曲子。
 * @param {import("cs_script/point_script").CSPlayerController|undefined} controller
 */
function EnsureLayoutForController(controller) {
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    if (slot < 0) return;
    const existing = playerLayouts.get(slot);
    if (existing && existing.IsValid()) return;
    AttachPlayer(slot);
}

// 玩家连上 / 重生 / 换边 / 回合重启：只要他手里还没有自己的 HUD 就补一块
Instance.OnPlayerActivate((event) => EnsureLayoutForController(event.player));
Instance.OnPlayerReset((event) => {
    const pawn = event.player;
    if (!pawn || !pawn.IsValid()) return;
    EnsureLayoutForController(pawn.GetPlayerController());
});

// 玩家掉线：专属 HUD 实体是永久实体，没人用了必须马上清掉，否则一直挂在服务器上
Instance.OnPlayerDisconnect((event) => {
    const slot = event.playerSlot;
    if (typeof slot !== "number" || slot < 0) return;
    KillLayout(slot);
    playerSelected.delete(slot);
    playerVoted.delete(slot);
    playerPage.delete(slot);
    playerSort.delete(slot);
    dirtySlots.delete(slot);
});

// 按钮点击
Instance.OnCustomHudClicked((event) => {
    const slot = event.player ? event.player.GetPlayerSlot() : -1;
    if (slot < 0) return;
    // 写值一律写在「该玩家登记在册的那块实体」上（事件里的 event.layout 就是它，这里按槽位取更稳）
    const layout = GetLayoutFor(slot);
    if (!layout) return;
    const btn = event.buttonId;
    const alreadyVoted = playerVoted.has(slot);

    // 封面卡片：cover_<行><列>_btn / cover_r<列>_btn
    if (btn.startsWith("cover_")) {
        if (alreadyVoted) return;
        const body = btn.substring(0, btn.length - 4);   // 去掉 "_btn"
        const tiles = ActiveTiles();
        const pool = PoolFor(slot);                      // ★ 该玩家自己那一页（不是全局池）
        for (let i = 0; i < tiles.length; i++) {
            if (tiles[i].id === body) { OnSelectCover(slot, pool[i]); return; }
        }
        return;
    }
    if (alreadyVoted && (btn === "action_vote" || btn === "action_abstain")) return;
    switch (btn) {
        case "close_btn":
            // 只是把面板收起来：本轮投票 / 抽取动画还没走完，实体继续留着（抽取结束统一清理）
            SetPanelShown(slot, false);
            break;
        case "mode_random": StartVote(MODE.RANDOM); break;
        case "mode_nomination": StartVote(MODE.NOMINATION); break;
        case "mode_full": StartVote(MODE.FULL); break;
        case "sort_btn":
            if (currentMode === MODE.RANDOM) break;
            CycleSort(slot, 1);                          // 只切该玩家的排序，并回到第 1 页
            SetVar(layout, slot, "sort_label", SortLabel(slot));
            RefreshCards(layout, slot);
            break;
        case "page_prev":
            GoPage(layout, slot, -1);
            break;
        case "page_next":
            GoPage(layout, slot, 1);
            break;
        case "action_vote":
            if (!voteEnd) CastVote(slot);
            break;
        case "action_abstain":
            if (!voteEnd) Abstain(slot);
            break;
    }
});

// 作弊命令（需 sv_cheats 1）用于测试
Instance.RegisterCheatCommand("mv_random", () => StartVote(MODE.RANDOM));
Instance.RegisterCheatCommand("mv_nomination", () => StartVote(MODE.NOMINATION));
Instance.RegisterCheatCommand("mv_full", () => StartVote(MODE.FULL));
Instance.RegisterCheatCommand("mv_end", () => EndVote());
// 排序循环 + 重绘（原来用于翻页，现在封面墙靠滚轮滚动，这两个命令改用来快速看排序结果）
Instance.RegisterCheatCommand("mv_next", () => ForEachSlot((l, s) => GoPage(l, s, 1)));
Instance.RegisterCheatCommand("mv_prev", () => ForEachSlot((l, s) => GoPage(l, s, -1)));
// mv_reveal 是调试命令：随机模式用共享候选，其他模式用默认排序的第 1 首（原来取全局排序的头部）
Instance.RegisterCheatCommand("mv_reveal", () => {
    const l = (currentMode === MODE.RANDOM) ? fullList : GetSortedList(DEFAULT_SORT);
    RevealWinner(l.length ? l[0].name : "");
});
Instance.RegisterCheatCommand("mv_debug", () => ToggleDebug());
// 查看当前有几块专属 HUD 实体（排查实体泄漏 / 互串用）
Instance.RegisterCheatCommand("mv_layouts", () => {
    const parts = [];
    for (const [slot, layout] of playerLayouts) parts.push(slot + (layout && layout.IsValid() ? "" : "(已失效)"));
    const ctrls = [];
    for (const c of Instance.GetAllPlayerControllers()) ctrls.push(c.GetPlayerSlot() + (c.IsConnected() ? "" : "(未连接)"));
    Instance.Msg("[music_vote] 专属 HUD 实体 " + playerLayouts.size + " 个：[" + (parts.join(", ") || "无") + "]" +
        " | 控制器：[" + (ctrls.join(", ") || "无") + "]" +
        " | 投票中=" + voteActive + " 抽取中=" + revealState.active + " | think=" + Math.round(1 / THINK_INTERVAL) + "Hz");
});
// 兜底：手动把还没清理的专属 HUD 实体全清掉
Instance.RegisterCheatCommand("mv_killhud", () => {
    const n = playerLayouts.size;
    KillAllLayouts();
    Instance.Msg("[music_vote] 已清理 " + n + " 块专属 HUD 实体");
});
