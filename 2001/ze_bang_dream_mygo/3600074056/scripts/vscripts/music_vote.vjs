import { Instance, CustomHudLayout, PointTemplate } from "cs_script/point_script";

/**
 * @file 音游投票 HUD 控制器（custom_hud_layout）
 * @copyright 2026 皮皮猫233 <https://steamcommunity.com/profiles/76561198199142327/>
 * @created 2026/9/8
 * @version 0.4.0
 *
 * 由 main.js 拆分而来：
 *   - 本文件：曲库元数据（Note / musicList）+ 投票 HUD 控制逻辑
 *   - music_game.js：谱面数据 + 谱面解析逻辑
 *
 * 选出曲目后，本文件通过 RunScriptInput 把 "Random"（仅 isRandom 曲目）与曲名
 * 发给 music_game.js 解析谱面；"Start" 由地图实体触发。
 *
 * ── 0.3.0 界面重做 ──────────────────────────────────────────────
 * 「全曲库封面墙」：整个曲库一次性铺进固定卡片池，靠滚轮纵向浏览。
 *   - 卡片池 = 24 行 × 5 列 = 120 张（id = cover_<池下标，3 位补零>），
 *     行优先：行 = floor(i / 5)，列 = i % 5。
 *     当前曲库 75 首，剩下 45 张就是给后续新增谱面预留的。
 *   - 封面区是纵向滚动容器（overflow: squish scroll），滚轮即可浏览全曲库，
 *     不再做横向平移分页（横向分页最多只能看到前两页，看不到整个曲库）。
 *   - 曲库没铺满时，多余槽位打上 Hidden（visibility: collapse）收起，不占位。
 *   - 随机抽取模式另外用 5 张横排大卡（id = cover_r0..r4）。
 *
 * ── 0.4.0 每名玩家一个专属 HUD 实体 ──────────────────────────────
 * 旧版所有玩家共用同一个 custom_hud_layout，内容只能靠 SetXxxForPlayer 的逐玩家覆写
 * 区分，多人时覆写量爆炸（尤其 StartVote 里那段被套在玩家循环里的封面 class 兜底清理，
 * 10 人就是 10×10×10×91 ≈ 9 万次调用），会把服务器拖崩。
 * 现在改成「每人一个专属 HUD 实体」：
 *   - 地图里把 custom_hud_layout 包进 point_template「music_vote_layout_temp」，
 *     脚本用 ForceSpawn 生成、并从返回值里拿实体句柄（SpawnPlayerLayout）；
 *   - 生成的实体是永久实体，不用了必须手动清理，且只能用 EntFire 发 Kill（KillLayout）；
 *   - 实体里的面板只对「它的主人」显示：实体级 Hidden 保持 true（music_vote.xml 里
 *     music_vote_root 本来就带 Hidden），只给主人写一条逐玩家覆写把它露出来；
 *   - 其余写变量 / 写 class 一律走实体级接口（不再产生 ForPlayer 覆写），
 *     因为一个实体只服务一名玩家。
 *
 * ── 0.4.0 其它改动 ──────────────────────────────────────────────
 *   - HUD 刷新间隔 THINK_INTERVAL 从 1/64 降到 1/16（调用量直接降到 1/4）；
 *     抽取动画的相位改成按「秒」判断，所以动画时长与频闪节奏和原来完全一致。
 *   - 中途连进来的玩家改用 OnPlayerReset 补 HUD（OnPlayerActivate 实测会漏）。
 *   - 新增调试命令：mv_layouts（看有几块专属实体 / 控制器列表 / think 频率）、
 *     mv_killhud（手动把专属实体全清掉）。
 */

const RevieState = {
    STABLE: 0,
    ALPHA: 1,
    PERMORMENCE: 2
}

/**
 * 注册谱面上架日期。参数与曲库表一致：(年, 月, 日)，**月为 1-based**（写 11 就是 11 月）。
 * JS 原生 Date 的月是 0-based，这里内部把月 -1 一次，调用处直接照抄表格即可。
 * @param {number} year
 * @param {number} month 1-12
 * @param {number} day
 * @returns {Date}
 */
function RegDate(year, month, day) {
    return new Date(year, month - 1, day);
}
class Note {
    /**
     * @param {{
     * name: string,
     * title: string,
     * musicAuthor?: string,
     * noteAuthor: string,
     * difficulty: 1 | 2 | 3 | 4 | 5,
     * date: Date,
     * tags: string[],
     * isRandom?: boolean,
     * revie?: number,
     * isSingle?: boolean,
     * speed?: number,
     * health?: number,
     * sponsor?: string,
     * }} param0 
     */
    constructor({ name, title, musicAuthor, noteAuthor, difficulty, date, tags, isRandom = false, revie = RevieState.ALPHA, isSingle = false, speed = 1, health = 100, sponsor }) {
        this.name = name;
        this.title = title;
        this.musicAuthor = musicAuthor;
        this.noteAuthor = noteAuthor;
        this.difficulty = difficulty;
        this.date = date;
        this.tags = tags;
        this.isRandom = isRandom;
        this.revie = revie;
        this.isSingle = isSingle;
        this.speed = speed;
        this.health = health;
        this.sponsor = sponsor;
    }
}

