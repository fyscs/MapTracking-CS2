import { CSPlayerPawn, Instance } from "cs_script/point_script";

Instance.OnScriptInput("AddMoney", (inputData) => {
    const player = /** @type {CSPlayerPawn} */ (inputData.activator);
    if (!player || !player.IsValid()) return;
    const controller = player.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    controller.AddMoneySpendableNow(200);
});