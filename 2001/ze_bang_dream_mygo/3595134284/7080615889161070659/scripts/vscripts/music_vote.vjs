// Generated by StarDance v4121 @91db1ad
// https://github.com/Kxnrl

import { Instance, Entity } from "cs_script/point_script";

/**
 * 投票系统
 * 此脚本由皮皮猫233编写
 * 仅供MyGO地图使用
 * 交流学习请联系作者
 * 2026/6/7
 */

const voteState = [0, 0, 0, 0, 0, 0, 0];
let voteEnd = false;

Instance.OnScriptInput("Add", (inputData) => {
    const caller = inputData.caller;
    if(!caller || !caller.IsValid()) return;
    // 获取投票编号
    const voteSuffix = Number(caller.GetEntityName().match(/\d+/)?.[0] || 0);
    voteState[voteSuffix - 1] += 1;
    VoteShow(voteSuffix);
});

Instance.OnScriptInput("Subtract", (inputData) => {
    const caller = inputData.caller;
    if(!caller || !caller.IsValid()) return;
    // 获取投票编号
    const voteSuffix = Number(caller.GetEntityName().match(/\d+/)?.[0] || 0);
    voteState[voteSuffix - 1] -= 1;
    VoteShow(voteSuffix);
});

Instance.OnScriptInput("Compare", (inputData) => {
    voteEnd = true;
    const winnerSuffix = voteState.indexOf(Math.max(...voteState)) + 1;
    Instance.EntFireAtName({ name: "music_vote_*_" + winnerSuffix + "_relay", input: "Trigger" });
});

// 回合重启时重置票数
Instance.OnRoundStart(() => {
    voteEnd = false
    voteState.fill(0);
});

/**
 * 票数显示
 * @param {number} voteSuffix 
 */
function VoteShow(voteSuffix) {
    // 更改投票颜色
    const color = voteState[voteSuffix - 1] * 255 / 64;
    Instance.EntFireAtName({ name: "music_vote" + voteSuffix + "_break", input: "Color", value: { r: color, g: color, b: color, a: 255 }});

    // 使票数最高的歌曲封面进行旋转
    if (voteEnd) return;
    if (voteState[voteState.indexOf(Math.max(...voteState))] === 0) {
        Instance.EntFireAtName({ name: "music_vote*_rota", input: "SetSpeed", value: 0 });
        return;
    }
    const winnerSuffix = voteState.indexOf(Math.max(...voteState)) + 1;
    Instance.EntFireAtName({ name: "music_vote*_rota", input: "SetSpeed", value: 0 });
    Instance.EntFireAtName({ name: "music_vote" + winnerSuffix + "_rota", input: "SetSpeed", value: 1 });
}