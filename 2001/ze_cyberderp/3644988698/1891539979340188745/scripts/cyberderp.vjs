import { Console, Entities, Instance, CSPlayerPawn, CSGearSlot } from "cs_script/point_script";

const script_ent_name = "ps_script";
let script_ent = null;
const hud_ent_name = "hud_hint";
let hud_ent = null;
const bound_ent_name = "temp_boing";
let bound_ent = null;

let cleard = [ false, false, false, false ]; // Tollary, Hexahedron, Magic, Trampolines
//let cleard = [ true, false, true, true ];
let playing = null;
let autism = false;

let intrigger = new Set();
let bossid = null;
let bossphys = null;
let indus = false;
let inboss = false;
let minion = false;

let boss_attack = 0;
let boss_breath = true;
let boss_vortex = true;
let boss_freezer = true;
let boss_attacking = true;

// General
Instance.OnRoundStart(() => {
	Console.Log(`[CyberScript] RoundStart`);
	Console.Log(`[CyberScript] Status: Tollary ${cleard[0]} | Hexahedron ${cleard[1]} | Magic ${cleard[2]} | Trampolines ${cleard[3]}`);
	playing = null;
	intrigger.clear();
	bossid = null;
	bossphys = null;
	indus = false;
	inboss = false;
	minion = false;
	if(!script_ent?.IsValid())
		script_ent = Entities.FindByName(script_ent_name)[0];

	if(!hud_ent?.IsValid())
		hud_ent = Entities.FindByName(hud_ent_name)[0];

	if(!bound_ent?.IsValid())
		bound_ent = Entities.FindByName(bound_ent_name)[0];

	WayChoice();
});

Instance.OnScriptInput("WayComplete", () => {
	cleard[playing] = true;
	Console.Log(`[CyberScript] Saved Successfully`);
});

Instance.OnScriptInput("AutismMovement", () => {
	if (!autism)
		return;

	Entities.FireInput({ name: "cyber_autism_movement", input: "PickRandom" });
	Entities.FireInput({ name: "cyber_autism_movement_sound", input: "PickRandom" });
	const time = GetRandomFloat(1.0, 5.0);
	script_ent.FireInput({ input: "RunScriptInput", value: "AutismMovement", delay: time });
});

Instance.OnScriptInput("GiveAmmo", (event) => {
	const activator = event.activator;
	const primary = activator.FindWeaponBySlot(CSGearSlot.RIFLE);
	const secondary = activator.FindWeaponBySlot(CSGearSlot.PISTOL);
	if (primary != undefined) {
		primary.FireInput({ input: "SetAmmoAmount", value: "999" });
	}
	if (secondary != undefined) {
		secondary.FireInput({ input: "SetAmmoAmount", value: "999" });
	}
});

Instance.OnGrenadeThrow((event) => {
	const grenade = event.projectile;
	if (event.weapon?.GetData().GetName() === "weapon_hegrenade")
	{
		grenade.SetModel("models/cyber/granade.vmdl");
		grenade.FireInput({ input: "spawnflags", value: "4" });
	}
	else if (event.weapon?.GetData().GetName() === "weapon_smokegrenade")
	{
		grenade.SetModel("models/cyber/smoke.vmdl");
		grenade.FireInput({ input: "spawnflags", value: "4" });
	}

	if (autism)
		grenade.FireInput({ input: "disablegravity" });
});

Instance.OnGrenadeBounce((event) => {
	const grenade = event.projectile;
	if (grenade?.IsValid() && bound_ent?.IsValid())
		bound_ent.ForceSpawn(grenade.GetAbsOrigin());
});

Instance.OnScriptInput("StartIndus", () => {
	indus = true;
	script_ent.FireInput({ input: "RunScriptInput", value: "ShowHudMessage", delay: 0.50 });
});

Instance.OnScriptInput("TouchIndus", (event) => {
	const client = event.activator;
	if (!(client instanceof CSPlayerPawn))
		return;

	const controller = client.GetPlayerController();
	const slot = controller.GetPlayerSlot();
	if (client.GetTeamNumber() === 3 && !intrigger.has(slot))
		intrigger.add(slot);
});

Instance.OnScriptInput("StopIndus", () => {
	indus = false;
});

Instance.OnScriptInput("StartBoss", () => {
	inboss = true;
	indus = false;
	boss_attacking = true;
	script_ent.FireInput({ input: "RunScriptInput", value: "ShowHudMessage", delay: 0.50 });
});

Instance.OnScriptInput("SetBossPhys", (event) => {
	bossphys = event.caller;
});

Instance.OnScriptInput("MiniBossTeleport", (event) => {
	if (minion)
		return;

	const client = event.activator;

    if (!client || !bossphys)
        return;

	const origin = bossphys.GetAbsOrigin();
	const angle = bossphys.GetAbsAngles();

	minion = true;
	client.Teleport({ position: origin, angles: angle });
});

Instance.OnScriptInput("RecastTeleport", (event) => {
	minion = false;
});

Instance.OnScriptInput("BossAttackChosen", () => {
	if (inboss)
	{
		boss_attack++;
		if (boss_attack > 3)
			boss_attack = 0;
	}
});

Instance.OnScriptInput("BossAttackExec", () => {
	const attackReady =
		boss_attack === 0 ||
		(boss_attack === 1 && boss_vortex) ||
		(boss_attack === 2 && boss_breath) ||
		(boss_attack === 3 && boss_freezer);

	if (!inboss || !boss_attacking || !attackReady)
		return;

	boss_attacking = false;
	if (boss_attack === 0)
	{
		Entities.FireInput({ name: "boss_tetris_case", input: "PickRandom" });
		Entities.FireInput({ name: "boss_exec_maker", input: "ForceSpawn", delay: 0.01 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossAttackRecast", delay: 0.55 });
	}
	else if (boss_attack === 1 && boss_vortex)
	{
		boss_vortex = false;
		Entities.FireInput({ name: "boss_vortex", input: "Enable" });
		Entities.FireInput({ name: "boss_vortex_particles", input: "Start" });
		Entities.FireInput({ name: "boss_vortex", input: "Disable", delay: 7.1 });
		Entities.FireInput({ name: "boss_vortex_particles", input: "Stop", delay: 7.1 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossAttackRecast", delay: 7.1 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossVortexRecast", delay: 21.0 });
	}
	else if (boss_attack === 2 && boss_breath)
	{
		boss_breath = false;
		Entities.FireInput({ name: "boss_breath_igniter", input: "Enable" });
		Entities.FireInput({ name: "boss_breath", input: "Start" });
		Entities.FireInput({ name: "boss_breath_igniter", input: "Disable", delay: 3.0 });
		Entities.FireInput({ name: "boss_breath", input: "Stop", delay: 3.0 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossAttackRecast", delay: 3.1 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossBreathRecast", delay: 26.0 });
	}
	else if (boss_attack === 3 && boss_freezer)
	{
		boss_freezer = false;
		Entities.FireInput({ name: "boss_freezer_maker", input: "ForceSpawn", delay: 0.01 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossAttackRecast", delay: 0.1 });
		script_ent.FireInput({ input: "RunScriptInput", value: "BossFreezerRecast", delay: 30.0 });
	}
});

Instance.OnScriptInput( "BossAttackRecast", () => {
	boss_attacking = true;
});

Instance.OnScriptInput( "BossVortexRecast", () => {
	boss_vortex = true;
});

Instance.OnScriptInput( "BossBreathRecast", () => {
	boss_breath = true;
});

Instance.OnScriptInput( "BossFreezerRecast", () => {
	boss_freezer = true;
});

Instance.OnScriptInput("SetBoss", (event) => {
	const client = event.activator;
	const controller = client.GetPlayerController();

	bossid = controller.GetPlayerSlot();
	boss_attack = 0;
	boss_breath = true;
	boss_vortex = true;
	boss_freezer = true;
	boss_attacking = false;
});

Instance.OnScriptInput( "StopBoss", () => {
	inboss = false;
});

Instance.OnScriptInput( "ShowHudMessage", () => {
	if(!hud_ent?.IsValid())
		return;

	if (indus)
	{
		ShowIndusHud();
		script_ent.FireInput({ input: "RunScriptInput", value: "ShowHudMessage", delay: 0.50 });
	}
	else if (inboss)
	{
		ShowInbossHud();
		script_ent.FireInput({ input: "RunScriptInput", value: "ShowHudMessage", delay: 0.50 });
	}
});

function ShowIndusHud() {
	const players = Entities.FindByClass("player");
	for(let i = 0; i < players.length; i++)
	{
		const player = players[i];
		if (!player?.IsValid() || player.GetTeamNumber() !== 3)
			continue;

		const controller = player.GetPlayerController();
		if (!controller)
			continue;

		const slot = controller.GetPlayerSlot();

		if(player?.IsValid() && player.GetTeamNumber() === 3)
		{
			if (intrigger.has(slot))
				hud_ent.FireInput({ input: "SetMessage", value: "You are allowed to pass now", delay: 0.00 });
			else
				hud_ent.FireInput({ input: "SetMessage", value: "You wont be able to go to the left unless you touch the source on the right", delay: 0.00 });

			hud_ent.FireInput({ input: "ShowHudHint", activator: player, delay: 0.00 });
		}
	}
}

function ShowInbossHud() {
	if (boss_attack === 0)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Tetris", delay: 0.00 });
	else if (boss_attack === 1 && boss_vortex)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Vortex", delay: 0.00 });
	else if (boss_attack === 1 && !boss_vortex)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Vortex (Cooldown)", delay: 0.00 });
	else if (boss_attack === 2 && boss_breath)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Fire Breath", delay: 0.00 });
	else if (boss_attack === 2 && !boss_breath)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Fire Breath (Cooldown)", delay: 0.00 });
	else if (boss_attack === 3 && boss_freezer)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Freeze Orb", delay: 0.00 });
	else if (boss_attack === 3 && !boss_freezer)
		hud_ent.FireInput({ input: "SetMessage", value: "Attack > Freeze Orb (Cooldown)", delay: 0.00 });

	hud_ent.FireInput({ input: "ShowHudHint", activator: bossid, delay: 0.00 });
}

// function
function WayChoice() {
	let candidates = [];
	for (let i = 0; i < cleard.length; i++) {
		if (!cleard[i]) {
			candidates.push(i);
		}
	}

	if (candidates.length === 0) {
		for (let i = 0; i < cleard.length; i++) {
			cleard[i] = false;
			candidates.push(i);
		}

		Console.Log(`[CyberScript] Reset to chosen - Enabled Autism Mode`);
		autism = true;
	}

	playing = candidates[GetRandomInt(0, candidates.length - 1)];
	Console.Log(`[CyberScript] Selected Way: ${playing}`);
	if (playing === null)
	{
		Console.Log(`[CyberScript] Error: number is null!`);
		return;
	}
	else if (playing === 0)
	{
		Entities.FireInput({ name: "cyber_1stway_brush", input: "Disable" });
		Entities.FireInput({ name: "cyber_2ndway_brush", input: "Enable" });
		Entities.FireInput({ name: "cyber_3rd_brush", input: "Enable" });
		Entities.FireInput({ name: "cyber_3rd_stoopid", input: "Disable" });
		Entities.FireInput({ name: "cyber_4th_block", input: "Disable" });
		Entities.FireInput({ name: "Cyber_Element_case1", input: "PickRandom" });
		Entities.FireInput({ name: "Cyber_inga", input: "StartSound" });
		Entities.FireInput({ name: "cyber_treasure1_case", input: "PickRandom" });
		Entities.FireInput({ name: "PEPE", input: "Start" });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * Current phase: TOTALLY NEVER SEEN * * *", delay: 6.0 });
		KillWay1();
		KillWay2();
		KillWay3();
	}
	else if(playing === 1)
	{
		Entities.FireInput({ name: "cyber_1stway_brush", input: "Enable" });
		Entities.FireInput({ name: "cyber_2ndway_brush", input: "Disable" });
		Entities.FireInput({ name: "cyber_3rd_brush", input: "Enable" });
		Entities.FireInput({ name: "cyber_3rd_stoopid", input: "Disable" });
		Entities.FireInput({ name: "cyber_4th_block", input: "Disable" });
		Entities.FireInput({ name: "cyber_boss_arenaChooser", input: "PickRandom" });
		Entities.FireInput({ name: "Cyber_BRODY", input: "StartSound" });
		Entities.FireInput({ name: "Cyber_Element_case2", input: "PickRandom" });
		Entities.FireInput({ name: "cyber_treasure2_case", input: "PickRandom" });
		Entities.FireInput({ name: "PEPE", input: "Start" });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * Current phase: CURSED HEXAHEDRON * * *", delay: 6.0 });
		KillWay0();
		KillWay2();
		KillWay3();
	}
	else if(playing === 2)
	{
		Entities.FireInput({ name: "cyber_3rd_brush", input: "Disable" });
		Entities.FireInput({ name: "cyber_3rd_stoopid", input: "Enable" });
		Entities.FireInput({ name: "cyber_4th_block", input: "Disable" });
		Entities.FireInput({ name: "Cyber_Element_case3", input: "PickRandom" });
		Entities.FireInput({ name: "cyber_magic_music", input: "StartSound" });
		Entities.FireInput({ name: "cyber_miniboss_templ", input: "KeyValue", value: "origin -3048 -2032 848" });
		Entities.FireInput({ name: "cyber_miniboss_templ", input: "ForceSpawn", delay: 0.01 });
		Entities.FireInput({ name: "cyber_treasure3_case", input: "PickRandom" });
		Entities.FireInput({ name: "PEPE", input: "Kill" });
		Entities.FireInput({ name: "Cyber_Path_*", input: "Kill" });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * Current phase: MAGIC IS REAL * * *", delay: 6.0 });
		KillWay0();
		KillWay1();
		KillWay3();
	}
	else if(playing === 3)
	{
		Entities.FireInput({ name: "cyber_4th_block", input: "Enable" });
		Entities.FireInput({ name: "cyber_4th_breakable", input: "Break", delay: 45.0 });
		Entities.FireInput({ name: "cyber_4th_hp", input: "Enable", delay: 44.0 });
		Entities.FireInput({ name: "cyber_4th_music", input: "StartSound" });
		Entities.FireInput({ name: "cyber_AFK_0", input: "Kill" });
		Entities.FireInput({ name: "Cyber_Cage_Destination", input: "Kill" });
		Entities.FireInput({ name: "Cyber_Cage_Teleport", input: "Kill" });
		Entities.FireInput({ name: "Cyber_Element_case4", input: "PickRandom" });
		Entities.FireInput({ name: "cyber_lebutton", input: "Kill" });
		Entities.FireInput({ name: "cyber_lebutton2", input: "Kill" });
		Entities.FireInput({ name: "cyber_miniboss_templ", input: "KeyValue", value: "origin 3616 -3248 -1984" });
		Entities.FireInput({ name: "cyber_miniboss_templ", input: "ForceSpawn", delay: 0.01 });
		Entities.FireInput({ name: "cyber_puzzle_case", input: "PickRandom" });
		Entities.FireInput({ name: "cyber_sewer_escape_brush", input: "Disable" });
		Entities.FireInput({ name: "PEPE", input: "Kill" });
		Entities.FireInput({ name: "Cyber_Path_*", input: "Kill" });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * Current phase: NOT TRAMPOLINES * * *", delay: 6.0 });
		Entities.FireInput({ name: "Console", input: "Command", value: "zr_infect_spawn_mz_ratio 8" });
		KillWay0();
		KillWay1();
		KillWay2();
	}

	if (autism)
	{
		Console.Log("[CyberScript] Autism Mode: true");
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * WIND: ENABLED * * *", delay: 6.0 });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * GLASSES: OFF * * *", delay: 7.0 });
		Entities.FireInput({ name: "Console", input: "Command", value: "say * * * GRAVITY: IS KILL * * *", delay: 8.0 });
		Entities.FireInput({ name: "Console", input: "Command", value: "zr_infect_spawn_mz_ratio 6" });
		Entities.FireInput({ name: "boss_surprise", input: "Kill", delay: 22.0 });
		Entities.FireInput({ name: "peno", input: "Kill", delay: 22.0 });
		Entities.FireInput({ name: "ppv_autism", input: "Enable", delay: 7.0 });
		Entities.FireInput({ name: "cyber_autism_overlay", input: "Start", delay: 7.0 });
		Entities.FireInput({ name: "cyber_autism_surprise", input: "ForceSpawn", delay: 8.0 });
		script_ent.FireInput({ input: "RunScriptInput", value: "AutismMovement", delay: 55.0 });
	}
	else
		Console.Log("[CyberScript] Autism Mode: false");
}

