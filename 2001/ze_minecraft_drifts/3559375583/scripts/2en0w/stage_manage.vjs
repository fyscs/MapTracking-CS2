let WarmupLandsPos = []
let WarmupUnderPos = []


function LowPlayersMode(){

	let human_num = GetHumans().length
	if(human_num<30 || failNum > 7){
		ForceZomibeHp =500 + human_num*300;
		ForceZomibeHpAdd = (-1-human_num/30)*failNum;
		Instance.EntFireAtTarget({ target: self, input: "runscriptinput", value: "ForceHPLoop",delay:15});	
	
	}
}

function GetHumans(){
	
	let _pl = Instance.FindEntitiesByClass("player");
	let humans = []
	for (let _i = 0; _i < _pl.length; _i++) {
		if(_pl[_i].GetTeamNumber()==3){
			humans.push(humans);
		}
	}
	return humans;
}


