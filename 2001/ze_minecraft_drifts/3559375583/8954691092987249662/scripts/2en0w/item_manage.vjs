function vector3Sub(_vec1,_vec2){
	
	let _sum = { x: _vec1.x-_vec2.x, y: _vec1.y-_vec2.y, z: _vec1.z-_vec2.z };
	return _sum;
}

function vector3LengthSquare(_vec) {
  let _sum = 0;
  _sum = (_vec.x*_vec.x)+(_vec.y*_vec.y)+(_vec.z*_vec.z)
  return _sum;
}



OnGameStart()