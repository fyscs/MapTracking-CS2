import { Instance } from "cs_script/point_script";

let self = null;


function OnGameStart(){
	Instance.Msg("item_manage loaded");
	self = Instance.FindEntityByName("item_manage")
	item_ammo_weaponcase_temp = Instance.FindEntityByName("item_ammo_weaponcase_temp")
}

Instance.OnRoundStart((event) => {
	   	
	item_ammo_weaponcase_temp = Instance.FindEntityByName("item_ammo_weaponcase_temp")

});



Instance.OnScriptInput("OnUse", (_input) => {

		if(_input.caller.GetParent().GetParent() === _input.activator){
			
			Instance.EntFireAtTarget({ target: _input.caller, input: "FireUser1", caller: _input.caller, activator: _input.activator });
			Instance.EntFireAtTarget({ target: _input.caller.GetParent(), input: "ToggleCanBePickedUp", delay: 0 });
			Instance.EntFireAtTarget({ target: _input.caller.GetParent(), input: "kill", delay: 0.01 });
			_input.caller.SetParent(_input.activator);
			_input.activator.DropWeapon(_input.activator.FindWeaponBySlot(1))

			_input.activator.GiveNamedItem("weapon_elite",0)


		}

});

function GivePlayerAmmo(_pos) {
	   let _len = 90000
       let _p = Instance.FindEntitiesByClass("player");

	   for (let _i = 0; _i < _p.length; _i++) {
			if(_len > vector3LengthSquare(vector3Sub(_p[_i].GetAbsOrigin(),_pos))){
				Instance.EntFireAtTarget({ target: self, input: "RunScriptInput", value:"SetWeaponAmmo", activator: _p[_i],delay:0.02+_i*0.02 });
			}
			
		}

		
		
};

function GivePlayerHegrenade(_pos) {
	   let _len = 90000
       let _p = Instance.FindEntitiesByClass("player");
	   let randomNum = Math.floor(2*Math.random())+1

	   for (let _i = 0; _i < _p.length; _i++) {
			if(_p[_i].GetTeamNumber()==3&&_len > vector3LengthSquare(vector3Sub(_p[_i].GetAbsOrigin(),_pos))){
				for(let num = 0;num < randomNum;num++){
					_p[_i].GiveNamedItem("weapon_hegrenade",false)
				}
			}
			
		}		
		
}

Instance.OnScriptInput("SetZombieHP", (_input) => {
	   let _len = 150000
       let _p = Instance.FindEntitiesByClass("player");
	   let _pos = _input.caller.GetAbsOrigin();

	   for (let _i = 0; _i < _p.length; _i++) {
			if(_p[_i].GetTeamNumber()==2&&_len > vector3LengthSquare(vector3Sub(_p[_i].GetAbsOrigin(),_pos))){
				_p[_i].SetHealth(300);
				_p[_i].SetMaxHealth(300);
			}
			
		}	
});

Instance.OnScriptInput("ItemAmmoUsing", (_input) => {
	let _r =Math.floor(Math.random()*9);
	let _calpos = _input.caller.GetAbsOrigin();
	let _calang = _input.caller.GetAbsAngles();	
	WeaponCaseNum = _r;
	switch(_r){
			case 0:GivePlayerAmmo(_calpos);break
			case 1:WeaponcaseSpawn(_calpos,_calang);break
			case 2:WeaponcaseSpawn(_calpos,_calang);break
			case 3:WeaponcaseSpawn(_calpos,_calang);break
			case 4:GivePlayerHegrenade(_calpos);break
			case 5:WeaponcaseSpawn(_calpos,_calang);break
			case 6:WeaponcaseSpawn(_calpos,_calang);break
			case 7:WeaponcaseSpawn(_calpos,_calang);break
			case 8:WeaponcaseSpawn(_calpos,_calang);break
			
		}
	Instance.EntFireAtTarget({ target: _input.caller, input: "alpha", value:"0", delay:0.8});
	Instance.EntFireAtTarget({ target: _input.caller, input: "kill", delay:3});
});

let item_ammo_weaponcase_temp = null;

function WeaponcaseSpawn(_casepos,_calang){

		_casepos.z=_casepos.z+10;
		let spawnNum = Math.floor(Math.pow(0.8+Math.random()*1.3,3))+1+Math.floor(Math.random()+0.01)*20;
		for (let _i = spawnNum; _i > 0; _i--) {
			item_ammo_weaponcase_temp.ForceSpawn({ 
			x:_casepos.x+Math.random()*60-30, 
			y: _casepos.y+Math.random()*60-30, 
			z:_casepos.z-10},_calang)
		}
}

Instance.OnScriptInput("ItemAmmoParticleCP", (_input) => {
		let soundpoint = WeaponCaseNum;
		if(soundpoint >4){soundpoint = 1}
		Instance.EntFireAtTarget({ target: _input.caller, input: "setdatacontrolpointx", value:soundpoint, delay:0.01})
		Instance.EntFireAtTarget({ target: _input.caller, input: "Start"})

});

let WeaponCaseModelGroup = [
	"",
	"weapons/models/m249/weapon_mach_m249.vmdl",
	"weapons/models/xm1014/weapon_shot_xm1014.vmdl",
	"weapons/models/awp/weapon_snip_awp.vmdl",
	"",
	"weapons/models/ak47/weapon_rif_ak47.vmdl",
	"weapons/models/m4a1_silencer/weapon_rif_m4a1_silencer.vmdl",
	"weapons/models/negev/weapon_mach_negev.vmdl",
	"weapons/models/m4a4/weapon_rif_m4a4.vmdl"
]
let WeaponCaseNum = 0;

Instance.OnScriptInput("SetAmmoWeaponCaseModel", (_input) => {
	if(WeaponCaseModelGroup[WeaponCaseNum]!= ""){
		_input.caller.SetModel(WeaponCaseModelGroup[WeaponCaseNum]);
	}
});

Instance.OnScriptInput("GivePlayerWeapon", (_input) => {

	if(_input.activator.GetTeamNumber()==3){
		let _w = _input.activator.FindWeaponBySlot(0);
		let _case = _input.caller;
		let _act = _input.activator;
		if(_w!= undefined){ _w.Remove()};
		switch(_case.GetModelName()){
			case WeaponCaseModelGroup[1]:_act.GiveNamedItem("weapon_m249",true);break
			case WeaponCaseModelGroup[2]:_act.GiveNamedItem("weapon_xm1014",true);break
			case WeaponCaseModelGroup[3]:_act.GiveNamedItem("weapon_awp",true);break
			case WeaponCaseModelGroup[5]:_act.GiveNamedItem("weapon_ak47",true);break
			case WeaponCaseModelGroup[6]:_act.GiveNamedItem("weapon_m4a1_silencer",true);break
			case WeaponCaseModelGroup[7]:_act.GiveNamedItem("weapon_negev",true);break
			case WeaponCaseModelGroup[8]:_act.GiveNamedItem("weapon_m4a1",true);break
			
		}
		Instance.EntFireAtTarget({ target: self, input: "RunScriptInput", value:"SetWeaponAmmo", activator: _act,delay:0.02 });
		_case.Remove();
	}
	
});

Instance.OnScriptInput("SetWeaponAmmo", (_input) => {

	let _w = _input.activator.FindWeaponBySlot(0);
	if(_w== undefined){_w = _input.activator.FindWeaponBySlot(1)}
	if(_w!= undefined){
		Instance.EntFireAtTarget({ target: _w, input: "addcontext", value:"gun_ammo_context:1"});
		Instance.EntFireAtTarget({ target: _w, input: "removecontext", value:"gun_ammo_context", delay: 40 });
		Instance.EntFireAtTarget({ target: _w, input: "FireUser1",  delay: 1,activator:_w });
		Instance.EntFireAtTarget({ target: _w, input: "addoutput", value: "onuser1>give_gun_ammo>TestActivator>>0>1"});
		
	}
//	Instance.Msg(_w.GetClassName());
	
});
