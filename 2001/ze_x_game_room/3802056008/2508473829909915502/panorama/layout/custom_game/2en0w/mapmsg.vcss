.root {
    width: 100%;
    height: 100%;
}
.horizontal-align-center {
    horizontal-align:center;
    y: 15%;
}
#box {
    flow-children: down;
}
.row {
    margin-bottom: 0px;
    text-align: center;
    horizontal-align: center;
}
.rowtext {
    padding: 0px 10px;
    font-weight: bold;
    font-size: 24px;
    opacity: 1;
    transition-property: color,opacity;
    transition-timing-function: ease-out,ease-out;
    transition-duration: 0.80s,1.00s;
}
.rowtext.hidden {
    opacity: 0;
    color: rgb(0, 255, 255);
}
.red {
    color: rgb(255, 100, 100);
}
.green {
    color: rgb(100, 255, 100);
}
.blue {
    color: rgb(100, 100, 255);
}
.yellow {
    color: rgb(255, 255, 100);
}
.orange {
    color: rgb(255, 200, 100);
}
.purple {
    color: rgb(255, 100, 255);
}
