// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

let CamMover;
let startroom_car;
let startroom_cam;

Instance.OnScriptInput("ForcePlayerCam", (event) => {
	let player = event.activator
	player.SetMoveType(0)
	let cam = player.GetCustomCamera()
	cam.SetMode(1)
	cam.Teleport(	{ position: CamMover.GetAbsOrigin(), angles:CamMover.GetAbsAngles() })
	cam.SetParent(CamMover)

});

Instance.OnScriptInput("StartCam1", (event) => {
	Instance.EntFireAtTarget({target:startroom_car, input:"setanimationlooping",value:"move",delay:2});
	Instance.EntFireAtTarget({target:startroom_cam, input:"setanimationnoresetnotlooping",value:"cam1",delay:2});
	Instance.EntFireAtTarget({target:startroom_cam, input:"setidleanimationnotlooping",value:"cam1_end",delay:2});
});

Instance.OnScriptInput("RecoverPlayerCam", (event) => {
	
	let player = event.activator
	let cam = player.GetCustomCamera()
	player.SetMoveType(1)
	cam.SetMode(0)

});

function Reset(){
	
	CamMover = Instance.FindEntityByName("CamMover")
	startroom_car = Instance.FindEntityByName("startroom_car")
	startroom_cam = Instance.FindEntityByName("cam")

	
}


Instance.OnRoundStart((event) => {
	Reset()

});


Instance.Msg("playercam_manage loaded");