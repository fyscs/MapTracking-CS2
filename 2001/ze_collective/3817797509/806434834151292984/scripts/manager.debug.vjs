function createDebugShowcaseLevel() {
  const base = ALL_LEVELS.find((level) =>
    level.requiredCapabilities.length === 0
    && level.tiles.filter((tile) => tile === 2).length === 4
  );
  if (!base) throw new Error("cannot find a valid marker layout for the debug showcase");
  const tiles = Array(CONFIG.mapSize * CONFIG.mapSize).fill(14);
  const protectedIndices = new Set();
  for (let index = 0; index < base.tiles.length; index++) {
    if (base.tiles[index] !== 2) continue;
    tiles[index] = 2;
    const markerX = index % CONFIG.mapSize;
    const markerY = Math.floor(index / CONFIG.mapSize);
    for (let dy = -1; dy <= 1; dy++) {
      for (let dx = -1; dx <= 1; dx++) {
        const x = markerX + dx;
        const y = markerY + dy;
        if (x >= 0 && x < CONFIG.mapSize && y >= 0 && y < CONFIG.mapSize) {
          protectedIndices.add(y * CONFIG.mapSize + x);
        }
      }
    }
  }
  const showcaseTiles = Object.keys(TILE_REGISTRY)
    .map(Number)
    .filter((tile) => tile !== 2 && !DEBUG_DATA.showcaseExcludedTiles.has(tile));
  const slots = tiles
    .map((_, index) => index)
    .filter((index) => tiles[index] !== 2 && !protectedIndices.has(index));
  if (showcaseTiles.length > slots.length) throw new Error("debug showcase has too many tile types");
  for (let index = 0; index < showcaseTiles.length; index++) tiles[slots[index]] = showcaseTiles[index];
  // The single registry sample is easy to miss and a random TRAPFLOOR draw
  // may leave it inert. Add two readable 3x2 patches on unused flat floor:
  // contact-collapse tile 85, then a walkway, then damage-count tile 91.
  // Never overwrite showcased types or the protected entry/exit approaches.
  let floorPatch;
  for (let y = 2; y <= CONFIG.mapSize - 4 && !floorPatch; y++) {
    for (let x = 2; x <= CONFIG.mapSize - 9; x++) {
      const area = Array.from({ length: 14 }, (_, offset) =>
        (y + Math.floor(offset / 7)) * CONFIG.mapSize + x + offset % 7);
      if (area.every(index => tiles[index] === 14 && !protectedIndices.has(index))) {
        floorPatch = { x, y };
        break;
      }
    }
  }
  if (!floorPatch) throw new Error("debug showcase has no clear floor-patch test area");
  const floorTestPlacements = [];
  for (let dy = 0; dy < 2; dy++) for (let dx = 0; dx < 7; dx++) {
    if (dx === 3) continue;
    const x = floorPatch.x + dx, y = floorPatch.y + dy;
    const tile = dx < 3 ? 85 : 91;
    const index = y * CONFIG.mapSize + x;
    tiles[index] = tile;
    floorTestPlacements.push(Object.freeze({ index, x, y, tile }));
  }
  return Object.freeze({
    id: "#debug_showcase",
    name: "Debug Showcase",
    author: "ZE Collective CS2 port",
    direction: base.direction,
    elevation: 0,
    requiredCapabilities: Object.freeze(["movement", "interactions", "liquids", "movers", "traps"]),
    debugShowcase: true,
    debugFloorTestPlacements: Object.freeze(floorTestPlacements),
    showcasedTiles: Object.freeze([2, ...showcaseTiles]),
    tileFrequency: Object.freeze({}),
    tiles: Object.freeze(tiles),
  });
}

