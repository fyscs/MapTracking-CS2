function createDebugTrapLevel() {
  const base = ALL_LEVELS.find((level) =>
    level.requiredCapabilities.length === 0
    && level.tiles.filter((tile) => tile === 2).length === 4
  );
  if (!base) throw new Error("cannot find a valid marker layout for the trap debug map");

  const tiles = Array(CONFIG.mapSize * CONFIG.mapSize).fill(14);
  const protectedIndices = new Set();
  for (let index = 0; index < base.tiles.length; index++) {
    if (base.tiles[index] !== 2) continue;
    tiles[index] = 2;
    const markerX = index % CONFIG.mapSize;
    const markerY = Math.floor(index / CONFIG.mapSize);
    // Keep the entry/exit pads and their immediate approach clear of traps.
    for (let dy = -1; dy <= 1; dy++) {
      for (let dx = -1; dx <= 1; dx++) {
        const x = markerX + dx;
        const y = markerY + dy;
        if (x >= 0 && x < CONFIG.mapSize && y >= 0 && y < CONFIG.mapSize) {
          protectedIndices.add(y * CONFIG.mapSize + x);
        }
      }
    }
  }

  const used = new Set();
  const placements = [];
  const assignments = {};
  const takeSlot = (rowStart, rowEnd) => {
    for (let y = rowStart; y <= rowEnd; y++) {
      for (let x = 1; x < CONFIG.mapSize - 1; x++) {
        const index = y * CONFIG.mapSize + x;
        if (protectedIndices.has(index) || used.has(index) || tiles[index] === 2) continue;
        // Leave a normal floor cell between trap pixels. This makes each
        // trigger readable in-game and prevents neighboring trap offsets from
        // making the test ambiguous.
        if (placements.some((placement) =>
          Math.abs(placement.x - x) + Math.abs(placement.y - y) <= 1
        )) continue;
        used.add(index);
        return { index, x, y };
      }
    }
    throw new Error(`trap debug row band ${rowStart}-${rowEnd} has no free slot`);
  };
  const place = (tile, trapName, rowStart, rowEnd) => {
    const slot = takeSlot(rowStart, rowEnd);
    tiles[slot.index] = tile;
    const assignment = { tile, debugTrap: true, debugTrapPixel: true };
    if (trapName !== undefined) assignment.trapName = trapName;
    assignments[slot.index] = Object.freeze(assignment);
    placements.push(Object.freeze({ ...slot, tile, trapName }));
  };

  // 85 is the armed floor trap and has no named entity selector.
  for (let index = 0; index < 6; index++) place(85, undefined, 2, 4);
  for (const name of TRAP_POOLS.step) place(86, name, 5, 7);
  for (const name of TRAP_POOLS.vicinity) place(87, name, 8, 10);
  for (const name of TRAP_POOLS.spawn) place(88, name, 11, 13);
  // Keep several unassigned random pixels to verify the normal random-pool
  // path as well. Named traps above already cover every definition exactly.
  for (let index = 0; index < 6; index++) place(89, undefined, 14, 16);

  return Object.freeze({
    id: "#debug_traps",
    name: "Debug Trap Pixel Lab",
    author: "ZE Collective CS2 port",
    direction: base.direction,
    elevation: 0,
    requiredCapabilities: Object.freeze(["movement", "traps"]),
    debugTraps: true,
    showcasedTiles: Object.freeze([2, 85, 86, 87, 88, 89]),
    debugTrapPlacements: Object.freeze(placements),
    debugTrapAssignments: Object.freeze(assignments),
    debugTrapSummary: placements
      .map(({ tile, trapName, x, y }) => `${tile}:${trapName ?? "random"}@${x},${y}`)
      .join(" "),
    tileFrequency: Object.freeze({}),
    tiles: Object.freeze(tiles),
  });
}

DEBUG_DATA.trapLevel = createDebugTrapLevel();

function createDebugSpiderLevel() {
  const base = ALL_LEVELS[0];
  const tiles = Array(CONFIG.mapSize ** 2).fill(14);
  const protectedIndices = new Set();
  for (let index = 0; index < base.tiles.length; index++) {
    if (base.tiles[index] !== 2) continue;
    tiles[index] = 2;
    const x = index % CONFIG.mapSize, y = Math.floor(index / CONFIG.mapSize);
    for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++)
      protectedIndices.add((y + dy) * CONFIG.mapSize + x + dx);
  }
  const assignments = {}, placements = [];
  // Four columns by three rows, with clear approaches around both markers.
  for (const y of [4, 8, 12]) for (const x of [5, 8, 11, 14]) {
    const index = y * CONFIG.mapSize + x;
    if (protectedIndices.has(index)) throw Error("spider lab overlaps a marker approach");
    tiles[index] = 88;
    const assignment = Object.freeze({ tile: 88, trapName: "thigh_spider",
      debugTrap: true, debugTrapPixel: true });
    assignments[index] = assignment;
    placements.push(Object.freeze({ index, x, y, tile: 88, trapName: "thigh_spider" }));
  }
  return Object.freeze({
    id: "#debug_spiders", name: "Debug Flat Spider Lab", author: "ZE Collective CS2 port",
    direction: base.direction, elevation: 0,
    requiredCapabilities: Object.freeze(["traps"]), debugSpiders: true, debugTraps: true,
    showcasedTiles: Object.freeze([2, 14, 88]),
    debugTrapPlacements: Object.freeze(placements), debugTrapAssignments: Object.freeze(assignments),
    debugTrapSummary: "12 thigh spiders on a flat floor; ze_debug_spiders status shows spawn heights",
    tileFrequency: Object.freeze({}), tiles: Object.freeze(tiles),
  });
}

