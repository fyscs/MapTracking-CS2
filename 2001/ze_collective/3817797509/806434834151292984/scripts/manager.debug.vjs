// Native I/O transport. No local imports, eval, shared globals or polling.
const debugController = {
  queue: [], nextId: 1, session: Math.floor(Math.random() * 0xffffffff).toString(16),
  pending: undefined, hello: false, connected: false, installed: false,
  owner: undefined, manager: undefined, request: undefined, reply: undefined,
};

function debugControllerMessage(text) { Instance.Msg(`[Collective debug] ${text}`); }
function debugControllerValid(entity) { return entity?.IsValid?.() === true; }

function resetDebugController(reason, quiet = false) {
  const transport = debugController;
  transport.queue.length = 0;
  transport.pending = undefined;
  transport.hello = false;
  transport.connected = false;
  transport.installed = false;
  transport.nextId = 1;
  transport.session = Math.floor(Math.random() * 0xffffffff).toString(16);
  // Do not alter the manager or any gameplay entities during disconnect.
  if (debugControllerValid(transport.request)) transport.request.SetEntityName("collective_debug_request");
  if (debugControllerValid(transport.reply)) transport.reply.SetEntityName("collective_debug_reply");
  if (!quiet) debugControllerMessage(reason);
}

function debugControllerWake() {
  Instance.SetNextThink(Instance.GetGameTime() + 0.01);
}

function enqueueDebugPacket(packet) {
  const text = encodeURIComponent(JSON.stringify(packet));
  if (text.length > 120000) throw Error("debug request exceeds 120000 encoded characters");
  const chunks = text.match(/.{1,80}/g) ?? [""];
  debugController.queue.push({ id: debugController.nextId++, chunks, part: 0, action: packet.action });
}

function debugControllerConnect() {
  const transport = debugController;
  transport.owner = Instance.FindEntityByName("collective_debug");
  transport.manager = Instance.FindEntityByName("manager");
  transport.request = Instance.FindEntityByName("collective_debug_request");
  transport.reply = Instance.FindEntityByName("collective_debug_reply");
  if (![transport.owner, transport.manager, transport.request, transport.reply].every(debugControllerValid)) {
    resetDebugController("missing optional debug bridge entities; formal map remains unaffected");
    return false;
  }
  transport.hello = true;
  transport.pending = { hello: true, deadline: Instance.GetGameTime() + 8 };
  Instance.EntFireAtTarget({ target: transport.manager, input: "RunScriptInput", value: "CollectiveDebugHello",
    caller: transport.request, activator: transport.owner });
  debugControllerWake();
  return true;
}

function sendDebugCommand(handler, args = "") {
  if (typeof args !== "string" || args.length > 512) {
    debugControllerMessage("arguments must be a string of at most 512 characters"); return;
  }
  const transport = debugController;
  if (transport.queue.length >= 32) { debugControllerMessage("command queue is full"); return; }
  if (transport.nextId > 999990) {
    resetDebugController("request counter reset; retry the command"); return;
  }
  if (!transport.installed) {
    const data = { ...DEBUG_DATA, showcaseExcludedTiles: [...DEBUG_DATA.showcaseExcludedTiles] };
    delete data.stageIds;
    enqueueDebugPacket({ action: "install", data });
    transport.installed = true;
    debugControllerMessage(`initializing test maps (${transport.queue[0].chunks.length} bounded frames); queued commands will run afterward`);
  }
  enqueueDebugPacket({ action: "command", handler, args });
  if (!transport.connected && !transport.hello) debugControllerConnect();
  else debugControllerWake();
}

function debugControllerThink() {
  const transport = debugController;
  if (transport.pending) {
    if (Instance.GetGameTime() > transport.pending.deadline) {
      resetDebugController("request timed out; command was not retried (to avoid duplicate effects). Retry manually.");
      return;
    }
    debugControllerWake();
    return;
  }
  if (!transport.queue.length || !transport.connected) return;
  if (![transport.owner, transport.manager, transport.request, transport.reply].every(debugControllerValid)) {
    resetDebugController("bridge entity disappeared; queued requests cancelled"); return;
  }
  const job = transport.queue[0];
  const name = `zdbgq:${transport.session}.${job.id}.${job.part}.${job.chunks.length}:${job.chunks[job.part]}`;
  if (name.length > 127) { resetDebugController("frame name too long"); return; }
  transport.request.SetEntityName(name);
  transport.pending = { id: job.id, part: job.part, deadline: Instance.GetGameTime() + 8 };
  Instance.EntFireAtTarget({ target: transport.manager, input: "RunScriptInput", value: "CollectiveDebugRequest",
    caller: transport.request, activator: transport.owner });
  debugControllerWake();
}

function debugControllerAck({ caller } = {}) {
  const transport = debugController;
  if (caller !== transport.reply || !transport.pending || !debugControllerValid(caller)) return;
  const reply = /^zdbgr:([0-9a-f]{1,8}|hello)\.(\d{1,6})\.(\d{1,4}):([01]):([a-z-]{0,32})$/.exec(caller.GetEntityName());
  if (!reply) return;
  const [, session, idText, partText, success, reason] = reply;
  if (transport.pending.hello) {
    if (session !== "hello" || idText !== "0" || partText !== "0" || success !== "1") return;
    transport.pending = undefined;
    transport.hello = false;
    transport.connected = true;
    debugControllerWake();
    return;
  }
  if (session !== transport.session || Number(idText) !== transport.pending.id
    || Number(partText) !== transport.pending.part) return;
  if (success !== "1") { resetDebugController(`manager rejected the request (${reason}); check its log`); return; }
  const job = transport.queue[0];
  if (!job || job.id !== transport.pending.id || job.part !== transport.pending.part) {
    resetDebugController("unexpected acknowledgement; queued requests cancelled"); return;
  }
  transport.pending = undefined;
  job.part++;
  if (job.action === "install" && job.part < job.chunks.length && job.part % 128 === 0)
    debugControllerMessage(`initializing test maps: ${job.part}/${job.chunks.length} frames acknowledged`);
  if (job.part === job.chunks.length) {
    transport.queue.shift();
    if (job.action === "install") debugControllerMessage("test maps ready; executing queued commands");
  }
  if (transport.queue.length) debugControllerWake();
}

Instance.SetThink(debugControllerThink);
Instance.OnScriptInput("CollectiveDebugAck", debugControllerAck);
Instance.OnScriptInput("CollectiveDebugReset", () => resetDebugController("manager reloaded; reconnect on next command", true));
Instance.OnActivate(() => debugControllerMessage("independent controller loaded; ze_debug_* commands are available"));
Instance.OnBeginRoundRestart(() => resetDebugController("round restarting", true));
Instance.OnScriptReload({ before: () => { resetDebugController("controller reloading", true); return undefined; },
  after: () => debugControllerMessage("independent controller reloaded") });

Instance.RegisterCheatCommand?.("ze_debug_event", args => sendDebugCommand("debugEventCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_audio", args => sendDebugCommand("debugAudioCommand", args));
