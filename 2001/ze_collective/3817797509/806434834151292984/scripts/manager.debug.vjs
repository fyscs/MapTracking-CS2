Instance.OnScriptInput("DebugStartRace", () => sendDebugCommand("debugRaceCommand", "start"));

Instance.RegisterCheatCommand?.("ze_debug_controller", args => {
  const action = String(args ?? "status").trim().toLowerCase() || "status";
  if (action === "reset") { resetDebugController("controller reset; next command reconnects"); return; }
  if (action !== "status") { debugControllerMessage("usage: ze_debug_controller [status|reset]"); return; }
  const transport = debugController, job = transport.queue[0];
  debugControllerMessage(`connected=${transport.connected} queued=${transport.queue.length}`
    + (job ? ` frame=${job.part + 1}/${job.chunks.length}` : " idle"));
});


Instance.RegisterCheatCommand?.("ze_debug_entwatch", args => sendDebugCommand("debugEntwatchCommand", args));
