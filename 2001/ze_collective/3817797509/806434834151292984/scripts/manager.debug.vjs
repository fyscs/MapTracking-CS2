Instance.RegisterCheatCommand?.("ze_debug_all_models", args => sendDebugCommand("debugAllModelsCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_silenthill", args => sendDebugCommand("debugSilentHillCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_traps", args => sendDebugCommand("debugTrapsCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_spiders", args => sendDebugCommand("debugSpidersCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_trap", args => sendDebugCommand("debugTrapsCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_race", args => sendDebugCommand("debugRaceCommand", args));
Instance.RegisterCheatCommand?.("ze_debug_karts", args => sendDebugCommand("debugKartsCommand", args));
