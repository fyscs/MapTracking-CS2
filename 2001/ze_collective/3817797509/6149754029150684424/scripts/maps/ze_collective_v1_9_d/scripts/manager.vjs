function colorToEntityColor(value) {
  if (Array.isArray(value) && value.length === 3) {
    const channels = value.map((channel) => Math.max(0, Math.min(255, Math.round(Number(channel) || 0))));
    return { r: channels[0], g: channels[1], b: channels[2], a: 255 };
  }
  if (value && typeof value === "object") {
    const channels = [value.r, value.g, value.b].map((channel) =>
      Math.max(0, Math.min(255, Math.round(Number(channel) || 0))));
    return { r: channels[0], g: channels[1], b: channels[2], a: 255 };
  }
  return undefined;
}

function genericRenderColor(tile, theme) {
  if (!themeProfile(theme).isGeneric || !Number.isInteger(tile)) return undefined;
  if (tile === 1) return { r: 100, g: 100, b: 150, a: 255 };
  if ([183, 184, 199].includes(tile)) return { r: 255, g: 255, b: 255, a: 255 };
  return colorToEntityColor(GENERIC_TILE_COLORS[tile]);
}

function featureRenderColor(feature, tile, theme) {
  return feature === "endButton" ? CONFIG.endButtonColor : genericRenderColor(tile, theme);
}

function isColorTile(tile) {
  return Boolean(tile && Array.isArray(tile.color) && tile.color.length === 3);
}

const THEME_RUNTIME_TERRAIN_SHAPES = Object.freeze([
  "wall",
  "floor", "floor_slope", "floor_slopehalf",
  "platform", "platform_slope", "platform_slopehalf",
  "floorceiling", "floorceiling_slope", "floorceiling_slopehalf",
  "tall", "tall_slope", "tall_slopehalf",
  "detail", "hidden", "hiddenwall",
  "platform_bridge", "assumed_floor", "trapfloor", "tunnelwall_block",
  "liquid", "liquid_tunnel", "liquid_stream", "liquid_shallow", "liquid_fall",
  "race_surface",
  "ladder", "climb", "climbhard",
  "elevator", "elevatorhuge",
  "breakable", "generic_hold", "hold", "button",
  "boost", "lowgrav", "teleport", "airslide",
  "crouch", "crouchtall",
]);
const THEME_RUNTIME_TERRAIN_SHAPE_SET = new Set(THEME_RUNTIME_TERRAIN_SHAPES);

function terrainModelsFor(theme, shape) {
  const selectedTheme = themeProfile(theme).name;
  const useTheme = selectedTheme !== "generic" && THEME_RUNTIME_TERRAIN_SHAPE_SET.has(shape);
  const models = THEME_TERRAIN_MODELS[useTheme ? selectedTheme : "generic"]?.[shape]
    ?? THEME_TERRAIN_MODELS.generic?.[shape];
  if (!Array.isArray(models) || models.length === 0) {
    throw new Error(`theme '${selectedTheme}' has no terrain model for '${shape}'`);
  }
  const natureGrass = selectedTheme === "nature" && NATURE_RANDOM_TERRAIN_SHAPES.has(shape);
  const incrementalLimit = useTheme && !natureGrass ? INCREMENTAL_THEME_MODEL_LIMITS[selectedTheme] : undefined;
  if (Number.isInteger(incrementalLimit) && incrementalLimit > 0) return models.slice(0, incrementalLimit);
                                                                            
  return models;
}

function chooseTerrainModel(theme, shape, random = Math.random) {
  const models = terrainModelsFor(theme, shape);
  const sample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
  return models[Math.floor(sample * models.length)];
}

function silentHillLightModel(model) {
  if (SILENTHILL_LIGHT_MODELS.has(model)) return model;
  const light = String(model).replace(/dark\.vmdl$/i, ".vmdl");
  return SILENTHILL_LIGHT_MODELS.has(light) ? light : undefined;
}

function silentHillDesiredModel(model) {
  const light = silentHillLightModel(model);
  if (!light) return model;
  return state.silentHillWorld.visualDark ? light.replace(/\.vmdl$/i, "dark.vmdl") : light;
}

function rememberSilentHillVisual(runtime, entity, model, request, restore) {
  if (request?.themeName !== "silenthill" || !validEntity(entity)) return model;
  const light = silentHillLightModel(model);
  if (!light) return model;
  state.silentHillWorld.visuals.set(entity, {
    light, runtime, restore,
    button: ["button", "endButton", "buttonmimic"].includes(request.feature),
    shallowJump: request.shallowJump === true,
    color: colorToEntityColor(request.renderColor) ?? { r: 255, g: 255, b: 255, a: 255 },
  });
  return silentHillDesiredModel(light);
}

function queueSilentHillVisualChange(dark) {
  const world = state.silentHillWorld;
  for (const transition of world.active) transition.record.restore?.();
  world.active.length = 0;
  world.visualDark = dark === true;
                                                                        
                                                                       
  const modelRates = new Map([...SILENTHILL_LIGHT_MODELS].map((model, index) =>
    [model, (index + 1) % SILENTHILL_MODEL_TICK_BUFFER === 0 ? 0.01 : 0]));
  world.pending = [...world.visuals.entries()].filter(([, record]) => !record.shallowJump)
    .map(([entity, record]) => [entity, record, modelRates.get(record.light) ?? 0]);
  for (let i = world.pending.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [world.pending[i], world.pending[j]] = [world.pending[j], world.pending[i]];
  }
  world.nextDispatchAt = 0;
  world.nextActiveAt = 0;
  setSilentHillFog(dark);
  setSilentHillSky(dark);
}

function setSilentHillFog(dark, restore = false) {
  if ([...state.genericEvents.active.values()].some(event => event.name === "THICK_FOG" && !event.ended)) return;
  if (state.endingRuntime) return;
  const fog = Instance.FindEntityByName?.("fog");
  if (validEntity(fog)) {
                                                                   
    fireTarget(fog, "SetFogColor", restore ? "255 255 255" : dark ? "0 0 0" : "100 100 100");
    fireTarget(fog, "SetFogStartDistance", restore ? "1000" : dark ? "-2500" : "-1000");
    fireTarget(fog, "SetFogEndDistance", restore ? "300000" : dark ? "2500" : "5000");
    fireTarget(fog, "SetFogMaxOpacity", "1");
  }
}

function setSilentHillSky(dark) {
  themeModelSky.silentHillDarkTarget = dark ? 1 : 0;
  if (!setCollectiveSkybox(dark ? "silenthill_dark" : "generic", true)) {
    if (dark && !themeModelSky.missingSilentHillSkyWarned) {
      themeModelSky.missingSilentHillSkyWarned = true;
      message("[SILENTHILL] dark env_sky is missing; cloud tint will change but the 2D sky will stay light");
    }
    return;
  }
}

function processSilentHillVisualChange() {
  const world = state.silentHillWorld;
  const now = Instance.GetGameTime();
                                                                       
                                                                         
  if (now >= (world.nextActiveAt ?? 0)) {
  world.nextActiveAt = now + SILENTHILL_FADE_RATE;
  for (let index = world.active.length - 1; index >= 0; index--) {
    const transition = world.active[index];
    const { entity, record, dark } = transition;
    if (world.visuals.get(entity) !== record || !validEntity(entity) || record.runtime?.lifecycle === "destroyed") {
      world.active.splice(index, 1);
      continue;
    }
    const step = Math.floor((now - transition.startedAt) / SILENTHILL_FADE_RATE);
    try {
      if (!transition.switched && step >= SILENTHILL_FADE_STEPS) {
        silentHillSwapModel(entity, record, dark);
        transition.switched = true;
      }
      if (step >= SILENTHILL_FADE_STEPS * 2 + 1) {
        record.restore?.();
        entity.SetColor?.({ ...record.color, a: terrainRenderAlpha(entity, record.color.a) });
        world.active.splice(index, 1);
        continue;
      }
      if (step === transition.lastStep) continue;
      transition.lastStep = step;
      const c = Math.min(255, Math.max(0,
        step < SILENTHILL_FADE_STEPS
          ? 255 - step * SILENTHILL_FADE_STEP
          : (step - SILENTHILL_FADE_STEPS) * SILENTHILL_FADE_STEP));
      const r = Math.min(255, 75 + c);
      entity.SetColor?.(dark
        ? { r, g: c, b: c, a: terrainRenderAlpha(entity, record.color.a) }
        : { r, g: r, b: c, a: terrainRenderAlpha(entity, record.color.a) });
    } catch (error) {
      world.active.splice(index, 1);
      message(`[SILENTHILL] model transition failed for ${record.light}: ${error}`);
    }
  }
  }
  if (now < (world.nextDispatchAt ?? 0)) return;
  while (world.pending.length) {
    const [entity, record, qrate = 0.01] = world.pending.shift();
    if (world.visuals.get(entity) !== record) continue;
    if (!validEntity(entity) || record.runtime?.lifecycle === "destroyed") {
      world.visuals.delete(entity);
      continue;
    }
    try {
      if (record.button) {
        const targetDark = world.visualDark;
        schedule(1, () => {
          if (world.visuals.get(entity) === record && world.visualDark === targetDark && validEntity(entity)) {
            silentHillSwapModel(entity, record, targetDark);
          }
        }, record.runtime?.index);
      } else {
        world.active.push({ entity, record, dark: world.visualDark, startedAt: now, switched: false, lastStep: -1 });
      }
    } catch (error) {
      message(`[SILENTHILL] model switch failed for ${record.light}: ${error}`);
    }
    if (qrate >= 0.01) { world.nextDispatchAt = now + qrate; break; }
  }
}

function silentHillSwapModel(entity, record, dark) {
  const position = entity.GetAbsOrigin?.();
  const angles = entity.GetAbsAngles?.();
  entity.SetModel(dark ? record.light.replace(/\.vmdl$/i, "dark.vmdl") : record.light);
  entity.collectiveFalldownCandidate = undefined;
  if (position && angles) entity.Teleport?.({ position, angles });
  record.restore?.();
}

function toggleSilentHillWorld(dark, delay = 0) {
  if (dark && !state.silentHillDarkReady) {
    message("[SILENTHILL] dark models are not preloaded; compile the updated VMAP before switching worlds");
    return false;
  }
  const world = state.silentHillWorld;
  const serial = ++world.serial;
  world.requestedDark = dark === true;
  if (delay > 0) {
    schedule(delay, () => {
      if (serial === world.serial && state.running && !state.fatal && !state.endingRuntime) {
        state.themeMusic.silenthillDark = dark === true;
        queueSilentHillVisualChange(dark);
      }
    });
  } else {
    state.themeMusic.silenthillDark = dark === true;
    queueSilentHillVisualChange(dark);
  }
  return true;
}

function chooseFinaleThemeName(runtime, random = Math.random) {
  const pool = runtime?.finaleThemeNames ?? FINALE_THEME_NAMES;
  if (!Array.isArray(pool) || pool.length === 0) return "generic";
  const sample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
  const selected = String(pool[Math.floor(sample * pool.length)] ?? "generic");
  runtime.finaleThemeHistory ??= [];
  runtime.finaleThemeHistory.push(selected);
  if (runtime.finaleThemeHistory.length > 128) runtime.finaleThemeHistory.shift();
  runtime.finaleThemeCurrent = selected;
  return selected;
}

function createStageSnapshot(stageIndex = 0, themeName, endingName) {
  const requestedIndex = Number(stageIndex) || 0;
  const infinite = requestedIndex > FINALE_STAGE_INDEX;
  const finale = requestedIndex === FINALE_STAGE_INDEX || (infinite && endingName === "FINALE");
  const index = finale || infinite
    ? STAGE_CONFIGS.length - 1
    : Math.max(0, Math.min(STAGE_CONFIGS.length - 1, requestedIndex));
  const config = STAGE_CONFIGS[index];
                                                                                        
  const theme = themeProfile(finale ? "generic" : themeName ?? config.theme);
                                                                           
                                                                              
  return Object.freeze({
    ...config,
    ending: finale ? "FINALE" : infinite ? "INFINITE" : String(endingName ?? config.ending).toUpperCase(),
    stageIndex: finale || infinite ? requestedIndex : index,
    stageNumber: finale ? FINALE_STAGE_INDEX + 1 : config.stage,
    goal: finale ? 0 : infinite ? Number.MAX_SAFE_INTEGER : config.stageGoal,
    stageGoal: finale ? 0 : infinite ? Number.MAX_SAFE_INTEGER : config.stageGoal,
    finaleMode: finale ? "boss" : undefined,
    infiniteMode: infinite,
    finaleInfiniteMusic: infinite && finale,
    theme: theme.name,
    themeProfile: theme,
    trapfloorChance: theme.trapfloorChance ?? config.trapfloorChance,
    trapstepChance: theme.trapstepChance ?? config.trapstepChance,
    trapvicinityChance: theme.trapvicinityChance ?? config.trapvicinityChance,
    trapspawnChance: theme.trapspawnChance ?? config.trapspawnChance,
    genericHoldOpenTime: config.genericHoldTime,
    generichold_opentime: config.genericHoldTime,
    buttonHoldTime: config.holdOpenTime,
    hold_opentime: config.holdOpenTime,
    holdOpenTimeSeconds: config.holdOpenTime,
    endTileDelay: config.endTileTime,
    endtile_time: config.endTileTime,
    endButtonDelay: config.endButtonTime,
    endbutton_time: config.endButtonTime,
    endTileTimeSeconds: config.endTileTime,
    endButtonTimeSeconds: config.endButtonTime,
    breakableMultiplier: config.breakableHealthMultiplier,
    breakableHealth: config.breakableHealthMultiplier,
    breakable_health: config.breakableHealthMultiplier,
    hazardDamagePerTick: config.hazardDamage,
    hazliquid_damage: config.hazardDamage,
    trapfloor_chance: theme.trapfloorChance ?? config.trapfloorChance,
    trapstep_chance: theme.trapstepChance ?? config.trapstepChance,
    trapvicinity_chance: theme.trapvicinityChance ?? config.trapvicinityChance,
    trapspawn_chance: theme.trapspawnChance ?? config.trapspawnChance,
    event_cooldown_min: config.eventCooldownMin,
    event_cooldown_max: config.eventCooldownMax,
    event_chance_base: config.eventChanceBase,
    event_chance_fail_add: config.eventChanceFailAdd,
  });
}

const DEFAULT_STAGE_SNAPSHOT = createStageSnapshot(0);
function shuffledCampaignThemeOrder() {
  const pool = shuffleGenerationThemeNames();
  return Array.from(
    { length: STAGE_CONFIGS.length },
    (_, index) => THEME_PROFILES[pool[index % pool.length]] ?? THEME_PROFILES[FIXED_GENERATION_THEME],
  );
}
const INITIAL_THEME_ORDER = Object.freeze(shuffledCampaignThemeOrder());
                                                                           
                                                                         
                                                                           
