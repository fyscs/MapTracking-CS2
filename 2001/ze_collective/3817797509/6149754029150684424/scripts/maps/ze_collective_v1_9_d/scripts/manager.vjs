  generic: new ThemeProfile("generic", { lowgravSkin: 1, airslideSkin: 1, liquidSkin: 1, hazardLiquidSkin: 3 }),
  castle: new ThemeProfile("castle", { lowgravSkin: 2, airslideSkin: 2, liquidSkin: 1, hazardLiquidSkin: 3 }),
  factory: new ThemeProfile("factory", { lowgravSkin: 2, airslideSkin: 2, liquidSkin: 1, hazardLiquidSkin: 5 }),
  temple: new ThemeProfile("temple", { lowgravSkin: 2, airslideSkin: 2, liquidSkin: 1, hazardLiquidSkin: 7 }),
  nature: new ThemeProfile("nature", { lowgravSkin: 1, airslideSkin: 2, liquidSkin: 1, hazardLiquidSkin: 13 }),
  hell: new ThemeProfile("hell", { lowgravSkin: 1, airslideSkin: 1, liquidSkin: 9, hazardLiquidSkin: 11 }),
  frost: new ThemeProfile("frost", { lowgravSkin: 1, airslideSkin: 2, liquidSkin: 17, hazardLiquidSkin: 15 }),
  silenthill: new ThemeProfile("silenthill", { lowgravSkin: 1, airslideSkin: 3, liquidSkin: 1, hazardLiquidSkin: 19 }),
});
                                                                       
                                                                           
                                                                             
                  
