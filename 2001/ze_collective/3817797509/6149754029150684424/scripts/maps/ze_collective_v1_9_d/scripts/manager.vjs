function availableThemes() {
  return AVAILABLE_THEMES;
}

function shuffleAvailableThemes(random = Math.random) {
  const result = [...AVAILABLE_THEMES];
  for (let index = result.length - 1; index > 0; index--) {
    const swap = Math.floor(Math.max(0, Math.min(0.999999, random())) * (index + 1));
    [result[index], result[swap]] = [result[swap], result[index]];
  }
  return Object.freeze(result);
}

function themeProfile(theme = "generic") {
  if (theme instanceof ThemeProfile) return theme;
  const key = String(theme || "generic");
  return THEME_PROFILES[key] ?? THEME_PROFILES.generic;
}

                                                                             
                                                                           
                                                                              
                                                                              
                                                      
