const RACE_LEVELS = Object.freeze(ALL_LEVELS.filter((level) => (
  String(level.name ?? "").startsWith("RACE")
  && level.id !== "#1667131507"
)));

const LEVELS = Object.freeze(ALL_LEVELS.filter((level) => {
                                                                        
                                                                          
  if (String(level.name ?? "").startsWith("RACE")) return false;
  const required = requiredCapabilitiesForLevel(level);
  return required.every((capability) => ACTIVE_CAPABILITIES.has(capability));
}));

                                                                     
                                                                        
                                                                            
                                                                    






                                                                            
                                                                            
                                                                               
                                                                         
                                                                




                                                                           
                                                                        
                                                                           
                                                                             
                                                             


















                                                                            
                                                                         
                                                                               




                                                                          
                                                                              
                                                                            




                                                                            
                                                                             
                                                                            
                                                                          
                                                                     



// Round arena: every container that only lives for one round. An engine round
// restart swaps the whole set for fresh objects (releaseRoundToEngine), so a
// forgotten clear() can't carry handles or closures into later rounds.
// Cross-round data (campaign, debug flags, template/sound caches, preloaded
// theme resources, warnings, slot HUD maps) must stay out of this list.
function createRoundScope() {
  return {
    falldownCheckpointQueue: [],
    falldownCheckpoints: new Map(),
    falldownCheckpointSuppressions: new Map(),
    falldownCheckpointAttackers: new Map(),
    airslidePlayers: new Map(),
    lowgravContacts: new Map(),
    lowgravFailsafeQueue: [],
    airslideFailsafeQueue: [],
    motherZombies: new Set(),
    terrainPreloadRetiring: new Set(),
    levels: new Map(),
    roundEntities: new Set(),
    spawnSafetyTriggers: new Map(),
    spawnQueue: [],
    generationQueues: new Map(["terrain", "liquid", "model", "ladder", "boost"].map(key => [key, []])),
    terrainSpawnFades: new Map(),
    itemSpawnQueue: [],
    trapSpawnQueue: [],
    sourceStageCosts: [],
    sourceExtraCosts: new Map(),
    scheduledTasks: [],
    outputConnections: new Map(),
    outputRoutes: new Map(),      // caller entity -> output name -> Map(connection id -> callback)
    outputRouteIndex: new Map(),  // connection id -> { entity, output }
    playerEffects: new Map(),
    liquidDamageCooldowns: new Map(),
    teleportEntryFallDamageTokens: new Map(),
    liquidShallowJumpCooldowns: new Map(),
    liquidShallowStreamHistory: new Map(),
    pendingDeployableUsePawns: new Set(),
    playerStatuses: new Map(),
    nativeStatusSpeeds: new Map(),
    releasedItemCarriers: new Map(),
    playerItems: new Map(),
    planetCrystalShuffle: [],
    itemParticleFxWindows: new Map(),
  };
}

const state = {
  ...createRoundScope(),
  activated: false,
  running: false,
  fatal: false,
  roundStartedAt: 0,
  roundBootstrapSerial: 0,
  roundBootstrapPending: false,
  roundBootstrapWaitLogged: false,
  nextEndCheckAt: 0,
  endLockedUntil: 0,
  falldownCheckpointEnabled: true,
  nextFalldownCheckpointAt: 0,
  lowgravFailsafeCursor: 0,
  nextLowgravFailsafeAt: 0,
  airslideFailsafeCursor: 0,
  nextAirslideRefreshAt: 0,
  nextAirslideFailsafeAt: 0,
  infectionActivated: false,
                                                                               
                                                                             
  zombieSpawnInvincibilityEnabled: true,
  firstInfectionAt: undefined,
  adminSlayActive: false,
  flightSlayEnabled: false,
  spawnPlatformKilled: false,
  spawnPlatformTransitionCount: 0,
  spawnPlatformFallScheduled: false,
  startPoint: START_POINTS[0],
  currentDirection: vec(1, 0, 0),
  nextEntry: vec(0, 0, 0),
  nextBridgeStart: vec(0, 0, 0),
  nextBufferSize: CONFIG.firstBufferSize,
  levelIndex: 0,
  lastLevelId: undefined,
  currentLevel: undefined,
                                                                         
                                                                           
                                                                              
                                                                   
  transitionLevel: undefined,
  pendingLevel: undefined,
  terrainPreload: undefined,
  nextRoundEntityPruneAt: 0,
  roundEntityPruneIterator: undefined,
  templates: new Map(),
  featureTemplates: new Map(),
  themePreloadTemplates: new Map(),
  themePreloaded: new Set(["generic"]),
  silentHillDarkReady: false,
  themePreload: undefined,
  themeTerrainWarmup: undefined,
  debugMovementThemeQueue: [],
  themeGenerationScheduled: false,
  soundEvents: new Map(),
  bgmAnchors: new Map(),
  themeMusic: {
    enabled: false,
    nextAt: undefined,
    currentEntity: undefined,
    currentSong: undefined,
    currentTheme: undefined,
    history: [],
    missingWarnings: new Set(),
    silenthillDark: false,
    fadeSerial: 0,
    infiniteThemeCount: -1,
    infiniteThemeTarget: undefined,
    infiniteThemePending: undefined,
    infiniteThemeResume: false,
  },
  silentHillWorld: {
    visualDark: false,
    requestedDark: false,
    serial: 0,
    visuals: new Map(),
    pending: [],
    active: [],
  },
  debugSilentHillTheme: false,
  snowstormOverlay: {
    serial: 0,
    active: false,
    particle: undefined,
    missingWarned: false,
  },
  collectiveTitle: {
    serial: 0,
    active: false,
    particle: undefined,
    missingWarned: false,
  },
  raceAnchors: { directionHint: undefined, fade: undefined, bgmToadsA: undefined, bgmToads: undefined },
  missingOptionalTemplateWarnings: new Set(),
  nextLiquidTickAt: 0,
  nextTrapTickAt: 0,
  nextItemTickAt: 0,
  nextKnifePickupTickAt: 0,
  lastEffectTickAt: 0,
  nextItemId: 1,
  nextItemEffectId: 1,
  humanItemDesired: 3,
  zombieItemDesired: 3,
  healOrbSpawnsRemaining: CONFIG.ensureHealOrbSpawns,
  genericEvents: {
    cooldown: undefined, failChance: 0, lastEvaluatedLevel: undefined,
    active: new Map(), history: [], bloodlustHits: new Map(),
    fallDamageDisabledUntil: 0, serial: 0, autoEnabled: true,
    manualEnabled: false, manualAutoBefore: undefined,
  },
  planetCombo: undefined,
  debugShowcaseMode: false,
  debugGravityMode: false,
  debugMovementThemesMode: false,
  debugAllModelsMode: false,
  debugTrapMode: false,
  debugStageId: undefined,
  debugStageMirror: false,
  debugNextEnding: undefined,
  teleportDestination: undefined,
  teleportFacing: undefined,
  teleportIndicator: undefined,
  lastTriggeredEndIndicator: undefined,
                                                                         
                                                                       
  debugTeleportTest: undefined,
                                                                       
                                                                            
                                                                          
  campaign: {
    stageIndex: 0,
    adminSelection: undefined,
    legitWin: true,
    stageLevelCount: 0,
    stageWins: 0,
    phase: "idle",
    themeOrder: [...INITIAL_THEME_ORDER],
    currentStageSnapshot: createStageSnapshot(0, INITIAL_THEME_ORDER[0]),
    endingStarted: false,
    endingContractCalls: 0,
    endingResolved: false,
    endingOutcomePending: false,
    complete: false,
    lastEnding: undefined,
    lastFailure: undefined,
    endingOrder: shuffledEndingOrder(),
    finaleAnchor: undefined,
    finaleDirection: undefined,
  },
  endingStartContract: undefined,
  endingRuntime: undefined,
  finaleEscapeActive: false,
                                                                          
                                                                          
                                                                    
  finalePostImpostorUntil: 0,
};

function range(first, last) {
  const values = [];
  for (let value = first; value <= last; value++) values.push(value);
  return values;
}

function campaignThemeName(stageIndex = state.campaign?.stageIndex ?? 0) {
  if (state.debugSilentHillTheme) return "silenthill";
  const selected = state.campaign?.themeOrder?.[Number(stageIndex)];
  return themeProfile(selected ?? FIXED_GENERATION_THEME).name;
}

function createCampaignStageSnapshot(stageIndex = state.campaign?.stageIndex ?? 0, endingName) {
  const requestedIndex = Number(stageIndex) || 0;
  return createStageSnapshot(
    requestedIndex,
    campaignThemeName(Math.min(requestedIndex, STAGE_CONFIGS.length - 1)),
    requestedIndex === FINALE_STAGE_INDEX ? "FINALE" : endingName,
  );
}

function campaignStageSnapshot() {
  const current = state.campaign?.currentStageSnapshot;
  if (current && Object.isFrozen(current)) return current;
  const index = state.campaign?.stageIndex ?? 0;
  const snapshot = createCampaignStageSnapshot(index, state.campaign?.endingOrder?.[index]);
  if (state.campaign) state.campaign.currentStageSnapshot = snapshot;
  return snapshot;
}

function stageSnapshotForRuntime(runtime) {
  return runtime?.debugEndingSnapshot ?? runtime?.stageSnapshot ?? LEGACY_RUNTIME_SNAPSHOT;
}

function activeRuntimes() {
  const runtimes = [...state.levels.values()].filter((runtime) => !["outcome_pending", "destroyed"].includes(runtime.lifecycle));
  const ending = state.endingRuntime;
  if (ending && !["outcome_pending", "resolved", "destroyed"].includes(ending.lifecycle) && !runtimes.includes(ending)) {
    runtimes.push(ending);
  }
  return runtimes;
}

function falldownCheckpointDescriptor(entity) {
  if (!validEntity(entity)) return "";
  let model = "";
  try {
    model = String(entity.GetModelName?.() ?? entity.GetModel?.() ?? "").toLowerCase();
  } catch (_) {
    model = "";
  }
  return `${String(entity.GetEntityName?.() ?? "").toLowerCase()} ${model}`;
}

// Classification needs three native string reads and a regex; it is cached on
// the entity and cleared by silentHillSwapModel, the only post-registration
// model change for terrain. Positions are still read live.
function isFalldownCheckpointCandidate(entity) {
  if (!validEntity(entity)) return false;
  entity.collectiveFalldownCandidate ??= classifyFalldownCheckpoint(entity);
  return entity.collectiveFalldownCandidate;
}

function classifyFalldownCheckpoint(entity) {
  const className = String(entity.GetClassName?.() ?? "").toLowerCase();
  if (className.startsWith("trigger_")) return false;
  const name = String(entity.GetEntityName?.() ?? "").toLowerCase();
  if (!name.startsWith("block_")) return false;

                                                           
                                                                           
                                                                      
  const descriptor = falldownCheckpointDescriptor(entity);
  return !/(?:^|[_/])(?:liquid|wall|hiddenwall|ladder|climb|crouch)(?:[_./]|$)/.test(descriptor);
}

function falldownCheckpointEntities() {
  const entities = [];
  for (const runtime of activeRuntimes()) {
    for (const entity of runtime.terrainEntities ?? []) {
      if (isFalldownCheckpointCandidate(entity)) entities.push(entity);
    }
  }
  return entities;
}

function findFalldownCheckpoint(pawn) {
  const origin = pawn?.GetAbsOrigin?.();
  if (!origin) return undefined;
  const candidates = [];
  for (const entity of falldownCheckpointEntities()) {
    const position = entity.GetAbsOrigin?.();
    if (position) candidates.push({ entity, position });
  }
  let nearest;
  let nearestPosition;
  let nearestDistance = CONFIG.falldownCheckpointRange + 0.001;
  for (const { entity, position } of candidates) {
    if (position.z > origin.z + 1) continue;
    const dx = position.x - origin.x;
    const dy = position.y - origin.y;
    const dz = position.z - origin.z;
    const distance = Math.hypot(dx, dy, dz);
    if (distance <= CONFIG.falldownCheckpointRange && distance < nearestDistance) {
      nearest = entity;
      nearestPosition = position;
      nearestDistance = distance;
    }
  }
  if (!nearest) return undefined;

                                                                          
                                                                        
                                              
  const checkpointOrigin = nearestPosition;
  let nearbyCount = 0;
  for (const { position } of candidates) {
    if (Math.hypot(
      position.x - checkpointOrigin.x,
      position.y - checkpointOrigin.y,
      position.z - checkpointOrigin.z,
    ) <= CONFIG.falldownCheckpointClusterRange) nearbyCount++;
  }
  return nearbyCount === 1 ? nearest : undefined;
}

function processFalldownCheckpoints(now) {
  if (!state.falldownCheckpointEnabled || now < state.nextFalldownCheckpointAt) return;
  state.nextFalldownCheckpointAt = now + CONFIG.falldownCheckpointRate;
  for (const [pawn, record] of state.falldownCheckpointSuppressions) {
    if (record <= now || !pawn?.IsValid?.()) state.falldownCheckpointSuppressions.delete(pawn);
  }
  for (const [pawn, record] of state.falldownCheckpointAttackers) {
    if (record.expiresAt <= now || !pawn?.IsValid?.() || !validEntity(record.attacker)) {
      state.falldownCheckpointAttackers.delete(pawn);
    }
  }

                                                                          
                                                                           
                                           
  if (state.falldownCheckpointQueue.length === 0) {
    state.falldownCheckpointQueue.push(
      ...allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3),
    );
  }
  const pawn = state.falldownCheckpointQueue.shift();
  if (!pawn?.IsValid?.() || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) return;
  const suppressedUntil = state.falldownCheckpointSuppressions.get(pawn) ?? 0;
  if (suppressedUntil > now) {
    state.falldownCheckpoints.delete(pawn);
    return;
  }
  const checkpoint = findFalldownCheckpoint(pawn);
                                                                           
  if (checkpoint) state.falldownCheckpoints.set(pawn, checkpoint);
}

                                                                              
                                                                              
                                                                       
function nullifyFalldownCheckpoint(pawn, attacker, iterations = 3, interval = 0.40) {
  if (!validEntity(pawn)) return;
  const now = Instance.GetGameTime();
  state.falldownCheckpoints.delete(pawn);
  state.falldownCheckpointSuppressions.set(pawn, now + Math.max(0, iterations * interval));
  if (
    validEntity(attacker)
    && attacker !== pawn
    && attacker.GetTeamNumber?.() !== pawn.GetTeamNumber?.()
  ) {
    state.falldownCheckpointAttackers.set(pawn, {
      attacker,
      expiresAt: now + 7,
    });
  }
}

function stageEndDelay(runtime) {
  const stage = stageSnapshotForRuntime(runtime);
  return runtime?.endProvider === "button" ? stage.endButtonTime : stage.endTileTime;
}

function setLevelLifecycle(runtime, lifecycle) {
  if (!runtime || runtime.lifecycle === "destroyed") return;
  runtime.lifecycle = lifecycle;
  if (Array.isArray(runtime.lifecycleHistory)) runtime.lifecycleHistory.push(lifecycle);
}

function setEndingStartContract(contract) {
  state.endingStartContract = typeof contract === "function" ? contract : undefined;
}

function callEndingStartContract(stageSnapshot, runtime) {
  if (state.campaign.endingStarted) return false;
  state.campaign.endingStarted = true;
                                                                          
                                                           
  state.falldownCheckpointEnabled = false;
  state.campaign.endingContractCalls++;
                                                                          
                                                                        
                                                                           
                                                                           
                           
  stopThemeMusic(`ending_handoff_${stageSnapshot.ending}`, 10);
  state.themeMusic.enabled = false;
  state.campaign.lastEnding = {
    stage: stageSnapshot.stage,
    theme: stageSnapshot.theme,
    ending: stageSnapshot.ending,
    levelIndex: runtime?.index,
  };
  const contract = state.endingStartContract;
  if (typeof contract === "function") {
    try {
      contract(Object.freeze({ stageSnapshot, runtime }));
    } catch (error) {
      failRuntime(`ending-start contract failed: ${error}`);
    }
  } else {
    try {
      const endingName = String(stageSnapshot.ending || "").toUpperCase();
      const starter = ENDING_STARTERS[endingName];
      if (typeof starter !== "function") throw new Error(`ending '${endingName}' has not been ported yet`);
      starter(stageSnapshot, runtime);
    } catch (error) {
      failRuntime(`${stageSnapshot.ending} ending startup failed: ${error}`);
    }
  }
  return true;
}

function advanceCampaignStage(stageSnapshot) {
                                                                           
                                                                          
                                                                           
                                                                   
  void stageSnapshot;
  return resolveStageEnding(true);
}

                                                                           
                                                                             
                                                                            
function resolveStageEnding(humansWon) {
                                                                      
                                                               
  if (state.adminSlayActive) return campaignStageSnapshot();
  if (state.campaign.endingResolved) return campaignStageSnapshot();
  if (
    !["ending_pending", "ending_handoff"].includes(state.campaign.phase)
    || !state.campaign.endingStarted
  ) {
    return campaignStageSnapshot();
  }
  if (state.endingRuntime && state.endingRuntime.lifecycle !== "destroyed") {
    markEndingOutcomePending(state.endingRuntime, humansWon);
  }
  state.campaign.endingResolved = true;
  state.campaign.endingOutcomePending = !!state.endingRuntime && state.endingRuntime.lifecycle !== "destroyed";
  if (!humansWon) {
    state.campaign.phase = "retained";
    state.campaign.stageLevelCount = 0;
    state.campaign.endingStarted = false;
    state.campaign.currentStageSnapshot = createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
    return state.campaign.currentStageSnapshot;
  }
  state.campaign.stageWins++;
  if (state.campaign.stageIndex >= FINALE_STAGE_INDEX) {
    state.campaign.complete = true;
    state.campaign.stageIndex++;
    state.campaign.phase = "infinite_pending";
    state.campaign.finaleAnchor = undefined;
    state.campaign.finaleDirection = undefined;
  } else if (state.campaign.stageIndex >= STAGE_CONFIGS.length - 1) {
                                                                             
                                                                              
                                                                        
    const source = state.endingRuntime?.sourceRuntime;
    state.campaign.finaleAnchor = source?.end ? clone(source.end) : undefined;
    state.campaign.finaleDirection = source?.outgoing ? clone(source.outgoing) : undefined;
    state.campaign.complete = false;
    state.campaign.stageIndex = FINALE_STAGE_INDEX;
    state.campaign.phase = "finale_pending";
  } else {
    state.campaign.stageIndex++;
    state.campaign.phase = "advanced";
  }
  state.campaign.stageLevelCount = 0;
  state.campaign.endingStarted = false;
  state.campaign.currentStageSnapshot = createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
  return state.campaign.currentStageSnapshot;
}

function retainCampaignStage(reason = "failure") {
  state.campaign.lastFailure = String(reason);
  state.campaign.phase = "retained";
  state.campaign.stageLevelCount = 0;
  state.campaign.endingStarted = false;
  state.campaign.endingContractCalls = 0;
  state.campaign.endingResolved = false;
  state.campaign.endingOutcomePending = false;
  state.campaign.complete = false;
  state.campaign.lastEnding = undefined;
  state.campaign.currentStageSnapshot = createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
  return state.campaign.currentStageSnapshot;
}

function retireInfiniteCheckout() {
  const vote = state.infiniteCheckout;
  if (!vote) return;
  state.infiniteCheckout = undefined;
  for (const id of vote.connections) {
    if (id === undefined || id === null) continue;
    disconnectEntityOutput(id);
    vote.runtime.outputConnections.delete(id);
    state.outputConnections.delete(id);
  }
  for (const entity of vote.entities) {
    if (validEntity(entity)) entity.Kill();
    vote.runtime.entities.delete(entity);
    state.silentHillWorld.visuals.delete(entity);
  }
}

function infiniteCheckoutShot(vote, event) {
  if (state.infiniteCheckout !== vote || vote.passed) return false;
  const pawn = resolvePawn(event?.attacker ?? event?.activator);
  if (!pawn?.IsAlive?.() || pawn.GetTeamNumber?.() !== 3 || vote.voters.has(pawn)) return false;
  vote.voters.add(pawn);
  vote.passed = vote.voters.size >= vote.needed;
  fireTarget(vote.text, "SetMessage", `Infinite Finale Checkout Vote (shoot eye) [${vote.passed
    ? "VOTE PASSED" : `${vote.voters.size}/${vote.needed}`}]`);
  if (vote.passed) {
    vote.checkoutValue = state.campaign.stageLevelCount;
    announce(`[INFINITE FINALE] YOU CHECKED OUT AT ${vote.checkoutValue} LEVELS`);
    for (const pitch of [20 + Math.floor(Math.random() * 11), 50 + Math.floor(Math.random() * 11)])
      playCatalogSound("eye_terror", vec(), { radius: 0, lifetime: 10, volume: 10, pitch });
  }
  return true;
}

function offerInfiniteCheckout(runtime) {
  if (!stageSnapshotForRuntime(runtime).infiniteMode || state.infiniteCheckout?.passed
    || state.campaign.stageLevelCount < 10) return false;
  retireInfiniteCheckout();
  const before = new Set(runtime.entities);
  const beforeOutputs = new Set(runtime.outputConnections);
                                                                          
  const direction = runtime.outgoing;
  const position = add(runtime.end, add(mul(direction, 300), vec(0, 0, 60)));
  const angles = { pitch: 0, yaw: normalizeYaw(yawOf(direction) + 180), roll: 0 };
  const vote = { runtime, voters: new Set(), passed: false,
    needed: Math.max(1, Math.floor(allLivingPawns().filter(p => p.GetTeamNumber?.() === 3).length * 0.7)),
    entities: new Set(), connections: [] };
  try {
    vote.visual = spawnVisual(runtime, { position, angles, feature: "infiniteCheckout" }, "models/luffaren/the_collective.vmdl");
    vote.visual.SetEntityName?.("checkout_vote");
    vote.visual.SetModelScale?.(1.5);
    fireTarget(vote.visual, "SetAnimation", "idle_open");
    fireTarget(vote.visual, "SetDefaultAnimation", "idle_open");
    const textPosition = add(position, add(mul(leftOf(direction), 240), vec(0, 0, 50)));
    const textAngles = { pitch: 0, yaw: normalizeYaw(yawOf(direction) - 90), roll: 90 };
    const textEntities = spawnRoundEntities(featureTemplate("finaleCheckoutText"), textPosition, textAngles) ?? [];
    finalizeSpawned(runtime, { position: textPosition, angles: textAngles, feature: "infiniteCheckoutText" }, textEntities);
    vote.text = textEntities.find(e => validEntity(e) && e.GetClassName?.() === "point_worldtext");
    if (!vote.text) throw new Error("checkout worldtext did not spawn");
    fireTarget(vote.text, "SetMessage", `Infinite Finale Checkout Vote (shoot eye) [0/${vote.needed}]`);
    fireTarget(vote.text, "Enable");
    const shell = { id: `checkout_${runtime.index}`, position, angles, visual: vote.visual,
      maxHealth: 1000000, hitboxes: new Set() };
    vote.hitbox = spawnFinaleBossDamageHitbox(runtime, shell, vec(-20, -40, -30), vec(20, 40, 30), "checkout");
    connectOwnedOutput(runtime, vote.hitbox, "OnTakeDamage", event => infiniteCheckoutShot(vote, event));
    state.infiniteCheckout = vote;
    return true;
  } finally {
    vote.entities = new Set([...runtime.entities].filter(e => !before.has(e)));
    vote.connections = [...runtime.outputConnections].filter(id => !beforeOutputs.has(id));
    if (state.infiniteCheckout !== vote) {
      state.infiniteCheckout = vote;
      retireInfiniteCheckout();
    }
  }
}

function endingTask(runtime, delay, callback) {
  if (!runtime || ["outcome_pending", "destroyed", "resolved"].includes(runtime.lifecycle)) return undefined;
  let task;
  task = schedule(delay, () => {
    runtime.tasks?.delete(task);
    if (["outcome_pending", "destroyed", "resolved"].includes(runtime.lifecycle)) return;
    callback();
  }, runtime.owner);
  runtime.tasks?.add(task);
  return task;
}

                                                                           
                                                                             
                                                                          
                                                                             
                                                                   
function endingTaskAt(runtime, absoluteTime, callback, dueKey) {
  if (!runtime || ["outcome_pending", "destroyed", "resolved"].includes(runtime.lifecycle)) return undefined;
  runtime.timelineAt ??= new Map();
  runtime.timelineDone ??= new Set();
  if (dueKey !== undefined) runtime.timelineAt.set(dueKey, absoluteTime);
  let task;
  task = schedule(Math.max(0, absoluteTime - Instance.GetGameTime()), () => {
    runtime.tasks?.delete(task);
    if (["outcome_pending", "destroyed", "resolved"].includes(runtime.lifecycle)) return;
    if (dueKey !== undefined && runtime.timelineDone.has(dueKey)) return;
    if (runtime.lifecycle === "spawning") {
      runtime.timelineDue ??= new Set();
      if (dueKey !== undefined) runtime.timelineDue.add(dueKey);
      return;
    }
    if (dueKey !== undefined) runtime.timelineDone.add(dueKey);
    callback();
  }, runtime.owner);
  runtime.tasks?.add(task);
  return task;
}

function flushEndingTimeline(runtime, handlers) {
  if (!runtime || runtime.lifecycle === "destroyed" || runtime.lifecycle === "resolved") return;
  runtime.timelineDue ??= new Set();
  runtime.timelineDone ??= new Set();
  const now = Instance.GetGameTime();
  for (const [key, callback] of Object.entries(handlers ?? {})) {
    if (!runtime.timelineDone.has(key)
      && (runtime.timelineDue.has(key) || (runtime.timelineAt?.get(key) ?? Infinity) <= now)) {
      runtime.timelineDue.delete(key);
      runtime.timelineDone.add(key);
      callback();
    }
  }
}

function endingAnnounce(runtime, delay, text) {
  if (delay <= 0) {
    announce(text);
    return undefined;
  }
  return endingTask(runtime, delay, () => announce(text));
}

function endingCountdown(runtime, totalTime, prefix, checkpoints = [60, 30, 10, 5, 4, 3, 2, 1]) {
  for (const seconds of checkpoints) {
    const delay = totalTime - seconds;
    if (delay > 0) endingAnnounce(runtime, delay, `${prefix} ${seconds}s`);
  }
}

function themeMusicPool(themeName, silenthillDark = state.themeMusic.silenthillDark) {
  const selected = themeProfile(themeName).name;
  if (selected === "silenthill" && silenthillDark) return SILENTHILL_DARK_MUSIC;
  return THEME_MUSIC[selected] ?? THEME_MUSIC.generic;
}

function selectThemeMusic(themeName, random = Math.random, silenthillDark) {
  const pool = themeMusicPool(themeName, silenthillDark);
  const sample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
  return pool[Math.floor(sample * pool.length)];
}

function resolveScreenParticle(holder, targetName) {
  if (!holder) return undefined;
  if (!validEntity(holder.particle)) {
    const found = Instance.FindEntityByName?.(targetName);
    if (validEntity(found)) holder.particle = found;
  }
  return validEntity(holder.particle) ? holder.particle : undefined;
}

function setSnowstormOverlayEnabled(enabled) {
  const overlay = state.snowstormOverlay;
  const wanted = enabled === true;
  const particle = resolveScreenParticle(overlay, "collective_snow_screen");
  if (!validEntity(particle)) {
    if (wanted && !overlay.missingWarned) {
      overlay.missingWarned = true;
      message("snowstorm screen particle 'collective_snow_screen' is unavailable");
    }
    return false;
  }
                                                                           
                                                                            
                                                                         
  // Stop only stops emission; the screen sprite lives for 999999 seconds.
  // Always clear on disable, including after reload when active resets to false.
  if (wanted && overlay.active) return true;
  overlay.active = wanted;
  fireTarget(particle, wanted ? "Start" : "DestroyImmediately", "");
  return true;
}

function setCollectiveTitleEnabled(enabled) {
  const title = state.collectiveTitle;
  const wanted = enabled === true;
  const particle = resolveScreenParticle(title, FINALE_BOSS_LOGO_CONFIG.particleTarget);
  if (!validEntity(particle)) {
    if (wanted && !title.missingWarned) {
      title.missingWarned = true;
      message(`finale title particle '${FINALE_BOSS_LOGO_CONFIG.particleTarget}' is unavailable`);
    }
    return false;
  }
  if (title.active === wanted) return true;
  title.active = wanted;
  fireTarget(particle, title.active ? "Start" : "Stop", "");
  return true;
}

function stopCollectiveTitle(reason = "stop") {
  const title = state.collectiveTitle;
  title.serial++;
  title.active = false;
  const particle = resolveScreenParticle(title, FINALE_BOSS_LOGO_CONFIG.particleTarget);
  if (validEntity(particle)) fireTarget(particle, "Stop", "");
  title.lastStopReason = reason;
}

function scheduleSnowstormOverlay(song) {
  const overlay = state.snowstormOverlay;
  const serial = ++overlay.serial;
  setSnowstormOverlayEnabled(false);
  if (!song?.snowstormOverlay) return;
  schedule(3.00, () => {
    if (overlay.serial === serial) setSnowstormOverlayEnabled(true);
  }, "snowstorm-overlay-start");
  schedule(Number(song.duration) + 5.00, () => {
    if (overlay.serial === serial) setSnowstormOverlayEnabled(false);
  }, "snowstorm-overlay-stop");
}

function stopThemeMusic(reason = "stop", fadeDuration = 0) {
  const music = state.themeMusic;
  clearSourceAudio(music);
  state.snowstormOverlay.serial++;
  setSnowstormOverlayEnabled(false);
  const entity = music.currentEntity;
  const fadeSerial = ++music.fadeSerial;
  if (validEntity(entity)) {
    const fade = Math.max(0, Number(fadeDuration) || 0);
    if (fade > 0) {
      fireTarget(entity, "FadeOut", String(fade));
                                                                             
                                                                              
                                                                            
                                                                              
                                          
      schedule(Math.max(0, fade - 0.1), () => {
        if (music.fadeSerial === fadeSerial && validEntity(entity)) fireTarget(entity, "Volume", "0");
      }, "theme-music-fade");
      schedule(Math.max(0, fade - 0.08), () => {
        if (music.fadeSerial === fadeSerial && validEntity(entity)) fireTarget(entity, "StopSound", "");
      }, "theme-music-fade");
    } else {
      fireTarget(entity, "Volume", "0");
      fireTarget(entity, "StopSound", "", 0.01);
    }
  }
  if (music.currentSong) {
    music.history.push({
      type: "stop",
      token: music.currentSong.token,
      at: Instance.GetGameTime(),
      reason,
      fadeDuration: Math.max(0, Number(fadeDuration) || 0),
    });
    if (music.history.length > 32) music.history.splice(0, music.history.length - 32);
  }
  music.currentEntity = undefined;
  music.currentSong = undefined;
  music.currentTheme = undefined;
  music.nextAt = undefined;
}

function startThemeMusic(delay = 0.5) {
  const music = state.themeMusic;
  music.fadeSerial++;
  music.enabled = true;
  music.nextAt = Instance.GetGameTime() + Math.max(0, delay);
}

function infiniteThemeRandomIndex(size, random) {
  return Math.floor(Math.max(0, Math.min(0.999999, Number(random()) || 0)) * size);
}

function advanceInfiniteTheme(random = Math.random) {
  const music = state.themeMusic;
  const stage = campaignStageSnapshot();
  if (!stage.infiniteMode || stage.ending === "FINALE") return false;
  if (music.infiniteThemeTarget === undefined) music.infiniteThemeTarget = infiniteThemeRandomIndex(6, random);
  if (++music.infiniteThemeCount <= music.infiniteThemeTarget) return false;
  music.infiniteThemeCount = 0;
  music.infiniteThemeTarget = infiniteThemeRandomIndex(6, random);
  const theme = state.debugSilentHillTheme ? "silenthill"
    : GENERATION_THEME_NAMES[infiniteThemeRandomIndex(GENERATION_THEME_NAMES.length, random)];
                                                                        
  if (theme === stage.theme) return false;
  const pending = { theme, stage };
  music.infiniteThemePending = pending;
  prepareThemeTerrainAssets(theme, { onComplete: success => {
    if (music.infiniteThemePending !== pending) return;
    music.infiniteThemePending = undefined;
    if (!state.running || state.fatal
        || state.endingRuntime || campaignStageSnapshot() !== stage) return;
    if (success) {
      state.campaign.currentStageSnapshot = createStageSnapshot(stage.stageIndex, theme, stage.ending);
                                                                             
      state.silentHillWorld.serial++;
      state.silentHillWorld.requestedDark = false;
      state.silentHillWorld.visualDark = false;
      state.silentHillWorld.pending.length = 0;
      music.silenthillDark = false;
      ensureThemeModelSky(theme);
      if (theme === "silenthill") setSilentHillSky(false);
      setThemeFog({ stageSnapshot: campaignStageSnapshot() });
      message(`infinite theme: '${stage.theme}' -> '${theme}'`);
    } else {
      message(`infinite theme '${theme}' not ready; retaining '${stage.theme}'`);
    }
                                                                           
    music.infiniteThemeResume = true;
    music.nextAt = Instance.GetGameTime();
  } });
  return true;
}

function playThemeMusic(now = Instance.GetGameTime(), random = Math.random) {
  const music = state.themeMusic;
  if (!music.enabled || state.fatal || state.endingRuntime
    || ["ending_pending", "ending_handoff", "ended"].includes(state.campaign.phase)) return false;
  if (music.infiniteThemePending) return false;
  if (music.infiniteThemeResume) music.infiniteThemeResume = false;
  else if (advanceInfiniteTheme(random)) return false;
  const stage = campaignStageSnapshot();
  const theme = stage.theme;
  const song = stage.infiniteMode && stage.ending !== "FINALE" && Number(random()) * 100 <= 7
    ? INFINITE_THEME_MUSIC[infiniteThemeRandomIndex(INFINITE_THEME_MUSIC.length, random)]
    : selectThemeMusic(theme, random);
  const anchorPrefix = song.anchorKind === "sfx" ? "soundevent_sfx_" : "soundevent_bgm_";
  const entity = song.anchorKind === "sfx"
    ? Instance.FindEntityByName?.(`${anchorPrefix}${song.token}`)
    : state.bgmAnchors.get(song.token) ?? Instance.FindEntityByName?.(`${anchorPrefix}${song.token}`);
  if (!validEntity(entity)) {
    if (!music.missingWarnings.has(song.token)) {
      music.missingWarnings.add(song.token);
      message(`theme audio anchor '${anchorPrefix}${song.token}' is unavailable`);
    }
    music.nextAt = now + song.duration;
    return false;
  }
                                                                          
  music.fadeSerial++;
  if (validEntity(music.currentEntity)) {
    fireTarget(music.currentEntity, "Volume", "0");
    fireTarget(music.currentEntity, "StopSound", "", 0.01);
  }
  let appliedPitch = song.pitch;
  if (song.silenthillToggle) {
                                                                         
                                                                           
                                                                        
    const pitchSample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
    appliedPitch = 98 + Math.floor(pitchSample * 4);
    clearSourceAudio(music);
    playSourceAudioStack([11768, 11768], vec(), { pitch: appliedPitch, owner: music });
    toggleSilentHillWorld(!state.silentHillWorld.requestedDark, SILENTHILL_TRANSITION_DELAY);
  } else {
                                                                             
                                                                            
    fireTarget(entity, "PlaySound", "");
    fireTarget(entity, "Volume", String(song.volume), 0.01);
    fireTarget(entity, "Pitch", String(song.pitch), 0.02);
    fireTarget(entity, "Volume", String(song.volume), 0.03);
  }
  music.currentEntity = entity;
  music.currentSong = song;
  music.currentTheme = theme;
  music.nextAt = now + song.duration;
  scheduleSnowstormOverlay(song);
  music.history.push({
    type: "play", token: song.token, theme, at: now,
    volume: song.volume, pitch: appliedPitch, duration: song.duration,
    silenthillDark: song.silenthillToggle ? music.silenthillDark : undefined,
  });
  if (music.history.length > 32) music.history.splice(0, music.history.length - 32);
  return true;
}

function processThemeMusic(now = Instance.GetGameTime()) {
  const music = state.themeMusic;
  if (!music.enabled || music.nextAt === undefined || now + 1e-6 < music.nextAt) return;
  playThemeMusic(now);
}

function playEndingMusic(runtime, token, allowReplay = false) {
  state.themeMusic.enabled = false;
  runtime.musicTokens ??= new Set();
  if (!allowReplay && runtime.musicTokens.has(token)) return true;
                                                                           
                                                                          
                                                                         
  const cached = state.bgmAnchors.get(token);
  const entity = validEntity(cached) ? cached
    : Instance.FindEntityByName?.(`soundevent_bgm_${token}`);
  if (!validEntity(entity)) {
    if (playCatalogSound(`bgm_${token}`, runtime.anchor, { radius: 0, owner: runtime })) {
      runtime.musicTokens.add(token);
      return true;
    }
    message(`ending BGM anchor 'soundevent_bgm_${token}' is unavailable`);
    return false;
  }
  fireTarget(entity, "Volume", "10");
  fireTarget(entity, "PlaySound", "");
  fireTarget(entity, "Pitch", "100", 0.01);
                                                                             
                                                                            
  const volume = token === "confronting_myself_infinite_static" ? "5" : "10";
  fireTarget(entity, "Volume", volume, 0.02);
  fireTarget(entity, "Volume", volume, 0.04);
  runtime.musicEntities ??= new Set();
  runtime.musicEntities.add(entity);
  runtime.musicTokens.add(token);
  return true;
}

                                                                      
                                                                             
                                                                              
                                                                
function playRaceMusic(runtime) {
  const index = runtime.raceBgmIndex ?? 0;
                                                                        
                                                                            
                                                                          
  const entity = index % 2 === 0
    ? state.raceAnchors?.bgmToadsA
    : state.raceAnchors?.bgmToads;
  if (validEntity(entity)) {
    fireTarget(entity, "Volume", "10");
    fireTarget(entity, "PlaySound", "");
    runtime.musicEntities ??= new Set();
    runtime.musicEntities.add(entity);
    runtime.raceBgmAnchorUsed = true;
    runtime.raceBgmHistory ??= [];
    runtime.raceBgmHistory.push({ index, requested: ENDING_MUSIC.RACE, anchor: index % 2 === 0 ? "A" : "B", entity });
    runtime.raceBgmIndex = index + 1;
    return true;
  }
  runtime.raceBgmAnchorUsed = false;
  runtime.raceBgmNote = "soundevent_bgm_toads_turnpike anchor is unavailable";
  runtime.raceBgmHistory ??= [];
  runtime.raceBgmHistory.push({ index, requested: ENDING_MUSIC.RACE, fallback: true });
  runtime.raceBgmIndex = index + 1;
                                                                         
                                                                    
  return playEndingMusic(runtime, ENDING_MUSIC.RACE, true);
}

function triggerRaceFade(runtime, at = Instance.GetGameTime()) {
  const fade = state.raceAnchors?.fade;
  runtime.raceFadeAt = at;
  if (validEntity(fade)) {
    fireTarget(fade, "Fade", "");
    runtime.raceFadeSupported = true;
    return true;
  }
  runtime.raceFadeSupported = false;
  runtime.raceFadeNote = "ending_race_fade base entity is unavailable; fade timing is retained for map asset wiring";
  return false;
}

function stopEndingMusic(runtime) {
  if (runtime) clearSourceAudio(runtime);
  for (const entity of runtime?.musicEntities ?? []) {
    if (!validEntity(entity)) continue;
    fireTarget(entity, "Volume", "0");
    fireTarget(entity, "StopSound", "");
  }
  runtime?.musicEntities?.clear?.();
  runtime?.musicTokens?.clear?.();
}

function finaleMusicHistory(runtime, event, token, at = Instance.GetGameTime()) {
  runtime.finaleMusicHistory ??= [];
  runtime.finaleMusicHistory.push({ event, token, at });
  if (runtime.finaleMusicHistory.length > 32) runtime.finaleMusicHistory.splice(0, runtime.finaleMusicHistory.length - 32);
}

function startFinaleBridgeMusic(runtime, at = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.bossMode !== "boss") return false;
  stopEndingMusic(runtime);
                                                                             
  const played = playSourceAudioStack([13673, 13675, 13675], runtime.anchor ?? vec(), { owner: runtime });
  endingTaskAt(runtime, at + 68.7, () => {
    if (runtime.finaleMusicPhase === "bridge")
      playSourceAudioStack([13673, 13675, 13675], runtime.anchor ?? vec(), { owner: runtime });
  }, `finale_bridge_audio_${runtime.sequence}`);
  runtime.finaleMusicPhase = played ? "bridge" : "bridge_missing";
  runtime.finaleMusicBridgeAt = at;
  finaleMusicHistory(runtime, "bridge", "grained", at);
  return played;
}

function startFinaleBossMusic(runtime, at = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.bossMode !== "boss") return false;
  runtime.finaleMusicPhase = "boss_intro";
  runtime.finaleMusicStartedAt = at;
  runtime.finaleMusicStartAt = at + FINALE_MUSIC_CONFIG.bossIntroDelay;
  runtime.finaleMusicLoopAt = at + FINALE_MUSIC_CONFIG.bossLoopDelay;

  endingTaskAt(runtime, runtime.finaleMusicStartAt, () => {
    if (runtime.bossPhase !== "escape") processFinaleMusic(runtime, Instance.GetGameTime());
  }, `finale_music_intro_${runtime.sequence}`);
  endingTaskAt(runtime, runtime.finaleMusicLoopAt, () => {
    if (!runtime || runtime.bossPhase === "escape") return;
    startFinaleMusicLoop(runtime, runtime.finaleMusicLoopAt);
  }, `finale_music_loop_${runtime.sequence}`);
  return true;
}

function startFinaleMusicLoop(runtime, at = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE") return false;
  const infinite = runtime.infinite === true;
  if (infinite && !runtime.finaleInfiniteMusicStaticPlayed) {
    stopEndingMusic(runtime);
    const played = playEndingMusic(runtime, "confronting_myself_infinite_static", true);
    runtime.finaleInfiniteMusicStaticPlayed = true;
    runtime.finaleMusicPhase = played ? "infinite_static" : "infinite_static_missing";
    runtime.finaleMusicNextAt = at + FINALE_MUSIC_CONFIG.infiniteStaticDelay;
    finaleMusicHistory(runtime, "infinite_static", "confronting_myself_infinite_static", at);
    return played;
  }
  const token = infinite ? "confronting_myself_loop_infinite" : "confronting_myself_loop";
  stopEndingMusic(runtime);
  const played = playEndingMusic(runtime, token, true);
  runtime.finaleMusicPhase = played ? "loop" : "loop_missing";
  runtime.finaleMusicNextAt = at + (infinite
    ? FINALE_MUSIC_CONFIG.infiniteLoopDuration
    : FINALE_MUSIC_CONFIG.normalLoopDuration);
  finaleMusicHistory(runtime, "loop", token, at);
  return played;
}

function processFinaleMusic(runtime, now = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE") return;
                                                                         
                                                                            
                                                                              
                                                                  
  if (["boss_intro", "boss_start_missing"].includes(runtime.finaleMusicPhase)
    && now + 1e-6 >= (runtime.finaleMusicStartAt ?? Infinity)
    && runtime.finaleMusicStartPlayedAt === undefined
    && now + 1e-6 >= (runtime.finaleMusicRetryAt ?? runtime.finaleMusicStartAt ?? Infinity)
    && runtime.bossPhase !== "escape") {
    stopEndingMusic(runtime);
    const played = playEndingMusic(runtime, "confronting_myself_start", true);
    runtime.finaleMusicPhase = played ? "boss_start" : "boss_start_missing";
    runtime.finaleMusicStartPlayedAt = played ? runtime.finaleMusicStartAt : undefined;
    runtime.finaleMusicRetryAt = played ? undefined : now + 1;
    finaleMusicHistory(runtime, "boss_start", "confronting_myself_start", runtime.finaleMusicStartAt);
  }
  if (["boss_intro", "boss_start", "boss_start_missing"].includes(runtime.finaleMusicPhase)
    && now + 1e-6 >= (runtime.finaleMusicLoopAt ?? Infinity)
    && runtime.bossPhase !== "escape") {
    startFinaleMusicLoop(runtime, runtime.finaleMusicLoopAt);
  }
  if (["infinite_static", "infinite_static_missing"].includes(runtime.finaleMusicPhase)
    && now + 1e-6 >= (runtime.finaleMusicNextAt ?? Infinity)) {
    startFinaleMusicLoop(runtime, runtime.finaleMusicNextAt);
  }
  if (!["loop", "loop_missing"].includes(runtime.finaleMusicPhase)
    || now + 1e-6 < (runtime.finaleMusicNextAt ?? Infinity)) return;
  const duration = runtime.infinite === true
    ? FINALE_MUSIC_CONFIG.infiniteLoopDuration
    : FINALE_MUSIC_CONFIG.normalLoopDuration;
  let at = runtime.finaleMusicNextAt;
  while (now + 1e-6 >= at) {
    startFinaleMusicLoop(runtime, at);
    at = runtime.finaleMusicNextAt;
    if (!(duration > 0)) break;
  }
}

function scheduleFinaleBossLogo(runtime, startAt = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE") return false;
  if (runtime.bossLogoScheduled) return runtime.bossLogoSupported === true;
  runtime.bossLogoScheduled = true;

  const players = allPlayerPawns();
  runtime.bossLogoPlayers = players.length;
  runtime.bossLogoHistory ??= [];

                                                                            
                                                                              
                                                                         
                                                                           
                                                                     
  const titleParticle = resolveScreenParticle(
    state.collectiveTitle,
    FINALE_BOSS_LOGO_CONFIG.particleTarget,
  );
  if (validEntity(titleParticle)) {
    const title = state.collectiveTitle;
    const serial = ++title.serial;
    setCollectiveTitleEnabled(false);
    const titleStartAt = startAt + FINALE_BOSS_LOGO_CONFIG.revealDelay;
    const titleStopAt = titleStartAt
      + FINALE_BOSS_LOGO_CONFIG.particleDuration
      + FINALE_BOSS_LOGO_CONFIG.particleStopPadding;
    runtime.bossLogoSupported = true;
    runtime.bossLogoMode = "particle";
    runtime.bossLogoHistory.push({
      event: "scheduled",
      mode: "particle",
      at: startAt,
      particleStartAt: titleStartAt,
      particleStopAt: titleStopAt,
      players: players.length,
    });
    endingTaskAt(runtime, titleStartAt, () => {
      if (title.serial !== serial) return;
      const started = setCollectiveTitleEnabled(true);
      runtime.bossLogoHistory.push({
        event: started ? "particle_start" : "particle_start_missing",
        target: FINALE_BOSS_LOGO_CONFIG.particleTarget,
        at: titleStartAt,
      });
    }, `finale_boss_logo_particle_start_${runtime.sequence}`);
    endingTaskAt(runtime, titleStopAt, () => {
      if (title.serial !== serial) return;
      const stopped = setCollectiveTitleEnabled(false);
      runtime.bossLogoHistory.push({
        event: stopped ? "particle_stop" : "particle_stop_missing",
        target: FINALE_BOSS_LOGO_CONFIG.particleTarget,
        at: titleStopAt,
      });
    }, `finale_boss_logo_particle_stop_${runtime.sequence}`);
    return true;
  }

                                                                      
                                 
  const commandTarget = Instance.FindEntityByName?.(FINALE_BOSS_LOGO_CONFIG.commandTarget);
  if (!validEntity(commandTarget)) {
    runtime.bossLogoSupported = false;
    runtime.bossLogoMode = "unavailable";
    runtime.bossLogoNote = `neither particle '${FINALE_BOSS_LOGO_CONFIG.particleTarget}' nor point_clientcommand '${FINALE_BOSS_LOGO_CONFIG.commandTarget}' is available`;
    return false;
  }

  runtime.bossLogoSupported = true;
  runtime.bossLogoMode = "command_fallback";
  runtime.bossLogoHistory.push({ event: "scheduled", mode: "command_fallback", at: startAt, players: players.length });

  const queueCommand = (pawn, label, delay, value) => {
    const dueAt = startAt + delay;
    const key = `finale_boss_logo_${runtime.sequence}_${label}_${Math.round(dueAt * 1000)}`;
    endingTaskAt(runtime, dueAt, () => {
      fireName(FINALE_BOSS_LOGO_CONFIG.commandTarget, "Command", value, 0, pawn);
      runtime.bossLogoHistory.push({ event: "command", label, value, at: dueAt, pawn });
      if (runtime.bossLogoHistory.length > 128) runtime.bossLogoHistory.shift();
    }, key);
  };

  for (const pawn of players) {
    for (let frame = 1; frame <= FINALE_BOSS_LOGO_CONFIG.frameCount; frame++) {
      queueCommand(
        pawn,
        `reveal_${frame}`,
        FINALE_BOSS_LOGO_CONFIG.revealDelay + (frame - 1) * FINALE_BOSS_LOGO_CONFIG.frameInterval,
        `r_screenoverlay luffaren/collective_boss_logo_${frame}`,
      );
    }
    const fadeStart = FINALE_BOSS_LOGO_CONFIG.revealDelay
      + FINALE_BOSS_LOGO_CONFIG.frameCount * FINALE_BOSS_LOGO_CONFIG.frameInterval
      + FINALE_BOSS_LOGO_CONFIG.holdDuration;
    for (let frame = FINALE_BOSS_LOGO_CONFIG.frameCount; frame >= 0; frame--) {
      queueCommand(
        pawn,
        `fade_${frame}`,
        fadeStart + (FINALE_BOSS_LOGO_CONFIG.frameCount - frame) * FINALE_BOSS_LOGO_CONFIG.frameInterval,
        `r_screenoverlay luffaren/collective_boss_logo_${frame}`,
      );
    }
    const clearAt = fadeStart
      + (FINALE_BOSS_LOGO_CONFIG.frameCount + 1) * FINALE_BOSS_LOGO_CONFIG.frameInterval;
    queueCommand(pawn, "clear", clearAt, "r_screenoverlay ");
    queueCommand(pawn, "clear_marker", clearAt + FINALE_BOSS_LOGO_CONFIG.clearMarkerDelay, "r_screenoverlay xxx");
    queueCommand(pawn, "clear_final", clearAt + FINALE_BOSS_LOGO_CONFIG.finalClearDelay, "r_screenoverlay ");
  }
  return true;
}

function setZombieRespawning(enabled, runtime) {
                                                                           
                                                                              
  if (!enabled && runtime?.respawnDisableInputIssuedAt !== undefined) return;
  fireName("zr_toggle_respawn", enabled ? "Enable" : "Disable");
  if (!enabled && runtime) runtime.respawnDisableInputIssuedAt = Instance.GetGameTime();
}

// Source EnableSpawnKiller(slay_flight_items=true): slay every flight holder,
// remove every flight item, and set ITEMS.flight.slay_enabled so no new
// flight spawns or takes off for the rest of the round.
function slayFlightHolders() {
  state.flightSlayEnabled = true;
  const owners = new Set([...state.levels.values(), state.endingRuntime, ...activeRuntimes()]);
  const result = { holders: 0, items: 0 };
  for (const owner of owners) {
    if (!owner || owner.lifecycle === "destroyed") continue;
    for (const item of [...(owner.items ?? [])]) {
      if (item.name !== "flight" || ["consumed", "cleaned"].includes(item.state)) continue;
      const holder = item.holder;
      if (holder?.IsAlive?.()) {
        holder.TakeDamage?.({
          damage: 999999,
          damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
        });
        result.holders++;
      }
      consumeItem(owner, item);
      result.items++;
    }
  }
  return result;
}

// Source EnableMassKillerAll(): spawn killer plus every living player.
function endingMassKillAll(runtime) {
  enableEndingSpawnKiller(runtime);
  for (const pawn of allLivingPawns()) {
    pawn.TakeDamage?.({
      damage: 999999,
      damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
    });
  }
}

function enableEndingSpawnKiller(runtime, scheduledAt, { slayFlight = true } = {}) {
  if (!runtime) return;
  // CLIMB enables the spawn killer without slaying flight first, then slays
  // flight later through the same call, so flight is handled before the latch.
  if (slayFlight && !runtime.spawnKillerFlightSlainAt) {
    runtime.spawnKillerFlightSlainAt = Instance.GetGameTime();
    runtime.spawnKillerFlightSlay = slayFlightHolders();
  }
  if (runtime.spawnKillerEnabledAt !== undefined) return;
  setZombieRespawning(false, runtime);
  runtime.spawnKillerEnabledAt = scheduledAt ?? Instance.GetGameTime();
  runtime.spawnKillerInputIssuedAt = Instance.GetGameTime();
  fireName("tele_spawninit", "Disable");
  fireName("tele_spawn", "Disable");
  fireName("spawnkiller", "Enable");
  fireName("tpdest_indicator", "Disable");
}

function cancelEndingTasks(runtime) {
  if (!runtime) return;
  for (const task of runtime.tasks ?? []) task.cancelled = true;
  runtime.tasks?.clear?.();
  state.scheduledTasks = state.scheduledTasks.filter((task) => task.owner !== runtime.owner);
}

                                                                        
                                                                           
                                                                         
                                                                              
                                                                    
function markEndingOutcomePending(runtime, humansWon) {
  if (!runtime || ["destroyed", "resolved"].includes(runtime.lifecycle)) return false;
  if (runtime.lifecycle === "outcome_pending") return true;
  cancelFinaleKamikaze(runtime);
  stopEndingMusic(runtime);
  cancelEndingTasks(runtime);
  for (const id of runtime.outputConnections ?? []) {
    disconnectEntityOutput(id);
    state.outputConnections.delete(id);
  }
  runtime.outputConnections?.clear?.();
  runtime.spawnQueue?.splice?.(0);
  runtime.remaining = 0;
  runtime.collapseQueue?.splice?.(0);
  runtime.outcome = {
    humansWon: humansWon === true,
    resolvedAt: Instance.GetGameTime(),
  };
  const source = runtime.sourceRuntime;
  // Both runtimes leave activeRuntimes() below; retire in-flight gust/pizza
  // instead of leaving them frozen mid-air until the round resets.
  retireLinearZombieProjectiles(runtime);
  if (source && source.lifecycle !== "destroyed") retireLinearZombieProjectiles(source);
  if (source && !["outcome_pending", "destroyed"].includes(source.lifecycle)) {
    source.lifecycleBeforeOutcome = source.lifecycle;
    source.lifecycle = "outcome_pending";
    source.lifecycleHistory?.push?.("outcome_pending");
  }
  runtime.lifecycle = "outcome_pending";
  runtime.lifecycleHistory?.push?.("outcome_pending");
  return true;
}

function endingCardinalDirection(runtime) {
  const source = runtime?.sourceRuntime;
  const raw = source?.outgoing ?? source?.incoming ?? vec(1, 0, 0);
  if (Math.abs(raw.x) >= Math.abs(raw.y)) return vec(raw.x < 0 ? -1 : 1, 0, 0);
  return vec(0, raw.y < 0 ? -1 : 1, 0);
}

function createEndingRuntime(kind, stageSnapshot, sourceRuntime) {
  const ending = String(kind || "").toUpperCase();
  if (!ENDING_NAMES.includes(ending) && ending !== "FINALE") throw new Error(`unknown ending '${ending}'`);
  if (ending === "FINALE") stageSnapshot = Object.freeze({ ...stageSnapshot,
    theme: "generic", themeProfile: THEME_PROFILES.generic });
  if (state.endingRuntime && ["spawning", "defending", "collapsing", "active"].includes(state.endingRuntime.lifecycle)) {
    return state.endingRuntime;
  }
  if (!sourceRuntime?.end) throw new Error(`${ending} requires the completed level exit`);
                                                                            
                                                                        
                                                                              
  closeBlockSpawnSafety(sourceRuntime);
  for (const level of state.levels.values()) {
    if (!level.raceLevel && !level.finaleEscape) closeBlockSpawnSafety(level);
  }
  const owner = `ending:${ending.toLowerCase()}:${sourceRuntime.index}:${state.campaign.stageIndex}`;
  const runtime = {
    kind: ending,
    index: owner,
    sequence: (state.campaign.endingContractCalls ?? 0) + 1,
    owner,
    lifecycle: "spawning",
    lifecycleHistory: ["spawning"],
    stageSnapshot,
    sourceRuntime,
    // Levels alive when the ending starts; tp-delay endings retire them.
    endingSourceLevels: [...state.levels.values()],
    anchor: clone(sourceRuntime.end),
    runStartedAt: Instance.GetGameTime(),
    direction: undefined,
    left: undefined,
    entryPosition: undefined,
    tpPosition: undefined,
    entities: new Set(),
    internalEntities: new Set(),
    externalEntities: new Set(),
    terrainEntities: new Set(),
    externalTerrainEntities: new Set(),
    endingTerrainEntities: new Set(),
    endingSafeTerrainEntities: new Set(),
    bridgeEntities: new Set(),
    movers: new Set(),
    liquids: new Set(),
    liquidPawns: new Set(),
    traps: new Set(),
    items: new Set(),
    itemDeployables: new Set(),
    breakables: new Set(),
    outputConnections: new Set(),
    tasks: new Set(),
    spawnQueue: [],
    remaining: 0,
    collapseQueue: [],
    destroyedExternalCount: 0,
    layout: undefined,
    timelineAt: new Map(),
    timelineDue: new Set(),
    timelineDone: new Set(),
                                                                      
                                                                           
                                                                       
    bossMode: "pyramid",
    bossPhase: undefined,
    bosses: new Set(),
    bossArena: undefined,
    bossDamageMultiplier: 1,
    bossEscapeScheduled: false,
    bossSaveBoostHistory: [],
    finaleCleanerPosition: undefined,
    finaleZombieInvincibilityRange: undefined,
    kamikaze: undefined,
    kamikazeHistory: [],
    kamikazeNextAt: undefined,
    kamikazeSupported: false,
    kamikazeNote: undefined,
    bossGrenadeHitCount: 0,
    bossBullets: new Set(),
    bossPieceTouchCooldowns: new Map(),
                                                                            
                                                                            
    bossAttackVisuals: new Set(),
    bossPieces: new Set(),
    bossFallTrigger: undefined,
    bossAliveHumanCount: undefined,
    finaleStructure: undefined,
    finaleStructurePhase: undefined,
    finaleLowgravTriggers: new Set(),
    finaleLowgravVisuals: new Set(),
    finaleLowgravInside: new Map(),
    finaleTowerPieces: new Set(),
    finaleBridgePieces: new Set(),
    finaleArenaPieces: new Set(),
    finaleZPlatformPieces: new Set(),
    finaleZElevators: new Set(),
    escape: undefined,
    rubbleProfile: undefined,
    rubblePieces: [],
    rubbleSpawnedCount: 0,
    finaleElevatorDebrisStarted: false,
    finaleElevatorDebrisDone: false,
    finaleElevatorRiding: false,
    finaleLowgravAntiBoost: false,
    finaleMusicPhase: undefined,
    finaleMusicHistory: [],
    finaleMusicStartedAt: undefined,
    finaleMusicStartAt: undefined,
    finaleMusicLoopAt: undefined,
    finaleMusicNextAt: undefined,
    finaleInfiniteMusicStaticPlayed: false,
    finaleHornNextAt: undefined,
    finaleHornState: 1,
    finaleHornHistory: [],
    bossLogoScheduled: false,
    bossLogoSupported: undefined,
    bossLogoMode: undefined,
    bossLogoPlayers: 0,
    bossLogoHistory: [],
    bossLogoNote: undefined,
    finaleSky: undefined,
    finaleThunder: undefined,
    finaleThemeRandom: false,
    finaleThemeNames: [...FINALE_THEME_NAMES],
    finaleThemeHistory: [],
    finaleThemeCurrent: undefined,
    finaleMapPoolCount: undefined,
    finaleHumanItemsSpawned: false,
    finaleZombieItemsSpawned: false,
    finaleItemErrors: [],
  };
  runtime.direction = endingCardinalDirection(runtime);
  runtime.left = leftOf(runtime.direction);
  state.endingRuntime = runtime;
  return runtime;
}

function endingPosition(runtime, forwardCell, sideCell, elevation = 0) {
  return add(
    runtime.anchor,
    add(
      mul(runtime.direction, (forwardCell + 0.5) * CONFIG.gridSize),
      add(
        mul(runtime.left, sideCell * CONFIG.gridSize),
        vec(0, 0, elevation * CONFIG.elevationStep),
      ),
    ),
  );
}

function bunkerPosition(runtime, forwardCell, sideCell, elevation) {
  return endingPosition(runtime, forwardCell, sideCell + BUNKER_CONFIG.sideOffset, elevation);
}

function spawnEndingTerrain(
  runtime,
  shape,
  position,
  role,
  internal = false,
  external = !internal,
  angles = anglesFor(runtime.direction),
  themeName = stageSnapshotForRuntime(runtime).theme,
  terrainModel,
) {
  const baseShape = String(shape).split("@")[0];
  const template = state.templates.get(baseShape);
  if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") {
    throw new Error("ending terrain template '" + baseShape + "' is unavailable");
  }
  const spawned = spawnRoundEntities(template, position, angles) ?? [];
  const valid = spawned.filter((entity) => entity?.IsValid?.());
  if (valid.length === 0) throw new Error(`ending terrain '${shape}' failed to spawn`);
  const selectedTheme = themeProfile(themeName).name;
  const selectedModel = terrainModel ?? chooseTerrainModel(selectedTheme, baseShape);
  for (const entity of valid) {
    if (typeof entity.SetModel !== "function") {
      throw new Error(`ending terrain model replacement is unavailable for ${selectedTheme}/${baseShape}`);
    }
    entity.SetModel(selectedModel);
    applyTerrainAppearance(entity, 0);
                                                                              
    entity.Teleport?.({ position, angles, velocity: vec() });
    entity.SetEntityName?.(`ending_${runtime.kind.toLowerCase()}_${runtime.sequence}_${role}`);
    runtime.entities.add(entity);
    runtime.terrainEntities.add(entity);
    runtime.endingTerrainEntities.add(entity);
    if (internal) runtime.endingSafeTerrainEntities.add(entity);
    if (internal) runtime.internalEntities.add(entity);
    if (external) {
      runtime.externalEntities.add(entity);
      runtime.externalTerrainEntities.add(entity);
    }
  }
  return valid;
}

function spawnEndingTile(runtime, request) {
  const valid = spawnEndingTerrain(
    runtime,
    request.shape,
    request.position,
    request.role,
    request.internal,
    request.external,
    request.angles ?? anglesFor(runtime.direction),
    request.themeName,
    request.terrainModel,
  );
  for (const entity of valid) {
                                                                      
                                                                         
    try { entity.__endingTile = request.tile; } catch {                             }
    applyTerrainAppearance(entity, 0, genericRenderColor(request.tile, request.themeName
      ?? stageSnapshotForRuntime(runtime).theme));
  }
  return valid;
}

function createBunkerNativeDoor(runtime, door) {
  if (!validEntity(door.visual)) throw new Error(`BUNKER door ${door.index} has no visual`);
  const leg = spawnNativeMoverLeg(runtime,
    { feature: `bunkerDoor_${door.index}`, nativeTemplateKey: "finaleZombieMover" },
    door.visual.GetModelName(), door.closedPosition,
    add(door.closedPosition, vec(0, 0, BUNKER_CONFIG.doorFullHeight)), BUNKER_CONFIG.doorSpeed);
  try {
    const position = clone(door.visual.GetAbsOrigin());
    const angles = door.visual.GetAbsAngles?.();
    door.visual.SetParent(leg.driver);
    door.visual.Teleport({ position, ...(angles ? { angles } : {}), velocity: vec() });
    runtime.bunkerNativeDoors ??= new Set();
    runtime.bunkerNativeDoors.add(leg);
    door.nativeDoor = leg;
    return leg;
  } catch (error) {
    releaseNativeMoverLeg(runtime, leg);
    throw error;
  }
}

function setBunkerDoorState(runtime, door, stateName) {
  if (!door) return;
  const state = ["closed", "crouch", "full"].includes(stateName) ? stateName : "closed";
  door.state = state;
  const height = state === "full"
    ? BUNKER_CONFIG.doorFullHeight
    : state === "crouch"
      ? BUNKER_CONFIG.doorCrouchHeight
      : 0;
  const leg = door.nativeDoor;
  if (!leg || leg.retired || !validEntity(leg.driver)) throw new Error(`BUNKER door ${door.index} native driver is unavailable`);
  fireTarget(leg.driver, "SetPosition", String(height / BUNKER_CONFIG.doorFullHeight));
}

function setAllBunkerDoorsClosed(runtime) {
  for (const door of runtime?.doors ?? []) setBunkerDoorState(runtime, door, "closed");
}

function transferEndingSourceOwnership(runtime) {
  const source = runtime.sourceRuntime;
  if (!source) return;
  for (const entity of [...(source.entities ?? [])]) {
    source.entities.delete(entity);
    runtime.entities.add(entity);
    runtime.externalEntities.add(entity);
  }
                                                                            
                                                                             
                                                                         
                                                          
  for (const entity of [...(source.terrainEntities ?? [])]) {
    source.terrainEntities.delete(entity);
    source.safeTerrainEntities?.delete?.(entity);
    if (!entity?.IsValid?.()) continue;
    runtime.entities.add(entity);
    runtime.terrainEntities.add(entity);
    runtime.externalEntities.add(entity);
    runtime.externalTerrainEntities.add(entity);
  }
  for (const id of [...(source.outputConnections ?? [])]) {
    source.outputConnections.delete(id);
    runtime.outputConnections.add(id);
    state.outputConnections.set(id, runtime.owner);
  }
}

function queueEndingTerrain(runtime, shape, position, role, internal = false, external = !internal, record, angles, modelShape) {
  const baseShape = String(shape).split("@")[0];
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.spawnQueue.push({
    kind: "terrain", shape, position: clone(position), role, internal, external, record, angles,
    themeName, terrainModel: chooseTerrainModel(themeName, modelShape ?? baseShape),
  });
  runtime.remaining++;
}

                                                                          
                                                                       
                                                                               
                                                                              
                                               
function queueEndingTile(runtime, tile, shape, position, role, internal = false, external = !internal, record, angles) {
  const baseShape = String(shape).split("@")[0];
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.spawnQueue.push({
    kind: "tile", tile, shape, position: clone(position), role, internal, external, record, angles,
    themeName, terrainModel: chooseTerrainModel(themeName, baseShape),
  });
  runtime.remaining++;
}

function queueEndingLadder(runtime, position, angles, role, internal = false, external = !internal, record) {
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.spawnQueue.push({
    kind: "ladder", position: clone(position), angles, role, internal, external, record,
    themeName, themeModel: chooseTerrainModel(themeName, "ladder"),
  });
  runtime.remaining++;
}

function queueEndingClimb(runtime, kind, position, angles, role, internal = false, external = !internal, record) {
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.spawnQueue.push({
    kind: "climb", climbKind: kind, position: clone(position), angles, role, internal, external, record,
    themeName, themeModel: chooseTerrainModel(themeName, kind === "climbhard" ? "climbhard" : "climb"),
  });
  runtime.remaining++;
}

function queueEndingBreakable(runtime, position, angles, role, internal = false, external = !internal, record, safe = false, destructible = true) {
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.spawnQueue.push({
    kind: "breakable", position: clone(position), angles, role, internal, external, record, safe,
    themeName, terrainModel: chooseTerrainModel(themeName, "breakable"),
    ...(destructible === false ? { destructible: false } : {}),
  });
  runtime.remaining++;
}

function isBunkerBoundary(forward, side) {
  return (forward === 14 && side > 0 && side < 9)
    || (forward === 7 && side > 0 && side < 9)
    || (side === 1 && forward > 7 && forward < 14)
    || (side === 8 && forward > 7 && forward < 14);
}

function isBunkerDoorCell(forward, side) {
  return BUNKER_CONFIG.doorCells.some((cell) => cell.forward === forward && cell.side === side);
}

function isBunkerRaisedCorner(forward, side) {
  return ((forward > 7 && forward < 10) || (forward > 11 && forward < 14))
    && ((side > 1 && side < 4) || (side > 5 && side < 8));
}

function isBunkerCornerOpening(forward, side) {
  return (forward === 8 || forward === 13) && (side === 2 || side === 7);
}

function spawnBunkerGeometry(runtime) {
  runtime.layout = {
    width: BUNKER_CONFIG.width,
    height: BUNKER_CONFIG.height,
    anchor: clone(runtime.anchor),
    direction: clone(runtime.direction),
    left: clone(runtime.left),
    cells: [],
    entry: clone(runtime.entryPosition),
    interior: [],
    containment: {
      supported: BUNKER_CONFIG.containmentSupported,
      note: "CS2 point_script cannot reproduce the Source 1 filter/brush containment volume; no fake wall is asserted here.",
    },
  };

                                                                            
                                                                           
                                                                  
  for (const side of [4, 5]) {
    queueEndingTile(
      runtime,
      25,
      "platform",
      bunkerPosition(runtime, 0.02, side, -0.1),
      `tp_start_${side}`,
      false,
      true,
      runtime.bridgeEntities,
    );
  }

                                                                            
                                                                              
                                                                         
  for (let forward = 0; forward < BUNKER_CONFIG.width; forward++) {
    for (let side = 0; side < BUNKER_CONFIG.height; side++) {
      const interior = forward >= BUNKER_CONFIG.interiorMinForward
        && forward <= BUNKER_CONFIG.interiorMaxForward
        && side >= BUNKER_CONFIG.interiorMinSide
        && side <= BUNKER_CONFIG.interiorMaxSide;
      const boundary = isBunkerBoundary(forward, side);
      const doorCell = boundary && isBunkerDoorCell(forward, side);
      const raisedCorner = interior && isBunkerRaisedCorner(forward, side);
      const cornerOpening = raisedCorner && isBunkerCornerOpening(forward, side);
      let elevation = 0;
      let protectedTile = false;
      if (boundary) {
        elevation = doorCell ? BUNKER_CONFIG.raisedFloorElevation : BUNKER_CONFIG.wallElevation;
        protectedTile = true;
      }
      if (interior) {
        const roofPosition = bunkerPosition(runtime, forward, side, BUNKER_CONFIG.roofElevation);
        queueEndingTile(runtime, 25, "platform", roofPosition, `roof_${forward}_${side}`, true, false);
        elevation = raisedCorner ? BUNKER_CONFIG.raisedFloorElevation : BUNKER_CONFIG.interiorFloorElevation;
        protectedTile = true;
      }
      const position = bunkerPosition(runtime, forward, side, elevation);
      const cell = {
        forward,
        side,
        position: clone(position),
        interior,
        boundary,
        doorCell,
        raisedCorner,
        cornerOpening,
        entities: [],
      };
      runtime.layout.cells.push(cell);
      if (interior) runtime.layout.interior.push(cell);
                                                                             
                                                                              
                                                               
      // Source BUNKER keeps an index-5 floor at elevation 2 under each moving door.
      if (!cornerOpening) {
        queueEndingTile(runtime, 5, "floor", position, `floor_${forward}_${side}`, protectedTile, !protectedTile, cell.entities);
      }
    }
  }

  for (let index = 0; index < BUNKER_CONFIG.doorCells.length; index++) {
    const { forward, side } = BUNKER_CONFIG.doorCells[index];
    const lowerPosition = bunkerPosition(runtime, forward, side, BUNKER_CONFIG.raisedFloorElevation);
    const door = {
      index,
      forward,
      side,
      visual: undefined,
      entities: [],
      closedPosition: clone(lowerPosition),
      mover: undefined,
      state: "closed",
      processed: false,
    };
    runtime.doors.push(door);
    queueEndingTerrain(runtime, "floor", lowerPosition, `door_${index}`, true, false, door.entities, undefined, "hold");
  }
  if (runtime.doors.length !== BUNKER_CONFIG.openings.length) {
    throw new Error(`expected ${BUNKER_CONFIG.openings.length} bunker doors, got ${runtime.doors.length}`);
  }
  for (const [index, [forward, side]] of [[16, 4.5], [16, -1], [16, 10],
    [6, -1], [6, 10], [10.5, -1], [10.5, 10]].entries()) {
    queueEndingTile(runtime, 1, "wall", bunkerPosition(runtime, forward, side, 20),
      `outer_wall_${index}`, false, true);
  }
}

function scheduleBunkerTimeline(runtime) {
  const runAt = runtime.runStartedAt;
  runtime.doorTasks = [];
  runtime.tpTask = endingTaskAt(
    runtime,
    runAt + BUNKER_CONFIG.tpDelay,
    () => releaseBunkerTeleport(runtime),
    "tp",
  );
  let doorAt = runAt + 1.2;
  for (let index = 0; index < BUNKER_CONFIG.openings.length; index++) {
    const key = `door${index}`;
    runtime.doorTasks.push(endingTaskAt(
      runtime,
      doorAt,
      () => processBunkerDoorTick(runtime),
      key,
    ));
    doorAt += 10.02;
  }
  runtime.defendTask = endingTaskAt(
    runtime,
    runAt + BUNKER_CONFIG.defendTime,
    () => startBunkerCollapse(runtime, runAt + BUNKER_CONFIG.defendTime),
    "collapse",
  );
}

function releaseBunkerTeleport(runtime) {
  if (!runtime || runtime.tpMovedAt !== undefined) return;
  moveTeleportDestination(runtime.tpPosition, runtime.direction);
  runtime.tpMovedAt = Instance.GetGameTime();
  releaseEndingSourceLevels(runtime);
}

function finishBunkerSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  for (const door of runtime.doors) {
    door.visual = door.entities.find((entity) => entity?.IsValid?.());
    if (!door.visual) throw new Error(`BUNKER door ${door.index} failed to spawn`);
    createBunkerNativeDoor(runtime, door);
    setBunkerDoorState(runtime, door, "closed");
  }
  runtime.lifecycle = "defending";
  runtime.lifecycleHistory.push("defending");
  runtime.spawnFinishedAt = Instance.GetGameTime();
                                                          
                                                                           
                                                                            
                                               
  const dueDoors = {};
  for (let index = 0; index < BUNKER_CONFIG.openings.length; index++) {
    dueDoors[`door${index}`] = () => processBunkerDoorTick(runtime);
  }
  flushEndingTimeline(runtime, {
    ...dueDoors,
    tp: () => releaseBunkerTeleport(runtime),
    collapse: () => startBunkerCollapse(runtime, runtime.runStartedAt + BUNKER_CONFIG.defendTime),
  });
}

function spawnEndingLadder(runtime, request) {
                                                                        
                                                                        
                                                                        
                            
  const sourceYaw = request.angles?.yaw ?? yawOf(runtime.direction);
  const surfaceAngles = {
    pitch: request.angles?.pitch ?? 0,
    yaw: normalizeYaw(sourceYaw + 180),
    roll: request.angles?.roll ?? 0,
  };
  const visualAngles = {
    pitch: request.angles?.pitch ?? 0,
    yaw: normalizeYaw(sourceYaw + 90),
    roll: request.angles?.roll ?? 0,
  };
  const spawned = spawnRoundEntities(featureTemplate("ladder"), request.position, surfaceAngles) ?? [];
  const valid = spawned.filter((entity) => entity?.IsValid?.());
  if (valid.length === 0) throw new Error("ending ladder surface failed to spawn");
  for (const entity of valid) {
    entity.Teleport?.({ position: request.position, angles: surfaceAngles, velocity: vec() });
    entity.SetEntityName?.(`ending_${runtime.kind.toLowerCase()}_${runtime.sequence}_${request.role}_surface`);
    runtime.entities.add(entity);
    if (request.internal) runtime.internalEntities.add(entity);
    if (request.external) runtime.externalEntities.add(entity);
    if (registerTerrainEntity(runtime, entity)) {
      runtime.endingTerrainEntities.add(entity);
      if (request.internal) runtime.endingSafeTerrainEntities.add(entity);
      if (request.external) runtime.externalTerrainEntities.add(entity);
      if (request.internal) runtime.internalEntities.add(entity);
    }
  }
                                                                              
                                                                         
                                                                             
                                            
  const visual = spawnVisual(
    runtime,
    { position: request.position, angles: visualAngles, feature: `${runtime.kind.toLowerCase()}Ladder` },
    request.themeModel ?? LADDER_MODEL,
  );
  if (!visual) throw new Error("ending ladder visual failed to spawn");
  visual.SetEntityName?.(`ending_${runtime.kind.toLowerCase()}_${runtime.sequence}_${request.role}_visual`);
  registerTerrainEntity(runtime, visual);
  runtime.endingTerrainEntities.add(visual);
  if (request.internal) runtime.endingSafeTerrainEntities.add(visual);
  if (request.external) runtime.externalTerrainEntities.add(visual);
  if (request.internal) runtime.internalEntities.add(visual);
  if (request.external) runtime.externalEntities.add(visual);
  return [...valid, visual];
}

function spawnEndingClimb(runtime, request) {
  // Source ending yaw -> baked prototype yaw matches the ending ladder visual
  // (+90), same as stage climbs where prototype and ladder visual share yaw.
  const sourceYaw = request.angles?.yaw ?? yawOf(runtime.direction);
  const quadrant = ((Math.round(normalizeYaw(sourceYaw + 90) / 90) * 90) % 360 + 360) % 360;
  const template = featureTemplate(`${request.climbKind}${quadrant}`);
  const spawned = spawnRoundEntities(template, request.position) ?? [];
  const valid = spawned.filter((entity) => entity?.IsValid?.());
  if (valid.length === 0) throw new Error(`ending ${request.climbKind} surface failed to spawn`);
  for (const entity of valid) {
    if (!entity.GetClassName?.().startsWith("trigger_") && request.themeModel) {
      if (typeof entity.SetModel !== "function") throw new Error(`ending ${request.climbKind} themed model replacement is unavailable`);
      entity.SetModel(request.themeModel);
      applyTerrainAppearance(entity, 0);
    }
    entity.SetEntityName?.(`ending_${runtime.kind.toLowerCase()}_${runtime.sequence}_${request.role}`);
    runtime.entities.add(entity);
    if (request.internal) runtime.internalEntities.add(entity);
    if (request.external) runtime.externalEntities.add(entity);
    if (registerTerrainEntity(runtime, entity)) {
      runtime.endingTerrainEntities.add(entity);
      if (request.internal) runtime.endingSafeTerrainEntities.add(entity);
      if (request.external) runtime.externalTerrainEntities.add(entity);
      if (request.internal) runtime.internalEntities.add(entity);
    }
  }
  return valid;
}

function spawnEndingBreakable(runtime, request) {
  const stage = stageSnapshotForRuntime(runtime);
  const blockRequest = { ...request, themeName: request.themeName ?? stage.theme,
    feature: `${runtime.kind.toLowerCase()}Breakable` };
  const model = request.terrainModel ?? chooseTerrainModel(blockRequest.themeName, "breakable");
  // Source CLIMB uses BREAKABLE models without the breakable SpawnQueue flag.
  // Use the health=0 terrain prototype and retain the appearance, with no damage outputs.
  const block = request.destructible === false
    ? spawnModelBlock(runtime, blockRequest, model, 0, 1)
    : spawnBreakableBlock(runtime, blockRequest, model);
  if (!block) throw new Error("ending breakable failed to spawn");
  if (request.destructible === false) {
    const color = genericRenderColor(91, blockRequest.themeName);
    applyTerrainAppearance(block, 1, color);
    const visualRecord = state.silentHillWorld.visuals.get(block);
    if (visualRecord) visualRecord.restore = () => applyTerrainAppearance(block, 1, color);
  }
  registerTerrainEntity(runtime, block, request.safe === true);
  runtime.endingTerrainEntities.add(block);
  if (request.safe === true || request.internal) runtime.endingSafeTerrainEntities.add(block);
  if (request.external) runtime.externalTerrainEntities.add(block);
  if (request.internal) runtime.internalEntities.add(block);
  if (request.external) runtime.externalEntities.add(block);
  return [block];
}

function processEndingSpawnQueue(runtime, onFinished) {
  if (!runtime || runtime.lifecycle !== "spawning") return;
  // Original TickSpawnQueue spawned tickspawnqueue_procamount (3) blocks per tick,
  // so ending terrain visibly builds up instead of appearing in one burst.
  const amount = Math.min(CONFIG.spawnQueuePerThink, runtime.spawnQueue.length);
  try {
    for (let index = 0; index < amount; index++) {
      const request = runtime.spawnQueue.shift();
      const spawned = request.kind === "ladder"
        ? spawnEndingLadder(runtime, request)
        : request.kind === "climb"
          ? spawnEndingClimb(runtime, request)
          : request.kind === "breakable"
            ? spawnEndingBreakable(runtime, request)
          : request.kind === "tile"
            ? spawnEndingTile(runtime, request)
          : spawnEndingTerrain(
          runtime,
          request.shape,
          request.position,
          request.role,
          request.internal,
          request.external,
          request.angles ?? anglesFor(runtime.direction),
          request.themeName,
          request.terrainModel,
        );
      if (typeof request.record?.push === "function") request.record.push(...spawned);
      else if (typeof request.record?.add === "function") for (const entity of spawned) request.record.add(entity);
      runtime.remaining--;
    }
    if (runtime.remaining === 0) onFinished(runtime);
  } catch (error) {
    failRuntime(`${runtime.kind} terrain spawn failed: ${error}`);
  }
}

function processBunkerSpawning(runtime) {
  processEndingSpawnQueue(runtime, finishBunkerSpawn);
}

function bunkerWorldToLocal(runtime, position) {
  const delta = sub(position, runtime.anchor);
  return {
    forward: (delta.x * runtime.direction.x + delta.y * runtime.direction.y) / CONFIG.gridSize - 0.5,
    side: (delta.x * runtime.left.x + delta.y * runtime.left.y) / CONFIG.gridSize - BUNKER_CONFIG.sideOffset,
    elevation: delta.z / CONFIG.elevationStep,
  };
}

function bunkerContainsPosition(runtime, position) {
  if (!runtime || !position) return false;
                                                                          
                                                                         
                                                                            
                                                                            
  const center = endingPosition(
    runtime,
    BUNKER_CONFIG.containmentCenterForward,
    0,
    BUNKER_CONFIG.containmentCenterElevation,
  );
  const delta = sub(position, center);
  const forward = delta.x * runtime.direction.x + delta.y * runtime.direction.y;
  const side = delta.x * runtime.left.x + delta.y * runtime.left.y;
  return Math.abs(forward) <= BUNKER_CONFIG.containmentHalfXY
    && Math.abs(side) <= BUNKER_CONFIG.containmentHalfXY
    && Math.abs(delta.z) <= BUNKER_CONFIG.containmentHalfZ;
}

function capBunkerZombieHealth(pawn) {
  const health = pawn?.GetHealth?.();
  if (!Number.isFinite(health) || health <= BUNKER_CONFIG.zombieHealthCap) return;
  if (typeof pawn.SetHealth === "function") {
    pawn.SetHealth(BUNKER_CONFIG.zombieHealthCap);
    return;
  }
  if (typeof pawn.TakeDamage === "function") {
    pawn.TakeDamage({
      damage: health - BUNKER_CONFIG.zombieHealthCap,
      damageFlags: CSDamageFlags.IGNORE_ARMOR ?? 0,
    });
  }
}

function bunkerTeamCounts() {
  let humans = 0;
  let zombies = 0;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() === 3) humans++;
    else if (pawn.GetTeamNumber?.() === 2) zombies++;
  }
  return { humans, zombies };
}

function processBunkerDoorTick(runtime) {
  if (!runtime || runtime.lifecycle !== "defending" || runtime.openings.length === 0) return;
  const opening = runtime.openings.shift();
  const candidates = runtime.doors.filter((door) => !door.processed);
  if (candidates.length === 0) return;
  const door = candidates[Math.floor(Math.random() * candidates.length)];
  door.processed = true;
  const { humans, zombies } = bunkerTeamCounts();
  const ratio = zombies > 0 ? humans / zombies : Infinity;
  let stateName = "closed";
  if (zombies === 0 || ratio > opening.ratioFull) stateName = "full";
  else if (ratio > opening.ratioCrouch) stateName = "crouch";
  setBunkerDoorState(runtime, door, stateName);
  runtime.doorHistory.push({ index: door.index, state: stateName, ratio, opening });
  const ratioText = Number.isFinite(ratio) ? ratio.toFixed(2) : "no opposition";
  endingAnnounce(runtime, 0, `BUNKER ENDING: door ${door.index + 1} ${stateName.toUpperCase()} (ratio ${ratioText})`);
}

function destroyEndingEntity(runtime, entity, deferKill = false) {
  if (!entity) return;
  const fall = entity.collectiveEndingFall;
  if (fall && !fall.retired) {
    retireEndingNativeFall(runtime, fall);
    return;
  }
  if (deferKill) queueEntityKills([entity]);
  else if (entity.IsValid?.()) entity.Kill?.();
  runtime.entities?.delete(entity);
  state.terrainSpawnFades.delete(entity);
  state.silentHillWorld.visuals.delete(entity);
  runtime.externalEntities.delete(entity);
  runtime.terrainEntities?.delete(entity);
  runtime.safeTerrainEntities?.delete?.(entity);
  runtime.externalTerrainEntities?.delete(entity);
  runtime.endingTerrainEntities?.delete(entity);
  runtime.endingSafeTerrainEntities?.delete(entity);
  runtime.internalEntities?.delete(entity);
  runtime.collapseQueue = runtime.collapseQueue.filter((candidate) => candidate !== entity);
  for (const mover of [...(runtime.movers ?? [])]) {
    if (mover.visual === entity) runtime.movers.delete(mover);
  }
  runtime.destroyedExternalCount++;
}

const ENDING_NATIVE_FALL_CONFIG = Object.freeze({ maxActivePieces: 40, motionDelay: 0.02 });

function retireEndingNativeFall(runtime, fall) {
  if (!fall || fall.retired) return;
  fall.retired = true;
  runtime.nativeFallingPieces?.delete(fall);
  runtime.activeFallingPieces = Math.max(0, (runtime.activeFallingPieces ?? 0) - 1);
  delete fall.original.collectiveEndingFall;
  delete fall.visual.collectiveEndingFall;
  destroyEndingEntity(runtime, fall.visual);
}

function beginEndingEntityFall(runtime, entity, lifetime, maximumActive = ENDING_NATIVE_FALL_CONFIG.maxActivePieces) {
  const existing = entity?.collectiveEndingFall;
  if (existing && !existing.retired) return existing.visual;
  if (!validEntity(entity)) return false;
  runtime.activeFallingPieces ??= 0;
  if (runtime.activeFallingPieces >= maximumActive) {
    destroyEndingEntity(runtime, entity);
    return false;
  }
  const classname = String(entity.GetClassName?.() ?? "").toLowerCase();
  const alreadyPhysics = classname.startsWith("prop_physics") || classname.startsWith("func_physbox");
  if (!alreadyPhysics && !classname.startsWith("prop_dynamic")) {
    // Brush triggers and controllers cannot become model physics props.
    destroyEndingEntity(runtime, entity);
    return false;
  }
  let visual = entity;
  try {
    if (!alreadyPhysics) {
      const position = entity.GetAbsOrigin();
      const angles = entity.GetAbsAngles();
      const model = entity.GetModelName?.();
      if (!model) throw new Error("ending collapse terrain model is unavailable");
      visual = spawnRacePhysicsRubbleFallback(runtime, { position, angles, feature: "endingNativeFall" }, model);
      const color = entity.GetColor?.() ?? entity.collectiveBaseColor;
      if (color) visual.SetColor?.(color);
      visual.collectiveBaseColor = entity.collectiveBaseColor;
      visual.collectiveBodyGroup = entity.collectiveBodyGroup;
      if (entity.collectiveBodyGroup !== undefined)
        fireTarget(visual, "SetBodyGroup", `Main,${entity.collectiveBodyGroup}`);
    }
    fireTarget(visual, "DisableMotion");
    fireTarget(visual, "ClearParent");
    visual.SetHealth?.(0);
    fireTarget(visual, "DisableDamageForces");
    fireTarget(visual, "SetAutoConvertBackFromDebris", "0");
    raceSetCollisionGroup(visual, RACE_CONFIG.fallCollisionGroup);
  } catch (error) {
    // Keep the original terrain if its replacement could not be prepared.
    if (visual !== entity) destroyEndingEntity(runtime, visual);
    throw error;
  }
  if (visual !== entity) destroyEndingEntity(runtime, entity);
  runtime.externalEntities.delete(visual);
  runtime.externalTerrainEntities?.delete(visual);
  runtime.terrainEntities?.delete(visual);
  runtime.endingTerrainEntities?.delete(visual);
  for (const mover of [...(runtime.movers ?? [])]) {
    if (mover.visual === visual || mover.collider === visual) runtime.movers.delete(mover);
  }
  runtime.collapseQueue = runtime.collapseQueue.filter((candidate) => candidate !== visual);
  runtime.entities.add(visual);
  const fall = { original: entity, visual, expiresAt: Instance.GetGameTime() + lifetime, retired: false };
  entity.collectiveEndingFall = fall;
  visual.collectiveEndingFall = fall;
  runtime.nativeFallingPieces ??= new Set();
  runtime.nativeFallingPieces.add(fall);
  runtime.activeFallingPieces++;
  endingTask(runtime, ENDING_NATIVE_FALL_CONFIG.motionDelay, () => {
    if (!fall.retired && validEntity(visual)) fireTarget(visual, "EnableMotion");
  });
  // Engine expiry remains effective if the ending cancels its script tasks.
  fireTarget(visual, "Kill", "", lifetime);
  endingTask(runtime, lifetime, () => retireEndingNativeFall(runtime, fall));
  return visual;
}

function processBunkerCollapseTick(runtime) {
  if (!runtime || runtime.lifecycle !== "collapsing") return;
  setAllBunkerDoorsClosed(runtime);
  while (runtime.collapseQueue.length > 0) {
    const entity = runtime.collapseQueue.shift();
    if (!entity?.IsValid?.()) continue;
    beginEndingEntityFall(runtime, entity, BUNKER_CONFIG.fallingPieceLifetime);
    break;
  }
  if (runtime.collapseQueue.some((entity) => entity?.IsValid?.())) {
    runtime.collapseTask = endingTask(runtime, BUNKER_CONFIG.collapseRate, () => processBunkerCollapseTick(runtime));
    return;
  }
  runtime.collapseFinishedAt = Instance.GetGameTime();
  runtime.timeoutTask = endingTask(runtime, BUNKER_CONFIG.timeoutSlayAll, () => {
    const counts = bunkerTeamCounts();
    if (counts.zombies > 0) {
      for (const pawn of allLivingPawns()) {
        pawn.TakeDamage?.({
          damage: 999999,
          damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
        });
      }
      resolveStageEnding(false);
    } else if (counts.humans > 0) {
      resolveStageEnding(true);
    } else {
      resolveStageEnding(false);
    }
  });
  endingAnnounce(runtime, 0, `BUNKER ENDING: YOU TOOK TOO LONG; ${BUNKER_CONFIG.timeoutSlayAll}s REMAIN`);
}

function startBunkerCollapse(runtime, scheduledAt) {
  if (!runtime || runtime.lifecycle !== "defending") return;
  runtime.lifecycle = "collapsing";
  runtime.lifecycleHistory.push("collapsing");
  runtime.collapseStartedAt = scheduledAt ?? Instance.GetGameTime();
  endingAnnounce(runtime, 0, "BUNKER ENDING: THE OUTSIDE IS STARTING TO CRUMBLE");
  setAllBunkerDoorsClosed(runtime);
                                                                             
                                                                              
                                                           
  runtime.collapseQueue = shuffleCopy([...runtime.externalTerrainEntities]
    .filter((entity) => entity?.IsValid?.() && !runtime.bridgeEntities.has(entity)));
  endingTask(runtime, 1, () => {
    enableEndingSpawnKiller(runtime);
    for (const entity of [...runtime.bridgeEntities]) destroyEndingEntity(runtime, entity);
    runtime.bridgeEntities.clear();
  });
  runtime.collapseTask = endingTask(runtime, BUNKER_CONFIG.collapseRate, () => processBunkerCollapseTick(runtime));
}

function finishEndingRuntime(runtime, lifecycle = "resolved") {
  if (!runtime) return;
  for (const leg of runtime.bunkerNativeDoors ?? []) releaseNativeMoverLeg(runtime, leg);
  runtime.bunkerNativeDoors?.clear();
  clearBoostPads(runtime);
  cancelFinaleKamikaze(runtime);
  if (runtime.kind === "FINALE") {
    for (const lift of [...(runtime.finaleNativeLifts ?? [])]) retireFinaleNativeLift(runtime, lift);
    clearFinaleBossBullets(runtime);
    runtime.bossPieceTouchCooldowns?.clear();
    if (runtime.bossPhase === "escape") state.finaleEscapeActive = false;
    state.finalePostImpostorUntil = 0;
    stopFinaleThunder(runtime);
    stopCollectiveTitle("finale_cleanup");
  }
                                                                          
                                                                             
                                                                      
  if (runtime.kind === "RACE") cleanupRaceRuntime(runtime);
  stopEndingMusic(runtime);
  cancelEndingTasks(runtime);
  for (const id of runtime.outputConnections ?? []) {
    disconnectEntityOutput(id);
    state.outputConnections.delete(id);
  }
  runtime.outputConnections?.clear?.();
  for (const item of runtime.items ?? []) {
    if (item.holder) forgetPlayerItem(item.holder, item);
    item.holder = undefined;
    item.state = "cleaned";
    ITEM_BEHAVIORS[item.definition.behavior]?.onCleanup?.(runtime, item);
    cleanupItemStripTrigger(runtime, item);
    destroyItemCarrier(item);
  }
  runtime.items?.clear?.();
  for (const deployable of [...(runtime.itemDeployables ?? [])]) {
    if (deployable.kind === "impostor") cleanupImpostor(runtime, deployable);
    else cleanupDeployable(runtime, deployable);
  }
  runtime.itemDeployables?.clear?.();
  for (const fall of [...(runtime.nativeFallingPieces ?? [])]) retireEndingNativeFall(runtime, fall);
  for (const entity of runtime.entities ?? []) if (entity?.IsValid?.()) entity.Kill?.();
  runtime.lifecycle = lifecycle;
  if (runtime.lifecycleHistory) runtime.lifecycleHistory.push(lifecycle);
  if (runtime.spawnQueue) runtime.spawnQueue.length = 0;
  runtime.remaining = 0;
  if (runtime.collapseQueue) runtime.collapseQueue.length = 0;
  if (runtime.doors) runtime.doors.length = 0;
  runtime.internalEntities?.clear?.();
  runtime.externalEntities?.clear?.();
  runtime.terrainEntities?.clear?.();
  runtime.safeTerrainEntities?.clear?.();
  runtime.externalTerrainEntities?.clear?.();
  runtime.endingTerrainEntities?.clear?.();
  runtime.endingSafeTerrainEntities?.clear?.();
  runtime.bridgeEntities?.clear?.();
  runtime.infectionImmunityUntil?.clear?.();
  runtime.movers?.clear?.();
}

function destroyEndingRuntime(runtime = state.endingRuntime, reason = "destroyed") {
  if (!runtime) return;
  finishEndingRuntime(runtime, "destroyed");
  runtime.destroyReason = reason;
  runtime.entities?.clear?.();
  if (state.endingRuntime === runtime) {
    state.endingRuntime = undefined;
    state.campaign.endingOutcomePending = false;
  }
}

function startBunkerEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["spawning", "defending", "collapsing"].includes(state.endingRuntime.lifecycle)) {
    return state.endingRuntime;
  }
  const runtime = Object.assign(createEndingRuntime("BUNKER", stageSnapshot, sourceRuntime), {
    doors: [],
    openings: BUNKER_CONFIG.openings.map((opening) => ({ ...opening })),
    doorHistory: [],
  });
  runtime.entryPosition = bunkerPosition(runtime, 0, 4.5, 0);
  runtime.tpPosition = add(runtime.entryPosition, vec(0, 0, 8));
                                                                           
                                                                           
  scheduleBunkerTimeline(runtime);
  playEndingMusic(runtime, ENDING_MUSIC.BUNKER);
  endingAnnounce(runtime, 0, "BUNKER ENDING: THIS IS YOUR LAST STAND");
  endingAnnounce(runtime, 1.03, "BUNKER ENDING: DEFEND THE BUNKER WITH YOUR LIFE");
  endingAnnounce(runtime, 5, `BUNKER ENDING: HOLD OUT FOR ${BUNKER_CONFIG.defendTime - 5}s`);
  endingCountdown(runtime, BUNKER_CONFIG.defendTime, "BUNKER ENDING: THE OUTSIDE WILL CRUMBLE IN");
  try {
    for (const shape of ["floor", "platform", "wall"]) {
      const template = state.templates.get(shape);
      if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") {
        throw new Error(`BUNKER requires terrain template '${shape}'`);
      }
    }
    spawnBunkerGeometry(runtime);
    if (runtime.remaining <= 0) throw new Error("BUNKER produced no terrain spawn requests");
    announce("BUNKER ending terrain is generating");
    return runtime;
  } catch (error) {
    destroyEndingRuntime(runtime, "startup_failed");
    throw error;
  }
}

function processBunkerEnding() {
  const runtime = state.endingRuntime;
  if (!runtime) return;
  if (runtime.lifecycle === "spawning") {
    processBunkerSpawning(runtime);
    return;
  }
  if (!["defending", "collapsing"].includes(runtime.lifecycle)) return;
  const pawns = allLivingPawns();
  let humans = 0;
  let zombies = 0;
  for (const pawn of pawns) {
    const team = pawn.GetTeamNumber?.();
    if (team === 3) humans++;
    else if (team === 2) {
      zombies++;
      if (bunkerContainsPosition(runtime, pawn.GetAbsOrigin?.())) capBunkerZombieHealth(pawn);
    }
  }
  runtime.lastTeamCounts = { humans, zombies };
  if (humans <= 0) {
    resolveStageEnding(false);
  } else if (zombies <= 0) {
    resolveStageEnding(true);
  }
}

function bridgeAngles(runtime, localYaw = 0) {
  return { pitch: 0, yaw: normalizeYaw(yawOf(runtime.direction) + localYaw), roll: 0 };
}

function queueBridgePart(runtime, shape, forward, side, elevation, role, options = {}) {
  const position = endingPosition(runtime, forward, side, elevation);
  const record = [];
  const part = { shape, forward, side, elevation, position: clone(position), entities: record, ...options };
  runtime.layout.parts.push(part);
  if (shape === "ladder") {
    queueEndingLadder(runtime, position, bridgeAngles(runtime, options.localYaw ?? 0), role, false, true, record);
  } else {
    const tile = options.tile ?? ({ floor: 5, platform: 25, wall: 1, detail: 90 })[shape];
    if (!Number.isInteger(tile)) throw new Error(`BRIDGE source tile is unavailable for '${shape}'`);
    queueEndingTile(
      runtime,
      tile,
      shape,
      position,
      role,
      options.internal === true,
      options.external !== false,
      record,
      options.localYaw === undefined ? undefined : bridgeAngles(runtime, options.localYaw),
    );
  }
  return part;
}

function spawnBridgeGeometry(runtime) {
  runtime.layout = { length: 44, width: 7, parts: [], path: [], finish: [] };
  queueBridgePart(runtime, "platform", 1.02, 0.02, -0.10, "tp_start", { startBlock: true });
  queueBridgePart(runtime, "floor", 0, 0, 0, "start_floor");
  queueBridgePart(runtime, "floor", 0, 1, -10, "start_under_left");
  queueBridgePart(runtime, "floor", 0, -1, -10, "start_under_right");
  queueBridgePart(runtime, "ladder", 0, -1, -20, "ladder_start_right", { localYaw: -90 });
  queueBridgePart(runtime, "ladder", 0, 1, -20, "ladder_start_left", { localYaw: 90 });
  queueBridgePart(runtime, "ladder", 39, -3, -20, "ladder_finish_right", { localYaw: 180 });
  queueBridgePart(runtime, "ladder", 39, 3, -20, "ladder_finish_left", { localYaw: 180 });

  let milestoneCount = 0;
  let detailCount = 0;
  for (let forward = 1; forward < 40; forward++) {
    if (forward % 5 === 0) {
      milestoneCount++;
      if (milestoneCount !== 4) {
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, 0, 0, `milestone_${forward}_top`));
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, 0, -2, `milestone_${forward}_under`));
      }
      if (forward < 33) {
        queueBridgePart(runtime, "wall", forward + 2.5, 2, 10, `post_${forward}_left`);
        queueBridgePart(runtime, "wall", forward + 2.5, -2, 10, `post_${forward}_right`);
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward + 2.52, 2.5, 0, `wing_${forward}_left`));
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward + 2.52, -2.5, 0, `wing_${forward}_right`));
      }
    } else {
      runtime.layout.path.push(queueBridgePart(runtime, "floor", forward, 0, 0, `center_${forward}`));
    }
    if (forward !== 20) {
      runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, -1, 0, `rail_${forward}_right`));
      runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, 1, 0, `rail_${forward}_left`));
      if (forward !== 19 && forward !== 21) {
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, -0.5, -1, `under_${forward}_right`));
        runtime.layout.path.push(queueBridgePart(runtime, "platform", forward, 0.5, -1, `under_${forward}_left`));
      }
                                                                        
                                                              
      if (forward > 2 && detailCount + 1 < BRIDGE_CONFIG.detailLimit && Math.random() * 100 <= BRIDGE_CONFIG.detailChance) {
        detailCount++;
        const side = [-1, 0, 1][Math.floor(Math.random() * 3)];
        queueBridgePart(runtime, "detail", forward, side, 0, `detail_${forward}_${detailCount}`);
      }
    }
    queueBridgePart(runtime, "floor", forward, -0.5, -10, `deep_${forward}_right`);
    queueBridgePart(runtime, "floor", forward, 0.5, -10, `deep_${forward}_left`);
  }

  for (let forwardOffset = 0; forwardOffset < 4; forwardOffset++) {
    for (let side = -3; side <= 3; side++) {
      if (forwardOffset === 3 && (side <= -3 || side >= 3)) continue;
      const elevation = forwardOffset === 0 && (side === -2 || side === 2) ? 2 : 0;
      runtime.layout.finish.push(queueBridgePart(runtime, "floor", 40 + forwardOffset, side, elevation, `finish_${forwardOffset}_${side}`,
        { tile: 2, internal: true, external: false }));
    }
  }
  runtime.layout.detailCount = detailCount;
}

function scheduleBridgeTimeline(runtime) {
  const runAt = runtime.runStartedAt;
  runtime.tpTask = endingTaskAt(
    runtime,
    runAt + BRIDGE_CONFIG.tpDelay,
    () => releaseBridgeTeleport(runtime),
    "tp",
  );
  runtime.holdTask = endingTaskAt(
    runtime,
    runAt + BRIDGE_CONFIG.holdTime,
    () => startBridgeCollapse(runtime, runAt + BRIDGE_CONFIG.holdTime),
    "collapse",
  );
}

function releaseBridgeTeleport(runtime) {
  if (!runtime || runtime.tpMovedAt !== undefined) return;
  moveTeleportDestination(runtime.tpPosition, runtime.direction);
  runtime.tpMovedAt = Instance.GetGameTime();
  releaseEndingSourceLevels(runtime);
}

// Hands ending-spawned entities that nut named block_<final stage> back to the
// final stage, so the source fade retires them together (CONFLICT start buffer).
function returnEntitiesToEndingSource(runtime, entities) {
  const source = runtime.sourceRuntime;
  const alive = state.levels.get(source?.index) === source && source.lifecycle !== "destroyed"
    && !source.sourceCleanupScheduled;
  for (const entity of entities) {
    if (!validEntity(entity)) continue;
    if (!alive) { destroyEndingEntity(runtime, entity); continue; }
    for (const key of ["entities", "terrainEntities", "endingTerrainEntities", "externalEntities", "externalTerrainEntities", "internalEntities"])
      runtime[key]?.delete(entity);
    source.entities.add(entity);
    source.terrainEntities?.add(entity);
    const visual = state.silentHillWorld.visuals.get(entity);
    if (visual) visual.runtime = source;
  }
}

// Original BUNKER/BRIDGE/RISE/CLIMB/CONFLICT fire MoveTP twice at tp_delay;
// the first call fades and kills the final stage. The levels captured when
// the ending started keep their own ownership so the ending never holds them.
function releaseEndingSourceLevels(runtime) {
  if (!runtime || runtime.endingSourceReleased) return;
  runtime.endingSourceReleased = true;
  const sourceLevels = new Set(runtime.endingSourceLevels ?? []);
  for (const event of [...state.genericEvents.active.values()]) {
    // COLLAPSE otherwise prevents beginLevelFade from retiring its old source.
    if (sourceLevels.has(event.collapseSource)) endGenericEvent(event, { reset: true });
  }
  for (const level of sourceLevels) {
    if (state.levels.get(level.index) !== level || level.lifecycle === "destroyed") continue;
    transferPickedItemState(level, runtime);
    if (level.sourceCleanupScheduled) continue;
    beginLevelFade(level);
    level.sourceCleanupScheduled = true;
    const duration = Math.ceil((255 - 3) / level.fadeStep) * level.fadeInterval + 0.05;
    // Level-owned cleanup must finish even if the ending resolves during the fade.
    schedule(duration, () => destroyLevel(level.index, false, true), level.index);
  }
}

function finishBridgeSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  runtime.lifecycle = "defending";
  runtime.lifecycleHistory.push("defending");
  runtime.spawnFinishedAt = Instance.GetGameTime();
  flushEndingTimeline(runtime, {
    tp: () => releaseBridgeTeleport(runtime),
    collapse: () => startBridgeCollapse(runtime, runtime.runStartedAt + BRIDGE_CONFIG.holdTime),
  });
}

function processBridgeSpawning(runtime) {
  processEndingSpawnQueue(runtime, finishBridgeSpawn);
}

function finishBridgeCollapse(runtime) {
  if (!runtime || runtime.collapseFinishedAt !== undefined) return;
  runtime.collapseFinishedAt = Instance.GetGameTime();
  runtime.lifecycle = "collapsing";
  endingTask(runtime, 5, () => announce(`BRIDGE: kill all zombies within ${BRIDGE_CONFIG.delaySlayTime - 5} seconds`));
  runtime.timeoutTask = endingTask(runtime, BRIDGE_CONFIG.delaySlayTime, () => {
    const counts = bunkerTeamCounts();
    if (counts.zombies <= 0 && counts.humans > 0) {
      resolveStageEnding(true);
      return;
    }
    for (const pawn of allLivingPawns()) {
      pawn.TakeDamage?.({
        damage: 999999,
        damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
      });
    }
    resolveStageEnding(false);
  });
}

function processBridgeCollapseTick(runtime) {
  if (!runtime || runtime.lifecycle !== "collapsing" || runtime.collapseFinishedAt !== undefined) return;
  const scanPosition = runtime.crumblePosition;
                                                                              
                                                                   
  for (const entity of [...runtime.externalTerrainEntities]) {
    if (runtime.endingSafeTerrainEntities.has(entity)) continue;
    if (!entity?.IsValid?.()) continue;
    const position = entity.GetAbsOrigin?.();
    if (!position) continue;
    if (Math.abs(position.z - scanPosition.z) > 2000) continue;
    if (distance2D(position, scanPosition) <= BRIDGE_CONFIG.crumbleDistance) {
      beginEndingEntityFall(
        runtime,
        entity,
        BRIDGE_CONFIG.fallingPieceLifetime,
      );
    }
  }
  runtime.crumbleLeft = !runtime.crumbleLeft;
  runtime.crumblePosition = add(
    runtime.crumblePosition,
    add(
      mul(runtime.left, runtime.crumbleLeft ? -BRIDGE_CONFIG.crumbleLeftRightTravel * 2 : BRIDGE_CONFIG.crumbleLeftRightTravel * 2),
      mul(runtime.direction, BRIDGE_CONFIG.crumbleTravel),
    ),
  );
  runtime.crumbleTravelled += BRIDGE_CONFIG.crumbleTravel;
  if (runtime.crumbleTravelled >= BRIDGE_CONFIG.travelCells * CONFIG.gridSize) {
    finishBridgeCollapse(runtime);
    return;
  }
  runtime.collapseTask = endingTask(runtime, BRIDGE_CONFIG.crumbleRate, () => processBridgeCollapseTick(runtime));
}

function startBridgeCollapse(runtime, scheduledAt) {
  if (!runtime || runtime.lifecycle !== "defending") return;
  runtime.lifecycle = "collapsing";
  runtime.lifecycleHistory.push("collapsing");
  runtime.collapseStartedAt = scheduledAt ?? Instance.GetGameTime();
  runtime.crumblePosition = add(runtime.anchor, mul(runtime.left, BRIDGE_CONFIG.crumbleLeftRightTravel));
  runtime.crumbleTravelled = 0;
  runtime.crumbleLeft = false;
  endingAnnounce(runtime, 0, "BRIDGE ENDING: THE BRIDGE IS STARTING TO CRUMBLE");
  endingTask(runtime, 1, () => enableEndingSpawnKiller(runtime));
  endingAnnounce(runtime, 2.03, "BRIDGE ENDING: RESPAWN IS DISABLED");
  endingAnnounce(runtime, 3.06, "BRIDGE ENDING: DEFEND!");
  endingTask(runtime, 1.5, () => {
    for (const part of runtime.layout.parts.filter((entry) => entry.startBlock)) {
      for (const entity of part.entities) destroyEndingEntity(runtime, entity);
    }
  });
  processBridgeCollapseTick(runtime);
}

function startBridgeEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["spawning", "defending", "collapsing"].includes(state.endingRuntime.lifecycle)) {
    return state.endingRuntime;
  }
  const runtime = createEndingRuntime("BRIDGE", stageSnapshot, sourceRuntime);
  runtime.entryPosition = endingPosition(runtime, 0, 0, 0);
  runtime.tpPosition = add(endingPosition(runtime, 1, 0, 0), vec(0, 0, 8));
                                                                         
                                                                            
  scheduleBridgeTimeline(runtime);
  playEndingMusic(runtime, ENDING_MUSIC.BRIDGE);
  endingAnnounce(runtime, 0, "BRIDGE ENDING");
  endingAnnounce(runtime, 1.05, `BRIDGE ENDING: HOLD THE BRIDGE FOR ${BRIDGE_CONFIG.holdTime + 1}s`);
  endingCountdown(runtime, BRIDGE_CONFIG.holdTime, "BRIDGE ENDING: BRIDGE CRUMBLING IN");
  try {
    for (const shape of ["floor", "platform", "wall", "detail"]) {
      const template = state.templates.get(shape);
      if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") {
        throw new Error(`BRIDGE requires terrain template '${shape}'`);
      }
    }
    const ladder = state.featureTemplates.get("ladder");
    if (!ladder || !ladder.IsValid?.() || typeof ladder.ForceSpawn !== "function") {
      throw new Error("BRIDGE requires feature template 'ladder'");
    }
    spawnBridgeGeometry(runtime);
    if (runtime.remaining <= 0) throw new Error("BRIDGE produced no terrain spawn requests");
    announce("BRIDGE ending terrain is generating");
    return runtime;
  } catch (error) {
    destroyEndingRuntime(runtime, "startup_failed");
    throw error;
  }
}

function processBridgeEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "BRIDGE") return;
  if (runtime.lifecycle === "spawning") {
    processBridgeSpawning(runtime);
    return;
  }
  if (!["defending", "collapsing"].includes(runtime.lifecycle)) return;
  const { humans, zombies } = bunkerTeamCounts();
  runtime.lastTeamCounts = { humans, zombies };
  if (humans <= 0) resolveStageEnding(false);
  else if (zombies <= 0) resolveStageEnding(true);
}

function createHuntRiftPair(runtime) {
  const previous = state.levels.get((runtime.sourceRuntime?.index ?? 0) - 1);
  const fallback = runtime.sourceRuntime?.tp ?? runtime.sourceRuntime?.entry ?? runtime.anchor;
  const item = {
    id: state.nextItemEffectId++,
    name: "rift",
    definition: { ...ITEM_DEFINITIONS.rift, team: 3 },
    position: clone(runtime.sourceRuntime.end),
    effects: new Set(),
    auxiliaryVisuals: new Set(),
    usesRemaining: 1,
  };
  const pair = {
    item,
    entry: undefined,
    exit: undefined,
    entryVisual: undefined,
    exitVisual: undefined,
    previousTeleport: previous?.tp ?? previous?.entry ?? fallback,
    touchCooldowns: new Map(),
  };
  runtime.riftPair = pair;
  return pair;
}

function spawnHuntEntryRift(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const pair = runtime.riftPair ?? createHuntRiftPair(runtime);
  if (pair.entryVisual && validEntity(pair.entryVisual)) return pair;
                                                                         
                                                                             
                                                                
  pair.entry = add(runtime.sourceRuntime.end, vec(0, 0, 64));
  pair.item.position = clone(pair.entry);
  const entryVisual = spawnItemEffectVisual(runtime, pair.item, {
    template: "rift",
    model: ITEM_DEFINITIONS.rift.model,
    position: pair.entry,
    scale: 1.5,
    glow: { r: 255, g: 255, b: 255, a: 255 },
  });
  pair.entryVisual = entryVisual;
  playSourceAudioCue(10805, pair.entry);
  spawnItemParticle(runtime, pair.item, "water_impact_bubbles_1", pair.entry, undefined, 0.05);
  return pair;
}

function spawnHuntExitRift(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const pair = runtime.riftPair ?? createHuntRiftPair(runtime);
  if (!pair.entryVisual || !validEntity(pair.entryVisual)) spawnHuntEntryRift(runtime);
  if (pair.exitVisual && validEntity(pair.exitVisual)) return pair;
                                                                     
                                                               
  pair.exit = add(pair.previousTeleport, vec(0, 0, 56));
  const exitVisual = spawnItemEffectVisual(runtime, pair.item, {
    template: "rift",
    model: ITEM_DEFINITIONS.rift.model,
    position: pair.exit,
    scale: 0.75,
    glow: { r: 255, g: 255, b: 255, a: 255 },
  });
  pair.exitVisual = exitVisual;
  playSourceAudioCue(10805, pair.exit);
  spawnItemParticle(runtime, pair.item, "water_impact_bubbles_1", pair.exit, undefined, 0.05);
  return pair;
}

function spawnHuntRifts(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  spawnHuntEntryRift(runtime);
  spawnHuntExitRift(runtime);
}

function processHuntRifts(runtime, now, humans) {
  const pair = runtime.riftPair;
  if (!pair || !pair.entry || !pair.exit || !validEntity(pair.entryVisual) || !validEntity(pair.exitVisual)) return;
  const touches = (pawn, base) => projectileTouchesPlayerHull(pawn, base, base, 1);
  for (const pawn of humans) {
    if ((pair.touchCooldowns.get(pawn) ?? 0) > now) continue;
    const atEntry = touches(pawn, pair.entry);
    const atExit = touches(pawn, pair.exit);
    if (!atEntry && !atExit) continue;
    const destination = atEntry ? pair.exit : pair.entry;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pair.touchCooldowns.set(pawn, now + 1);
    runtime.infectionImmunityUntil.set(pawn, now + HUNT_CONFIG.teleportInfectionImmunity);
    pawn.Teleport?.({
      position: add(destination, vec(0, 0, 12)),
      velocity: vec(velocity.x, velocity.y, velocity.z < -300 ? 0 : velocity.z),
    });
    playRiftTeleportAudio(pawn, atEntry ? pair.entry : pair.exit, destination);
    spawnRiftTeleportParticles(runtime, pair, pawn, atEntry ? pair.entry : pair.exit, atEntry ? pair.entry : pair.exit);
  }
}

function capHuntZombieHealth(runtime, humans, zombies, now) {
  if (now < runtime.nextHealthCapAt) return;
  runtime.nextHealthCapAt = now + HUNT_CONFIG.healthTickRate;
  const cap = Math.max(1, HUNT_CONFIG.zombieHealthBase + HUNT_CONFIG.zombieHealthPerHuman * humans.length);
  runtime.zombieHealthCap = cap;
  for (const pawn of zombies) {
    const health = pawn.GetHealth?.();
    if (!Number.isFinite(health) || health <= cap) continue;
    if (typeof pawn.SetHealth === "function") pawn.SetHealth(cap);
    else pawn.TakeDamage?.({ damage: health - cap, damageFlags: CSDamageFlags.IGNORE_ARMOR ?? 0 });
  }
}

function startHuntEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  const riftTemplate = state.featureTemplates.get("item_rift");
  if (!riftTemplate || !riftTemplate.IsValid?.() || typeof riftTemplate.ForceSpawn !== "function") {
    throw new Error("HUNT requires feature template 'item_rift'");
  }
  const runtime = createEndingRuntime("HUNT", stageSnapshot, sourceRuntime);
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.nextHealthCapAt = 0;
  runtime.infectionImmunityUntil = new Map();
  state.zombieSpawnInvincibilityEnabled = false;
  runtime.zombieSpawnInvincibilityDisabledAt = Instance.GetGameTime();
  transferEndingSourceOwnership(runtime);
  runtime.riftEntryTask = endingTaskAt(runtime, runtime.runStartedAt + 2.0, () => spawnHuntEntryRift(runtime), "rift_entry");
  runtime.riftExitTask = endingTaskAt(runtime, runtime.runStartedAt + 2.3, () => spawnHuntExitRift(runtime), "rift_exit");
                                                                      
                                                                        
  runtime.riftTask = runtime.riftExitTask;
  runtime.spawnKillerTask = endingTask(runtime, HUNT_CONFIG.spawnKillerDelay, () => {
    runtime.respawnDisabledAt = Instance.GetGameTime();
    enableEndingSpawnKiller(runtime);
  });
  runtime.timeoutTask = endingTask(runtime, HUNT_CONFIG.slayTime, () => {
    if (runtime.timeoutTriggered || runtime.lifecycle !== "active") return;
    runtime.timeoutTriggered = true;
                                                                          
                                                                         
                                                     
    for (const pawn of allLivingPawns()) {
      if (pawn.GetTeamNumber?.() !== 3) continue;
      pawn.TakeDamage?.({
        damage: 999999,
        damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
      });
    }
    runtime.timeoutMassKillTask = endingTask(runtime, 0.5, () => {
      if (runtime.timeoutMassKillDone || runtime.lifecycle !== "active") return;
      runtime.timeoutMassKillDone = true;
      for (const pawn of allLivingPawns()) {
        pawn.TakeDamage?.({
          damage: 999999,
          damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
        });
      }
      resolveStageEnding(false);
    });
  });
  playEndingMusic(runtime, ENDING_MUSIC.HUNT);
  endingAnnounce(runtime, 0, "HUNT ENDING");
  endingAnnounce(runtime, 1.03, "HUNT ENDING: zombies have low HP - kill them all!");
  endingAnnounce(runtime, 2.1, `HUNT ENDING: the stage-end rift grants ${HUNT_CONFIG.teleportInfectionImmunity}s infection immunity`);
  endingAnnounce(runtime, 5, `HUNT ENDING: YOU HAVE ${HUNT_CONFIG.slayTime - 5}s TO KILL THE ZOMBIES`);
  endingAnnounce(runtime, 6, "HUNT ENDING: IF THE TIME RUNS OUT YOU LOSE");
  endingAnnounce(runtime, HUNT_CONFIG.spawnKillerDelay + 0.2, "HUNT ENDING: RESPAWN IS DISABLED");
  endingCountdown(runtime, HUNT_CONFIG.slayTime, "HUNT ENDING: YOU HAVE", [60, 30, 10, 5, 4, 3, 2, 1]);
  return runtime;
}

function processHuntEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "HUNT" || runtime.lifecycle !== "active") return;
  const pawns = allLivingPawns();
  const humans = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 3);
  const zombies = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 2);
  const now = Instance.GetGameTime();
  capHuntZombieHealth(runtime, humans, zombies, now);
  processHuntRifts(runtime, now, humans);
  for (const [pawn, until] of [...runtime.infectionImmunityUntil]) {
    if (!validEntity(pawn) || until <= now) runtime.infectionImmunityUntil.delete(pawn);
  }
  runtime.lastTeamCounts = { humans: humans.length, zombies: zombies.length };
  if (runtime.timeoutTriggered) return;
  if (humans.length <= 0) resolveStageEnding(false);
  else if (zombies.length <= 0) resolveStageEnding(true);
}

function risePosition(runtime, forwardCell, sideCell, elevation = 0) {
  return add(
    runtime.courseAnchor,
    add(
      mul(runtime.direction, (forwardCell + 0.5) * CONFIG.gridSize),
      add(mul(runtime.left, sideCell * CONFIG.gridSize), vec(0, 0, elevation * CONFIG.elevationStep)),
    ),
  );
}

                                                                               
                                                                              
                                                                               
                                                         
function chooseRiseDirection(runtime, current = endingCardinalDirection(runtime), pivot = add(runtime.anchor, mul(current, 6 * CONFIG.gridSize))) {
  const candidates = current.x > 0
    ? [vec(1, 0, 0), vec(0, 1, 0), vec(0, -1, 0)]
    : current.x < 0
      ? [vec(-1, 0, 0), vec(0, 1, 0), vec(0, -1, 0)]
      : current.y > 0
        ? [vec(1, 0, 0), vec(-1, 0, 0), vec(0, 1, 0)]
        : [vec(1, 0, 0), vec(-1, 0, 0), vec(0, -1, 0)];
  const allowed = (direction) => {
    const probe = add(pivot, mul(direction, 12000));
    return direction.x > 0 ? probe.x < RISE_CONFIG.worldBoundary
      : direction.x < 0 ? probe.x > -RISE_CONFIG.worldBoundary
        : direction.y > 0 ? probe.y < RISE_CONFIG.worldBoundary
          : probe.y > -RISE_CONFIG.worldBoundary;
  };
  const shuffled = shuffleCopy(candidates);
  const selected = shuffled.find(allowed) ?? current;
  runtime.boundaryDirectionCandidates = shuffled.map(clone);
  runtime.boundaryDirectionFallback = selected.x !== current.x || selected.y !== current.y;
  runtime.direction = clone(selected);
  runtime.left = leftOf(runtime.direction);
  return runtime.direction;
}

function queueRiseTerrain(runtime, shape, forward, side, elevation, role, safe = false, angles = anglesFor(runtime.direction)) {
  const record = [];
  const tile = shape === "platform" ? 25 : 5;
  queueEndingTile(runtime, tile, shape, risePosition(runtime, forward, side, elevation), role, safe, !safe, record, angles);
  const piece = { role, position: risePosition(runtime, forward, side, elevation), entities: record, safe, climb: false };
  runtime.layout.pieces.push(piece);
  if (safe) runtime.layout.safePieces.push(piece);
  else runtime.layout.collapsiblePieces.push(piece);
  return piece;
}

function buildRiseGeometry(runtime) {
  const oldDirection = endingCardinalDirection(runtime);
  const oldLeft = leftOf(oldDirection);
  runtime.direction = clone(oldDirection);
  runtime.left = oldLeft;
  runtime.courseAnchor = clone(runtime.anchor);
  runtime.layout = {
    pieces: [],
    collapsiblePieces: [],
    safePieces: [],
    climbPieces: [],
    hillRows: [],
    topRows: [],
    end: [],
  };
                                                                           
                                                              
  for (let forward = 0; forward <= 6; forward++) {
    for (const side of [-0.5, 0.5]) queueRiseTerrain(runtime, "floor", forward, side, 0, `approach_${forward}_${side}`);
  }
  const pivot = add(runtime.anchor, mul(oldDirection, 6 * CONFIG.gridSize));
  chooseRiseDirection(runtime, oldDirection, pivot);
                                                                          
                                                                          
  runtime.courseAnchor = add(pivot, mul(runtime.direction, CONFIG.gridSize));
  for (let forward = 0; forward <= 1; forward++) {
    for (const side of [-0.5, 0.5]) queueRiseTerrain(runtime, "floor", forward, side, 0, `start_${forward}_${side}`);
  }
  let elevation = 0;
  runtime.moverPiece = queueRiseTerrain(runtime, "platform", 1, 0, RISE_CONFIG.moverHeight, "tp_mover", true);

  const slopeYaw = normalizeYaw(yawOf(runtime.direction) + 180);
  const slopeShape = "floor_slope";
  for (let forward = 2; forward < RISE_CONFIG.hillLength; forward++) {
    const row = { forward, elevation, pieces: [] };
    for (let side = -RISE_CONFIG.hillWidth; side < RISE_CONFIG.hillWidth; side++) {
      row.pieces.push(queueRiseTerrain(
        runtime,
        slopeShape,
        forward,
        side + 0.5,
        elevation,
        `hill_${forward}_${side}`,
        false,
        { pitch: 0, yaw: slopeYaw, roll: 0 },
      ));
    }
    runtime.layout.hillRows.push(row);
    const climb = RISE_CONFIG.climbSections.find((section) => section.row === forward);
    if (climb) {
      elevation += RISE_CONFIG.climbHeight;
      for (let index = 0; index < RISE_CONFIG.climbAmount; index++) {
        const side = -2.5 + Math.random() * 5;
        const isLadder = climb.kind === "ladder";
        const position = risePosition(
          runtime,
                                                                     
                                                               
          forward + (isLadder ? -0.02 + Math.random() * 0.02 : -0.01 + Math.random() * 0.06),
          side,
          elevation - 20 + (-0.05 + Math.random() * (isLadder ? 0.05 : 0.07)),
        );
        const record = [];
        if (climb.kind === "ladder") {
          queueEndingLadder(runtime, position, { pitch: 0, yaw: slopeYaw, roll: 0 }, `climb_${forward}_${index}`, false, true, record);
        } else {
          queueEndingClimb(runtime, climb.kind, position, { pitch: 0, yaw: slopeYaw, roll: 0 }, `climb_${forward}_${index}`, false, true, record);
        }
        const piece = { role: `climb_${forward}_${index}`, position, entities: record, safe: false, climb: true };
        runtime.layout.climbPieces.push(piece);
      }
    } else {
      elevation += 1;
    }
  }

  runtime.hillTopElevation = elevation;
  for (let forward = RISE_CONFIG.hillLength; forward < RISE_CONFIG.hillLength + RISE_CONFIG.topLength; forward++) {
    const row = { forward, elevation, pieces: [] };
    for (let side = -RISE_CONFIG.hillWidth; side < RISE_CONFIG.hillWidth; side++) {
      row.pieces.push(queueRiseTerrain(runtime, "floor", forward, side + 0.5, elevation, `top_${forward}_${side}`));
    }
    runtime.layout.topRows.push(row);
  }
  elevation += 1;
  runtime.safeElevation = elevation;
  for (let forward = RISE_CONFIG.hillLength + RISE_CONFIG.topLength; forward < RISE_CONFIG.hillLength + RISE_CONFIG.topLength + 3; forward++) {
    for (let side = -1; side <= 1; side++) {
      const piece = queueRiseTerrain(runtime, "platform", forward, side, elevation, `safe_${forward}_${side}`, true);
      runtime.layout.end.push(piece);
    }
  }
  runtime.safeCenter = risePosition(runtime, RISE_CONFIG.hillLength + RISE_CONFIG.topLength + 1, 0, elevation);
  runtime.tpPosition = add(risePosition(runtime, 1, 0, RISE_CONFIG.moverHeight), vec(0, 0, RISE_CONFIG.moverTeleportOffset));
  runtime.moverStart = risePosition(runtime, 1, 0, RISE_CONFIG.moverHeight);
  runtime.moverTarget = add(
    risePosition(runtime, RISE_CONFIG.hillLength, 0, elevation + RISE_CONFIG.moverHeight),
    add(mul(runtime.direction, RISE_CONFIG.moverTargetForwardOffset), vec(0, 0, RISE_CONFIG.moverTargetHeightOffset)),
  );
  runtime.hazardStartZ = runtime.courseAnchor.z + RISE_CONFIG.hazardSpawnOffset;
  runtime.hazardTargetZ = runtime.courseAnchor.z + elevation * CONFIG.elevationStep - RISE_CONFIG.hazardTargetLip;
  runtime.hazardZ = runtime.hazardStartZ;
}

function startRiseCollapse(runtime, scheduledAt) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.collapseStartedAt !== undefined) return;
  const now = Instance.GetGameTime();
  runtime.collapseStartedAt = scheduledAt ?? now;
  runtime.collapsePieces = runtime.layout.collapsiblePieces.map((piece) => {
    const distance = Math.hypot(piece.position.x - runtime.anchor.x, piece.position.y - runtime.anchor.y, piece.position.z - runtime.anchor.z);
    const randomized = distance * RISE_CONFIG.collapseDistanceFactor
      + RISE_CONFIG.collapseRandomDelayMin
      + Math.random() * (RISE_CONFIG.collapseRandomDelayMax - RISE_CONFIG.collapseRandomDelayMin);
    const fallAt = runtime.collapseStartedAt + Math.max(0, Math.min(200, randomized));
    const vanishDelay = RISE_CONFIG.collapsePieceDelayMin
      + Math.random() * (RISE_CONFIG.collapsePieceDelayMax - RISE_CONFIG.collapsePieceDelayMin);
    return {
      ...piece,
      fallAt,
      motionAt: fallAt + vanishDelay,
      vanishAt: fallAt + vanishDelay + RISE_CONFIG.collapsePieceKillTime,
      lowered: false,
      falling: false,
    };
  });
  runtime.climbKillAt = runtime.collapseStartedAt + RISE_CONFIG.collapseClimbKillDelay;
}

function updateRiseMover(runtime, now) {
  if (now < runtime.moverStartsAt || runtime.moverFinished) return;
  const elapsed = Math.max(0, now - runtime.moverStartsAt);
  const delta = sub(runtime.moverTarget, runtime.moverStart);
  const distance = Math.hypot(delta.x, delta.y, delta.z);
  const ratio = distance <= 0 ? 1 : Math.min(1, elapsed * RISE_CONFIG.moverSpeed / distance);
  const position = add(runtime.moverStart, mul(delta, ratio));
  for (const entity of runtime.moverPiece.entities) entity.Teleport?.({ position, velocity: vec() });
  runtime.tpPosition = add(position, vec(0, 0, RISE_CONFIG.moverTeleportOffset));
  moveTeleportDestination(runtime.tpPosition, runtime.direction);
  runtime.moverFinished = ratio >= 1;
}

function updateRiseHazard(runtime, now) {
                                                                             
                                                                              
                                                                             
                                                                               
  const hazardVisuals = runtime.hazardVisuals ?? [];
  const fadeStart = runtime.hazardVisualSpawnedAt ?? runtime.runStartedAt ?? now;
  const fadeAlpha = Math.max(0, Math.min(255, Math.floor((now - fadeStart) * 100)));
  runtime.hazardVisualAlpha = fadeAlpha;
  for (const layer of hazardVisuals) {
    if (!validEntity(layer?.entity)) continue;
    const position = vec(runtime.courseAnchor.x, runtime.courseAnchor.y, runtime.hazardZ + (layer.zOffset ?? 0));
    layer.entity.Teleport?.({ position, velocity: vec() });
    if (layer.alpha !== fadeAlpha) {
      layer.alpha = fadeAlpha;
      try {
        layer.entity.SetColor?.({ r: 255, g: 255, b: 255, a: fadeAlpha });
        fireTarget(layer.entity, "SetRenderAlpha", String(fadeAlpha));
      } catch (error) {
        runtime.hazardVisualNote = `render alpha unavailable: ${error}`;
      }
    }
  }
  if (now < runtime.hazardStartsAt) return;
  runtime.hazardZ = Math.min(
    runtime.hazardTargetZ,
    runtime.hazardStartZ + (now - runtime.hazardStartsAt) * RISE_CONFIG.hazardSpeed,
  );
                                                                             
                                                                        
  for (const layer of hazardVisuals) {
    if (!validEntity(layer?.entity)) continue;
    layer.entity.Teleport?.({
      position: vec(runtime.courseAnchor.x, runtime.courseAnchor.y, runtime.hazardZ + (layer.zOffset ?? 0)),
      velocity: vec(),
    });
  }
  runtime.hazardTeleportedPawns ??= new Set();
  for (const pawn of allLivingPawns()) {
    const origin = pawn.GetAbsOrigin?.();
    if (!origin || origin.z > runtime.hazardZ) continue;
    if (pawn.GetTeamNumber?.() === 2) {
      if (runtime.hazardTeleportedPawns.has(pawn)) continue;
      runtime.hazardTeleportedPawns.add(pawn);
      pawn.Teleport?.({ position: vec(origin.x, origin.y, RISE_CONFIG.hazardTeleportZ), velocity: vec() });
    } else if (pawn.GetTeamNumber?.() === 3) {
      pawn.TakeDamage?.({ damage: 999999, damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0) });
    }
  }
}

function updateRiseCollapse(runtime, now) {
  for (const piece of runtime.collapsePieces ?? []) {
    if (!piece.lowered && now >= piece.fallAt) {
      piece.lowered = true;
      for (const entity of piece.entities) {
        const position = entity.GetAbsOrigin?.() ?? piece.position;
        entity.Teleport?.({ position: add(position, vec(0, 0, RISE_CONFIG.collapsePieceLower)), velocity: vec() });
        entity.collectiveBaseColor = { r: 255, g: 150, b: 150, a: 255 };
        entity.SetColor?.(entity.collectiveBaseColor);
      }
    }
    if (!piece.falling && now >= (piece.motionAt ?? Infinity)) {
      piece.falling = true;
      for (const entity of piece.entities ?? []) {
        if (!validEntity(entity)) continue;
        beginEndingEntityFall(runtime, entity, RISE_CONFIG.collapsePieceKillTime);
      }
    }
    if (!piece.removed && now >= piece.vanishAt) {
      piece.removed = true;
      for (const entity of piece.entities) if (entity?.IsValid?.()) entity.Kill();
    }
  }
  if (!runtime.climbsRemoved && now >= (runtime.climbKillAt ?? Infinity)) {
    runtime.climbsRemoved = true;
    for (const piece of runtime.layout.climbPieces) for (const entity of piece.entities) if (entity?.IsValid?.()) entity.Kill();
  }
}

function resolveRiseCheckpoint(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  const survivors = humans.filter((pawn) => {
    const origin = pawn.GetAbsOrigin?.();
    return origin
      && distance2D(origin, runtime.safeCenter) <= CONFIG.gridSize * 2.2
      && origin.z >= runtime.safeCenter.z - 120;
  });
  runtime.safeHumans = new Set(survivors);
  runtime.checkpointEvaluatedAt = Instance.GetGameTime();
  runtime.safeCondition = humans.length > 0 && survivors.length === humans.length;
                                                                              
                                                                                
}

function spawnRiseHazard(runtime) {
  const profile = themeProfile(stageSnapshotForRuntime(runtime).theme);
  runtime.hazardModel = RISE_CONFIG.hazardModel;
  runtime.hazardThemeName = profile.name;
  runtime.hazardSkin = profile.hazardLiquidSkin;
  runtime.hazardResourceAvailable = false;
  runtime.hazardVisualNote = "dual liquid layers use render mode/alpha entity I/O; verify visual fade in game";
  runtime.hazardVisuals = [];
  runtime.hazardVisualSpawnedAt = Instance.GetGameTime();
  runtime.hazardVisualAlpha = 0;
  const spawnLayer = (zOffset, renderMode, feature) => {
    const request = {
      position: vec(runtime.courseAnchor.x, runtime.courseAnchor.y, runtime.hazardStartZ + zOffset),
      angles: anglesFor(runtime.direction),
      feature,
    };
    let visual;
    try {
      const template = state.featureTemplates.get("model");
      if (template?.IsValid?.() && typeof template.ForceSpawn === "function") {
        visual = spawnVisual(runtime, request, RISE_CONFIG.hazardModel, false);
      } else {
        runtime.hazardVisualNote = "template_model unavailable; dual layers use floor fallback; verify collision in game";
        visual = spawnModelBlock(runtime, request, RISE_CONFIG.hazardModel);
        runtime.hazardVisualFallback = true;
      }
    } catch (error) {
      runtime.hazardVisualNote = `visual layer unavailable (${feature}): ${error}`;
      try {
                                                                         
                                                                             
                                                                        
        visual = spawnModelBlock(runtime, request, RISE_CONFIG.hazardModel);
        runtime.hazardVisualFallback = true;
      } catch (fallbackError) {
        runtime.hazardVisualNote = `visual layer unavailable (${feature}): ${fallbackError}`;
      }
    }
    if (!visual) return undefined;
    visual.SetModelScale?.(RISE_CONFIG.hazardModelScale);
                                                                           
                                                                            
                                                                     
    applyThemeSkin(visual, runtime.hazardSkin);
    try {
      visual.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
      fireTarget(visual, "SetRenderMode", String(renderMode));
      fireTarget(visual, "SetRenderAlpha", "0");
    } catch (error) {
      runtime.hazardVisualNote = `render mode unavailable (${feature}): ${error}`;
    }
    runtime.entities.add(visual);
    runtime.externalEntities.add(visual);
    const layer = { entity: visual, zOffset, renderMode, alpha: 0, feature };
    runtime.hazardVisuals.push(layer);
    return layer;
  };
  const primary = spawnLayer(0, 1, "riseHazard");
  const overlay = spawnLayer(-2, 3, "riseHazardOverlay");
  runtime.hazardVisual = primary?.entity;
  runtime.hazardVisualOverlay = overlay?.entity;
  runtime.hazardResourceAvailable = runtime.hazardVisuals.length === 2;
  if (!runtime.hazardResourceAvailable) {
    runtime.hazardVisualNote = "one or more liquid visual layers unavailable; scripted CT/T contact remains active";
    message("RISE hazard visual layer unavailable; scripted contact remains active");
  }
}

function scheduleRiseTimeline(runtime) {
  if (!runtime || runtime.riseTimelineScheduled) return;
  runtime.riseTimelineScheduled = true;
  const at = (delay) => runtime.runStartedAt + delay;
  const handlers = {
    rise_tp: () => {
      moveTeleportDestination(runtime.tpPosition, runtime.direction);
      runtime.tpMovedAt = at(RISE_CONFIG.tpDelay);
      releaseEndingSourceLevels(runtime);
    },
    rise_collapse: () => startRiseCollapse(runtime, at(RISE_CONFIG.collapseDelay)),
    rise_mover_remove: () => {
      runtime.moverRemovedAt = at(RISE_CONFIG.resolveTime);
      for (const entity of runtime.moverPiece?.entities ?? []) destroyEndingEntity(runtime, entity);
      runtime.moverPieceRemoved = true;
      enableEndingSpawnKiller(runtime, at(RISE_CONFIG.resolveTime));
    },
    rise_cleanup: () => {
      runtime.nonSafeTerrainRemovedAt = at(RISE_CONFIG.safeCleanupTime);
      for (const entity of [...(runtime.endingTerrainEntities ?? [])]) {
        if (runtime.endingSafeTerrainEntities?.has(entity)) continue;
        destroyEndingEntity(runtime, entity);
      }
    },
    rise_fail: () => {
      runtime.failTriggeredAt = at(RISE_CONFIG.failTime);
      for (const pawn of allLivingPawns()) {
        pawn.TakeDamage?.({ damage: 999999, damageFlags: CSDamageFlags.FORCE_DEATH ?? 0 });
      }
      resolveStageEnding(false);
    },
    rise_announce_0: () => announce("[RISE ENDING]"),
    rise_announce_1: () => announce("[RISE ENDING] DEFEND YOUR WAY TO THE TOP"),
    rise_announce_2: () => announce("[RISE ENDING] THE VERY END IS YOUR SAFE HAVEN"),
    rise_announce_3: () => announce("[RISE ENDING] THE HILL WILL GRADUALLY COLLAPSE"),
    rise_announce_4: () => announce("[RISE ENDING] HOLD BACK THE ZOMBIES TO SURVIVE"),
    rise_announce_5: () => announce("[RISE ENDING] GOOD LUCK"),
  };
  runtime.riseTimelineHandlers = handlers;
  const delays = {
    rise_tp: RISE_CONFIG.tpDelay,
    rise_collapse: RISE_CONFIG.collapseDelay,
    rise_mover_remove: RISE_CONFIG.resolveTime,
    rise_cleanup: RISE_CONFIG.safeCleanupTime,
    rise_fail: RISE_CONFIG.failTime,
    rise_announce_0: 0,
    rise_announce_1: 1.03,
    rise_announce_2: 2.04,
    rise_announce_3: 3.05,
    rise_announce_4: 4.06,
    rise_announce_5: 5.07,
  };
  for (const [key, callback] of Object.entries(handlers)) endingTaskAt(runtime, at(delays[key]), callback, key);
}

function finishRiseSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.startedAt = runtime.runStartedAt;
  runtime.moverStartsAt = runtime.runStartedAt + RISE_CONFIG.moverDelay;
  runtime.hazardStartsAt = runtime.runStartedAt + RISE_CONFIG.hazardDelay;
  runtime.hazardTeleportedPawns ??= new Set();
  spawnRiseHazard(runtime);
  flushEndingTimeline(runtime, runtime.riseTimelineHandlers);
}

function startRiseEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  for (const key of ["ladder", "climb0", "climb90", "climb180", "climb270", "climbhard0", "climbhard90", "climbhard180", "climbhard270"]) {
    const template = state.featureTemplates.get(key);
    if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") throw new Error(`RISE requires feature template '${key}'`);
  }
  const runtime = createEndingRuntime("RISE", stageSnapshot, sourceRuntime);
                                                                       
                                                                           
                                                                     
  playEndingMusic(runtime, ENDING_MUSIC.RISE);
  buildRiseGeometry(runtime);
  scheduleRiseTimeline(runtime);
  return runtime;
}

function processRiseEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "RISE") return;
  if (runtime.lifecycle === "spawning") {
    processEndingSpawnQueue(runtime, finishRiseSpawn);
    return;
  }
  if (runtime.lifecycle !== "active") return;
  const now = Instance.GetGameTime();
  updateRiseMover(runtime, now);
  updateRiseHazard(runtime, now);
  updateRiseCollapse(runtime, now);
  if (allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3).length <= 0) resolveStageEnding(false);
}

function climbPosition(runtime, forwardCell, sideCell, elevation = 0) {
  return endingPosition(runtime, forwardCell, sideCell, elevation);
}

function queueClimbPiece(runtime, forward, side, elevation, role, safe = false, shape = "floor", crumble = !safe, angles) {
  const record = [];
  const position = climbPosition(runtime, forward, side, elevation);
  const tile = ({ floor: 5, platform: 25 })[shape];
  if (!Number.isInteger(tile)) throw new Error(`CLIMB source tile is unavailable for '${shape}'`);
  queueEndingTile(runtime, tile, shape, position, role, safe, !safe, record, angles ?? anglesFor(runtime.direction));
  const piece = { role, position, entities: record, safe, crumble };
  runtime.layout.pieces.push(piece);
  if (safe) runtime.layout.safePieces.push(piece);
  else if (crumble) runtime.layout.crumblePieces.push(piece);
  return piece;
}

function queueClimbBreakable(runtime, forward, side, elevation, role, safe = false, angles) {
  const record = [];
  const position = climbPosition(runtime, forward, side, elevation);
  queueEndingBreakable(runtime, position, angles ?? anglesFor(runtime.direction), role, safe, !safe, record, safe, false);
  const piece = { role, position, entities: record, safe, crumble: !safe, destructible: false };
  runtime.layout.pieces.push(piece);
  if (safe) runtime.layout.safePieces.push(piece);
  else runtime.layout.crumblePieces.push(piece);
  return piece;
}

function setClimbBoostVisualState(runtime, enabled) {
  const visual = runtime?.boostVisual;
  runtime.boostVisualState = enabled ? "enabled" : "disabled";
  runtime.boostVisualAlpha = enabled ? 255 : 50;
  if (!validEntity(visual)) return;
  visual.SetColor?.(enabled
    ? { r: 255, g: 255, b: 255, a: 255 }
    : { r: 255, g: 0, b: 0, a: 50 });
  fireTarget(visual, "SetRenderAlpha", String(runtime.boostVisualAlpha));
}

function spawnClimbBoostVisual(runtime) {
  runtime.boostVisualSupported = false;
  runtime.boostVisualNote = "optional visual; floor collision remains a separate authored block";
  const template = state.featureTemplates.get("model");
  if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") {
    runtime.boostVisualNote = "template_model unavailable; boost remains scripted without a visual";
    return;
  }
  try {
    const visual = spawnVisual(
      runtime,
      { position: runtime.boostPosition ?? runtime.boostPiece?.position, angles: anglesFor(runtime.direction), feature: "climbBoostVisual" },
      chooseTerrainModel(stageSnapshotForRuntime(runtime).theme, "boost") ?? CLIMB_BOOST_MODEL,
      false,
    );
    if (!visual) return;
    runtime.boostVisual = visual;
    runtime.boostVisualSupported = true;
    runtime.externalEntities.add(visual);
    setClimbBoostVisualState(runtime, false);
  } catch (error) {
    runtime.boostVisualNote = `visual unavailable: ${error}`;
  }
}

function queueClimbRing(runtime, minForward, maxForward, radius, elevation, role) {
  for (let forward = minForward; forward <= maxForward; forward++) {
    queueClimbPiece(runtime, forward, -radius, elevation, `${role}_${forward}_low`);
    queueClimbPiece(runtime, forward, radius, elevation, `${role}_${forward}_high`);
  }
  for (let side = -radius + 1; side <= radius - 1; side++) {
    queueClimbPiece(runtime, minForward, side, elevation, `${role}_left_${side}`);
    queueClimbPiece(runtime, maxForward, side, elevation, `${role}_right_${side}`);
  }
}

function buildClimbGeometry(runtime) {
  runtime.layout = { pieces: [], crumblePieces: [], safePieces: [], ladders: [], route: [] };
  runtime.crumbleQueue = [];
  for (let side = -2; side <= 2; side++) queueClimbPiece(runtime, 0, side, 0, `start_${side}`);
  runtime.boostPiece = queueClimbPiece(runtime, 1, 0, 0, "start_boost", false, "floor", false);

  const rings = [
    { min: 15, max: 22, radius: 3.5, elevation: 15 },
    { min: 16, max: 21, radius: 2.5, elevation: 45 },
    { min: 17, max: 20, radius: 1.5, elevation: 75 },
    { min: 18, max: 19, radius: 0.5, elevation: 105 },
  ];
  for (const [index, ring] of rings.entries()) queueClimbRing(runtime, ring.min, ring.max, ring.radius, ring.elevation, `tower_${index}`);
  let bottomElevation = 15;
  for (let layer = 0; layer < CLIMB_CONFIG.extraBottomLayers; layer++) {
    bottomElevation -= 31;
    queueClimbRing(runtime, 15, 22, 3.5, bottomElevation, `tower_bottom_${layer}`);
  }

  const route = [
    [21.7, 0.8, 32], [21.7, -0.8, 32], [21.7, 3, 34], [21.7, -3, 34],
    [19.8, 3.3, 36], [19.8, -3.3, 36], [17.6, 3.3, 38], [17.6, -3.3, 38],
    [15.5, 3.3, 40], [15.5, -3.3, 40], [15.3, 1.8, 42], [15.3, -1.8, 42], [15.3, 0, 44],
    [20.5, 0.8, 62], [20.5, -0.8, 62], [20.5, 2, 64], [20.5, -2, 64],
    [18.5, 2, 66], [18.5, -2, 66], [16.5, 2, 68], [16.5, -2, 68], [16.1, 0, 70],
    [15.1, 0, 70], [15, 0, 72, 45], [14.75, 0.005, 69.05, undefined, true],
    [16, 2.5, 75], [17, 2.5, 75], [18, 2.5, 75], [19, 2.5, 75], [20, 2.5, 75],
    [16, -2.5, 75], [17, -2.5, 75], [18, -2.5, 75], [19, -2.5, 75], [20, -2.5, 75],
    [19.5, 0.8, 92.5], [19.5, -0.8, 92.5], [17.8, 1, 94.6], [17.8, -1, 94.6],
    [17.7, 0.8, 96.7], [17.7, -0.8, 96.7], [17.1, 0, 98.8], [17.8, 0, 100.9, 45], [17.9, 0, 103, -45],
    [18.1, 0.4, 107.1], [18.9, -0.4, 107.1], [18.2, -0.3, 109.2], [18.8, 0.3, 109.2],
    [18.3, 0.2, 111.3], [18.7, -0.2, 111.3], [18.4, -0.1, 113.4], [18.6, 0.1, 113.4],
  ];
  for (const [index, [forward, side, elevation, yawOffset, destructible]] of route.entries()) {
    const angles = yawOffset === undefined ? undefined : { pitch: 0, yaw: normalizeYaw(yawOf(runtime.direction) + yawOffset), roll: 0 };
    runtime.layout.route.push(destructible
      ? queueClimbBreakable(runtime, forward, side, elevation, `route_${index}`, false, angles)
      : queueClimbPiece(runtime, forward, side, elevation, `route_${index}`, false, "platform", true, angles));
  }

  const ladders = [
    [22, 0, 15, 0], [21, 0, 45, 0], [20, 0, 75, 0],
    [19.5, 0, 115, 0], [17.5, 0, 115, 180], [18.5, 1, 115, 90], [18.5, -1, 115, 270],
  ];
  for (const [index, [forward, side, elevation, yawOffset]] of ladders.entries()) {
    const record = [];
    const position = climbPosition(runtime, forward, side, elevation);
    queueEndingLadder(runtime, position, { pitch: 0, yaw: normalizeYaw(yawOf(runtime.direction) + yawOffset), roll: 0 }, `ladder_${index}`, false, true, record);
    const piece = { role: `ladder_${index}`, position, entities: record, safe: false, crumble: true, ladder: true };
    runtime.layout.pieces.push(piece);
    runtime.layout.crumblePieces.push(piece);
    runtime.layout.ladders.push(piece);
  }

  runtime.safePiece = queueClimbPiece(runtime, CLIMB_CONFIG.towerCenterForward, 0, CLIMB_CONFIG.safeElevation, "safe_top", true);
  runtime.safeSupports = [
    [19.25, 0.75], [19.25, -0.75], [17.75, 0.75], [17.75, -0.75],
  ].map(([forward, side], index) => queueClimbBreakable(
    runtime, forward, side, 129.9, `safe_support_${index}`, true,
  ));
  runtime.safeCenter = clone(runtime.safePiece.position);
  runtime.towerCenter = climbPosition(runtime, CLIMB_CONFIG.towerCenterForward, 0, 0);
  runtime.tpPosition = add(climbPosition(runtime, 0, 0, 0), vec(0, 0, 8));
  runtime.tplimitZ = runtime.tpPosition.z - CLIMB_CONFIG.flightZCap;
  runtime.boostPosition = clone(runtime.boostPiece.position);
}

function spawnClimbFlight(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const side = Math.random() < 0.5 ? -1 : 1;
  const position = add(
    runtime.tpPosition,
    add(mul(runtime.left, side * (70 + Math.random() * 160)), add(mul(runtime.direction, -45 + Math.random() * 90), vec(0, 0, 40))),
  );
  spawnItemFeature(runtime, {
    kind: "feature", feature: "item", position,
    angles: anglesFor(runtime.direction), team: 2,
    endingItem: true, debugItem: true, itemName: "flight",
  });
}

function maintainClimbFlights(runtime) {
  const flights = [...runtime.items].filter((item) => item.name === "flight" && !["consumed", "cleaned"].includes(item.state));
  for (let index = flights.length; index < CLIMB_CONFIG.flightAmount; index++) spawnClimbFlight(runtime);
  for (const item of runtime.items) {
    if (item.name !== "flight" || !validEntity(item.holder)) continue;
    if (!item.data.climbInitialized || (item.holder.GetAbsOrigin?.()?.z ?? Infinity) < runtime.tplimitZ) {
      let outward = vec(runtime.towerCenter.x, runtime.towerCenter.y, 0);
      const length = Math.hypot(outward.x, outward.y);
      outward = length > 0.001 ? mul(outward, 1 / length) : mul(runtime.direction, -1);
      const position = add(
        runtime.towerCenter,
        add(
          mul(outward, CLIMB_CONFIG.flightInitialDistance),
          vec(
            -CLIMB_CONFIG.flightInitialRandomOffset + Math.random() * CLIMB_CONFIG.flightInitialRandomOffset * 2,
            -CLIMB_CONFIG.flightInitialRandomOffset + Math.random() * CLIMB_CONFIG.flightInitialRandomOffset * 2,
            CLIMB_CONFIG.flightInitialHeight - CLIMB_CONFIG.flightInitialRandomOffset + Math.random() * CLIMB_CONFIG.flightInitialRandomOffset * 2,
          ),
        ),
      );
      const clamped = vec(
        Math.max(-16000, Math.min(16000, position.x)),
        Math.max(-16000, Math.min(16000, position.y)),
        Math.max(-16000, Math.min(16000, position.z)),
      );
      const inward = directionBetween(clamped, runtime.towerCenter);
      item.holder.Teleport?.({ position: clamped, velocity: mul(inward, CLIMB_CONFIG.flightInitialSpeed) });
      item.data.climbInitialized = true;
    }
  }
}

function startClimbCrumble(runtime, scheduledAt) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.crumbleQueue.length > 0) return;
  runtime.crumbleQueue = [...runtime.layout.crumblePieces]
    .filter((piece) => piece && piece.crumble !== false && !piece.safe)
    .sort(() => Math.random() - 0.5);
  runtime.nextCrumbleAt = Instance.GetGameTime();
  runtime.crumbleStartedAt = scheduledAt ?? runtime.nextCrumbleAt;
  runtime.boostDisabled = true;
  runtime.laddersRemovedAt = runtime.crumbleStartedAt;
  for (const entity of runtime.boostPiece?.entities ?? []) destroyEndingEntity(runtime, entity);
  if (runtime.boostVisual) destroyEndingEntity(runtime, runtime.boostVisual);
  runtime.boostVisualState = "removed";
  fireName("tele_spawninit", "Disable");
  fireName("tele_spawn", "Disable");
                                                                               
                                                                               
  enableEndingSpawnKiller(runtime, runtime.crumbleStartedAt, { slayFlight: false });
}

function processClimbCrumble(runtime, now) {
  if (runtime.crumbleQueue.length <= 0 || now < runtime.nextCrumbleAt) return;
  runtime.nextCrumbleAt = now + CLIMB_CONFIG.crumbleRate;
  const piece = runtime.crumbleQueue.shift();
  for (const entity of piece.entities ?? []) {
    if (!validEntity(entity)) continue;
    const className = String(entity.GetClassName?.() ?? "").toLowerCase();
    if (className.startsWith("trigger_")) {
      entity.Kill?.();
      continue;
    }
    beginEndingEntityFall(runtime, entity, CLIMB_CONFIG.crumbleFallLifetime);
  }
  runtime.crumbleRemoved = (runtime.crumbleRemoved ?? 0) + 1;
}

function spawnClimbDebris(runtime, now) {
  if (!runtime || runtime.lifecycle !== "active" || !runtime.debrisEnabled) return;
  runtime.nextDebrisAt ??= now;
  if (now < runtime.nextDebrisAt) return;
  runtime.nextDebrisAt = now + CLIMB_CONFIG.debrisRateMin
    + Math.random() * (CLIMB_CONFIG.debrisRateMax - CLIMB_CONFIG.debrisRateMin);
  const targets = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  if (targets.length <= 0) return;
  const target = targets[Math.floor(Math.random() * targets.length)];
  const origin = target.GetAbsOrigin?.() ?? runtime.towerCenter;
  const angle = Math.random() * Math.PI * 2;
  const radius = Math.random() * CLIMB_CONFIG.debrisRadius;
  const position = add(origin, vec(
    Math.cos(angle) * radius,
    Math.sin(angle) * radius,
    CLIMB_CONFIG.debrisZMin + Math.random() * (CLIMB_CONFIG.debrisZMax - CLIMB_CONFIG.debrisZMin),
  ));
  const debrisThemeName = themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  const debrisThemeShape = "floor";
  const debrisModel = chooseTerrainModel(debrisThemeName, debrisThemeShape);
  try {
    const visual = spawnModelBlock(
      runtime,
      { position, angles: { pitch: Math.random() * 360, yaw: Math.random() * 360, roll: Math.random() * 360 }, feature: "climbDebris" },
      debrisModel,
      0,
      1,
    );
    if (!visual) return;
    runtime.entities.add(visual);
    runtime.debrisPieces ??= new Set();
    const piece = {
      visual, model: debrisModel, themeName: debrisThemeName, themeShape: debrisThemeShape,
      position: clone(position), spawnedAt: now, expiresAt: now + CLIMB_CONFIG.debrisLifetime,
      damage: CLIMB_CONFIG.debrisDamage, touchers: new Set(),
    };
    const physics = beginEndingEntityFall(runtime, visual, CLIMB_CONFIG.debrisLifetime);
    if (!physics) return;
    piece.visual = physics;
    runtime.debrisPieces.add(piece);
  } catch (error) {
    runtime.debrisSpawnError = String(error);
  }
}

function processClimbDebris(runtime, now) {
  if (!runtime) return;
  if (runtime.debrisEnabled) spawnClimbDebris(runtime, now);
  const pawns = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  for (const piece of [...(runtime.debrisPieces ?? [])]) {
    if (!validEntity(piece.visual)) {
      runtime.debrisPieces.delete(piece);
      continue;
    }
    const position = piece.visual.GetAbsOrigin?.() ?? piece.position;
    for (const pawn of pawns) {
      if (piece.touchers.has(pawn)) continue;
      const pawnPosition = pawn.GetAbsOrigin?.();
      if (!pawnPosition || Math.hypot(pawnPosition.x - position.x, pawnPosition.y - position.y, pawnPosition.z - position.z) > 96) continue;
      piece.touchers.add(pawn);
      damagePawn(pawn, piece.damage, piece.visual, piece.visual);
    }
  }
}

function resolveClimbCheckpoint(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  for (const item of [...runtime.items]) if (item.name === "flight") consumeItem(runtime, item);
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  const survivors = humans.filter((pawn) => {
    const origin = pawn.GetAbsOrigin?.();
    return origin && distance2D(origin, runtime.safeCenter) <= CONFIG.gridSize * 1.5 && origin.z >= runtime.safeCenter.z - 120;
  });
  runtime.safeHumans = new Set(survivors);
  runtime.checkpointEvaluatedAt = Instance.GetGameTime();
  runtime.safeCondition = humans.length > 0 && survivors.length === humans.length;
                                                                             
                                                                      
}

function scheduleClimbTimeline(runtime) {
  if (!runtime || runtime.climbTimelineScheduled) return;
  runtime.climbTimelineScheduled = true;
  const at = (delay) => runtime.runStartedAt + delay;
  const handlers = {
    climb_precipitation: () => {
      runtime.precipitationSupported = false;
      runtime.precipitationEnabled = false;
      runtime.precipitationRequested = true;
      runtime.precipitationNote = "CLIMB precipitation is not fabricated from the retired template_precipitation slot";
      runtime.precipitationType = CLIMB_CONFIG.precipitation;
      runtime.precipitationStartedAt = at(CLIMB_CONFIG.precipitationDelay);
    },
    climb_boost: () => setClimbBoostVisualState(runtime, true),
    climb_tp: () => {
      moveTeleportDestination(runtime.tpPosition, runtime.direction);
      runtime.tpMovedAt = at(CLIMB_CONFIG.tpDelay);
      releaseEndingSourceLevels(runtime);
    },
    climb_flight: () => {
      runtime.flightSpawning = true;
      runtime.flightSpawnedAt = at(CLIMB_CONFIG.flightSpawnDelay);
      maintainClimbFlights(runtime);
    },
    climb_debris: () => {
      runtime.debrisEnabled = true;
      runtime.debrisStartedAt = at(CLIMB_CONFIG.debrisStartDelay);
      runtime.nextDebrisAt = at(CLIMB_CONFIG.debrisStartDelay);
    },
    climb_crumble: () => startClimbCrumble(runtime, at(CLIMB_CONFIG.crumbleTime)),
    climb_flight_slay: () => {
      runtime.flightSpawning = false;
      runtime.flightRemovedAt = at(CLIMB_CONFIG.flightSlayTime);
      runtime.debrisEnabled = false;
      runtime.debrisStoppedAt = at(CLIMB_CONFIG.flightSlayTime);
      for (const piece of [...(runtime.debrisPieces ?? [])]) destroyEndingEntity(runtime, piece.visual);
      runtime.debrisPieces?.clear?.();
      enableEndingSpawnKiller(runtime, at(CLIMB_CONFIG.flightSlayTime));
      runtime.flightHoldersKilled = runtime.spawnKillerFlightSlay?.holders ?? 0;
      runtime.spawnKillerConfirmedAt = at(CLIMB_CONFIG.flightSlayTime);
    },
    climb_fail: () => {
      runtime.failTriggeredAt = at(CLIMB_CONFIG.failTime);
      for (const pawn of allLivingPawns()) pawn.TakeDamage?.({ damage: 999999, damageFlags: CSDamageFlags.FORCE_DEATH ?? 0 });
      resolveStageEnding(false);
    },
    climb_announce_0: () => announce("[CLIMB ENDING] WE MUST CLIMB THE TOWER"),
    climb_announce_1: () => announce("[CLIMB ENDING] ONLY THE VERY TOP WILL BE SAFE"),
    climb_announce_go: () => announce("[CLIMB ENDING] NOW GO!"),
    climb_announce_rain: () => announce("[CLIMB ENDING] RAIN IS STARTING"),
    climb_announce_crumble: () => announce("[CLIMB ENDING] THE TOWER IS STARTING TO CRUMBLE"),
    climb_announce_flight: () => announce("[CLIMB ENDING] THE ANGELS ARE DEAD"),
  };
  runtime.climbTimelineHandlers = handlers;
  const delays = {
    climb_precipitation: CLIMB_CONFIG.precipitationDelay,
    climb_boost: CLIMB_CONFIG.boostEnableDelay,
    climb_tp: CLIMB_CONFIG.tpDelay,
    climb_flight: CLIMB_CONFIG.flightSpawnDelay,
    climb_debris: CLIMB_CONFIG.debrisStartDelay,
    climb_crumble: CLIMB_CONFIG.crumbleTime,
    climb_flight_slay: CLIMB_CONFIG.flightSlayTime,
    climb_fail: CLIMB_CONFIG.failTime,
    climb_announce_0: 0,
    climb_announce_1: 1.03,
    climb_announce_go: CLIMB_CONFIG.boostEnableDelay,
    climb_announce_rain: CLIMB_CONFIG.precipitationDelay,
    climb_announce_crumble: CLIMB_CONFIG.crumbleTime,
    climb_announce_flight: CLIMB_CONFIG.flightSlayTime,
  };
  for (const [key, callback] of Object.entries(handlers)) endingTaskAt(runtime, at(delays[key]), callback, key);
}

function finishClimbSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.startedAt = runtime.runStartedAt;
  runtime.boostEnabledAt = runtime.runStartedAt + CLIMB_CONFIG.boostEnableDelay;
  runtime.flightEnabledAt = runtime.runStartedAt + CLIMB_CONFIG.flightSpawnDelay;
  runtime.debrisStartsAt = runtime.runStartedAt + CLIMB_CONFIG.debrisStartDelay;
  runtime.flightSpawning = false;
  runtime.nextBoostAt = new Map();
  spawnClimbBoostVisual(runtime);
  flushEndingTimeline(runtime, runtime.climbTimelineHandlers);
}

function startClimbEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  for (const key of ["ladder", "item_flight", "item_carrier_knife", "trigger"]) {
    const template = state.featureTemplates.get(key);
    if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") throw new Error(`CLIMB requires feature template '${key}'`);
  }
  const runtime = createEndingRuntime("CLIMB", stageSnapshot, sourceRuntime);
  playEndingMusic(runtime, ENDING_MUSIC.CLIMB);
  buildClimbGeometry(runtime);
  scheduleClimbTimeline(runtime);
  return runtime;
}

function processClimbEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "CLIMB") return;
  if (runtime.lifecycle === "spawning") {
    processEndingSpawnQueue(runtime, finishClimbSpawn);
    return;
  }
  if (runtime.lifecycle !== "active") return;
  const now = Instance.GetGameTime();
  if (!runtime.boostDisabled && now >= runtime.boostEnabledAt) {
    for (const pawn of allLivingPawns()) {
      const origin = pawn.GetAbsOrigin?.();
      if (!origin || distance2D(origin, runtime.boostPosition) > 55 || Math.abs(origin.z - runtime.boostPosition.z) > 70) continue;
      if ((runtime.nextBoostAt.get(pawn) ?? 0) > now) continue;
      runtime.nextBoostAt.set(pawn, now + 1);
      pawn.Teleport?.({ position: add(runtime.boostPosition, vec(0, 0, 25)), velocity: add(mul(runtime.direction, 750), vec(0, 0, 1000)) });
                                                                        
                                                                           
                                                                          
                               
      runtime.boostSoundPlayed = true;
      runtime.boostSoundToken = "boostpad";
      runtime.boostSoundCount = (runtime.boostSoundCount ?? 0) + 1;
      runtime.boostSoundAvailable = playSourceAudioCue(1471, runtime.boostPosition, {recipient:pawn});
    }
  }
  if (runtime.flightSpawning) maintainClimbFlights(runtime);
  processClimbDebris(runtime, now);
  processClimbCrumble(runtime, now);
  if (allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3).length <= 0) resolveStageEnding(false);
}

function conflictPosition(runtime, forwardCell, sideCell, elevation = 0) {
  return add(runtime.arenaAnchor, add(
    mul(runtime.direction, (forwardCell + 0.5) * CONFIG.gridSize),
    add(mul(runtime.left, sideCell * CONFIG.gridSize), vec(0, 0, elevation * CONFIG.elevationStep)),
  ));
}

function chooseConflictDirection(runtime, pivot = runtime.anchor, oldDirection = runtime.direction) {
  const candidates = [];
  if (oldDirection.x > 0) candidates.push(vec(1, 0, 0), vec(0, 1, 0), vec(0, -1, 0));
  else if (oldDirection.x < 0) candidates.push(vec(-1, 0, 0), vec(0, 1, 0), vec(0, -1, 0));
  else if (oldDirection.y > 0) candidates.push(vec(1, 0, 0), vec(-1, 0, 0), vec(0, 1, 0));
  else candidates.push(vec(1, 0, 0), vec(-1, 0, 0), vec(0, -1, 0));
  let selected;
  for (const candidate of shuffleCopy(candidates)) {
    const probe = add(pivot, mul(candidate, 12000));
    const allowed = candidate.x > 0
      ? probe.x < RISE_CONFIG.worldBoundary
      : candidate.x < 0
        ? probe.x > -RISE_CONFIG.worldBoundary
        : candidate.y > 0
          ? probe.y < RISE_CONFIG.worldBoundary
          : probe.y > -RISE_CONFIG.worldBoundary;
    if (allowed) {
      selected = candidate;
      break;
    }
  }
  selected ??= clone(oldDirection);
  runtime.direction = clone(selected);
  runtime.left = leftOf(runtime.direction);
  runtime.boundaryDirectionFallback = selected.x !== oldDirection.x || selected.y !== oldDirection.y;
  runtime.directionPivot = clone(pivot);
  return runtime.direction;
}

function buildConflictGeometry(runtime) {
  const oldDirection = clone(runtime.direction);
  const oldLeft = leftOf(oldDirection);
  runtime.layout = { buffer: [], base: [], arena: [], zombiePlatform: undefined };
  runtime.tileSemantics = [];
                                                                       
                                                                            
  for (let forward = 0; forward < CONFLICT_CONFIG.startBufferLength; forward++) {
    for (const side of [-0.5, 0.5]) {
      const record = [];
      const position = add(runtime.anchor, add(
        mul(oldDirection, (forward + 0.5) * CONFIG.gridSize),
        mul(oldLeft, side * CONFIG.gridSize),
      ));
      queueEndingTile(runtime, 5, "floor", position, `buffer_${forward}_${side}`, false, true, record, anglesFor(oldDirection));
      const piece = { tile: 5, shape: "floor", forward, side, position, entities: record };
      runtime.layout.buffer.push(piece);
      runtime.tileSemantics.push(piece);
    }
  }
  const pivot = add(runtime.anchor, mul(oldDirection, (CONFLICT_CONFIG.startBufferLength - 1) * CONFIG.gridSize));
  chooseConflictDirection(runtime, pivot, oldDirection);
  runtime.courseAnchor = add(pivot, mul(runtime.direction, CONFIG.gridSize));
  runtime.arenaAnchor = runtime.courseAnchor;
  for (let forward = 0; forward < CONFLICT_CONFIG.baseLength; forward++) {
    for (let side = -1; side <= 1; side++) {
      const record = [], position = conflictPosition(runtime, forward, side);
      queueEndingTile(runtime, 40, "platform", position, `human_base_${forward}_${side}`, true, false, record);
      const piece = { tile: 40, shape: "platform", forward, side, position, entities: record, safe: true };
      runtime.layout.base.push(piece);
      runtime.tileSemantics.push(piece);
    }
  }
  for (let x = 0; x < CONFLICT_CONFIG.arenaLength; x++) {
    for (let side = -CONFLICT_CONFIG.arenaWidth / 2; side <= CONFLICT_CONFIG.arenaWidth / 2; side++) {
      const forward = CONFLICT_CONFIG.baseLength + x;
      const record = [], position = conflictPosition(runtime, forward, side);
      queueEndingTile(runtime, 20, "floor", position, `arena_${x}_${side}`, false, true, record);
      const piece = { tile: 20, shape: "floor", forward, side, x, position, entities: record, removed: false };
      runtime.layout.arena.push(piece);
      runtime.tileSemantics.push(piece);
    }
  }
  const zombieForward = CONFLICT_CONFIG.baseLength + CONFLICT_CONFIG.arenaLength;
  const zombiePosition = conflictPosition(runtime, zombieForward, 0, CONFLICT_CONFIG.zombiePlatformHeight);
  const zombieRecord = [];
  queueEndingTile(runtime, 25, "platform", zombiePosition, "zombie_platform", true, false, zombieRecord);
  runtime.layout.zombiePlatform = { tile: 25, shape: "platform", position: zombiePosition, entities: zombieRecord, safe: true };
  runtime.tileSemantics.push(runtime.layout.zombiePlatform);
  runtime.humanSpawn = add(conflictPosition(runtime, 0, 0), vec(0, 0, 8));
  runtime.zombieSpawn = add(zombiePosition, vec(0, 0, 8));
  runtime.tpPosition = clone(runtime.zombieSpawn);
  runtime.boundary = {
    forwardMin: CONFLICT_CONFIG.boundaryForwardMin,
    forwardMax: CONFLICT_CONFIG.boundaryForwardMax,
    halfSide: CONFLICT_CONFIG.boundaryHalfSide,
  };
}

function shuffleCopy(values) {
  const result = [...values];
  for (let index = result.length - 1; index > 0; index--) {
    const swap = Math.floor(Math.random() * (index + 1));
    [result[index], result[swap]] = [result[swap], result[index]];
  }
  return result;
}

function mutateConflictTerrain(runtime, random = Math.random) {
  const distance = (a, b) => Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
  const scan = (forward, side, z = 0) => add(runtime.arenaAnchor, add(
    mul(runtime.direction, forward),
    add(mul(runtime.left, side), vec(0, 0, z)),
  ));
  runtime.terrainCleanMutations = [];
  for (let iteration = 0; iteration < CONFLICT_CONFIG.terrainCleanIterations; iteration++) {
    const sideSign = random() < 0.5 ? -1 : 1;
    const forward = CONFLICT_CONFIG.terrainCleanForwardMin
      + random() * (CONFLICT_CONFIG.terrainCleanForwardMax - CONFLICT_CONFIG.terrainCleanForwardMin);
    const side = sideSign * (
      CONFLICT_CONFIG.terrainCleanSideMin
      + random() * (CONFLICT_CONFIG.terrainCleanSideMax - CONFLICT_CONFIG.terrainCleanSideMin)
    );
    const radius = CONFLICT_CONFIG.terrainCleanRadiusMin
      + random() * (CONFLICT_CONFIG.terrainCleanRadiusMax - CONFLICT_CONFIG.terrainCleanRadiusMin);
    const center = scan(forward, side);
    const affected = runtime.layout.arena.filter((piece) => !piece.removed && distance(piece.position, center) <= radius);
    for (const piece of affected) {
      piece.removed = true;
      for (const entity of piece.entities) if (entity?.IsValid?.()) entity.Kill?.();
    }
    runtime.terrainCleanMutations.push({ iteration, center, radius, affected: affected.length });
  }
  runtime.terrainElevationMutations = [];
  for (let iteration = 0; iteration < CONFLICT_CONFIG.terrainElevationIterations; iteration++) {
    const sideSign = random() < 0.5 ? -1 : 1;
    const forward = CONFLICT_CONFIG.terrainElevationForwardMin
      + random() * (CONFLICT_CONFIG.terrainElevationForwardMax - CONFLICT_CONFIG.terrainElevationForwardMin);
    const side = sideSign * (
      CONFLICT_CONFIG.terrainElevationSideMin
      + random() * (CONFLICT_CONFIG.terrainElevationSideMax - CONFLICT_CONFIG.terrainElevationSideMin)
    );
    const zOffset = (random() * 2 - 1) * CONFLICT_CONFIG.terrainElevationRadiusZ;
    const radius = CONFLICT_CONFIG.terrainElevationRadiusMin
      + random() * (CONFLICT_CONFIG.terrainElevationRadiusMax - CONFLICT_CONFIG.terrainElevationRadiusMin);
    const amount = (CONFLICT_CONFIG.terrainElevationMin
      + random() * (CONFLICT_CONFIG.terrainElevationMax - CONFLICT_CONFIG.terrainElevationMin))
      * (random() < 0.5 ? -1 : 1);
    const center = scan(forward, side, zOffset);
    const affected = runtime.layout.arena.filter((piece) => !piece.removed && distance(piece.position, center) <= radius);
    for (const piece of affected) {
      piece.position = add(piece.position, vec(0, 0, amount));
      for (const entity of piece.entities) entity.Teleport?.({ position: piece.position, velocity: vec() });
    }
    runtime.terrainElevationMutations.push({ iteration, center, radius, amount, affected: affected.length });
  }
  const itemRange = CONFLICT_CONFIG.itemFlagRange;
  const humanCenter = runtime.arenaAnchor;
  const zombieCenter = add(runtime.arenaAnchor, mul(runtime.direction, (
    CONFLICT_CONFIG.baseLength + CONFLICT_CONFIG.arenaLength
  ) * CONFIG.gridSize));
  runtime.humanItemScan = { center: humanCenter, radius: itemRange };
  runtime.zombieItemScan = { center: zombieCenter, radius: itemRange };
  runtime.humanItemTiles = runtime.layout.arena.filter((piece) => !piece.removed && distance(piece.position, humanCenter) <= itemRange);
  runtime.zombieItemTiles = runtime.layout.arena.filter((piece) => !piece.removed && distance(piece.position, zombieCenter) <= itemRange);
  const flagCandidates = [...runtime.humanItemTiles];
  runtime.flagTile = flagCandidates[Math.floor(Math.random() * flagCandidates.length)] ?? runtime.layout.base[4];
  runtime.flagPosition = clone(runtime.flagTile.position);
  runtime.flagPolePosition = add(runtime.flagPosition, vec(0, 0, -10));
}

function spawnConflictFlag(runtime) {
  const angles = { pitch: 0, yaw: Math.random() * 360, roll: 0 };
  runtime.flagResourceAvailable = false;
  runtime.flagResourceNote = `addon flagpole '${CONFLICT_FLAG_MODEL}' requires assetdep_conflict_flagpole`;
  const pole = spawnVisual(runtime, { position: runtime.flagPolePosition, angles, feature: "conflict_flagpole" }, CONFLICT_FLAG_MODEL);
  if (!validEntity(pole)) throw new Error("CONFLICT flagpole visual failed to spawn");
  runtime.flagPoleVisual = pole;
  runtime.flagVisual = pole;
  pole.SetModelScale?.(1.50);
  pole.SetColor?.({ r: 20, g: 100, b: 255, a: 255 });
  pole.Glow?.({ r: 50, g: 200, b: 255, a: 255 });
  fireTarget(pole, "SetAnimation", "idle");
  fireTarget(pole, "SetDefaultAnimation", "idle");
  runtime.flagResourceAvailable = true;
  const indicator = spawnVisual(runtime, { position: runtime.flagPosition, angles, feature: "conflict_flag_indicator" }, CONFLICT_FLAG_INDICATOR_MODEL);
  runtime.flagIndicator = indicator;
  indicator?.SetModelScale?.(0.97);
  indicator?.SetColor?.({ r: 20, g: 100, b: 255, a: 255 });
  indicator?.Glow?.({ r: 50, g: 200, b: 255, a: 255 });
}

function conflictLocalCoordinates(runtime, position) {
  const delta = sub(position, runtime.arenaAnchor);
  return {
    forward: (delta.x * runtime.direction.x + delta.y * runtime.direction.y) / CONFIG.gridSize,
    side: (delta.x * runtime.left.x + delta.y * runtime.left.y) / CONFIG.gridSize,
  };
}

function rescueConflictPawn(runtime, pawn) {
  if (!runtime || !pawn?.IsValid?.() || !pawn.IsAlive?.()) return false;
  const team = pawn.GetTeamNumber?.();
  const destination = team === 3 ? runtime.humanSpawn : team === 2 ? runtime.zombieSpawn : undefined;
  if (!destination) return false;
  pawn.Teleport?.({ position: clone(destination), velocity: vec() });
  runtime.rescueCount = (runtime.rescueCount ?? 0) + 1;
  runtime.lastRescueTeam = team;
  return true;
}

function spawnConflictBoundary(runtime) {
  runtime.boundarySupported = false;
  runtime.boundaryNote = "boundary trigger uses spatial rescue fallback; brush bounds require in-game verification";
  try {
    const trigger = spawnTriggerVolume(
      runtime,
      { position: conflictPosition(runtime, CONFLICT_CONFIG.baseLength, 0), angles: anglesFor(runtime.direction), feature: "conflict_boundary" },
      vec(-2, -CONFLICT_CONFIG.boundaryHalfSide * CONFIG.gridSize, -2000),
      vec((CONFLICT_CONFIG.arenaLength * CONFIG.gridSize) + 4, CONFLICT_CONFIG.boundaryHalfSide * CONFIG.gridSize, 5000),
    );
    runtime.boundaryTrigger = trigger;
    runtime.externalEntities.add(trigger);
    runtime.boundarySupported = true;
    connectOwnedOutput(runtime, trigger, "OnStartTouch", ({ activator } = {}) => {
      const pawn = resolvePawn(activator);
      if (!pawn) return;
      const local = conflictLocalCoordinates(runtime, pawn.GetAbsOrigin?.() ?? runtime.arenaAnchor);
      if (local.forward < runtime.boundary.forwardMin
        || local.forward > runtime.boundary.forwardMax
        || Math.abs(local.side) > runtime.boundary.halfSide) rescueConflictPawn(runtime, pawn);
    });
  } catch (error) {
    runtime.boundaryNote = `boundary trigger unavailable: ${error}; process-time spatial rescue remains active`;
  }
}

function processConflictBoundary(runtime) {
  for (const pawn of allLivingPawns()) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const local = conflictLocalCoordinates(runtime, position);
    if (local.forward < runtime.boundary.forwardMin
      || local.forward > runtime.boundary.forwardMax
      || Math.abs(local.side) > runtime.boundary.halfSide) rescueConflictPawn(runtime, pawn);
  }
}

function spawnConflictItem(runtime, name, team, position) {
  spawnItemFeature(runtime, {
    kind: "feature", feature: "item", position: add(position, vec(0, 0, 40)),
    angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 }, team,
    endingItem: true, debugItem: true, itemName: name,
  });
}

function scheduleConflictItems(runtime) {
  const humanTiles = shuffleCopy(runtime.humanItemTiles), zombieTiles = shuffleCopy(runtime.zombieItemTiles);
  let delay = 0;
  for (const name of CONFLICT_CONFIG.humanItems) {
    const tile = humanTiles.shift() ?? runtime.flagTile;
    endingTask(runtime, delay, () => spawnConflictItem(runtime, name, 3, tile.position));
    delay += 0.05;
  }
  for (const name of CONFLICT_CONFIG.zombieItems) {
    const tile = zombieTiles.shift() ?? runtime.layout.arena.at(-1);
    endingTask(runtime, delay, () => spawnConflictItem(runtime, name, 2, tile.position));
    delay += 0.05;
  }
}

function finishConflictRound(runtime, winner) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.ended) return;
                                                                      
                                                                             
  setZombieRespawning(false, runtime);
  runtime.ended = true;
  runtime.winner = winner;
  runtime.outcomeCandidate = winner === 3;
  runtime.outcomeAt = Instance.GetGameTime();
  const losingTeam = winner === 3 ? 2 : 3;
  runtime.losingTeam = losingTeam;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() !== losingTeam) continue;
    pawn.TakeDamage?.({ damage: 999999, damageFlags: CSDamageFlags.FORCE_DEATH ?? 0 });
  }
  runtime.spawnKillerAfterResultAt = runtime.outcomeAt + 0.2;
  endingTask(runtime, 0.2, () => {
    runtime.spawnKillerIssuedAt = Instance.GetGameTime();
    enableEndingSpawnKiller(runtime, runtime.spawnKillerAfterResultAt);
  });
  runtime.massKillAt = runtime.outcomeAt + 15;
  endingTask(runtime, 15, () => {
    runtime.massKillIssuedAt = Instance.GetGameTime();
    for (const pawn of allLivingPawns()) pawn.TakeDamage?.({ damage: 999999, damageFlags: CSDamageFlags.FORCE_DEATH ?? 0 });
  });
}

function processConflictTick(runtime, now) {
  if (runtime.ended) return;
  if (now < runtime.nextConflictTickAt) return;
  runtime.nextConflictTickAt = now + CONFLICT_CONFIG.tickRate;
  const pawns = allLivingPawns();
  const humans = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 3);
  const zombies = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 2);
  runtime.lastConflictTickAt = now;
  if (humans.length <= 0) { finishConflictRound(runtime, 2); return; }
  const cap = Math.max(1, CONFLICT_CONFIG.zombieHealthBase + CONFLICT_CONFIG.zombieHealthPerHuman * humans.length);
  for (const zombie of zombies) if ((zombie.GetHealth?.() ?? 0) > cap) zombie.SetHealth?.(cap);
  for (const human of humans) {
    let damage = 0;
    const a = human.GetAbsOrigin?.();
    for (const zombie of zombies) {
      const b = zombie.GetAbsOrigin?.();
      if (a && b && Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z) <= CONFLICT_CONFIG.touchRange) damage += CONFLICT_CONFIG.touchDamage;
    }
    if (damage > 0) damagePawn(human, damage);
  }
  const attackers = zombies.filter((zombie) => {
    const origin = zombie.GetAbsOrigin?.();
    return origin && Math.hypot(origin.x - runtime.flagPosition.x, origin.y - runtime.flagPosition.y, origin.z - (runtime.flagPosition.z + 40)) <= 40;
  });
  runtime.flagLife = Math.min(100, runtime.flagLife + attackers.length * CONFLICT_CONFIG.flagDrainPerZombie);
  const flagColor = attackers.length > 0 ? { r: 255, g: 0, b: 0, a: 255 } : { r: 20, g: 100, b: 255, a: 255 };
  runtime.flagVisual?.SetColor?.(flagColor);
  runtime.flagIndicator?.SetColor?.(flagColor);
  if (attackers.length > 0) {
    runtime.flagSoundPitch = 70 + runtime.flagLife;
    runtime.flagPitchLastApplied = playSourceAudioCue(2841, runtime.flagPosition, { pitch: runtime.flagSoundPitch });
    runtime.flagPitchHook = "click1 Pitch input via EntFireAtTarget";
    if (!runtime.flagPitchLastApplied) runtime.flagPitchNote = "click1 sound anchor is unavailable; dynamic pitch could not be issued";
  }
  if (runtime.flagLife >= 100) { finishConflictRound(runtime, 2); return; }
  if (runtime.timerStarted) {
    runtime.timeRemaining = Math.max(0, runtime.battleEndsAt - now);
    if (runtime.timeRemaining <= 0) { finishConflictRound(runtime, 3); return; }
  }
}

function finishConflictSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  mutateConflictTerrain(runtime);
  spawnConflictFlag(runtime);
  spawnConflictBoundary(runtime);
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  const now = Instance.GetGameTime();
  runtime.runStartedAt ??= now;
  runtime.startedAt = runtime.runStartedAt;
  runtime.flagLife = 0;
                                                                          
                                                                         
                                                                              
                                                               
  runtime.flagPitchSupported = false;
  runtime.flagPitchNote = "dynamic click1 Pitch input is emitted; verify ambient sound-event support in-game";
  runtime.nextConflictTickAt = runtime.runStartedAt;
  runtime.timerStarted = false;
  runtime.timeRemaining = CONFLICT_CONFIG.battleTime;
  runtime.battleStartsAt = runtime.runStartedAt + CONFLICT_CONFIG.prepareTime;
  runtime.battleEndsAt = runtime.battleStartsAt + CONFLICT_CONFIG.battleTime;
  runtime.jumpPressed = new Map();
  runtime.jumpGrounded = new Map();
  runtime.crouchJump = { velocity: CONFLICT_CONFIG.jumpForce, ctOnly: false, crouchOnly: true };
  endingTaskAt(runtime, runtime.runStartedAt + CONFLICT_CONFIG.tpDelay, () => {
    moveTeleportDestination(runtime.tpPosition, mul(runtime.direction, -1));
    runtime.tpMovedAt = runtime.runStartedAt + CONFLICT_CONFIG.tpDelay;
    // Nut named the start buffer block_<final stage>, so it faded with it.
    returnEntitiesToEndingSource(runtime, runtime.layout.buffer.flatMap(piece => piece.entities));
    releaseEndingSourceLevels(runtime);
  }, "tp");
  endingTaskAt(runtime, runtime.battleStartsAt, () => {
    runtime.timerStarted = true;
    runtime.timerStartedAt = runtime.battleStartsAt;
    runtime.timeRemaining = CONFLICT_CONFIG.battleTime;
  }, "prepare");
  scheduleConflictItems(runtime);
  announce(`CONFLICT ending started; defend the flag for ${CONFLICT_CONFIG.battleTime} seconds`);
}

function startConflictEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  for (const name of new Set([...CONFLICT_CONFIG.humanItems, ...CONFLICT_CONFIG.zombieItems])) {
    const definition = ITEM_DEFINITIONS[name], key = `item_${definition?.templateName ?? name}`;
    const template = state.featureTemplates.get(key);
    if (!definition || !template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") throw new Error(`CONFLICT requires feature template '${key}'`);
  }
  for (const key of ["model", "item_carrier_p250", "item_carrier_knife", "trigger"]) {
    const template = state.featureTemplates.get(key);
    if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") throw new Error(`CONFLICT requires feature template '${key}'`);
  }
  const runtime = createEndingRuntime("CONFLICT", stageSnapshot, sourceRuntime);
  playEndingMusic(runtime, CONFLICT_CONFIG.music);
  buildConflictGeometry(runtime);
  return runtime;
}

function processConflictEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "CONFLICT") return;
  if (runtime.lifecycle === "spawning") { processEndingSpawnQueue(runtime, finishConflictSpawn); return; }
  if (runtime.lifecycle !== "active") return;
  const now = Instance.GetGameTime();
  // Nut never cleared JUMP_VELOCITY, so the crouch boost outlives the result.
  processConflictCrouchJump(runtime, now);
  if (runtime.ended) return;
  processConflictBoundary(runtime);
  processConflictTick(runtime, now);
}

function isMoonBoosting(pawn, now) {
  for (const [source, status] of state.playerStatuses.get(pawn) ?? []) {
    if (source.endsWith(":moonboosting") && status.until >= now) return true;
  }
  return false;
}

function processConflictCrouchJump(runtime, now) {
  for (const pawn of allLivingPawns()) {
    const pressed = Boolean(pawn.IsInputPressed?.(CSInputs.JUMP));
    const crouching = Boolean(pawn.IsInputPressed?.(CSInputs.DUCK));
    // Nut hooked player_jump, so only real ground jumps were boosted; the
    // previous-tick check covers the tick where the jump already left ground.
    const grounded = typeof pawn.GetGroundEntity === "function" ? Boolean(pawn.GetGroundEntity()) : true;
    const jumpedFromGround = grounded || runtime.jumpGrounded?.get(pawn) === true;
    runtime.jumpGrounded?.set(pawn, grounded);
    if (pressed && crouching && jumpedFromGround && !runtime.jumpPressed.get(pawn) && !isMoonBoosting(pawn, now)) {
      const velocity = pawn.GetAbsVelocity?.() ?? vec();
      pawn.Teleport?.({ velocity: vec(velocity.x, velocity.y, Math.max(velocity.z, runtime.crouchJump?.velocity ?? CONFLICT_CONFIG.jumpForce)) });
    }
    runtime.jumpPressed.set(pawn, pressed);
  }
}

function raceGridWorld(entry, incoming, entryCenter, x, y, elevation, entryElevation) {
  const forward = incoming;
  const left = leftOf(incoming);
  const longitudinal = (x - entryCenter.x) * RACE_CONFIG.gridSize;
  const lateral = (entryCenter.y - y) * RACE_CONFIG.gridSize;
  return add(
                                                                           
                                                                             
                                                                           
    add(entry, add(
      mul(forward, longitudinal + RACE_CONFIG.gridSize / 2),
      mul(left, lateral),
    )),
    vec(0, 0, (elevation - entryElevation) * CONFIG.elevationStep),
  );
}

function raceAllowedDirections(origin, incoming) {
                                                                         
                                                                            
  const east = vec(1, 0, 0), west = vec(-1, 0, 0);
  const north = vec(0, 1, 0), south = vec(0, -1, 0);
  let allowed = [];
  if (origin.x > RACE_CONFIG.edgeLimit) allowed.push(west);
  else if (origin.x < -RACE_CONFIG.edgeLimit) allowed.push(east);
  if (origin.y > RACE_CONFIG.edgeLimit) allowed.push(south);
  else if (origin.y < -RACE_CONFIG.edgeLimit) allowed.push(north);
  const opposite = direction => direction.x === -incoming.x && direction.y === -incoming.y;
  if (!allowed.length) {
    allowed.push(...(origin.x > RACE_CONFIG.edgeWarning ? [west]
      : origin.x < -RACE_CONFIG.edgeWarning ? [east] : [west, east]));
    allowed.push(...(origin.y > RACE_CONFIG.edgeWarning ? [south]
      : origin.y < -RACE_CONFIG.edgeWarning ? [north] : [south, north]));
  } else if (allowed.length === 1 && opposite(allowed[0])) {
    allowed = incoming.x !== 0 ? [origin.y > 0 ? south : north] : [origin.x > 0 ? west : east];
  }
  return allowed.filter(direction => !opposite(direction));
}

function raceCandidatePlan(level, runtime, incoming, mirrored = false) {
  if (!level || !["forward", "left", "right"].includes(level.direction)) return false;
  if (!Number.isFinite(level.cost) || level.cost < 0 || level.cost > 800) return false;
  if (!Number.isFinite(level.elevation)) return false;
  const origin = runtime.raceNextEntry ?? runtime.anchor;
  let rows;
  let markers;
  let elevations;
  let outgoing;
  let probe;
  if (Array.isArray(level.tiles) && level.tiles.length === CONFIG.mapSize * CONFIG.mapSize) {
                                                                             
                                                                          
                                                                      
                                           
    rows = tileRows(level, mirrored);
    markers = markerData(rows);
    elevations = entryExitElevations(rows, markers);
    outgoing = exitDirection(markers, incoming);
    probe = raceGridWorld(
      origin,
      incoming,
      markers.entryCenter,
      markers.exitCenter.x,
      markers.exitCenter.y,
      elevations.exit,
      elevations.entry,
    );
                                                                             
                                                                            
                                                                            
                           
    probe = add(probe, mul(outgoing, RACE_CONFIG.gridSize / 2));
  } else {
                                                                             
                                                                         
    outgoing = level.direction === "left"
      ? leftOf(incoming)
      : level.direction === "right"
        ? rightOf(incoming)
        : incoming;
    probe = add(origin, mul(outgoing, RACE_CONFIG.gridSize * RACE_CONFIG.stageBoxCells));
  }
                                                                          
                                                                              
                                                                          
                                          
  if (!runtime.raceAllowPreparationOverflow) {
    if (!raceAllowedDirections(origin, incoming).some(direction => direction.x === outgoing.x && direction.y === outgoing.y)) return false;
  }
  if (Math.abs(probe.z) > CONFIG.heightLimit) return false;
  return { level, mirrored, rows, markers, elevations, outgoing, entry: clone(origin), end: clone(probe) };
}

function raceCandidateWithinBounds(level, runtime, incoming, mirrored = false) {
  return Boolean(raceCandidatePlan(level, runtime, incoming, mirrored));
}

function chooseRaceLevel(runtime) {
  const incoming = runtime.raceNextIncoming ?? runtime.direction;
                                                                           
                                                                           
                                                                           
                                                                
  const pool = [];
  for (const level of RACE_LEVELS) {
    for (const mirrored of [false, true]) {
      const plan = raceCandidatePlan(level, runtime, incoming, mirrored);
      if (plan) pool.push(plan);
    }
  }
  runtime.raceCandidateCount = pool.length;
  if (pool.length === 0) {
    runtime.raceSelectionNote = "no authored RACE layout orientation satisfies the current bounds";
    throw new Error(runtime.raceSelectionNote);
  }
  const history = Array.isArray(runtime.raceHistory) ? runtime.raceHistory : [];
  const cooldown = Math.max(0, Math.min(
    Number.isFinite(RACE_CONFIG.selectionCooldown) ? RACE_CONFIG.selectionCooldown : 0,
    Math.max(0, RACE_LEVELS.length - 1),
  ));
  const recent = cooldown > 0 ? history.slice(-cooldown) : [];
  const recentIds = new Set(recent.map((entry) => String(entry?.id ?? entry?.name ?? "")));
  const planKey = (plan) => String(plan?.level?.id ?? plan?.level?.name ?? "");
  let selectionPool = pool.filter((plan) => !recentIds.has(planKey(plan)));
                                                                         
                                                                           
                                                              
  if (selectionPool.length === 0 && recent.length > 0) {
    const previousId = String(recent.at(-1)?.id ?? recent.at(-1)?.name ?? "");
    selectionPool = pool.filter((plan) => planKey(plan) !== previousId);
  }
  if (selectionPool.length === 0) selectionPool = pool;
  runtime.raceFreshCandidateCount = pool.filter((plan) => !recentIds.has(planKey(plan))).length;
  runtime.raceSelectionPoolCount = selectionPool.length;
  runtime.raceSelectionCooldown = cooldown;
  runtime.raceSelectionRecentIds = [...recentIds];
  const selected = selectionPool[Math.floor(Math.random() * selectionPool.length)];
  runtime.raceSelectionNote = `selected from ${selectionPool.length}/${pool.length} authored RACE layout orientations fresh=${runtime.raceFreshCandidateCount} cooldown=${cooldown}`;
  raceLog(
    runtime,
    `select incoming=${incoming.x},${incoming.y} pool=${pool.length} fresh=${runtime.raceFreshCandidateCount} `
      + `recent=${[...recentIds].join(",") || "none"} chosen=${selected.level.id ?? selected.level.name} mirror=${selected.mirrored ? 1 : 0}`,
  );
  return selected;
}

function raceLevelRecord(runtime, level, slot, mirrored, entry, incoming, rows, markers, elevations, outgoing, bufferCells = RACE_CONFIG.activeBuffer) {
  const index = `race:${runtime.sequence}:${slot}`;
  const exitPosition = add(
    raceGridWorld(entry, incoming, markers.entryCenter, markers.exitCenter.x, markers.exitCenter.y, elevations.exit, elevations.entry),
    mul(outgoing, RACE_CONFIG.gridSize / 2),
  );
  const left = leftOf(incoming);
  const span = RACE_CONFIG.gridSize * (RACE_CONFIG.stageBoxCells / 2);
                                                                          
                                                                             
                                                                            
                                                              
  const gridCenter = raceGridWorld(entry, incoming, markers.entryCenter, 9.5, 9.5, elevations.entry, elevations.entry);
  const minX = gridCenter.x - span;
  const maxX = gridCenter.x + span;
  const minY = gridCenter.y - span;
  const maxY = gridCenter.y + span;
  const record = {
    index, raceLevel: true, id: level.id, name: level.name, author: level.author,
    stageSnapshot: runtime.stageSnapshot, stageConfigSnapshot: runtime.stageSnapshot,
    themeSnapshot: runtime.stageSnapshot?.themeProfile, stage: runtime.stageSnapshot?.stage,
    stageLevel: 0, lifecycle: "queued", lifecycleHistory: ["queued"],
    mirrored, incoming: clone(incoming), outgoing: clone(outgoing), entry: clone(entry),
    end: clone(exitPosition),
                                                                             
                                                                              
                                                                            
                                                                 
    tp: add(add(entry, mul(incoming, -(bufferCells - 0.5) * RACE_CONFIG.gridSize)), vec(0, 0, 8)),
    buffer: bufferCells,
    center: clone(gridCenter), entities: new Set(), terrainEntities: new Set(),
    safeTerrainEntities: new Set(), outputConnections: new Set(), buttons: new Set(),
    breakables: new Set(), holds: new Map([[1, []], [2, []], [3, []], [4, []]]),
    teleportDestinations: new Map([[1, []], [2, []], [3, []], [4, []]]), teleportSources: new Set(),
    teleportEntries: new Set(),
    liquids: new Set(), liquidPawns: new Set(), movers: new Set(), traps: new Set(), trapCost: 0,
    items: new Set(), itemDeployables: new Set(), healOrbQueued: false, endProvider: "position",
    completed: false, remaining: 0, raceSlot: slot, raceOwner: runtime, raceProfile: runtime.raceProfile,
    bbox: { minX, maxX, minY, maxY }, slopeTemplateBlocked: false, disabledFeatures: new Set(),
    raceTileCounts: Object.create(null), raceShapeCounts: Object.create(null),
    raceSurfaceCounts: Object.create(null),
    raceFeatureCounts: Object.create(null), raceRequestCounts: Object.create(null),
    raceCoverage: new Map(), raceSkippedTiles: [], raceFeatureFallbacks: [],
    previewRows: rows.map((row) => row.slice()),
    raceBridgeLayerCells: [], raceBridgeLayerCount: 0,
    left,
  };
  state.levels.set(index, record);
  runtime.raceLevels ??= [];
  runtime.raceLevels.push(record);
  runtime.raceHistory ??= [];
  runtime.raceHistory.push({ id: level.id, name: level.name, slot, mirrored: Boolean(mirrored), entry: clone(entry), end: clone(exitPosition) });
  return record;
}

function enqueueRaceTerrain(runtime, record, shape, position, angles, tile) {
  enqueueSpawn(record, shape, position, angles);
  const request = state.spawnQueue.at(-1);
  if (request) {
    request.race = true;
    request.tile = tile;
    request.raceProfile = runtime.raceProfile;
    raceRequestContext(runtime, record, request, "terrain");
    raceCount(record, "raceShapeCounts", shape);
    if (["floor", "platform", "floorceiling", "tall"].includes(shape)) {
      const yaw = ((Math.round(normalizeYaw(angles?.yaw ?? yawOf(runtime.direction)) / 90) * 90) % 360 + 360) % 360;
      request.raceSurfaceKey = angles?.pitch === 10 ? `race_surface_slope_yaw${yaw}` : "race_surface_flat";
      raceCount(record, "raceSurfaceCounts", request.raceSurfaceKey);
                                                                         
                                                                         
                                                                         
      request.themeTerrainShape = "race_surface";
      request.terrainModel = chooseTerrainModel(request.themeName, "race_surface");
    }
  }
}

                                                                           
                                                                            
                                                                           
                                                                             
                                                                           
                                                                       
function enqueueRaceStartBridge(runtime, record, start, end, direction, amount) {
  const left = leftOf(direction);
  for (let step = 0; step < amount; step++) {
    const progress = (step + 0.5) / amount;
    const center = add(start, mul(sub(end, start), progress));
    for (const lane of [-1.5, -0.5, 0.5, 1.5]) {
      enqueueRaceTerrain(
        runtime,
        record,
        "platform",
        add(center, mul(left, lane * RACE_CONFIG.gridSize)),
        anglesFor(direction),
        185,
      );
      const request = state.spawnQueue.at(-1);
      if (request) {
        request.raceBridge = true;
        request.raceSurfaceKey = "race_surface_flat";
      }
    }
  }
  runtime.raceBridges ??= [];
  const bridge = {
    start: clone(start),
    end: clone(end),
    direction: clone(direction),
    lanes: 4,
    cells: amount,
    flat: true,
  };
  runtime.raceBridges.push(bridge);
  if (!runtime.raceStartBridge) runtime.raceStartBridge = bridge;
}

function enqueueRaceFeature(runtime, record, feature, position, angles, data = {}) {
  enqueueFeature(record, feature, position, angles, { ...data, race: true, raceProfile: runtime.raceProfile });
  const request = state.spawnQueue.at(-1);
  if (request) {
    request.race = true;
    raceRequestContext(runtime, record, request, "feature");
    raceCount(record, "raceFeatureCounts", feature);
  }
}

function buildRaceLevel(runtime, slot) {
  runtime.raceNextSlot ??= 0;
  if (slot === undefined || slot === null) slot = runtime.raceNextSlot;
  runtime.raceNextSlot = Math.max(runtime.raceNextSlot, slot + 1);
  const selection = chooseRaceLevel(runtime);
  const { level, mirrored, rows, markers, elevations, outgoing } = selection;
  const incoming = clone(runtime.raceNextIncoming ?? runtime.direction);
  const entry = clone(selection.entry ?? runtime.raceNextEntry ?? runtime.raceStart);
  const bufferCells = Number.isFinite(runtime.raceNextBuffer)
    ? runtime.raceNextBuffer
    : (slot < RACE_CONFIG.generateRequestTimes.length ? RACE_CONFIG.initialBuffer : RACE_CONFIG.activeBuffer);
  const record = raceLevelRecord(runtime, level, slot, mirrored, entry, incoming, rows, markers, elevations, outgoing, bufferCells);
                                                                           
                                                                        
                                                                          
  if (bufferCells > 0) {
    const bridgeStart = sub(entry, mul(incoming, bufferCells * RACE_CONFIG.gridSize));
    enqueueRaceStartBridge(
      runtime,
      record,
      bridgeStart,
      entry,
      incoming,
      RACE_CONFIG.initialBuffer,
    );
  }
  if (!runtime.raceStarted && record.raceSlot >= 0) {
                                                                            
                                                                            
                                                          
    moveTeleportDestination(record.tp, record.incoming);
    runtime.raceTeleportStart = clone(record.tp);
    runtime.raceStartRecord = record;
  }
  for (let y = 0; y < CONFIG.mapSize; y++) {
    for (let x = 0; x < CONFIG.mapSize; x++) {
      const tile = rows[y][x];
      if (tile === 0) continue;
      runtime.raceBuildCell = { x, y, tile };
      raceCount(record, "raceTileCounts", tile);
      const nearest = nearestFloor(rows, x, y);
      const feature = featureKind(tile);
      const elevation = feature ? sourceNeighborElevation(rows, x, y) : nearest.elevation;
      const position = raceGridWorld(entry, incoming, markers.entryCenter, x, y, elevation, elevations.entry);
                                                                           
                                                                            
                                                                        
      if (feature && !["item", "trap"].includes(feature)) {
        try {
          if (feature === "liquid") {
            const liquid = liquidTileData(tile, incoming, mirrored, "generic", rows, x, y, elevation);
                                                                            
                                                                            
                                        
            const surfaceElevation = liquid.fall ? (Number.isFinite(liquid.waterfall?.elevation) ? liquid.waterfall.elevation : elevation)
              : liquidSurfaceElevation(rows, x, y);
            const liquidPosition = add(position, vec(0, 0, (surfaceElevation - elevation) * CONFIG.elevationStep));
            const surface = add(liquidPosition, vec(0, 0, -8));
                                                                        
                                                                            
                                                       
            const fallBottom = liquid.fall
              ? waterfallBottomPlan(liquid.waterfall, position, elevation, incoming, mirrored, "generic")
              : undefined;
            if (fallBottom) {
              enqueueRaceTerrain(runtime, record, "floor", fallBottom.floorPosition, anglesFor(incoming), tile);
              enqueueRaceFeature(runtime, record, feature, fallBottom.liquidPosition, fallBottom.liquid.visualAngles,
                { tile: liquid.waterfall.bottom.tile, mirrored, ...fallBottom.liquid });
            }
            const liquidAngles = liquid.visualAngles;
            enqueueRaceFeature(runtime, record, feature, surface, liquidAngles, { tile, mirrored, ...liquid });
          } else if (feature === "ladder" || feature === "climb") {
                                                                              
                                                                              
                                                                        
            const placement = climbPlacement(rows, x, y, incoming, entry, markers.entryCenter, elevations.entry, Math.random, raceGridWorld);
            if (placement.spawnBaseFloor) {
              enqueueRaceTerrain(
                runtime,
                record,
                placement.baseFamily,
                placement.floorPosition,
                anglesFor(incoming),
                tile,
              );
            }
            if (placement.floorOnly) continue;
            enqueueRaceFeature(runtime, record, feature, placement.position, placement.angles, {
              tile,
              surfaceAngles: placement.surfaceAngles,
              height: 20 * CONFIG.elevationStep,
            });
          } else {
            const featureAngles = feature === "boost" ? boostFeatureAngles(tile, incoming, mirrored) : anglesFor(incoming);
            const baseFamily = tileFamily(nearest.tile, rows, x, y) || "platform";
                                                                            
                                                                             
                                                                          
                                                                               
                                                                               
            if (feature !== "elevator" && !(feature === "trap" && tile === 85) && tile !== 147) {
              enqueueRaceTerrain(
                runtime,
                record,
                isFloorFamily(baseFamily) ? baseFamily : "platform",
                position,
                anglesFor(incoming),
                tile,
              );
            }
            if (feature === "elevator") {
              enqueueRaceFeature(runtime, record, feature, position, featureAngles, {
                tile, mirrored, destination: add(position, vec(0, 0, CONFIG.elevationStep)),
                horizontal: false, fallback: false, model: "models/luffaren/collective_elevatorbig.vmdl",
              });
            } else {
              enqueueRaceFeature(runtime, record, feature, position, featureAngles, { tile, mirrored, team: tile === 93 ? 3 : 2 });
            }
          }
        } catch (error) {
          record.disabledFeatures.add(feature);
          record.raceFeatureFallbacks.push({ x, y, tile, feature, error: String(error) });
          runtime.raceDiagnostics ??= [];
          runtime.raceDiagnostics.push(`feature ${feature} at ${x},${y} fell back to floor: ${error}`);
        }
        if (!record.disabledFeatures.has(feature)) continue;
      } else if (feature) {
        record.disabledFeatures.add(feature);
      }
      let family = tileFamily(tile, rows, x, y) || tileFamily(nearest.tile, rows, x, y) || "platform";
      if (!isFloorFamily(family) && family !== "wall" && family !== "hiddenwall" && family !== "detail") family = "platform";
      if (tile === 185) {
        const bridgeElevations = racePlatformBridgeElevations(rows, x, y);
        record.raceBridgeLayerCells.push({ x, y, tile, elevations: [...bridgeElevations] });
        record.raceBridgeLayerCount += bridgeElevations.length;
        for (const bridgeElevation of bridgeElevations) {
          enqueueRaceTerrain(
            runtime,
            record,
            "platform",
            raceGridWorld(entry, incoming, markers.entryCenter, x, y, bridgeElevation, elevations.entry),
            anglesFor(incoming),
            tile,
          );
        }
        continue;
      }
      if (isFloorFamily(family) && blockedByFloorMarker(rows, x, y)) {
        record.raceSkippedTiles.push({ x, y, tile, reason: "floor-marker" });
        continue;
      }
      const explicit = explicitElevation(tile);
      let terrainPosition = position;
      let terrainAngles = anglesFor(incoming);
      if (isFloorFamily(family) && explicit !== undefined) {
        const slope = slopeShape(family, rows, x, y, explicit, incoming, terrainAngles);
        if (slope.shape.includes("_slope")) {
          record.slopeTemplateBlocked = true;
          runtime.raceSlopeNote = "RACE slopes require pre-baked pitch10/z+14 templates; runtime rotation is not reliable";
          family = family;
          terrainAngles = { pitch: 10, yaw: slope.angles.yaw, roll: 0 };
          terrainPosition = add(position, vec(0, 0, 14));
        }
      }
      enqueueRaceTerrain(runtime, record, family, terrainPosition, terrainAngles, tile);
    }
  }
  runtime.raceBuildCell = undefined;
  const coverageGaps = [];
  for (let y = 0; y < CONFIG.mapSize; y++) {
    for (let x = 0; x < CONFIG.mapSize; x++) {
      const tile = rows[y][x];
      if (tile === 0) continue;
      if (!record.raceCoverage.has(raceCellKey(x, y))) {
        const skipped = record.raceSkippedTiles.find((entry) => entry.x === x && entry.y === y);
        coverageGaps.push({ x, y, tile, reason: skipped?.reason ?? "no-request" });
      }
    }
  }
  record.raceCoverageGaps = coverageGaps;
  record.raceEmptyTileCount = rows.flat().filter((tile) => tile === 0).length;
  const nonzeroTileCount = CONFIG.mapSize * CONFIG.mapSize - record.raceEmptyTileCount;
  const shapeSummary = Object.entries(record.raceShapeCounts).map(([key, count]) => `${key}:${count}`).join(",") || "none";
  const surfaceSummary = Object.entries(record.raceSurfaceCounts).map(([key, count]) => `${key}:${count}`).join(",") || "none";
  const featureSummary = Object.entries(record.raceFeatureCounts).map(([key, count]) => `${key}:${count}`).join(",") || "none";
  const tileSummary = Object.entries(record.raceTileCounts).map(([key, count]) => `${key}:${count}`).join(",") || "none";
  raceLog(
    runtime,
    `map slot=${slot} id=${level.id} name="${level.name}" author="${level.author}" `
      + `mirror=${mirrored ? 1 : 0} incoming=${incoming.x},${incoming.y} outgoing=${outgoing.x},${outgoing.y} `
      + `buffer=${record.buffer} entry=${record.entry.x},${record.entry.y},${record.entry.z} tp=${record.tp.x},${record.tp.y},${record.tp.z} `
      + `queued=${record.remaining} nonzero=${nonzeroTileCount} empty(tile0)=${record.raceEmptyTileCount} `
      + `skipped=${record.raceSkippedTiles.length} gaps=${coverageGaps.length} `
      + `bridges=${record.raceBridgeLayerCount} tiles[${tileSummary}] shapes[${shapeSummary}] `
      + `surfaces[${surfaceSummary}] features[${featureSummary}]`,
  );
  if (record.raceFeatureFallbacks.length > 0) {
    for (const fallback of record.raceFeatureFallbacks) {
      raceLog(runtime, `map slot=${slot} feature-fallback cell=${fallback.x},${fallback.y} tile=${fallback.tile} feature=${fallback.feature} error=${fallback.error}`);
    }
  }
  for (const bridge of record.raceBridgeLayerCells.filter((entry) => entry.elevations.length > 1).slice(0, 96)) {
    raceLog(runtime, `map slot=${slot} bridge-layers cell=${bridge.x},${bridge.y} elevations=${bridge.elevations.join("/")}`);
  }
  if (coverageGaps.length > 0) {
    const detailLimit = 96;
    for (const gap of coverageGaps.slice(0, detailLimit)) {
      raceLog(runtime, `map slot=${slot} MISSING cell=${gap.x},${gap.y} tile=${gap.tile} reason=${gap.reason}`);
    }
    if (coverageGaps.length > detailLimit) {
      raceLog(runtime, `map slot=${slot} MISSING ... ${coverageGaps.length - detailLimit} more cells`);
    }
  }
  runtime.raceNextEntry = add(record.end, mul(outgoing, (runtime.raceNextBuffer ?? RACE_CONFIG.activeBuffer) * RACE_CONFIG.gridSize));
  runtime.raceNextIncoming = clone(outgoing);
  runtime.raceNextBuffer = runtime.raceProfile.activeBuffer;
  record.raceSpawnQueuedAt = Instance.GetGameTime();
  runtime.raceLevelBuilds ??= [];
  runtime.raceLevelBuilds.push({ slot, record, queued: record.remaining, requestedAt: runtime.runStartedAt + RACE_CONFIG.generateRequestTimes[slot] });
  return record;
}

function completeRaceLevelSpawn(record) {
  if (!record?.raceLevel || record.remaining !== 0 || record.lifecycle === "active") return;
  closeBlockSpawnSafety(record);
  const runtime = record.raceOwner;
  record.lifecycle = "active";
  record.lifecycleHistory?.push?.("active");
  record.spawnCompletedAt = Instance.GetGameTime();
  updateTerrainPreviewHud(record, "race-spawn-complete");
  raceLog(
    runtime,
    `map slot=${record.raceSlot} id=${record.id} name="${record.name}" spawn-complete `
      + `buffer=${record.buffer} tp=${record.tp?.x ?? "?"},${record.tp?.y ?? "?"},${record.tp?.z ?? "?"} `
      + `entities=${record.entities?.size ?? 0} queued=${record.remaining} gaps=${record.raceCoverageGaps?.length ?? 0}`,
  );
  if (!runtime || runtime.lifecycle !== "active") return;
  if (record.checkoutRequest) finalizeRaceCheckout(runtime, record.checkoutRequest, record);
  if (!runtime.raceCurrentLevel || (record.raceSlot ?? -1) >= (runtime.raceCurrentLevel.raceSlot ?? -1)) {
    runtime.raceCurrentLevel = record;
    runtime.raceFinish = clone(record.end);
    runtime.raceStageBBox = { ...record.bbox };
    runtime.raceCheckoutCurrentLevel = record;
  }
}

function finalizeRaceCheckout(runtime, request, record) {
  if (!runtime || !request || !record || request.committedAt !== undefined) return;
  runtime.raceCurrentLevel = record;
  runtime.raceFinish = clone(record.end);
  runtime.raceStageBBox = { ...record.bbox };
  runtime.raceCheckoutCurrentLevel = record;
  request.committedAt = Instance.GetGameTime();
  request.commitPending = false;
  if (runtime.checkoutPending === request) runtime.checkoutPending = undefined;
  runtime.checkoutCommits = (runtime.checkoutCommits ?? 0) + 1;
  runtime.raceCheckoutHistory ??= [];
  runtime.raceCheckoutHistory.push({ ...request, record });
  runtime.checkoutLast = request;
  runtime.checkoutCommittedBeforeCleanup = true;
  while ((runtime.raceLevels?.length ?? 0) > RACE_CONFIG.checkoutHistory) {
    const old = runtime.raceLevels.shift();
    if (!old || old === runtime.raceCurrentLevel) break;
    destroyEntities(old.entities ?? []);
    state.spawnQueue = state.spawnQueue.filter((entry) => entry.levelIndex !== old.index);
    state.levels.delete(old.index);
  }
}

function raceSetCollisionGroup(entity, group) {
  if (!validEntity(entity)) return false;
  const value = String(group);
  const applied = fireTarget(entity, "SetCollisionGroup", value);
  try { entity.__raceCollisionGroup = group; } catch {                             }
  return applied !== false;
}

function raceConfigureFallingDebris(entity, collisionGroup = RACE_CONFIG.fallCollisionGroup) {
  if (!validEntity(entity)) return false;
                                                                              
                                                                       
                                                                             
  raceSetCollisionGroup(entity, collisionGroup);
  let applied = false;
  try {
    if (typeof entity.SetSolid === "function") {
      entity.SetSolid(RACE_CONFIG.fallSolid);
      applied = true;
    }
  } catch {                                  }
  if (!applied) fireTarget(entity, "SetSolid", String(RACE_CONFIG.fallSolid), 0.02);
  try {
    entity.__raceSolid = RACE_CONFIG.fallSolid;
    entity.__racePlayerCollision = false;
    entity.__raceTerrainCollision = true;
  } catch {                             }
  return true;
}

function raceConfigureKinematicKartBody(controller) {
  const body = controller?.body;
  if (!controller?.kinematic || !validEntity(body)) return false;
                                                                         
                                                                            
                                                                    
                                                                              
                                                                            
                                                                          
                                                                       
  raceSetCollisionGroup(body, controller.collisionGroup ?? RACE_CONFIG.raceCollisionGroup);
  let applied = false;
  try {
    if (typeof body.SetSolid === "function") {
      body.SetSolid(0);
      applied = true;
    }
  } catch {                                  }
  if (!applied) fireTarget(body, "SetSolid", "0");
  try {
    body.__raceSolid = 0;
    body.__racePlayerCollision = false;
    body.__raceTerrainCollision = true;
    body.__raceTerrainCollisionMode = "tracebox";
  } catch {                             }
  controller.bodySolid = 0;
  controller.playerCollision = false;
  controller.terrainCollision = true;
  controller.terrainCollisionMode = "tracebox";
  return true;
}

function setRacePawnControlLocked(pawn, locked) {
  if (!validEntity(pawn)) return false;
  // CS2 CSMoveType: NONE=0, WALK=1, FLYGRAVITY=2 (not the Source 1 numbering).
  const moveType = locked ? 0 : 1;
  let applied = false;
  try {
    if (typeof pawn.SetMoveType === "function") {
      pawn.SetMoveType(moveType);
      applied = true;
    }
  } catch {                                         }
                                                                             
                                                                             
                                                                        
  if (!applied) fireTarget(pawn, "SetMoveType", String(moveType));
  pawn.Teleport?.({ velocity: vec() });
  return true;
}

function lockRacePreparationPlayers(runtime, moveToStash = false) {
  if (!runtime || runtime.lifecycle !== "active") return;
  runtime.preRaceFrozenPawns ??= new Set();
  runtime.stashedPlayers ??= [];
  for (const pawn of allLivingPawns()) {
    const team = pawn.GetTeamNumber?.();
    if (team !== 2 && team !== 3) continue;
    if (!runtime.preRaceFrozenPawns.has(pawn)) {
      fireTarget(pawn, "ClearParent", "");
      runtime.preRaceFrozenPawns.add(pawn);
      setRacePawnControlLocked(pawn, true);
    } else {
                                                                  
      pawn.Teleport?.({ velocity: vec() });
    }
    if (!moveToStash || runtime.stashedPlayers.some((entry) => entry.pawn === pawn)) continue;
    const side = Math.random() * 2000 - 1000;
    const position = vec(team === 3 ? 16000 : -16000, side, 15800);
    pawn.Teleport?.({ position, velocity: vec() });
    runtime.stashedPlayers.push({ pawn, team, position: clone(position), unparented: true, frozen: true });
  }
}

function releaseRacePreparationPlayers(runtime) {
  for (const pawn of runtime?.preRaceFrozenPawns ?? []) setRacePawnControlLocked(pawn, false);
  runtime?.preRaceFrozenPawns?.clear?.();
}

function enableRaceKartMotion(controller, at = Instance.GetGameTime()) {
  if (!controller || controller.motionEnabledAt !== undefined) return false;
                                                                      
                                                              
  if (controller.kinematic) {
    raceConfigureKinematicKartBody(controller);
    fireTarget(controller.body, "DisableMotion", "");
    fireTarget(controller.body, "SetVelocity", "0 0 0");
    fireTarget(controller.body, "SetAngularVelocity", "0 0 0");
    controller.body?.Teleport?.({ velocity: vec() });
    controller.motionEnabledAt = at;
    controller.motionReleaseCount = (controller.motionReleaseCount ?? 0) + 1;
    controller.motionMode = "kinematic";
    return true;
  }
  if (validEntity(controller.body)) {
    raceSetCollisionGroup(controller.body, controller.collisionGroup ?? RACE_CONFIG.raceCollisionGroup);
                                                                           
                                                                           
                                                                        
    fireTarget(controller.body, "SetVelocity", "0 0 0");
    fireTarget(controller.body, "SetAngularVelocity", "0 0 0");
    controller.body.Teleport?.({ velocity: vec() });
    fireTarget(controller.body, "EnableMotion", "");
    fireTarget(controller.body, "Wake", "");
  }
  controller.motionEnabledAt = at;
  controller.motionEnableCount = (controller.motionEnableCount ?? 0) + 1;
  controller.motionMode = "physics";
  return true;
}

function kartBodyOrigin(controller) {
  return controller?.body?.GetAbsOrigin?.() ?? controller?.position;
}

function raceKartGroundPosition(position, ignoreEntity) {
  if (!position || typeof Instance.TraceLine !== "function") return undefined;
  try {
    const trace = Instance.TraceLine({
      start: add(position, vec(0, 0, 128)),
      end: add(position, vec(0, 0, -256)),
      ignoreEntity,
      ignorePlayers: true,
    });
    const end = trace?.position ?? trace?.end;
    if (
      (trace?.didHit ?? trace?.hit)
      && end
      && Number.isFinite(end.z)
      && end.z >= position.z - 128
      && end.z <= position.z + 16
    ) return clone(end);
  } catch {                                                 }
  return undefined;
}

function raceKinematicSupport(controller, origin, expectedGroundZ, runtime) {
  if (!origin) return { grounded: false, traceAvailable: false };
                                                                            
                                                                           
                                                                             
                                                                            
                      
  if (typeof Instance.TraceLine === "function") {
    try {
      const trace = Instance.TraceLine({
        start: add(origin, vec(0, 0, RACE_CONFIG.supportTraceTop)),
        end: add(origin, vec(0, 0, -RACE_CONFIG.supportTraceBottom)),
        ignoreEntity: raceKartTraceIgnoreEntities(runtime, controller),
        ignorePlayers: true,
      });
      const didHit = trace?.didHit ?? trace?.hit;
      if (didHit !== undefined) {
        if (!didHit) return { grounded: false, traceAvailable: true };
        const end = trace.position ?? trace.end;
        if (!end || !Number.isFinite(end.z)) return { grounded: false, traceAvailable: true };
        const supportOffset = Number.isFinite(controller?.supportOffsetZ)
          ? controller.supportOffsetZ
          : KART_CONFIG.endingSpawnZOffset;
        const previousGround = Number.isFinite(expectedGroundZ)
          ? expectedGroundZ
          : Number.isFinite(controller?.supportGroundZ)
            ? controller.supportGroundZ
            : origin.z - supportOffset;
        const delta = end.z - previousGround;
        if (delta > RACE_CONFIG.supportMaxStepUp || delta < -RACE_CONFIG.supportMaxStepDown) {
                                                                              
                                                                       
          return { grounded: false, traceAvailable: true, groundZ: end.z };
        }
        return {
          grounded: true,
          traceAvailable: true,
          groundZ: end.z,
          bodyZ: end.z + supportOffset,
        };
      }
    } catch {                                           }
  }
  try {
    if (typeof controller?.body?.GetGroundEntity === "function") {
      return { grounded: !!controller.body.GetGroundEntity(), traceAvailable: false };
    }
  } catch {                                                  }
  try {
    if (typeof controller?.pawn?.GetGroundEntity === "function") {
      return { grounded: !!controller.pawn.GetGroundEntity(), traceAvailable: false };
    }
  } catch {                                                  }
                                                                             
                                                                            
  return { grounded: true, traceAvailable: false };
}

function raceKinematicLandingSupport(controller, origin, runtime) {
  if (!origin || typeof Instance.TraceLine !== "function") return { grounded: false, traceAvailable: false };
  try {
    const trace = Instance.TraceLine({
      start: add(origin, vec(0, 0, RACE_CONFIG.supportTraceTop)),
      end: add(origin, vec(0, 0, -RACE_CONFIG.landingTraceBottom)),
      ignoreEntity: raceKartTraceIgnoreEntities(runtime, controller),
      ignorePlayers: true,
    });
    const didHit = trace?.didHit ?? trace?.hit;
    const end = trace?.position ?? trace?.end;
    if (!didHit || !end || !Number.isFinite(end.z)) {
      return { grounded: false, traceAvailable: true };
    }
                                                                          
                                                                             
                                                                              
    if (trace.normal && Number.isFinite(trace.normal.z) && trace.normal.z < RACE_CONFIG.kartWalkableNormalZ) {
      return { grounded: false, traceAvailable: true };
    }
    const supportOffset = Number.isFinite(controller?.supportOffsetZ)
      ? controller.supportOffsetZ
      : KART_CONFIG.endingSpawnZOffset;
    return {
      grounded: true,
      traceAvailable: true,
      groundZ: end.z,
      bodyZ: end.z + supportOffset,
    };
  } catch {
    return { grounded: false, traceAvailable: true };
  }
}


function raceKartTraceIgnoreEntities(runtime, controller) {
  const now = Instance.GetGameTime?.();
  let ignored = [];
  if (runtime?.raceTraceIgnoreCacheAt === now && Array.isArray(runtime.raceTraceIgnoreCache)) {
    ignored = runtime.raceTraceIgnoreCache;
  } else if (runtime) {
    const seen = new Set();
    const addIgnored = (entity) => {
      if (!validEntity(entity) || seen.has(entity)) return;
      seen.add(entity);
      ignored.push(entity);
    };
                                                                              
                                                                                
                                                                               
                                                                               
    for (const kart of runtime.karts?.values?.() ?? []) addIgnored(kart?.body);
    for (const piece of runtime.rubblePieces ?? []) {
      if (piece?.expired) continue;
      addIgnored(piece?.visual);
    }
    runtime.raceTraceIgnoreCacheAt = now;
    runtime.raceTraceIgnoreCache = ignored;
  }
  const body = controller?.body;
  if (validEntity(body) && !ignored.includes(body)) return [...ignored, body];
  return ignored;
}

function traceRaceKartHullWorld(start, end, controller, runtime) {
  if (!start || !end) return undefined;
  const ignored = raceKartTraceIgnoreEntities(runtime, controller);
  const traceConfig = {
    start,
    end,
                                                                             
                                                                            
                                                 
    ignoreEntity: ignored,
    ignorePlayers: true,
  };
  let trace;
  try {
    if (typeof Instance.TraceBox === "function") {
      trace = Instance.TraceBox({
        ...traceConfig,
        mins: RACE_CONFIG.kartHullMins,
        maxs: RACE_CONFIG.kartHullMaxs,
      });
    }
  } catch {
    return undefined;
  }
  if (!trace) return undefined;
  const didHit = trace.didHit ?? trace.hit ?? false;
  return {
    didHit: Boolean(didHit),
    position: clone(trace.position ?? trace.end ?? (didHit ? start : end)),
    normal: trace.normal ?? trace.hitNormal,
    hitEntity: trace.hitEntity,
  };
}

function raceKartCollisionResponse(base, nextPosition, collision, controller, verticalVelocity, now) {
  if (!collision?.didHit) return { position: nextPosition, verticalVelocity, horizontalHit: false, verticalHit: false };
  const normal = collision.normal;
  const hasNormal = normal
    && Number.isFinite(normal.x)
    && Number.isFinite(normal.y)
    && Number.isFinite(normal.z);
  if (!hasNormal) {
    controller.speed = 0;
    controller.wallCollisionCount = (controller.wallCollisionCount ?? 0) + 1;
    controller.lastWallCollisionAt = now;
    return { position: clone(collision.position ?? base), verticalVelocity: 0, horizontalHit: true, verticalHit: false };
  }
  const horizontalNormal = Math.hypot(normal.x, normal.y);
  const walkable = normal.z >= RACE_CONFIG.kartWalkableNormalZ;
  const verticalHit = Math.abs(normal.z) >= RACE_CONFIG.kartWalkableNormalZ
    && ((normal.z > 0 && verticalVelocity < 0) || (normal.z < 0 && verticalVelocity > 0));
                                                                           
                                                                            
                                                                          
  if (walkable && normal.z > 0 && verticalVelocity < -1) {
    const contact = collision.position ?? base;
    return {
      position: add(contact, mul(normal, RACE_CONFIG.kartCollisionClearance)),
      verticalVelocity: 0,
      horizontalHit: false,
      verticalHit: true,
      landing: true,
    };
  }
                                                                             
                                                                              
  if (walkable && !verticalHit) return { position: nextPosition, verticalVelocity, horizontalHit: false, verticalHit: false };
  if (horizontalNormal <= 0.25 && !verticalHit) return { position: nextPosition, verticalVelocity, horizontalHit: false, verticalHit: false };
  const contact = collision.position ?? base;
  const clearance = horizontalNormal > 0.25 ? RACE_CONFIG.kartWallClearance : RACE_CONFIG.kartCollisionClearance;
  const position = add(contact, mul(normal, clearance));
  if (verticalHit) verticalVelocity = 0;
  if (verticalHit && normal.z > 0) controller.supportGroundZ = position.z - (controller.supportOffsetZ ?? KART_CONFIG.endingSpawnZOffset);
  if (horizontalNormal > 0.25) {
                                                                            
                                                                            
                                                                    
    const drive = vec(
      Math.cos((controller.heading ?? 0) * Math.PI / 180) * (controller.speed ?? 0),
      Math.sin((controller.heading ?? 0) * Math.PI / 180) * (controller.speed ?? 0),
      0,
    );
    const intoWall = drive.x * normal.x + drive.y * normal.y;
    const tangent = sub(drive, vec(normal.x * intoWall, normal.y * intoWall, 0));
    const tangentLength = Math.hypot(tangent.x, tangent.y);
    if (tangentLength > 1) {
      controller.heading = Math.atan2(tangent.y, tangent.x) * 180 / Math.PI;
      controller.speed = Math.min(Math.max(tangentLength, RACE_CONFIG.wallSlideSpeed), RACE_CONFIG.maximumSpeed);
    } else {
      const side = vec(-normal.y, normal.x, 0);
      controller.heading = Math.atan2(side.y, side.x) * 180 / Math.PI;
      controller.speed = Math.min(Math.max(controller.speed ?? 0, RACE_CONFIG.wallSlideSpeed), RACE_CONFIG.maximumSpeed);
    }
    controller.wallCollisionCount = (controller.wallCollisionCount ?? 0) + 1;
    controller.lastWallCollisionAt = now;
  }
  return { position, verticalVelocity, horizontalHit: horizontalNormal > 0.25, verticalHit };
}

function raceKinematicGrounded(controller, origin, runtime) {
  return raceKinematicSupport(controller, origin, undefined, runtime).grounded;
}

function syncRaceKinematicKart(controller, position, bodyAngles) {
  if (!controller || !position) return false;
  controller.position = clone(position);
  const bodyVelocity = vec();
  controller.body?.Teleport?.({ position, angles: bodyAngles, velocity: bodyVelocity });
  if (controller.visual && controller.visual !== controller.body) {
    controller.visual.Teleport?.({
      position,
      angles: { pitch: 0, yaw: normalizeYaw((bodyAngles?.yaw ?? controller.heading) + KART_CONFIG.visualYawOffset), roll: 0 },
      velocity: bodyVelocity,
    });
  }
  const pawn = controller.rider ?? controller.pawn;
  if (validEntity(pawn)) {
    const seat = add(position, vec(0, 0, kartRiderLocalZ(controller)));
                                                                               
                                                                         
                                                                           
                                                                          
    pawn.Teleport?.({
      position: seat,
      velocity: bodyVelocity,
    });
    controller.riderSyncedAt = Instance.GetGameTime();
    controller.riderSyncedPosition = clone(seat);
  }
  return true;
}

function kartParentRider(controller) {
  const body = controller.body;
  const rider = controller.rider;
  if (!validEntity(body) || !validEntity(rider)) return false;
                                                                             
                                                                          
                                                                               
                                                            
  controller.manualRiderSync = true;
  controller.parentUnsupported = true;
  controller.parentNote = "CS2 physics kart uses deterministic manual rider synchronization";
  controller.parentHook = "manual_body_seat_sync";
  controller.parented = false;
  return false;
}

function pawnHasOtherKart(pawn, except) {
  for (const runtime of activeRuntimes()) {
    for (const kart of runtime.traps ?? []) {
      if (kart !== except && kart?.name === "kart" && kart.rider === pawn && !kart.spent) return true;
    }
    for (const kart of runtime.karts?.values?.() ?? []) {
      if (kart !== except && kart.rider === pawn && !kart.spent) return true;
    }
  }
  return false;
}

function kartMount(controller, pawn, now = Instance.GetGameTime()) {
  if (!controller || controller.spent || controller.exploded || !validEntity(pawn) || !pawn.IsAlive?.()) return false;
  if (validEntity(controller.rider) && controller.rider.IsAlive?.()) return controller.rider === pawn;
  if (now < (controller.mountReadyAt ?? 0)) return false;
  if (pawnHasOtherKart(pawn, controller)) return false;
  controller.pawn = pawn;
  controller.rider = pawn;
  controller.team = pawn.GetTeamNumber?.();
  controller.driving = !controller.frozen;
                                                                       
                                                                     
  controller.previousBodyOwner = controller.body?.GetOwner?.();
  controller.body?.SetOwner?.(pawn);
  const bodyPosition = kartBodyOrigin(controller) ?? controller.position;
  const seatPosition = add(bodyPosition, vec(0, 0, kartRiderLocalZ(controller)));
  pawn.Teleport?.({ position: seatPosition, angles: { pitch: KART_CONFIG.riderStartPitch, yaw: controller.heading, roll: 0 }, velocity: vec() });
  setRacePawnControlLocked(pawn, true);
  kartParentRider(controller);
  controller.mountedAt = now;
  controller.riderLocalOffset = vec(0, 0, kartRiderLocalZ(controller));
  return true;
}

function kartDismount(controller, now = Instance.GetGameTime(), moveRider = true) {
  const rider = controller?.rider;
  if (!validEntity(rider)) {
    if (controller) {
      if (validEntity(controller.body)) controller.body.SetOwner?.(controller.previousBodyOwner);
      controller.previousBodyOwner = undefined;
      controller.rider = undefined;
      controller.pawn = undefined;
      controller.team = undefined;
      controller.driving = false;
    }
    return false;
  }
  fireTarget(rider, "ClearParent", "");
  controller.body?.SetOwner?.(controller.previousBodyOwner);
  controller.previousBodyOwner = undefined;
  try { rider.SetParent?.(undefined); } catch {                                 }
  setRacePawnControlLocked(rider, false);
  if (moveRider) {
    const bodyPosition = kartBodyOrigin(controller) ?? rider.GetAbsOrigin?.();
    if (bodyPosition) rider.Teleport?.({ position: add(bodyPosition, vec(0, 0, KART_CONFIG.dismountZOffset)), velocity: vec() });
  }
  controller.rider = undefined;
  controller.pawn = undefined;
  controller.team = undefined;
  controller.driving = false;
  controller.parented = false;
  controller.mountReadyAt = now + KART_CONFIG.mountCooldown;
  controller.dismountedAt = now;
  return true;
}

function cleanupKartController(runtime, controller, killRider = false) {
  if (!controller || controller.cleaned) return;
  const rider = controller.rider ?? controller.pawn;
  if (killRider && validEntity(rider)) raceKillPawn(rider);
  kartDismount(controller, Instance.GetGameTime(), false);
  if (controller.visualParented && validEntity(controller.visual)) {
    fireTarget(controller.visual, "ClearParent", "");
    try { controller.visual.SetParent?.(undefined); } catch {                                  }
    controller.visualParented = false;
  }
  for (const entity of new Set([controller.body, controller.visual])) {
    if (entity === controller.body && validEntity(entity)) fireTarget(entity, "DisableMotion", "");
    if (validEntity(entity)) entity.Kill?.();
    runtime?.entities?.delete?.(entity);
  }
  controller.spent = true;
  controller.cleaned = true;
}

function applyKartVisualPose(controller) {
  const visual = controller?.visual;
  if (!validEntity(visual)) return false;
  const apply = () => {
    if (!validEntity(visual)) return;
    fireTarget(visual, "SetAnimation", KART_CONFIG.idleAnimation);
    fireTarget(visual, "SetDefaultAnimation", KART_CONFIG.idleAnimation, 0.01);
  };
  apply();
                                                                            
                                                                           
                                                                   
  afterThink(apply);
  controller.visualAnimation = KART_CONFIG.idleAnimation;
  controller.visualPoseApplied = true;
  return true;
}

function queueKartCollisionFilter(controller) {
  const body = controller?.body;
  const pair = Instance.FindEntityByName?.("collective_kart_collision_pair");
  if (!validEntity(body) || !validEntity(pair) || typeof body.SetEntityName !== "function") {
    if (state.kartCollisionPairWarningRound !== state.roundBootstrapSerial) {
      state.kartCollisionPairWarningRound = state.roundBootstrapSerial;
      message("[KART] native collision pair unavailable; kart-to-kart filtering is not applied");
    }
    return false;
  }
                                                                           
                                                                           
  body.SetEntityName("collective_kart_physics");
  controller.collisionPairRequested = true;
                                                                              
                                                             
  if (state.kartCollisionFilterPending) return true;
  const token = { round: state.roundBootstrapSerial };
  state.kartCollisionFilterPending = token;
  afterThink(() => {
    if (state.kartCollisionFilterPending !== token) return;
    state.kartCollisionFilterPending = undefined;
    if (token.round !== state.roundBootstrapSerial || !state.running || state.fatal || !validEntity(pair)) return;
                                                                            
                                                                             
    fireTarget(pair, "DisableCollisionsWith", "collective_kart_physics");
  });
  return true;
}

function spawnKartController(runtime, position, angles, options = {}) {
  const mode = options.mode === "ending" ? "ending" : "normal";
  const templateKey = state.featureTemplates.has(RACE_CONFIG.kartTemplateKey) ? RACE_CONFIG.kartTemplateKey : "trap_kart";
  const physicsTemplateAvailable = templateKey === RACE_CONFIG.kartTemplateKey;
  if (!physicsTemplateAvailable) throw new Error("Physical kart requires template_race_kart");
                                                                       
                                                                            
                                                    
  const spawnZOffset = mode === "ending" ? KART_CONFIG.endingSpawnZOffset : KART_CONFIG.normalSpawnZOffset;
  const ground = undefined;
  const spawnPosition = add(position, vec(0, 0, spawnZOffset));
  const spawned = spawnRoundEntities(featureTemplate(templateKey), spawnPosition, angles) ?? [];
  finalizeSpawned(runtime, { position: spawnPosition, angles, feature: `${mode}_kart` }, spawned);
  const valid = spawned.filter((entity) => entity?.IsValid?.() && !entity.GetClassName?.().startsWith("trigger_"));
  const body = valid.find((entity) => String(entity.GetModelName?.() ?? "").includes("kartphys")) ?? valid[0];
  const visual = valid.find((entity) => entity !== body && String(entity.GetModelName?.() ?? "").includes("luffaren_kart")) ?? body;
  for (const entity of spawned) {
    if (entity === body || entity === visual || !entity?.IsValid()) continue;
    entity.Kill?.();
    runtime.entities.delete(entity);
  }
  if (!body) throw new Error(`${mode} kart body failed to spawn`);
  const heading = Number.isFinite(angles?.yaw) ? angles.yaw : 0;
  body.Teleport?.({ position: spawnPosition, angles: { pitch: 0, yaw: heading, roll: 0 }, velocity: vec() });
  if (visual !== body) {
    visual.Teleport?.({
      position: spawnPosition,
      angles: { pitch: 0, yaw: normalizeYaw(heading + KART_CONFIG.visualYawOffset), roll: 0 },
      velocity: vec(),
    });
  }
  let visualParented = false;
  if (visual !== body && typeof visual?.SetParent === "function") {
                                                                                
                                                                         
                                                        
    visual.SetParent(body);
    visual.Teleport?.({
      position: spawnPosition,
      angles: { pitch: 0, yaw: normalizeYaw(heading + KART_CONFIG.visualYawOffset), roll: 0 },
      velocity: vec(),
    });
    visualParented = true;
  }
  // 原版 Run() 为每辆卡丁车设置随机 rendercolor。
  const kartColor = {
    r: Math.floor(Math.random() * 256), g: Math.floor(Math.random() * 256), b: Math.floor(Math.random() * 256), a: 255,
  };
  visual.collectiveBaseColor = kartColor;
  visual.SetColor?.(kartColor);
  const controller = {
    mode, pawn: undefined, rider: undefined, body, visual, position: clone(spawnPosition), spawnZOffset, heading, speed: 0,
    supportGroundZ: Number.isFinite(ground?.z) ? ground.z : position.z,
    supportOffsetZ: Number.isFinite(ground?.z) ? spawnPosition.z - ground.z : spawnZOffset,
    team: undefined, exploded: false, spent: false, driving: false, frozen: options.frozen ?? mode === "ending",
    jumpLocked: options.jumpLocked ?? mode === "ending", getoffLocked: options.getoffLocked ?? mode === "ending",
    gravity: 1, friction: RACE_CONFIG.friction,
                                                                     
    collisionGroup: RACE_CONFIG.raceCollisionGroup,
    playerCollision: false,
    terrainCollision: true,
    bodySolid: 6,
    terrainCollisionMode: "physics",
    zombieHealthCap: mode === "ending" ? RACE_CONFIG.zombieHealthCap : KART_CONFIG.normalZombieHealthCap,
    jihadRange: mode === "ending" ? RACE_CONFIG.jihadRange : KART_CONFIG.normalJihadRange,
    jihadMagnitude: mode === "ending" ? RACE_CONFIG.jihadMagnitude : KART_CONFIG.normalJihadMagnitude,
    jihadRadius: mode === "ending" ? RACE_CONFIG.jihadExplosionRadius : KART_CONFIG.normalJihadRadius,
    physicsTemplateAvailable, visualParented,
    physicsValidated: false,
                                                                              
    kinematic: false,
    physicsSupported: true,
    physicsNote: "Engine body integration and collision; source velocity drive; seat synchronization requires in-game validation",
    motionMode: "physics",
    driveArmed: true,
    physicsTicks: 0, lookTicks: 0, lookAccumulator: 0, lastControl: undefined, fallRescues: 0,
  };
  raceSetCollisionGroup(body, controller.collisionGroup);
  if (controller.frozen) fireTarget(body, "DisableMotion", "");
  else enableRaceKartMotion(controller);
  applyKartVisualPose(controller);
  queueKartCollisionFilter(controller);
  if (options.rider) kartMount(controller, options.rider, Instance.GetGameTime());
  if (mode === "ending") raceLog(runtime, `kart motion=physics terrain=physics collisiongroup=${controller.collisionGroup} rider=seat_sync`);
  return controller;
}

function spawnRaceKart(runtime, pawn, position) {
  const angles = anglesFor(runtime.direction);
  const controller = spawnKartController(runtime, position, angles, {
    mode: "ending", rider: pawn, frozen: true,
    jumpLocked: RACE_CONFIG.jumpLock, getoffLocked: RACE_CONFIG.getoffLock,
  });
  runtime.karts.set(pawn, controller);
  return controller;
}

function raceKillPawn(pawn) {
  if (!pawn?.IsAlive?.()) return;
  pawn.TakeDamage?.({ damage: 999999, damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0) });
}

function beginRace(runtime) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.raceStarted) return;
  runtime.raceStarted = true;
  runtime.raceStartedAt = Instance.GetGameTime();
  runtime.raceCheckoutReadyAt = runtime.raceStartedAt + RACE_CONFIG.checkoutGrace;
  runtime.raceFrozen = true;
  runtime.orientationCorrections = [];
  runtime.raceStart ??= add(runtime.anchor, vec(0, 0, 12));
  runtime.humanRaceStart ??= add(runtime.raceStart, mul(runtime.direction, 1320));
  const teams = new Map([[2, []], [3, []]]);
  for (const pawn of allLivingPawns()) teams.get(pawn.GetTeamNumber?.())?.push(pawn);
  for (const [team, pawns] of teams) {
    // Zombie rows grow forward, human rows backward: both stay in the gap.
    const base = team === 3 ? runtime.humanRaceStart : runtime.raceStart;
    const rowDirection = team === 3 ? -1 : 1;
    for (const [index, slot] of raceStartSlots(pawns.length).entries()) {
      const offset = add(mul(runtime.left, slot.lateral), mul(runtime.direction, rowDirection * slot.row * RACE_CONFIG.startRowSpacing));
      spawnRaceKart(runtime, pawns[index], add(base, offset));
    }
  }
  announce("RACE ending: GO");
}

// Source spawned karts at RandomFloat(-280,280) as non-colliding debris
// projectiles. CS2 kart bodies only skip their own rider (owner), so
// overlapping karts/riders get depenetrated downward when motion starts.
// Keep the original 560-unit spread, but on distinct lanes and rows.
function raceStartSlots(count) {
  const half = RACE_CONFIG.startHalfWidth;
  const lanes = Math.floor((half * 2) / RACE_CONFIG.startLaneSpacing) + 1;
  const slots = [];
  for (let row = 0; slots.length < count; row++) {
    const laneOrder = shuffleCopy([...Array(lanes).keys()]);
    for (const lane of laneOrder.slice(0, count - slots.length)) {
      slots.push({ row, lateral: -half + lane * RACE_CONFIG.startLaneSpacing });
    }
  }
  return slots;
}

function applyRaceOrientation(runtime) {
  if (!runtime?.raceStarted) return;
  const correction = { at: Instance.GetGameTime(), count: 0 };
  const heading = yawOf(runtime.direction);
  for (const controller of runtime.karts.values()) {
    if (!validEntity(controller.pawn) || !controller.pawn.IsAlive?.()) continue;
                                                                             
                                                                              
                                                                               
    controller.pawn.Teleport?.({ angles: { pitch: KART_CONFIG.riderStartPitch, yaw: heading, roll: 0 } });
    controller.body?.Teleport?.({ angles: { pitch: 0, yaw: heading, roll: 0 } });
    correction.count++;
  }
  runtime.orientationCorrections.push(correction);
}

function nearestKartRider(controller) {
  const origin = kartBodyOrigin(controller);
  if (!origin) return undefined;
  return allLivingPawns()
    .filter((pawn) => {
      if (!validEntity(pawn) || !pawn.IsAlive?.()) return false;
      const position = pawn.GetAbsOrigin?.();
      return position && Math.hypot(position.x - origin.x, position.y - origin.y, position.z - origin.z) <= KART_CONFIG.mountRange;
    })
    .sort((a, b) => {
      const ao = a.GetAbsOrigin();
      const bo = b.GetAbsOrigin();
      return Math.hypot(ao.x - origin.x, ao.y - origin.y, ao.z - origin.z)
        - Math.hypot(bo.x - origin.x, bo.y - origin.y, bo.z - origin.z);
    })[0];
}

function updateKartController(runtime, controller, elapsed, now = Instance.GetGameTime()) {
  if (!controller || controller.spent || controller.exploded) return;
                                                                           
                                                                        
  const currentBodyPosition = controller.kinematic
    ? (controller.position ?? kartBodyOrigin(controller))
    : kartBodyOrigin(controller);
  if (currentBodyPosition) controller.position = clone(currentBodyPosition);
  if (!validEntity(controller.rider) || !controller.rider.IsAlive?.()) {
    if (controller.mode === "normal") {
      kartDismount(controller, now, false);
      const candidate = nearestKartRider(controller);
      if (candidate) kartMount(controller, candidate, now);
    }
  }
  const pawn = controller.rider ?? controller.pawn;
  if (!validEntity(pawn) || !pawn.IsAlive?.()) return;
  if (controller.kinematic) {
                                                                             
                                                                          
                                                                          
                                                                             
    const pawnOrigin = pawn.GetAbsOrigin?.();
    const riderZ = kartRiderLocalZ(controller);
    const expected = controller.position ? add(controller.position, vec(0, 0, riderZ)) : undefined;
    if (pawnOrigin && (!expected || Math.hypot(pawnOrigin.x - expected.x, pawnOrigin.y - expected.y) > 64)) {
      controller.position = add(pawnOrigin, vec(0, 0, -riderZ));
    }
  }
  controller.team = pawn.GetTeamNumber?.();
  if (controller.team === 2 && (pawn.GetHealth?.() ?? 0) > controller.zombieHealthCap) pawn.SetHealth?.(controller.zombieHealthCap);
  controller.physicsTicks++;
  if (controller.frozen || !controller.driving) {
                                                                          
                                                                             
                                                                      
    controller.speed = 0;
    controller.driveVelocityAccel = 0;
    controller.verticalVelocity = 0;
    if (controller.kinematic) {
      syncRaceKinematicKart(controller, controller.position ?? pawn.GetAbsOrigin?.(), {
        pitch: 0, yaw: controller.heading, roll: 0,
      });
    } else {
      controller.body?.Teleport?.({ velocity: vec() });
      pawn.Teleport?.({ velocity: vec() });
    }
    return;
  }
  const angles = viewAngles(pawn) ?? { pitch: 0, yaw: controller.heading, roll: 0 };
  controller.lookAccumulator = (controller.lookAccumulator ?? 0) + elapsed;
  if (controller.lookZ === undefined || controller.lookAccumulator >= RACE_CONFIG.lookTick) {
    const look = forwardVector(pawn, true);
    controller.lookZ = look.z;
    controller.lookAccumulator %= RACE_CONFIG.lookTick;
    controller.lookTicks++;
    const delta = normalizeYaw(angles.yaw - controller.heading);
    controller.driveTurn = Math.abs(delta) > RACE_CONFIG.turnDeadzone
      ? Math.max(-RACE_CONFIG.turnRate, Math.min(RACE_CONFIG.turnRate, delta * RACE_CONFIG.turnScale)) : 0;
  }
  if (controller.getoffLocked === false && controller.lookZ <= KART_CONFIG.dismountLookZ) {
    kartDismount(controller, now, true);
    return;
  }
  const driveVelocityAccel = controller.lookZ + 0.20;
                                                                             
                                                                             
                                                                      
  if (controller.kinematic && !controller.driveArmed) {
    if (controller.lookZ <= 0.05) {
      controller.speed = 0;
      controller.driveVelocityAccel = driveVelocityAccel;
      controller.verticalVelocity = 0;
      syncRaceKinematicKart(controller, controller.position ?? pawn.GetAbsOrigin?.(), {
        pitch: 0, yaw: controller.heading, roll: 0,
      });
      return;
    }
    controller.driveArmed = true;
  }
  controller.driveVelocityAccel = driveVelocityAccel;
  controller.controlApproximation = !controller.physicsSupported;
  const desiredDelta = normalizeYaw(angles.yaw - controller.heading);
  const tickScale = elapsed / RACE_CONFIG.physicsTick;
  controller.heading = normalizeYaw(controller.heading + (controller.driveTurn ?? 0) * tickScale);
  controller.lastControl = { pitch: angles.pitch, yaw: angles.yaw, delta: desiredDelta };
                                                                          
                                                                             
                                                                              
                             
  controller.speed = Math.max(0, Math.min(RACE_CONFIG.maximumSpeed,
    controller.speed + RACE_CONFIG.baseAcceleration * driveVelocityAccel * tickScale));
  if (!controller.jumpLocked && now < (controller.jumpReadyAt ?? 0)) controller.speed = Math.min(180, controller.speed);
  const radians = controller.heading * Math.PI / 180;
                                                                            
                                                          
  let verticalVelocity;
  let kinematicOrigin;
  let kinematicGrounded = false;
  if (controller.kinematic) {
    kinematicOrigin = clone(controller.position ?? pawn.GetAbsOrigin?.() ?? vec());
    const support = raceKinematicSupport(controller, kinematicOrigin, undefined, runtime);
    kinematicGrounded = support.grounded;
    if (support.grounded && Number.isFinite(support.groundZ)) controller.supportGroundZ = support.groundZ;
    if (kinematicGrounded) {
      verticalVelocity = 0;
    } else {
      const gravity = Math.max(0, Math.min(1, controller.gravity ?? RACE_CONFIG.gravity));
      verticalVelocity = Math.max(
        -RACE_CONFIG.maximumFallSpeed,
        (controller.verticalVelocity ?? 0) - (1 - gravity) * CONFIG.worldGravity * elapsed,
      );
    }
  } else {
                                                                             
                                                                             
                                                                              
    const previous = controller.physicsSupported
      ? (controller.body?.GetAbsVelocity?.() ?? pawn.GetAbsVelocity?.() ?? vec())
      : (pawn.GetAbsVelocity?.() ?? vec());
    verticalVelocity = previous.z;
    if (!controller.physicsSupported && verticalVelocity < 0) {
      const gravity = Math.max(0, Math.min(1, controller.gravity ?? RACE_CONFIG.gravity));
      verticalVelocity = Math.min(0, verticalVelocity + (1 - gravity) * CONFIG.worldGravity * elapsed);
      verticalVelocity = Math.max(verticalVelocity, -RACE_CONFIG.maximumFallSpeed);
    }
  }
  controller.verticalVelocity = verticalVelocity;
  if (controller.jumpLocked === false && controller.lookZ >= KART_CONFIG.jumpLookZ && now >= (controller.jumpReadyAt ?? 0)) {
    verticalVelocity = KART_CONFIG.jumpVelocity;
    controller.jumpReadyAt = now + KART_CONFIG.jumpCooldown;
  }
  const velocity = vec(Math.cos(radians) * controller.speed, Math.sin(radians) * controller.speed, verticalVelocity);
  const bodyAngles = { pitch: 0, yaw: controller.heading, roll: 0 };
  if (controller.kinematic) {
    const base = kinematicOrigin ?? clone(controller.position ?? pawn.GetAbsOrigin?.() ?? vec());
    let nextPosition = add(base, mul(velocity, elapsed));
                                                                            
                                                                           
                                                                              
    if (kinematicGrounded) {
                                                                            
                                                                             
      const nextSupport = raceKinematicSupport(controller, nextPosition, controller.supportGroundZ, runtime);
      if (nextSupport.grounded) {
        if (Number.isFinite(nextSupport.bodyZ)) nextPosition.z = nextSupport.bodyZ;
        else nextPosition.z = base.z;
        if (Number.isFinite(nextSupport.groundZ)) controller.supportGroundZ = nextSupport.groundZ;
      } else {
                                                                           
                                                                    
        nextPosition.z = base.z;
      }
    }
                                                                               
                                                                               
                                                                                
                                                                     
    const collision = traceRaceKartHullWorld(base, nextPosition, controller, runtime);
    let collisionGrounded = false;
    if (collision?.didHit) {
                                                                              
                                                                         
                                                                            
                                                             
      const normal = collision.normal ?? collision.hitNormal;
      const noNormalLanding = !normal && verticalVelocity < -1
        ? raceKinematicLandingSupport(controller, nextPosition, runtime)
        : undefined;
      if (noNormalLanding?.grounded && Number.isFinite(noNormalLanding.bodyZ)) {
        nextPosition.z = noNormalLanding.bodyZ;
        controller.supportGroundZ = noNormalLanding.groundZ;
        verticalVelocity = 0;
        controller.verticalVelocity = 0;
        collisionGrounded = true;
      } else {
        const response = raceKartCollisionResponse(base, nextPosition, collision, controller, verticalVelocity, now);
        nextPosition = response.position;
        verticalVelocity = response.verticalVelocity;
        controller.verticalVelocity = verticalVelocity;
        collisionGrounded = response.verticalHit && !response.horizontalHit;
        if (response.landing) {
                                                                            
                                                                               
                                                                               
          const landing = raceKinematicLandingSupport(controller, nextPosition, runtime);
          if (landing.grounded && Number.isFinite(landing.bodyZ)) {
            nextPosition.z = landing.bodyZ;
            if (Number.isFinite(landing.groundZ)) controller.supportGroundZ = landing.groundZ;
            collisionGrounded = true;
          }
        }
      }
    }
    syncRaceKinematicKart(controller, nextPosition, bodyAngles);
    controller.kinematicGrounded = collisionGrounded || kinematicGrounded;
    controller.riderSyncedAt = now;
  } else if (controller.physicsSupported) {
                                                                            
                                                                              
                                                            
    controller.body?.Teleport?.({ velocity, angles: bodyAngles });
    const bodyPosition = kartBodyOrigin(controller);
                                                                           
                                                                            
    if (!controller.visualParented && controller.visual !== controller.body && bodyPosition) {
      controller.visual?.Teleport?.({ position: bodyPosition,
        angles: { pitch: 0, yaw: normalizeYaw(controller.heading + KART_CONFIG.visualYawOffset), roll: 0 } });
    }
    pawn.Teleport?.({
      position: bodyPosition ? add(bodyPosition, vec(0, 0, kartRiderLocalZ(controller))) : undefined,
      velocity,
    });
    controller.riderSyncedAt = now;
    controller.riderSyncedPosition = bodyPosition ? add(bodyPosition, vec(0, 0, kartRiderLocalZ(controller))) : undefined;
  } else {
                                                                         
                                                                              
    controller.body?.Teleport?.({ velocity, angles: bodyAngles });
    pawn.Teleport?.({ velocity });
    const position = pawn.GetAbsOrigin?.();
    if (position && controller.visual && controller.visual !== controller.body) {
      controller.visual.Teleport?.({ position: add(position, vec(0, 0, controller.spawnZOffset)), angles: bodyAngles, velocity: vec() });
    }
  }
}

function updateRaceKart(runtime, controller, elapsed) {
  updateKartController(runtime, controller, elapsed, Instance.GetGameTime());
}

function processRaceKartFall(runtime, controller, now) {
  const pawn = controller.rider ?? controller.pawn;
  const bodyOrigin = controller.kinematic
    ? controller.position
    : controller.body?.GetAbsOrigin?.();
  const origin = controller.kinematic
    ? (bodyOrigin ?? pawn?.GetAbsOrigin?.())
    : controller.physicsSupported
      ? (bodyOrigin ?? pawn?.GetAbsOrigin?.())
      : pawn?.GetAbsOrigin?.();
  if (!origin || origin.z >= RACE_CONFIG.absoluteFallZ) return;
                                                                          
                                                                            
                                                                          
                                                              
  raceSetCollisionGroup(controller.body, controller.collisionGroup ?? RACE_CONFIG.raceCollisionGroup);
  if (controller.team === 2 && now <= runtime.raceStartedAt + RACE_CONFIG.fallenZombieGrace) {
    const side = Math.random() * (RACE_CONFIG.fallenReturnSide * 2) - RACE_CONFIG.fallenReturnSide;
    const target = add(add(runtime.raceStart, mul(runtime.direction, RACE_CONFIG.fallenReturnOffset)), add(mul(runtime.left, side), vec(0, 0, 40)));
    if ((controller.kinematic || controller.physicsSupported) && validEntity(controller.body)) {
      controller.body.Teleport?.({ position: target, velocity: vec(), angles: anglesFor(runtime.direction) });
      pawn.Teleport?.({ position: add(target, vec(0, 0, kartRiderLocalZ(controller))), velocity: vec() });
      if (controller.kinematic) {
        controller.position = clone(target);
        controller.visual?.Teleport?.({
          position: target,
          angles: { pitch: 0, yaw: yawOf(runtime.direction) + KART_CONFIG.visualYawOffset, roll: 0 },
          velocity: vec(),
        });
      }
      controller.riderLocalOffset = vec(0, 0, kartRiderLocalZ(controller));
    } else {
      pawn.Teleport?.({ position: target, velocity: vec() });
    }
    controller.speed = 0;
    controller.heading = yawOf(runtime.direction);
    controller.fallRescues++;
    return;
  }
  raceKillPawn(pawn);
  controller.fallenAt = now;
}

function requestKartJihadExplosion(runtime, zombie, target, now) {
  runtime.jihadExplosionSupported = RACE_CONFIG.jihadExplosionSupported && state.featureTemplates.has("race_jihad");
  runtime.jihadExplosionNote = runtime.jihadExplosionSupported
    ? "template_race_jihad is available; verify magnitude/radius I/O in-game"
    : RACE_CONFIG.jihadExplosionNote;
  runtime.jihadExplosionRequests ??= [];
  const origin = kartBodyOrigin(zombie) ?? zombie.rider?.GetAbsOrigin?.() ?? runtime.raceStart ?? vec();
  runtime.jihadExplosionRequests.push({
    at: now, origin: clone(origin), mode: zombie.mode,
    magnitude: zombie.jihadMagnitude, radius: zombie.jihadRadius,
    damage: undefined, target, sounds: [...RACE_CONFIG.jihadSounds],
  });
  const template = state.featureTemplates.get("race_jihad");
  if (runtime.jihadExplosionSupported && template?.ForceSpawn) {
    const spawned = spawnRoundEntities(template, origin, anglesFor(runtime.direction ?? runtime.incoming ?? vec(1, 0, 0))) ?? [];
    finalizeSpawned(runtime, { position: origin, feature: "kart_jihad" }, spawned);
    const explosionEntities = spawned.filter((entity) => entity?.IsValid?.());
    runtime.jihadExplosionRequests.at(-1).entities = explosionEntities;
    for (const entity of explosionEntities) {
      fireTarget(entity, "Explode", "");
      fireTarget(entity, "Kill", "", 0.05);
    }
  }
  for (const token of RACE_CONFIG.jihadSounds) playCatalogSound(token, origin, {radius:token === "explode_1" ? 20000 : 50000,lifetime:.2});
}

function processKartJihad(runtime, controllers, now) {
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3 && pawn.IsAlive?.());
  for (const zombie of controllers) {
    const rider = zombie.rider ?? zombie.pawn;
    if (zombie.team !== 2 || zombie.exploded || zombie.spent || !rider?.IsAlive?.()) continue;
    const zo = kartBodyOrigin(zombie) ?? rider.GetAbsOrigin?.();
    const target = humans.find((pawn) => {
      const ho = pawn.GetAbsOrigin?.();
      return pawn !== rider && zo && ho && Math.hypot(zo.x - ho.x, zo.y - ho.y, zo.z - ho.z) <= zombie.jihadRange;
    });
    if (!target) continue;
    zombie.jihadTouches = (zombie.jihadTouches ?? 0) + 1;
    zombie.exploded = true;
                                                                             
                                                                              
                                                        
    raceKillPawn(target);
    requestKartJihadExplosion(runtime, zombie, target, now);
    cleanupKartController(runtime, zombie, true);
  }
}

function processRaceJihad(runtime, now) {
  processKartJihad(runtime, runtime.karts.values(), now);
}

function spawnRacePhysicsRubbleFallback(runtime, request, model) {
                                                                         
                                                                           
                                                                           
                                                                             
  const candidates = [
    "race_rubble_elevatorbig",
    "race_rubble_blockwall",
    "race_rubble_holdgeneric",
    "race_rubble_ladder",
    "race_kart",
  ];
  for (const key of candidates) {
    const template = state.featureTemplates.get(key);
    if (!template?.IsValid?.() || typeof template.ForceSpawn !== "function") continue;
    let spawned = [];
    try {
      spawned = spawnRoundEntities(template, request.position, request.angles) ?? [];
    } catch {
      continue;
    }
    const body = spawned.find((entity) => validEntity(entity) && String(entity.GetClassName?.() ?? "").toLowerCase() === "prop_physics_override");
    if (!body) {
      for (const entity of spawned) entity?.Kill?.();
      continue;
    }
    if (typeof body.SetModel !== "function") {
      for (const entity of spawned) entity?.Kill?.();
      continue;
    }
    try {
      finalizeSpawned(runtime, request, spawned);
      for (const entity of spawned) {
        if (entity === body) continue;
        entity?.Kill?.();
        runtime.entities.delete(entity);
      }
      body.SetModel(model);
      body.Teleport?.({ position: request.position, angles: request.angles, velocity: vec() });
      return body;
    } catch (error) {
      for (const entity of spawned) {
        if (validEntity(entity)) entity.Kill?.();
        runtime.entities.delete(entity);
      }
      throw error;
    }
  }
  throw new Error("RACE rubble has no prop_physics_override template; refusing a non-falling dynamic block");
}

function spawnRaceRubblePiece(runtime, target, now) {
  const targetPosition = target.GetAbsOrigin?.();
  if (!targetPosition) return;
  const profile = runtime.rubbleProfile ?? RACE_CONFIG;
  const angle = Math.random() * Math.PI * 2;
  const distance = profile.rubbleHorizontalMin + Math.random() * (profile.rubbleHorizontalMax - profile.rubbleHorizontalMin);
  const offset = typeof profile.rubbleOffset === "function"
    ? profile.rubbleOffset(targetPosition)
    : vec(
      Math.cos(angle) * distance,
      Math.sin(angle) * distance,
      profile.rubbleHeightMin + Math.random() * (profile.rubbleHeightMax - profile.rubbleHeightMin),
    );
  const position = add(targetPosition, offset);
  const tile = profile.rubbleTypes[Math.floor(Math.random() * profile.rubbleTypes.length)];
  const themeName = runtime?.kind === "FINALE" && runtime.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  const themeShape = profile.rubbleThemeShapes[tile] ?? "floor";
  const model = chooseTerrainModel(themeName, themeShape);
                                                                              
                                                                             
  const rubbleAngles = {
    pitch: Math.random() * 360,
    yaw: Math.random() * 360,
    roll: Math.random() * 360,
  };
  const piece = {
    tile, model, themeName, themeShape, position, angles: rubbleAngles, velocity: vec(), target, hitPawns: new Set(), spawnedAt: now,
    damageMode: "native_touch",
    expiresAt: now + profile.rubbleLifetime,
    motionEnableAt: now + 0.10,
    motionDisabledUntil: now + 0.10,
    collisionGroup: profile.rubbleCollisionGroup,
    solid: profile.fallSolid,
    playerCollision: false,
    terrainCollision: true,
    terrainCollisionMode: "physics",
    kinematicFall: profile.kinematicFall === true,
    kinematicGravity: profile.kinematicGravity ?? 800,
    damage: profile.debrisDamage ?? RACE_CONFIG.debrisDamage,
    rubbleHitboxExpansion: profile.rubbleHitboxExpansion,
    bounds: profile.rubbleBounds[tile] ?? profile.rubbleBounds[25],
    visual: undefined,
  };
  try {
    const templateKind = tile === 25 ? "elevatorbig" : tile === 3 ? "ladder" : tile === 95 ? "holdgeneric" : tile === 91 ? "blockwall" : undefined;
    const template = templateKind ? state.featureTemplates.get(`race_rubble_${templateKind}`) : undefined;
    if (template?.IsValid?.() && typeof template.ForceSpawn === "function") {
      const spawned = spawnRoundEntities(template, position, rubbleAngles) ?? [];
      const physics = spawned.find((entity) => validEntity(entity) && String(entity.GetClassName?.() ?? "").toLowerCase() === "prop_physics_override");
      if (physics) {
        finalizeSpawned(runtime, { position, angles: rubbleAngles, velocity: vec(), feature: `race_rubble_${tile}`, tile }, spawned);
        for (const entity of spawned) {
          if (entity === physics || !validEntity(entity)) continue;
          entity.Kill?.();
          runtime.entities.delete(entity);
        }
        if (typeof physics.SetModel === "function") {
          physics.SetModel(model);
          physics.Teleport?.({ position, angles: rubbleAngles, velocity: vec() });
          piece.visual = physics;
          piece.templateKind = templateKind;
        } else {
          physics.Kill?.();
          runtime.entities.delete(physics);
          piece.visual = spawnRacePhysicsRubbleFallback(runtime, { position, angles: rubbleAngles, velocity: vec(), feature: `race_rubble_${tile}`, tile }, model);
          piece.templateFallback = true;
          piece.physicsFallback = true;
        }
      } else {
        for (const entity of spawned) entity?.Kill?.();
        piece.visual = spawnRacePhysicsRubbleFallback(runtime, { position, angles: rubbleAngles, velocity: vec(), feature: `race_rubble_${tile}`, tile }, model);
        piece.templateFallback = true;
        piece.physicsFallback = true;
      }
    } else {
      piece.visual = spawnRacePhysicsRubbleFallback(runtime, { position, angles: rubbleAngles, velocity: vec(), feature: `race_rubble_${tile}`, tile }, model);
      piece.templateFallback = true;
      piece.physicsFallback = true;
      runtime.raceRubbleVisualFallback = true;
      runtime.raceRubbleVisualNote = "race_rubble_* unavailable; used a prop_physics_override fallback with the same real-physics fall contract";
    }
    raceConfigureFallingDebris(piece.visual, RACE_CONFIG.rubbleCollisionGroup);
    if (!validEntity(piece.visual)) throw new Error("rubble physics body did not spawn");
    spawnRaceRubbleTouch(runtime, piece);
    fireTarget(piece.visual, "Kill", "", profile.rubbleLifetime);
                                                                           
                                                                             
                                                                       
                                                        
    if (validEntity(piece.visual)) {
                                                                            
                                                                          
                                                                           
                              
      try {
        piece.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
        fireTarget(piece.visual, "SetRenderAlpha", "255");
      } catch {                                                        }
      if (piece.kinematicFall) {
        fireTarget(piece.visual, "DisableMotion");
        piece.motionEnableQueued = false;
        piece.scriptMotionQueued = true;
      } else {
        fireTarget(piece.visual, "EnableMotion", "", 0.10);
        piece.motionEnableQueued = true;
        piece.scriptMotionQueued = false;
      }
    }
  } catch (error) {
    cleanupRaceRubblePiece(runtime, piece);
    runtime.raceDiagnostics ??= [];
    runtime.raceDiagnostics.push(`rubble generation failed: ${error}`);
    failRuntime(`RACE/FINALE falling rubble generation failed: ${error}`);
    return;
  }
  runtime.rubblePieces ??= [];
  runtime.rubblePieces.push(piece);
}

// Source SpawnDebris used a parented trigger_multiple and OnStartTouch.
// The authored brush supplies the collision bounds; never SetModel/SetSize it.
function spawnRaceRubbleTouch(runtime, piece) {
  const key = `race_rubble_touch_${piece.tile}`;
  const template = featureTemplate(key);
  const spawned = spawnRoundEntities(template, piece.position, piece.angles) ?? [];
  if (spawned.length !== 1 || !validEntity(spawned[0])
    || spawned[0].GetClassName?.() !== "trigger_multiple") {
    for (const entity of spawned) if (validEntity(entity)) entity.Kill?.();
    throw new Error(`rubble requires one authored trigger_multiple from ${key}`);
  }
  piece.touch = spawned[0];
  finalizeSpawned(runtime, { position: piece.position, angles: piece.angles,
    feature: `race_rubble_touch_${piece.tile}` }, spawned);
  if (typeof piece.touch.SetParent !== "function") throw new Error("rubble touch requires native SetParent");
  fireTarget(piece.touch, "Disable");
  raceSetCollisionGroup(piece.touch, 10);
  piece.touch.SetParent(piece.visual);
  piece.touch.Teleport({ position: piece.position, angles: piece.angles, velocity: vec() });
  piece.touchConnection = connectOwnedOutput(runtime, piece.touch, "OnStartTouch", (event) => {
    const now = Instance.GetGameTime();
    if (state.fatal || piece.expired || now < piece.motionEnableAt || now >= piece.expiresAt
      || ["destroyed", "outcome_pending", "resolved"].includes(runtime.lifecycle)
      || !validEntity(piece.visual) || !validEntity(piece.touch)) return;
    const pawn = resolvePawn(event?.activator);
    if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3 || piece.hitPawns.has(pawn)) return;
    // Reserve before TakeDamage: synchronous damage outputs cannot re-enter
    // and apply this piece a second time. Roll back only if damage failed.
    piece.hitPawns.add(pawn);
    try {
      if (!damageRaceRubblePawn(pawn, piece.damage, piece.visual)) piece.hitPawns.delete(pawn);
    } catch (error) {
      piece.hitPawns.delete(pawn);
      cleanupRaceRubblePiece(runtime, piece);
      message(`[RUBBLE] contact damage failed: ${String(error)}`);
    }
  });
  if (piece.touchConnection === undefined || piece.touchConnection === null)
    throw new Error("rubble OnStartTouch connection failed");
  fireTarget(piece.touch, "Enable", "", 0.10);
  fireTarget(piece.touch, "Kill", "", piece.expiresAt - piece.spawnedAt);
}

function damageRaceRubblePawn(pawn, damage, inflictor) {
  const amount = Number(damage);
  if (!validEntity(pawn) || !pawn.IsAlive?.() || !Number.isFinite(amount) || amount <= 0) return false;
  if (typeof pawn.TakeDamage !== "function") throw new Error("falling rubble requires CSPlayerPawn.TakeDamage");
                                                                             
                                                                       
  const event = {
    damage: amount,
    damageFlags: CSDamageFlags.IGNORE_ARMOR,
    damageTypes: CSDamageTypes.GENERIC,
  };
  if (validEntity(inflictor)) event.inflictor = inflictor;
  pawn.TakeDamage(event);
  return true;
}

function cleanupRaceRubblePiece(runtime, piece) {
  piece.expired = true;
  if (piece.touchConnection !== undefined && piece.touchConnection !== null) {
    if (state.outputConnections.has(piece.touchConnection)) disconnectEntityOutput(piece.touchConnection);
    runtime.outputConnections?.delete(piece.touchConnection);
    state.outputConnections.delete(piece.touchConnection);
    piece.touchConnection = undefined;
  }
  for (const entity of [piece.touch, piece.hurt, piece.visual]) {
    if (validEntity(entity)) entity.Kill?.();
    runtime.entities.delete(entity);
  }
}

function processRaceRubble(runtime, now) {
  const rubbleActive = runtime.raceRubbleStarted || runtime.finaleElevatorDebrisStarted;
  if (!rubbleActive) return;
  const profile = runtime.rubbleProfile ?? RACE_CONFIG;
  runtime.rubbleSpawnedCount ??= 0;
  runtime.nextRubbleAt ??= now;
  const underLimit = profile.spawnLimit === undefined || runtime.rubbleSpawnedCount < profile.spawnLimit;
  if (!runtime.raceRubbleStopped && underLimit && now >= runtime.nextRubbleAt) {
    const humans = runtime.finaleElevatorDebrisStarted ? []
      : allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3 && pawn.IsAlive?.());
                                                                        
                                                                            
                                                                     
    const elevatorOrigin = runtime.finaleElevatorDebrisOrigin ?? runtime.finaleElevatorTarget
      ?? runtime.bossArena?.center ?? runtime.anchor;
    const target = runtime.finaleElevatorDebrisStarted
      ? { GetAbsOrigin: () => clone(elevatorOrigin) }
      : humans[Math.floor(Math.random() * Math.max(1, humans.length))];
    if (target) spawnRaceRubblePiece(runtime, target, now);
    if (target) runtime.rubbleSpawnedCount++;
    runtime.nextRubbleAt = now + profile.rubbleIntervalMin + Math.random() * (profile.rubbleIntervalMax - profile.rubbleIntervalMin);
  }
  if (!underLimit && runtime.finaleElevatorDebrisStarted) runtime.finaleElevatorDebrisDone = true;
  for (const piece of runtime.rubblePieces ?? []) {
                                                                          
                                                                          
    if (piece.expiresAt <= now || piece.damageMode !== "native_touch" || piece.hurt
      || !validEntity(piece.visual) || !validEntity(piece.touch)) {
      cleanupRaceRubblePiece(runtime, piece);
      continue;
    }
    if (piece.kinematicFall) {
      const t = Math.max(0, now - piece.motionEnableAt);
      const drop = 0.5 * piece.kinematicGravity * t * t;
      piece.visual.Teleport?.({
        position: vec(piece.position.x, piece.position.y, piece.position.z - drop),
        angles: piece.angles,
        velocity: vec(0, 0, -piece.kinematicGravity * t),
      });
    }
    // The engine moves the child trigger and emits contact outputs. This
    // pass only retires bodies/connections; no piece-by-player polling.
  }
  runtime.rubblePieces = runtime.rubblePieces.filter((piece) => !piece.expired);
}

function racePawnInStageBox(runtime, pawn) {
  const position = pawn?.GetAbsOrigin?.();
  const box = runtime.raceCurrentLevel?.bbox ?? runtime.raceStageBBox;
  return !!position && !!box && position.x >= box.minX && position.x <= box.maxX && position.y >= box.minY && position.y <= box.maxY;
}

function commitRaceCheckout(runtime, request) {
  if (!runtime || runtime.lifecycle !== "active" || request.committedAt !== undefined || request.commitPending || request.failed) return;
  if (runtime.checkoutPending && runtime.checkoutPending !== request) return;
  runtime.checkoutPending = request;
  const slot = runtime.raceNextSlot ?? 0;
  let record;
  try {
    record = buildRaceLevel(runtime, slot);
  } catch (error) {
    runtime.raceDiagnostics ??= [];
    runtime.raceDiagnostics.push(`checkout generation failed: ${error}`);
    request.failed = true;
    raceLog(runtime, `CHECKOUT_FAIL request=${request.id} source=${request.sourceLevel?.id ?? "?"} error=${error}`);
    failRuntime(`RACE checkout failed: ${error}`);
    return;
  }
  if (record.remaining > 0) {
    request.commitPending = true;
    record.checkoutRequest = request;
    runtime.checkoutPending = request;
    return;
  }
  finalizeRaceCheckout(runtime, request, record);
}

function processRaceCheckout(runtime, now) {
  if (!runtime.raceStarted || !runtime.raceFinish || now < (runtime.nextRaceCheckoutAt ?? 0)) return;
                                                                          
                                                                          
  if (runtime.raceFrozen || runtime.checkoutPending) return;
  if ((runtime.raceLevels ?? []).some(record => record.remaining > 0)) return;
  if (now < (runtime.raceCheckoutReadyAt ?? runtime.raceStartedAt + RACE_CONFIG.checkoutGrace)) return;
  runtime.nextRaceCheckoutAt = now + RACE_CONFIG.checkoutInterval;
  if (now < (runtime.checkoutLockedUntil ?? 0)) return;
  const candidates = allLivingPawns().filter((pawn) => [2, 3].includes(pawn.GetTeamNumber?.()) && pawn.IsAlive?.());
  const pawn = candidates.find((candidate) => {
    const position = candidate.GetAbsOrigin?.();
                                                                           
                                                                           
    return position && racePawnInStageBox(runtime, candidate)
      && Math.hypot(position.x - runtime.raceFinish.x, position.y - runtime.raceFinish.y,
        position.z - runtime.raceFinish.z) <= RACE_CONFIG.checkoutRadius;
  });
  if (!pawn) return;
  const sourceLevel = runtime.raceCurrentLevel ?? runtime.raceCheckoutCurrentLevel;
  if (sourceLevel?.checkoutClaimed) return;
  if (sourceLevel) sourceLevel.checkoutClaimed = true;
  const request = { id: (runtime.checkoutRequests?.length ?? 0) + 1, pawn, sourceLevel, requestedAt: now, movedAt: undefined, spawnedAt: undefined, committedAt: undefined };
  runtime.checkoutPending = request;
  raceLog(runtime, `checkout request=${request.id} source-slot=${sourceLevel?.raceSlot ?? "?"} source=${sourceLevel?.id ?? "?"}`);
  runtime.checkoutRequests ??= [];
  runtime.checkoutRequests.push(request);
  runtime.checkoutLockedUntil = now + RACE_CONFIG.checkoutLock;
  const moveKey = `race_checkout_move_${runtime.sequence}_${request.id}`;
  const spawnKey = `race_checkout_spawn_${runtime.sequence}_${request.id}`;
  endingTaskAt(runtime, now + RACE_CONFIG.checkoutRequestDelay, () => {
    if (runtime.lifecycle !== "active") return;
    request.movedAt = Instance.GetGameTime();
    request.moveCommitted = true;
    const reached = request.sourceLevel;
    const destination = reached?.tp ?? runtime.raceFinish;
    const direction = reached?.incoming ?? runtime.direction;
    request.moveDestination = clone(destination);
    request.moveDirection = clone(direction);
    if (state.teleportDestination?.IsValid?.()) moveTeleportDestination(destination, direction);
  }, moveKey);
  endingTaskAt(runtime, now + RACE_CONFIG.checkoutRequestDelay + RACE_CONFIG.checkoutSpawnDelay, () => {
    if (runtime.lifecycle !== "active") return;
    request.spawnedAt = Instance.GetGameTime();
    commitRaceCheckout(runtime, request);
  }, spawnKey);
}

function scheduleRaceRoundAudio(runtime, winningTeam) {
  if (!runtime || runtime.raceRoundAudioArmed) return;
  runtime.raceRoundAudioArmed = true;
  const owner = `round-audio:race:${runtime.sequence}`;
  const position = clone(runtime.raceFinish ?? runtime.anchor ?? vec());
  runtime.roundOwnedAudioTasks ??= [];
  runtime.roundOwnedAudioTasks.push(schedule(0, () => playSourceAudioCue(3199, position), owner));
  runtime.roundOwnedAudioTasks.push(schedule(RACE_CONFIG.firstPlaceDelay, () => playSourceAudioCue(3200, position), owner));
  runtime.roundOwnedAudioTasks.push(schedule(0.05, () => {
    stopCatalogSound("toads_turnpike");
    stopCatalogSound("mk64_racestart");
    stopCatalogSound("letsago");
    for (const anchor of [state.raceAnchors?.bgmToadsA, state.raceAnchors?.bgmToads]) {
      if (!validEntity(anchor)) continue;
      fireTarget(anchor, "Volume", "0");
      fireTarget(anchor, "StopSound", "");
    }
  }, owner));
}

function finishRaceRound(runtime) {
  if (!runtime || runtime.raceRoundFinished) return;
  setZombieRespawning(false, runtime);
  runtime.raceRoundFinished = true;
  runtime.raceRoundFinishedAt = Instance.GetGameTime();
  runtime.raceRoundWaitingForResult = true;
  for (const pawn of allLivingPawns()) if (pawn.GetTeamNumber?.() === 2) raceKillPawn(pawn);
  runtime.raceRoundCandidate = 3;
}

function resolveRaceWin(runtime) {
                                                                           
                                                                            
  finishRaceRound(runtime);
}

function clearRaceOldTransient(runtime) {
  const source = runtime?.sourceRuntime;
  runtime.oldTransientClearedEntities ??= [];
  for (const item of [...(source?.items ?? [])]) {
    if (item.holder) forgetPlayerItem(item.holder, item);
    item.holder = undefined;
    item.state = "cleaned";
    cleanupItemStripTrigger(source, item);
    destroyItemCarrier(item);
    source.items.delete(item);
  }
  for (const deployable of [...(source?.itemDeployables ?? [])]) {
    cleanupDeployable(source, deployable);
    source.itemDeployables.delete(deployable);
  }
  for (const entity of [...(runtime.entities ?? [])]) {
    if (!validEntity(entity)) continue;
    const name = String(entity.GetName?.() ?? entity.GetEntityName?.() ?? entity.targetname ?? "").toLowerCase();
    if (!/(^|[_:])(item|i|kart)([_:]|$)/.test(name) && !name.includes("trap_kart") && !name.includes("race_kart")) continue;
    destroyEndingEntity(runtime, entity);
    runtime.oldTransientClearedEntities.push(entity);
  }
  runtime.oldTransientClearedAt = Instance.GetGameTime();
  runtime.oldItemsCleared = true;
  runtime.oldKartsCleared = true;
}

function cleanupRaceRuntime(runtime) {
  if (!runtime || runtime.kind !== "RACE" || runtime.raceCleanupDone) return;
  for (const controller of runtime.karts?.values?.() ?? []) {
    cleanupKartController(runtime, controller, false);
  }
  releaseRacePreparationPlayers(runtime);
  runtime.karts?.clear?.();
  for (const piece of runtime.rubblePieces ?? []) cleanupRaceRubblePiece(runtime, piece);
  runtime.rubblePieces = [];
  for (const record of runtime.raceLevels ?? []) {
    if (state.levels.get(record.index) === record) destroyLevel(record.index, false);
    else destroyEntities(record.entities ?? []);
  }
  runtime.raceLevels = [];
  runtime.raceCurrentLevel = undefined;
  runtime.raceFinish = undefined;
  runtime.raceStageBBox = undefined;
  runtime.raceCleanupDone = true;
}

function scheduleRaceTimeline(runtime) {
  const at = (time, key, callback) => endingTaskAt(runtime, runtime.runStartedAt + time, callback, `race_${runtime.sequence}_${key}`);
  at(0, "run_start", () => {
    runtime.runStarted = true;
    clearRaceOldTransient(runtime);
    enableEndingSpawnKiller(runtime);
    triggerRaceFade(runtime);
    playSourceAudioCue(3206, runtime.anchor);
    runtime.preRaceControlsLocked = true;
    lockRacePreparationPlayers(runtime, false);
  });
  at(RACE_CONFIG.runT0Stash, "stash", () => {
    runtime.playersStashedAt = Instance.GetGameTime();
    lockRacePreparationPlayers(runtime, true);
    runtime.stashOffset = 16000;
  });
                                                                         
                                                                       
  const oldLevels = [...state.levels.values()].filter(level => level.kind !== "RACE"
    && !Number.isInteger(level.raceSlot) && level !== runtime);
  at(3.95, "retire_old_levels", () => {
    for (const id of runtime.raceOldSourceConnections ?? []) {
      disconnectEntityOutput(id);
      runtime.outputConnections.delete(id);
      state.outputConnections.delete(id);
    }
    // Retired under the run_start screen fade, so kills are spread over Thinks.
    for (const entity of runtime.raceOldSourceEntities ?? []) {
      destroyEndingEntity(runtime, entity, true);
      runtime.entities.delete(entity);
    }
    runtime.raceOldSourceEntities?.clear();
    runtime.raceOldSourceConnections?.clear();
    for (const level of oldLevels) {
      if (state.levels.get(level.index) === level) destroyLevel(level.index, false, true);
    }
  });
  for (let slot = 0; slot < RACE_CONFIG.generateRequestTimes.length; slot++) {
    at(RACE_CONFIG.generateRequestTimes[slot], `request_${slot}`, () => {
      runtime.raceGenerationRequests.push({ slot, requestedAt: Instance.GetGameTime(), buildAt: runtime.runStartedAt + RACE_CONFIG.generateBuildTimes[slot], status: "requested" });
    });
    at(RACE_CONFIG.generateBuildTimes[slot], `build_${slot}`, () => {
      const request = runtime.raceGenerationRequests.find((entry) => entry.slot === slot && entry.status === "requested");
      if (!request) {
        runtime.raceDiagnostics ??= [];
        runtime.raceDiagnostics.push(`RACE build slot ${slot} had no pending request; emergency generation retained`);
      }
      if (request) request.status = "building";
      const record = buildRaceLevel(runtime, slot);
      if (request) { request.status = "built"; request.record = record; }
    });
  }
  at(RACE_CONFIG.indicatorAt, "indicator", () => {
    runtime.indicatorOpenedAt = Instance.GetGameTime();
    positionTeleportIndicator(runtime.raceStart, true);
  });
  at(RACE_CONFIG.profileAt, "profile", () => {
    runtime.raceProfileActive = true;
    runtime.raceAllowPreparationOverflow = false;
    runtime.raceNextBuffer = RACE_CONFIG.activeBuffer;
    runtime.raceProfile = Object.freeze({ ...runtime.raceProfile, buffer: RACE_CONFIG.activeBuffer, switchedAt: Instance.GetGameTime() });
  });
  at(RACE_CONFIG.captureTeleportAt, "capture_tp", () => {
    const destination = state.teleportDestination;
    const authoredStart = runtime.raceStartRecord ?? runtime.raceLevels?.at?.(-1);
    runtime.raceTeleportStart = authoredStart?.tp
      ? clone(authoredStart.tp)
      : destination?.GetAbsOrigin?.() ?? clone(runtime.raceWorldOrigin);
    const forward = authoredStart?.incoming ?? destination?.GetForwardVector?.();
    if (forward && Math.hypot(forward.x, forward.y) > 0.01) {
      runtime.direction = Math.abs(forward.x) >= Math.abs(forward.y)
        ? vec(forward.x < 0 ? -1 : 1, 0, 0)
        : vec(0, forward.y < 0 ? -1 : 1, 0);
      runtime.left = leftOf(runtime.direction);
    }
    runtime.raceStartDirection = clone(runtime.direction);
    runtime.raceStart = clone(runtime.raceTeleportStart);
    runtime.humanRaceStart = add(runtime.raceStart, mul(runtime.direction, 1320));
    runtime.raceSpawnHeading = yawOf(runtime.direction);
    raceLog(runtime, `startpoint source=${authoredStart?.id ?? "teledest"} slot=${authoredStart?.raceSlot ?? "?"} tp=${runtime.raceTeleportStart.x},${runtime.raceTeleportStart.y},${runtime.raceTeleportStart.z} human=${runtime.humanRaceStart.x},${runtime.humanRaceStart.y},${runtime.humanRaceStart.z}`);
    runtime.tpCapturedAt = Instance.GetGameTime();
  });
  at(RACE_CONFIG.startAt, "start", () => beginRace(runtime));
  for (let index = 0; index < RACE_CONFIG.orientationCount; index++) {
    at(RACE_CONFIG.orientationStart + index * RACE_CONFIG.orientationInterval, `orientation_${index}`, () => applyRaceOrientation(runtime));
  }
  at(RACE_CONFIG.startSoundAt, "start_sound", () => playSourceAudioCue(3223, runtime.raceStart));
  for (const [index, time] of RACE_CONFIG.kartStartSoundAt.entries()) at(time, `kart_sound_${index}`, () => playSourceAudioCue(3225, runtime.raceStart));
  at(RACE_CONFIG.kartSecondSoundAt, "kart_sound_2", () => playSourceAudioCue(3227, runtime.raceStart));
  at(RACE_CONFIG.unfreezeAt, "unfreeze", () => {
    runtime.raceFrozen = false;
    runtime.preRaceControlsLocked = false;
    runtime.raceRubbleStarted = true;
    runtime.raceJihadGraceStartedAt = Instance.GetGameTime();
    for (const controller of runtime.karts.values()) {
      controller.frozen = false;
      controller.driving = true;
      enableRaceKartMotion(controller, Instance.GetGameTime());
    }
  });
  at(RACE_CONFIG.musicAt, "music", () => {
    playRaceMusic(runtime);
    runtime.raceBgmStartedAt = Instance.GetGameTime();
    runtime.nextRaceMusicAt = runtime.runStartedAt + RACE_CONFIG.musicAt + RACE_CONFIG.musicRepeat;
  });
  at(RACE_CONFIG.killZombiesAt, "kill_zombies", () => finishRaceRound(runtime));
  at(RACE_CONFIG.massFallbackAt, "mass_fallback", () => {
    runtime.massFallbackAt = Instance.GetGameTime();
    setZombieRespawning(false, runtime);
    for (const pawn of allLivingPawns()) raceKillPawn(pawn);
    runtime.raceMassFallback = true;
  });
}

function finishRaceSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  runtime.raceOldSourceEntities = new Set(runtime.sourceRuntime?.entities ?? []);
  runtime.raceOldSourceConnections = new Set(runtime.sourceRuntime?.outputConnections ?? []);
  transferEndingSourceOwnership(runtime);
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.startedAt = runtime.runStartedAt;
  runtime.lastRaceTickAt = runtime.runStartedAt;
  runtime.karts = new Map();
  runtime.raceStarted = false;
  runtime.raceGenerationRequests = [];
  runtime.raceHistory = [];
  runtime.raceLevels = [];
  runtime.raceBridges = [];
  runtime.raceNextSlot = 0;
  runtime.raceNextBuffer = RACE_CONFIG.initialBuffer;
  runtime.raceAllowPreparationOverflow = true;
  runtime.raceProfile = Object.freeze({
    kind: "RACE", gridSize: RACE_CONFIG.gridSize, initialBuffer: RACE_CONFIG.initialBuffer,
    buffer: RACE_CONFIG.initialBuffer, endRadius: RACE_CONFIG.checkoutRadius, ignoreHeight: true,
    bboxCells: RACE_CONFIG.stageBoxCells, history: RACE_CONFIG.checkoutHistory,
    checkoutRequestDelay: RACE_CONFIG.checkoutRequestDelay, checkoutSpawnDelay: RACE_CONFIG.checkoutSpawnDelay,
    disabledItems: true, disabledTraps: true, trapfloorBaseOnly: true, elevatorModel: "race elevatorbig",
    slopePitch: 10, slopeZOffset: 14, slopeTemplateBlocked: true,
  });
  runtime.raceTemplateStatus = {
    kart: state.featureTemplates.has("race_kart"),
    surfaceFlat: state.featureTemplates.has("race_surface_flat"),
    surfaceSlope: [0, 90, 180, 270].every((yaw) => state.featureTemplates.has(`race_surface_slope_yaw${yaw}`)),
    rubble: ["elevatorbig", "blockwall", "holdgeneric", "ladder"].every((kind) => state.featureTemplates.has(`race_rubble_${kind}`)),
    jihad: state.featureTemplates.has("race_jihad"),
    directionHint: validEntity(state.raceAnchors?.directionHint),
    fade: validEntity(state.raceAnchors?.fade),
    bgmA: validEntity(state.raceAnchors?.bgmToadsA),
    bgmB: validEntity(state.raceAnchors?.bgmToads),
  };
  runtime.raceTemplateNote = "formal template_race_* contracts are cached when present; missing templates remain explicit fallbacks until the map asset batch";
  raceLog(
    runtime,
    `start source=${runtime.sourceRuntime?.id ?? "?"} pool=${RACE_LEVELS.length} `
      + `templates=surface:${runtime.raceTemplateStatus.surfaceFlat ? "ok" : "MISSING"}/slope:${runtime.raceTemplateStatus.surfaceSlope ? "ok" : "MISSING"}/kart:${runtime.raceTemplateStatus.kart ? "ok" : "MISSING"} `
      + `rubble:${runtime.raceTemplateStatus.rubble ? "ok" : "MISSING"} jihad:${runtime.raceTemplateStatus.jihad ? "ok" : "MISSING"}`,
  );
  runtime.raceBgmIndex = 0;
  runtime.raceBgmHistory = [];
  runtime.raceWorldOrigin = vec(0, 0, 0);
  runtime.raceStart = add(runtime.raceWorldOrigin, vec(0, 0, 12));
  runtime.humanRaceStart = add(runtime.raceStart, mul(runtime.direction, 1320));
  runtime.raceFinish = add(runtime.raceStart, mul(runtime.direction, RACE_CONFIG.gridSize * RACE_CONFIG.stageBoxCells));
                                                                              
                                                                        
                                                                           
                                         
  runtime.raceNextEntry = add(
    runtime.raceWorldOrigin,
    mul(runtime.direction, RACE_CONFIG.initialBuffer * RACE_CONFIG.gridSize),
  );
  runtime.raceNextIncoming = clone(runtime.direction);
  runtime.raceStageBBox = {
    minX: Math.min(runtime.raceStart.x, runtime.raceFinish.x) - RACE_CONFIG.gridSize * 10,
    maxX: Math.max(runtime.raceStart.x, runtime.raceFinish.x) + RACE_CONFIG.gridSize * 10,
    minY: Math.min(runtime.raceStart.y, runtime.raceFinish.y) - RACE_CONFIG.gridSize * 10,
    maxY: Math.max(runtime.raceStart.y, runtime.raceFinish.y) + RACE_CONFIG.gridSize * 10,
  };
  scheduleRaceTimeline(runtime);
  endingAnnounce(runtime, 0, "RACE ENDING: GET READY TO RACE");
  endingCountdown(runtime, RACE_CONFIG.startAt, "RACE ENDING STARTS IN", [10, 5, 3, 2, 1]);
  announce("RACE ending started; authored RACE levels are generating");
}

function startRaceEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  const requiredTemplates = [
    "race_surface_flat",
    "race_surface_slope_yaw0",
    "race_surface_slope_yaw90",
    "race_surface_slope_yaw180",
    "race_surface_slope_yaw270",
    "race_kart",
  ];
  const missingTemplates = requiredTemplates.filter((key) => {
    const template = state.featureTemplates.get(key);
    return !template || !template.IsValid?.() || typeof template.ForceSpawn !== "function";
  });
  if (missingTemplates.length > 0) {
    message(`[RACE] startup blocked; missing templates=${missingTemplates.join(",")}`);
    throw new Error(`RACE requires formal map templates: ${missingTemplates.join(", ")}`);
  }
  if (RACE_LEVELS.length !== 50) throw new Error(`RACE requires exactly 50 playable authored levels after removing the simplified course, got ${RACE_LEVELS.length}`);
  const runtime = createEndingRuntime("RACE", stageSnapshot, sourceRuntime);
  runtime.raceProfile = undefined;
  runtime.remaining = 0;
  finishRaceSpawn(runtime);
  return runtime;
}

function processRaceEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "RACE" || runtime.lifecycle !== "active") return;
  const now = Instance.GetGameTime();
  if (!runtime.raceStarted) {
                                                                          
                                                             
    lockRacePreparationPlayers(runtime, runtime.playersStashedAt !== undefined);
    return;
  }
  if (runtime.nextRaceMusicAt !== undefined && now + 1e-6 >= runtime.nextRaceMusicAt) {
    playRaceMusic(runtime);
    runtime.nextRaceMusicAt += RACE_CONFIG.musicRepeat;
  }
  if (now >= (runtime.lastRaceTickAt ?? now) + RACE_CONFIG.physicsTick) {
    const elapsed = Math.max(RACE_CONFIG.physicsTick, Math.min(0.1, now - (runtime.lastRaceTickAt ?? now)));
    runtime.lastRaceTickAt = now;
    for (const controller of runtime.karts.values()) {
      updateRaceKart(runtime, controller, elapsed);
      processRaceKartFall(runtime, controller, now);
      if (controller.team === 2 && (controller.pawn.GetHealth?.() ?? 0) > RACE_CONFIG.zombieHealthCap) controller.pawn.SetHealth?.(RACE_CONFIG.zombieHealthCap);
    }
  }
  processRaceJihad(runtime, now);
  processRaceRubble(runtime, now);
  processRaceCheckout(runtime, now);
  if (runtime.raceRoundFinished) return;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3 && pawn.IsAlive?.());
  if (humans.length === 0) runtime.roundLost = true;
}

function finaleStructurePosition(runtime, forwardCell, sideCell, elevation = 0) {
  return endingPosition(runtime, forwardCell, sideCell, elevation);
}

function spawnFinaleItemList(runtime, names, team, basePosition, rolePrefix, options = {}) {
  if (!runtime || !Array.isArray(names) || !basePosition) return 0;
  let spawned = 0;
  for (let index = 0; index < names.length; index++) {
    const name = names[index];
    const position = add(basePosition, vec(
      Math.floor(Math.random() * 341) - 170,
      Math.floor(Math.random() * 341) - 170,
      Number(options.zOffset ?? 40),
    ));
    try {
      spawnItemFeature(runtime, {
        kind: "feature",
        feature: "item",
        position,
        angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 },
        team,
        teamOverride: team,
        endingItem: true,
        debugItem: true,
        itemName: name,
        role: `${rolePrefix}_${name}_${index}`,
      });
      spawned++;
    } catch (error) {
      runtime.finaleItemErrors ??= [];
      runtime.finaleItemErrors.push({ team, name, index, error: String(error) });
      message(`[FINALE DEBUG] ${rolePrefix} item '${name}' failed: ${error}`);
    }
  }
  return spawned;
}

function spawnFinaleHumanItems(runtime) {
  if (!runtime || runtime.bossMode !== "boss" || runtime.finaleHumanItemsSpawned) return 0;
  const structure = runtime.finaleStructure;
                                                                     
                                                                              
                                                   
  const base = finaleStructurePosition(
    runtime,
    FINALE_STRUCTURE_CONFIG.bridgeLength + 3.5,
    0,
    (structure?.bridgeHeight ?? 0) + FINALE_STRUCTURE_CONFIG.elevatorFloorElevation,
  );
  const names = runtime.infinite ? FINALE_ITEM_CONFIG.humanInfinite : FINALE_ITEM_CONFIG.human;
  const count = spawnFinaleItemList(runtime, names, 3, base, "finale_human", { zOffset: 70 });
  runtime.finaleHumanItemsSpawned = true;
  runtime.finaleHumanItemsSpawnedAt = Instance.GetGameTime();
  runtime.finaleHumanItemCount = count;
  message(`[FINALE DEBUG] human items spawned=${count}/${names.length} infinite=${runtime.infinite === true}`);
  return count;
}

function finaleZombieItemAnchor(runtime) {
  const arena = runtime?.bossArena;
  if (!arena?.center) return undefined;
                                                                     
                                                                           
                                                   
  const arenaOrigin = add(arena.center, mul(runtime.direction, -CONFIG.gridSize * 0.5));
  const forward = FINALE_BOSS_CONFIG.arenaHalfSize + FINALE_BOSS_CONFIG.zPlatformDistance
    + FINALE_BOSS_CONFIG.zPlatformWidth - 0.1;
  return add(arenaOrigin, add(
    mul(runtime.direction, forward * CONFIG.gridSize),
    vec(0, 0, FINALE_BOSS_CONFIG.zPlatformHeight * CONFIG.elevationStep + 40),
  ));
}

function spawnFinaleZombieItems(runtime) {
  if (!runtime || runtime.bossMode !== "boss" || runtime.finaleZombieItemsSpawned) return 0;
  const base = finaleZombieItemAnchor(runtime);
  if (!base) return 0;
  const names = runtime.infinite ? FINALE_ITEM_CONFIG.zombieInfinite : FINALE_ITEM_CONFIG.zombie;
  const count = spawnFinaleItemList(runtime, names, 2, base, "finale_zombie", { zOffset: 0 });
  runtime.finaleZombieItemsSpawned = true;
  runtime.finaleZombieItemsSpawnedAt = Instance.GetGameTime();
  runtime.finaleZombieItemCount = count;
  message(`[FINALE DEBUG] zombie items spawned=${count}/${names.length} infinite=${runtime.infinite === true}`);
  return count;
}

function queueFinaleStructureTile(runtime, shape, forwardCell, sideCell, elevation, role, record, options = {}) {
  const localYaw = Number(options.localYaw ?? 0);
  const worldYaw = normalizeYaw(yawOf(runtime.direction) + localYaw);
  const queuedShape = shape;
  const position = finaleStructurePosition(runtime, forwardCell, sideCell, elevation);
  const tile = ({ wall: 1, floor: 5, floor_slope: 5, platform: 25, detail: 90 })[shape];
  if (!Number.isInteger(tile)) throw new Error(`Finale manual source tile is unavailable for '${shape}'`);
  queueEndingTile(
    runtime,
    tile,
    queuedShape,
    position,
    role,
    options.internal === true,
    options.external !== false,
    record,
    { pitch: 0, yaw: worldYaw, roll: 0 },
  );
  return position;
}

function buildFinaleBridge(runtime) {
  const config = FINALE_STRUCTURE_CONFIG;
  const bridge = [];
  const bridgeTpQueue = [];
  let height = 0;
  let slopeRemaining = 0;
  let detailCount = 0;
  for (let forward = 0; forward < config.bridgeLength; forward++) {
    if (forward % 3 === 0 && forward > 5) {
      bridgeTpQueue.push(finaleStructurePosition(runtime, forward + 2, 0, height));
      bridgeTpQueue[bridgeTpQueue.length - 1].z += 150;
    }
    if (forward % config.bridgeSlopeEvery === 0 && forward > config.bridgeSlopeStart) {
      slopeRemaining = config.bridgeSlopeSegments;
    }
    if (forward % 5 === 0 && forward > config.bridgeSlopeStart) {
      for (const side of [2.5, -2.5]) {
        const record = [];
        queueFinaleStructureTile(runtime, "wall", forward, side, height + 20,
          `finale_bridge_side_${forward}_${side}`, record, { external: true });
        bridge.push({ forward, side, elevation: height + 20, entities: record, sideProp: true });
      }
    }
    const shape = slopeRemaining > 0 ? "floor_slope" : "floor";
    for (const side of [-1.5, -0.5, 0.5, 1.5]) {
      const record = [];
      queueFinaleStructureTile(runtime, shape, forward, side, height,
        `finale_bridge_${forward}_${side}`, record, { localYaw: shape === "floor_slope" ? 180 : 0 });
      const piece = { forward, side, elevation: height, entities: record, shape };
      bridge.push(piece);
      runtime.finaleBridgePieces.add(piece);
      if (shape === "floor" && forward > 0 && detailCount < config.bridgeDetailLimit
        && Math.random() * 100 < config.bridgeDetailChance) {
        const detailRecord = [];
        queueFinaleStructureTile(runtime, "detail", forward, side, height,
          `finale_bridge_detail_${forward}_${side}`, detailRecord, { external: true });
        detailCount++;
        const detail = { forward, side, elevation: height, entities: detailRecord, detail: true };
        bridge.push(detail);
        runtime.finaleBridgePieces.add(detail);
      }
    }
    if (slopeRemaining > 0) {
      height++;
      slopeRemaining--;
    }
  }
                                                                             
                                                                            
  bridgeTpQueue.push(finaleStructurePosition(runtime, config.bridgeLength + 1.5, 0, height));
  bridgeTpQueue[bridgeTpQueue.length - 1].z += 8;
  runtime.finaleStructure.bridge = bridge;
  runtime.finaleStructure.bridgeTpQueue = bridgeTpQueue;
  runtime.finaleStructure.bridgeHeight = height;
  runtime.finaleStructure.bridgeDetailCount = detailCount;
}

function queueFinaleLowgravTrigger(runtime, position, role, height) {
                                                                         
                                                                     
                                                                         
                                                                       
                                                                          
  const triggerWidth = FINALE_BOSS_CONFIG.lowgravTriggerWidth;
  const triggerDepth = FINALE_BOSS_CONFIG.lowgravTriggerDepth;
  runtime.finaleStructure.lowgravRequests.push({
    position: clone(position),
    triggerPosition: add(position, vec(0, 0, -triggerDepth)),
    role,
    height,
    mins: { x: -triggerWidth, y: -triggerWidth, z: -triggerDepth },
    maxs: { x: triggerWidth, y: triggerWidth, z: 0 },
  });
}

function finaleLowgravGeometry(request) {
  if (!request?.position) throw new Error("Finale lowgrav request has no top anchor");
  const width = FINALE_BOSS_CONFIG.lowgravTriggerWidth;
  const depth = FINALE_BOSS_CONFIG.lowgravTriggerDepth;
  return {
                                                                        
                                                                           
                                                               
    triggerPosition: add(request.position, vec(0, 0, -depth)),
    mins: { x: -width, y: -width, z: -depth },
    maxs: { x: width, y: width, z: 0 },
  };
}

function queueFinaleLowgravVisual(runtime, position, role, height) {
  const themeName = runtime?.finaleThemeRandom
    ? chooseFinaleThemeName(runtime)
    : themeProfile(stageSnapshotForRuntime(runtime).theme).name;
  runtime.finaleStructure.lowgravVisualRequests.push({
    position: add(position, vec(0, 0, -FINALE_BOSS_CONFIG.lowgravVisualHeight)),
    top: clone(position),
    angles: anglesFor(runtime.direction),
    role,
    height,
    themeName,
    model: chooseTerrainModel(themeName, "lowgrav"),
  });
}

function buildFinaleTower(runtime) {
  const config = FINALE_STRUCTURE_CONFIG;
  const base = config.bridgeLength;
  const bridgeHeight = runtime.finaleStructure.bridgeHeight;
  const tower = [];
  const towerPieces = runtime.finaleTowerPieces;
  const towerDoor = {
    panelPieces: [],
    offset: 0,
    targetOffset: 0,
    speed: 70,
    state: "closed",
  };
  runtime.finaleStructure.towerDoor = towerDoor;
  const addTile = (shape, forward, side, elevation, role, options = {}) => {
    const record = [];
    const position = queueFinaleStructureTile(runtime, shape, forward, side, bridgeHeight + elevation,
      role, record, { internal: true, external: false });
    const piece = {
      forward, side, elevation: bridgeHeight + elevation, shape,
      position, basePosition: clone(position), entities: record, role,
    };
    tower.push(piece);
    towerPieces.add(piece);
    if (String(role).startsWith("finale_elevator_floor_")) {
      runtime.finaleStructure.elevatorPieces.push(piece);
    }
    return piece;
  };
  for (let x = 1; x <= config.towerSize; x++) {
    for (let y = 1; y <= config.towerSize; y++) {
      const forward = base + x - 1;
      const side = y - 4.5;
      const center = x > 2 && x < 7 && y > 2 && y < 7;
      const inner = x > 1 && x < 8 && y > 1 && y < 8;
      if (center) {
        for (let lowgrav = 1; lowgrav < config.lowgravHeightMax; lowgrav++) {
          queueFinaleLowgravVisual(
            runtime,
            finaleStructurePosition(runtime, base + x - 1.1, side, bridgeHeight + (30 * lowgrav)),
            `finale_lowgrav_visual_${x}_${y}_${lowgrav}`,
            lowgrav,
          );
          queueFinaleLowgravTrigger(
            runtime,
            finaleStructurePosition(runtime, base + x - 1, side, bridgeHeight + (30 * lowgrav)),
            `finale_lowgrav_${x}_${y}_${lowgrav}`,
            lowgrav,
          );
        }
        addTile("platform", base + x - 1, side, config.elevatorFloorElevation,
          `finale_elevator_floor_${x}_${y}`);
        continue;
      }
      if (inner) {
        queueFinaleLowgravVisual(
          runtime,
          finaleStructurePosition(runtime, base + x - 1.1, side,
            bridgeHeight + (25 * config.lowgravHeightMax)),
          `finale_lowgrav_visual_top_${x}_${y}`,
          config.lowgravHeightMax,
        );
        queueFinaleLowgravTrigger(
          runtime,
          finaleStructurePosition(runtime, base + x - 1, side, bridgeHeight + (25 * config.lowgravHeightMax)),
          `finale_lowgrav_top_${x}_${y}`,
          config.lowgravHeightMax,
        );
        addTile("platform", base + x - 1, side, config.towerTopElevation,
          `finale_top_${x}_${y}`);
        continue;
      }
      for (let towerHeight = 1; towerHeight <= config.towerHeight; towerHeight++) {
        const rawHeight = towerHeight * 31;
        const door = x < 3 && y > 3 && y < 6 && rawHeight <= 31;
        const window = rawHeight > 31
          && towerHeight % 2 === 0
          && (x % 3 === 0 || y % 3 === 0);
        if (window) continue;
        if (door) {
                                                                         
                                                                          
                                                             
                                                                     
                                                                           
          const panel = addTile("floor", base + x - 1.1, side, rawHeight,
            `finale_tower_door_panel_${x}_${y}`);
          towerDoor.panelPieces.push(panel);
          addTile("floor", base + x - 1, side, 0,
            `finale_tower_door_floor_${x}_${y}`);
          addTile("platform", base + x, side, 0,
            `finale_tower_tp_floor_${x}_${y}`);
        } else {
                                                                      
                                                                          
                                                                 
          if (rawHeight <= 31) {
            addTile("floor", base + x - 1, side, rawHeight - 31,
              `finale_tower_${x}_${y}_base`);
          }
          addTile("floor", base + x - 1, side, rawHeight,
            `finale_tower_${x}_${y}_${towerHeight}`);
        }
      }
    }
  }
                                                                         
                                                                           
                                                                             
                    
  runtime.finaleStructure.lowgravSteps = [];
  let lastSide = 1;
  for (let raw = 5; raw < (config.lowgravHeightMax * CONFIG.elevationStep) - CONFIG.elevationStep; raw += 5) {
    const sides = [0, 1, 2, 3].filter((side) => side !== lastSide);
    const selected = sides[Math.floor(Math.random() * sides.length)];
    let forward = Math.floor(Math.random() * 4) - 2;
    let side = Math.floor(Math.random() * 4) - 1.5;
    if (selected === 0) { forward = 2; lastSide = 0; }
    else if (selected === 1) { forward = -3; lastSide = 1; }
    // Source pushes y-0.5 after picking the side, so left/right land on -2.5/2.5.
    else if (selected === 2) { side = -2.5; lastSide = 2; }
    else { side = 2.5; lastSide = 3; }
    const record = [];
    queueFinaleStructureTile(runtime, "platform", base + 4 + forward, side, bridgeHeight + raw,
      `finale_lowgrav_step_${raw}`, record, { internal: true, external: false });
    runtime.finaleStructure.lowgravSteps.push({ forward: base + 4 + forward, side, elevation: bridgeHeight + raw, entities: record });
  }
  runtime.finaleStructure.tower = tower;
  runtime.finaleStructure.towerHeight = config.towerHeight;
}

function createFinaleNativeLift(runtime, pieces, displacement, speed, feature, onArrived) {
  const members = pieces.filter(piece => (piece.entities ?? []).some(validEntity));
  const first = members[0]?.entities.find(validEntity);
  if (!first) throw new Error(`${feature}: no spawned lift pieces`);
  const start = clone(first.GetAbsOrigin());
  const leg = spawnNativeMoverLeg(runtime, { feature, nativeTemplateKey: feature.startsWith("finaleZElevator_")
    ? "finaleZombieMover" : "finaleMover" }, first.GetModelName(), start, add(start, displacement), speed);
  const lift = { ...leg, pieces: members, start, displacement: clone(displacement), finished: false };
  runtime.finaleNativeLifts ??= new Set();
  runtime.finaleNativeLifts.add(lift);
  try {
    for (const piece of members) {
      for (const entity of piece.entities ?? []) {
        if (!validEntity(entity)) continue;
        const position = clone(entity.GetAbsOrigin());
        const angles = entity.GetAbsAngles?.();
        entity.SetParent(lift.driver);
        entity.Teleport({ position, ...(angles ? { angles } : {}), velocity: vec() });
      }
    }
    lift.connections.push(connectOwnedOutput(runtime, lift.driver, "OnFullyOpen", () => {
      if (lift.retired || ["outcome_pending", "resolved", "destroyed"].includes(runtime.lifecycle)) return;
      lift.finished = true;
      lift.arrivedAt = Instance.GetGameTime();
      onArrived?.(lift);
    }));
    return lift;
  } catch (error) {
    retireFinaleNativeLift(runtime, lift);
    throw error;
  }
}

function retireFinaleNativeLift(runtime, lift) {
  if (!lift || lift.retired) return;
  fireTarget(lift.driver, "Stop");
  for (const piece of lift.pieces ?? []) {
    for (const entity of piece.entities ?? []) {
      if (!validEntity(entity)) continue;
      const position = clone(entity.GetAbsOrigin());
      const angles = entity.GetAbsAngles?.();
      entity.SetParent(undefined);
      entity.Teleport({ position, ...(angles ? { angles } : {}), velocity: vec() });
      piece.position = position;
    }
  }
  runtime.finaleNativeLifts?.delete(lift);
  releaseNativeMoverLeg(runtime, lift);
}

function setFinaleTowerDoorState(runtime, stateName) {
  const door = runtime?.finaleStructure?.towerDoor;
  if (!door || runtime.finaleStructure.approachCleanupDone) return false;
  const state = stateName === "open" ? "open" : "closed";
  door.state = state;
  door.targetOffset = state === "open" ? 10 * CONFIG.elevationStep : 0;
  if (!door.nativeLift) {
    door.nativeLift = createFinaleNativeLift(runtime, door.panelPieces, vec(0, 0, 10 * CONFIG.elevationStep),
      door.speed, "finaleTowerDoor", () => { door.offset = 10 * CONFIG.elevationStep; });
    door.nativeLift.connections.push(connectOwnedOutput(runtime, door.nativeLift.driver, "OnFullyClosed", () => {
      door.offset = 0;
    }));
  }
  fireTarget(door.nativeLift.driver, state === "open" ? "Open" : "Close");
  return true;
}

function updateFinaleTowerDoor(runtime, elapsed) {
                                                                  
}

function buildFinaleBossArena(runtime) {
  const config = FINALE_STRUCTURE_CONFIG;
                                                                         
                                                                          
  const bossBase = config.bridgeLength + 4;
  const bossElevation = runtime.finaleStructure.bridgeHeight + config.towerTopElevation;
  const arenaCenter = finaleStructurePosition(runtime, bossBase, 0,
    bossElevation);
  const arena = [];
  const pieces = runtime.finaleArenaPieces;
  const smooth = FINALE_BOSS_CONFIG.arenaSmoothValue;
  for (let x = -FINALE_BOSS_CONFIG.arenaHalfSize; x < FINALE_BOSS_CONFIG.arenaHalfSize; x++) {
    for (let y = -FINALE_BOSS_CONFIG.arenaHalfSize; y < FINALE_BOSS_CONFIG.arenaHalfSize; y++) {
      if (x > -4 && x < 3 && y > -4 && y < 3) continue;
      const eigX = x < 0 ? x + 1 : x;
      const eigY = y < 0 ? y + 1 : y;
      if (Math.abs(eigX) + Math.abs(eigY) >= smooth) continue;
      const record = [];
      const forward = bossBase + x;
      const position = queueFinaleStructureTile(runtime, "platform", forward, y + 0.5, bossElevation,
        `finale_boss_arena_${x}_${y}`, record, { internal: true, external: false });
      const piece = { x, y, forward, side: y + 0.5, position, entities: record, bossCollected: false };
      arena.push(piece);
      pieces.add(piece);
    }
  }
  const zPlatform = [];
  for (let y = -FINALE_BOSS_CONFIG.zPlatformLength / 2; y < FINALE_BOSS_CONFIG.zPlatformLength / 2; y++) {
    for (let width = 0; width < FINALE_BOSS_CONFIG.zPlatformWidth; width++) {
      const record = [];
      const forward = bossBase + FINALE_BOSS_CONFIG.arenaHalfSize
        + FINALE_BOSS_CONFIG.zPlatformDistance + width;
      const position = queueFinaleStructureTile(runtime, "platform", forward, y + 0.5,
        bossElevation + FINALE_BOSS_CONFIG.zPlatformHeight, `finale_boss_zplatform_${y}_${width}`, record,
        { internal: true, external: false });
      zPlatform.push({ y, width, forward, side: y + 0.5, position, entities: record });
    }
  }
  runtime.bossArena = {
    center: clone(arenaCenter),
    halfSize: FINALE_BOSS_CONFIG.arenaHalfSize * CONFIG.gridSize,
    smoothValue: smooth,
    arenaPieces: arena,
    zPlatform,
    zElevators: [],
    bossBase,
  };
                                                                          
                                                                             
                                                                          
                                                                           
  const centerTop = [
    ...(runtime.finaleStructure?.elevatorPieces ?? []),
    ...(runtime.finaleStructure?.tower ?? []).filter((piece) =>
      String(piece?.role ?? "").startsWith("finale_top_")),
  ];
  runtime.layout = { pieces: [...new Set([...arena, ...centerTop])], groups: new Map() };
  runtime.finaleStructure.arena = arena;
  runtime.finaleStructure.zPlatform = zPlatform;
}

function buildFinaleStructure(runtime) {
  runtime.finaleStructure = {
    mode: "boss",
    bridge: [],
    bridgeTpQueue: [],
    bridgeHeight: 0,
    bridgeCleanupIndex: -1,
    bridgeCleanupStarted: false,
    bridgeCleanupDone: false,
    spawnPlatformFired: false,
    bridgeDetailCount: 0,
    lowgravRequests: [],
    lowgravVisualRequests: [],
    lowgravDisabled: false,
    lowgravSteps: [],
    tower: [],
    elevatorPieces: [],
    arena: [],
    zPlatform: [],
    arenaBuildRequested: false,
    arenaSpawned: false,
    elevatorLeaving: false,
    towerCleanupStarted: false,
    towerCleanupIndex: 0,
    towerCleanupOrder: [],
    elevator: undefined,
    elevatorStartedAt: undefined,
    elevatorArrivalAt: undefined,
    elevatorPieces: [],
    bossReadyAt: undefined,
    bossReady: false,
    antiBoostEnabled: false,
    notes: [],
  };
  runtime.finaleBridgePieces.clear();
  runtime.finaleTowerPieces.clear();
  runtime.finaleArenaPieces.clear();
  buildFinaleBridge(runtime);
  buildFinaleTower(runtime);
  runtime.finaleStructure.anchor = clone(runtime.anchor);
  runtime.finaleStructure.direction = clone(runtime.direction);
  runtime.finaleStructure.left = clone(runtime.left);
  runtime.finaleStructure.bridgeTileCount = runtime.finaleStructure.bridge.length;
  message(`[FINALE DEBUG] structure bridge=${runtime.finaleStructure.bridge.length} tower=${runtime.finaleStructure.tower.length} lowgrav=${runtime.finaleStructure.lowgravRequests.length} detail=${runtime.finaleStructure.bridgeDetailCount}`);
}

function spawnFinaleLowgravTriggers(runtime) {
  const templateKey = FINALE_BOSS_CONFIG.lowgravTriggerTemplateKey;
  const template = state.featureTemplates.get(templateKey);
  if (!template?.IsValid?.() || typeof template.ForceSpawn !== "function") {
    runtime.finaleStructure.lowgravSupported = false;
    runtime.finaleStructure.notes.push(`${FEATURE_TEMPLATE_NAMES[templateKey]} unavailable; Finale low gravity is disabled`);
    message(`[FINALE DEBUG] lowgrav template unavailable: ${FEATURE_TEMPLATE_NAMES[templateKey]}`);
    return;
  }
  runtime.finaleStructure.lowgravSupported = true;
  for (const request of runtime.finaleStructure.lowgravRequests) {
    try {
      const geometry = finaleLowgravGeometry(request);
      const trigger = spawnTriggerVolume(runtime, {
        position: geometry.triggerPosition,
        angles: { pitch: 0, yaw: 0, roll: 0 },
        feature: request.role,
        templateKey,
      }, geometry.mins, geometry.maxs);
      trigger.SetEntityName?.(`finale_lowgrav_${runtime.sequence}_${request.role}`);
      raceSetCollisionGroup(trigger, FINALE_BOSS_CONFIG.collisionGroup);
      trigger.finaleCollisionGroup = FINALE_BOSS_CONFIG.collisionGroup;
      trigger.finaleGravityHeight = request.height;
      trigger.finaleGravityTop = clone(request.position);
      trigger.finaleGravityBounds = geometry;
      runtime.finaleLowgravTriggers.add(trigger);
      const gravitySource = `${runtime.index}:finale_lowgrav:${request.role}`;
      connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
        const pawn = resolvePawn(data?.activator ?? data);
        if (!pawn?.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) return;
        const insideByPawn = runtime.finaleLowgravInside ??= new Map();
        let active = insideByPawn.get(pawn);
        if (!active) insideByPawn.set(pawn, active = new Set());
        if (active.has(request.role)) return;
        active.add(request.role);
        addGravitySource(runtime, pawn, gravitySource, CONFIG.lowGravity, { engine: true, simulate: false });
        capGravitySlideVelocity(pawn);
      });
      connectOwnedOutput(runtime, trigger, "OnEndTouch", (data) => {
        const pawn = resolvePawn(data?.activator ?? data);
        if (!pawn) return;
        const active = runtime.finaleLowgravInside?.get(pawn);
        if (active?.has(request.role)) active.delete(request.role);
        removeGravitySource(pawn, gravitySource);
        capGravitySlideVelocity(pawn);
      });
      fireTarget(trigger, "Enable");
      message(`[FINALE DEBUG] lowgrav role=${request.role} top=${request.position.x},${request.position.y},${request.position.z} trigger=${geometry.triggerPosition.x},${geometry.triggerPosition.y},${geometry.triggerPosition.z} bounds=${geometry.mins.x},${geometry.mins.y},${geometry.mins.z}..${geometry.maxs.x},${geometry.maxs.y},${geometry.maxs.z}`);
    } catch (error) {
      runtime.finaleStructure.lowgravSupported = false;
      runtime.finaleStructure.notes.push(`lowgrav trigger ${request.role} failed: ${error}`);
      message(`[FINALE DEBUG] lowgrav trigger '${request.role}' failed: ${error}`);
    }
  }
}

function spawnFinaleLowgravVisuals(runtime) {
  const structure = runtime?.finaleStructure;
  if (!runtime || !structure || structure.lowgravVisualsSpawned) return;
  structure.lowgravVisualsSpawned = true;
  for (const request of structure.lowgravVisualRequests ?? []) {
    try {
      const visual = spawnVisual(runtime, {
        position: request.position,
        angles: request.angles,
        feature: request.role,
      }, request.model);
      if (!validEntity(visual)) throw new Error("lowgrav visual did not spawn");
      visual.SetEntityName?.(`finale_lowgrav_visual_${runtime.sequence}_${request.role}`);
      const applySourceAppearance = () => {
        if (!validEntity(visual)) return;
                                                                             
                                                                             
                                                                           
                                                                          
                                          
        const color = genericRenderColor(130, request.themeName) ?? { r: 255, g: 255, b: 255, a: 255 };
        visual.SetColor?.({ ...color, a: 150 });
        fireTarget(visual, "SetRenderAlpha", "150");
        fireTarget(visual, "SetSolid", "5");
      };
      applySourceAppearance();
      afterThink(applySourceAppearance);
                                                                           
                                                                          
      runtime.finaleLowgravVisuals.add(visual);
    } catch (error) {
      structure.notes.push(`lowgrav visual ${request.role} failed: ${error}`);
      message(`[FINALE DEBUG] lowgrav visual '${request.role}' failed: ${error}`);
    }
  }
}

function disableFinaleLowgrav(runtime) {
  const structure = runtime?.finaleStructure;
  if (!runtime || !structure || structure.lowgravDisabled) return;
  structure.lowgravDisabled = true;
  const insideByPawn = runtime.finaleLowgravInside ?? new Map();
  for (const [pawn, roles] of insideByPawn) {
    for (const role of roles ?? []) {
      removeGravitySource(pawn, `${runtime.index}:finale_lowgrav:${role}`);
    }
  }
  insideByPawn.clear();
  let triggerIndex = 0;
  for (const trigger of runtime.finaleLowgravTriggers ?? []) {
    if (!validEntity(trigger)) continue;
    fireTarget(trigger, "Disable");
    const key = `finale_lowgrav_kill_${runtime.sequence}_${triggerIndex++}`;
    endingTaskAt(runtime, Instance.GetGameTime() + 0.2, () => {
      if (validEntity(trigger)) trigger.Kill?.();
    }, key);
  }
  runtime.finaleLowgravTriggers.clear();
  for (const visual of runtime.finaleLowgravVisuals ?? []) {
    if (validEntity(visual)) visual.Kill?.();
    runtime.entities.delete(visual);
  }
  runtime.finaleLowgravVisuals.clear();
}

function queueFinaleBossArena(runtime) {
  if (!runtime || runtime.finaleStructure?.arenaBuildRequested) return;
  runtime.finaleStructure.arenaBuildRequested = true;
  buildFinaleBossArena(runtime);
  runtime.finaleStructure.arenaSpawned = false;
  runtime.lifecycle = "spawning";
  runtime.lifecycleHistory.push("spawning_arena");
  message(`[FINALE DEBUG] boss arena queued pieces=${runtime.finaleStructure.arena.length} zplatform=${runtime.finaleStructure.zPlatform.length}`);
}

function spawnFinaleZElevators(runtime) {
  const arena = runtime.bossArena;
  if (!arena || arena.zElevators.length > 0) return;
  for (const platform of arena.zPlatform) {
    if (platform.y % FINALE_BOSS_CONFIG.zPlatformElevatorModulo !== 0) continue;
                                                                              
                                                                          
    const theme = runtime.finaleThemeRandom
      ? chooseFinaleThemeName(runtime)
      : stageSnapshotForRuntime(runtime).theme;
    const model = chooseTerrainModel(theme, "elevator");
                                                                         
                                                                         
    const start = add(platform.position, mul(runtime.direction, -CONFIG.gridSize));
    const visual = spawnModelBlock(runtime, {
      position: start,
      angles: anglesFor(runtime.direction, true),
      feature: `finaleZElevator_${platform.y}`,
    }, model);
    if (!visual) continue;
    visual.SetEntityName?.(`finale_boss_zelevator_${runtime.sequence}_${platform.y}`);
    const mover = {
      entity: visual,
      start: clone(start),
      target: add(start, mul(runtime.direction, -(FINALE_BOSS_CONFIG.zPlatformDistance - 1) * CONFIG.gridSize)),
      position: clone(start),
      speed: FINALE_BOSS_CONFIG.zPlatformElevatorSpeed,
      startAt: undefined,
      started: false,
      waitUntil: undefined,
      direction: 1,
      finished: false,
    };
    arena.zElevators.push(mover);
    runtime.finaleZElevators.add(mover);
    mover.nativeLift = createFinaleNativeLift(runtime, [{ entities: [visual], position: clone(start) }],
      sub(mover.target, start), mover.speed, `finaleZElevator_${platform.y}`, () => {
        mover.direction = -1;
        mover.waitUntil = Instance.GetGameTime() + FINALE_BOSS_CONFIG.zPlatformElevatorWait;
      });
    mover.nativeLift.connections.push(connectOwnedOutput(runtime, mover.nativeLift.driver, "OnFullyClosed", () => {
      if (mover.nativeLift.retired) return;
      mover.direction = 1;
      mover.waitUntil = Instance.GetGameTime() + FINALE_BOSS_CONFIG.zPlatformElevatorWait;
    }));
  }
                                                                           
                                                                           
                                                                         
  const order = [...arena.zElevators];
  for (let index = order.length - 1; index > 0; index--) {
    const swap = Math.floor(Math.random() * (index + 1));
    [order[index], order[swap]] = [order[swap], order[index]];
  }
  const base = (runtime.bossStartedAt ?? Instance.GetGameTime()) + FINALE_BOSS_CONFIG.zPlatformElevatorStart;
  order.forEach((mover, index) => { mover.startAt = base + index * FINALE_BOSS_CONFIG.zPlatformElevatorInterval; });
  arena.zElevatorStartOrder = order;
}

function updateFinaleZElevators(runtime, now, elapsed) {
  for (const mover of runtime.bossArena?.zElevators ?? []) {
    if (!validEntity(mover.entity)) continue;
    if (!mover.started) {
      if (now < (mover.startAt ?? now)) continue;
      mover.started = true;
      mover.waitUntil = now;
    }
    if (mover.waitUntil === undefined || now < mover.waitUntil) continue;
    mover.waitUntil = undefined;
    fireTarget(mover.nativeLift.driver, mover.direction > 0 ? "Open" : "Close");
  }
}

function finishFinaleBossArenaSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.finaleStructure.arenaSpawned = true;
  if (runtime.debugDirectBoss !== true) {
    spawnFinaleZElevators(runtime);
    spawnFinaleZombieItems(runtime);
    spawnFinaleBossIdleEyes(runtime);
  }
  if (runtime.debugDirectBoss === true) {
    const structure = runtime.finaleStructure;
    structure.zPlatformTp = add(runtime.bossArena.center,
      add(mul(runtime.direction, (FINALE_BOSS_CONFIG.arenaHalfSize + FINALE_BOSS_CONFIG.zPlatformDistance) * CONFIG.gridSize),
        vec(0, 0, FINALE_BOSS_CONFIG.zPlatformHeight * CONFIG.elevationStep + 8)));
    moveTeleportDestination(structure.zPlatformTp, runtime.direction, true);
    structure.bossReady = true;
    runtime.finalBossReadyAt = Instance.GetGameTime();
    startFinaleBossFight(runtime);
    const side = runtime.left ?? leftOf(runtime.direction);
    const humanSpot = add(runtime.bossArena.center, add(mul(side, -450), vec(0, 0, 64)));
    const zombieSpot = add(runtime.bossArena.center, add(mul(side, 450), vec(0, 0, 64)));
    for (const pawn of allLivingPawns()) {
      const team = pawn.GetTeamNumber?.();
      const spot = team === 3 ? humanSpot : team === 2 ? zombieSpot : undefined;
      if (spot) pawn.Teleport?.({ position: spot, angles: anglesFor(runtime.direction), velocity: vec() });
    }
    announce("DEBUG: direct Boss arena ready");
  }
  flushEndingTimeline(runtime, {
    finaleArenaTeleport: () => releaseFinaleArenaTeleport(runtime),
    [`finale_music_bridge_${runtime.sequence}`]: () => startFinaleBridgeMusic(
      runtime,
      runtime.runStartedAt + FINALE_MUSIC_CONFIG.bridgeDelay,
    ),
  });
}

function startFinaleStructureTimeline(runtime) {
  const structure = runtime?.finaleStructure;
  if (!runtime || !structure || runtime.lifecycle !== "active") return;
  runtime.finaleStructurePhase = "bridge";
  runtime.finalBossReadyAt = undefined;
  structure.bossReady = false;
                                                                            
                                                                          
                                                                            
                                             
  scheduleFinaleHorn(runtime, runtime.runStartedAt + 0.5 + 9 + Math.random() * 91);
                                                                            
                                                                           
                                                        
  endingTaskAt(runtime, runtime.runStartedAt + FINALE_MUSIC_CONFIG.bridgeDelay, () => {
    startFinaleBridgeMusic(runtime, runtime.runStartedAt + FINALE_MUSIC_CONFIG.bridgeDelay);
  }, `finale_music_bridge_${runtime.sequence}`);
  spawnFinaleLowgravTriggers(runtime);
                                                                         
                                                                         
                                                                          
  spawnFinaleLowgravVisuals(runtime);
                                                                         
                                                                              
                                             
  spawnFinaleHumanItems(runtime);
  endingTaskAt(runtime, runtime.runStartedAt + FINALE_STRUCTURE_CONFIG.antiBoostStartDelay, () => {
    structure.antiBoostEnabled = true;
    structure.nextAntiBoostAt = Instance.GetGameTime();
    message("[FINALE DEBUG] tower anti-boost enabled");
  }, "finaleAntiBoostStart");
                                                                              
                                                                          
                                                                            
                                               
  structure.towerCleanupOrder = [
    ...runtime.finaleTowerPieces,
    ...(structure.lowgravSteps ?? []),
  ].filter((piece) => {
    const role = String(piece?.role ?? "");
    return !role.startsWith("finale_elevator_floor_")
      && !role.startsWith("finale_top_")
      && !role.startsWith("finale_tower_door_panel_")
      && !role.startsWith("finale_tower_tp_floor_");
  });
  for (let index = structure.towerCleanupOrder.length - 1; index > 0; index--) {
    const swap = Math.floor(Math.random() * (index + 1));
    [structure.towerCleanupOrder[index], structure.towerCleanupOrder[swap]] = [structure.towerCleanupOrder[swap], structure.towerCleanupOrder[index]];
  }
  endingTaskAt(runtime, runtime.runStartedAt + FINALE_STRUCTURE_CONFIG.bridgeCleanupDelay,
    () => { structure.bridgeCleanupStarted = true; structure.bridgeCleanupNextAt = Instance.GetGameTime(); }, "finaleBridgeCleanup");
                                                                             
                                                                            
                                                                             
                                        
  endingTaskAt(
    runtime,
    runtime.runStartedAt
      + FINALE_STRUCTURE_CONFIG.bridgeCleanupDelay
      + FINALE_STRUCTURE_CONFIG.spawnPlatformFallDelay,
    () => {
      if (structure.spawnPlatformFired) return;
      structure.spawnPlatformFired = true;
      fireName("spawnplatform", "FireUser1");
    },
    "finaleSpawnPlatformFall",
  );
  // Source starts finale_towerelevator_leavetime only when the elevator relay
  // is spawned: after five 0.05s setup steps, the shared manual queue spawns
  // every bridge and tower item (lowgrav visuals included) at 0.05s each.
  // Mirror that ~32s delay instead of counting from the round start, so the
  // zombies' tower entry (~76s) still precedes departure as in the original.
  const sourceElevatorSpawnDelay = 0.25 + 0.05 * (
    (structure.bridge?.length ?? 0)
    + (structure.tower?.length ?? 0)
    + (structure.lowgravVisualRequests?.length ?? 0));
  structure.elevatorReadyAt = runtime.runStartedAt + sourceElevatorSpawnDelay;
  structure.elevatorLeaveAt = structure.elevatorReadyAt + FINALE_STRUCTURE_CONFIG.towerElevatorLeaveTime;
  scheduleFinaleElevatorCountdown(runtime, structure.elevatorReadyAt, structure.elevatorLeaveAt);
  // Source spawns block_finale_towerdoormaster right after the elevator master
  // (one more 0.05s queue slot) and opens it 1s later, so the door stays shut
  // until the whole tower has spawned. Source also sets FALLDAMAGE_DISABLE for
  // the elevator wait and clears it when the elevator leaves.
  structure.towerDoorOpenAt = structure.elevatorReadyAt + 0.05 + 1;
  endingTaskAt(runtime, structure.towerDoorOpenAt,
    () => setFinaleTowerDoorState(runtime, "open"), "finaleTowerDoorOpen");
  endingTaskAt(runtime, structure.elevatorReadyAt, () => {
    state.genericEvents.fallDamageDisabledUntil = Math.max(
      state.genericEvents.fallDamageDisabledUntil ?? 0, structure.elevatorLeaveAt);
  }, "finaleElevatorWaitFallDamage");
  endingTaskAt(runtime, structure.elevatorLeaveAt,
    () => {
      structure.elevatorLeaving = true;
      runtime.finaleStructurePhase = "elevator";
                                                                             
                                                                          
                                                                    
      disableFinaleLowgrav(runtime);
      structure.towerCleanupStarted = true;
      structure.towerCleanupStartedAt = Instance.GetGameTime();
      startFinaleTowerElevator(runtime, Instance.GetGameTime());
      queueFinaleBossArena(runtime);
    }, "finaleElevatorLeave");
  endingTaskAt(runtime, structure.elevatorLeaveAt + FINALE_STRUCTURE_CONFIG.zPlatformTeleportDelay,
    () => releaseFinaleArenaTeleport(runtime), "finaleArenaTeleport");
}

function releaseFinaleArenaTeleport(runtime) {
  const structure = runtime?.finaleStructure;
  if (!structure || !runtime.bossArena?.center) return;
  structure.zPlatformTp = add(runtime.bossArena.center,
    add(mul(runtime.direction, (FINALE_BOSS_CONFIG.arenaHalfSize + FINALE_BOSS_CONFIG.zPlatformDistance) * CONFIG.gridSize),
      vec(0, 0, FINALE_BOSS_CONFIG.zPlatformHeight * CONFIG.elevationStep + 8)));
  moveTeleportDestination(structure.zPlatformTp, runtime.direction, true);
  for (const piece of runtime.finaleTowerPieces ?? []) {
    if (!String(piece?.role ?? "").startsWith("finale_tower_tp_floor_")) continue;
    for (const entity of piece.entities ?? []) destroyEndingEntity(runtime, entity);
    piece.cleaned = true;
  }
  runtime.bossArena.releasedAt = Instance.GetGameTime();
  structure.bossReady = true;
  endingTaskAt(runtime, Instance.GetGameTime() + 2, () => {
    structure.antiBoostEnabled = false;
  }, `finaleAntiBoostStop_${runtime.sequence}`);
}

function cleanupFinaleApproach(runtime) {
  const structure = runtime?.finaleStructure;
  if (!structure || structure.approachCleanupDone) return;
  const doorLift = structure.towerDoor?.nativeLift;
  if (doorLift) retireFinaleNativeLift(runtime, doorLift);
  disableFinaleLowgrav(runtime);
  // Only the tower's center landing remains part of the boss arena. Use
  // owned piece records, including the original refs of falling replacements.
  const pieces = new Set([
    ...(structure.bridge ?? []),
    ...(structure.tower ?? []),
    ...(runtime.finaleTowerPieces ?? []),
    ...(structure.lowgravSteps ?? []),
  ]);
  for (const piece of pieces) {
    const role = String(piece?.role ?? "");
    if (role.startsWith("finale_elevator_floor_") || role.startsWith("finale_top_")) continue;
    for (const entity of piece.entities ?? []) destroyEndingEntity(runtime, entity);
    piece.cleaned = true;
  }
  structure.bridgeCleanupDone = true;
  structure.towerCleanupIndex = structure.towerCleanupOrder?.length ?? 0;
  structure.approachCleanupDone = true;
  structure.approachCleanedAt = Instance.GetGameTime();
}

function scheduleFinaleElevatorCountdown(runtime, readyAt, leaveAt) {
  const leaveTime = leaveAt - readyAt;
  endingTaskAt(runtime, readyAt, () => announce(`FINALE: elevator leaves in ${Math.round(leaveTime)}s`),
    `finale_elevator_countdown_${runtime.sequence}`);
  for (const seconds of [30, 10, 5]) {
    if (leaveTime - seconds <= 0) continue;
    endingTaskAt(runtime, leaveAt - seconds, () => announce(`FINALE: elevator leaves in ${seconds}s`),
      `finale_elevator_countdown_${seconds}_${runtime.sequence}`);
  }
  endingTaskAt(runtime, leaveAt, () => announce("FINALE: elevator is leaving"),
    `finale_elevator_leaving_${runtime.sequence}`);
  endingTaskAt(runtime, leaveAt + 1.01, () => announce("FINALE: prepare for the end"),
    `finale_elevator_prepare_${runtime.sequence}`);
}

function scheduleFinaleHorn(runtime, absoluteTime) {
  if (!runtime || runtime.kind !== "FINALE") return;
  const at = Math.max(Instance.GetGameTime(), Number(absoluteTime) || Instance.GetGameTime());
  runtime.finaleHornNextAt = at;
  const suffix = Math.round(at * 100);
  endingTaskAt(runtime, at, () => {
    if (!runtime || runtime.lifecycle !== "active") return;
    const stateValue = runtime.finaleHornState === 2 ? 2 : 1;
    const token = `horn${stateValue}_default`;
    const played = playCatalogSound(token, vec(), {radius:0,lifetime:.5,...{
      pitch: 98 + Math.floor(Math.random() * 5),
    }});
    runtime.finaleHornHistory ??= [];
    runtime.finaleHornHistory.push({
      at: Instance.GetGameTime(),
      token,
      played,
    });
    runtime.finaleHornState = stateValue === 1 ? 2 : 1;
    scheduleFinaleHorn(runtime, Instance.GetGameTime() + 9 + Math.random() * 91);
  }, `finale_horn_${runtime.sequence}_${suffix}`);
}

function startFinaleTowerElevator(runtime, now) {
  const structure = runtime?.finaleStructure;
  if (!runtime || !structure || structure.elevator) return;
  const startElevation = structure.bridgeHeight + FINALE_STRUCTURE_CONFIG.elevatorFloorElevation;
  const targetElevation = structure.bridgeHeight + FINALE_STRUCTURE_CONFIG.towerTopElevation;
                                                                         
                                                                               
                                       
  const start = finaleStructurePosition(runtime, FINALE_STRUCTURE_CONFIG.bridgeLength + 3.5, 0, startElevation);
  const target = add(start, vec(0, 0,
    (targetElevation - startElevation) * CONFIG.elevationStep));
  const distance = Math.abs(target.z - start.z);
  structure.elevator = {
    start: clone(start),
    target: clone(target),
    position: clone(start),
    speed: FINALE_STRUCTURE_CONFIG.elevatorMoveSpeed,
    startedAt: now,
    arrivalAt: now + distance / Math.max(1, FINALE_STRUCTURE_CONFIG.elevatorMoveSpeed),
    finished: false,
  };
  structure.elevatorStartedAt = now;
  structure.elevatorArrivalAt = structure.elevator.arrivalAt;
  runtime.finalBossReadyAt = Infinity;
  structure.elevator.nativeLift = createFinaleNativeLift(runtime, structure.elevatorPieces,
    sub(target, start), structure.elevator.speed, "finaleTowerLift", lift => {
      structure.elevator.finished = true;
      structure.elevator.position = clone(target);
      structure.elevator.arrivedAt = lift.arrivedAt;
      runtime.finalBossReadyAt = lift.arrivedAt + FINALE_STRUCTURE_CONFIG.bossStartDelay;
      retireFinaleNativeLift(runtime, lift);
    });
  fireTarget(structure.elevator.nativeLift.driver, "Open");
  runtime.finaleElevatorRiding = true;
  // Source 1 StartFinaleElevatorLocal: CleanSelf every pizza within 350u.
  for (const owner of activeRuntimes()) {
    retireLinearZombieProjectiles(owner, deployable => deployable.kind === "pizzabaker"
      && Math.hypot(deployable.position.x - start.x, deployable.position.y - start.y, deployable.position.z - start.z) <= 350);
  }
  runtime.finaleElevatorOrigin = clone(start);
  runtime.finaleElevatorTarget = clone(target);
  runtime.finaleElevatorDebrisOrigin = clone(target);
  runtime.finaleElevatorDebrisStarted = false;
  runtime.finaleElevatorDebrisDone = false;
  runtime.rubbleProfile = {
    ...FINALE_ELEVATOR_RUBBLE_PROFILE,
    debrisDamage: runtime.infinite ? 102 : FINALE_ELEVATOR_RUBBLE_PROFILE.debrisDamage,
  };
  runtime.rubbleSpawnedCount = 0;
  runtime.nextRubbleAt = now + FINALE_STRUCTURE_CONFIG.elevatorDebrisStartDelay;
  startFinaleThunder(runtime, now);
  structure.notes.push(`native tower elevator started; estimated arrival=${structure.elevator.arrivalAt.toFixed(2)}; boss waits for OnFullyOpen`);
  message(`[FINALE DEBUG] tower elevator start=${start.z} target=${target.z} arrival=${structure.elevator.arrivalAt.toFixed(2)}`);
}

function moveFinaleTowerElevator(runtime, now, elapsed) {
  const structure = runtime?.finaleStructure;
  const elevator = structure?.elevator;
  if (!elevator || elevator.finished) return;
                                                                                
  const origin = elevator.nativeLift?.driver.GetAbsOrigin?.();
  if (origin) elevator.position = add(elevator.start, sub(origin, elevator.nativeLift.start));
}

function processFinaleElevatorDebris(runtime, now) {
  const structure = runtime?.finaleStructure;
  if (!structure?.elevator || !structure.elevatorLeaving) return;
  const elapsed = now - structure.elevator.startedAt;
  if (!runtime.finaleElevatorDebrisStarted
    && elapsed >= FINALE_STRUCTURE_CONFIG.elevatorDebrisStartDelay) {
    runtime.finaleElevatorDebrisStarted = true;
    runtime.rubbleProfile = {
      ...FINALE_ELEVATOR_RUBBLE_PROFILE,
      debrisDamage: runtime.infinite ? 102 : FINALE_ELEVATOR_RUBBLE_PROFILE.debrisDamage,
    };
    runtime.rubbleSpawnedCount = 0;
    runtime.nextRubbleAt = now;
    announce("FINALE: watch out from above!");
  }
  if (runtime.finaleElevatorDebrisStarted) {
    processRaceRubble(runtime, now);
    if (runtime.finaleElevatorDebrisDone && !structure.elevatorDebrisDone) {
      structure.elevatorDebrisDone = true;
      structure.elevatorDebrisFinishedAt ??= now;
      endingTaskAt(runtime, now + 2, () => {
        runtime.finaleElevatorRiding = false;
      }, `finale_elevator_riding_off_${runtime.sequence}`);
    }
  }
}

function processFinaleAntiBoost(runtime, now) {
  const structure = runtime?.finaleStructure;
  if (!structure?.antiBoostEnabled || runtime.finaleStructurePhase === "escape") return;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() !== 2 || !pawn.IsAlive?.()) continue;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    if (velocity.z > FINALE_STRUCTURE_CONFIG.antiBoostVelocity) {
      pawn.Teleport?.({ velocity: vec(velocity.x, velocity.y, FINALE_STRUCTURE_CONFIG.antiBoostDownVelocity) });
    }
  }
  structure.nextAntiBoostAt = now + FINALE_STRUCTURE_CONFIG.antiBoostRate;
}

function spawnFinaleWeatherParticle(runtime, key, position) {
  const spawned = spawnRoundEntities(featureTemplate(key), position, { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  if (spawned.length !== 1 || !validEntity(spawned[0]) || spawned[0].GetClassName?.() !== "info_particle_system") {
    destroyEntities(spawned);
    throw new Error(`${FEATURE_TEMPLATE_NAMES[key]} must spawn exactly one info_particle_system`);
  }
  const particle = spawned[0];
  runtime.finaleWeatherSpawnCount = (runtime.finaleWeatherSpawnCount ?? 0) + 1;
  particle.SetEntityName?.(`${key}_${runtime.sequence}_${runtime.finaleWeatherSpawnCount}`);
  runtime.entities.add(particle);
                                                                              
                                                                              
                                                                              
  particle.Teleport({ position, angles: { pitch: 0, yaw: 0, roll: 0 }, velocity: vec() });
  fireTarget(particle, "Start");
  return particle;
}

function processFinaleRain(runtime, now = Instance.GetGameTime()) {
  const thunder = runtime?.finaleThunder;
  if (!thunder?.enabled || runtime.kind !== "FINALE"
    || !["active", "spawning"].includes(runtime.lifecycle)
    || now + 1e-6 < thunder.startedAt + FINALE_THUNDER_CONFIG.startDelay) return false;
  if (now + 1e-6 < (runtime.finaleRainNextAt ?? 0)) return false;
  runtime.finaleRainNextAt = now + FINALE_RAIN_CONFIG.updateRate;
  const position = runtime.escape?.current?.entry ?? runtime.escape?.history?.at(-1)?.end
    ?? runtime.finaleStructure?.elevator?.position
    ?? runtime.bossArena?.center ?? runtime.topCenter ?? runtime.anchor;
  if (!validEntity(runtime.finaleRainParticle)) {
    if (runtime.finaleRainParticle) retireFinaleRainParticle(runtime, runtime.finaleRainParticle);
    runtime.finaleRainParticle = spawnFinaleWeatherParticle(runtime, "finaleRain", position);
    runtime.finaleRainStartedAt ??= now;
  } else {
                                                                             
                                                                             
    runtime.finaleRainParticle.Teleport({ position, velocity: vec() });
  }
  processFinaleRainGround(runtime, now);
  return true;
}

function retireFinaleRainParticle(runtime, particle) {
  if (validEntity(particle)) {
    fireTarget(particle, "DestroyImmediately");
    particle.Kill();
  }
  runtime.entities.delete(particle);
}

function processFinaleRainGround(runtime, now) {
  const emitters = runtime.finaleRainGround ??= new Map();
  const desired = new Map();
  const pawns = allLivingPawns();
  const offset = (runtime.finaleRainGroundCursor ?? 0) % Math.max(1, pawns.length);
  const checks = Math.min(pawns.length, FINALE_RAIN_CONFIG.maxGroundChecks);
                                                                               
  for (let i = 0; i < checks && desired.size < FINALE_RAIN_CONFIG.maxGroundEmitters; i++) {
    const pawn = pawns[(offset + i) % pawns.length];
    const origin = pawn.GetAbsOrigin?.();
    if (!origin || typeof Instance.TraceLine !== "function") continue;
    const trace = Instance.TraceLine({ start: add(origin, vec(0, 0, 8)),
      end: add(origin, vec(0, 0, -16)), ignoreEntity: pawn, ignorePlayers: true });
    const ground = trace?.position ?? trace?.end;
    if (!(trace?.didHit ?? trace?.hit) || !ground
      || ![ground.x, ground.y, ground.z].every(Number.isFinite)
      || (trace.normal && trace.normal.z < 0.5)) continue;
    const roof = Instance.TraceLine({ start: add(ground, vec(0, 0, 16)),
      end: add(ground, vec(0, 0, 4096)), ignoreEntity: pawn, ignorePlayers: true });
    if (roof?.didHit ?? roof?.hit) continue;
    const cell = FINALE_RAIN_CONFIG.groundCell;
    const key = `${Math.floor(ground.x / cell)},${Math.floor(ground.y / cell)},${Math.floor(ground.z / 16)}`;
    if (!desired.has(key)) desired.set(key, add(ground, vec(0, 0, 1)));
  }
                                                                          
                                                                         
  runtime.finaleRainGroundCursor = pawns.length > checks ? offset + checks : 0;
  for (const [key, record] of emitters) {
    if (!validEntity(record.particle) || (!desired.has(key)
      && now - record.lastSeen >= FINALE_RAIN_CONFIG.staleGroundTime)) {
      retireFinaleRainParticle(runtime, record.particle);
      emitters.delete(key);
    }
  }
  let created = 0;
  for (const [key, ground] of desired) {
    const record = emitters.get(key);
    if (record) {
      record.lastSeen = now;
      record.particle.Teleport({ position: ground, velocity: vec() });
    } else if (emitters.size < FINALE_RAIN_CONFIG.maxGroundEmitters
      && created < FINALE_RAIN_CONFIG.maxGroundCreates) {
      emitters.set(key, { particle: spawnFinaleWeatherParticle(runtime, "finaleRainGround", ground), lastSeen: now });
      created++;
    }
  }
}

function startFinaleThunder(runtime, now = Instance.GetGameTime()) {
  if (!runtime || runtime.kind !== "FINALE") return false;
  if (runtime.finaleThunder) return runtime.finaleThunder;
  const numericNow = Number(now);
  const startedAt = Number.isFinite(numericNow) ? numericNow : Instance.GetGameTime();
  runtime.finaleThunder = {
    enabled: true,
    startedAt,
    nextAt: startedAt + FINALE_THUNDER_CONFIG.startDelay,
    tickCount: 0,
    primaryPlayed: 0,
    secondaryPlayed: 0,
    visualSupported: state.featureTemplates.has("finaleThunder"),
    precipitationSupported: state.featureTemplates.has("finaleRain"),
    precipitationRequested: 2,
    note: FINALE_THUNDER_CONFIG.visualNote,
    history: [],
  };
  runtime.finaleStructure?.notes?.push?.(`thunder armed at ${runtime.finaleThunder.nextAt.toFixed(2)}; visual=${runtime.finaleThunder.visualSupported}`);
  return runtime.finaleThunder;
}

function processFinaleThunder(runtime, now = Instance.GetGameTime()) {
  const thunder = runtime?.finaleThunder;
  if (!thunder?.enabled || runtime.kind !== "FINALE" || runtime.lifecycle === "outcome_pending") return false;
                                                                         
                                                                          
  processFinaleRain(runtime, now);
  if (now + 1e-6 < thunder.nextAt) return false;

                                                                              
                                                                             
                                                                            
  const tickAt = now;
  thunder.tickCount++;
  const center = runtime.escape?.current?.entry ?? runtime.bossArena?.center ?? runtime.anchor;
  const angle = Math.random() * Math.PI * 2;
  const radius = 10000 + Math.random() * 5000;
  const position = add(center, vec(Math.cos(angle) * radius, Math.sin(angle) * radius, 2000 + Math.random() * 6000));
  for (const axis of ["x", "y", "z"]) position[axis] = Math.max(-14000, Math.min(14000, position[axis]));
  const flash = spawnFinaleWeatherParticle(runtime, "finaleThunder", position);
  endingTask(runtime, 0.35, () => {
    if (validEntity(flash)) flash.Kill();
    runtime.entities.delete(flash);
  });
  let primaryPlayed = false;
  let secondaryPlayed = false;
  if (Math.random() * 100 <= FINALE_THUNDER_CONFIG.soundChance) {
    primaryPlayed = playCatalogSound(FINALE_THUNDER_CONFIG.primarySound, vec(), {radius:0,lifetime:.5,...{
      pitch: 30 + Math.floor(Math.random() * 141),
      volume: 1 + Math.floor(Math.random() * 10),
    }});
    if (primaryPlayed) thunder.primaryPlayed++;
    if (Math.random() * 100 <= FINALE_THUNDER_CONFIG.secondarySoundChance) {
      const token = `thunder_dist_${1 + Math.floor(Math.random() * 3)}`;
      secondaryPlayed = playCatalogSound(token, vec(), {radius:0,lifetime:.5,...{
        pitch: 90 + Math.floor(Math.random() * 21),
      }});
      if (secondaryPlayed) thunder.secondaryPlayed++;
    }
  }
  thunder.history.push({ at: tickAt, primaryPlayed, secondaryPlayed, visualSupported: thunder.visualSupported });
  if (thunder.history.length > 64) thunder.history.shift();
  thunder.nextAt = now + FINALE_THUNDER_CONFIG.rateMin
    + Math.random() * (FINALE_THUNDER_CONFIG.rateMax - FINALE_THUNDER_CONFIG.rateMin);
  return true;
}

function stopFinaleThunder(runtime) {
  const thunder = runtime?.finaleThunder;
  if (!runtime) return false;
  const wasEnabled = thunder?.enabled === true;
  if (thunder) {
    thunder.enabled = false;
    thunder.stoppedAt = Instance.GetGameTime();
  }
  retireFinaleRainParticle(runtime, runtime.finaleRainParticle);
  for (const record of runtime.finaleRainGround?.values() ?? []) retireFinaleRainParticle(runtime, record.particle);
  runtime.finaleRainGround?.clear();
  runtime.finaleRainParticle = undefined;
  runtime.finaleRainNextAt = undefined;
  return wasEnabled;
}

function processFinaleStructure(runtime, now) {
  const structure = runtime?.finaleStructure;
  if (!runtime || !structure || !["active", "spawning"].includes(runtime.lifecycle)) return;
  if (!structure.lowgravDisabled) {
    const insideByPawn = runtime.finaleLowgravInside ??= new Map();
    for (const pawn of allLivingPawns()) {
      let active = insideByPawn.get(pawn);
      if (!active) insideByPawn.set(pawn, active = new Set());
      for (const request of structure.lowgravRequests ?? []) {
        const geometry = finaleLowgravGeometry(request);
        const delta = sub(pawn.GetAbsOrigin?.() ?? vec(), request.position);
        const along = delta.x * runtime.direction.x + delta.y * runtime.direction.y;
        const side = delta.x * runtime.left.x + delta.y * runtime.left.y;
        const inside = Math.abs(along) <= geometry.maxs.x
          && Math.abs(side) <= geometry.maxs.y
          && delta.z >= geometry.mins.z && delta.z <= geometry.maxs.z;
        const source = `${runtime.index}:finale_lowgrav:${request.role}`;
        if (inside && !active.has(request.role)) {
          active.add(request.role);
          addGravitySource(runtime, pawn, source, CONFIG.lowGravity, { engine: true, simulate: false });
          capGravitySlideVelocity(pawn);
        } else if (!inside && active.has(request.role)) {
          active.delete(request.role);
          removeGravitySource(pawn, source);
          capGravitySlideVelocity(pawn);
        }
      }
    }
  }
  if (structure.bridgeCleanupStarted && !structure.bridgeCleanupDone && now >= (structure.bridgeCleanupNextAt ?? now)) {
    structure.bridgeCleanupNextAt = now + FINALE_STRUCTURE_CONFIG.bridgeCleanupRate;
    structure.bridgeCleanupIndex++;
    const index = structure.bridgeCleanupIndex;
    const queue = structure.bridgeTpQueue ?? [];
    if (index < queue.length - 5) {
      moveTeleportDestination(queue[index], runtime.direction, true);
    } else if (index < queue.length - 3) {
      structure.bridgeZombieDelayUntil = now + FINALE_STRUCTURE_CONFIG.bridgeZombieDelay;
                                                                        
                                                                           
                                                                               
                          
      structure.bridgeCleanupNextAt = structure.bridgeZombieDelayUntil;
      setFinaleTowerDoorState(runtime, "closed");
      endingTaskAt(runtime, now + FINALE_STRUCTURE_CONFIG.bridgeZombieDelay,
        () => setFinaleTowerDoorState(runtime, "open"),
        `finaleTowerDoorOpenAfterBridge_${index}_${runtime.sequence}`);
    } else {
      structure.bridgeCleanupDone = true;
      const finalPosition = queue[queue.length - 1];
      if (finalPosition) moveTeleportDestination(finalPosition, runtime.direction, true);
    }
    // The teleport queue ends before the distance-based sweep reaches the
    // bridge tail. Collapse all remaining bridge pieces on the final handoff.
    const threshold = structure.bridgeCleanupDone ? Infinity
      : Math.max(0, index * (FINALE_STRUCTURE_CONFIG.bridgeCleanupStep / CONFIG.gridSize) - 2);
    for (const piece of structure.bridge ?? []) {
      if (piece.forward > threshold || piece.cleaned) continue;
      piece.cleaned = true;
      for (const entity of piece.entities ?? []) if (validEntity(entity)) beginEndingEntityFall(runtime, entity, 6, 80);
    }
    if (structure.bridgeCleanupDone && !structure.spawnPlatformFired) {
      structure.spawnPlatformFired = true;
      fireName("spawnplatform", "FireUser1");
    }
  }
  if (structure.towerCleanupStarted) {
    structure.towerCleanupNextAt ??= now;
    while (structure.towerCleanupIndex < structure.towerCleanupOrder.length && now >= structure.towerCleanupNextAt) {
      const piece = structure.towerCleanupOrder[structure.towerCleanupIndex++];
      structure.towerCleanupNextAt += FINALE_STRUCTURE_CONFIG.towerCleanupRate;
      for (const entity of piece.entities ?? []) {
        if (!validEntity(entity)) continue;
        beginEndingEntityFall(runtime, entity, 2, 40);
        piece.cleaned = true;
      }
    }
  }
  const elapsed = Math.max(0.01, Math.min(0.1, now - (runtime.lastFinaleStructureTickAt ?? now)));
  updateFinaleTowerDoor(runtime, elapsed);
  if (structure.elevator && !structure.elevator.finished) moveFinaleTowerElevator(runtime, now, elapsed);
  processFinaleElevatorDebris(runtime, now);
  if (structure.antiBoostEnabled && now >= (structure.nextAntiBoostAt ?? now)) processFinaleAntiBoost(runtime, now);
  if (structure.elevator && structure.elevator.finished && runtime.finaleElevatorRiding
    && structure.elevatorDebrisDone && now >= (structure.elevatorDebrisFinishedAt ?? now + 2)) {
    runtime.finaleElevatorRiding = false;
  }
  if (structure.bossReady && structure.arenaSpawned && runtime.bossMode === "boss"
    && !runtime.bossPhase && now >= (runtime.finalBossReadyAt ?? now)) {
    startFinaleBossFight(runtime);
  }
  updateFinaleZElevators(runtime, now, elapsed);
  runtime.lastFinaleStructureTickAt = now;
}

function buildFinaleGeometry(runtime) {
  runtime.layout = { pieces: [], groups: new Map() };
  const size = FINALE_CONFIG.pyramidSize;
  for (let forward = 0; forward < size; forward++) {
    for (let sideIndex = 0; sideIndex < size; sideIndex++) {
      const xDepth = Math.min(forward, size - 1 - forward);
      const yDepth = Math.min(sideIndex, size - 1 - sideIndex);
      const group = Math.min(xDepth, yDepth) + 1;
      const side = sideIndex - (size / 2 - 0.5);
      const position = endingPosition(runtime, forward, side, 0);
      const record = [];
      queueEndingTerrain(runtime, "floor", position, `pyramid_${group}_${forward}_${sideIndex}`, true, false, record);
      const piece = { forward, sideIndex, group, position, entities: record };
      runtime.layout.pieces.push(piece);
      if (!runtime.layout.groups.has(group)) runtime.layout.groups.set(group, []);
      runtime.layout.groups.get(group).push(piece);
    }
  }
  runtime.topCenter = endingPosition(runtime, size / 2 - 0.5, 0, 0);
}

function setupFinaleElevators(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  runtime.elevators = [];
  let height = 0;
  const startAt = Instance.GetGameTime() + 0.5;
  for (let group = 2; group <= FINALE_CONFIG.pyramidSize / 2; group++) {
    if (group < FINALE_CONFIG.pyramidSize / 2) height += FINALE_CONFIG.pyramidStepHeight;
    const lift = createFinaleNativeLift(runtime, runtime.layout.groups.get(group) ?? [], vec(0, 0, height),
      FINALE_CONFIG.stepRiseSpeed, `finalePyramid_${group}`, arrived => retireFinaleNativeLift(runtime, arrived));
    lift.group = group;
    runtime.elevators.push(lift);
    endingTaskAt(runtime, startAt, () => { if (!lift.retired) fireTarget(lift.driver, "Open"); },
      `finalePyramidStart_${group}_${runtime.sequence}`);
  }
  runtime.stepRiseStartedAt = Instance.GetGameTime();
}

function startFinaleDefense(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  runtime.defenseStartedAt = Instance.GetGameTime();
  runtime.defending = true;
  announce(`FINALE: defend the pyramid for ${FINALE_CONFIG.finalHoldTime} seconds`);
}

// Source RaiseFinalElevator(): ::Process(pq,0.20) reaches its third entry at
// ~0.6s, then drops every block_* except finalewinblock one per 0.02s, each
// non-solid for 0.80s plus a 13-step alpha fade. Zombies left on the pyramid
// or route fall into telehurt and die to the spawn killer.
const FINALE_TOP_COLLAPSE_CONFIG = Object.freeze({ delay: 0.6, rate: 0.02, lifetime: 1.06 });

function startFinaleTopCollapse(runtime, topPieces) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.finaleTopCollapseStartedAt !== undefined) return;
  const keep = new Set(topPieces.flatMap(piece => piece.entities ?? []));
  for (const lift of [...(runtime.finaleNativeLifts ?? [])]) if (!lift.final) retireFinaleNativeLift(runtime, lift);
  const queue = new Set();
  for (const owner of [runtime, ...state.levels.values()]) {
    if (!owner || owner.lifecycle === "destroyed") continue;
    for (const entity of [...(owner.terrainEntities ?? [])]) {
      if (keep.has(entity) || !validEntity(entity)) continue;
      if (owner !== runtime) {
        // Source block_* ignores ownership; take the route terrain so the
        // collapse retires it through this runtime instead of its level.
        owner.terrainEntities.delete(entity);
        owner.safeTerrainEntities?.delete?.(entity);
        owner.entities?.delete(entity);
        runtime.entities.add(entity);
        runtime.terrainEntities.add(entity);
        // Ladder surfaces follow their visual so the fall can retire them too.
        const companions = owner.terrainCompanions?.get(entity);
        if (companions) {
          owner.terrainCompanions.delete(entity);
          for (const companion of companions) {
            owner.entities?.delete(companion);
            runtime.entities.add(companion);
          }
          (runtime.terrainCompanions ??= new Map()).set(entity, companions);
        }
      }
      queue.add(entity);
    }
  }
  const now = Instance.GetGameTime();
  runtime.finaleTopCollapseStartedAt = now;
  runtime.finaleTopCollapseNextAt = now;
  runtime.finaleTopCollapseQueue = shuffleCopy([...queue]);
  runtime.finaleTopCollapseTotal = queue.size;
}

function processFinaleTopCollapse(runtime, now) {
  const queue = runtime.finaleTopCollapseQueue;
  if (!queue?.length || now < runtime.finaleTopCollapseNextAt) return;
  const rate = FINALE_TOP_COLLAPSE_CONFIG.rate;
  const due = Math.min(queue.length, 1 + Math.floor((now - runtime.finaleTopCollapseNextAt) / rate));
  runtime.finaleTopCollapseNextAt += due * rate;
  for (let index = 0; index < due; index++) {
    const entity = queue.shift();
    killTerrainCompanions(runtime, entity);
    if (!validEntity(entity)) continue;
    try { beginEndingEntityFall(runtime, entity, FINALE_TOP_COLLAPSE_CONFIG.lifetime); }
    catch { destroyEndingEntity(runtime, entity); }
  }
}

// Source finaleelevator_win Run(): EnableMassKillerAll() 100s after the top rises.
function finaleMassKill(runtime, scheduledAt) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.massKillTriggeredAt !== undefined) return;
  runtime.massKillTriggeredAt = scheduledAt;
  announce("FINALE: YOU TOOK TOO LONG - SLAYING");
  endingMassKillAll(runtime);
  resolveStageEnding(false);
}

function raiseFinaleTop(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
                                                                           
                                                                          
                 
  stopFinaleSky(runtime);
  runtime.finalRiseStartedAt = Instance.GetGameTime();
  runtime.finalRising = true;
  const pieces = [];
  for (const group of [FINALE_CONFIG.pyramidSize / 2 - 1, FINALE_CONFIG.pyramidSize / 2]) {
    for (const existing of runtime.elevators.filter(lift => lift.group === group)) retireFinaleNativeLift(runtime, existing);
    pieces.push(...(runtime.layout.groups.get(group) ?? []));
  }
  const lift = createFinaleNativeLift(runtime, pieces, vec(0, 0, FINALE_CONFIG.finalRiseDistance),
    FINALE_CONFIG.finalRiseSpeed, "finalePyramidTop", arrived => retireFinaleNativeLift(runtime, arrived));
  lift.final = true;
  runtime.elevators.push(lift);
  endingTask(runtime, 0.1, () => { if (!lift.retired) fireTarget(lift.driver, "Open"); });
  endingTask(runtime, FINALE_TOP_COLLAPSE_CONFIG.delay, () => startFinaleTopCollapse(runtime, pieces));
  // Source RaiseFinalElevator() fires EnableSpawnKiller(), which also slays flight.
  enableEndingSpawnKiller(runtime);
  const zombies = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 2);
  if (zombies.length <= 0) resolveStageEnding(true);
}

function updateFinaleElevators(runtime, elapsed) {
                                                                           
}

function finishFinaleSpawn(runtime) {
  if (!runtime || runtime.lifecycle !== "spawning" || runtime.remaining !== 0) return;
  transferEndingSourceOwnership(runtime);
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.startedAt = Instance.GetGameTime();
  runtime.lastElevatorTickAt = runtime.startedAt;
  runtime.elevators = [];
  if (runtime.bossMode === "boss") {
                                                                            
                                                                             
                                                                               
                                   
    startFinaleStructureTimeline(runtime);
    announce("FINALE ending started; the tower bridge is rising");
    return;
  }
  const runAt = runtime.runStartedAt;
  runtime.raceRubbleStarted = true;
  runtime.raceRubbleStopped = false;
  runtime.rubbleProfile = {
    ...FINALE_ESCAPE_RUBBLE_PROFILE,
    debrisDamage: runtime.infinite ? 16 : 11,
  };
  runtime.rubbleSpawnedCount = 0;
  runtime.nextRubbleAt = runAt;
  endingTaskAt(runtime, runAt + 5, () => {
                                                                            
                                                                   
    runtime.eventEvaluateInfiniteEnabled = false;
    runtime.infiniteKamikazeEnabled = false;
    runtime.noPrint = true;
  }, "finale_pyramid_quiet");
  endingTaskAt(runtime, runAt + FINALE_CONFIG.rubbleDisableDelay, () => {
    runtime.raceRubbleStopped = true;
    runtime.finalePyramidRubbleStoppedAt = Instance.GetGameTime();
  }, "finale_pyramid_rubble_stop");
  endingTaskAt(runtime, runAt, () => announce("FINALE: YOU REACHED THE END"), "finale_pyramid_reached");
  endingTaskAt(runtime, runAt + 8, () => announce("FINALE: THE TOP OF THE PYRAMID IS YOUR ESCAPE"), "finale_pyramid_escape_hint");
  endingTaskAt(runtime, runAt + 9, () => announce("FINALE: DEFEND IT WITH YOUR LIFE"), "finale_pyramid_defend_hint");
  endingTaskAt(runtime, runAt + FINALE_KAMIKAZE_CONFIG.delay,
    () => startFinaleKamikaze(runtime, "pyramid"), "finale_pyramid_kamikaze");
  endingTaskAt(runtime, runAt + FINALE_CONFIG.elevatorSetupDelay,
    () => setupFinaleElevators(runtime), "finale_pyramid_elevators");
  endingTaskAt(runtime, runAt + FINALE_CONFIG.defenseStartDelay,
    () => startFinaleDefense(runtime), "finale_pyramid_defense");
  endingTaskAt(runtime, runAt + FINALE_CONFIG.defenseStartDelay + FINALE_CONFIG.finalHoldTime,
    () => raiseFinaleTop(runtime), "finale_pyramid_rise");
  for (const seconds of [30, 20, 10, 5, 4, 3, 2, 1]) {
    const at = runAt + FINALE_CONFIG.defenseStartDelay + FINALE_CONFIG.finalHoldTime - seconds;
    endingTaskAt(runtime, at, () => announce(`FINALE: RISING IN ${seconds}s`), `finale_pyramid_rising_${seconds}`);
  }
  endingTaskAt(runtime, runAt + FINALE_CONFIG.defenseStartDelay + FINALE_CONFIG.finalHoldTime,
    () => announce("FINALE: RISING"), "finale_pyramid_rising_now");
  endingTaskAt(runtime, runAt + FINALE_CONFIG.defenseStartDelay + FINALE_CONFIG.finalHoldTime + FINALE_CONFIG.massKillDelay,
    () => {
                                                                              
                                                                              
                                      
      finaleMassKill(runtime, runAt + FINALE_CONFIG.defenseStartDelay
        + FINALE_CONFIG.finalHoldTime + FINALE_CONFIG.massKillDelay);
    }, "finale_pyramid_masskill");
  flushEndingTimeline(runtime, {
    finale_pyramid_quiet: () => {
      runtime.eventEvaluateInfiniteEnabled = false;
      runtime.infiniteKamikazeEnabled = false;
      runtime.noPrint = true;
    },
    finale_pyramid_elevators: () => setupFinaleElevators(runtime),
    finale_pyramid_defense: () => startFinaleDefense(runtime),
    finale_pyramid_rise: () => raiseFinaleTop(runtime),
    finale_pyramid_kamikaze: () => startFinaleKamikaze(runtime, "pyramid"),
    finale_pyramid_rising_30: () => announce("FINALE: RISING IN 30s"),
    finale_pyramid_rising_20: () => announce("FINALE: RISING IN 20s"),
    finale_pyramid_rising_10: () => announce("FINALE: RISING IN 10s"),
    finale_pyramid_rising_5: () => announce("FINALE: RISING IN 5s"),
    finale_pyramid_rising_4: () => announce("FINALE: RISING IN 4s"),
    finale_pyramid_rising_3: () => announce("FINALE: RISING IN 3s"),
    finale_pyramid_rising_2: () => announce("FINALE: RISING IN 2s"),
    finale_pyramid_rising_1: () => announce("FINALE: RISING IN 1s"),
    finale_pyramid_rising_now: () => announce("FINALE: RISING"),
    finale_pyramid_masskill: () => finaleMassKill(runtime, Instance.GetGameTime()),
  });
  announce("FINALE ending started; the pyramid is your escape");
}

                                                                                    
                                                                                   
function prepareFinaleMixedThemes(runtime, onReady) {
  const themes = [...FINALE_THEME_NAMES].filter(theme => theme !== "generic");
  let requested = false;
  const valid = () => state.endingRuntime === runtime && runtime.lifecycle === "preloading";
  const next = () => {
    if (!valid()) return;
    if (state.themePreload) {
      endingTaskAt(runtime, Instance.GetGameTime() + 0.05, next, "finale_model_preload_wait");
      return;
    }
    if (!requested) {
      requested = true;
      prepareThemeTerrainBatch(themes, (success, reason, failedThemes) => {
        if (!valid()) return;
        if (!success) {
          failRuntime(`Finale mixed-theme preload failed for '${failedThemes || "unknown"}' (${reason ?? "unknown"}); terrain generation cancelled`);
          return;
        }
        next();
      });
      return;
    }

    const startedAt = Instance.GetGameTime();
    const preloadDelay = startedAt - runtime.runStartedAt;
    runtime.runStartedAt = startedAt;
    if (Number.isFinite(runtime.nextGenericEventAt)) runtime.nextGenericEventAt += preloadDelay;
    runtime.finaleThemesReady = true;
    runtime.lifecycle = "spawning";
    runtime.lifecycleHistory.push("spawning");
    message(`Finale model preload finished after ${preloadDelay.toFixed(2)}s; building terrain`);
    try { onReady(); }
    catch (error) { failRuntime(`Finale construction failed after model preload: ${error}`); }
  };
  next();
}

function startFinaleEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning", "preloading"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  const mode = stageSnapshot?.finaleMode === "pyramid" || sourceRuntime?.finaleMode === "pyramid" ? "pyramid" : "boss";
  const missing = missingFinaleFeatureTemplates(mode);
  if (missing.length) throw new Error(`Finale missing required entities: ${missing.join(", ")}`);
  state.falldownCheckpointEnabled = false;
  state.finalePostImpostorUntil = 0;
  const runtime = createEndingRuntime("FINALE", stageSnapshot, sourceRuntime);
  runtime.finaleThemeRandom = true;
  runtime.finaleMapPoolCount = finaleMapPoolCount(runtime);
  runtime.infinite = stageSnapshot?.finaleInfiniteMusic === true
    || sourceRuntime?.finaleInfiniteMusic === true;
  runtime.eventEvaluateInfiniteEnabled = runtime.infinite;
  if (runtime.infinite) runtime.nextGenericEventAt = runtime.runStartedAt + genericInfiniteFinaleDelay();
                                                                             
                                                                            
  runtime.bossMode = mode;
  runtime.lifecycle = "preloading";
  runtime.lifecycleHistory.push("preloading");
  runtime.finaleThemesReady = false;
  prepareFinaleMixedThemes(runtime, () => {
    if (runtime.infinite && mode === "boss") prepareInfiniteFinaleEntrance(runtime);
    if (runtime.bossMode === "boss") buildFinaleStructure(runtime);
    else buildFinaleGeometry(runtime);
    setupFinaleSky(runtime);
  });
                                                                            
  return runtime;
}

function prepareInfiniteFinaleEntrance(runtime) {
                                                                          
                                                                            
  const direction = clone(runtime.direction);
  const left = leftOf(direction);
  const end = clone(runtime.anchor);
  const record = runtime.infiniteCheckoutBridge = [];
  for (let x = 0; x < 7; x++) for (const y of [-0.5, 0.5]) {
    const position = add(end, add(mul(direction, (x + 0.5) * CONFIG.gridSize), mul(left, y * CONFIG.gridSize)));
    queueEndingTerrain(runtime, "floor", position, `infinite_checkout_bridge_${x}_${y}`,
      false, true, record, anglesFor(direction));
  }
  const corner = add(end, mul(direction, 6 * CONFIG.gridSize));
  const choices = [vec(1), vec(-1), vec(0, 1), vec(0, -1)]
    .filter(next => next.x * direction.x + next.y * direction.y >= 0);
  for (let i = choices.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [choices[i], choices[j]] = [choices[j], choices[i]];
  }
  const next = choices.find(d => d.x > 0 ? corner.x + 12000 < 15500
    : d.x < 0 ? corner.x - 12000 > -15500
    : d.y > 0 ? corner.y + 12000 < 15500 : corner.y - 12000 > -15500) ?? direction;
  runtime.direction = clone(next);
  runtime.left = leftOf(next);
  runtime.anchor = add(corner, mul(next, CONFIG.gridSize));
                                                                         
                                                                        
                                                                            
  endingTask(runtime, 15, () => {
    const source = runtime.sourceRuntime;
    if (state.levels.get(source?.index) !== source || source.lifecycle === "destroyed") return;
    transferPickedItemState(source, runtime);
                                                                        
    for (const entity of record) {
      if (!validEntity(entity)) continue;
      for (const key of ["entities", "terrainEntities", "endingTerrainEntities", "externalEntities", "externalTerrainEntities"])
        runtime[key]?.delete(entity);
      source.entities.add(entity);
      source.terrainEntities.add(entity);
      const visual = state.silentHillWorld.visuals.get(entity);
      if (visual) visual.runtime = source;
    }
    beginLevelFade(source);
    source.sourceCleanupScheduled = true;
    const duration = Math.ceil((255 - 3) / source.fadeStep) * source.fadeInterval + 0.05;
    endingTask(runtime, duration, () => destroyLevel(source.index, false));
  });
}

function processFinaleEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "FINALE") return;
  if (runtime.lifecycle === "preloading") return;
  if (runtime.lifecycle === "outcome_pending") return;
  if (["spawning", "active"].includes(runtime.lifecycle)) processFinaleSky(runtime);
  processInfiniteFinaleEvents(runtime, Instance.GetGameTime());
  processFinaleThunder(runtime, Instance.GetGameTime());
  if (runtime.lifecycle === "spawning") {
                                                                        
                                                                           
                                                                            
                        
    processFinaleStructure(runtime, Instance.GetGameTime());
    processEndingSpawnQueue(runtime, runtime.finaleStructure?.arenaBuildRequested && !runtime.finaleStructure?.arenaSpawned
      ? finishFinaleBossArenaSpawn
      : finishFinaleSpawn);
    return;
  }
  if (runtime.lifecycle !== "active") return;
  if (runtime.bossMode === "boss" || runtime.bossPhase) {
    const now = Instance.GetGameTime();
    processFinaleMusic(runtime, now);
    if (runtime.bossPhase === "escape" || runtime.bossPhase === "boss_defeated") {
                                                                          
                                                                              
                                                                           
                                                                             
                                                                               
                                                              
      processFinaleBossFight(runtime);
      if (runtime.bossPhase === "boss_defeated") return;
      processFinaleKamikaze(runtime, now);
      processFinaleEscape(runtime);
      return;
    }
    processFinaleStructure(runtime, now);
    if (runtime.bossPhase === "boss_active" || runtime.bossPhase === "boss_intro") processFinaleBossFight(runtime);
    return;
  }
  const now = Instance.GetGameTime();
  const elapsed = Math.max(0.01, Math.min(0.1, now - runtime.lastElevatorTickAt));
  runtime.lastElevatorTickAt = now;
  updateFinaleElevators(runtime, elapsed);
  processFinaleTopCollapse(runtime, now);
  processFinaleSky(runtime, now, elapsed);
                                                                         
                                                                            
                                                            
  processRaceRubble(runtime, now);
  processFinaleKamikaze(runtime, now);
  const pawns = allLivingPawns();
  const humans = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 3);
  const zombies = pawns.filter((pawn) => pawn.GetTeamNumber?.() === 2);
  if (humans.length <= 0) resolveStageEnding(false);
  else if (runtime.finalRising && zombies.length <= 0) resolveStageEnding(true);
}

function finaleBossArenaCenter(runtime) {
  if (runtime?.bossArena?.center) return clone(runtime.bossArena.center);
  return clone(runtime?.topCenter ?? runtime?.anchor ?? vec());
}

function setupFinaleSky(runtime) {
  if (!runtime || runtime.kind !== "FINALE") return false;
  if (runtime.finaleSky) return runtime.finaleSky.clouds.length > 0;
  clearThemeModelSky();
                                                                         
                                                                       
  setCollectiveSkybox("generic");
  setFinaleSkyFog();
  const center = finaleSkyCenter(runtime);
  const clouds = [];
  const groups = [
    { name: "red", count: FINALE_SKY_CONFIG.cloudCount.red, color: FINALE_SKY_CONFIG.redColor, direction: 1 },
    { name: "black", count: FINALE_SKY_CONFIG.cloudCount.black, color: FINALE_SKY_CONFIG.blackColor, direction: -1 },
  ];
  for (const group of groups) {
    for (let index = 0; index < group.count; index++) {
      const yaw = Math.floor(Math.random() * 361);
      const position = add(center, vec(0, 0, FINALE_SKY_CONFIG.cloudOffsetZ));
      try {
        const visual = spawnVisual(runtime, {
          position,
          angles: { pitch: 0, yaw, roll: 0 },
          feature: `finaleSky_${group.name}_${index}`,
        }, FINALE_SKY_CONFIG.model);
        if (!validEntity(visual)) throw new Error("cloud visual did not spawn");
        visual.SetModelScale?.(FINALE_SKY_CONFIG.modelScale);
        visual.SetColor?.(group.color);
        fireTarget(visual, "SetDefaultAnimation", "baseidle");
        fireTarget(visual, "SetAnimation", "baseidle");
                                                                             
                                                                             
                                                                           
        fireTarget(visual, "SetRenderMode", "2");
        fireTarget(visual, "SetRenderAlpha", "255");
        fireTarget(visual, "SetSolid", "0");
        visual.SetEntityName?.(`finale_sky_${runtime.sequence}_${group.name}_${index}`);
        clouds.push({
          visual,
          group: group.name,
          center: clone(center),
          yaw,
          direction: group.direction,
        });
      } catch (error) {
        runtime.finaleStructure?.notes?.push?.(`sky ${group.name}_${index} unavailable: ${error}`);
      }
    }
  }
  runtime.finaleSky = {
    clouds,
    rotating: clouds.length > 0,
    rotation: 0,
    startedAt: Instance.GetGameTime(),
    lastTickAt: Instance.GetGameTime(),
    stoppedAt: undefined,
    setupFailed: clouds.length === 0,
  };
  if (clouds.length === 0) {
    runtime.finaleStructure?.notes?.push?.("finale sky cloud model unavailable; continuing without cloud overlay");
    return false;
  }
  return true;
}

function finaleSkyCenter(runtime) {
                                                                      
                                                                     
  const z = state.currentLevel?.end?.z ?? runtime?.sourceRuntime?.end?.z ?? 0;
  return vec(0, 0, Number.isFinite(z) ? z : 0);
}

function setFinaleSkyFog() {
  const fog = Instance.FindEntityByName("fog");
  if (!validEntity(fog)) return false;
  fireTarget(fog, "SetFogColor", "0 0 0");
  fireTarget(fog, "SetFogStartDistance", String(FINALE_SKY_CONFIG.fogStart));
  fireTarget(fog, "SetFogEndDistance", String(FINALE_SKY_CONFIG.fogEnd));
  fireTarget(fog, "SetFogMaxOpacity", String(FINALE_SKY_CONFIG.fogOpacity));
  fireTarget(fog, "Enable");
  return true;
}

function processFinaleSky(runtime, now = Instance.GetGameTime(), elapsed) {
  const sky = runtime?.finaleSky;
  if (!sky?.rotating || sky.clouds.length === 0) return false;
                                                                          
                                                                   
  if (sky.lastTickAt >= now) return false;
  const delta = elapsed ?? now - (sky.lastTickAt ?? now);
  const step = FINALE_SKY_CONFIG.rotationSpeed * Math.max(0, Math.min(0.1, Number(delta) || 0));
  sky.rotation = normalizeYaw(sky.rotation + step);
  const center = finaleSkyCenter(runtime);
  for (const cloud of sky.clouds) {
    if (!validEntity(cloud.visual)) continue;
    const angles = {
      pitch: 0,
      yaw: normalizeYaw(cloud.yaw + cloud.direction * sky.rotation),
      roll: 0,
    };
    cloud.visual.Teleport?.({
      position: add(center, vec(0, 0, FINALE_SKY_CONFIG.cloudOffsetZ)),
      angles,
      velocity: vec(),
    });
    cloud.center = clone(center);
  }
  sky.lastTickAt = now;
  sky.tickCount = (sky.tickCount ?? 0) + 1;
  return true;
}

function stopFinaleSky(runtime) {
  const sky = runtime?.finaleSky;
  if (!sky || !sky.rotating) return false;
  sky.rotating = false;
  sky.stoppedAt = Instance.GetGameTime();
  return true;
}

function finaleBossAliveHumans() {
  return allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3 && pawn.IsAlive?.());
}

function finaleMapPoolCount(runtime) {
  const explicit = Number(runtime?.finaleMapPoolCount);
  if (Number.isFinite(explicit) && explicit > 0) return Math.floor(explicit);
                                                                              
                                                                             
                                                                               
  const pool = Array.isArray(ALL_LEVELS) ? ALL_LEVELS.length
    : Array.isArray(LEVELS) ? LEVELS.length : 1;
  return Math.max(1, Number(pool) || 1);
}

function finaleEscapeLevelPlan(runtime) {
  const infiniteExtraStack = runtime?.infinite === true
    ? Math.min(
      FINALE_ESCAPE_CONFIG.infiniteLevelAddCap,
      finaleMapPoolCount(runtime) * FINALE_ESCAPE_CONFIG.infiniteLevelAddPerStage,
    )
    : 0;
  const infiniteExtraLevels = Math.floor(infiniteExtraStack);
  return {
    levelTarget: FINALE_ESCAPE_CONFIG.levelAmount + infiniteExtraLevels,
    infiniteExtraStack,
    infiniteExtraLevels,
  };
}

function finaleBossDamageMultiplier(runtime, infinite = false) {
  const stagePool = finaleMapPoolCount(runtime);
  const poolAdd = Math.min(
    FINALE_BOSS_CONFIG.damageMultiplierStageCap,
    stagePool * FINALE_BOSS_CONFIG.damageMultiplierStageEach,
  );
  return FINALE_BOSS_CONFIG.damageMultiplierBase
    + poolAdd
    + (infinite ? FINALE_BOSS_CONFIG.damageMultiplierInfiniteAdd : 0);
}

function finaleBossSpawnCount(runtime, infinite = false) {
  const stagePool = finaleMapPoolCount(runtime);
  const stack = infinite ? Math.min(
    FINALE_BOSS_CONFIG.spawnAmountCap,
    stagePool * FINALE_BOSS_CONFIG.spawnAmountStageEach,
  ) : 0;
  const count = Math.floor(FINALE_BOSS_CONFIG.spawnAmount + stack + (infinite ? FINALE_BOSS_CONFIG.spawnAmountInfiniteAdd : 0));
  return Math.max(1, Math.min(FINALE_BOSS_CONFIG.spawnAmountCap, count));
}

function finaleBossHealth(runtime, aliveHumans, count, infinite = false) {
  const stagePool = finaleMapPoolCount(runtime);
  const stageAdd = Math.min(FINALE_BOSS_CONFIG.healthStageCap, stagePool * FINALE_BOSS_CONFIG.healthPerStage);
  const perHuman = infinite ? FINALE_BOSS_CONFIG.healthPerHumanInfinite : FINALE_BOSS_CONFIG.healthPerHuman;
  return Math.max(1, Math.floor(
    (FINALE_BOSS_CONFIG.healthBase + aliveHumans * perHuman + stageAdd) / Math.max(1, count),
  ));
}

function finaleBossEntityPosition(entity, fallback) {
  return clone(entity?.GetAbsOrigin?.() ?? fallback ?? vec());
}

function finaleBossSyncHitbox(boss, hitbox, position) {
  if (!validEntity(hitbox)) return;
  if (validEntity(boss.visual) && hitbox.GetParent?.() === boss.visual) return;
  hitbox.Teleport?.({ position, angles: boss.angles, velocity: vec() });
}

function finaleBossTrigger(runtime, boss, role, mins, maxs) {
  const trigger = spawnTriggerVolume(runtime, {
    templateKey: FINALE_BOSS_CONFIG.eyeTouchTemplateKey,
    position: boss.position,
    angles: boss.angles,
    feature: `finaleBoss_${role}_${boss.id}`,
  }, mins, maxs);
  if (!trigger) throw new Error(`FINALE boss ${role} hitbox did not spawn`);
  trigger.SetEntityName?.(`finale_boss_${role}_${boss.id}`);
                                                                          
                                                                           
  trigger.finaleHitboxRole = role;
  trigger.finaleCollisionGroup = FINALE_BOSS_CONFIG.collisionGroup;
  trigger.finaleHitboxSizeConfigured = true;
  trigger.finaleHitboxMins = mins;
  trigger.finaleHitboxMaxs = maxs;
  trigger.SetParent?.(boss.visual);
  trigger.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
  fireTarget(trigger, "Enable");
  boss.hitboxes.add(trigger);
  return trigger;
}

const FINALE_BOSS_HITBOX_HEALTH_BASE = 500000;

function spawnFinaleBossDamageHitbox(runtime, boss, mins, maxs, role = "damage") {
  const grenade = role === "grenade";
  const key = role === "checkout" ? FINALE_BOSS_CONFIG.checkoutDamageTemplateKey
    : grenade ? FINALE_BOSS_CONFIG.grenadeDamageTemplateKey : FINALE_BOSS_CONFIG.eyeDamageTemplateKey;
  const model = role === "checkout" ? FINALE_BOSS_CONFIG.checkoutDamageModel
    : grenade ? FINALE_BOSS_CONFIG.grenadeDamageModel : FINALE_BOSS_CONFIG.eyeDamageModel;
  const spawned = spawnRoundEntities(featureTemplate(key), boss.position, boss.angles) ?? [];
  finalizeSpawned(runtime, { position: boss.position, angles: boss.angles,
    feature: `finaleBoss_${role}_${boss.id}` }, spawned);
  const damageable = spawned.length === 1 && spawned[0];
  if (!validEntity(damageable) || !String(damageable.GetClassName?.()).startsWith("prop_physics")
    || typeof damageable.SetHealth !== "function"
    || String(damageable.GetModelName?.()).replace(/_c$/i, "") !== model) {
    for (const entity of spawned) { entity?.Kill?.(); runtime.entities.delete(entity); }
    throw new Error(`FINALE boss ${role} requires its authored physics hitbox (${model})`);
  }
  const health = FINALE_BOSS_HITBOX_HEALTH_BASE + (grenade ? 500000 : boss.maxHealth);
  damageable.SetEntityName?.(`finale_boss_${role}_${boss.id}`);
  damageable.finaleHitboxRole = role;
  damageable.finaleHitboxTemplate = key;
  damageable.finaleHitboxHealthBase = FINALE_BOSS_HITBOX_HEALTH_BASE;
  damageable.SetMaxHealth?.(health);
  damageable.SetHealth?.(health);
  if (grenade) boss.grenadeHitboxHealth = health;
  else {
    boss.damageHitboxHealth = health;
    boss.damageHitboxTemplate = key;
  }
  damageable.finaleHitboxSizeConfigured = true;
  damageable.finaleHitboxMins = mins;
  damageable.finaleHitboxMaxs = maxs;
                                                                             
                                                                             
  damageable.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(damageable, "SetRenderMode", "1");
  fireTarget(damageable, "SetRenderAlpha", "0");
  raceSetCollisionGroup(damageable, FINALE_BOSS_CONFIG.collisionGroup);
  fireTarget(damageable, "DisableMotion");
  damageable.SetParent?.(boss.visual);
  damageable.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
  boss.hitboxes.add(damageable);
  return damageable;
}

function finaleBossGrenadeHitboxEvent(runtime, boss, event, source = "take") {
  if (!runtime || !boss || boss.dead || ["destroyed", "resolved", "outcome_pending"].includes(runtime.lifecycle)) return false;
  const hitbox = boss.grenadeHitbox;
  if (!validEntity(hitbox)) return false;
  const current = Number(hitbox.GetHealth?.());
  const previous = Number(boss.grenadeHitboxHealth);
  if (!Number.isFinite(current) || !Number.isFinite(previous)) return false;
  if (current >= previous) {
    if (source === "take" && !boss.grenadeHitboxReadQueued) {
      boss.grenadeHitboxReadQueued = true;
      afterThink(() => {
        boss.grenadeHitboxReadQueued = false;
        if (validEntity(hitbox)) finaleBossGrenadeHitboxEvent(runtime, boss, event, "health");
      });
    }
    return false;
  }
                                                                        
                                                                            
                                                                            
  boss.grenadeHitboxHealth = current;
  boss.grenadeHitCount = (boss.grenadeHitCount ?? 0) + 1;
  runtime.bossGrenadeHitCount = (runtime.bossGrenadeHitCount ?? 0) + 1;
                                                                           
                                                                             
  if (validEntity(boss.damageHitbox)) finaleBossDamageHitboxEvent(runtime, boss, event, "health");
  const critical = Math.random() * 100 <= FINALE_BOSS_CONFIG.grenadeCritChance;
  return damageFinaleBoss(runtime, boss, FINALE_BOSS_CONFIG.grenadeDamage,
    event?.activator ?? event?.attacker, { critical, grenade: true });
}

function finaleBossDamageHitboxEvent(runtime, boss, event, source = "take") {
  if (!runtime || !boss || boss.dead || ["destroyed", "resolved", "outcome_pending"].includes(runtime.lifecycle)) return false;
  const currentHealth = Number(boss.damageHitbox?.GetHealth?.());
  const baseline = Number(boss.damageHitboxHealth ?? 0);
                                                                          
                                                                           
                                                                     
  if (!Number.isFinite(currentHealth) || !(baseline > currentHealth)) {
    if (source === "take" && !boss.damageHitboxReadQueued) {
      boss.damageHitboxReadQueued = true;
      afterThink(() => {
        boss.damageHitboxReadQueued = false;
        if (validEntity(boss.damageHitbox)) finaleBossDamageHitboxEvent(runtime, boss, event, "health");
      });
    }
    return false;
  }
  const damage = baseline - currentHealth;
  const attacker = event?.attacker ?? event?.inflictor ?? event?.activator;
  boss.damageHitboxHealth = currentHealth;
  return damageFinaleBoss(runtime, boss, damage, attacker, { nativeHealth: true });
}

function pointInsideFinaleBox(position, center, angles, mins, maxs) {
  if (!position || !center) return false;
  const relative = sub(position, center);
  const forward = forwardFromAngles(angles ?? {});
  const left = leftFromAngles(angles ?? {});
  const up = upFromAngles(angles ?? {});
  const localX = relative.x * forward.x + relative.y * forward.y + relative.z * forward.z;
  const localY = relative.x * left.x + relative.y * left.y + relative.z * left.z;
  const localZ = relative.x * up.x + relative.y * up.y + relative.z * up.z;
  return localX >= mins.x && localX <= maxs.x
    && localY >= mins.y && localY <= maxs.y
    && localZ >= mins.z && localZ <= maxs.z;
}

function finaleBossPieceTouchesPawn(piece, pawn) {
  const hull = playerCollisionHull(pawn);
  if (!piece?.position || !hull) return false;
                                                                         
                                                                          
                                                                         
  const basis = [
    forwardFromAngles(piece.angles ?? {}),
    leftFromAngles(piece.angles ?? {}),
    upFromAngles(piece.angles ?? {}),
  ];
  const world = [vec(1, 0, 0), vec(0, 1, 0), vec(0, 0, 1)];
  const half = [46, 46, 15];                                                   
  const offset = mul(basis[2], -15);
  const difference = sub(hull.center, add(piece.position, offset));
  const playerHalf = [hull.halfWidth, hull.halfWidth, hull.halfHeight];
  const dot = (a, b) => a.x * b.x + a.y * b.y + a.z * b.z;
  const overlapsOn = (axis) => {
    const playerRadius = world.reduce((sum, direction, i) => sum + playerHalf[i] * Math.abs(dot(axis, direction)), 0);
    const pieceRadius = basis.reduce((sum, direction, i) => sum + half[i] * Math.abs(dot(axis, direction)), 0);
    return Math.abs(dot(difference, axis)) <= playerRadius + pieceRadius + 0.000001;
  };
  for (const axis of [...world, ...basis]) if (!overlapsOn(axis)) return false;
  for (const a of world) for (const b of basis) {
    const axis = vec(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
    if (dot(axis, axis) > 0.00000001 && !overlapsOn(axis)) return false;
  }
  return true;
}

function finaleBossFallTouch(runtime, pawn, now = Instance.GetGameTime()) {
  if (!runtime || !pawn?.IsAlive?.()) return false;
  const center = finaleBossArenaCenter(runtime);
  const origin = add(center, vec(0, 0, -FINALE_BOSS_CONFIG.fallTriggerZOffset));
  const position = pawn.GetAbsOrigin?.();
  if (!position || !pointInsideFinaleBox(
    position,
    origin,
    { yaw: 0 },
    FINALE_BOSS_CONFIG.fallTriggerMins,
    FINALE_BOSS_CONFIG.fallTriggerMaxs,
  )) return false;
  runtime.bossFallTouchCooldowns ??= new Map();
  if ((runtime.bossFallTouchCooldowns.get(pawn) ?? 0) > now) return false;
  runtime.bossFallTouchCooldowns.set(pawn, now + 0.2);
  if (pawn.GetTeamNumber?.() !== 3) {
    pawn.Teleport?.({ position: vec(0, 0, -16160), velocity: vec() });
    return true;
  }
  damagePawn(pawn, FINALE_BOSS_CONFIG.fallTriggerHumanDamage * (runtime.bossDamageMultiplier ?? 1));
  if (!pawn.IsAlive?.()) return true;
  const boss = [...(runtime.bosses ?? [])].find((candidate) => !candidate.dead);
  let direction = boss ? sub(finaleBossArenaCenter(runtime), boss.position) : vec(1, 0, 0);
  direction.z = 0;
  const length = Math.hypot(direction.x, direction.y) || 1;
  direction = vec(direction.x / length, direction.y / length, 0);
  const safe = add(finaleBossArenaCenter(runtime), mul(direction,
    (FINALE_BOSS_CONFIG.arenaHalfSize * CONFIG.gridSize) + 500));
  pawn.Teleport?.({
    position: safe,
    velocity: add(mul(direction, -600), vec(0, 0, 595)),
  });
  return true;
}

function processFinaleBossEyeTouch(runtime, boss, humans) {
  if (!runtime || !boss || boss.dead) return;
  for (const pawn of humans ?? []) {
    const position = pawn.GetAbsOrigin?.();
    if (!pointInsideFinaleBox(position, boss.position, boss.angles,
      FINALE_BOSS_CONFIG.eyeMins, FINALE_BOSS_CONFIG.eyeMaxs)) continue;
    finaleBossTouchDamage(runtime, boss, pawn, FINALE_BOSS_CONFIG.eyeTouchDamage, boss.hitbox);
  }
}

function spawnFinaleBossFallTrigger(runtime) {
  if (validEntity(runtime.bossFallTrigger)) return runtime.bossFallTrigger;
  try {
    const center = finaleBossArenaCenter(runtime);
    const trigger = spawnTriggerVolume(runtime, {
      position: add(center, vec(0, 0, -FINALE_BOSS_CONFIG.fallTriggerZOffset)),
      angles: anglesFor(runtime.direction),
      feature: "finaleBossFallTrigger",
    }, FINALE_BOSS_CONFIG.fallTriggerMins, FINALE_BOSS_CONFIG.fallTriggerMaxs);
    trigger.SetEntityName?.(`finale_boss_fall_${runtime.sequence}`);
    trigger.finaleCollisionGroup = FINALE_BOSS_CONFIG.collisionGroup;
    trigger.finaleFallDamage = FINALE_BOSS_CONFIG.fallTriggerHumanDamage;
    connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      const pawn = resolvePawn(data?.activator ?? data);
      if (!pawn?.IsAlive?.()) return;
      finaleBossFallTouch(runtime, pawn);
    });
    fireTarget(trigger, "Enable");
    runtime.bossFallTrigger = trigger;
    return trigger;
  } catch (error) {
    runtime.bossArena ??= {};
    runtime.bossArena.fallTriggerNote = `fall trigger unavailable: ${error}`;
    return undefined;
  }
}

function finaleBossIsGrenade(entity) {
  if (!validEntity(entity)) return false;
  const className = String(entity.GetClassName?.() ?? "").toLowerCase();
  const name = entityName(entity).toLowerCase();
  return className.includes("grenade")
    || className.includes("projectile")
    || name.includes("grenade")
    || name.includes("hegrenade");
}

function finaleBossTouchDamage(runtime, boss, pawn, amount, source) {
  if (!pawn?.IsAlive?.() || pawn.GetTeamNumber?.() !== 3 || boss.dead) return false;
  const now = Instance.GetGameTime();
  const until = boss.touchCooldowns.get(pawn) ?? 0;
  if (until > now) return false;
  boss.touchCooldowns.set(pawn, now + FINALE_BOSS_CONFIG.eyeTouchCooldown);
  damagePawn(pawn, amount * (runtime.bossDamageMultiplier ?? 1), undefined, source);
  return true;
}

function finaleBossLivingTargets() {
  const targets = [];
  for (const runtime of activeRuntimes()) {
    if (runtime?.kind !== "FINALE" || !["boss_intro", "boss_active"].includes(runtime.bossPhase)) continue;
    for (const boss of runtime.bosses ?? []) {
      if (!boss.dead && boss.position) targets.push({ runtime, boss });
    }
  }
  return targets;
}

                                                                            
                                                                             
                                                    
function hurtFinaleBossAt(position, radius, damage, stunChance = 0, stunTimeAdd = 0, attacker, source = "item") {
  if (!position || !Number.isFinite(Number(radius)) || Number(radius) < 0) return 0;
  let hits = 0;
  for (const { runtime, boss } of finaleBossLivingTargets()) {
    const bossPosition = boss.position;
    if (Math.hypot(
      bossPosition.x - position.x,
      bossPosition.y - position.y,
      bossPosition.z - position.z,
    ) > Number(radius)) continue;
    const critical = Math.random() * 100 <= Number(stunChance);
    if (!damageFinaleBoss(runtime, boss, damage, attacker, {
      critical,
      stunTimeAdd,
      source,
    })) continue;
    hits++;
                                                                              
                                                                             
                                                                            
    runtime.bossHurtFxCount ??= 0;
    if (runtime.bossHurtFxCount >= FINALE_BOSS_CONFIG.hurtFxLimit) continue;
    runtime.bossHurtFxCount++;
    endingTask(runtime, FINALE_BOSS_CONFIG.hurtFxDuration, () => {
      runtime.bossHurtFxCount = Math.max(0, (runtime.bossHurtFxCount ?? 1) - 1);
    });
    playSourceAudioCue(13601, boss.position);
    const effectCount = critical ? 2 : 1;
    playFinaleBossTerrorBurst(boss.position, effectCount, effectCount, 230, 255);
  }
  return hits;
}

function damageFinaleBoss(runtime, bossOrId, damage, attacker, options = {}) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.bossPhase === "escape") return false;
  const boss = typeof bossOrId === "object"
    ? bossOrId
    : [...(runtime.bosses ?? [])].find((candidate) => candidate.id === bossOrId);
  const amount = Number(damage);
  if (!boss || boss.dead || !Number.isFinite(amount) || amount <= 0) return false;
                                                                             
                                                                         
  const applied = amount;
  boss.health = Math.max(0, boss.health - applied);
  if (!options.nativeHealth && !boss.dead && validEntity(boss.damageHitbox)) {
    boss.damageHitboxHealth = FINALE_BOSS_HITBOX_HEALTH_BASE + boss.health;
    boss.damageHitbox.SetHealth?.(boss.damageHitboxHealth);
  }
  boss.lastDamageAt = Instance.GetGameTime();
  boss.damageEvents.push({ at: boss.lastDamageAt, amount: applied, attacker, critical: options.critical === true });
  if (options.grenade || (attacker && finaleBossIsGrenade(attacker))) playSourceAudioCue(15021, boss.position);
  if (options.critical === true) {
    const stunMax = runtime.infinite ? FINALE_BOSS_CONFIG.stunMaxInfinite : FINALE_BOSS_CONFIG.stunMax;
    const now = Instance.GetGameTime();
    const isNewStun = boss.stunJustStunned !== false;
    const currentStun = Math.max(boss.stunUntil ?? 0, now);
    const stunAdd = Math.max(0, Number(options.stunTimeAdd ?? FINALE_BOSS_CONFIG.grenadeCritStun));
    boss.stunUntil = Math.min(now + stunMax, currentStun + Math.min(stunAdd, stunMax));
    boss.stunWasActive = true;
    boss.stunJustStunned = false;
    boss.midspin = false;
    boss.midspinStartedAt = 0;
    boss.midspinDropAt = 0;
    boss.midspinUntil = 0;
    boss.tailAim = false;
    boss.lowDrift = false;
    boss.eyelidOpen = true;
    boss.tailSnapPosition = undefined;
    boss.tailSnapActive = false;
    boss.tailSnapUntil = 0;
    boss.tailSnapClearAt = 0;
    boss.tailSnapLiftResetAt = 0;
    boss.flingUntil = 0;
    boss.flingAppliedAt = 0;
    for (const piece of boss.pieces ?? []) piece.isSnap = false;
    if (isNewStun) {
      finaleBossSetAnimation(boss, "idle_open_frenzy", "idle_open_frenzy", 3 + Math.random() * 3);
      playSourceAudioCue(14625, boss.position, { parent: boss.visual, pitch: 40 + Math.floor(Math.random() * 21) });
      playSourceAudioCue(14626, boss.position, { parent: boss.visual, pitch: 130 + Math.floor(Math.random() * 21) });
    }
  }
  if (validEntity(boss.visual)) {
                                                                           
                                                                              
                                                              
    const now = Instance.GetGameTime();
    if ((boss.damageFxCooldownUntil ?? 0) <= now) {
      boss.damageFxCooldownUntil = now + FINALE_BOSS_CONFIG.damageFxCooldown;
      const visual = boss.visual;
      const flash = boss.damageFlashSerial = (boss.damageFlashSerial ?? 0) + 1;
      visual.SetColor?.({ r: 255, g: 130, b: 130, a: 255 });
                                                                           
                                                                          
      schedule(0.03, () => {
        if (boss.dead || runtime.lifecycle === "destroyed" || boss.visual !== visual
          || boss.damageFlashSerial !== flash || !validEntity(visual)) return;
        visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
      }, runtime.index);
      const ratio = boss.maxHealth > 0 ? boss.health / boss.maxHealth : 0;
      const skin = Math.max(0, Math.min(6, Math.floor((1 - ratio) * 10 - 2.5)));
      fireTarget(boss.visual, "Skin", String(skin));
    }
  }
  if (boss.health <= 0) defeatFinaleBoss(runtime, boss);
  return true;
}

function defeatFinaleBoss(runtime, boss) {
  if (!boss || boss.dead) return;
  const anotherBossAlive = [...(runtime.bosses ?? [])]
    .some((candidate) => candidate !== boss && !candidate.dead);
  boss.dead = true;
  boss.deadAt = Instance.GetGameTime();
                                                                         
                                                                             
                                                    
  if (!anotherBossAlive) {
    const arena = finaleBossArenaCenter(runtime);
    runtime.finaleCleanerPosition = vec(boss.position.x, boss.position.y, arena.z);
  }
  for (const piece of boss.pieceCollectBuffer ?? []) piece.bossCollectQueued = false;
  boss.pieceCollectBuffer?.splice?.(0);
  if (anotherBossAlive) {
                                                                            
                                                           
    boss.deadVelocity = vec(
      Math.random() * 20 - 10,
      Math.random() * 20 - 10,
      20 + Math.random() * 10,
    );
  } else {
    const towardArena = directionBetween3D(boss.position, finaleBossArenaCenter(runtime));
    boss.deadVelocity = add(mul(towardArena, Math.random() * 10), vec(0, 0, 24 + Math.random() * 2));
  }
  boss.deadRotation = vec(Math.random() * 10 - 5, Math.random() * 10 - 5, Math.random() * 10 - 5);
  for (const hitbox of boss.hitboxes ?? []) fireTarget(hitbox, "Disable");
                                                                          
                                                                            
                                                                      
                                
  for (const hitbox of [boss.damageHitbox, boss.grenadeHitbox]) {
    if (!validEntity(hitbox)) continue;
    hitbox.Kill?.();
    runtime.entities.delete(hitbox);
  }
  boss.damageHitbox = undefined;
  boss.grenadeHitbox = undefined;
  const deathPlaybackRate = 7 + Math.random() * 3;
  boss.animationState = "idle_open_frenzy";
  boss.animationHistory ??= [];
  boss.animationHistory.push({
    sequence: "idle_open_frenzy",
    idle: "idle_open_frenzy",
    appliedSequence: "idle_open_frenzy",
    appliedIdle: "idle_open_frenzy",
    at: boss.deadAt,
    playbackRate: deathPlaybackRate,
  });
  fireTarget(boss.visual, "SetAnimation", "idle_open_frenzy", 0.04);
  fireTarget(boss.visual, "SetDefaultAnimation", "idle_open_frenzy", 0.05);
  fireTarget(boss.visual, "SetPlaybackRate", String(deathPlaybackRate), 0.03);
  boss.visual?.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
  playSourceAudioCue(14985, boss.position, { parent: boss.visual, pitch: 220 + Math.floor(Math.random() * 36) });
  playSourceAudioCue(14986, boss.position, { parent: boss.visual, pitch: 130 + Math.floor(Math.random() * 21) });
                                                                            
                                                                             
                                                                       
  const remaining = [...(runtime.bosses ?? [])].some((candidate) => !candidate.dead);
  if (remaining) {
    runtime.bossPhase = "boss_active";
    return;
  }
  runtime.bossPhase = "boss_defeated";
  if (runtime.bossEscapeScheduled) return;
  runtime.bossEscapeScheduled = true;
                                                                           
                                                                           
                                                  
  for (const delay of [3, 6]) {
    endingTaskAt(runtime, boss.deadAt + delay, () => boostFallingFinaleHumans(runtime), `finale_boss_save_${delay}_${runtime.sequence}`);
  }
                                                                           
                                                                             
                                                                              
  endingTaskAt(runtime, boss.deadAt + FINALE_BOSS_CONFIG.deathEscapeDelay - 0.02, () => {
    if (!boss.dead || runtime.bossPhase !== "boss_defeated") return;
    const arena = finaleBossArenaCenter(runtime);
    runtime.finaleCleanerPosition = vec(boss.position.x, boss.position.y, arena.z);
  }, `finale_boss_cleaner_${runtime.sequence}`);
  endingTask(runtime, FINALE_BOSS_CONFIG.deathEscapeDelay, () => beginFinaleEscape(runtime), "finale_boss_escape");
}

function boostFallingFinaleHumans(runtime) {
  const boosted = [];
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() !== 3 || !pawn.IsAlive?.()) continue;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    if (velocity.z > -300) continue;
    pawn.Teleport?.({ velocity: vec(0, 0, 200) });
    boosted.push(pawn);
  }
  runtime.bossSaveBoostHistory ??= [];
  runtime.bossSaveBoostHistory.push({ at: Instance.GetGameTime(), count: boosted.length });
  return boosted.length;
}

function finaleKamikazeNormalize(direction, fallback = vec(1, 0, 0)) {
  const length = Math.hypot(direction?.x ?? 0, direction?.y ?? 0, direction?.z ?? 0);
  return length > 0.001
    ? vec(direction.x / length, direction.y / length, direction.z / length)
    : clone(fallback);
}

function finaleKamikazeTarget(runtime) {
  if (runtime?.bossPhase === "escape") {
    return clone(runtime.escape?.current?.entry
      ?? runtime.escape?.nextEntry
      ?? runtime.escape?.anchor
      ?? runtime.tpPosition
      ?? runtime.anchor);
  }
  return clone(runtime?.topCenter ?? runtime?.tpPosition ?? runtime?.anchor ?? vec());
}

function finaleKamikazeCandidates() {
  const zombies = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 2 && pawn.IsAlive?.());
  const moving = zombies.filter((pawn) => {
    const lease = kamikazePilots.get(pawn);
    if (lease && (lease.active || Instance.GetGameTime() < lease.until)) return false;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    return Math.hypot(velocity.x, velocity.y) > 5;
  });
                                                                             
                                                                              
                                                                             
                                                                            
                                         
  const mothers = moving.filter((pawn) => state.motherZombies?.has?.(pawn));
  return mothers.length > 0 ? mothers : moving;
}

function cleanupFinaleKamikazeFlight(runtime, flight, restorePilot = false) {
  clearSourceAudio(flight);
  if (flight.explodeTask) {
    flight.explodeTask.cancelled = true;
    runtime.tasks?.delete(flight.explodeTask);
    state.scheduledTasks = state.scheduledTasks.filter(task => task !== flight.explodeTask);
  }
  for (const id of flight.outputConnections ?? []) {
    disconnectEntityOutput(id);
    runtime.outputConnections?.delete(id);
    state.outputConnections.delete(id);
  }
  flight.outputConnections?.clear();
  for (const entity of [flight.visual, flight.damageHitbox]) {
    if (validEntity(entity)) entity.Kill();
    runtime.entities?.delete(entity);
  }
  const pawn = flight.pawn, lease = kamikazePilots.get(pawn);
  if (lease?.flight !== flight) return;
  lease.active = false;
  if (!restorePilot) return;                                             
  kamikazePilots.delete(pawn);
  const original = flight.originalPilot;
                                                                          
                                                                               
  if (!original || !validEntity(pawn) || !pawn.IsAlive?.()
    || pawn.GetTeamNumber?.() !== original.team) return;
  pawn.Teleport?.({ position: clone(original.position), angles: original.angles,
    velocity: clone(original.velocity) });
  pawn.SetHealth?.(Math.min(pawn.GetHealth?.() ?? original.health, original.health));
}

function cancelFinaleKamikaze(runtime) {
  const flight = runtime?.kamikaze;
  if (!flight) return false;
  runtime.kamikaze = undefined;
  cleanupFinaleKamikazeFlight(runtime, flight, true);
  return true;
}

function scheduleFinaleKamikaze(runtime, absoluteTime, reason = "pyramid") {
  if (!runtime || runtime.lifecycle === "destroyed" || runtime.lifecycle === "resolved") return false;
                                                                            
                                                                            
                                                                           
                                                                           
  const dispatchDelay = FINALE_KAMIKAZE_CONFIG.dispatchDelayMin
    + Math.random() * (FINALE_KAMIKAZE_CONFIG.dispatchDelayMax - FINALE_KAMIKAZE_CONFIG.dispatchDelayMin);
  const launchAt = absoluteTime + dispatchDelay;
  runtime.kamikazeNextAt = launchAt;
  const key = `finale_kamikaze_${reason}_${Math.round(launchAt * 100)}_${runtime.sequence}`;
  endingTaskAt(runtime, launchAt, () => {
    runtime.kamikazeNextAt = undefined;
    startFinaleKamikaze(runtime, reason);
  }, key);
  return true;
}

function scheduleNextFinaleInfiniteKamikaze(runtime, now) {
  if (!runtime?.infinite || runtime.bossPhase !== "escape" || runtime.finalPyramidStartedAt !== undefined) return false;
  const delay = FINALE_KAMIKAZE_CONFIG.infiniteDelayMin
    + Math.random() * (FINALE_KAMIKAZE_CONFIG.infiniteDelayMax - FINALE_KAMIKAZE_CONFIG.infiniteDelayMin);
  return scheduleFinaleKamikaze(runtime, now + delay, "infinite_escape");
}

function spawnFinaleKamikazeVisual(runtime, event) {
  const template = state.featureTemplates.get(FINALE_KAMIKAZE_CONFIG.visualTemplateKey);
  if (!template?.IsValid?.() || typeof template.ForceSpawn !== "function") {
    runtime.kamikazeSupported = false;
    runtime.kamikazeNote = "template_model is unavailable; KAMIKAZE keeps its logical flight without a plane visual";
    return undefined;
  }
  try {
    const visual = spawnVisual(runtime, {
      position: event.position,
      angles: anglesFromDirection(event.direction),
      feature: "finaleKamikaze",
    }, FINALE_KAMIKAZE_CONFIG.model);
    if (!validEntity(visual)) throw new Error("plane visual did not spawn");
    visual.SetModelScale?.(FINALE_KAMIKAZE_CONFIG.modelScale);
    runtime.kamikazeSupported = true;
    runtime.kamikazeNote = undefined;
    return visual;
  } catch (error) {
    runtime.kamikazeSupported = false;
    runtime.kamikazeNote = `plane visual unavailable: ${String(error)}`;
    message(`[FINALE KAMIKAZE] visual fallback: ${error}`);
    return undefined;
  }
}

function spawnFinaleKamikazeDamageHitbox(runtime, event) {
                                                                      
                                                                        
                                                                         
                                                                        
                                 
  const templateKeys = [FINALE_BOSS_CONFIG.triggerTemplateKey, "model"];
  let damageable;
  let selectedKey;
  const request = {
    position: event.position,
    angles: anglesFromDirection(event.direction),
    feature: `finaleKamikazeDamage_${runtime.sequence}`,
  };
  for (const key of templateKeys) {
    const template = state.featureTemplates.get(key);
    if (!template?.IsValid?.() || typeof template.ForceSpawn !== "function") continue;
    let spawned;
    try {
      spawned = spawnRoundEntities(template, request.position, request.angles) ?? [];
      finalizeSpawned(runtime, request, spawned);
    } catch {
      continue;
    }
                                                                        
                                                                         
    damageable = spawned.find((entity) => entity?.IsValid?.()
      && String(entity.GetClassName?.() ?? "").toLowerCase().includes("prop_physics")
      && typeof entity.SetHealth === "function");
    damageable ??= spawned.find((entity) => entity?.IsValid?.()
      && !String(entity.GetClassName?.() ?? "").toLowerCase().startsWith("trigger_")
      && typeof entity.SetHealth === "function");
    if (damageable) {
      selectedKey = key;
      for (const entity of spawned) {
        if (entity === damageable || !entity?.IsValid?.()) continue;
        entity.Kill?.();
        runtime.entities.delete(entity);
      }
      break;
    }
    for (const entity of spawned) {
      if (entity?.IsValid?.()) entity.Kill?.();
      runtime.entities.delete(entity);
    }
  }
  if (!damageable) throw new Error("FINALE KAMIKAZE damage hitbox prototype did not spawn");

  const health = FINALE_KAMIKAZE_CONFIG.hitboxHealthBase + event.health;
  damageable.SetEntityName?.(`finale_kamikaze_damage_${runtime.sequence}`);
  damageable.finaleHitboxRole = "kamikaze_damage";
  damageable.finaleHitboxTemplate = selectedKey;
  damageable.finaleHitboxHealthBase = FINALE_KAMIKAZE_CONFIG.hitboxHealthBase;
  damageable.SetMaxHealth?.(health);
  damageable.SetHealth?.(health);
  try {
    damageable.SetSize?.(
      FINALE_KAMIKAZE_CONFIG.hitboxMins,
      FINALE_KAMIKAZE_CONFIG.hitboxMaxs,
    );
    damageable.finaleHitboxSizeConfigured = typeof damageable.SetSize === "function";
  } catch {
    damageable.finaleHitboxSizeConfigured = false;
  }
  damageable.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(damageable, "SetRenderMode", "1");
  fireTarget(damageable, "SetRenderAlpha", "0");
  fireTarget(damageable, "SetDamageFilter", "filter_ct");
  try { damageable.SetSolid?.(3); } catch {                                  }
  fireTarget(damageable, "SetSolid", "3");
  damageable.SetModelScale?.(100000);
  raceSetCollisionGroup(damageable, FINALE_BOSS_CONFIG.collisionGroup);
  fireTarget(damageable, "DisableMotion");
  event.damageHitbox = damageable;
  event.damageHitboxHealth = health;
  event.damageHitboxTemplate = selectedKey;
  return damageable;
}

function finaleKamikazeDamageHitboxEvent(runtime, event, data, source = "health") {
  if (!runtime || !event || event.exploded) return false;
  const hitbox = event.damageHitbox;
  if (!validEntity(hitbox)) return false;
  const currentHealth = Number(hitbox.GetHealth?.());
  const baseline = FINALE_KAMIKAZE_CONFIG.hitboxHealthBase;
  let damage = Number(data?.damage ?? data?.Damage ?? data?.value);
  if (!Number.isFinite(damage) || damage <= 0) damage = undefined;
  const projectedHealth = Number.isFinite(currentHealth) && Number.isFinite(damage)
    ? currentHealth - damage
    : currentHealth;
                                                                            
                                                                             
                                                                     
  if (source === "health" && (!Number.isFinite(currentHealth) || currentHealth > baseline)) return false;
  if (source !== "health" && Number.isFinite(currentHealth) && currentHealth > baseline
    && (!Number.isFinite(projectedHealth) || projectedHealth > baseline)) return false;
  if (event.shotDownAt !== undefined
    && Math.abs(Instance.GetGameTime() - event.shotDownAt) < 0.05) return false;
  event.shotDownAt = Instance.GetGameTime();
  return explodeFinaleKamikaze(runtime, "shot-down");
}

function explodeFinaleKamikaze(runtime, reason = "impact") {
  const event = runtime?.kamikaze;
  if (!event || event.exploded) return false;
  event.exploded = true;
  event.explodeReason = reason;
  event.explodedAt = Instance.GetGameTime();
  const origin = clone(event.position ?? event.pawn?.GetAbsOrigin?.() ?? runtime.anchor);
  const radius = FINALE_KAMIKAZE_CONFIG.explodeRadius;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3 && pawn.IsAlive?.());
  let hitCount = 0;
  for (const pawn of humans) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const distance = Math.hypot(position.x - origin.x, position.y - origin.y, position.z - origin.z);
    if (distance > radius) continue;
    const scale = Math.max(0.05, 1 - distance / radius);
    damagePawn(pawn, FINALE_KAMIKAZE_CONFIG.explodeMagnitude * scale, event.pawn, event.visual, CSDamageTypes.BLAST);
    hitCount++;
  }
  event.hitCount = hitCount;
  for (let index = 0; index < 5; index++) {
    playCatalogSound(FINALE_KAMIKAZE_CONFIG.soundExplosion, origin, {radius:FINALE_KAMIKAZE_CONFIG.soundExplosion === FINALE_KAMIKAZE_CONFIG.soundExplosion ? 15000 : 500000,lifetime:2,...{ pitch: 95 + Math.floor(Math.random() * 6) }});
    playCatalogSound(FINALE_KAMIKAZE_CONFIG.soundExplosionTail, origin, {radius:FINALE_KAMIKAZE_CONFIG.soundExplosion === FINALE_KAMIKAZE_CONFIG.soundExplosionTail ? 15000 : 500000,lifetime:2,...{ pitch: 95 + Math.floor(Math.random() * 6) }});
  }
  cleanupFinaleKamikazeFlight(runtime, event);
  if (event.pawn?.IsAlive?.()) {
    event.pawn.TakeDamage?.({
      damage: 999999,
      damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
    });
  }
  runtime.kamikazeHistory ??= [];
  runtime.kamikazeHistory.push({
    startedAt: event.startedAt,
    explodedAt: event.explodedAt,
    reason,
    hitCount,
    visual: validEntity(event.visual),
    damageHitbox: validEntity(event.damageHitbox),
  });
  runtime.kamikaze = undefined;
  if (runtime.infinite && runtime.bossPhase === "escape") scheduleNextFinaleInfiniteKamikaze(runtime, event.explodedAt);
  return true;
}

function startFinaleKamikaze(runtime, reason = "pyramid") {
  if (!runtime || runtime.lifecycle !== "active" || runtime.kamikaze || runtime.bossPhase === "boss_active") return false;
  const candidates = finaleKamikazeCandidates();
  if (candidates.length === 0) {
    runtime.kamikazeHistory ??= [];
    runtime.kamikazeHistory.push({ startedAt: Instance.GetGameTime(), skipped: true, reason: "no-zombie-candidate" });
    runtime.kamikazeNote = "no living zombie candidate was available";
    if (runtime.infinite && runtime.bossPhase === "escape") scheduleNextFinaleInfiniteKamikaze(runtime, Instance.GetGameTime());
    return false;
  }
  const pawn = candidates[Math.floor(Math.random() * candidates.length)];
  const target = finaleKamikazeTarget(runtime);
  const radial = finaleKamikazeNormalize(vec(-target.x, -target.y, 0), mul(runtime.direction ?? vec(1, 0, 0), -1));
  const start = add(add(target, mul(radial, FINALE_KAMIKAZE_CONFIG.startDistance)), vec(0, 0, FINALE_KAMIKAZE_CONFIG.startHeight));
  start.z = Math.max(-14000, Math.min(16000, start.z));
  const direction = finaleKamikazeNormalize(sub(target, start), runtime.direction ?? vec(1, 0, 0));
  const now = Instance.GetGameTime();
  const humanCount = allLivingPawns().filter((candidate) => candidate.GetTeamNumber?.() === 3 && candidate.IsAlive?.()).length;
  const event = {
    pawn,
    originalPilot: { position: clone(pawn.GetAbsOrigin?.() ?? start),
      velocity: clone(pawn.GetAbsVelocity?.() ?? vec()), angles: pawn.GetAbsAngles?.(),
      health: pawn.GetHealth?.() ?? FINALE_KAMIKAZE_CONFIG.playerHealth,
      team: pawn.GetTeamNumber?.() },
    outputConnections: new Set(),
    target,
    position: clone(start),
    direction,
    reason,
    startedAt: now,
    explodeAt: now + FINALE_KAMIKAZE_CONFIG.explodeTime,
    bottomLimit: target.z - FINALE_KAMIKAZE_CONFIG.bottomLimitOffset,
    health: FINALE_KAMIKAZE_CONFIG.hpBase + FINALE_KAMIKAZE_CONFIG.hpEachHuman * humanCount,
    lastAt: now,
    exploded: false,
  };
  runtime.kamikaze = event;
  kamikazePilots.set(pawn, { flight: event, active: true,
    until: now + FINALE_KAMIKAZE_CONFIG.candidateLockDuration });
  runtime.kamikazeHistory ??= [];
  runtime.kamikazeHistory.push({ startedAt: now, reason, candidate: pawn });
  pawn.SetHealth?.(FINALE_KAMIKAZE_CONFIG.playerHealth);
                                                                          
                                                                               
  pawn.Teleport?.({ position: clone(start), angles: anglesFromDirection(direction), velocity: mul(direction, FINALE_KAMIKAZE_CONFIG.flySpeed) });
  event.visual = spawnFinaleKamikazeVisual(runtime, event);
                                                                        
                                                                              
  try {
    event.damageHitbox = spawnFinaleKamikazeDamageHitbox(runtime, event);
    runtime.kamikazeHitboxSupported = true;
    runtime.kamikazeHitboxNote = undefined;
    message(`[FINALE DEBUG] KAMIKAZE damage hitbox ready template=${event.damageHitboxTemplate} hp=${event.damageHitboxHealth}`);
    const takeId = connectOwnedOutput(runtime, event.damageHitbox, "OnTakeDamage", (data) => {
      if (runtime.kamikaze !== event) return;
      finaleKamikazeDamageHitboxEvent(runtime, event, data, "take");
    });
    const healthId = connectOwnedOutput(runtime, event.damageHitbox, "OnHealthChanged", (data) => {
      if (runtime.kamikaze !== event) return;
      finaleKamikazeDamageHitboxEvent(runtime, event, data, "health");
    });
    for (const id of [takeId, healthId]) if (id !== undefined && id !== null) event.outputConnections.add(id);
  } catch (error) {
                                                                            
                                                                        
                                                                  
    runtime.kamikazeHitboxNote = `damage hitbox unavailable: ${String(error)}`;
    runtime.kamikazeHitboxSupported = false;
    message(`[FINALE KAMIKAZE] damage hitbox fallback: ${error}`);
  }
  for (let index = 0; index < 5; index++) {
    playCatalogSound(FINALE_KAMIKAZE_CONFIG.soundIncoming, start, {radius:15000,lifetime:8,parent:pawn,owner:event,pitch:95 + Math.floor(Math.random() * 6)});
    playCatalogSound(FINALE_KAMIKAZE_CONFIG.soundWarning, start, {radius:15000,lifetime:15,parent:pawn,owner:event,pitch:95 + Math.floor(Math.random() * 6)});
  }
  event.explodeTask = endingTaskAt(runtime, event.explodeAt, () => {
    if (runtime.kamikaze === event) explodeFinaleKamikaze(runtime, "timeout");
  }, `finale_kamikaze_explode_${runtime.sequence}_${Math.round(now * 100)}`);
  return true;
}

function processFinaleKamikaze(runtime, now = Instance.GetGameTime()) {
  const event = runtime?.kamikaze;
  if (!event || event.exploded) return;
  const pawn = event.pawn;
  if (!pawn?.IsAlive?.()) {
    explodeFinaleKamikaze(runtime, "plane-killed");
    return;
  }
  const elapsed = Math.max(0, Math.min(0.1, now - (event.lastAt ?? now)));
  event.lastAt = now;
  const origin = pawn.GetAbsOrigin?.() ?? event.position;
  event.position = clone(origin);
  const humans = allLivingPawns().filter((candidate) => candidate.GetTeamNumber?.() === 3 && candidate.IsAlive?.());
  let targetHuman;
  let targetDistance = Infinity;
  for (const human of humans) {
    const position = human.GetAbsOrigin?.();
    if (!position) continue;
    const distance = Math.hypot(position.x - origin.x, position.y - origin.y, position.z - origin.z);
    if (distance < targetDistance) {
      targetDistance = distance;
      targetHuman = position;
    }
    if (projectileTouchesPlayerHull(human, origin, add(origin, mul(event.direction, FINALE_KAMIKAZE_CONFIG.explodeTraceDistance)), 24)) {
      explodeFinaleKamikaze(runtime, "human-contact");
      return;
    }
  }
  if (targetHuman) {
    const desired = finaleKamikazeNormalize(sub(targetHuman, origin), event.direction);
    event.direction = finaleKamikazeNormalize(add(event.direction, mul(desired, 0.07 * FINALE_KAMIKAZE_CONFIG.turnSpeed)), event.direction);
  }
  const next = add(origin, mul(event.direction, FINALE_KAMIKAZE_CONFIG.flySpeed * elapsed));
  if (next.z <= event.bottomLimit) {
    explodeFinaleKamikaze(runtime, "bottom-limit");
    return;
  }
  const trace = typeof Instance.TraceLine === "function"
    ? Instance.TraceLine({ start: origin, end: next, ignoreEntity: pawn, ignorePlayers: true })
    : undefined;
  if (trace?.didHit || trace?.hit) {
    explodeFinaleKamikaze(runtime, "world-contact");
    return;
  }
  event.position = next;
  const angles = anglesFromDirection(event.direction);
  pawn.Teleport?.({ position: next, angles, velocity: mul(event.direction, FINALE_KAMIKAZE_CONFIG.flySpeed) });
  if (validEntity(event.visual)) event.visual.Teleport?.({ position: next, angles, velocity: vec() });
  if (validEntity(event.damageHitbox)) {
    event.damageHitbox.Teleport?.({ position: next, angles, velocity: vec() });
  }
}

function beginFinaleEscape(runtime) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.bossPhase === "escape") return;
  runtime.bossPhase = "escape";
  runtime.finaleZombieInvincibilityRange = 50;
  runtime.escapeStartedAt = Instance.GetGameTime();
  state.finalePostImpostorUntil = runtime.escapeStartedAt + 20;
  runtime.escapeReady = false;
  const reverseDirection = mul(runtime.direction, -1);





  const top = runtime.bossArena?.center ?? runtime.anchor;
  const escapeAnchor = add(
    add(top, vec(0, 0, -(FINALE_STRUCTURE_CONFIG.towerTopElevation * CONFIG.elevationStep))),
    mul(reverseDirection, FINALE_ESCAPE_CONFIG.startDistance),
  );
  const escapePlan = finaleEscapeLevelPlan(runtime);
  runtime.escape = {
    levelTarget: escapePlan.levelTarget,
    infiniteExtraStack: escapePlan.infiniteExtraStack,
    infiniteExtraLevels: escapePlan.infiniteExtraLevels,
    levelCount: 0,
    current: undefined,
    history: [],
    firstLevel: undefined,
    vellerTarget: undefined,
    direction: reverseDirection,
    anchor: clone(escapeAnchor),
    nextEntry: add(escapeAnchor, mul(reverseDirection, CONFIG.bufferSize * CONFIG.gridSize)),
    nextSpawnAt: runtime.escapeStartedAt + FINALE_ESCAPE_CONFIG.startDelay,
    startedAt: runtime.escapeStartedAt,
    lastLevelId: undefined,
    lastOutgoing: undefined,
    teleportedAt: undefined,
    rubbleStartedAt: runtime.escapeStartedAt + FINALE_ESCAPE_CONFIG.rubbleDelay,
    vellerTeams: new Set(),
    vellerPlayers: new Map(),
    flags: {



      trapsDisabled: !runtime.infinite,
      itemsDisabled: true,
      elevatorsDisabled: true,
      crouchesDisabled: true,
      holdsDisabled: true,
      streamDrownDisabled: true,
      breakablesDisabled: true,
      forcedLadder: true,
    },
  };
  runtime.rubbleProfile = {
    ...FINALE_ESCAPE_RUBBLE_PROFILE,
    debrisDamage: runtime.infinite ? 16 : FINALE_ESCAPE_RUBBLE_PROFILE.debrisDamage,
  };
  runtime.raceRubbleStarted = false;
  runtime.raceRubbleStopped = false;
  runtime.finaleElevatorDebrisStarted = false;
  runtime.finaleElevatorDebrisDone = true;
  runtime.rubbleSpawnedCount = 0;
  state.finaleEscapeActive = true;
  restorePlayerEffects(runtime.index);



  for (const boss of runtime.bosses ?? []) for (const hitbox of boss.hitboxes ?? []) fireTarget(hitbox, "Disable");
  if (validEntity(runtime.bossFallTrigger)) fireTarget(runtime.bossFallTrigger, "Disable");
  fireName("finalefalldowntrigger", "Disable");
  for (const lift of [...(runtime.finaleNativeLifts ?? [])]) retireFinaleNativeLift(runtime, lift);
  for (const entity of runtime.finaleZElevators ?? []) {
    retireFinaleNativeLift(runtime, entity.nativeLift);
    if (validEntity(entity.entity)) entity.entity.Kill?.();
  }
  for (const entity of runtime.finaleLowgravTriggers ?? []) if (validEntity(entity)) entity.Kill?.();
  runtime.finaleZElevators.clear();
  runtime.finaleLowgravTriggers.clear();
  runtime.finaleStructurePhase = "escape";
  scheduleFinaleTopCollapse(runtime);
  endingTaskAt(runtime, runtime.escapeStartedAt + FINALE_ESCAPE_CONFIG.zPlatformKillDelay, () => {
    for (const platform of runtime.bossArena?.zPlatform ?? []) {
      for (const entity of platform.entities ?? []) destroyEndingEntity(runtime, entity);
    }
    runtime.bossArena.zPlatformRemovedAt = Instance.GetGameTime();
  }, `finaleEscapeZPlatformKill_${runtime.sequence}`);
  endingTaskAt(runtime, runtime.escape.nextSpawnAt, () => {
    runtime.escapeReady = true;
    queueFinaleEscapeLevel(runtime);
  }, "finaleEscapeInitialSpawn");
  endingTaskAt(runtime, runtime.escapeStartedAt + FINALE_ESCAPE_CONFIG.teleportMoveDelay, () => {
    const escape = runtime.escape;
    const first = escape?.firstLevel;

    if (first?.tp && escape.levelCount <= 3) {
      moveTeleportDestination(first.tp, first.incoming);
      runtime.escape.teleportedAt = Instance.GetGameTime();
    }
  }, "finaleEscapeTeleport");
  endingTaskAt(runtime, runtime.escapeStartedAt + FINALE_ESCAPE_CONFIG.rubbleDelay, () => {
    runtime.raceRubbleStarted = true;
    runtime.nextRubbleAt = Instance.GetGameTime();
    message("[FINALE ESCAPE] CT-only falling debris enabled");
  }, "finaleEscapeRubble");


  if (runtime.infinite) scheduleNextFinaleInfiniteKamikaze(runtime, runtime.escapeStartedAt);
  announce("FINALE: boss defeated; escape route is opening");
}

function scheduleFinaleTopCollapse(runtime) {
  if (!runtime || runtime.finaleTopCollapseScheduled) return;
  runtime.finaleTopCollapseScheduled = true;
  const cleaner = runtime.finaleCleanerPosition
    ?? runtime.bossArena?.center
    ?? runtime.anchor;
  const entities = new Set();




  for (const piece of runtime.finaleTowerPieces ?? []) {
    const role = String(piece?.role ?? "");
    if (!role.startsWith("finale_elevator_floor_") && !role.startsWith("finale_top_")) continue;
    if (piece.bossCollected || piece.bossCollecting) continue;
    for (const entity of piece.entities ?? []) entities.add(entity);
  }
  for (const piece of runtime.finaleArenaPieces ?? []) {
    // Collected terrain belongs to the corpse until its death-motion cleanup.
    if (piece.bossCollected || piece.bossCollecting) continue;
    for (const entity of piece.entities ?? []) entities.add(entity);
  }
  for (const platform of runtime.bossArena?.zPlatform ?? []) for (const entity of platform.entities ?? []) entities.add(entity);
  for (const entity of entities) {
    if (!validEntity(entity)) continue;
    const position = entity.GetAbsOrigin?.() ?? cleaner;
    const distance = Math.hypot(position.x - cleaner.x, position.y - cleaner.y);
    const delay = Math.max(0, Math.min(8, distance / 300));
    endingTaskAt(runtime, runtime.escapeStartedAt + delay, () => {
      if (!validEntity(entity)) return;
      const origin = entity.GetAbsOrigin?.() ?? position;
      entity.Teleport?.({
        position: add(origin, vec(Math.random() * 30 - 15, Math.random() * 30 - 15, Math.random() * 10 - 5)),
        velocity: vec(),
      });
      beginEndingEntityFall(runtime, entity, 2.1);
    }, `finale_top_collapse_${runtime.sequence}_${Math.round(position.x)}_${Math.round(position.y)}_${Math.round(position.z)}`);
  }
}

// The layout context the completion handoff will see for the next segment.
// Called while `after` is still current, it mirrors that handoff: `after`
// joins a history trimmed to the retained count and its exit sets the heading.
function finaleEscapePlanContext(escape, after) {
  if (!after) return { direction: escape.direction, nextEntry: escape.nextEntry, anchor: escape.anchor,
    history: escape.history, lastLevelId: escape.lastLevelId, segment: escape.levelCount + 1 };
  const history = [...(escape.history ?? []), after];
  if (history.length > FINALE_ESCAPE_CONFIG.history) history.shift();
  return { direction: clone(after.outgoing), nextEntry: escape.nextEntry, anchor: escape.anchor,
    history, lastLevelId: after.id, segment: escape.levelCount + 1 };
}

// Background plans stop after layout: pixels then run in budgeted batches
// into the level's own request list instead of the global spawn queue.
function planFinaleEscapeLevel(runtime, plan, background = false) {
  const candidates = LEVELS.filter((level) => level.id !== plan.lastLevelId
    && !level.name.startsWith("RACE")
    && level.cost <= FINALE_ESCAPE_CONFIG.stageCostLimit
    && !level.tiles.some(tile => [92, 142, 143, 147, 148, 149, 150, 151, 152, 168, 169, 170].includes(tile)));
  if (candidates.length === 0) throw new Error("FINALE escape has no level candidates");
  // Visit each candidate once, with both mirrors, instead of repeatedly
  // sampling an outward map until the retry limit kills the Think loop.
  for (let i = candidates.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [candidates[i], candidates[j]] = [candidates[j], candidates[i]];
  }
  const attempts = candidates.flatMap(candidate => {
    const mirrored = Math.random() >= 0.5;
    return [{ candidate, mirrored }, { candidate, mirrored: !mirrored }];
  });
  for (const { candidate, mirrored } of attempts) {
    const layout = finaleEscapeBufferLayout(candidate, mirrored, plan);
    const { entry, bridgeStart, bufferSize } = layout;
    const queueStart = state.spawnQueue.length;
    try {
      const level = buildLevel(
        candidate,
        mirrored,
        `finale_escape:${plan.segment}`,
        entry,
        plan.direction,
        bridgeStart,
        bufferSize,
        stageSnapshotForRuntime(runtime),
        true,
      );
      if (!finaleEscapeWithinLimits(level)) {
        state.spawnQueue.splice(queueStart);
        continue;
      }
      if (background) {
        level.preloadRequests = [];
        return level;
      }
      // Rejected geometry never reaches the queue. The accepted route is
      // fully planned here because the escape controller owns no planner.
      for (const _ of level.planningIterator) {}
      level.planningIterator = undefined;
      return level;
    } catch (error) {
      state.spawnQueue.splice(queueStart);
      message(`FINALE escape rejected level '${candidate.name}': ${error}`);
    }
  }
  throw new Error(`FINALE escape could not select an in-bounds level`
    + ` for segment ${plan.segment}; entry=${JSON.stringify(plan.nextEntry)}`
    + ` direction=${JSON.stringify(plan.direction)}`);
}

function themeFinaleEscapeRequests(runtime, level, requests) {
  for (const request of requests) {
    if (request.levelIndex !== level.index) continue;
    const themeName = chooseFinaleThemeName(runtime);
    request.themeName = themeName;
    if (request.kind === "terrain") {
      request.terrainModel = chooseTerrainModel(themeName, request.themeTerrainShape ?? request.shape);
    } else if (request.kind === "feature" && request.themeShape) {
      request.themeModel = chooseTerrainModel(themeName, request.themeShape);
    }
  }
}

// Adopt a background plan made for this exact handoff. A quick finish can
// catch it mid-planning; finish the pixels now as the cold path would and
// keep the blocks already staged. Anything else is discarded and planned cold.
function adoptFinaleEscapePreload(runtime) {
  const preload = state.terrainPreload;
  if (preload?.kind !== "finale_escape") return undefined;
  if (!terrainPreloadMatches(preload)) {
    clearTerrainPreload();
    return undefined;
  }
  const level = preload.runtime;
  try {
    if (level.planningIterator) for (const _ of level.planningIterator) {}
    level.planningIterator = undefined;
  } catch (error) {
    message(`[TERRAIN PRELOAD] escape plan discarded: ${error}`);
    clearTerrainPreload();
    return undefined;
  }
  state.terrainPreload = undefined;
  if (!preload.themed) themeFinaleEscapeRequests(runtime, level, level.preloadRequests);
  state.spawnQueue.push(...level.preloadRequests);
  level.preloadRequests = undefined;
  return level;
}

function queueFinaleEscapeLevel(runtime) {
  const escape = runtime?.escape;
  if (!runtime || !escape || escape.current || escape.levelCount >= escape.levelTarget) return false;
  let selected = adoptFinaleEscapePreload(runtime);
  const staged = selected?.terrainPreloadedEntities?.size ?? 0;
  if (!selected) {
    selected = planFinaleEscapeLevel(runtime, finaleEscapePlanContext(escape));
    themeFinaleEscapeRequests(runtime, selected, state.spawnQueue);
  }
  selected.finaleEscape = true;
  selected.endProvider = "position";
  selected.tp = add(sub(selected.entry, mul(selected.incoming,
    (CONFIG.bufferSize - 0.5) * CONFIG.gridSize)), vec(0, 0, 8));
  const previous = escape.history?.at(-1);
  selected.spawnSafetyReturn = previous ? {
    position: add(sub(previous.end, mul(previous.outgoing, CONFIG.gridSize / 2)), vec(0, 0, 16)),
    angles: anglesFor(previous.outgoing),
  } : { position: add(selected.tp, vec(0, 0, 8)), angles: anglesFor(selected.incoming) };
  selected.sourceGenerationScheduled = true;
  selected.escapeNumber = escape.levelCount + 1;
  selected.escapeNoItems = escape.flags.itemsDisabled;
  selected.escapeNoTraps = escape.flags.trapsDisabled;
  state.levels.set(selected.index, selected);
  escape.current = selected;
  if (!escape.firstLevel) {
    escape.firstLevel = selected;
    escape.vellerTarget = add(selected.entry,
      add(mul(selected.incoming, CONFIG.gridSize / 2 - CONFIG.bufferSize * CONFIG.gridSize), vec(0, 0, 4)));
  }
  escape.levelCount++;
  escape.lastLevelId = selected.id;
  escape.nextEntry = add(selected.end, mul(selected.outgoing, CONFIG.bufferSize * CONFIG.gridSize));
  escape.currentSpawnStartedAt = Instance.GetGameTime();
  message(`[FINALE ESCAPE] level ${escape.levelCount}/${escape.levelTarget} map=${selected.id} name="${selected.name}" queued=${selected.remaining}`
    + (staged ? ` preloaded=${staged}` : ""));
  return true;
}

function finaleEscapeWithinLimits(level) {
  const { end, outgoing } = level;
  if (Math.abs(end.x) > CONFIG.edgeLimit || Math.abs(end.y) > CONFIG.edgeLimit
    || Math.abs(end.z) > CONFIG.heightLimit) return false;
  // Source chooses the outgoing direction at the warning boundary. A
  // sideways turn may briefly increase radius while steering away from it.
  for (const axis of ["x", "y"]) {
    if (Math.abs(end[axis]) > CONFIG.edgeWarning && end[axis] * outgoing[axis] > 0) return false;
  }
  return true;
}

function finaleEscapeBufferLayout(level, mirrored, escape) {
  const rows = tileRows(level, mirrored);
  const markers = markerData(rows);
  const elevation = entryExitElevations(rows, markers).entry;
  const direction = escape.direction;
  const initial = escape.nextEntry ?? escape.anchor;
  const bridgeStart = sub(initial, mul(direction, CONFIG.bufferSize * CONFIG.gridSize));


  const previous = (escape.history ?? []).slice(0, -1).map(area => area.sourceAreaBounds).filter(Boolean);
  for (let bufferSize = CONFIG.bufferSize; bufferSize <= CONFIG.mapSize; bufferSize++) {
    const entry = add(bridgeStart, mul(direction, bufferSize * CONFIG.gridSize));
    const bounds = sourceAreaBounds(entry, direction, markers.entryCenter, elevation);
    const overlaps = previous.some(old => bounds.minX <= old.maxX && bounds.maxX >= old.minX
      && bounds.minY <= old.maxY && bounds.maxY >= old.minY);


    if (!overlaps || bufferSize === CONFIG.mapSize) return { entry, bridgeStart, bufferSize };
  }
}

function sourceAreaBounds(entry, incoming, entryCenter, elevation) {
  const corners = [0, CONFIG.mapSize - 1].flatMap(x => [0, CONFIG.mapSize - 1].map(y =>
    gridWorld(entry, incoming, entryCenter, x, y, 0, elevation)));
  const inset = CONFIG.gridSize / 2 - 8;
  return {
    minX: Math.min(...corners.map(p => p.x)) - inset,
    maxX: Math.max(...corners.map(p => p.x)) + inset,
    minY: Math.min(...corners.map(p => p.y)) - inset,
    maxY: Math.max(...corners.map(p => p.y)) + inset,
  };
}

function spawnFinaleEscapeZombieItem(runtime, level) {
  if (!runtime?.infinite || !level || level.escapeZombieItemSpawned) return 0;
  const entry = level.entry ?? runtime.escape?.nextEntry ?? runtime.anchor;
  const direction = level.incoming ?? runtime.escape?.direction ?? runtime.direction;
  const base = add(entry, add(mul(direction, CONFIG.gridSize * 0.5), vec(0, 0, 40)));
  const names = FINALE_ITEM_CONFIG.zombieInfinite;
  const itemName = names[Math.floor(Math.random() * names.length)];
  try {
    spawnItemFeature(level, {
      kind: "feature",
      feature: "item",
      position: base,
      angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 },
      team: 2,
      teamOverride: 2,
      endingItem: true,
      debugItem: true,
      itemName,
      role: `finale_escape_zombie_${level.escapeNumber ?? 0}`,
    });
    level.escapeZombieItemSpawned = true;
    level.escapeZombieItemName = itemName;
    level.escapeZombieItemSpawnedAt = Instance.GetGameTime();
    return 1;
  } catch (error) {
    level.escapeZombieItemError = String(error);
    message(`[FINALE ESCAPE] zombie item '${itemName}' failed: ${error}`);
    level.escapeZombieItemSpawned = true;
    return 0;
  }
}

function processFinaleEscapeSpawn(runtime) {
  const escape = runtime?.escape;
  const level = escape?.current;
  if (!level) return;


  if (level.remaining > 0) {
    level.lifecycle = "spawning";
    return;
  }
  try { releaseLevelPostSpawn(level); }
  catch (error) { failRuntime(`escape postspawn release failed for level ${level.index}: ${error}`); return; }
  closeBlockSpawnSafety(level);
  if (level.lifecycle !== "active") {
    setLevelLifecycle(level, "active");
    spawnEndIndicator(level);
    updateTerrainPreviewHud(level, "finale-escape-spawn-complete");
  }
  spawnFinaleEscapeZombieItem(runtime, level);
}

function processFinaleEscapeVeller(runtime, now) {
  const escape = runtime.escape;
  const target = escape.vellerTarget;
  if (!target) return;
  const elapsed = now - escape.startedAt;


  for (const [team, delay] of [[3, FINALE_ESCAPE_CONFIG.ctVelocityDelay], [2, FINALE_ESCAPE_CONFIG.zombieVelocityDelay]]) {
    if (elapsed < delay || escape.vellerTeams.has(team)) continue;
    escape.vellerTeams.add(team);
    for (const pawn of allLivingPawns()) {
      if (pawn.GetTeamNumber?.() === team) escape.vellerPlayers.set(pawn,
        { team, nextAt: now + 0.1, attempts: 0, done: false });
    }
  }
  for (const [pawn, job] of escape.vellerPlayers) {
    if (!validEntity(pawn) || pawn.IsAlive?.() === false || pawn.GetHealth?.() <= 0
      || pawn.GetTeamNumber?.() !== job.team) { escape.vellerPlayers.delete(pawn); continue; }
    if (job.done) {
      if (now < job.postAt) continue;
      const position = pawn.GetAbsOrigin?.();
      if (position && target.z - position.z > FINALE_ESCAPE_CONFIG.vellerPostDistance)
        pawn.Teleport?.({ position: add(target, vec(0, 0, 4)), velocity: vec() });
      escape.vellerPlayers.delete(pawn);
      continue;
    }
    if (now < job.nextAt) continue;
    job.nextAt = now + FINALE_ESCAPE_CONFIG.vellerRate;
    const origin = pawn.GetAbsOrigin?.();
    if (!origin) continue;
    const delta = sub(target, origin);
    const distance = Math.hypot(delta.x, delta.y, delta.z);
    job.attempts++;
    if (distance < 100) {
      job.done = true;
      job.postAt = now + FINALE_ESCAPE_CONFIG.vellerPostCheck;
      continue;
    }
    const horizontal = Math.hypot(delta.x, delta.y) || 1;
    let zVelocity = pawn.GetAbsVelocity?.().z ?? 0;
    if (delta.z > 200) zVelocity = 800;
    else if (delta.z > 0) zVelocity = 500;
    else if (delta.z > -50) zVelocity = 300;
    else if (delta.z > -100) zVelocity = 200;
    else if (delta.z > -200) zVelocity = 100;
    else if (delta.z > -500) zVelocity = -50;
    else if (delta.z > -1000) zVelocity = -200;
    else if (delta.z > -2000) zVelocity = -500;
    const xyVelocity = Math.max(250, Math.min(1000, Math.hypot(delta.x, delta.y) / 2));
    if (job.attempts > FINALE_ESCAPE_CONFIG.vellerMaxAmount) {
      pawn.Teleport?.({ position: add(target, vec(0, 0, 4)), velocity: vec() });
      job.done = true;
      job.postAt = now + FINALE_ESCAPE_CONFIG.vellerPostCheck;
      continue;
    }
    pawn.Teleport?.({ velocity: vec(delta.x / horizontal * xyVelocity, delta.y / horizontal * xyVelocity, zVelocity) });
  }
}

function startFinalePyramidAfterEscape(runtime) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.finalPyramidStartedAt !== undefined) return false;
  const escape = runtime.escape;
  if (!escape) return false;
  const anchor = escape.lastEnd ?? escape.nextEntry ?? escape.anchor ?? runtime.anchor;
  const direction = escape.lastOutgoing ?? escape.direction ?? runtime.direction ?? vec(1, 0, 0);
  const now = Instance.GetGameTime();




  cancelEndingTasks(runtime);
  for (const lift of [...(runtime.finaleNativeLifts ?? [])]) retireFinaleNativeLift(runtime, lift);
  for (const boss of runtime.bosses ?? []) {
    for (const hitbox of boss.hitboxes ?? []) if (validEntity(hitbox)) hitbox.Kill?.();
    if (validEntity(boss.visual)) boss.visual.Kill?.();
  }
  for (const piece of [...(runtime.finaleTowerPieces ?? []), ...(runtime.finaleArenaPieces ?? [])]) {
    for (const entity of piece.entities ?? []) if (validEntity(entity)) entity.Kill?.();
  }
  for (const platform of runtime.bossArena?.zPlatform ?? []) {
    for (const entity of platform.entities ?? []) if (validEntity(entity)) entity.Kill?.();
  }
  // Source FINALE_ENDING.Run() only queues the pyramid past the last exit;
  // the route humans are standing on stays until the round resets. Keep the
  // retained history and finish only the retirement cancelled above.
  const retained = new Set(escape.history ?? []);
  // Source Run() never moves teledest: zombies keep running the route. The
  // cancelled retirement above would have moved it to the oldest retained
  // segment, so finish that move instead of placing it on the pyramid.
  const chase = escape.history?.[0];
  for (const index of [...state.levels.keys()]) {
    const level = state.levels.get(index);
    if (!level?.finaleEscape || retained.has(level) || level.lifecycle === "destroyed") continue;
    transferPickedItemState(level, runtime);
    beginLevelFade(level);
    const duration = Math.ceil((255 - 3) / 50) * 0.05 + 0.05;
    endingTask(runtime, duration, () => destroyLevel(level.index, false));
  }
  state.finaleEscapeActive = false;

  runtime.escape = undefined;
  runtime.finalPyramidStartedAt = now;
  runtime.finalePyramidPhase = "spawning";
  runtime.bossMode = "pyramid";
  runtime.bossPhase = undefined;
  runtime.bossArena = undefined;
  runtime.bosses.clear();
  clearFinaleBossBullets(runtime);
  runtime.bossGrenadeHitCount = 0;
  runtime.finaleStructure = undefined;
  runtime.finaleStructurePhase = "final_pyramid";
  runtime.finaleTowerPieces.clear();
  runtime.finaleBridgePieces.clear();
  runtime.finaleArenaPieces.clear();
  runtime.finaleZElevators.clear();
  runtime.finaleLowgravTriggers.clear();
  runtime.anchor = clone(anchor);
  runtime.direction = clone(direction);
  runtime.left = leftOf(runtime.direction);
  runtime.entryPosition = clone(anchor);
  runtime.tpPosition = chase?.tp ? clone(chase.tp) : add(anchor, vec(0, 0, 8));
  runtime.runStartedAt = now;
  runtime.startedAt = undefined;
  runtime.layout = undefined;
  runtime.elevators = [];
  runtime.spawnQueue.length = 0;
  runtime.remaining = 0;
  runtime.lifecycle = "spawning";
  runtime.lifecycleHistory.push("spawning_final_pyramid");
  buildFinaleGeometry(runtime);
  if (runtime.remaining <= 0) throw new Error("FINALE final pyramid produced no terrain spawn requests");
  moveTeleportDestination(runtime.tpPosition, chase?.tp ? chase.incoming : runtime.direction);
  announce("FINALE: escape route complete; the final pyramid is rising");
  return true;
}

function processFinaleEscape(runtime) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.bossPhase !== "escape") return;
  const now = Instance.GetGameTime();
  const humans = finaleBossAliveHumans();
  if (humans.length === 0) {
    runtime.raceRubbleStopped = true;
    resolveStageEnding(false);
    return;
  }
  const escape = runtime.escape;
  if (!escape) return;
  processFinaleEscapeSpawn(runtime);
  processFinaleEscapeVeller(runtime, now);
  processRaceRubble(runtime, now);
  const current = escape.current;
  if (current?.lifecycle === "active") {
    for (const pawn of humans) {
      const position = pawn.GetAbsOrigin?.();
      if (!position || distance2D(position, current.end) > CONFIG.endRadius) continue;
      if (position.z < current.end.z + CONFIG.endMinZ || position.z > current.end.z + CONFIG.endMaxZ) continue;





      escape.lastOutgoing = current.outgoing ? clone(current.outgoing) : clone(escape.direction);
      escape.direction = clone(escape.lastOutgoing);
      current.completed = true;
      setEndIndicatorState(current, "triggered");
      const previous = escape.history?.at(-1);
      if (previous) setEndIndicatorState(previous, "old");
      setLevelLifecycle(current, "history");
      escape.history.push(current);
      escape.current = undefined;
      escape.nextSpawnAt = now + FINALE_ESCAPE_CONFIG.handoffDelay;


      if (escape.history.length > FINALE_ESCAPE_CONFIG.history) {
        const expired = escape.history.shift();
        const chase = escape.history[0];
        endingTaskAt(runtime, escape.nextSpawnAt, () => {
          if (runtime.bossPhase !== "escape") return;
          if (chase?.tp) moveTeleportDestination(chase.tp, chase.incoming);
          transferPickedItemState(expired, runtime);
          expired.fadeStep = 50;
          expired.fadeInterval = 0.05;
          beginLevelFade(expired);
          const duration = Math.ceil((255 - 3) / 50) * 0.05 + 0.05;
          endingTask(runtime, duration, () => destroyLevel(expired.index, false));
        }, `finaleEscapeRetire_${current.escapeNumber}`);
      }
      if (escape.levelCount >= escape.levelTarget) {
        escape.completedAt = now;
        runtime.raceRubbleStopped = true;
        announce("FINALE: escape route complete; humans reached safety");
        escape.lastEnd = clone(current.end);
        startFinalePyramidAfterEscape(runtime);
      } else {
        announce(`FINALE ESCAPE: level ${escape.levelCount}/${escape.levelTarget} complete`);
      }
      break;
    }
  }
  if (!escape.current && escape.levelCount < escape.levelTarget && now >= escape.nextSpawnAt) {
    try { queueFinaleEscapeLevel(runtime); }
    catch (error) { failRuntime(`FINALE escape generation failed: ${error}`); }
  }
}

function finaleBossSmootherStep(value) {
  const t = Math.max(0, Math.min(1, Number(value) || 0));
  return t * t * t * (t * (t * 6 - 15) + 10);
}

function finaleBossSetAnimation(boss, sequence, idle = sequence, playbackRate, now = Instance.GetGameTime()) {
  if (!boss) return;
                                                                          
                                                                            
  const appliedSequence = sequence;
  const appliedIdle = idle;
  boss.animationState = appliedSequence;
  boss.animationHistory ??= [];
  boss.animationHistory.push({ sequence, idle, appliedSequence, appliedIdle, at: now, playbackRate });
  fireTarget(boss.visual, "SetAnimation", appliedSequence);
  fireTarget(boss.visual, "SetDefaultAnimation", appliedIdle, 0.01);
  if (Number.isFinite(playbackRate)) fireTarget(boss.visual, "SetPlaybackRate", String(playbackRate));
}

const FINALE_BOSS_TERROR_SOUNDS = Object.freeze([
  "eye_terror2",
  "eye_terror3",
  "eye_terror4",
  "eye_terror5",
]);

function playFinaleBossTerrorBurst(position, countMin, countMax, pitchMin, pitchMax) {
  const min = Math.max(0, Math.floor(Number(countMin) || 0));
  const max = Math.max(min, Math.floor(Number(countMax) || min));
  const count = min + Math.floor(Math.random() * (max - min + 1));
  const lowPitch = Number.isFinite(Number(pitchMin)) ? Math.floor(Number(pitchMin)) : 100;
  const highPitch = Number.isFinite(Number(pitchMax)) ? Math.floor(Number(pitchMax)) : lowPitch;
  const pitchRangeMin = Math.min(lowPitch, highPitch);
  const pitchRangeMax = Math.max(lowPitch, highPitch);
  for (let index = 0; index < count; index++) {
    const token = FINALE_BOSS_TERROR_SOUNDS[
      Math.floor(Math.random() * FINALE_BOSS_TERROR_SOUNDS.length)
    ];
    const pitch = pitchRangeMin + Math.floor(Math.random() * (pitchRangeMax - pitchRangeMin + 1));
    playCatalogSound(token, position, {radius:50000,lifetime:5,...{ pitch }});
  }
}

function finaleBossSetTailAim(boss, enabled, now) {
  boss.tailAim = enabled === true;
  if (boss.tailAim) {
    boss.tailAimAttackUntil = now + FINALE_BOSS_CONFIG.tailAimAttackCooldown;
    boss.tailAimForceUntil = now + FINALE_BOSS_CONFIG.tailAimForceCooldown
      + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset;
  } else {
    boss.tailAimAttackUntil = 0;
    boss.tailAimForceUntil = now + FINALE_BOSS_CONFIG.tailAimForceCooldown
      + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset;
  }
}

function finaleBossChooseRandomTarget(boss) {
  const humans = finaleBossAliveHumans().filter((pawn) => pawn?.IsAlive?.() !== false);
  if (humans.length === 0) return undefined;
  const pawn = humans[Math.floor(Math.random() * humans.length)];
  const position = pawn.GetAbsOrigin?.();
  return position ? { pawn, position: clone(position) } : undefined;
}

// Source 1 spawns the boss eyes in _StartFinaleElevator: they lie on the
// arena (pitch 90, idle_closed) while the humans ride up, and Start() only
// wakes them when the fight begins.
function finaleBossIdlePlacement(runtime) {
  const center = finaleBossArenaCenter(runtime);
  const radius = Math.max(0, (runtime.bossArena?.halfSize
    ?? FINALE_BOSS_CONFIG.arenaHalfSize * CONFIG.gridSize) - 350);
  const yaw = yawOf(runtime.direction) + 45 + Math.floor(Math.random() * (315 - 45 + 1));
  const radians = yaw * Math.PI / 180;
  const distance = 350 + Math.random() * radius;
  return {
    position: add(center, vec(Math.cos(radians) * distance, Math.sin(radians) * distance, 38)),
    angles: { pitch: 90, yaw: Math.random() * 360, roll: 0 },
  };
}

function spawnFinaleBossIdleEyes(runtime) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.bossPhase || runtime.finaleBossIdleEyes) return 0;
  const count = finaleBossSpawnCount(runtime, runtime.infinite === true);
  runtime.finaleBossIdleEyes = [];
  for (let index = 0; index < count; index++) {
    const placement = finaleBossIdlePlacement(runtime);
    const visual = spawnVisual(runtime, {
      ...placement,
      feature: `finaleBossVisual_${index}`,
    }, FINALE_BOSS_CONFIG.model);
    if (!validEntity(visual)) continue;
    visual.SetModelScale?.(FINALE_BOSS_CONFIG.modelScale);
    fireTarget(visual, "SetAnimation", "idle_closed");
    fireTarget(visual, "SetDefaultAnimation", "idle_closed", 0.01);
    runtime.finaleBossIdleEyes.push({ ...placement, visual });
  }
  return runtime.finaleBossIdleEyes.length;
}

function spawnFinaleBoss(runtime, options = {}) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.lifecycle !== "active") {
    throw new Error("FINALE boss requires an active FINALE runtime");
  }
  for (const key of ["hold", "bossPieceTouch", "bossEyeTouch", "bossEyeDamage", "bossGrenadeDamage"]) {
    const template = featureTemplate(key);
    if (typeof template.ForceSpawn !== "function") {
      throw new Error(`FINALE requires ${FEATURE_TEMPLATE_NAMES[key]}; recompile the updated VMAP`);
    }
  }
  const center = finaleBossArenaCenter(runtime);
  runtime.bossArena ??= {
    center: clone(center),
    halfSize: FINALE_BOSS_CONFIG.arenaHalfSize * CONFIG.gridSize,
    smoothValue: FINALE_BOSS_CONFIG.arenaSmoothValue,
  };
  runtime.infinite = options.infinite === true || runtime.infinite === true;
  runtime.bossDamageMultiplier = finaleBossDamageMultiplier(runtime, runtime.infinite);
  const count = finaleBossSpawnCount(runtime, runtime.infinite);
  const aliveHumans = finaleBossAliveHumans().length;
  const health = finaleBossHealth(runtime, aliveHumans, count, runtime.infinite);
  runtime.bossPhase = "boss_intro";
  runtime.bossStartedAt = Instance.GetGameTime();
  runtime.bossFightActiveAt = runtime.bossStartedAt + 1.4;
  runtime.bossHurtFxCount = 0;
  runtime.bosses.clear();
  runtime.bossGrenadeHitCount = 0;
  clearFinaleBossBullets(runtime);
  runtime.bossPieceTouchCooldowns ??= new Map();
  runtime.bossPieceTouchCooldowns.clear();
                                                                       
                                                                             
                                                                            
  const idleEyes = runtime.finaleBossIdleEyes ?? [];
  runtime.finaleBossIdleEyes = undefined;
  for (const idle of idleEyes.slice(count)) destroyEndingEntity(runtime, idle.visual);
  for (let index = 0; index < count; index++) {
    const idle = idleEyes[index];
    const placement = idle && validEntity(idle.visual) ? idle : finaleBossIdlePlacement(runtime);
    const position = clone(placement.position);
    const angles = { ...placement.angles };
    const boss = {
      id: index,
      position: clone(position),
      angles,
      visual: undefined,
      hitboxes: new Set(),
      health,
      maxHealth: health,
      dead: false,
      stunJustStunned: true,
      damageFxCooldownUntil: 0,
      stunUntil: 0,
      touchCooldowns: new Map(),
      grenadeHitCount: 0,
      grenadeHitboxHealth: 0,
      damageEvents: [],
      target: undefined,
      targetPosition: clone(center),
      destination: undefined,
      interpolationStart: clone(position),
      interpolationProgress: 1,
      interpolationSpeed: FINALE_BOSS_CONFIG.movementInterpolationMin,
      interpolateMovement: false,
      nextTargetAt: Instance.GetGameTime(),
      nextMovementAt: Instance.GetGameTime(),
      nextSightAt: Instance.GetGameTime() + FINALE_BOSS_CONFIG.attackSightCooldown,
      nextAttackAt: Instance.GetGameTime() + 1,
                                                                         
                                                                     
      nextBlinkAt: Instance.GetGameTime() + 0.4
        + FINALE_BOSS_CONFIG.blinkInitialMin
        + Math.random() * (FINALE_BOSS_CONFIG.blinkInitialMax - FINALE_BOSS_CONFIG.blinkInitialMin),
      eyelidOpen: false,
      firstMovementAt: Instance.GetGameTime() + 1,
      firstMovement: 0,
      movementCount: 0,
      movementPauseUntil: 0,
      shouldMove: false,
      pieces: new Set(),
      collectingPieces: new Set(),
      pieceCollectBuffer: [],
      chainPieces: [],
      damageHitbox: undefined,
      damageHitboxHealth: 0,
      damageHitboxTemplate: undefined,
      pieceCountTarget: FINALE_BOSS_CONFIG.pieceTarget,
      midspinUntil: 0,
      midspinDropAt: 0,
      midspin: false,
      tailAim: false,
      tailAimAttackUntil: 0,
      tailAimForceUntil: Instance.GetGameTime() + FINALE_BOSS_CONFIG.tailAimForceCooldown
        + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset,
      tailSnapPosition: undefined,
      tailSnapActive: false,
      tailSnapLiftResetAt: 0,
      tailSnapClearAt: 0,
      tailSnapLiftMult: 1,
      tailSnapLiftMult2: 0,
      pieceSin: 0,
      flingUntil: 0,
      flingChargeVisuals: 0,
      deadVelocity: vec(),
      deadRotation: vec(),
      deadFadeoutTicks: 0,
    };
    // Reuse the idle eye that has been resting on the arena since the tower
    // elevator left, so the model does not pop in when the fight begins.
    boss.visual = placement.visual ?? spawnVisual(runtime, {
      position,
      angles,
      feature: `finaleBossVisual_${index}`,
    }, FINALE_BOSS_CONFIG.model);
    if (!validEntity(boss.visual)) throw new Error("FINALE boss visual did not spawn");
    boss.visual.SetModelScale?.(FINALE_BOSS_CONFIG.modelScale);
    finaleBossSetAnimation(boss, "idle_closed", "idle_closed");
    boss.hitbox = finaleBossTrigger(runtime, boss, "eye", FINALE_BOSS_CONFIG.eyeMins, FINALE_BOSS_CONFIG.eyeMaxs);
    boss.grenadeHitbox = spawnFinaleBossDamageHitbox(runtime, boss,
      FINALE_BOSS_CONFIG.grenadeMins, FINALE_BOSS_CONFIG.grenadeMaxs, "grenade");
    boss.damageHitbox = spawnFinaleBossDamageHitbox(
      runtime, boss, FINALE_BOSS_CONFIG.eyeMins, FINALE_BOSS_CONFIG.eyeMaxs,
    );
    connectOwnedOutput(runtime, boss.damageHitbox, "OnTakeDamage", (event) => {
      finaleBossDamageHitboxEvent(runtime, boss, event);
    });
    connectOwnedOutput(runtime, boss.damageHitbox, "OnHealthChanged", (event) => {
      finaleBossDamageHitboxEvent(runtime, boss, event, "health");
    });
    connectOwnedOutput(runtime, boss.hitbox, "OnStartTouch", (data) => {
      const pawn = resolvePawn(data?.activator ?? data);
      finaleBossTouchDamage(runtime, boss, pawn, FINALE_BOSS_CONFIG.eyeTouchDamage, boss.hitbox);
    });
    connectOwnedOutput(runtime, boss.grenadeHitbox, "OnTakeDamage", (data) => {
      finaleBossGrenadeHitboxEvent(runtime, boss, data);
    });
    connectOwnedOutput(runtime, boss.grenadeHitbox, "OnHealthChanged", (data) => {
      finaleBossGrenadeHitboxEvent(runtime, boss, data, "health");
    });
    runtime.bosses.add(boss);
  }
  spawnFinaleBossFallTrigger(runtime);
  runtime.bossAliveHumanCount = aliveHumans;
                                                                          
                                                                           
                                                  
  runtime.nextBossAliveCountAt = runtime.bossStartedAt + FINALE_BOSS_CONFIG.aliveHumanCheckInterval;
  announce(`FINALE: ${count} boss eye${count === 1 ? "" : "s"} entered the arena`);
  return runtime.bosses;
}

function finaleBossChooseTarget(boss) {
  return finaleBossChooseRandomTarget(boss);
}

                                                                            
                                                                           
                                                                          
                                                                          
                                                                               
                                                                       
                                                
function finaleBossAimAtTarget(boss) {
  if (!boss || boss.dead || !boss.position) return false;
                                                                          
                                                                            
                                                 
  let current = forwardFromAngles(boss.angles ?? { pitch: 90, yaw: 0, roll: 0 });
  let targetDirection;
  if (boss.midspin) {
                                                                             
                                                                            
                                                                              
                                                                              
                                                              
    const horizontalLength = Math.hypot(current.x, current.y);
    const yaw = Number(boss.angles?.yaw ?? 0) * Math.PI / 180;
    const horizontal = horizontalLength > 0.0001
      ? vec(current.x / horizontalLength, current.y / horizontalLength, 0)
      : vec(Math.cos(yaw), Math.sin(yaw), 0);
                                                                       
                                                                        
    current = clone(horizontal);
    boss.forwardDirection = clone(horizontal);
    targetDirection = vec(-horizontal.y, horizontal.x, 0);
  } else {
    let targetPosition;
    if (boss.tailSnapPosition) {
      targetPosition = boss.tailSnapPosition;
    } else if (boss.target && boss.target.IsAlive?.() !== false) {
      const origin = boss.target.GetAbsOrigin?.();
      if (origin) targetPosition = add(origin, vec(0, 0, 48));
    }
    if (!targetPosition && boss.targetPosition) targetPosition = add(boss.targetPosition, vec(0, 0, 48));
    if (!targetPosition && boss.destination) targetPosition = boss.destination;
    if (!targetPosition) return false;
    const delta = sub(targetPosition, boss.position);
    const targetLength = Math.hypot(delta.x, delta.y, delta.z) || 1;
    targetDirection = mul(delta, 1 / targetLength);
  }
  const lookSpeed = boss.midspin ? 0.05 : 0.02;
  const blended = add(current, mul(targetDirection, lookSpeed));
  const length = Math.hypot(blended.x, blended.y, blended.z) || 1;
  boss.forwardDirection = vec(blended.x / length, blended.y / length, blended.z / length);
  boss.angles = anglesFromDirection(boss.forwardDirection);
  return true;
}

function finaleBossBeginFling(runtime, boss, now) {
  if (boss.flingUntil > now || boss.dead) return false;
  boss.flingUntil = now + FINALE_BOSS_CONFIG.attackFlingCharge;
  boss.shouldMove = false;
  boss.nextAttackAt = boss.flingUntil;
  finaleBossSetAnimation(boss, "idle_open", "idle_open", 1.5, now);
  endingTaskAt(runtime, boss.flingUntil, () => {
    if (!boss.dead) finaleBossFlingAttack(runtime, boss, boss.flingUntil);
  }, `finale_boss_fling_${runtime.sequence}_${boss.id}_${Math.round(now * 100)}`);
                                                                             
                                                                         
                                                                           
  const charge = FINALE_BOSS_CONFIG.attackFlingCharge;
  for (let pitch = 30; pitch <= 80; pitch += 5) {
    const delay = pitch === 30
      ? 0
      : Math.max(0, Math.min(charge - 0.02, charge - (80 - pitch) / 30));
    endingTaskAt(runtime, now + delay, () => {
      if (boss.dead || boss.flingUntil <= 0) return;
      playSourceAudioCue(14675, boss.position, {
        pitch: pitch + Math.floor(Math.random() * 11) - 5,
      });
    }, `finale_boss_fling_charge_${runtime.sequence}_${boss.id}_${pitch}_${Math.round(now * 100)}`);
  }
  return true;
}

function finaleBossBeginMovement(runtime, boss, now) {
  if (boss.dead || boss.flingUntil > now || now < (boss.movementPauseUntil ?? 0)) return false;
  if (boss.movementCount === 0) {
    boss.destination = add(finaleBossArenaCenter(runtime), vec(0, 0, FINALE_BOSS_CONFIG.firstMovementHeight));
  } else {
    const angle = Math.random() * Math.PI * 2;
    const radius = Math.random() * ((runtime.bossArena?.halfSize ?? 0) + 500);
    const target = finaleBossArenaCenter(runtime);
    const height = boss.lowDrift ? FINALE_BOSS_CONFIG.lowDriftHeight
      : FINALE_BOSS_CONFIG.roamHeightMin + Math.random() * (FINALE_BOSS_CONFIG.roamHeightMax - FINALE_BOSS_CONFIG.roamHeightMin);
    boss.destination = add(target, vec(Math.cos(angle) * radius, Math.sin(angle) * radius, height));
  }
  boss.interpolationStart = clone(boss.position);
  boss.interpolationProgress = 0;
                                                                       
                                                                           
                                                              
  boss.interpolateMovement = boss.movementCount === 0 || Math.random() < 0.5;
  boss.interpolationSpeed = FINALE_BOSS_CONFIG.movementInterpolationMin
    + Math.random() * (FINALE_BOSS_CONFIG.movementInterpolationMax - FINALE_BOSS_CONFIG.movementInterpolationMin);
  boss.lastMovedAt = now;
  boss.lastPosition = clone(boss.position);
  boss.shouldMove = true;
  boss.movementCount++;
  boss.firstMovement = boss.movementCount;
  boss.nextMovementAt = now + FINALE_BOSS_CONFIG.tickRate;
  return true;
}

function finaleBossQueuePieces(runtime, boss) {
  if (!runtime || !boss || boss.dead) return 0;
  const completedCount = [...(boss.pieces ?? [])]
    .filter((piece) => piece.bossCollected && !piece.isBullet).length;
  const collectingCount = boss.collectingPieces?.size ?? 0;
  if (completedCount + collectingCount >= boss.pieceCountTarget) return 0;
  const arenaZ = finaleBossArenaCenter(runtime).z;
                                                                            
                                                                            
                                                                       
  const scanCenter = vec(boss.position.x, boss.position.y, arenaZ);
  const nearby = (runtime.layout?.pieces ?? []).filter((piece) => {
    if (piece.bossCollected || piece.bossCollecting || piece.bossCollectQueued) return false;
    const position = piece.position ?? piece.entities?.[0]?.GetAbsOrigin?.();
    if (!position) return false;
    return Math.hypot(
      position.x - scanCenter.x,
      position.y - scanCenter.y,
      position.z - scanCenter.z,
    ) <= FINALE_BOSS_CONFIG.pieceScanRadius;
  });
  boss.pieceCollectBuffer ??= [];
                                                                             
                                                                           
                                                        
  for (const piece of nearby) {
    piece.bossCollectQueued = true;
    boss.pieceCollectBuffer.push(piece);
  }
  return nearby.length;
}

function finaleBossMove(runtime, boss, elapsed, now) {
  if (boss.dead) return;
                                                                              
                                                                            
                                                   
  const targetInvalid = !boss.target?.IsAlive?.()
    || boss.target.GetTeamNumber?.() !== 3;
  if (now >= boss.nextTargetAt || targetInvalid) {
    const target = finaleBossChooseTarget(boss);
    boss.target = target?.pawn;
    boss.targetPosition = target?.position ?? finaleBossArenaCenter(runtime);
    boss.nextTargetAt = now + FINALE_BOSS_CONFIG.targetRefresh;
  }
  if (boss.midspin) {
    const center = finaleBossArenaCenter(runtime);
                                                                             
                                                                        
                                                                       
    const midspinStarted = now >= (boss.midspinStartedAt ?? now)
      && now < (boss.midspinDropAt ?? Number.POSITIVE_INFINITY);
    const target = add(center, vec(0, 0, midspinStarted ? 20 : 500));
    const delta = sub(target, boss.position);
    const distance = Math.hypot(delta.x, delta.y, delta.z);
    if (distance > 0.01) {
                                                                       
                                                                           
                                                                        
      const divisor = midspinStarted ? 30 : 20;
      const iterations = Math.max(1, elapsed * 100);
      const fraction = Math.min(1, 1 - Math.pow(1 - (1 / divisor), iterations));
      boss.position = add(boss.position, mul(delta, fraction));
    }
    finaleBossAimAtTarget(boss);
    boss.visual?.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
    boss.visual?.SetForwardVector?.(boss.forwardDirection);
    finaleBossSyncHitbox(boss, boss.hitbox, boss.position);
    finaleBossSyncHitbox(boss, boss.grenadeHitbox, boss.position);
    finaleBossSyncHitbox(boss, boss.damageHitbox, boss.position);
    boss.nextMovementAt = now + FINALE_BOSS_CONFIG.tickRate;
    return;
  }
                                                                           
                                                                            
  finaleBossAimAtTarget(boss);
  if (now < (boss.movementPauseUntil ?? 0) || now < (boss.stunUntil ?? 0) || boss.flingUntil > now) {
    boss.visual?.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
    boss.visual?.SetForwardVector?.(boss.forwardDirection);
    finaleBossSyncHitbox(boss, boss.hitbox, boss.position);
    finaleBossSyncHitbox(boss, boss.grenadeHitbox, boss.position);
    finaleBossSyncHitbox(boss, boss.damageHitbox, boss.position);
    return;
  }
  if (boss.movementPauseUntil && now >= boss.movementPauseUntil) boss.movementPauseUntil = 0;
                                                                            
                                                                         
                                                                             
  if (boss.lastMovedAt !== undefined && now - boss.lastMovedAt > 1
    && boss.lastPosition
    && Math.hypot(boss.position.x - boss.lastPosition.x, boss.position.y - boss.lastPosition.y, boss.position.z - boss.lastPosition.z) < 1) {
    boss.destination = undefined;
    boss.interpolationProgress = 1;
    boss.nextMovementAt = now;
    boss.movementPauseUntil = 0;
  }
  const destinationDistance = boss.destination
    ? Math.hypot(
      boss.destination.x - boss.position.x,
      boss.destination.y - boss.position.y,
      boss.destination.z - boss.position.z,
    )
    : 0;
  const reachedDestination = !boss.destination
    || (boss.interpolateMovement
      ? boss.interpolationProgress >= 0.95
      : destinationDistance <= 100);
  if (reachedDestination) {
    finaleBossQueuePieces(runtime, boss);
                                                                          
                                                                 
    const collectedCount = [...(boss.pieces ?? [])].filter((piece) => piece.bossCollected && !piece.isBullet).length
      + (boss.collectingPieces?.size ?? 0);
                                                                           
                                                                             
                                                 
    if (Math.random() * 100 <= FINALE_BOSS_CONFIG.tailAimToggleChance
      || (!boss.tailAim && now >= (boss.tailAimForceUntil ?? 0))) {
      finaleBossSetTailAim(boss, !boss.tailAim, now);
    }
    if (Math.random() * 100 <= FINALE_BOSS_CONFIG.lowDriftToggleChance) boss.lowDrift = !boss.lowDrift;
    boss.tailSnapLiftMult2 = boss.lowDrift ? 1 : 0;
    if (Math.random() * 100 <= FINALE_BOSS_CONFIG.playSoundChance) {
      playFinaleBossTerrorBurst(boss.position, 1, 3, 40, 120);
    }
    if (boss.flingUntil <= 0
      && collectedCount >= FINALE_BOSS_CONFIG.attackSpinMinPieces
      && Math.random() * 100 <= FINALE_BOSS_CONFIG.attackSpinChance) {
      finaleBossStartSpin(boss, now);
      boss.destination = undefined;
      return;
    }
    if (boss.movementCount >= 2 && Math.random() * 100 <= FINALE_BOSS_CONFIG.attackFlingChance) {
      if (finaleBossBeginFling(runtime, boss, now)) return;
    }
    if (boss.movementCount === 1 && !boss.firstMovementPauseDone) {
      boss.firstMovementPauseDone = true;
      boss.movementPauseUntil = now + FINALE_BOSS_CONFIG.firstMovementPause;
      boss.destination = undefined;
      return;
    }
    finaleBossBeginMovement(runtime, boss, now);
  }
  if (now < boss.nextMovementAt || !boss.destination) return;
  const previousPosition = clone(boss.position);
  const iterations = Math.max(1, elapsed * 100);
  if (boss.interpolateMovement) {
    boss.interpolationProgress = Math.min(1,
      boss.interpolationProgress + boss.interpolationSpeed * iterations);
    const smooth = finaleBossSmootherStep(boss.interpolationProgress);
    boss.position = add(
      boss.interpolationStart,
      mul(sub(boss.destination, boss.interpolationStart), smooth),
    );
  } else {
                                                                      
                                                                         
                                   
    const delta = sub(boss.destination, boss.position);
    const distance = Math.hypot(delta.x, delta.y, delta.z);
    if (distance > 0.01) {
      const fraction = 1 - Math.pow(0.99, iterations);
      boss.position = add(boss.position, mul(delta, Math.min(1, fraction)));
    }
  }
  if (Math.hypot(boss.position.x - previousPosition.x, boss.position.y - previousPosition.y, boss.position.z - previousPosition.z) >= 0.01) boss.lastMovedAt = now;
  boss.lastPosition = clone(boss.position);
  finaleBossAimAtTarget(boss);
  boss.nextMovementAt = now + FINALE_BOSS_CONFIG.tickRate;
  boss.visual?.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
  boss.visual?.SetForwardVector?.(boss.forwardDirection);
  finaleBossSyncHitbox(boss, boss.hitbox, boss.position);
  finaleBossSyncHitbox(boss, boss.grenadeHitbox, boss.position);
  finaleBossSyncHitbox(boss, boss.damageHitbox, boss.position);
}

function finaleBossCollectPieces(runtime, boss, now) {
  const completedCount = [...(boss.pieces ?? [])]
    .filter((piece) => piece.bossCollected && !piece.isBullet).length;
  const collectingCount = boss.collectingPieces?.size ?? 0;
  if (boss.dead) return;
  // At the piece target only stop picking new pieces; pieces already in
  // flight must keep advancing or they freeze mid-air (Source 1 moved each
  // collecting piece from its own TickMove, independent of this count).
  const atTarget = completedCount + collectingCount >= boss.pieceCountTarget;
  if (atTarget) {
    for (const piece of boss.pieceCollectBuffer ?? []) piece.bossCollectQueued = false;
    boss.pieceCollectBuffer?.splice?.(0);
  }
  if (!atTarget && now >= (boss.nextPieceCollectAt ?? 0)) {
    boss.nextPieceCollectAt = now + FINALE_BOSS_CONFIG.pieceCollectInterval;
    boss.pieceCollectBuffer ??= [];
    let piece;
    while (boss.pieceCollectBuffer.length > 0 && !piece) {
      const index = Math.floor(Math.random() * boss.pieceCollectBuffer.length);
      const candidate = boss.pieceCollectBuffer.splice(index, 1)[0];
      if (!candidate || candidate.bossCollected || candidate.bossCollecting) continue;
      candidate.bossCollectQueued = false;
      piece = candidate;
    }
    if (piece) {
      const position = piece.position ?? piece.entities?.[0]?.GetAbsOrigin?.();
      piece.bossCollecting = true;
      piece.bossTouchActiveAt = now + FINALE_BOSS_CONFIG.pieceTouchEnableDelay;
      piece.bossCollector = boss;
      piece.bossCollectStartedAt = now;
                                                                            
                                                                             
                                                           
      piece.bossCollectMotionAt = now + FINALE_BOSS_CONFIG.pieceCollectWarning + 0.02;
      piece.bossCollectActivated = false;
      piece.bossCollectProgress = 0;
      piece.bossCollectStart = clone(position);
      piece.angles ??= bodyAngles(piece.entities?.find((entity) => validEntity(entity)))
        ?? anglesFor(runtime.direction);
      for (const entity of piece.entities ?? []) entity.SetColor?.({ r: 255, g: 50, b: 50, a: 255 });
      boss.collectingPieces ??= new Set();
      boss.collectingPieces.add(piece);
    }
  }
  for (const piece of [...(boss.collectingPieces ?? [])]) {
    if (now < (piece.bossCollectMotionAt ?? now)) continue;
    if (!piece.bossCollectActivated) {
      piece.bossCollectActivated = true;
      playSourceAudioCue(14322, piece.position);
      for (const entity of piece.entities ?? []) {
                                                                            
                                                                          
                                                                             
                                                                       
                                    
        try { entity.SetSolid?.(5); } catch {                                  }
        fireTarget(entity, "SetSolid", "5");
        raceSetCollisionGroup(entity, FINALE_BOSS_CONFIG.collisionGroup);
        entity.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
      }
    }
    piece.bossCollectProgress = Math.min(1, (piece.bossCollectProgress ?? 0)
      + FINALE_BOSS_CONFIG.pieceMoveMin
      + Math.random() * (FINALE_BOSS_CONFIG.pieceMoveMax - FINALE_BOSS_CONFIG.pieceMoveMin));
                                                                            
                                                                           
                                                       
    const completed = boss.chainPieces?.at(-1);
    const targetPosition = completed?.position ?? boss.position;
    const targetForward = completed?.angles
      ? forwardFromAngles(completed.angles)
      : boss.forwardDirection
        ? clone(boss.forwardDirection)
        : forwardFromAngles(boss.angles ?? { pitch: 90, yaw: 0, roll: 0 });
    const currentForward = forwardFromAngles(piece.angles ?? anglesFor(runtime.direction));
    const blendedForward = add(currentForward, mul(targetForward, 0.03));
    const blendedLength = Math.hypot(blendedForward.x, blendedForward.y, blendedForward.z) || 1;
    piece.angles = anglesFromDirection(mul(blendedForward, 1 / blendedLength));
    const position = add(piece.bossCollectStart,
      mul(sub(targetPosition, piece.bossCollectStart), finaleBossSmootherStep(piece.bossCollectProgress)));
    piece.position = clone(position);
    for (const entity of piece.entities ?? []) {
      entity.Teleport?.({ position, angles: piece.angles, velocity: vec() });
      entity.SetColor?.({ r: piece.bossCollectProgress < 1 ? 255 : 255, g: piece.bossCollectProgress < 1 ? 50 : 255, b: piece.bossCollectProgress < 1 ? 50 : 255, a: 255 });
    }
    if (piece.bossCollectProgress >= 1) {
      piece.bossCollected = true;
      piece.bossCollecting = false;
      piece.bossCollectedAt = now;
      boss.collectingPieces.delete(piece);
      boss.pieces.add(piece);
      boss.chainPieces ??= [];
      boss.chainPieces.push(piece);
    }
  }
}

function finaleBossSyncChain(boss) {
  if (!boss.chainPieces?.length) return;
  const now = Instance.GetGameTime();
  boss.pieceSin = (boss.pieceSin ?? 0) - 0.05;
  const pieces = boss.chainPieces.filter((piece) => piece.bossCollected && !piece.isBullet);
  if (!pieces.length) return;
  const forward = boss.forwardDirection
    ? clone(boss.forwardDirection)
    : forwardFromAngles(boss.angles ?? { pitch: 0, yaw: 0, roll: 0 });
  let lead = clone(boss.position);
  for (let chainIndex = 0; chainIndex < pieces.length; chainIndex++) {
    const piece = pieces[chainIndex];
    const index = chainIndex + 1;
                                                                             
                                                                 
    if (index === 1) {
      const firstPosition = add(lead, mul(forward, -80));
      piece.position = firstPosition;
                                                                        
                                                                          
                                                                          
      for (const entity of piece.entities ?? []) {
        if (validEntity(entity)) entity.Teleport?.({ position: firstPosition, velocity: vec() });
      }
      lead = firstPosition;
      continue;
    }

    let newPosition = clone(piece.position ?? lead);
    newPosition = add(newPosition, vec(
      Math.random() * 2 - 1,
      Math.random() * 2 - 1,
      Math.random() * 2 - 1,
    ));
    const tailSnapMultiplier = boss.tailSnapActive ? 20 : 1;
    let target = boss.tailSnapPosition ? clone(boss.tailSnapPosition) : undefined;
    if (!target && boss.target && boss.target.IsAlive?.() !== false) {
      target = boss.target.EyePosition?.()
        ?? boss.target.GetEyePosition?.()
        ?? (boss.target.GetAbsOrigin?.()
          ? add(boss.target.GetAbsOrigin(), vec(0, 0, 48))
          : undefined);
    }
    if (!boss.dead && boss.midspin) {
      newPosition = add(newPosition, mul(forward, -50));
                                                                           
                                                                            
                                                                            
      if (now >= (boss.midspinStartedAt ?? Number.POSITIVE_INFINITY)
        && now < (boss.midspinDropAt ?? Number.POSITIVE_INFINITY)) {
        newPosition.z += boss.position.z - (piece.position?.z ?? newPosition.z);
      }
    } else if (!boss.dead && boss.tailAim && target) {
      const zIndex = pieces.length + 1 - index;
      const delta = sub(target, piece.position ?? newPosition);
      const targetDistance = Math.hypot(delta.x, delta.y, delta.z) || 1;
      let distance = index * tailSnapMultiplier;
      if (targetDistance <= distance) distance = targetDistance;
      newPosition = add(newPosition, mul(delta, distance / targetDistance));
      newPosition.z += zIndex * ((boss.tailSnapLiftMult ?? 1) + (boss.tailSnapLiftMult2 ?? 0));
    } else {
      newPosition.z += Math.sin(boss.pieceSin + (index / 2)) * 4;
      newPosition = add(newPosition, mul(forward, -8));
      newPosition.z += boss.lowDrift ? 5 : -1;
    }

                                                                       
                                                                           
                                                                          
                                                                      
    if (boss.tailSnapActive && boss.tailSnapPosition
      && Math.hypot(
        newPosition.x - boss.tailSnapPosition.x,
        newPosition.y - boss.tailSnapPosition.y,
        newPosition.z - boss.tailSnapPosition.z,
      ) < 5) {
      boss.tailSnapActive = false;
      boss.tailSnapLiftMult = 2;
      boss.tailSnapLiftResetAt = Math.min(
        boss.tailSnapLiftResetAt || Number.POSITIVE_INFINITY,
        now + 0.5,
      );
    }

    const segment = sub(newPosition, lead);
    const segmentDistance = Math.hypot(segment.x, segment.y, segment.z);
    if (segmentDistance > 90) newPosition = add(lead, mul(segment, 90 / segmentDistance));
    const pieceDirection = sub(newPosition, lead);
    const pieceLength = Math.hypot(pieceDirection.x, pieceDirection.y, pieceDirection.z) || 1;
    piece.position = newPosition;
                                                                           
                                                                         
                                                               
    const pieceForward = mul(pieceDirection, 1 / pieceLength);
    piece.angles = anglesFromDirection(pieceForward);
    for (const entity of piece.entities ?? []) {
      if (!validEntity(entity)) continue;
      entity.Teleport?.({ position: newPosition, angles: piece.angles, velocity: vec() });
      entity.SetForwardVector?.(pieceForward);
    }
    lead = newPosition;
  }
  boss.lastSyncAt = Instance.GetGameTime();
}

function finaleBossDamagePieceTouch(runtime, pawn, damage, now) {
  if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) return false;
                                                                         
                                                                            
  runtime.bossPieceTouchCooldowns ??= new Map();
  if ((runtime.bossPieceTouchCooldowns.get(pawn) ?? 0) > now) return false;
  runtime.bossPieceTouchCooldowns.set(pawn, now + FINALE_BOSS_CONFIG.pieceTouchCooldown);
  const health = pawn.GetHealth?.();
                                                                             
                                                                            
  if (Number.isFinite(health) && health > damage && typeof pawn.SetHealth === "function") {
    pawn.SetHealth(health - damage);
  } else pawn.TakeDamage?.({ damage, damageFlags: CSDamageFlags.IGNORE_ARMOR ?? 0 });
  return true;
}

function finaleBossPieceDamage(runtime, boss, now) {
  const humans = finaleBossAliveHumans();
  const activePieces = new Set([
    ...(boss.pieces ?? []),
    ...(boss.collectingPieces ?? []),
  ]);
  for (const piece of activePieces) {
    if (!piece.bossCollected && !piece.bossCollecting) continue;
    if (now < (piece.bossTouchActiveAt ?? Number.POSITIVE_INFINITY)) continue;
    for (const pawn of humans) {
      if (!finaleBossPieceTouchesPawn(piece, pawn)) continue;
      const damage = (piece.isBullet
        ? FINALE_BOSS_CONFIG.pieceBulletDamage
        : boss.midspin
          ? FINALE_BOSS_CONFIG.pieceMidspinDamage
          : boss.tailSnapActive
            ? FINALE_BOSS_CONFIG.pieceSnapDamage
            : FINALE_BOSS_CONFIG.pieceTouchDamage) * (runtime.bossDamageMultiplier ?? 1);
      finaleBossDamagePieceTouch(runtime, pawn, damage, now);
    }
  }
}

function finaleBossStartSpin(boss, now) {
  boss.midspin = true;
  boss.midspinStartedAt = now + FINALE_BOSS_CONFIG.spinStartup;
                                                                          
                                                               
  boss.midspinDropAt = now + FINALE_BOSS_CONFIG.attackSpinLength;
  boss.midspinUntil = now + FINALE_BOSS_CONFIG.attackSpinLength + 0.5;
  boss.nextAttackAt = boss.midspinUntil;
  boss.tailAim = false;
  boss.tailAimForceUntil = now + FINALE_BOSS_CONFIG.tailAimForceCooldown
    + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset;
  boss.shouldMove = true;
  finaleBossSetAnimation(boss, "idle_open", "idle_open", 1.5, now);
  playSourceAudioCue(14826, boss.position);
  playFinaleBossTerrorBurst(boss.position, 2, 4, 20, 200);
}

function finaleBossStartTailSnap(runtime, boss, now) {
  if (!boss.tailAim || boss.midspin || boss.tailSnapPosition || now < (boss.tailAimAttackUntil ?? 0)) return false;
  const target = boss.target?.GetAbsOrigin?.();
  if (!target) return false;
  const velocity = boss.target.GetAbsVelocity?.() ?? vec();
  const horizontal = Math.hypot(velocity.x, velocity.y);
  const lead = horizontal > 400 ? 400 : horizontal;
  const direction = horizontal > 0.01 ? vec(velocity.x / horizontal, velocity.y / horizontal, 0) : vec();
  boss.tailSnapPosition = add(target, add(mul(direction, lead * FINALE_BOSS_CONFIG.tailSnapDelay), vec(0, 0, 4)));
  boss.tailSnapStrikeAt = now + FINALE_BOSS_CONFIG.tailSnapDelay;
  boss.tailSnapUntil = boss.tailSnapStrikeAt + FINALE_BOSS_CONFIG.tailSnapDuration;
  boss.tailSnapClearAt = boss.tailSnapUntil + FINALE_BOSS_CONFIG.tailSnapClearDelay;
  boss.tailSnapLiftResetAt = now + FINALE_BOSS_CONFIG.tailSnapDelay + 1.4;
  boss.tailSnapActive = false;
  boss.tailSnapLiftMult = 2;
  boss.nextAttackAt = boss.tailSnapClearAt;
  endingTaskAt(runtime, boss.tailSnapStrikeAt, () => {
    if (!boss.dead && boss.tailSnapPosition) boss.tailSnapActive = true;
  }, `finale_boss_tailsnap_strike_${runtime.sequence}_${boss.id}_${Math.round(now * 100)}`);
  endingTaskAt(runtime, now + FINALE_BOSS_CONFIG.tailSnapDelay * 0.9, () => {
    if (!boss.dead && boss.tailAim && !boss.midspin) {
      const count = 1 + Math.floor(Math.random() * 4);
      for (let index = 0; index < count; index++) {
        playSourceAudioCue(14448, boss.tailSnapPosition, {
          pitch: 40 + Math.floor(Math.random() * 61),
        });
      }
    }
  }, `finale_boss_tailsnap_clang_${runtime.sequence}_${Math.round(now * 100)}`);
  playCatalogSound("eye_terror3", boss.position, {radius:50000,lifetime:5});
  return true;
}

function finaleBossStartTailShoot(runtime, boss, now) {
  if (!boss.tailAim || boss.midspin || boss.tailSnapPosition || now < (boss.tailAimAttackUntil ?? 0)) return false;
  const target = boss.target?.GetAbsOrigin?.();
  const tail = boss.chainPieces?.filter((piece) => piece.bossCollected && !piece.isBullet).at(-1);
  if (!target || !tail || !tail.position) return false;
  const velocity = boss.target.GetAbsVelocity?.() ?? vec();
  const velocityLength = Math.hypot(velocity.x, velocity.y);
  const velocityScale = velocityLength > 400 ? 400 / velocityLength : 1;
  const predictedVelocity = vec(velocity.x * velocityScale, velocity.y * velocityScale, 0);
  const estimate = FINALE_BOSS_CONFIG.tailShootEstimateMin
    + Math.random() * (FINALE_BOSS_CONFIG.tailShootEstimateMax - FINALE_BOSS_CONFIG.tailShootEstimateMin);
  const predicted = add(target, add(mul(predictedVelocity, estimate), vec(0, 0, 32)));
  const delta = sub(predicted, tail.position);
  const distance = Math.hypot(delta.x, delta.y, delta.z) || 1;
  const entities = (tail.entities ?? []).filter(validEntity);
  const master = entities[0];
  if (!master) return false;
  const direction = mul(delta, 1 / distance);
  const bullet = {
    piece: tail,
    entities,
    position: clone(tail.position),
    direction,
    speed: FINALE_BOSS_CONFIG.tailShootSpeed,
    expiresAt: now + 3,
    activeAt: Math.max(now, tail.bossTouchActiveAt ?? now),
    retired: false,
  };
  const angles = tail.angles ?? anglesFor(runtime.direction);
  const request = { feature: "finaleTailShoot", position: bullet.position, angles };
  const original = entities.map(entity => ({ entity, parent: entity.GetParent?.(),
    position: clone(entity.GetAbsOrigin?.() ?? bullet.position), angles: entity.GetAbsAngles?.() ?? angles }));
  try {
    const model = master.GetModelName?.() || FINALE_BOSS_CONFIG.model;
    bullet.leg = spawnNativeMoverLeg(runtime, request, model, bullet.position,
      add(bullet.position, mul(direction, 20000)), bullet.speed);
    bullet.trigger = spawnTriggerVolume(runtime, { ...request, templateKey: "bossPieceTouch" },
      vec(-46, -46, -30), vec(46, 46, 0));
                                                                          
                                                                       
    for (const entity of entities) {
      entity.SetParent(bullet.leg.driver);
      entity.Teleport({ position: bullet.position, angles, velocity: vec() });
    }
    bullet.trigger.SetParent(master);
    bullet.trigger.Teleport({ position: bullet.position, angles, velocity: vec() });
    bullet.leg.connections.push(connectOwnedOutput(runtime, bullet.trigger, "OnStartTouch", data => {
      const touchAt = Instance.GetGameTime();
      if (runtime.lifecycle !== "active" || bullet.retired || !runtime.bossBullets.has(bullet)
        || touchAt < bullet.activeAt || touchAt >= bullet.expiresAt
        || !validEntity(bullet.leg.driver) || !validEntity(bullet.trigger) || !validEntity(master)) return;
      finaleBossDamagePieceTouch(runtime, resolvePawn(data?.activator),
        FINALE_BOSS_CONFIG.pieceBulletDamage * (runtime.bossDamageMultiplier ?? 1), touchAt);
    }));
  } catch (error) {
                                                                            
                                                                             
    for (const row of original) if (validEntity(row.entity)) {
      row.entity.SetParent(row.parent);
      row.entity.Teleport({ position: row.position, angles: row.angles, velocity: vec() });
    }
    retireFinaleBossBullet(runtime, bullet, true);
    throw error;
  }
  tail.isBullet = true;
  runtime.bossBullets.add(bullet);
  bullet.nextRefreshAt = bullet.activeAt + 0.1;
  fireTarget(bullet.trigger, "Enable", undefined, bullet.activeAt - now);
  fireTarget(bullet.leg.driver, "Open", undefined, 0.02);
                                                                          
                                                                            
  endingTask(runtime, 0.03, () => {
    if (bullet.retired || !validEntity(bullet.leg.driver) || !runtime.bossBullets.has(bullet)) return;
    for (const entity of entities) if (validEntity(entity)) {
      entity.Teleport({ angles: anglesFromDirection(direction) });
    }
  });
                                                                          
  for (const entity of [...entities, bullet.trigger, bullet.leg.driver, bullet.leg.anchor]) {
    fireTarget(entity, "Kill", undefined, 3);
  }
  boss.pieces.delete(tail);
  boss.chainPieces = boss.chainPieces.filter((piece) => piece !== tail);
  boss.nextAttackAt = now + Math.max(0.01, Number(CONFIG.thinkInterval ?? 0.01));
  playSourceAudioCue(14487, tail.position, {parent:bullet.leg.driver});
  return true;
}

function retireFinaleBossBullet(runtime, bullet, keepPiece = false) {
  if (!bullet || bullet.retired) return;
  bullet.retired = true;
                                                                          
  releaseNativeMoverLeg(runtime, bullet.leg);
  for (const entity of [bullet.trigger, ...(keepPiece ? [] : bullet.entities ?? []), bullet.visual]) {
    if (!entity) continue;
    if (validEntity(entity)) entity.Kill?.();
    for (const key of ["entities", "terrainEntities", "safeTerrainEntities", "internalEntities",
      "externalEntities", "externalTerrainEntities", "endingTerrainEntities", "endingSafeTerrainEntities"]) {
      runtime[key]?.delete(entity);
    }
    runtime.levelFadeColors?.delete(entity);
    state.silentHillWorld.visuals.delete(entity);
  }
  runtime.bossBullets?.delete(bullet);
}

function clearFinaleBossBullets(runtime) {
  for (const bullet of [...(runtime.bossBullets ?? [])]) retireFinaleBossBullet(runtime, bullet);
}

function processFinaleBossBullets(runtime, now) {
  for (const bullet of [...(runtime.bossBullets ?? [])]) {
    if (runtime.lifecycle !== "active" || now >= bullet.expiresAt
      || !validEntity(bullet.leg?.driver) || !validEntity(bullet.leg?.anchor)
      || !validEntity(bullet.trigger) || !bullet.entities?.some(validEntity)) {
      retireFinaleBossBullet(runtime, bullet);
      continue;
    }
                                                                       
                                                                          
    if (now >= bullet.nextRefreshAt) {
      bullet.nextRefreshAt = now + 0.1;
      fireTarget(bullet.trigger, "Disable");
      fireTarget(bullet.trigger, "Enable", undefined, 0.01);
    }
  }
}

function spawnFinaleBossAttackVisual(runtime, position, direction, color, speed, lifetime, scale = 2, feature = "finaleBossAttack", track = true) {
  if (!runtime || !position || !direction) return undefined;
  let visual;
  try {
    visual = spawnVisual(runtime, {
      position: clone(position),
      angles: anglesFromDirection(direction),
      feature,
    }, FINALE_BOSS_CONFIG.model);
  } catch (error) {
    runtime.finaleStructure?.notes?.push?.(`${feature} visual unavailable: ${error}`);
    return undefined;
  }
  if (!validEntity(visual)) return undefined;
  visual.SetModelScale?.(scale);
  visual.SetColor?.(color);
                                                                          
                                                   
  visual.Glow?.(color);
  const now = Instance.GetGameTime();
  const projectile = {
    visual,
    position: clone(position),
    direction: finaleKamikazeNormalize(direction),
    speed,
    expiresAt: now + lifetime,
    feature,
  };
  if (track) {
    runtime.bossAttackVisuals ??= new Set();
    runtime.bossAttackVisuals.add(projectile);
  }
  return projectile;
}

function processFinaleBossAttackVisuals(runtime, now, elapsed) {
  for (const projectile of [...(runtime?.bossAttackVisuals ?? [])]) {
    if (!validEntity(projectile.visual) || now >= projectile.expiresAt) {
      projectile.visual?.Kill?.();
      runtime.bossAttackVisuals.delete(projectile);
      continue;
    }
    projectile.position = add(projectile.position, mul(projectile.direction, projectile.speed * elapsed));
    projectile.visual.Teleport?.({
      position: projectile.position,
      angles: anglesFromDirection(projectile.direction),
      velocity: vec(),
    });
  }
}

function finaleBossFlingChargeTick(runtime, boss) {
  if (!runtime || !boss || boss.dead || !boss.flingUntil || boss.flingAppliedAt) return false;
                                                                          
                                                                           
                                                                        
                                                        
  const position = add(boss.position, vec(
    Math.random() * 2000 - 1000,
    Math.random() * 2000 - 1000,
    Math.random() * 300,
  ));
  const direction = directionBetween3D(position, boss.position);
  const visual = spawnFinaleBossAttackVisual(
    runtime,
    position,
    direction,
    { r: 150, g: 120, b: 20, a: 90 },
    2000,
    0.3,
    1,
    "finaleBossFlingCharge",
  );
  if (!visual) return false;
  boss.flingChargeVisuals = (boss.flingChargeVisuals ?? 0) + 1;
  return true;
}

function finaleBossAttackTick(runtime, boss, now) {
  if (boss.dead || now < (boss.stunUntil ?? 0) || now < (boss.nextAttackAt ?? now)) return;
  const collectedCount = [...(boss.pieces ?? [])]
    .filter((piece) => piece.bossCollected && !piece.isBullet).length;
  const interval = Math.max(0.01, Number(CONFIG.thinkInterval ?? 0.01));
  const sourceTicks = interval / 0.01;
                                                                         
                                                                          
                                                                      
  if (boss.tailAim) {
    const snapChecks = Math.max(0, collectedCount - 1) * sourceTicks;
    const snapChance = 1 - Math.pow(1 - FINALE_BOSS_CONFIG.tailSnapChance / 1000, snapChecks);
    if (Math.random() <= snapChance && finaleBossStartTailSnap(runtime, boss, now)) return;
    if (collectedCount >= FINALE_BOSS_CONFIG.tailShootMinPieces) {
      const shootChance = 1 - Math.pow(1 - FINALE_BOSS_CONFIG.tailShootChance / 1000, sourceTicks);
      if (Math.random() <= shootChance && finaleBossStartTailShoot(runtime, boss, now)) return;
    }
  }
  boss.nextAttackAt = now + interval;
}

function finaleBossApplyHumanDeathReduction(runtime, aliveHumans, now = Instance.GetGameTime()) {
  if (now < (runtime.nextBossAliveCountAt ?? now)) return;
  runtime.nextBossAliveCountAt = now + FINALE_BOSS_CONFIG.aliveHumanCheckInterval;
  const previous = runtime.bossAliveHumanCount;
  runtime.bossAliveHumanCount = aliveHumans.length;
  if (previous === undefined || aliveHumans.length >= previous) return;
  const reduction = (previous - aliveHumans.length) * FINALE_BOSS_CONFIG.healthReductionPerHumanDeath;
  for (const boss of runtime.bosses ?? []) {
    if (boss.dead) continue;
    boss.health = Math.max(0, boss.health - reduction);
    if (boss.health <= 0) {
      defeatFinaleBoss(runtime, boss);
      continue;
    }
                                                                           
                                                                         
                                                       
    if (validEntity(boss.damageHitbox)) {
      boss.damageHitboxHealth = FINALE_BOSS_HITBOX_HEALTH_BASE + boss.health;
      boss.damageHitbox.SetHealth?.(boss.damageHitboxHealth);
    }
  }
}

function finaleBossSightAttack(runtime, boss, now) {
  if (boss.dead || boss.eyelidOpen !== true || boss.midspin
    || now < (boss.stunUntil ?? 0) || now < boss.nextSightAt
    || finaleBossAliveHumans().length < FINALE_BOSS_CONFIG.attackSightMinHumans) return;
  const target = boss.target && boss.target.IsAlive?.() !== false
    ? { pawn: boss.target }
    : finaleBossChooseTarget(boss);
  if (!target?.pawn) return;
  const pawn = target.pawn;
  const targetOrigin = pawn.GetAbsOrigin?.();
  const targetPosition = pawn.EyePosition?.()
    ?? pawn.GetEyePosition?.()
    ?? (targetOrigin ? add(targetOrigin, vec(0, 0, 48)) : undefined);
  if (!targetPosition) return;
                                                                           
                                                                            
                                                                            
  const eyeDirection = forwardVector(pawn, true);
  const towardBoss = directionBetween3D(targetPosition, boss.position);
  const bossToPlayer = directionBetween3D(boss.position, targetPosition);
  const bossForward = boss.forwardDirection
    ? clone(boss.forwardDirection)
    : forwardFromAngles(boss.angles ?? { pitch: 0, yaw: 0, roll: 0 });
  const viewAngle = sourceDirectionDifference(targetPosition, boss.position, eyeDirection);
  const bossAngle = sourceDirectionDifference(boss.position, targetPosition, bossForward);
  if (viewAngle + bossAngle <= FINALE_BOSS_CONFIG.attackSightMinAngle
    && Math.random() * 1000 <= FINALE_BOSS_CONFIG.attackSightChance) {
                                                                             
                                                                           
                                                                           
    boss.nextSightAt = now + FINALE_BOSS_CONFIG.attackSightCooldown;
    damagePawn(pawn, FINALE_BOSS_CONFIG.attackSightDamage * (runtime.bossDamageMultiplier ?? 1));
    const horizontalPush = directionBetween(boss.position, targetPosition);
    pawn.Teleport?.({ velocity: add(mul(horizontalPush, FINALE_BOSS_CONFIG.attackSightXYVelocity), vec(0, 0, FINALE_BOSS_CONFIG.attackSightZVelocity)) });
                                                                            
                                                                              
    spawnFinaleBossAttackVisual(
      runtime,
      boss.position,
      sub(targetPosition, boss.position),
      { r: 50, g: 70, b: 150, a: 90 },
      5000,
      0.3,
      2,
      "finaleBossSight",
    );
  }
}

function finaleBossFlingAttack(runtime, boss, now) {
  if (boss.dead || !boss.flingUntil || now < boss.flingUntil) return false;
  if (!boss.flingAppliedAt) {
    boss.flingAppliedAt = now;
    for (const pawn of finaleBossAliveHumans()) {
      const position = pawn.GetAbsOrigin?.();
      if (!position || Math.hypot(position.x - boss.position.x, position.y - boss.position.y, position.z - boss.position.z) > FINALE_BOSS_CONFIG.attackFlingDistance) continue;
      const eyePosition = pawn.EyePosition?.()
        ?? pawn.GetEyePosition?.()
        ?? add(position, vec(0, 0, 48));
      const eyeDirection = forwardVector(pawn, true);
      const angle = sourceDirectionDifference(eyePosition, boss.position, eyeDirection);
      if (angle > FINALE_BOSS_CONFIG.attackFlingLookAngle) continue;
                                                                           
      const awayFromBoss = directionBetween(boss.position, position);
      pawn.Teleport?.({ velocity: add(mul(awayFromBoss, FINALE_BOSS_CONFIG.attackFlingXYVelocity), vec(0, 0, FINALE_BOSS_CONFIG.attackFlingZVelocity)) });
      if (FINALE_BOSS_CONFIG.attackFlingDamage > 0) damagePawn(pawn, FINALE_BOSS_CONFIG.attackFlingDamage * (runtime.bossDamageMultiplier ?? 1));
      spawnFinaleBossAttackVisual(
        runtime,
        boss.position,
        sub(position, boss.position),
        { r: 255, g: 220, b: 0, a: 90 },
        10000,
        0.2,
        2,
        "finaleBossFling",
      );
    }
    for (let index = 0; index < 3; index++) {
      playSourceAudioCue(14726, boss.position, {
        pitch: 200 + Math.floor(Math.random() * 56),
      });
      playSourceAudioCue(14727, boss.position, {
        pitch: 200 + Math.floor(Math.random() * 56),
      });
    }
    boss.flingUntil = 0;
    boss.flingAppliedAt = 0;
    boss.shouldMove = true;
    boss.destination = undefined;
    return true;
  }
  return false;
}

function processFinaleBossBlink(boss, now) {
                                                                          
                                                                         
  if (boss.dead || now < (boss.stunUntil ?? 0) || now < (boss.nextBlinkAt ?? now)) return;
  const wasOpen = boss.eyelidOpen === true;
  boss.eyelidOpen = !boss.eyelidOpen;
  const animation = boss.eyelidOpen ? "open" : "close";
  const idle = boss.eyelidOpen ? "idle_open" : "idle_closed";
  finaleBossSetAnimation(
    boss,
    animation,
    idle,
    FINALE_BOSS_CONFIG.blinkPlaybackMin
      + Math.random() * (FINALE_BOSS_CONFIG.blinkPlaybackMax - FINALE_BOSS_CONFIG.blinkPlaybackMin),
    now,
  );
  playSourceAudioCue(14895, boss.position);
                                                                            
                                                                           
                                                                         
  boss.nextBlinkAt = now + (wasOpen
    ? FINALE_BOSS_CONFIG.blinkClosedHoldMin
      + Math.random() * (FINALE_BOSS_CONFIG.blinkClosedHoldMax - FINALE_BOSS_CONFIG.blinkClosedHoldMin)
    : FINALE_BOSS_CONFIG.blinkOpenHoldMin
      + Math.random() * (FINALE_BOSS_CONFIG.blinkOpenHoldMax - FINALE_BOSS_CONFIG.blinkOpenHoldMin));
}

function processFinaleBossDeathMotion(runtime, boss, elapsed) {
  if (!boss.dead || !validEntity(boss.visual)) return;
                                                                         
                                                                             
                                                              
  const iterations = Math.max(1, elapsed * 100);
  boss.deadVelocity.z = Math.max(-50, (boss.deadVelocity.z ?? 0) - 0.30 * iterations);
  boss.position = add(boss.position, mul(boss.deadVelocity, iterations));
  boss.angles = {
    pitch: Number(boss.angles?.pitch ?? 90) + Number(boss.deadRotation?.pitch ?? boss.deadRotation?.x ?? 0) * iterations,
    yaw: Number(boss.angles?.yaw ?? 0) + Number(boss.deadRotation?.yaw ?? boss.deadRotation?.y ?? 0) * iterations,
    roll: Number(boss.angles?.roll ?? 0) + Number(boss.deadRotation?.roll ?? boss.deadRotation?.z ?? 0) * iterations,
  };
                                                                      
                                                                             
                                                                           
  boss.forwardDirection = forwardFromAngles(boss.angles);
  boss.visual.Teleport?.({ position: boss.position, angles: boss.angles, velocity: vec() });
  boss.visual.SetForwardVector?.(boss.forwardDirection);
  finaleBossSyncHitbox(boss, boss.hitbox, boss.position);
  finaleBossSyncHitbox(boss, boss.grenadeHitbox, boss.position);
  finaleBossSyncHitbox(boss, boss.damageHitbox, boss.position);
    boss.deadFadeoutTicks = (boss.deadFadeoutTicks ?? 0) + iterations;
  if (boss.deadFadeoutTicks <= 500) return;
  destroyEndingEntity(runtime, boss.visual);
  boss.visual = undefined;
  const pieces = new Set([
    ...(boss.chainPieces ?? []),
    ...(boss.collectingPieces ?? []),
  ]);
  for (const piece of pieces) {
    for (const entity of piece.entities ?? []) destroyEndingEntity(runtime, entity);
  }
  boss.chainPieces = [];
  boss.collectingPieces?.clear?.();
  boss.pieces?.clear?.();
}

function processFinaleBossFight(runtime) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.lifecycle !== "active") return;
  const now = Instance.GetGameTime();
  const elapsed = Math.max(0.01, Math.min(0.1, now - (runtime.lastBossTickAt ?? now)));
  runtime.lastBossTickAt = now;
                                                                             
                                                                          
                                                
  processFinaleSky(runtime, now, elapsed);
  processFinaleBossAttackVisuals(runtime, now, elapsed);
  if (runtime.bossPhase === "escape") {
                                                                          
                                                                           
                                                                             
                                                                         
               
    processFinaleBossBullets(runtime, now, elapsed);
    for (const boss of runtime.bosses ?? []) {
      if (!boss.dead) continue;
      processFinaleBossDeathMotion(runtime, boss, elapsed);
      finaleBossSyncChain(boss);
    }
    return;
  }
  if (runtime.bossPhase === "boss_intro") {
    if (now < (runtime.bossFightActiveAt ?? now)) return;
    runtime.bossPhase = "boss_active";
    for (const boss of runtime.bosses ?? []) {
      boss.eyelidOpen = true;
      finaleBossSetAnimation(boss, "open", "idle_open", 1, now);
      playSourceAudioCue(14901, boss.position, { pitch: 20 + Math.floor(Math.random() * 21) });
      playSourceAudioCue(14903, boss.position, { pitch: 65 + Math.floor(Math.random() * 11) });
    }
  }
  const humans = finaleBossAliveHumans();
  if (humans.length === 0) {
    runtime.roundLost = true;
  }
                                                                             
                                                                              
                                                                             
                                                      
  for (const boss of runtime.bosses ?? []) processFinaleBossEyeTouch(runtime, boss, humans);
  for (const pawn of allLivingPawns()) finaleBossFallTouch(runtime, pawn, now);
  if (humans.length > 0) finaleBossApplyHumanDeathReduction(runtime, humans, now);
  processFinaleBossBullets(runtime, now, elapsed);
  for (const boss of runtime.bosses ?? []) {
    if (boss.dead) {
      processFinaleBossDeathMotion(runtime, boss, elapsed);
      finaleBossSyncChain(boss);
      continue;
    }
    if (boss.midspin && boss.midspinUntil > 0 && now >= boss.midspinUntil) {
      boss.midspin = false;
      boss.midspinUntil = 0;
      boss.midspinDropAt = 0;
      boss.tailAim = false;
      boss.tailAimForceUntil = now + FINALE_BOSS_CONFIG.tailAimForceCooldown
        + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset;
      finaleBossSetAnimation(boss, "idle_open", "idle_open", 1, now);
    }
    if (boss.tailSnapClearAt && now >= boss.tailSnapClearAt) {
      boss.tailSnapClearAt = 0;
      boss.tailSnapUntil = 0;
      boss.tailSnapPosition = undefined;
      boss.tailSnapActive = false;
      boss.tailSnapLiftMult = 1;
      boss.tailSnapLiftResetAt = 0;
    } else if (boss.tailSnapLiftResetAt && now >= boss.tailSnapLiftResetAt) {
      boss.tailSnapLiftResetAt = 0;
      boss.tailSnapLiftMult = 1;
    } else if (boss.tailSnapUntil && now >= boss.tailSnapUntil) {
      boss.tailSnapActive = false;
    }
    if (boss.stunUntil && now < boss.stunUntil) {
                                                                             
                                                                          
                                                                 
      boss.tailAim = false;
      boss.lowDrift = false;
      boss.midspin = false;
      boss.midspinStartedAt = 0;
      boss.midspinDropAt = 0;
      boss.midspinUntil = 0;
      boss.flingUntil = 0;
      boss.flingAppliedAt = 0;
      boss.eyelidOpen = true;
      boss.tailAimAttackUntil = now + FINALE_BOSS_CONFIG.tailAimAttackCooldown;
      boss.tailAimForceUntil = now + FINALE_BOSS_CONFIG.tailAimForceCooldown
        + (Math.random() * 2 - 1) * FINALE_BOSS_CONFIG.tailAimForceRandomOffset;
    }
    if (boss.stunUntil && now >= boss.stunUntil && boss.stunWasActive) {
      boss.stunWasActive = false;
      boss.stunUntil = 0;
      boss.stunJustStunned = true;
      boss.flingUntil = 0;
      boss.midspin = false;
      boss.midspinUntil = 0;
      boss.midspinDropAt = 0;
      finaleBossSetTailAim(boss, false, now);
      finaleBossSetAnimation(boss, "idle_open", "idle_open", 1, now);
    }
    finaleBossMove(runtime, boss, elapsed, now);
    processFinaleBossBlink(boss, now);
    finaleBossCollectPieces(runtime, boss, now);
    finaleBossSyncChain(boss);
    finaleBossPieceDamage(runtime, boss, now);
    finaleBossFlingChargeTick(runtime, boss);
    finaleBossAttackTick(runtime, boss, now);
    finaleBossSightAttack(runtime, boss, now);
    finaleBossFlingAttack(runtime, boss, now);
  }
}

function startFinaleBossFight(runtime = state.endingRuntime, options = {}) {
  if (!runtime || runtime.kind !== "FINALE") throw new Error("startFinaleBossFight requires a FINALE runtime");
  if (runtime.lifecycle !== "active") throw new Error("startFinaleBossFight requires an active FINALE runtime");
  if (runtime.bossPhase === "boss_active" || runtime.bossPhase === "boss_intro") return runtime;
  cleanupFinaleApproach(runtime);
  runtime.bossMode = "boss";
                                                                             
                                                                 
  runtime.finaleZombieInvincibilityRange = 200;
                                                                             
                                                                        
                                            
  state.snowstormOverlay.serial++;
  setSnowstormOverlayEnabled(false);
  spawnFinaleBoss(runtime, options);
  setupFinaleSky(runtime);
  startFinaleBossMusic(runtime, runtime.bossStartedAt);
                                                                        
                                                                       
  scheduleFinaleBossLogo(runtime, runtime.bossStartedAt + 0.4);
  return runtime;
}

function removeAscendHumanMoonboosts(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  runtime.humanMoonboostRemovedAt = runtime.runStartedAt + ASCEND_CONFIG.humanMoonboostRemovalDelay;
  runtime.humanMoonboostRemoved = 0;
  for (const owner of activeRuntimes()) {
    if (owner === runtime) continue;
    for (const item of [...(owner.items ?? [])]) {
      if (item.name === "moonboost" && item.definition.team === 3 && item.state !== "consumed") {
        consumeItem(owner, item);
        runtime.humanMoonboostRemoved++;
      }
    }
  }
}

function spawnAscendZombieItems(runtime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const previous = state.levels.get((runtime.sourceRuntime?.index ?? 0) - 1);
                                                                           
                                                                            
  const center = previous?.tp
    ? add(previous.tp, vec(0, 0, 32))
    : previous?.entry ?? runtime.sourceRuntime?.tp ?? runtime.anchor;
  runtime.zItemAnchor = clone(center);
  runtime.zItemSpawnPositions = [];
  const spawnOne = (name, index) => {
    const angle = Math.random() * Math.PI * 2;
    const position = add(center, vec(Math.cos(angle) * 85, Math.sin(angle) * 85, 0));
    runtime.zItemSpawnPositions.push({ name, index, position: clone(position) });
    spawnItemFeature(runtime, {
      kind: "feature",
      feature: "item",
      position,
      angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 },
      team: 2,
      teamOverride: 2,
      endingItem: true,
      debugItem: true,
      itemName: name,
      role: `ascend_${name}_${index}`,
    });
  };
  for (let index = 0; index < ASCEND_CONFIG.moonboostZombieAmount; index++) spawnOne("moonboost", index);
  for (let index = 0; index < ASCEND_CONFIG.flightZombieAmount; index++) spawnOne("flight", index);
  runtime.zombieItemsSpawnedAt = Instance.GetGameTime();
}

function clearAscendFlightItems(runtime) {
  if (!runtime || runtime.flightItemsClearedAt !== undefined) return;
  const owners = new Set([runtime, ...activeRuntimes()]);
  runtime.flightHoldersKilled = 0;
  runtime.flightItemsCleared = 0;
  for (const owner of owners) {
    for (const item of [...(owner.items ?? [])]) {
      if (item.name !== "flight" || item.state === "consumed" || item.state === "cleaned") continue;
      const holder = item.holder;
      if (holder?.IsAlive?.()) {
        holder.TakeDamage?.({
          damage: 999999,
          damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
        });
        runtime.flightHoldersKilled++;
      }
      consumeItem(owner, item);
      runtime.flightItemsCleared++;
    }
  }
  runtime.flightItemsClearedAt = Instance.GetGameTime();
}

// CS2 CSMoveType NONE=0. Freeze before any zombie dies: the last zombie death
// ends the round, and OnRoundEnd stops the ending runtime immediately.
function freezeAscendSurvivor(runtime, pawn) {
  let applied = false;
  try {
    if (typeof pawn.SetMoveType === "function") {
      pawn.SetMoveType(0);
      applied = true;
    }
  } catch {}
  if (!applied) {
    runtime.safeMovementTypeNote = "pawn SetMoveType API unavailable; used SetMoveType input";
    fireTarget(pawn, "SetMoveType", "0");
  }
  try { pawn.targetname = "endsafeplayer"; } catch {}
  pawn.Teleport?.({ velocity: vec() });
}

function triggerAscendFade(runtime, type, scheduledAt) {
  if (!runtime) return false;
  const at = scheduledAt ?? Instance.GetGameTime();
  runtime.fadeEvents ??= [];
  runtime.fadeEvents.push({ type, at });
  const fade = runtime.fadeEntity ?? Instance.FindEntityByName?.("ending_ascend_fade");
  if (!validEntity(fade)) {
    runtime.fadeSupported = false;
    runtime.fadeNote ??= "ASCEND env_fade anchor is unavailable; fade timing is retained for in-game wiring";
    return false;
  }
  runtime.fadeEntity = fade;
  runtime.fadeSupported = true;
  if (type === "pulse") {
    runtime.fadeRenderAlpha = ASCEND_CONFIG.fadePulseAlpha;
    runtime.fadeDuration = ASCEND_CONFIG.fadePulseDuration;
    fireTarget(fade, "Fade", "");
  } else if (type === "ascension") {
    runtime.fadeRenderAlpha = 255;
    runtime.fadeDuration = ASCEND_CONFIG.fadeAscensionDuration;
    runtime.fadeReverseDuration = ASCEND_CONFIG.fadePulseDuration;
    fireTarget(fade, "Fade", "", 0.02);
  } else if (type === "result") {
    runtime.fadeDuration = ASCEND_CONFIG.fadeResultDuration;
    runtime.fadeReverseDuration = ASCEND_CONFIG.fadeResultDuration;
    fireTarget(fade, "Fade", "", 0.02);
  }
  return true;
}

function scheduleAscendFadeTick(runtime, absoluteTime) {
  if (!runtime || runtime.lifecycle !== "active") return;
  const key = `ascend_fade_${runtime.fadeTickCount ?? 0}`;
  endingTaskAt(runtime, absoluteTime, () => {
    if (runtime.phase === "defending") {
      triggerAscendFade(runtime, "pulse", absoluteTime);
      runtime.fadeTickCount = (runtime.fadeTickCount ?? 0) + 1;
      const next = absoluteTime + ASCEND_CONFIG.fadeTickRate;
      if (next < runtime.runStartedAt + ASCEND_CONFIG.defendTime) scheduleAscendFadeTick(runtime, next);
    }
  }, key);
}

function beginAscension(runtime) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.phase !== "defending") return;
  runtime.phase = "ascending";
  runtime.ascendStartedAt = runtime.runStartedAt + ASCEND_CONFIG.defendTime;
  runtime.nextAscendTickAt = runtime.ascendStartedAt;
  runtime.fadeTicking = false;
  triggerAscendFade(runtime, "ascension", runtime.ascendStartedAt);
  announce("ASCEND ending: the ascension has begun");
}

function resolveAscension(runtime, { roundEnded = false } = {}) {
  if (!runtime || runtime.lifecycle !== "active" || runtime.phase !== "ascending" || runtime.settlementAt !== undefined) return;
  setZombieRespawning(false, runtime);
  const threshold = runtime.stageCenterZ + ASCEND_CONFIG.surviveHeightAboveStage;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  // A round that already ended mid-ascension keeps every rising human aloft
  // instead of dropping them when the terrain is removed.
  const survivors = roundEnded
    ? humans
    : humans.filter((pawn) => (pawn.GetAbsOrigin?.()?.z ?? -Infinity) > threshold);
  runtime.ascendedHumans = new Set(survivors);
  runtime.safePlayers = new Set(survivors);
  runtime.phase = "settled";
  runtime.settlementAt = roundEnded
    ? Instance.GetGameTime()
    : runtime.runStartedAt + ASCEND_CONFIG.defendTime + ASCEND_CONFIG.winDelay;
  if (!roundEnded) runtime.outcomeCandidate = survivors.length > 0 && runtime.roundLost !== true;
  runtime.safeMovementType = "none";
  for (const pawn of survivors) freezeAscendSurvivor(runtime, pawn);
  if (roundEnded) return;
  clearAscendFlightItems(runtime);
  for (const pawn of allLivingPawns()) {
    if (runtime.safePlayers.has(pawn)) continue;
    pawn.TakeDamage?.({
      damage: 999999,
      damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
    });
  }
  triggerAscendFade(runtime, "result", runtime.settlementAt);
  runtime.resultFadeUntil = runtime.settlementAt + ASCEND_CONFIG.fadeResultDuration;
}

function startAscendEnding(stageSnapshot, sourceRuntime) {
  if (state.endingRuntime && ["active", "spawning"].includes(state.endingRuntime.lifecycle)) return state.endingRuntime;
  for (const key of ["item_moonboost", "item_flight", "item_carrier_p250", "item_carrier_knife", "trigger"]) {
    const template = state.featureTemplates.get(key);
    if (!template || !template.IsValid?.() || typeof template.ForceSpawn !== "function") {
      throw new Error(`ASCEND requires feature template '${key}'`);
    }
  }
  const runtime = createEndingRuntime("ASCEND", stageSnapshot, sourceRuntime);
  runtime.lifecycle = "active";
  runtime.lifecycleHistory.push("active");
  runtime.phase = "defending";
  runtime.stageCenterZ = sourceRuntime.center?.z ?? ((sourceRuntime.entry?.z ?? sourceRuntime.end.z) + sourceRuntime.end.z) * 0.5;
  runtime.ascendedHumans = new Set();
  runtime.safePlayers = new Set();
  runtime.roundLost = false;
  runtime.outcomeCandidate = undefined;
  runtime.fadeEvents = [];
  runtime.fadeTickCount = 0;
  runtime.fadeSupported = false;
  runtime.fadeNote = "ASCEND fade timing is recorded; env_fade anchor support is checked at runtime";
  transferEndingSourceOwnership(runtime);
  const at = (delay) => runtime.runStartedAt + delay;
  runtime.ascendTask = endingTaskAt(runtime, at(ASCEND_CONFIG.defendTime), () => beginAscension(runtime), "ascend_start");
  endingTaskAt(runtime, at(ASCEND_CONFIG.humanMoonboostRemovalDelay), () => removeAscendHumanMoonboosts(runtime), "ascend_moonboost_cleanup");
  endingTaskAt(runtime, at(ASCEND_CONFIG.zombieItemDelay), () => spawnAscendZombieItems(runtime), "ascend_zombie_items");
  // Flight holders are slain inside settlement, after survivors are frozen; the
  // old 0.5s-early slay could kill the last zombie and end the round first.
  runtime.failsafeTask = endingTaskAt(runtime, at(ASCEND_CONFIG.defendTime + ASCEND_CONFIG.slayAllDelay), () => {
    runtime.failsafeTriggeredAt = at(ASCEND_CONFIG.defendTime + ASCEND_CONFIG.slayAllDelay);
    endingMassKillAll(runtime);
  }, "ascend_failsafe");
  endingTaskAt(runtime, at(ASCEND_CONFIG.defendTime + ASCEND_CONFIG.winDelay), () => resolveAscension(runtime), "ascend_settlement");
  scheduleAscendFadeTick(runtime, at(ASCEND_CONFIG.fadeStartDelay));
  playEndingMusic(runtime, ASCEND_CONFIG.music);
  announce(`ASCEND ending started; survive for ${ASCEND_CONFIG.defendTime} seconds`);
  return runtime;
}

function processAscendEnding(runtime = state.endingRuntime) {
  if (!runtime || runtime.kind !== "ASCEND" || runtime.lifecycle !== "active") return;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
  if (humans.length <= 0 && runtime.phase !== "settled") runtime.roundLost = true;
  if (runtime.phase !== "ascending") return;
  const now = Instance.GetGameTime();
  if (now < runtime.nextAscendTickAt) return;
  runtime.nextAscendTickAt = now + ASCEND_CONFIG.ascendRate;
  for (const pawn of humans) {
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport?.({ velocity: vec(velocity.x, velocity.y, ASCEND_CONFIG.ascendVerticalVelocity) });
  }
}

const ENDING_STARTERS = Object.freeze({
  RISE: startRiseEnding,
  CLIMB: startClimbEnding,
  BUNKER: startBunkerEnding,
  BRIDGE: startBridgeEnding,
  HUNT: startHuntEnding,
  ASCEND: startAscendEnding,
  CONFLICT: startConflictEnding,
  RACE: startRaceEnding,
  FINALE: startFinaleEnding,
});

function processEndingRuntime() {
  const runtime = state.endingRuntime;
  if (!runtime || runtime.lifecycle === "outcome_pending") return;
  if (runtime.kind === "RISE") processRiseEnding(runtime);
  else if (runtime.kind === "CLIMB") processClimbEnding(runtime);
  else if (runtime.kind === "BUNKER") processBunkerEnding();
  else if (runtime.kind === "BRIDGE") processBridgeEnding(runtime);
  else if (runtime.kind === "HUNT") processHuntEnding(runtime);
  else if (runtime.kind === "ASCEND") processAscendEnding(runtime);
  else if (runtime.kind === "CONFLICT") processConflictEnding(runtime);
  else if (runtime.kind === "RACE") processRaceEnding(runtime);
  else if (runtime.kind === "FINALE") processFinaleEnding(runtime);
}

function vec(x = 0, y = 0, z = 0) {
  return { x, y, z };
}

function formatVector(value) {
  const vector = value ?? vec();
  const component = (name) => Number(vector[name] ?? 0).toFixed(0);
  return `(${component("x")}, ${component("y")}, ${component("z")})`;
}

function add(a, b) {
  return vec(a.x + b.x, a.y + b.y, a.z + b.z);
}

function sub(a, b) {
  return vec(a.x - b.x, a.y - b.y, a.z - b.z);
}

function mul(v, amount) {
  return vec(v.x * amount, v.y * amount, v.z * amount);
}

function clone(v) {
  return vec(v.x, v.y, v.z);
}

function leftOf(direction) {
  return vec(-direction.y, direction.x, 0);
}

function rightOf(direction) {
  return vec(direction.y, -direction.x, 0);
}

function yawOf(direction) {
  return Math.atan2(direction.y, direction.x) * 180 / Math.PI;
}

function normalizeYaw(yaw) {
  return ((yaw + 180) % 360 + 360) % 360 - 180;
}

function anglesFor(direction, reverse = false) {
  return { pitch: 0, yaw: normalizeYaw(yawOf(direction) + (reverse ? 180 : 0)), roll: 0 };
}

function bakedTemplateKey(shape, yaw) {
                                                                        
                                                                             
                                                                      
  return shape;
}
function distance2D(a, b) {
  return Math.hypot(a.x - b.x, a.y - b.y);
}

function message(text) {
  Instance.Msg(`[ze_collective] ${text}`);
}

                                                                          
                                                                               
                                                                           
                                                                               
                                                                        
function raceLog(runtime, text) {
  const prefix = runtime?.debugForced ? "[RACE DEBUG]" : "[RACE]";
  message(`${prefix} ${text}`);
}

function raceCellKey(x, y) {
  return `${x},${y}`;
}

function raceCount(record, bucket, key, amount = 1) {
  if (!record) return;
  record[bucket] ??= Object.create(null);
  const normalized = String(key);
  record[bucket][normalized] = (record[bucket][normalized] ?? 0) + amount;
}

function raceRequestContext(runtime, record, request, kind) {
  if (!request || !record) return;
  const cell = runtime?.raceBuildCell;
  request.raceRecord = record;
  request.raceRequestKind = kind;
  if (cell) {
    request.raceCell = { x: cell.x, y: cell.y, tile: cell.tile };
    const key = raceCellKey(cell.x, cell.y);
    record.raceCoverage ??= new Map();
    const coverage = record.raceCoverage.get(key) ?? {
      x: cell.x, y: cell.y, tile: cell.tile, requests: 0, kinds: [],
    };
    coverage.requests++;
    if (!coverage.kinds.includes(kind)) coverage.kinds.push(kind);
    record.raceCoverage.set(key, coverage);
    raceCount(record, "raceRequestCounts", kind);
  }
}

function announce(text) {
  message(text);
  const safe = String(text).replace(/[\r\n;"]/g, " ");
  Instance.ServerCommand(`say ${safe}`);
}

function findTerrainPreviewHud() {
  if (validEntity(terrainPreviewHud)
    && typeof terrainPreviewHud.SetHasClass === "function") {
    return terrainPreviewHud;
  }
  try {
    const candidate = Instance.FindEntityByName(TERRAIN_PREVIEW_HUD_TARGET);
    if (validEntity(candidate)
      && typeof candidate.SetHasClass === "function") {
      if (terrainPreviewHud !== candidate) {
        terrainPreviewHudTileClasses = [];
        terrainPreviewHudShown = false;
      }
      terrainPreviewHud = candidate;
      return candidate;
    }
  } catch (_) {
                                                                            
                                                                             
  }
  if (!terrainPreviewHudWarningPrinted) {
    terrainPreviewHudWarningPrinted = true;
    message("terrain preview HUD entity not found; continuing without preview");
  }
  return undefined;
}

function pledgeHudWarning(reason) {
  if (pledgeHudWarningPrinted) return;
  pledgeHudWarningPrinted = true;
  message(`PLEDGE HUD unavailable: ${reason}; gameplay continues without the screen prompt`);
}

function invincibilityHudWarning(reason) {
  if (invincibilityHudWarningPrinted) return;
  invincibilityHudWarningPrinted = true;
  message(`Invincibility HUD unavailable: ${reason}; protection remains active`);
}

function findInvincibilityHud() {
  if (validEntity(invincibilityHud) && typeof invincibilityHud.SetHasClassForPlayer === "function") return invincibilityHud;
  try {
    const hud = Instance.FindEntityByName(INVINCIBILITY_HUD_TARGET);
    if (validEntity(hud) && typeof hud.SetHasClassForPlayer === "function") {
      invincibilityHud = hud;
      return hud;
    }
  } catch (error) {
    invincibilityHudWarning(error);
  }
  return undefined;
}

function clearInvincibilityHudSlot(slot, record) {
  try {
    if (validEntity(record.hud)) record.hud.SetHasClassForPlayer(slot, INVINCIBILITY_HUD_PANEL, "Active", false);
  } catch (error) {
    invincibilityHudWarning(error);
    return false;
  }
  invincibilityHudPlayers.delete(slot);
  return true;
}

function hideInvincibilityForPlayer(pawn) {
  for (const [slot, record] of invincibilityHudPlayers) {
    if (record.pawn === pawn) clearInvincibilityHudSlot(slot, record);
  }
}

function clearInvincibilityHud() {
  for (const [slot, record] of invincibilityHudPlayers) clearInvincibilityHudSlot(slot, record);
  invincibilityHudNextSyncAt = 0;
}

function syncInvincibilityHud(now, force = false) {
  if (!force && now < invincibilityHudNextSyncAt) return;
  invincibilityHudNextSyncAt = now + 0.5;                                        
  const players = new Set(allLivingPawns().filter(zombieStartAreaProtected));
  for (const [slot, record] of invincibilityHudPlayers) {
    if (!players.has(record.pawn)) clearInvincibilityHudSlot(slot, record);
  }
  if (!players.size) return;
  const hud = findInvincibilityHud();
  if (!hud) {
    invincibilityHudWarning(INVINCIBILITY_HUD_TARGET);
    return;
  }
  for (const pawn of players) {
    const slot = playerSlotForHud(pawn);
    if (slot === undefined) continue;
    const previous = invincibilityHudPlayers.get(slot);
    if (previous?.pawn === pawn && previous.hud === hud) continue;
    if (previous && !clearInvincibilityHudSlot(slot, previous)) continue;
    try {
      hud.SetHasClassForPlayer(slot, INVINCIBILITY_HUD_PANEL, "Active", true);
      invincibilityHudPlayers.set(slot, { pawn, hud });
    } catch (error) {
      invincibilityHudWarning(error);
    }
  }
}

function itemTutorialHudWarning(reason) {
  if (itemTutorialHudWarningPrinted) return;
  itemTutorialHudWarningPrinted = true;
  message(`Item tutorial HUD unavailable: ${reason}`);
}

function applyItemTutorial(slot, record) {
  try {
    const hud = findPledgeHud();
    if (!hud || typeof hud.SetDialogVariableStringForPlayer !== "function") {
      itemTutorialHudWarning(`${PLEDGE_HUD_TARGET} or per-player dialog variables are missing`);
      return false;
    }
    record.hud = hud; // Also track partial writes so reset/death can clean them up.
    record.applied = false;
    // Never use global text/class setters: simultaneous pickups must stay private.
    hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Active", false);
    hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Fading", false);
    for (const [key, value] of Object.entries(record.content)) {
      hud.SetDialogVariableStringForPlayer(slot, `item_tutorial_${key}`, `item_${key}`, value);
    }
    hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Active", true);
    record.applied = true;
    record.fading = false;
    return true;
  } catch (error) {
    itemTutorialHudWarning(error);
    return false;
  }
}

function clearItemTutorialSlot(slot, record) {
  record.cancelled = true;
  try {
    if (validEntity(record.hud)) {
      record.hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Active", false);
      record.hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Fading", false);
      for (const key of Object.keys(record.content)) {
        record.hud.SetDialogVariableStringForPlayer(slot, `item_tutorial_${key}`, `item_${key}`);
      }
    }
  } catch (error) {
    itemTutorialHudWarning(error);
    return false; // Keep the captured slot so the next Think can retry cleanup.
  }
  itemTutorialPlayers.delete(slot);
  return true;
}

function showItemTutorial(item, pawn) {
  const slot = playerSlotForHud(pawn);
  if (slot === undefined) {
    itemTutorialHudWarning("cannot resolve player slot");
    return false;
  }
  const previous = itemTutorialPlayers.get(slot);
  if (previous && !clearItemTutorialSlot(slot, previous)) return false;
  const holdUntil = Instance.GetGameTime() + ITEM_TUTORIAL_HOLD_TIME;
  const record = { pawn, team: pawn.GetTeamNumber?.(), content: itemTutorialContent(item),
    holdUntil, clearAt: holdUntil + ITEM_TUTORIAL_FADE_TIME, hud: undefined, fading: false };
  itemTutorialPlayers.set(slot, record);
  return applyItemTutorial(slot, record);
}

function hideItemTutorialForPlayer(pawn) {
  const slot = playerSlotForHud(pawn);
  for (const [targetSlot, record] of itemTutorialPlayers) {
    if (record.pawn === pawn || targetSlot === slot) clearItemTutorialSlot(targetSlot, record);
  }
}

function clearItemTutorials() {
  for (const [slot, record] of itemTutorialPlayers) clearItemTutorialSlot(slot, record);
}

function syncItemTutorials(now) {
  for (const [slot, record] of itemTutorialPlayers) {
    if (record.cancelled || !state.running || state.fatal || now >= record.clearAt
      || !validEntity(record.pawn) || !record.pawn.IsAlive?.()
      || record.pawn.GetTeamNumber?.() !== record.team || playerSlotForHud(record.pawn) !== slot) {
      clearItemTutorialSlot(slot, record);
      continue;
    }
    if ((!record.applied || !validEntity(record.hud)) && !applyItemTutorial(slot, record)) continue;
    if (now >= record.holdUntil && !record.fading) {
      try {
        record.hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Fading", true);
        record.hud.SetHasClassForPlayer(slot, ITEM_TUTORIAL_PANEL, "Active", false);
        record.fading = true;
      } catch (error) {
        itemTutorialHudWarning(error);
      }
    }
  }
}

function zombieItemLockHudWarning(reason) {
  if (zombieItemLockHudWarningPrinted) return;
  zombieItemLockHudWarningPrinted = true;
  message(`Zombie item lock HUD unavailable: ${reason}`);
}

function clearZombieItemLockSlot(slot, record) {
  record.cancelled = true;
  try {
    if (validEntity(record.hud)) {
      record.hud.SetHasClassForPlayer(slot, ZOMBIE_ITEM_LOCK_PANEL, "Active", false);
      record.hud.SetDialogVariableStringForPlayer(slot, "zombie_item_lock_countdown", "zombie_item_lock_time");
    }
  } catch (error) {
    zombieItemLockHudWarning(error);
    return false; // Retain the captured slot so cleanup can retry after native failures.
  }
  zombieItemLockPlayers.delete(slot);
  return true;
}

function hideZombieItemLockForPlayer(pawn) {
  for (const [slot, record] of zombieItemLockPlayers) {
    if (record.pawn === pawn) clearZombieItemLockSlot(slot, record);
  }
}

function clearZombieItemLocks() {
  for (const [slot, record] of zombieItemLockPlayers) clearZombieItemLockSlot(slot, record);
}

function applyZombieItemLockHud(slot, record, now) {
  try {
    const hud = findPledgeHud();
    if (!hud || typeof hud.SetDialogVariableStringForPlayer !== "function") {
      zombieItemLockHudWarning(`${PLEDGE_HUD_TARGET} or per-player dialog variables are missing`);
      return false;
    }
    const seconds = Math.max(0, Math.ceil(record.lockUntil - now));
    const text = record.phase === "protection"
      ? `Initial protection ends in ${seconds}s`
      : `Unlocks for all in ${seconds}s`;
    if (record.hud === hud && record.text === text && record.applied) return true;
    record.hud = hud;
    record.applied = false;
    hud.SetDialogVariableStringForPlayer(slot, "zombie_item_lock_countdown", "zombie_item_lock_time", text);
    hud.SetHasClassForPlayer(slot, ZOMBIE_ITEM_LOCK_PANEL, "Active", true);
    record.text = text;
    record.applied = true;
    return true;
  } catch (error) {
    zombieItemLockHudWarning(error);
    return false;
  }
}

function showZombieItemLock(item, pawn, now, lockUntil, phase) {
  const slot = playerSlotForHud(pawn);
  if (slot === undefined) return false;
  const previous = zombieItemLockPlayers.get(slot);
  if (previous && (previous.cancelled || previous.pawn !== pawn || previous.item !== item || previous.phase !== phase)) {
    if (!clearZombieItemLockSlot(slot, previous)) return false;
  }
  const record = zombieItemLockPlayers.get(slot) ?? { pawn, item, phase };
  record.lockUntil = lockUntil;
  record.expiresAt = Math.min(now + ZOMBIE_ITEM_LOCK_HOLD_TIME, lockUntil);
  zombieItemLockPlayers.set(slot, record);
  return applyZombieItemLockHud(slot, record, now);
}

function syncZombieItemLocks(now) {
  for (const [slot, record] of zombieItemLockPlayers) {
    if (record.cancelled || !state.running || state.fatal || now >= record.expiresAt
      || !validEntity(record.pawn) || !record.pawn.IsAlive?.()
      || record.pawn.GetTeamNumber?.() !== 2 || playerSlotForHud(record.pawn) !== slot
      || state.motherZombies.has(record.pawn) || record.item.stripUnlocked === true
      || !["world", "dropped"].includes(record.item.state) || !validEntity(record.item.carrier)) {
      clearZombieItemLockSlot(slot, record);
      continue;
    }
    applyZombieItemLockHud(slot, record, now);
  }
}

function findPledgeHud() {
  if (validEntity(pledgeHud) && typeof pledgeHud.SetHasClassForPlayer === "function") return pledgeHud;
  try {
    const candidate = Instance.FindEntityByName(PLEDGE_HUD_TARGET);
    if (validEntity(candidate) && typeof candidate.SetHasClassForPlayer === "function") {
      pledgeHud = candidate;
      return candidate;
    }
  } catch (error) {
    pledgeHudWarning(error);
  }
  return undefined;
}

function playerSlotForHud(pawn) {
  try {
    const controller = pawn?.GetPlayerController?.()
      ?? Instance.GetAllPlayerControllers().find((candidate) =>
        validEntity(candidate) && candidate.GetPlayerPawn?.() === pawn);
    const slot = controller?.GetPlayerSlot?.();
    return Number.isInteger(slot) && slot >= 0 ? slot : undefined;
  } catch (_) {
    return undefined;
  }
}

function clearPledgeHudSlot(slot, record) {
  try {
    if (validEntity(record.hud)) {
      record.hud.SetHasClassForPlayer(slot, PLEDGE_HUD_PANEL, "Active", false);
    }
  } catch (error) {
    pledgeHudWarning(error);
  }
  pledgeHudPlayers.delete(slot);
}

function hidePledgePromptForPlayer(pawn) {
  const slot = playerSlotForHud(pawn);
                                                                        
                                                                        
  for (const [targetSlot, record] of pledgeHudPlayers) {
    if (record.pawn === pawn || targetSlot === slot) clearPledgeHudSlot(targetSlot, record);
  }
}

function clearPledgePrompt() {
  for (const [slot, record] of pledgeHudPlayers) clearPledgeHudSlot(slot, record);
}

function syncPledgePrompt(event) {
  const players = new Set([...event.pledged].filter((pawn) =>
    validEntity(pawn) && pawn.IsAlive?.() && pawn.GetTeamNumber?.() === 3));
  for (const [slot, record] of pledgeHudPlayers) {
    if (!players.has(record.pawn)) clearPledgeHudSlot(slot, record);
  }
  if (!players.size) return;
  const hud = findPledgeHud();
  if (!hud || typeof hud.SetHasClassForPlayer !== "function") {
    pledgeHudWarning("collective_pledge_hud or SetHasClassForPlayer is missing");
    return;
  }
  for (const pawn of players) {
    const slot = playerSlotForHud(pawn);
    if (slot === undefined) {
      pledgeHudWarning("cannot resolve player slot");
      continue;
    }
    const previous = pledgeHudPlayers.get(slot);
    if (previous?.pawn === pawn && previous.hud === hud) continue;
    if (previous) clearPledgeHudSlot(slot, previous);
    try {
                                                                          
      hud.SetHasClassForPlayer(slot, PLEDGE_HUD_PANEL, "Active", true);
      pledgeHudPlayers.set(slot, { pawn, hud });
    } catch (error) {
      pledgeHudWarning(error);
    }
  }
}

function squidBlindHudWarning(reason) {
  if (squidBlindHudWarningPrinted) return;
  squidBlindHudWarningPrinted = true;
  message(`Squid blindness HUD unavailable: ${reason}; gameplay continues without the overlay`);
}

function findSquidBlindHud() {
  if (validEntity(squidBlindHud) && typeof squidBlindHud.SetHasClassForPlayer === "function") return squidBlindHud;
  try {
    const candidate = Instance.FindEntityByName(SQUID_BLIND_HUD_TARGET);
    if (validEntity(candidate) && typeof candidate.SetHasClassForPlayer === "function") {
      squidBlindHud = candidate;
      return candidate;
    }
  } catch (error) {
    squidBlindHudWarning(error);
  }
  return undefined;
}

function clearSquidBlindHudSlot(slot, record) {
  try {
    if (validEntity(record.hud)) record.hud.SetHasClassForPlayer(slot, SQUID_BLIND_HUD_PANEL, "Active", false);
  } catch (error) {
                                                                            
    squidBlindHudWarning(error);
    return false;
  }
  squidBlindHudPlayers.delete(slot);
  return true;
}

function hideSquidBlindForPlayer(pawn) {
  for (const [slot, record] of squidBlindHudPlayers) {
    if (record.pawn === pawn) clearSquidBlindHudSlot(slot, record);
  }
}

function clearSquidBlindHud() {
  for (const [slot, record] of squidBlindHudPlayers) clearSquidBlindHudSlot(slot, record);
  squidBlindHudNextSyncAt = 0;
}

function squidBlindPlayers(now) {
  const players = new Set();
  for (const [pawn, statuses] of state.playerStatuses) {
    if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) continue;
    if ([...statuses.values()].some((status) =>
      status.squidBlind === true && status.until > now
      && (state.levels.has(status.owner) || state.endingRuntime?.index === status.owner))) players.add(pawn);
  }
  return players;
}

function syncSquidBlindHud(now, force = false) {
  if (!force && now < squidBlindHudNextSyncAt) return;
  squidBlindHudNextSyncAt = now + 0.1;
                                                                           
                                                    
  const players = state.running && !state.fatal ? squidBlindPlayers(now) : new Set();
  for (const [slot, record] of squidBlindHudPlayers) {
    if (!players.has(record.pawn)) clearSquidBlindHudSlot(slot, record);
  }
  if (!players.size) return;
  const hud = findSquidBlindHud();
  if (!hud) {
    squidBlindHudWarning(`${SQUID_BLIND_HUD_TARGET} or SetHasClassForPlayer is missing`);
    return;
  }
  for (const pawn of players) {
    const slot = playerSlotForHud(pawn);
    if (slot === undefined) {
      squidBlindHudWarning("cannot resolve player slot");
      continue;
    }
    const previous = squidBlindHudPlayers.get(slot);
    if (previous?.pawn === pawn && previous.hud === hud) continue;
    if (previous && !clearSquidBlindHudSlot(slot, previous)) continue;
    try {
      hud.SetHasClassForPlayer(slot, SQUID_BLIND_HUD_PANEL, "Active", true);
      squidBlindHudPlayers.set(slot, { pawn, hud });
    } catch (error) {
      squidBlindHudWarning(error);
    }
  }
}



function terrainPreviewRuntimeReady(runtime) {
  return !!runtime && state.running && !state.fatal
    && state.levels.get(runtime.index) === runtime
    && runtime.remaining === 0 && !runtime.planningIterator
    && ["active", "history", "transition", "end_delay", "fading"].includes(runtime.lifecycle);
}

                                                                             
function showTerrainPreviewHudStatic(reason = "bootstrap") {
  if (!terrainPreviewRuntimeReady(terrainPreviewRuntime)) {
    return hideTerrainPreviewHud(reason);
  }
  const hud = findTerrainPreviewHud();
  if (!hud) return false;
  try {
    if (!terrainPreviewHudShown || terrainPreviewHudTileClasses.length !== CONFIG.mapSize * CONFIG.mapSize)
      return updateTerrainPreviewHud(terrainPreviewRuntime, reason);
    return updateTerrainPreviewMetadata(hud, terrainPreviewHudMetadata);
  } catch (error) {
    message(`terrain preview HUD bootstrap failed: ${error}`);
    return false;
  }
}

function updateTerrainPreviewMetadata(hud, metadata) {
  if (!metadata || typeof hud?.SetDialogVariableString !== "function") return false;
                                                                       
  hud.SetDialogVariableString("stage_title", "map_name", String(metadata.name ?? "unknown"));
  hud.SetDialogVariableString("stage_info", "map_author", String(metadata.author ?? "unknown"));
  hud.SetDialogVariableString("stage_id", "map_id", String(metadata.id ?? "unknown").replace(/^#/, ""));
                                                                             
  hud.SetHasClass("stage_header", "Hidden", false);
  hud.SetHasClass("stage_header", "MetadataVisible", true);
  hud.SetHasClass("stage_header", "MetadataDisabled", false);
  hud.SetHasClass(TERRAIN_PREVIEW_ROOT_PANEL, "Hidden", false);
  return true;
}



function terrainPreviewTileClass(tile) {
  const value = Number(tile);
  if (!Number.isInteger(value)) return "TileIndexUnknown";
  if (value === 9998) return "TileIndex9998";
  if (value >= 0 && value < 200) return `TileIndex${value}`;
  return "TileIndexUnknown";
}

function terrainPreviewRows(runtime) {
  if (!runtime) return [];
  if (Array.isArray(runtime.previewRows)) return runtime.previewRows;
  if (Array.isArray(runtime.previewTiles)) {
    const rows = [];
    for (let y = 0; y < CONFIG.mapSize; y++) {
      rows.push(runtime.previewTiles.slice(y * CONFIG.mapSize, (y + 1) * CONFIG.mapSize));
    }
    return rows;
  }
  return [];
}

function updateTerrainPreviewHud(runtime, reason = "queued") {
  if (!terrainPreviewRuntimeReady(runtime)) {
    if (terrainPreviewRuntime === runtime) hideTerrainPreviewHud(reason);
    return false;
  }
  const rows = terrainPreviewRows(runtime);
  const tiles = rows.flat();
  if (tiles.length !== CONFIG.mapSize * CONFIG.mapSize) {
    if (terrainPreviewRuntime === runtime) hideTerrainPreviewHud("invalid-preview");
    message(`terrain preview skipped (${reason}): expected ${CONFIG.mapSize * CONFIG.mapSize} tiles, got ${tiles.length}`);
    return false;
  }
  terrainPreviewHudMetadata = { id: runtime.id, name: runtime.name, author: runtime.author };
  terrainPreviewRuntime = runtime;
  const hud = findTerrainPreviewHud();
  if (!hud) return false;
  try {
    hud.SetHasClass(TERRAIN_PREVIEW_ROOT_PANEL, "Hidden", true);
    for (let index = 0; index < tiles.length; index++) {
      const selected = terrainPreviewTileClass(tiles[index]);
      const panelId = `pixel_${index}`;
      const previous = terrainPreviewHudTileClasses[index];
      if (previous && previous !== selected) hud.SetHasClass(panelId, previous, false);
      if (!previous) {
                                                                           
                                                                            
        for (const className of TERRAIN_PREVIEW_LEGACY_TILE_CLASSES) {
          hud.SetHasClass(panelId, className, false);
        }
      }
      if (previous !== selected) {
        hud.SetHasClass(panelId, selected, true);
        terrainPreviewHudTileClasses[index] = selected;
      }
    }
    updateTerrainPreviewMetadata(hud, terrainPreviewHudMetadata);
    hud.SetHasClass(TERRAIN_PREVIEW_ROOT_PANEL, "Hidden", false);
    terrainPreviewHudShown = true;
    return true;
  } catch (error) {
    try { hud.SetHasClass(TERRAIN_PREVIEW_ROOT_PANEL, "Hidden", true); } catch (_) {}
    terrainPreviewHudShown = false;
    message(`terrain preview update failed: ${error}`);
    return false;
  }
}

function clearTerrainPreviewHudTiles(hud, classes = terrainPreviewHudTileClasses) {
  for (let index = 0; index < CONFIG.mapSize * CONFIG.mapSize; index++) {
    const panelId = `pixel_${index}`;
    const className = classes[index];
    if (className) hud.SetHasClass(panelId, className, false);
  }
}

function hideTerrainPreviewHud(reason = "round-end") {
  const hud = findTerrainPreviewHud();
  const wasShown = terrainPreviewHudShown || !!terrainPreviewRuntime;
  let cleared = !hud;
  try {
    if (hud) {
      hud.SetHasClass(TERRAIN_PREVIEW_ROOT_PANEL, "Hidden", true);
      hud.SetHasClass("stage_header", "MetadataDisabled", true);
      hud.SetHasClass("stage_header", "MetadataVisible", false);
      clearTerrainPreviewHudTiles(hud);
      cleared = true;
      if (typeof hud.SetDialogVariableString === "function") {
        hud.SetDialogVariableString("stage_title", "map_name", "");
        hud.SetDialogVariableString("stage_info", "map_author", "");
        hud.SetDialogVariableString("stage_id", "map_id", "");
      }
    }
    if (wasShown) message(`terrain preview HUD hidden (${reason})`);
    return true;
  } catch (error) {
    message(`terrain preview HUD hide failed: ${error}`);
    return false;
  } finally {
                                                                            
    terrainPreviewRuntime = undefined;
    terrainPreviewHudMetadata = undefined;
    terrainPreviewHudShown = false;
    if (cleared) terrainPreviewHudTileClasses = [];
  }
}

// PointTemplate creates entities before caller-side model/transform setup.
// Keep every result reachable for round cleanup even if that setup throws.
function spawnRoundEntities(template, ...args) {
  const spawned = template.ForceSpawn(...args);
  for (const entity of spawned ?? []) if (entity) state.roundEntities.add(entity);
  return spawned;
}

function pruneRoundEntities(now) {
  if (now < state.nextRoundEntityPruneAt) return;
  state.nextRoundEntityPruneAt = now + 0.1;
  const iterator = state.roundEntityPruneIterator ??= state.roundEntities.values();
  // Bound native IsValid calls instead of scanning a whole map in one Think.
  for (let budget = 128; budget > 0; budget--) {
    const next = iterator.next();
    if (next.done) { state.roundEntityPruneIterator = undefined; return; }
    if (!validEntity(next.value)) state.roundEntities.delete(next.value);
  }
}

function roundCleanupStep(name, callback) {
  try { return callback(); }
  catch (error) { message(`round cleanup '${name}' failed: ${String(error)}`); }
}

// The engine keeps a V8 global handle for every QueueAfterThinks callback it
// is given, retaining the callback's whole closure (entity, request, runtime)
// for the life of the process. Batch all post-Think work behind one stable,
// capture-free function so at most one handle per frame reaches the engine.
let afterThinkQueue = [];
let afterThinkScheduledAt;

function drainAfterThinks() {
  afterThinkScheduledAt = undefined;
  const queue = afterThinkQueue;
  afterThinkQueue = [];
  for (const callback of queue) {
    try { callback(); }
    catch (error) { reportGuardedError("afterThink", error); }
  }
}

function afterThink(callback) {
  afterThinkQueue.push(callback);
  if (afterThinkScheduledAt !== undefined) return;
  afterThinkScheduledAt = Instance.GetGameTime();
  Instance.QueueAfterThinks(drainAfterThinks);
}

// If the engine ever drops a queued drain (e.g. across a lifecycle edge),
// don't let the batch wait forever.
function recoverStalledAfterThinks(now) {
  if (afterThinkScheduledAt !== undefined && now - afterThinkScheduledAt > 1) drainAfterThinks();
}

function cancelScheduledTasks() {
  for (const task of state.scheduledTasks) task.cancelled = true;
  state.scheduledTasks.length = 0;
}

function schedule(delay, callback, owner) {
  const task = {
    at: Instance.GetGameTime() + Math.max(0, delay),
    callback,
    owner,
    round: state.roundBootstrapSerial,
    cancelled: false,
  };
  state.scheduledTasks.push(task);
  return task;
}

function processTasks(now) {
  const due = [];
  const future = [];
  for (const task of state.scheduledTasks) {
    if (task.cancelled || task.round !== state.roundBootstrapSerial) continue;
    (task.at <= now ? due : future).push(task);
  }
  state.scheduledTasks = future;
  for (const task of due) {
    try {
      if (!task.cancelled && task.round === state.roundBootstrapSerial) task.callback();
    } catch (error) {
      failRuntime(`scheduled task failed: ${error}`);
      return;
    }
  }
}

function validateLevels() {
  if (Object.keys(TILE_REGISTRY).length !== 201) throw new Error("expected 201 tile definitions");
  if (ALL_LEVELS.length !== 1360) throw new Error(`expected 1360 source levels, got ${ALL_LEVELS.length}`);
  if (RACE_LEVELS.length !== 50) throw new Error(`expected 50 playable authored RACE levels after removing the simplified course, got ${RACE_LEVELS.length}`);
  const expectedCapabilityLevels = FEATURE_FLAGS.randomColor
    ? ALL_LEVELS.length
    : FEATURE_FLAGS.humanItems
    ? (FEATURE_FLAGS.zombieItems ? 1311 : 848)
    : (FEATURE_FLAGS.zombieItems ? 766 : 726);
  const excludedRaceLevels = ALL_LEVELS.filter(level => String(level.name ?? "").startsWith("RACE")
    && requiredCapabilitiesForLevel(level).every(capability => ACTIVE_CAPABILITIES.has(capability)));
  const expectedPlayableLevels = expectedCapabilityLevels - excludedRaceLevels.length;
  if (LEVELS.length !== expectedPlayableLevels) {
    throw new Error(`expected ${expectedPlayableLevels} active levels, got ${LEVELS.length}`);
  }
  for (const level of ALL_LEVELS) {
    if (!level || !Array.isArray(level.tiles) || level.tiles.length !== 400) {
      throw new Error(`${level?.id ?? "unknown"}: expected 400 tiles`);
    }
    if (!["forward", "left", "right"].includes(level.direction)) {
      throw new Error(`${level.id}: invalid direction '${level.direction}'`);
    }
    let markerCount = 0;
    for (const tile of level.tiles) {
      const colorTile = tile && Array.isArray(tile.color) && tile.color.length === 3;
      if (!colorTile && (!Number.isInteger(tile) || !TILE_REGISTRY[tile])) throw new Error(`${level.id}: unknown tile '${tile}'`);
      if (tile === 2) markerCount++;
    }
    if (markerCount !== 4) {
      throw new Error(`${level.id}: expected four START_END tiles, got ${markerCount}`);
    }
  }
}

function cacheEntities(parentCosmetics = true) {
  state.templates.clear();
  for (const [shape, name] of Object.entries(TEMPLATE_NAMES)) {
    const entity = Instance.FindEntityByName(name);
    if (entity && entity.IsValid() && typeof entity.ForceSpawn === "function") {
      state.templates.set(shape, entity);
    }
  }
  state.featureTemplates.clear();
  for (const [capability, name] of Object.entries(FEATURE_TEMPLATE_NAMES)) {
    const entity = Instance.FindEntityByName(name);
    if (entity && entity.IsValid() && typeof entity.ForceSpawn === "function") {
      state.featureTemplates.set(capability, entity);
    }
  }
  state.themePreloadTemplates.clear();
  for (const theme of THEME_PRELOAD_NAMES) {
    const entity = Instance.FindEntityByName(`template_theme_preload_${theme}`);
    if (entity && entity.IsValid() && typeof entity.ForceSpawn === "function") {
      state.themePreloadTemplates.set(theme, entity);
    }
  }
  state.soundEvents.clear();
  for (const token of ITEM_SOUND_EVENT_TOKENS) {
    const entity = Instance.FindEntityByName(`soundevent_sfx_${token}`);
    if (entity && entity.IsValid?.()) state.soundEvents.set(token, entity);
  }
  state.bgmAnchors.clear();
  const bgmAnchorTokens = new Set([
    ...THEME_MUSIC_TOKENS,
    ...Object.values(ENDING_MUSIC),
    "confronting_myself_infinite_static",
    "confronting_myself_loop",
    "confronting_myself_loop_infinite",
    "confronting_myself_start",
    "grained",
  ]);
  for (const token of bgmAnchorTokens) {
    const entity = Instance.FindEntityByName(`soundevent_bgm_${token}`);
    if (entity && entity.IsValid?.()) state.bgmAnchors.set(token, entity);
  }
  state.snowstormOverlay.particle = Instance.FindEntityByName("collective_snow_screen");
  state.collectiveTitle.particle = Instance.FindEntityByName(FINALE_BOSS_LOGO_CONFIG.particleTarget);
                                                                          
                                                                             
                                                                              
                                
  state.raceAnchors = {
    directionHint: Instance.FindEntityByName("ending_race_direction_hint"),
    fade: Instance.FindEntityByName("ending_race_fade"),
    bgmToadsA: Instance.FindEntityByName("soundevent_bgm_toads_turnpike"),
    bgmToads: Instance.FindEntityByName("soundevent_bgm_toads_turnpike_race_b"),
  };
  state.teleportDestination = Instance.FindEntityByName("teledest");
  state.teleportIndicator = Instance.FindEntityByName("tpdest_indicator");
  if (parentCosmetics) parentAuthoredEntity("spawninfoboard", "spawnplatform");
}

function spawnInfoBoardPlan(direction) {
                                                                         
                                                                     
  const length = Math.hypot(direction.x, direction.y);
  const forward = length > 0 ? vec(direction.x / length, direction.y / length, 0) : vec(1, 0, 0);
  return {
    position: sub(vec(0, 0, 472), mul(forward, 516)),
    angles: { pitch: 15, yaw: normalizeYaw(yawOf(forward)), roll: 0 },
  };
}

function restoreSpawnInfoBoard() {
  const roundSerial = state.roundBootstrapSerial;
  const deadline = Instance.GetGameTime() + REQUIRED_ENTITY_WAIT_TIMEOUT;
  const apply = () => {
    if (roundSerial !== state.roundBootstrapSerial || !state.running || state.fatal || state.spawnPlatformKilled) return false;
    const board = Instance.FindEntityByName("spawninfoboard");
    if (!validEntity(board)) {
      if (Instance.GetGameTime() < deadline) schedule(REQUIRED_ENTITY_RETRY_INTERVAL, apply);
      else message("spawn info board missing; check the updated VMAP build");
      return false;
    }
    try {
      const plan = spawnInfoBoardPlan(state.startPoint.direction);
                                                                            
                                                                               
      board.Teleport({ position: plan.position, angles: plan.angles, velocity: vec() });
      fireTarget(board, "Enable", "");
      return true;
    } catch (error) {
      message(`spawn info board could not be restored: ${String(error)}`);
      return false;
    }
  };
  return apply();
}

const SPAWN_STAGE_LABEL_TARGET = "collective_spawn_stage_label";
let spawnStageLabelSerial = 0;

function spawnStageLabelPlan(stage, direction) {
                                                                       
                                                                         
  const infinite = stage.stageIndex > FINALE_STAGE_INDEX
    || stage.finaleInfiniteMusic === true;
  const finale = stage.stageIndex >= FINALE_STAGE_INDEX;
  const text = infinite ? "Infinite mode" : finale ? "Finale"
    : `Stage ${stage.stageNumber}/${STAGE_CONFIGS.length} | ${stage.stageGoal} levels | ${stage.theme} | ${String(stage.ending).toLowerCase()}`;
  const length = Math.hypot(direction.x, direction.y);
  const forward = length > 0 ? vec(direction.x / length, direction.y / length, 0) : vec(1, 0, 0);
                                                                            
                                                                             
                                                                               
                                                                                
  const position = add(vec(0, 0, 200), mul(forward, 480));
                                                                          
                                                                           
                                                                   
  const angles = { pitch: 0, yaw: normalizeYaw(yawOf(forward) - 90), roll: 90 };
  return { text, position, angles };
}

function hideSpawnStageLabel() {
  spawnStageLabelSerial++;
  fireName(SPAWN_STAGE_LABEL_TARGET, "Disable");
}

function showSpawnStageLabel() {
  const serial = ++spawnStageLabelSerial;
  const deadline = Instance.GetGameTime() + REQUIRED_ENTITY_WAIT_TIMEOUT;
  const apply = () => {
    if (serial !== spawnStageLabelSerial || !state.running || state.fatal || state.spawnPlatformKilled) return false;
    const text = Instance.FindEntityByName(SPAWN_STAGE_LABEL_TARGET);
    if (!validEntity(text)) {
      if (Instance.GetGameTime() < deadline) schedule(REQUIRED_ENTITY_RETRY_INTERVAL, apply);
      else message(`spawn stage label '${SPAWN_STAGE_LABEL_TARGET}' missing; check the updated VMAP build`);
      return false;
    }
    try {
      const plan = spawnStageLabelPlan(campaignStageSnapshot(), state.startPoint.direction);
                                                                              
      text.Teleport({ position: plan.position, angles: plan.angles, velocity: vec() });
      fireTarget(text, "SetMessage", plan.text);
      fireTarget(text, "SetTextColor", "255 255 0");
      fireTarget(text, "Enable");
      return true;
    } catch (error) {
                                                                            
      message(`spawn stage label could not be displayed: ${String(error)}`);
      return false;
    }
  };
  return apply();
}

function parentAuthoredEntity(childName, parentName) {
  try {
    const child = Instance.FindEntityByName(childName);
    const parent = Instance.FindEntityByName(parentName);
    if (!validEntity(child) || !validEntity(parent) || typeof child.SetParent !== "function") return false;
    const position = child.GetAbsOrigin?.();
    const angles = child.GetAbsAngles?.();
    child.SetParent(parent);
                                                                              
                                                              
    child.Teleport?.({ position, angles, velocity: vec() });
    return true;
  } catch (error) {
                                                                       
                                                                            
    message(`optional parent '${childName}' -> '${parentName}' was skipped: ${String(error)}`);
    return false;
  }
}

function missingRequiredEntities() {
  const missing = new Set();
  for (const shape of Object.keys(TEMPLATE_NAMES)) {
    if (!state.templates.has(shape)) missing.add(TEMPLATE_NAMES[shape]);
  }
  for (const [capability, name] of Object.entries(FEATURE_TEMPLATE_NAMES)) {
    if (featureTemplateIsRequired(capability) && !state.featureTemplates.has(capability)) missing.add(name);
  }
  if (!state.teleportDestination || !state.teleportDestination.IsValid()) {
    missing.add("teledest");
  }
  return [...missing];
}

function validateRequiredEntities() {
  const missing = missingRequiredEntities();
  if (missing.length > 0) {
    failRuntime(`missing required entities: ${missing.join(", ")}`);
    return false;
  }
  return true;
}

function failRuntime(reason) {
  clearThemeTerrainWarmup();
  clearTerrainPreload(true);
  hideTerrainPreviewHud("fatal");
  clearGenerationWork();
  clearSpawnSafetyTriggers();
  clearInvincibilityHud();
  hideSpawnStageLabel();
  clearSourceAudio();
  clearGenericEvents();
  clearThemeModelSky();
  if (!state.fatal) announce(`FATAL: ${reason}`);
  stopThemeMusic("fatal");
  state.themeMusic.enabled = false;
  state.fatal = true;
  state.running = false;
  state.roundBootstrapPending = false;
  destroyEndingRuntime(state.endingRuntime, "fatal");
  retainCampaignStage(reason);
  state.spawnQueue.length = 0;
  state.itemSpawnQueue.length = 0;
  state.trapSpawnQueue.length = 0;
  state.scheduledTasks.length = 0;
  if (state.pendingLevel) {
    destroyLevel(state.pendingLevel.index);
    state.pendingLevel = undefined;
  }
  state.transitionLevel = undefined;
  fireName("tele_spawn", "Disable");
  fireName("afk_killer", "Disable");
}

                                                                             
                       
const COLLECTIVE_SKYBOX_ENTITIES = Object.freeze({
  generic: "default_sky",
  castle: "collective_sky_castle",
  factory: "collective_sky_factory",
  hell: "collective_sky_hell",
  silenthill_dark: "collective_sky_silenthill_dark",
});
let collectiveSkyboxSelection = "generic";

function setCollectiveSkybox(key, quiet = false) {
  if (!Object.hasOwn(COLLECTIVE_SKYBOX_ENTITIES, key)) {
    if (!quiet) message("skybox: use generic, castle, factory, hell or silenthill_dark");
    return false;
  }
                                                                       
  const targets = Object.entries(COLLECTIVE_SKYBOX_ENTITIES).map(([name, target]) =>
    ({ name, target, entity: Instance.FindEntityByName(target) }));
                                                                         
                                                                       
  const missing = targets.filter(({ name, entity }) => !validEntity(entity)
    && (name !== "silenthill_dark" || key === "silenthill_dark"));
  if (missing.length) {
    if (!quiet) message("skybox entities missing: " + missing.map(({ target }) => target).join(", "));
    return false;
  }
  for (const { name, entity } of targets) {
    if (name !== key && validEntity(entity)) fireTarget(entity, "Disable", "");
  }
  fireTarget(targets.find(({ name }) => name === key).entity, "Enable", "");
  collectiveSkyboxSelection = key;
  return true;
}

function resetCollectiveSkybox() {
                                                                      
  for (const [key, target] of Object.entries(COLLECTIVE_SKYBOX_ENTITIES)) {
    const entity = Instance.FindEntityByName(target);
    if (entity?.IsValid?.()) fireTarget(entity, key === "generic" ? "Enable" : "Disable", "");
  }
  collectiveSkyboxSelection = "generic";
}


                     


                        
                                                                             
                                                                 
const THEME_MODEL_SKY_PROFILES = Object.freeze({
  generic: { sky: "generic", clouds: 2, color: [100,100,100], backgrounds: 0 },
  castle: { sky: "castle", clouds: 2, color: [0,0,0], backgrounds: 1,
    model: "skybox_castle", spread: 5000, z: [-8000,-7500], scale: [3,3], tint: [150,150,120] },
  factory: { sky: "factory", clouds: 2, color: [100,150,100], backgrounds: 2,
    model: "skybox_factory", spread: 5000, z: [-5000,-4000], scale: [3,4], tint: [120,180,150] },
  temple: { sky: "castle", clouds: 2, color: [255,0,0], backgrounds: 4,
    model: "skybox_temple", spread: 10000, z: [-3000,3000], scale: [2,4], tint: [180,150,120], alpha: 254 },
  nature: { sky: "castle", clouds: 3, color: [50,150,0], backgrounds: 3,
    model: "skybox_nature", spread: 1000, z: [-3000,3000], scale: [43,43], tint: [160,170,100] },
  hell: { sky: "hell", clouds: 1, color: [200,50,0], backgrounds: 5,
    model: "skybox_hell", spread: 1000, z: [-3000,3000], scale: [4,5], gray: [100,120] },
  frost: { sky: "generic", clouds: 2, color: [0,200,255], cloudExtraZ: -3500, backgrounds: 1,
    model: "skybox_frost", scale: [12,12], tint: [255,255,255], frost: true },
  silenthill: { sky: "generic", clouds: 2, color: [100,100,100], backgrounds: 0 },
});
const themeModelSky = { active: undefined, retiring: [], serial: 0, nextTick: 0, override: undefined, failedTheme: undefined,
  silentHillDarkTarget: 0, silentHillDarkAmount: 0, missingSilentHillSkyWarned: false };
function skyRandomRange(a, b) { return a + Math.random() * (b - a); }
function themeSkyKill(scene) {
  if (!scene) return;
                                                                             
  for (const entity of [...scene.entities].reverse()) if (validEntity(entity)) entity.Kill();
  scene.entities.clear();
}
function clearThemeModelSky() {
  themeSkyKill(themeModelSky.active);
  for (const scene of themeModelSky.retiring) themeSkyKill(scene);
  themeModelSky.active = undefined;
  themeModelSky.retiring.length = 0;
  themeModelSky.override = undefined;
  themeModelSky.failedTheme = undefined;
  themeModelSky.nextTick = 0;
  themeModelSky.silentHillDarkTarget = 0;
  themeModelSky.silentHillDarkAmount = 0;
  themeModelSky.lastToneTick = undefined;
}
function themeSkyAlpha(record, alpha) {
  record.requestedAlpha = Math.max(0, Math.min(record.maxAlpha, Math.floor(alpha)));
  if ([...state.genericEvents.active.values()].some(event => event.name === "PHASING" && !event.ended)) alpha = 0;
  alpha = Math.max(0, Math.min(record.maxAlpha, Math.floor(alpha)));
  const colorKey = record.tint.join(",");
  if (!validEntity(record.visual) || (record.alpha === alpha && record.colorKey === colorKey)) return;
  record.visual.SetColor({r: record.tint[0], g: record.tint[1], b: record.tint[2], a: alpha});
  record.alpha = alpha;
  record.colorKey = colorKey;
}
function themeSkySpawn(scene, model, position, yaw, scale, tint, maxAlpha = 255, parent) {
  const spawned = spawnRoundEntities(scene.template, position, {pitch: 0, yaw, roll: 0}) ?? [];
                                                             
  for (const entity of spawned) if (validEntity(entity)) scene.entities.add(entity);
  const visual = spawned.find(entity => validEntity(entity) && typeof entity.SetModel === "function");
  if (!visual) throw new Error("sky prototype did not return a model entity");
  for (const entity of spawned) if (entity !== visual && validEntity(entity)) {
    entity.Kill(); scene.entities.delete(entity);
  }
  visual.SetEntityName("theme_sky_" + scene.serial + "_" + scene.records.length);
  visual.SetModel(model);
  visual.SetModelScale(scale);
                                                                          
                                                                            
  if (model === "models/luffaren/collective_skybox_clouds.vmdl") {
    fireTarget(visual, "SetDefaultAnimation", "baseidle");
    fireTarget(visual, "SetAnimation", "baseidle");
  }
  if (parent) visual.SetParent(parent);
                                                                         
  visual.Teleport({position, angles: {pitch: 0, yaw, roll: 0}, velocity: vec()});
  const record = {visual, tint: [...tint], baseTint: [...tint], maxAlpha, alpha: undefined};
  themeSkyAlpha(record, 0);
  scene.records.push(record);
  return record;
}
function moveThemeModelSky(scene, endZ) {
  if (!scene || !Number.isFinite(endZ) || scene.endZ === endZ) return;
  const z = endZ - 2300 + (scene.profile.cloudExtraZ ?? 0);
  for (const record of scene.clouds) if (validEntity(record.visual)) {
    record.visual.Teleport({position: vec(0, 0, z), velocity: vec()});
  }
                                                                              
  scene.endZ = endZ;
}
function ensureThemeModelSky(theme, endZ = state.currentLevel?.end?.z ?? 0, force = false) {
                                                                        
                                                                           
  if (!force && state.endingRuntime?.kind === "FINALE" && state.endingRuntime.finaleSky
      && ["spawning", "active"].includes(state.endingRuntime.lifecycle)) return false;
  if (!force && themeModelSky.override === "off") return false;
  const key = !force && themeModelSky.override ? themeModelSky.override : theme;
  const profile = THEME_MODEL_SKY_PROFILES[key];
  if (!profile) return false;
  if (themeModelSky.active?.theme === key) {
    moveThemeModelSky(themeModelSky.active, endZ);
    return true;
  }
  if (themeModelSky.failedTheme === key) return false;
  const template = Instance.FindEntityByName("template_sky_model");
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
    themeModelSky.failedTheme = key;
    message("model sky unavailable: template_sky_model missing; existing sky retained");
    return false;
  }
  const scene = {theme: key, profile, template, serial: ++themeModelSky.serial,
    entities: new Set(), records: [], clouds: [], startedAt: Instance.GetGameTime(), endZ: undefined};
  const base = vec(0, 0, endZ - 2300 + (profile.cloudExtraZ ?? 0));
  try {
    for (let i = 0; i < profile.clouds; i++) {
      scene.clouds.push(themeSkySpawn(scene, "models/luffaren/collective_skybox_clouds.vmdl",
        base, Math.floor(skyRandomRange(0, 361)), 100, profile.color));
    }
    for (let i = 0; i < profile.backgrounds; i++) {
      const masterIndex = key === "factory" ? i : key === "temple" ? Math.floor(i / 2) : 0;
      const master = scene.clouds[masterIndex].visual;
      const yaw = skyRandomRange(0, 360);
      let offset;
      if (profile.frost) {
        const radians = yaw * Math.PI / 180;
                                                                                
        offset = vec(Math.cos(radians) * 15000, Math.sin(radians) * -15000, -2200);
      } else {
        offset = vec(skyRandomRange(-profile.spread, profile.spread),
          skyRandomRange(-profile.spread, profile.spread), skyRandomRange(...profile.z));
      }
      const gray = profile.gray ? Math.floor(skyRandomRange(profile.gray[0], profile.gray[1] + 1)) : undefined;
      const tint = profile.gray ? [gray, gray, gray] : profile.tint;
      const record = themeSkySpawn(scene, "models/luffaren/" + profile.model + ".vmdl", add(base, offset),
        yaw, skyRandomRange(...profile.scale), tint, profile.alpha ?? 255, master);
      if (profile.glow) record.visual.Glow?.({r: profile.glow[0], g: profile.glow[1], b: profile.glow[2], a: 255});
    }
    scene.endZ = endZ;
  } catch (error) {
    themeSkyKill(scene);
    themeModelSky.failedTheme = key;
    message("model sky '" + key + "' spawn failed; existing sky retained: " + error);
    return false;
  }
  const old = themeModelSky.active;
  if (old) {
    old.fadeOutAt = scene.startedAt;
    for (const record of old.records) record.fadeStartAlpha = record.alpha ?? record.maxAlpha;
    themeModelSky.retiring.push(old);
  }
  themeModelSky.active = scene;
  themeModelSky.failedTheme = undefined;
  setCollectiveSkybox(profile.sky);
  return true;
}
function processThemeModelSky(now = Instance.GetGameTime()) {
  if (now < themeModelSky.nextTick) return;
  themeModelSky.nextTick = now + 0.05;
  const active = themeModelSky.active;
  if (active) {
    const target = active.theme === "silenthill" ? themeModelSky.silentHillDarkTarget : 0;
    const delta = Math.min(1, Math.max(0, (now - (themeModelSky.lastToneTick ?? now)) / 1.0));
    themeModelSky.silentHillDarkAmount += Math.sign(target - themeModelSky.silentHillDarkAmount)
      * Math.min(Math.abs(target - themeModelSky.silentHillDarkAmount), delta);
    if (active.theme === "silenthill") {
      for (const record of active.clouds) {
        record.tint = record.baseTint.map((channel) => Math.round(channel * (1 - 0.8 * themeModelSky.silentHillDarkAmount)));
      }
    }
                                                             
    const steps = Math.floor(Math.max(0, now - active.startedAt) / 0.05 + 1e-6);
    for (const record of active.records) themeSkyAlpha(record, Math.min(record.maxAlpha, steps * 5));
    if (now >= (active.nextMoveAt ?? 0)) {
      moveThemeModelSky(active, state.currentLevel?.end?.z ?? active.endZ);
      active.nextMoveAt = now + 5;
    }
  }
  for (const scene of themeModelSky.retiring) {
    const t = Math.max(0, Math.min(1, (now - scene.fadeOutAt) / 5));
    for (const record of scene.records) themeSkyAlpha(record, (record.fadeStartAlpha ?? record.maxAlpha) * (1 - t));
    if (t >= 1) themeSkyKill(scene);
  }
  themeModelSky.retiring = themeModelSky.retiring.filter(scene => scene.entities.size > 0);
  themeModelSky.lastToneTick = now;
}

                      

function fireName(name, input, value, delay = 0, activator) {
  Instance.EntFireAtName({ name, input, value, delay, activator });
}

function fireTarget(target, input, value, delay = 0, activator) {
  Instance.EntFireAtTarget({ target, input, value, delay, activator });
}

function resolvePawn(entity) {
  if (!entity || !entity.IsValid()) return undefined;
  if (typeof entity.GetPlayerPawn === "function") {
    const pawn = entity.GetPlayerPawn();
    return pawn && pawn.IsValid() ? pawn : undefined;
  }
  return typeof entity.Teleport === "function" ? entity : undefined;
}

// Controller -> pawn resolution is cached for the duration of one Think so the
// many per-tick subsystems do not each walk every controller. Validity and
// life are still re-checked on every call, so a pawn killed mid-Think drops out.
let thinkPlayerPawns;

function resolvePlayerPawns() {
  if (thinkPlayerPawns) return thinkPlayerPawns;
  const pawns = [];
  for (const controller of Instance.GetAllPlayerControllers()) {
    if (!controller || !controller.IsValid()) continue;
    const pawn = controller.GetPlayerPawn();
    if (pawn && pawn.IsValid()) pawns.push(pawn);
  }
  return pawns;
}

function allLivingPawns() {
  return resolvePlayerPawns().filter((pawn) => pawn.IsValid() && pawn.IsAlive());
}

function allPlayerPawns() {
  return resolvePlayerPawns().filter((pawn) => pawn.IsValid());
}

function applyCoreServerSettings() {
  Instance.ServerCommand(`sv_airaccelerate ${CONFIG.airAccelerate}`);
  Instance.ServerCommand(`mp_roundtime ${CONFIG.roundTimeMinutes}`);
  Instance.ServerCommand(`mp_freezetime ${CONFIG.freezeTimeSeconds}`);
                                                                           
                                                                           
  Instance.SetRoundRemainingTime(CONFIG.roundTimeMinutes * 60);
}

function positionTeleportIndicator(position, enabled) {
  const indicator = state.teleportIndicator;
  if (!indicator || !indicator.IsValid()) return;
                                                                        
                                                                           
                                                                     
  indicator.SetColor?.({ r: 255, g: 255, b: 0, a: 255 });
  indicator.Teleport({
    position: add(position, vec(0, 0, -8)),
    angles: { pitch: 0, yaw: 0, roll: 0 },
    velocity: vec(),
  });
  fireTarget(indicator, enabled ? "Enable" : "Disable");
}

function setEndIndicatorState(runtime, indicatorState = "pending") {
  const indicator = runtime?.endIndicator;
  if (!validEntity(indicator)) return false;
  const color = END_INDICATOR_COLORS[indicatorState] ?? END_INDICATOR_COLORS.touch;
  runtime.endIndicatorState = indicatorState;
  indicator.SetColor?.(color);
  fireTarget(indicator, "Skin", indicatorState === "triggered" ? "1" : "0");
  if (indicatorState === "triggered") {
                                                                             
                                                                            
                                           
    indicator.Glow?.({ r: 0, g: 200, b: 0, a: 255 });
  } else {
    indicator.Unglow?.();
  }
  return true;
}

function spawnEndIndicator(runtime) {
  if (!runtime || runtime.raceLevel || runtime.kind === "FINALE" || runtime.endIndicator) return;
  if (!runtime.end || !runtime.outgoing) return;
  const position = sub(runtime.end, mul(runtime.outgoing, 48));
  try {
    const indicator = spawnVisual(runtime, {
      position,
                                                                          
                                                                      
      angles: { pitch: 0, yaw: 0, roll: 0 },
      feature: "endindicator",
    }, END_INDICATOR_MODEL);
    if (!validEntity(indicator)) throw new Error("floor indicator did not spawn");
    indicator.SetEntityName?.(`block_${runtime.index}_endindicator`);
    runtime.endIndicator = indicator;
    setEndIndicatorState(runtime, runtime.endProvider === "button" ? "button" : "touch");
                                                                            
                                                                        
    afterThink(() => {
      if (validEntity(runtime.endIndicator)) {
        setEndIndicatorState(runtime, runtime.endIndicatorState ?? "pending");
      }
    });
  } catch (error) {
                                                                            
                                        
    runtime.endIndicatorNote = `unavailable: ${error}`;
    message(`[END INDICATOR] level=${runtime.index} unavailable: ${error}`);
  }
}

function prepareTeleportIndicator() {
  const destination = state.teleportDestination;
  state.teleportFacing = undefined;
  if (!destination || !destination.IsValid()) return;
  positionTeleportIndicator(destination.GetAbsOrigin(), false);
  schedule(CONFIG.teleportIndicatorFallback, () => {
    const indicator = state.teleportIndicator;
    if (indicator && indicator.IsValid()) fireTarget(indicator, "Enable");
  });
}

function createCampaignFinaleSource() {
  const campaign = state.campaign ?? {};
  const position = campaign.finaleAnchor ?? state.startPoint?.position ?? vec();
  const direction = campaign.finaleDirection ?? state.startPoint?.direction ?? vec(1, 0, 0);
  return {
    index: `campaign_finale_source:${state.roundBootstrapSerial}`,
    id: "#campaign_finale_source",
    name: "Campaign Finale Source",
    lifecycle: "finale_source",
    lifecycleHistory: ["finale_source"],
    end: clone(position),
    entry: clone(position),
    tp: clone(position),
    center: clone(position),
    incoming: clone(direction),
    outgoing: clone(direction),
    entities: new Set(),
    terrainEntities: new Set(),
    safeTerrainEntities: new Set(),
    outputConnections: new Set(),
    items: new Set(),
    itemDeployables: new Set(),
    liquids: new Set(),
    liquidPawns: new Set(),
    movers: new Set(),
    traps: new Set(),
  };
}

function startCampaignFinale() {
  if (!state.running || state.fatal || state.campaign.stageIndex !== FINALE_STAGE_INDEX) return false;
  if (state.endingRuntime && !["destroyed", "resolved"].includes(state.endingRuntime.lifecycle)) return true;
  const stageSnapshot = createCampaignStageSnapshot(FINALE_STAGE_INDEX, "FINALE");
  const source = createCampaignFinaleSource();
  state.campaign.currentStageSnapshot = stageSnapshot;
  state.campaign.phase = "ending_handoff";
  state.campaign.endingStarted = true;
  state.falldownCheckpointEnabled = false;
  state.campaign.endingResolved = false;
  state.campaign.endingOutcomePending = false;
  state.campaign.endingContractCalls++;
  state.campaign.lastEnding = {
    stage: stageSnapshot.stageNumber,
    theme: stageSnapshot.theme,
    ending: "FINALE",
    levelIndex: source.index,
    campaign: true,
  };
  stopThemeMusic("finale_handoff", 10);
  state.themeMusic.enabled = false;
  try {
    const runtime = startFinaleEnding(stageSnapshot, source);
    runtime.campaignFinale = true;
    announce("FINALE: the fourth stage is complete; the final approach is opening");
    return true;
  } catch (error) {
    failRuntime(`campaign Finale startup failed: ${error}`);
    return false;
  }
}

function findThemePreloadEntity(target) {
  try {
    const entity = Instance.FindEntityByName(target);
    return validEntity(entity) ? entity : undefined;
  } catch (_) {
    return undefined;
  }
}

function cleanupThemePreload(pending = state.themePreload) {
  if (!pending) return;
  const entities = new Set([...(pending.returnedEntities ?? []), ...(pending.found?.values?.() ?? [])]);
  for (const target of pending.targets ?? []) {
    const entity = findThemePreloadEntity(target);
    if (entity) entities.add(entity);
  }
  for (const entity of entities) {
    if (validEntity(entity)) fireTarget(entity, "Kill");
  }
}

function scheduleInitialTerrainGeneration(reason) {
  if (!state.running || state.fatal || state.themeGenerationScheduled) return;
  state.themeGenerationScheduled = true;
                                                                        
                                                                           
  setSilentHillFog(false, campaignStageSnapshot().theme !== "silenthill");
  if (campaignStageSnapshot().theme === "silenthill") setSilentHillSky(false);
  if (state.campaign.stageIndex === FINALE_STAGE_INDEX && !state.debugMovementThemesMode && !state.debugAllModelsMode && !state.debugSilentHillTheme
    && state.debugStageId !== DEBUG_DATA.liquidFallLevel.id) {
    schedule(0.2, startCampaignFinale);
    message(`Finale generation armed (${reason}); theme '${campaignStageSnapshot().theme}'`);
    return;
  }
  startThemeMusic(0.1);
  ensureThemeModelSky(campaignStageSnapshot().theme);
  schedule(0.2, generateNextLevel);
  message(`terrain generation armed (${reason}); theme '${campaignStageSnapshot().theme}'`);
}

function finishThemeTerrainPreload(reason, completion, success = true) {
  if (completion) { completion(success, reason); return; }
  if ((state.debugMovementThemesMode || state.debugAllModelsMode || state.debugStageId === DEBUG_DATA.liquidFallLevel.id)
    && state.debugMovementThemeQueue.length > 0) {
    prepareThemeTerrainAssets(state.debugMovementThemeQueue.shift());
    return;
  }
  scheduleInitialTerrainGeneration(reason);
}

function detachThemePreload(pending) {
  if (state.themePreload === pending) state.themePreload = undefined;
  if (state.themeTerrainWarmup && state.themeTerrainWarmup.pending === pending) state.themeTerrainWarmup.pending = undefined;
}

function fallbackThemePreload(theme, reason, pending = state.themePreload) {
  const completion = pending?.onComplete;
  cleanupThemePreload(pending);
  detachThemePreload(pending);
  if (!completion) announce(`theme '${theme}' resources unavailable (${reason}); continuing with authored theme models`);
  finishThemeTerrainPreload(completion ? reason : "theme_unpreloaded", completion, false);
}

function themePreloadTimeout(theme) {
  return theme === "silenthill" ? THEME_PRELOAD_TIMEOUT * 2 : THEME_PRELOAD_TIMEOUT;
}

// What one theme still needs streamed: `ready` (nothing to spawn), `error`
// (cannot be loaded) or the native template(s) to spawn and names to wait for.
function themePreloadPlan(themeName) {
  const theme = themeProfile(themeName).name;
  if (theme === "generic") return { theme, ready: "generic" };
  if (state.themePreloaded.has(theme)) return { theme, ready: "theme_cached" };
  const rootModels = themePreloadModels(theme);
  const lightRootsReady = rootModels.length > 0
    && rootModels.every((model) => findThemePreloadEntity(themeRootPreloadTarget(model)));
  if (theme !== "silenthill" && lightRootsReady) return { theme, ready: "theme_root_preloaded", rootPreloaded: true };
  const template = state.themePreloadTemplates.get(theme);
  const darkTemplate = theme === "silenthill"
    ? Instance.FindEntityByName?.("template_theme_preload_silenthill_dark")
    : undefined;
  if ((!lightRootsReady && (!validEntity(template) || typeof template.ForceSpawn !== "function"))
    || (theme === "silenthill" && (!validEntity(darkTemplate) || typeof darkTemplate.ForceSpawn !== "function"))) {
    const missing = theme === "silenthill"
      ? [!lightRootsReady && !validEntity(template) && `template_theme_preload_${theme}`,
        !validEntity(darkTemplate) && "template_theme_preload_silenthill_dark"].filter(Boolean)
      : [`template_theme_preload_${theme}`];
    return { theme, error: `preload template missing: ${missing.join(", ") || "ForceSpawn unavailable"}` };
  }
  const darkModels = theme === "silenthill"
    ? rootModels.map((model) => model.replace(/\.vmdl$/i, "dark.vmdl"))
    : [];
  const targets = [
    ...(!lightRootsReady ? rootModels.map((model) => themePreloadTarget(theme, model)) : []),
    ...darkModels.map((model) => themePreloadTarget(theme, model)),
  ];
  if (targets.length === 0) return { theme, error: "empty model set" };
  return { theme, targets, spawners: [!lightRootsReady && template, darkTemplate].filter(Boolean) };
}

function createThemePreloadPending(plans, onComplete) {
  const now = Instance.GetGameTime();
  return {
    theme: plans.map((plan) => plan.theme).join("+"),
    themes: plans.map((plan) => ({ theme: plan.theme, targets: plan.targets, doneAt: undefined,
      startedAt: now, deadline: now + themePreloadTimeout(plan.theme) })),
    targets: plans.flatMap((plan) => plan.targets),
    found: new Map(),
    returnedEntities: [],
    startedAt: now,
    nextPollAt: now,
    deadline: now + Math.max(...plans.map(plan => themePreloadTimeout(plan.theme))),
    onComplete,
  };
}

function spawnThemePreloadPlan(plan, pending) {
  for (const spawner of plan.spawners) {
    const spawned = spawnRoundEntities(spawner, clone(THEME_PRELOAD_ORIGIN), { pitch: 0, yaw: 0, roll: 0 });
    if (Array.isArray(spawned)) pending.returnedEntities.push(...spawned.filter(validEntity));
  }
}

function clearThemeTerrainWarmup() {
  if (state.themeTerrainWarmup?.pending) cleanupThemePreload(state.themeTerrainWarmup.pending);
  state.themeTerrainWarmup = undefined;
}

function armThemeTerrainWarmup(runtime) {
  if (runtime.index !== 1 || state.themeTerrainWarmup || state.endingRuntime || runtime.kind || runtime.raceLevel
    || state.debugStageId || state.debugShowcaseMode || state.debugGravityMode
    || state.debugMovementThemesMode || state.debugAllModelsMode || state.debugTrapMode
    || runtime.debugTeleport || runtime.debugLiquidFall) return;
  state.themeTerrainWarmup = { round: state.roundBootstrapSerial,
    queue: [...THEME_PRELOAD_NAMES], pending: undefined, finished: false };
  message("[THEME WARMUP] first level ready; warming remaining terrain themes in the background");
}

// Foreground consumers reuse a theme already being streamed in the background.
// Transfer the entities and original deadline so neither loader can kill the other's props.
function adoptThemeTerrainWarmup(pending) {
  const warmup = state.themeTerrainWarmup;
  const background = warmup?.pending;
  const entry = pending.themes.find(entry => entry.theme === background?.theme);
  if (warmup) warmup.queue = warmup.queue.filter(theme => !pending.themes.some(entry => entry.theme === theme));
  if (!entry) return undefined;
  Object.assign(entry, background.themes[0]);
  for (const [name, entity] of background.found) pending.found.set(name, entity);
  pending.returnedEntities.push(...background.returnedEntities);
  pending.deadline = Math.max(...pending.themes.map(entry => entry.deadline));
  warmup.pending = undefined;
  message(`[THEME WARMUP] foreground adopted '${entry.theme}'`);
  return entry.theme;
}

function processThemeTerrainWarmup(foregroundUsed = false) {
  const warmup = state.themeTerrainWarmup;
  if (!warmup || !state.running || state.fatal) return false;
  if (warmup.round !== state.roundBootstrapSerial) { clearThemeTerrainWarmup(); return false; }
  if (warmup.pending) processThemePreload(Instance.GetGameTime(), warmup.pending);
  if (warmup.pending || foregroundUsed || state.themePreload || state.endingRuntime) return false;
  while (warmup.queue.length) {
    const plan = themePreloadPlan(warmup.queue.shift());
    if (plan.ready) { markThemePreloaded(plan.theme); continue; }
    if (plan.error) {
      message(`[THEME WARMUP] '${plan.theme}' skipped: ${plan.error}`);
      continue;
    }
    const pending = createThemePreloadPending([plan], (success, reason) => {
      if (state.themeTerrainWarmup !== warmup || warmup.round !== state.roundBootstrapSerial) return;
      message(`[THEME WARMUP] '${plan.theme}' ${success ? "ready" : `failed: ${reason}`}`);
    });
    warmup.pending = pending;
    try {
      spawnThemePreloadPlan(plan, pending);
      message(`[THEME WARMUP] streaming ${pending.targets.length} '${plan.theme}' models`);
    } catch (error) {
      fallbackThemePreload(plan.theme, `ForceSpawn failed: ${String(error)}`, pending);
    }
    return true;
  }
  if (!warmup.finished) {
    warmup.finished = true;
    message("[THEME WARMUP] background pass complete");
  }
  return false;
}

function prepareThemeTerrainAssets(themeName = campaignStageSnapshot().theme, options = {}) {
  const plan = themePreloadPlan(themeName);
  if (plan.ready) {
    if (plan.rootPreloaded) state.themePreloaded.add(plan.theme);
    finishThemeTerrainPreload(plan.ready, options.onComplete);
    return true;
  }
  if (plan.error) {
    if (options.onComplete) options.onComplete(false, plan.error);
    else fallbackThemePreload(plan.theme, plan.error);
    return false;
  }
  const pending = createThemePreloadPending([plan], options.onComplete);
  const adopted = adoptThemeTerrainWarmup(pending);
  state.themePreload = pending;
  try {
    if (adopted !== plan.theme) spawnThemePreloadPlan(plan, pending);
    message(`streaming ${pending.targets.length} '${plan.theme}' terrain models`);
    return true;
  } catch (error) {
    fallbackThemePreload(plan.theme, `ForceSpawn failed: ${String(error)}`);
    return false;
  }
}

// Finale: spawn every uncached theme's preload templates together so the engine
// streams them concurrently instead of one theme after another.
// onComplete(success, reason, failedThemes).
function prepareThemeTerrainBatch(themeNames, onComplete) {
  const plans = themeNames.map(themePreloadPlan);
  for (const plan of plans) if (plan.rootPreloaded) state.themePreloaded.add(plan.theme);
  const failed = plans.filter((plan) => plan.error);
  if (failed.length) {
    onComplete(false, failed.map((plan) => `${plan.theme}: ${plan.error}`).join("; "),
      failed.map((plan) => plan.theme).join(", "));
    return false;
  }
  const loading = plans.filter((plan) => plan.targets);
  if (loading.length === 0) {
    onComplete(true, "theme_cached");
    return true;
  }
  const pending = createThemePreloadPending(loading, (success, reason) => onComplete(success, reason,
    success ? undefined : pending.themes.filter((entry) => entry.doneAt === undefined).map((entry) => entry.theme).join(", ")));
  const adopted = adoptThemeTerrainWarmup(pending);
  state.themePreload = pending;
  try {
    for (const plan of loading) if (adopted !== plan.theme) spawnThemePreloadPlan(plan, pending);
    message(`streaming ${pending.targets.length} terrain models for ${loading.length} themes in parallel (${pending.theme})`);
    return true;
  } catch (error) {
    fallbackThemePreload(pending.theme, `ForceSpawn failed: ${String(error)}`);
    return false;
  }
}

function markThemePreloaded(theme) {
  state.themePreloaded.add(theme);
  if (theme === "silenthill") state.silentHillDarkReady = true;
}

function processThemePreload(now = Instance.GetGameTime(), pending = state.themePreload) {
  if (!pending || !state.running || state.fatal
    || (pending !== state.themePreload && pending !== state.themeTerrainWarmup?.pending)) return;
  if (now < (pending.nextPollAt ?? 0) && now < pending.deadline) return;
  pending.nextPollAt = now + 0.05;
  for (const target of pending.targets) {
    if (pending.found.has(target)) continue;
    const entity = findThemePreloadEntity(target);
    if (entity) pending.found.set(target, entity);
  }
  for (const entry of pending.themes ?? []) {
    if (entry.doneAt !== undefined || !entry.targets.every((target) => pending.found.has(target))) continue;
    entry.doneAt = now;
    markThemePreloaded(entry.theme);
    message(`theme '${entry.theme}' streamed ${entry.targets.length} models in ${(now - (entry.startedAt ?? pending.startedAt)).toFixed(2)}s`);
  }
  if (pending.found.size === pending.targets.length) {
    cleanupThemePreload(pending);
    if (!pending.themes) markThemePreloaded(pending.theme);
    detachThemePreload(pending);
    if ((pending.themes?.length ?? 0) > 1) {
      message(`all ${pending.themes.length} themes streamed in ${(now - pending.startedAt).toFixed(2)}s`);
    }
    finishThemeTerrainPreload("theme_streamed", pending.onComplete);
    return;
  }
  if (now >= pending.deadline || pending.themes?.some(entry => entry.doneAt === undefined && now >= entry.deadline)) {
    const missing = pending.targets.filter((target) => !pending.found.has(target));
    const incomplete = (pending.themes ?? []).filter((entry) => entry.doneAt === undefined).map((entry) => entry.theme);
    fallbackThemePreload(pending.theme, `stream timeout ${pending.found.size}/${pending.targets.length}`
      + ` after ${(now - pending.startedAt).toFixed(1)}s`
      + (incomplete.length ? `; incomplete themes ${incomplete.join(", ")}` : "")
      + `; missing ${missing.slice(0, 4).join(", ")}`
      + (missing.length > 4 ? ` (+${missing.length - 4} more)` : ""), pending);
  }
}

function resetRoundState({ preserveCampaignOutcome = false } = {}) {
  state.running = false;
  state.roundBootstrapSerial++;
  cancelScheduledTasks();
  if (!entityReleaseByEngine) roundCleanupStep("settleEngineRelease", () => settleEngineRelease());
  const retiringRuntimes = new Set([
    ...state.levels.values(), state.endingRuntime, state.pendingLevel,
    state.currentLevel, state.transitionLevel, state.terrainPreload?.runtime,
  ].filter(Boolean));
  state.debugNextEnding = undefined;
  roundCleanupStep("clearThemeTerrainWarmup", () => clearThemeTerrainWarmup());
  roundCleanupStep("stopDebugThunder", () => stopDebugThunder());
  roundCleanupStep("flushDeferredEntityKills", () => flushDeferredEntityKills());
  roundCleanupStep("terrain preload", () => clearTerrainPreload(true));
  state.itemParticleFxWindows?.clear();
  if (state.adminSlayActive) {
    for (const name of ["spawnkiller", "KILL_ALL_REAL"])
      roundCleanupStep(name, () => fireName(name, "Disable"));
  }
  state.adminSlayActive = false;
  state.flightSlayEnabled = false;
  roundCleanupStep("retireInfiniteCheckout", () => retireInfiniteCheckout());
  roundCleanupStep("clearGenerationWork", () => clearGenerationWork());
  roundCleanupStep("clearSpawnSafetyTriggers", () => clearSpawnSafetyTriggers());
  roundCleanupStep("clearInvincibilityHud", () => clearInvincibilityHud());
  roundCleanupStep("clearSquidBlindHud", () => clearSquidBlindHud());
  roundCleanupStep("clearItemTutorials", () => clearItemTutorials());
  roundCleanupStep("clearZombieItemLocks", () => clearZombieItemLocks());
  roundCleanupStep("preview HUD", () => hideTerrainPreviewHud("round-reset"));
  roundCleanupStep("stage label", () => hideSpawnStageLabel());
  roundCleanupStep("clearSourceAudio", () => clearSourceAudio());
  roundCleanupStep("clearGenericEvents", () => clearGenericEvents());
  roundCleanupStep("clearThemeModelSky", () => clearThemeModelSky());
  roundCleanupStep("resetCollectiveSkybox", () => resetCollectiveSkybox());
  roundCleanupStep("teleport debug", () => DEBUG_HOOKS.clearTeleportTest());
  state.roundBootstrapPending = false;
  state.roundBootstrapWaitLogged = false;
  roundCleanupStep("cleanupThemePreload", () => cleanupThemePreload());
  state.themePreload = undefined;
  state.debugMovementThemeQueue.length = 0;
  state.themeGenerationScheduled = false;
  roundCleanupStep("theme music", () => stopThemeMusic("round_reset"));
  state.themeMusic.enabled = false;
  state.themeMusic.history.length = 0;
  state.themeMusic.missingWarnings.clear();
  state.themeMusic.silenthillDark = false;
  state.themeMusic.infiniteThemeCount = -1;
  state.themeMusic.infiniteThemeTarget = undefined;
  state.themeMusic.infiniteThemePending = undefined;
  state.themeMusic.infiniteThemeResume = false;
  state.silentHillWorld.serial++;
  state.silentHillWorld.visualDark = false;
  state.silentHillWorld.requestedDark = false;
  state.silentHillWorld.visuals.clear();
  state.silentHillWorld.pending.length = 0;
  state.silentHillWorld.active.length = 0;
  state.silentHillWorld.nextDispatchAt = 0;
  state.silentHillWorld.nextActiveAt = 0;
  roundCleanupStep("collective title", () => stopCollectiveTitle("round_reset"));
  roundCleanupStep("ending", () => destroyEndingRuntime(state.endingRuntime, "round_reset"));
  for (const index of [...state.levels.keys()])
    roundCleanupStep(`level ${index}`, () => destroyLevel(index));
  state.levels.clear();
  state.spawnQueue.length = 0;
  state.itemSpawnQueue.length = 0;
  state.trapSpawnQueue.length = 0;
  state.sourceStageCosts.length = 0;
  state.sourceExtraCosts.clear();
  state.scheduledTasks.length = 0;
  for (const id of state.outputConnections.keys())
    roundCleanupStep(`output ${id}`, () => disconnectEntityOutput(id));
  state.outputConnections.clear();
  roundCleanupStep("restorePlayerEffects", () => restorePlayerEffects());
  state.airslidePlayers.clear();
  state.airslideFailsafeQueue.length = 0;
  state.airslideFailsafeCursor = 0;
  state.nextAirslideRefreshAt = 0;
  state.nextAirslideFailsafeAt = Instance.GetGameTime() + 5;
  state.lowgravContacts.clear();
  state.lowgravFailsafeQueue.length = 0;
  state.lowgravFailsafeCursor = 0;
  state.nextLowgravFailsafeAt = Instance.GetGameTime() + 5;
  roundCleanupStep("clearPlayerStatuses", () => clearPlayerStatuses());
  state.playerItems.clear();
  // Owned weapons survive the engine round restart, so always kill these.
  destroyEntities(state.releasedItemCarriers.keys(), true);
  state.releasedItemCarriers.clear();
  state.liquidDamageCooldowns.clear();
  state.teleportEntryFallDamageTokens.clear();
  state.liquidShallowJumpCooldowns.clear();
  state.liquidShallowStreamHistory.clear();
  state.nextLiquidTickAt = 0;
  state.nextTrapTickAt = 0;
  state.nextItemTickAt = 0;
  state.nextKnifePickupTickAt = 0;
  state.pendingDeployableUsePawns.clear();
  state.nextItemId = 1;
  state.nextItemEffectId = 1;
  state.humanItemDesired = 3;
  state.zombieItemDesired = 3;
  state.healOrbSpawnsRemaining = CONFIG.ensureHealOrbSpawns;
  state.planetCrystalShuffle.length = 0;
  state.planetCombo = undefined;
  state.lastEffectTickAt = 0;
  state.running = false;
  state.fatal = false;
  state.infectionActivated = false;
  state.zombieSpawnInvincibilityEnabled = true;
  state.firstInfectionAt = undefined;
  state.motherZombies.clear();
  state.spawnPlatformKilled = false;
  state.spawnPlatformTransitionCount = 0;
  state.spawnPlatformFallScheduled = false;
  state.levelIndex = 0;
  state.lastLevelId = undefined;
  state.currentLevel = undefined;
  state.transitionLevel = undefined;
  state.pendingLevel = undefined;
  state.finaleEscapeActive = false;
  state.finalePostImpostorUntil = 0;
  for (const runtime of retiringRuntimes) {
    runtime.lifecycle = "destroyed";
    for (const task of runtime.tasks ?? []) task.cancelled = true;
    runtime.tasks?.clear();
    destroyEntities(runtime.entities ?? []);
    destroyEntities(runtime.terrainPreloadedEntities ?? []);
    runtime.entities?.clear();
    runtime.terrainPreloadedEntities?.clear();
    runtime.outputConnections?.clear();
    runtime.items?.clear();
    runtime.itemDeployables?.clear();
  }
  destroyEntities(deferredEntityKills);
  deferredEntityKills = [];
  deferredEntityKillCursor = 0;
  destroyEntities(state.terrainPreloadRetiring);
  state.terrainPreloadRetiring.clear();
  destroyEntities(state.roundEntities);
  state.nextRoundEntityPruneAt = 0;
  state.roundEntityPruneIterator = undefined;
  state.endingRuntime = undefined;
  state.themeTerrainWarmup = undefined;
  state.terrainPreload = undefined;
  state.debugTeleportTest = undefined;
  state.spawnSafetyTriggers.clear();
  sourceAudio.live.clear();
  sourceAudio.templates.clear();
  state.genericEvents.active.clear();
  state.genericEvents.bloodlustHits.clear();
  state.genericEvents.cooldown = undefined;
  state.genericEvents.lastEvaluatedLevel = undefined;
  themeModelSky.active = undefined;
  themeModelSky.retiring.length = 0;
  for (const pawn of state.playerEffects.keys())
    roundCleanupStep("restore gravity", () => setPlayerGravity(pawn, 1));
  state.playerEffects.clear();
  for (const pawn of new Set([...state.playerStatuses.keys(), ...state.nativeStatusSpeeds.keys()])) {
    roundCleanupStep("restore speed", () => syncNativeStatusSpeed(pawn));
    roundCleanupStep("restore invincibility", () => syncNativeInvincibleContext(pawn));
  }
  state.playerStatuses.clear();
  state.nativeStatusSpeeds.clear();
  state.campaign.endingOutcomePending = false;
  state.campaign.stageLevelCount = 0;
  if (!preserveCampaignOutcome) {
    state.campaign.phase = "idle";
    state.campaign.endingStarted = false;
    state.campaign.endingContractCalls = 0;
    state.campaign.endingResolved = false;
    state.campaign.endingOutcomePending = false;
    state.campaign.complete = false;
    state.campaign.lastEnding = undefined;
    state.campaign.currentStageSnapshot = createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
  }
  state.nextEndCheckAt = 0;
  state.endLockedUntil = 0;
  state.falldownCheckpointEnabled = true;
  state.nextFalldownCheckpointAt = 0;
  state.falldownCheckpointQueue.length = 0;
  state.falldownCheckpoints.clear();
  state.falldownCheckpointSuppressions.clear();
  state.falldownCheckpointAttackers.clear();
  state.nextBufferSize = CONFIG.firstBufferSize;
  state.lastTriggeredEndIndicator = undefined;
  roundCleanupStep("radar", () => Instance.ServerCommand("sv_disable_radar 0"));
  roundCleanupStep("teleport indicator", () => {
    if (validEntity(state.teleportIndicator)) fireTarget(state.teleportIndicator, "Disable");
  });
  roundCleanupStep("tele_spawninit", () => fireName("tele_spawninit", "Disable"));
  roundCleanupStep("tele_spawn", () => fireName("tele_spawn", "Disable"));
  roundCleanupStep("afk_killer", () => fireName("afk_killer", "Disable"));
}

function beginRound() {
  resetRoundState();
  refreshCheapPlayerModelSwitch();
                                                                             
  setZombieRespawning(true);
  applyPendingAdminSelection();
  const bootstrapSerial = state.roundBootstrapSerial;
  state.roundBootstrapPending = true;
  state.campaign.phase = "active";
  state.campaign.currentStageSnapshot = createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
  if (state.campaign.currentStageSnapshot.infiniteMode) {
    // The original infinite mode draws a fresh opening theme each round.
    const theme = state.debugSilentHillTheme ? "silenthill"
      : GENERATION_THEME_NAMES[infiniteThemeRandomIndex(GENERATION_THEME_NAMES.length, Math.random)];
    state.campaign.currentStageSnapshot = createStageSnapshot(state.campaign.stageIndex, theme);
  }
  initializeGenericEventCooldown(state.campaign.currentStageSnapshot);
  applyCoreServerSettings();
  armAdminPlatformRetirement(bootstrapSerial);
  try {
    validateLevels();
  } catch (error) {
    failRuntime(`level data validation failed: ${error}`);
    return;
  }
  waitForRequiredEntities(bootstrapSerial, Instance.GetGameTime() + REQUIRED_ENTITY_WAIT_TIMEOUT);
}

function waitForRequiredEntities(bootstrapSerial, deadline) {
  if (bootstrapSerial !== state.roundBootstrapSerial || !state.roundBootstrapPending || state.fatal) return;
  cacheEntities(!state.roundBootstrapWaitLogged);
                                                                            
                                                                            
                
  showTerrainPreviewHudStatic("entity-bootstrap");
  const missing = missingRequiredEntities();
  if (missing.length > 0) {
    const now = Instance.GetGameTime();
    if (now >= deadline) {
      failRuntime(`missing required entities after ${REQUIRED_ENTITY_WAIT_TIMEOUT}s: ${missing.join(", ")}`);
      return;
    }
    if (!state.roundBootstrapWaitLogged) {
      state.roundBootstrapWaitLogged = true;
      message(`waiting for ${missing.length} required entities to register: ${missing.join(", ")}`);
    }
    schedule(REQUIRED_ENTITY_RETRY_INTERVAL, () => waitForRequiredEntities(bootstrapSerial, deadline));
    return;
  }
  state.roundBootstrapPending = false;
  prepareTeleportIndicator();

  if (state.campaign.stageIndex === FINALE_STAGE_INDEX && state.campaign.finaleAnchor) {
    const direction = state.campaign.finaleDirection ?? vec(1, 0, 0);
    state.startPoint = Object.freeze({
      name: "finale",
      position: clone(state.campaign.finaleAnchor),
      direction: clone(direction),
    });
  } else {
    state.startPoint = START_POINTS[Math.floor(Math.random() * START_POINTS.length)];
  }
  state.currentDirection = clone(state.startPoint.direction);
  state.nextBridgeStart = clone(state.startPoint.position);
  state.nextEntry = add(
    state.startPoint.position,
    mul(state.currentDirection, CONFIG.firstBufferSize * CONFIG.gridSize),
  );
  state.roundStartedAt = Instance.GetGameTime();
  state.running = true;
  restoreSpawnInfoBoard();
  showSpawnStageLabel();
  fireName("tele_spawninit", "Enable", undefined, 0.1);
  state.debugMovementThemeQueue = (state.debugMovementThemesMode || state.debugAllModelsMode || state.debugStageId === DEBUG_DATA.liquidFallLevel.id)
    ? THEME_PRELOAD_NAMES.filter((name) => name !== state.campaign.currentStageSnapshot.theme)
    : [];
  prepareThemeTerrainAssets(state.campaign.currentStageSnapshot.theme);
  message(`round initialized; first direction ${state.startPoint.name}`);
}

function tileRows(level, mirrored) {
  const rows = [];
  for (let y = 0; y < CONFIG.mapSize; y++) {
    rows.push(level.tiles.slice(y * CONFIG.mapSize, (y + 1) * CONFIG.mapSize));
  }

                                                                          
                                                                          
                                                                        
  for (const row of rows) row.reverse();
  let normalized = rotateRowsCounterClockwise(rows);
  if (mirrored) normalized.reverse();

  return normalized.map((row) => row.map((tile) => transformFloorBlockDirection(tile, mirrored)));
}

function rotateRowsCounterClockwise(rows) {
  const size = rows.length;
  const result = Array.from({ length: size }, () => Array(size));
  for (let y = 0; y < size; y++) {
    for (let x = 0; x < size; x++) result[size - 1 - x][y] = rows[y][x];
  }
  return result;
}

function transformFloorBlockDirection(tile, mirrored) {
  const vectors = {
    186: { x: 0, y: -1 },
    187: { x: 0, y: 1 },
    188: { x: -1, y: 0 },
    189: { x: 1, y: 0 },
  };
  const vector = vectors[tile];
  if (!vector) return tile;

                                                                    
  let x = -vector.x;
  let y = vector.y;
  [x, y] = [y, -x];
                                                                  
  if (mirrored) y = -y;
  if (x === 0 && y === -1) return 186;
  if (x === 0 && y === 1) return 187;
  if (x === -1 && y === 0) return 188;
  return 189;
}

function markerData(rows) {
  const entrance = [];
  const exit = [];
  for (let y = 0; y < CONFIG.mapSize; y++) {
    for (let x = 0; x < CONFIG.mapSize; x++) {
      if (rows[y][x] !== 2) continue;
      (x === 0 ? entrance : exit).push({ x, y });
    }
  }
  if (entrance.length !== 2 || exit.length !== 2) {
    throw new Error(`bad START_END layout (${entrance.length}/${exit.length})`);
  }
  const exitOnValidEdge = exit.every((p) =>
    p.x === CONFIG.mapSize - 1 || p.y === 0 || p.y === CONFIG.mapSize - 1,
  );
  if (!exitOnValidEdge) throw new Error("exit marker is not on a map edge");
  return {
    entrance,
    exit,
    entryCenter: averageGrid(entrance),
    exitCenter: averageGrid(exit),
  };
}

function averageGrid(points) {
  const total = points.reduce((sum, point) => ({ x: sum.x + point.x, y: sum.y + point.y }), { x: 0, y: 0 });
  return { x: total.x / points.length, y: total.y / points.length };
}

function surfaceHeight(tile) {
  if (tile >= 5 && tile <= 24) return tile - 4;
  if (tile >= 25 && tile <= 44) return tile - 24;
  if (tile >= 45 && tile <= 64) return tile - 44;
  if (tile >= 105 && tile <= 124) return tile - 104;
                                                                          
                                                                        
  return undefined;
}

                                                                        
                                                            
function explicitElevation(tile) {
  return surfaceHeight(tile);
}

const SOURCE_CARDINAL_DIRECTIONS = Object.freeze([
  { dx: -1, dy: 0 },
  { dx: 1, dy: 0 },
                                                                      
                                                                 
  { dx: 0, dy: -1 },
  { dx: 0, dy: 1 },
]);

function sourceNeighborElevationPass(rows, x, y, onlyClosest) {
  const elevations = [];
  for (const { dx, dy } of SOURCE_CARDINAL_DIRECTIONS) {
    let currentX = x;
    let currentY = y;
    for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
      const tile = rows[currentY + dy]?.[currentX + dx];
                                                                         
                                                                           
                                                                     
      if (tile === undefined || tile === 0 || tile === 1) break;
      const elevation = explicitElevation(tile);
      if (elevation !== undefined) {
        elevations.push(elevation);
        break;
      }
      if (onlyClosest) break;
      currentX += dx;
      currentY += dy;
    }
  }
  if (!elevations.length) return undefined;
  if (elevations.length <= 2) return Math.min(...elevations);

                                                                          
                                                                    
  const counts = new Map();
  for (const elevation of elevations) counts.set(elevation, (counts.get(elevation) ?? 0) + 1);
  const maxCount = Math.max(...counts.values());
  return Math.min(...[...counts.entries()]
    .filter(([, count]) => count === maxCount)
    .map(([elevation]) => elevation));
}

function sourceNeighborElevation(rows, x, y, fallback = CONFIG.defaultElevation) {
  return sourceNeighborElevationPass(rows, x, y, true)
    ?? sourceNeighborElevationPass(rows, x, y, false)
    ?? fallback;
}

function liquidSurfaceElevation(rows, x, y, fallback = CONFIG.defaultElevation) {
  // Source liquid tiles use GetElevationFromNeighbors(false, "lowest").
  // Look past other liquid/feature cells; waterfalls separate the pools.
  const elevations = [];
  for (const { dx, dy } of SOURCE_CARDINAL_DIRECTIONS) {
    for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
      const tile = rows[y + dy * distance]?.[x + dx * distance];
      if (tile === undefined || tile === 0 || tile === 1 || isWaterfallTile(tile)) break;
      const elevation = explicitElevation(tile);
      if (elevation !== undefined) {
        elevations.push(elevation);
        break;
      }
    }
  }
  return elevations.length ? Math.min(...elevations) : fallback;
}

const SOURCE_TERRAIN_BASES = Object.freeze([4, 24, 44, 104]);

function sourceTerrainFamilyIndex(tile) {
  if (tile >= 5 && tile <= 24) return 0;
  if (tile >= 25 && tile <= 44) return 1;
  if (tile >= 45 && tile <= 64) return 2;
  if (tile >= 105 && tile <= 124) return 3;
  return undefined;
}

function sourceNeighborTerrainData(rows, x, y, fallbackElevation = -50) {
                                                                              
                                                                          
                                                                               
                                                                     
  const centerElevation = sourceNeighborElevation(rows, x, y, CONFIG.defaultElevation);
  const counts = [0, 0, 0, 0];
  const countTile = (tile) => {
    const family = sourceTerrainFamilyIndex(tile);
    if (family === undefined) return false;
    counts[family]++;
    return true;
  };
  for (const { dx, dy } of SOURCE_CARDINAL_DIRECTIONS) {
    countTile(rows[y + dy]?.[x + dx]);
  }
  if (counts.every((count) => count === 0)) {
    for (const { dx, dy } of SOURCE_CARDINAL_DIRECTIONS) {
      let currentX = x;
      let currentY = y;
      for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
        const tile = rows[currentY + dy]?.[currentX + dx];
        if (tile === undefined || tile === 0 || tile === 1) break;
        if (countTile(tile)) break;
        currentX += dx;
        currentY += dy;
      }
    }
  }
  if (counts.every((count) => count === 0)) {
    return {
      validfound: false,
      elevation: fallbackElevation,
      tile: undefined,
      family: undefined,
    };
  }
                                                                           
                                                       
  let winner = 0;
  let winnerCount = 0;
  for (let index = 0; index < counts.length; index++) {
    if (counts[index] >= winnerCount) {
      winner = index;
      winnerCount = counts[index];
    }
  }
  const tile = SOURCE_TERRAIN_BASES[winner] + centerElevation;
  return {
    validfound: true,
    elevation: centerElevation,
    tile,
    family: ["floor", "platform", "floorceiling", "tall"][winner],
  };
}

function sourceDirectionalSurface(rows, x, y, dx, dy) {
  let currentX = x;
  let currentY = y;
  for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
    const tile = rows[currentY + dy]?.[currentX + dx];
    if (tile === undefined || tile === 0 || tile === 1) return undefined;
    const elevation = surfaceHeight(tile);
    if (elevation !== undefined) return { tile, elevation };
    currentX += dx;
    currentY += dy;
  }
  return undefined;
}

function hiddenBridgePlan(rows, x, y) {
  const candidates = [];
  for (const { dx, dy } of SOURCE_CARDINAL_DIRECTIONS) {
    let currentX = x;
    let currentY = y;
    for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
      const neighbor = rows[currentY + dy]?.[currentX + dx];
      if (neighbor === undefined || neighbor === 0 || neighbor === 1 || neighbor === 67 || neighbor === 77) break;
      const surface = sourceDirectionalSurface(rows, currentX, currentY, dx, dy);
      currentX += dx;
      currentY += dy;
      if (surface) {
        candidates.push(surface);
        break;
      }
    }
  }
  if (candidates.length === 0) return { validfound: false };
  const lowest = candidates.reduce((best, candidate) =>
    candidate.elevation < best.elevation ? candidate : best,
  );
  const tallest = candidates.reduce((best, candidate) =>
    candidate.elevation > best.elevation ? candidate : best,
  );
  return {
    validfound: true,
    lowestElevation: lowest.elevation,
    lowestTile: lowest.tile,
    tallestElevation: tallest.elevation,
    tallestTile: tallest.tile,
  };
}

function normalizeHiddenBridgeSupportTile(tile) {
  if (tile >= 45 && tile <= 64) return tile - 40;
  if (tile >= 105 && tile <= 124) return tile - 100;
  return tile;
}

function nearestFloor(rows, startX, startY) {
  const visited = new Set([`${startX},${startY}`]);
  const queue = [{ x: startX, y: startY }];
  while (queue.length > 0) {
    const point = queue.shift();
    if (point.x >= 0 && point.x < CONFIG.mapSize && point.y >= 0 && point.y < CONFIG.mapSize) {
      const tile = rows[point.y][point.x];
      const elevation = surfaceHeight(tile);
      if (elevation !== undefined) return { tile, elevation };
      for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
        const x = point.x + dx;
        const y = point.y + dy;
        const key = `${x},${y}`;
        if (x >= 0 && x < CONFIG.mapSize && y >= 0 && y < CONFIG.mapSize && !visited.has(key)) {
          visited.add(key);
          queue.push({ x, y });
        }
      }
    }
  }
  return { tile: 25 + CONFIG.defaultElevation - 1, elevation: CONFIG.defaultElevation };
}

function entryExitElevations(rows, markers) {
                                                                             
                                                                            
                                                                             
                                                           
  const markerElevation = ({ x, y }, dx, dy) =>
    surfaceHeight(rows[y + dy]?.[x + dx])
    ?? sourceNeighborElevationPass(rows, x, y, true)
    ?? sourceDirectionalSurface(rows, x, y, dx, dy)?.elevation
    ?? sourceNeighborElevationPass(rows, x, y, false)
    ?? CONFIG.defaultElevation;
  const entrance = markers.entrance[0];
  const exit = markers.exit[0];
  const exitInward = exit.x === CONFIG.mapSize - 1
    ? { dx: -1, dy: 0 }
    : exit.y === 0
      ? { dx: 0, dy: 1 }
      : { dx: 0, dy: -1 };
  return {
    entry: markerElevation(entrance, 1, 0),
    exit: markerElevation(exit, exitInward.dx, exitInward.dy),
  };
}

function gridWorld(entry, incoming, entryCenter, x, y, elevation, entryElevation) {
  const forward = incoming;
  const left = leftOf(incoming);
  const longitudinal = (x - entryCenter.x) * CONFIG.gridSize;
  const lateral = (entryCenter.y - y) * CONFIG.gridSize;
  return add(
                                                                          
                                                                            
                                                                             
                                                                     
    add(entry, add(
      mul(forward, longitudinal + CONFIG.gridSize / 2),
      mul(left, lateral),
    )),
    vec(0, 0, (elevation - entryElevation) * CONFIG.elevationStep),
  );
}

function exitDirection(markers, incoming) {
  if (markers.exit.every((p) => p.x === CONFIG.mapSize - 1)) return clone(incoming);
  if (markers.exit.every((p) => p.y === 0)) return leftOf(incoming);
  if (markers.exit.every((p) => p.y === CONFIG.mapSize - 1)) return rightOf(incoming);
  throw new Error("exit markers span multiple edges");
}

function tileFamily(tile, rows, x, y) {
  if (tile >= 5 && tile <= 24) return "floor";
  if (tile >= 25 && tile <= 44) return "platform";
  if (tile >= 45 && tile <= 64) return "floorceiling";
  if (tile >= 105 && tile <= 124) return "tall";
  if (tile === 1) return "wall";
  if (tile === 90) return "detail";
  if (tile === 183 || tile === 184) return "hidden";
  if (tile === 199) return "hiddenwall";
  if (tile === 185 || tile === 9998) return "platform";
  if (tile === 2) return tileFamily(nearestFloor(rows, x, y).tile, rows, x, y) || "platform";
  return undefined;
}

function isFloorFamily(family) {
  return family === "floor" || family === "platform" || family === "floorceiling" || family === "tall";
}

function blockedByFloorMarker(rows, x, y) {
  const neighbor = (dx, dy) => rows[y + dy]?.[x + dx];
  const values = [neighbor(-1, 0), neighbor(1, 0), neighbor(0, -1), neighbor(0, 1)];
  if (values.includes(145)) return true;
  return neighbor(-1, 0) === 189 || neighbor(1, 0) === 188 || neighbor(0, -1) === 187 || neighbor(0, 1) === 186;
}
function surfaceHeightAt(rows, x, y) {
  return surfaceHeight(rows[y]?.[x]);
}

function elevationAt(rows, x, y) {
  return surfaceHeightAt(rows, x, y);
}


                                                                        
                                                                           
                                                                             
const SLOPE_CANDIDATE_DIRECTIONS = Object.freeze([
  { name: "right", dx: 1, dy: 0, localYaw: 180, order: 0 },
  { name: "left", dx: -1, dy: 0, localYaw: 0, order: 1 },
  { name: "up", dx: 0, dy: -1, localYaw: 270, order: 2 },
  { name: "down", dx: 0, dy: 1, localYaw: 90, order: 3 },
]);

function slopeLocalYaw(dx, dy) {
  return SLOPE_CANDIDATE_DIRECTIONS.find((candidate) => candidate.dx === dx && candidate.dy === dy)?.localYaw;
}

function findSlopeCandidates(rows, x, y, height) {
  return SLOPE_CANDIDATE_DIRECTIONS
    .filter(({ dx, dy }) => surfaceHeightAt(rows, x + dx, y + dy) === height + 1)
    .map((candidate) => ({ ...candidate }));
}

function hasAdjacentLadderOrClimb(rows, x, y) {
  return SLOPE_CANDIDATE_DIRECTIONS.some(({ dx, dy }) => {
    const tile = rows[y + dy]?.[x + dx];
    return tile === 3 || tile === 4;
  });
}

function chooseSlopeCandidate(candidates, rows, x, y, height) {
  if (!candidates.length) return undefined;
                                                                             
                                                                     
  const chosen = candidates[Math.floor(Math.random() * candidates.length)];
  return {
    ...chosen,
    fullSlope: !hasAdjacentLadderOrClimb(rows, x, y)
      && surfaceHeightAt(rows, x - chosen.dx, y - chosen.dy) === height - 1,
  };
}

function slopeWorldYaw(localYaw, incoming) {
  return normalizeYaw(yawOf(incoming) + localYaw);
}

function slopeShape(family, rows, x, y, elevation, incoming, fallbackAngles = anglesFor(incoming)) {
  if (!isFloorFamily(family)) return { shape: family, angles: fallbackAngles };
  const candidates = findSlopeCandidates(rows, x, y, elevation);
  const selected = chooseSlopeCandidate(candidates, rows, x, y, elevation);
  if (!selected) return { shape: family, angles: fallbackAngles };
  const worldYaw = slopeWorldYaw(selected.localYaw, incoming);
  return {
    shape: `${family}_${selected.fullSlope ? "slope" : "slopehalf"}`,
    uphill: { dx: selected.dx, dy: selected.dy },
    localYaw: selected.localYaw,
    worldYaw,
    angles: { pitch: 0, yaw: worldYaw, roll: 0 },
  };
}
                                                                        
                                                                         
                                                                      
                                                                     
                                                                             
function racePlatformBridgeElevations(rows, x, y) {
  const neighbors = [
    { dx: -1, dy: 0 },
    { dx: 1, dy: 0 },
    { dx: 0, dy: -1 },
    { dx: 0, dy: 1 },
  ];
  const samples = [];
  for (const { dx, dy } of neighbors) {
                                                                             
                                                                              
                                                                        
                                                              
    let cx = x;
    let cy = y;
    for (let distance = 0; distance <= CONFIG.mapSize; distance++) {
      cx += dx;
      cy += dy;
      const tile = rows[cy]?.[cx];
      if (tile === undefined || tile === 0 || tile === 1 || tile === 67 || tile === 77) break;
      const elevation = explicitElevation(tile);
      if (elevation !== undefined) samples.push({ elevation, tile });
    }
  }
  if (samples.length === 0) return [nearestFloor(rows, x, y).elevation];
  const elevations = [...new Set(samples.map(({ elevation }) => elevation))].sort((a, b) => b - a);
  if (elevations.length === 1) return elevations;
                                                                              
                                                                              
  return [elevations[0], elevations[elevations.length - 1]];
}

function featureKind(tile) {
  if (tile === 3) return "ladder";
  if (tile === 4 || tile === 141) return "climb";
  if (tile >= 125 && tile <= 129) return "boost";
  if (tile === 130 || tile === 140) return "lowgrav";
  if ([131, 133, 136, 138].includes(tile)) return "teleport";
  if ([132, 134, 137, 139].includes(tile)) return "teleportDestination";
  if (tile === 135) return "airslide";
  if (tile === 142 || tile === 143 || tile === 147) return "crouch";
  if (tile === 91) return "breakable";
  if (tile === 95) return "genericHold";
  if ([96, 98, 101, 103, 195, 196, 197, 198].includes(tile)) return "hold";
  if ([97, 99, 102, 104].includes(tile)) return "button";
  if (tile === 100) return "endButton";
  if ((tile >= 65 && tile <= 84) || (tile >= 158 && tile <= 167)) return "liquid";
  if (tile === 92 || (tile >= 148 && tile <= 152)) return "elevator";
  if (tile >= 85 && tile <= 89) return "trap";
  if (tile === 93 || tile === 94) return "item";
  return undefined;
}

function holdGroup(tile) {
  if ([96, 97, 195].includes(tile)) return 1;
  if ([98, 99, 196].includes(tile)) return 2;
  if ([101, 102, 197].includes(tile)) return 3;
  if ([103, 104, 198].includes(tile)) return 4;
  return 0;
}

function teleportGroup(tile) {
  if (tile === 131 || tile === 132) return 1;
  if (tile === 133 || tile === 134) return 2;
  if (tile === 136 || tile === 137) return 3;
  return 4;
}

function localDirection(incoming, localYaw, mirrored) {
  const yaw = normalizeYaw(yawOf(incoming) + (mirrored ? -localYaw : localYaw));
  const radians = yaw * Math.PI / 180;
  return vec(Math.round(Math.cos(radians)) || 0, Math.round(Math.sin(radians)) || 0, 0);
}

function boostDirection(tile, incoming, mirrored) {
  const localYaw = { 126: 180, 127: 0, 128: 90, 129: 270 }[tile];
  return localYaw === undefined ? vec() : localDirection(incoming, localYaw, mirrored);
}

function boostFeatureAngles(tile, incoming, mirrored) {
  if (tile === 125) {
                                                                          
                                                                
    return { pitch: 0, yaw: [0, 90, 180, 270][Math.floor(Math.random() * 4)], roll: 0 };
  }
  return anglesFor(boostDirection(tile, incoming, mirrored));
}

function movePlatformDestinationIndex(tile) {
  if (tile >= 173 && tile <= 182) return tile - 173;
  if (tile >= 190 && tile <= 193) return tile - 180;
  return -1;
}

function isMovePlatformTile(tile) {
  return tile >= 168 && tile <= 170;
}

                                                                              
                                                                            
                                                                         
const WATERFALL_DIRECTION_CANDIDATES = Object.freeze([
                                                                              
                                                                             
                                                                    
                                           
  { dx: -1, dy: 0, localYaw: 180, order: 0 },
  { dx: 1, dy: 0, localYaw: 0, order: 1 },
  { dx: 0, dy: -1, localYaw: 90, order: 2 },
  { dx: 0, dy: 1, localYaw: 270, order: 3 },
]);

function isLiquidTile(tile) {
  return (tile >= 65 && tile <= 84) || (tile >= 158 && tile <= 167);
}

function isWaterfallTile(tile) {
  return tile === 67 || tile === 77;
}

function waterfallSourceElevation(tile) {
  const explicit = surfaceHeight(tile);
  if (explicit !== undefined) return explicit;
                                                                           
                                                                     
  if (tile === 185 || tile === 9998) return CONFIG.defaultElevation;
  return undefined;
}

function waterfallLineElevation(rows, x, y, dx, dy) {
  for (let distance = 1; distance <= CONFIG.mapSize + 1; distance++) {
    const tile = rows[y + dy * distance]?.[x + dx * distance];
    if (tile === undefined || tile === 0 || tile === 1 || isWaterfallTile(tile)) return undefined;
    const elevation = waterfallSourceElevation(tile);
    if (elevation !== undefined) return elevation;
  }
  return undefined;
}

function waterfallNeighborElevation(rows, x, y, fallback = CONFIG.defaultElevation) {
  const samples = [
    [-1, 0], [1, 0], [0, 1], [0, -1],
  ].map(([dx, dy]) => waterfallLineElevation(rows, x, y, dx, dy))
    .filter((value) => value !== undefined);
  return samples.length ? Math.min(...samples) : fallback;
}

function waterfallDirectionPlan(rows, x, y, baseElevation = CONFIG.defaultElevation, incoming = vec(1, 0, 0)) {
                                                                             
                                                                         
                                                             
  const elevation = waterfallNeighborElevation(rows, x, y, baseElevation);
  const currentElevation = Number.isFinite(elevation) ? elevation : baseElevation;
  const topLiquids = [];
  const terrainCandidates = [];
  const sameLevelLiquids = [];
  const nonFallLiquidCandidates = [];
  const allLiquidCandidates = [];
  const wallCandidates = [];
  const bottomCandidates = [];
  let highestTerrain = -50;
  let highestLiquid = -5000;

  for (const candidate of WATERFALL_DIRECTION_CANDIDATES) {
    const neighbor = rows[y + candidate.dy]?.[x + candidate.dx];
    if (neighbor === undefined) continue;
    if (isLiquidTile(neighbor)) {

      if (!isWaterfallTile(neighbor)) {
        const neighborElevation = waterfallNeighborElevation(rows, x + candidate.dx, y + candidate.dy);
        bottomCandidates.push({ tile: neighbor, elevation: neighborElevation });
        if (neighborElevation === currentElevation) sameLevelLiquids.push(candidate);
        if (neighborElevation >= highestLiquid) {
          if (neighborElevation > highestLiquid) topLiquids.length = 0;
          highestLiquid = neighborElevation;
          topLiquids.push(candidate);
        }
        nonFallLiquidCandidates.push(candidate);
      }
                                                                         
                                                   
      allLiquidCandidates.push(candidate);
      continue;
    }
    if (neighbor === 1) {
      wallCandidates.push(candidate);
      continue;
    }
    const neighborElevation = waterfallSourceElevation(neighbor);
    if (neighborElevation !== undefined && neighborElevation >= highestTerrain) {
      if (neighborElevation > highestTerrain) terrainCandidates.length = 0;
      highestTerrain = neighborElevation;
      terrainCandidates.push(candidate);
    }
  }

                                                                            
                                                        
  let candidates = topLiquids;
  let selectedElevation = highestLiquid;
  if (!candidates.length) {
    candidates = terrainCandidates;
    selectedElevation = highestTerrain;
  }
  if (!candidates.length) {
    candidates = sameLevelLiquids;
    selectedElevation = currentElevation;
  }
  if (!candidates.length) {
    candidates = nonFallLiquidCandidates;
    selectedElevation = highestLiquid;
  }
  if (!candidates.length) {
    candidates = wallCandidates;
    selectedElevation = -50;
  }
  if (!candidates.length) {
    candidates = allLiquidCandidates;
    selectedElevation = highestLiquid;
  }

  const chosen = candidates.length
    ? candidates[Math.floor(Math.random() * candidates.length)]
    : undefined;
  const localYaw = chosen?.localYaw ?? 0;
  const worldYaw = normalizeYaw(yawOf(incoming) + localYaw);
  // Source nliquidsbot: the lowest neighbouring non-fall pool below the top
  // one is the waterfall's landing pool. Its floor and water are extended
  // into this cell; with no lower pool the waterfall has no floor at all.
  let bottom;
  for (const candidate of bottomCandidates) {
    if (candidate.elevation < highestLiquid && (!bottom || candidate.elevation < bottom.elevation)) bottom = candidate;
  }
  return {
    localYaw,
    worldYaw,
    elevation: selectedElevation > -10 ? selectedElevation : currentElevation,
    direction: chosen ? { dx: chosen.dx, dy: chosen.dy } : undefined,
    candidateCount: candidates.length,
    bottom,
  };
}

// Source floorpos_ofs: depth of the landing pool's floor below its surface.
function waterfallBottomFloorDepth(tile) {
  if ([66, 76].includes(tile)) return 248;
  if ([65, 75].includes(tile) || (tile >= 158 && tile <= 167)) return 24;
  if ((tile >= 70 && tile <= 74) || (tile >= 80 && tile <= 84)) return 128;
  if ([68, 69, 78, 79].includes(tile)) return 180;
  return 0;
}

// Floor and water that a waterfall cell borrows from its landing pool.
// `base` is the cell's grid position at elevation `baseElevation`.
function waterfallBottomPlan(waterfall, base, baseElevation, incoming, mirrored, theme) {
  const bottom = waterfall?.bottom;
  if (!bottom) return undefined;
  const poolLevel = add(base, vec(0, 0, (bottom.elevation - baseElevation) * CONFIG.elevationStep));
  const liquid = liquidTileData(bottom.tile, incoming, mirrored, theme);
  return {
    floorPosition: add(poolLevel, vec(0, 0, -waterfallBottomFloorDepth(bottom.tile))),
    liquidPosition: add(poolLevel, vec(0, 0, -16)),
    liquid: { ...liquid, drown: false },
  };
}

function liquidStreamOrientation(localYaw, incoming, mirrored, genericStream) {
                                                                              
                                                                      
  const incomingYaw = normalizeYaw(yawOf(incoming));
  const northSouth = Math.abs(incomingYaw) === 90;
  let yaw = localYaw;
  if (mirrored && !genericStream) {
    const leftRight = localYaw === 0 || localYaw === 180;
    if (leftRight === northSouth) yaw += 180;
  }
  yaw += incomingYaw;
  if (mirrored && northSouth) yaw += 180;
                                                                          
                                                                           
                                                                          
  const visualDirection = localDirection(vec(1, 0, 0), yaw + 180, false);
  const pushDirection = localDirection(vec(1, 0, 0), yaw + 360, false);
  return { visualDirection, pushDirection };
}

function liquidTileData(
  tile,
  incoming,
  mirrored,
  theme = "generic",
  rows = undefined,
  x = undefined,
  y = undefined,
  baseElevation = CONFIG.defaultElevation,
) {
  const hazardous = (tile >= 75 && tile <= 84) || (tile >= 163 && tile <= 167);
  const shallow = tile === 65 || tile === 75 || (tile >= 158 && tile <= 167);
  const fall = tile === 67 || tile === 77;
  const tunnel = [68, 69, 78, 79].includes(tile);
  const tunnelWall = tile === 69 || tile === 79;
  const stream = (tile >= 70 && tile <= 74) || (tile >= 80 && tile <= 84) || (tile >= 158 && tile <= 167);
  const genericStream = [70, 80, 158, 163].includes(tile);
  const directionalIndex = tile >= 163 ? tile - 163 : tile >= 158 ? tile - 158 : tile >= 80 ? tile - 80 : tile - 70;
  const localYaw = genericStream ? [0, 90, 180, 270][Math.floor(Math.random() * 4)] : [0, 180, 0, 90, 270][directionalIndex];
  const orientation = stream
    ? liquidStreamOrientation(localYaw, incoming, mirrored, genericStream)
    : { visualDirection: vec(), pushDirection: vec() };
                                                                            
                                                                        
  const streamDirection = orientation.visualDirection;
                                                                            
                                                                             
                                            
  const shallowJump = genericStream && shallow;
  const pushDirection = genericStream && !shallow ? vec(0, 0, -1) : shallowJump ? vec() : orientation.pushDirection;
  const drown = genericStream;
  const waterfall = fall && rows && Number.isInteger(x) && Number.isInteger(y)
    ? waterfallDirectionPlan(rows, x, y, baseElevation, incoming)
    : undefined;
  const triggerDepth = fall ? (hazardous ? 5000 : 0) : 240;
                                                                              
                                                                            
                                                                      
  const body = fall ? 2 : stream ? (genericStream ? 47 : shallow ? 31 : 46) : 31;
                                                                        
                                                                        
  const useStreamModel = stream && (genericStream || !shallow);
  const depth = shallow ? 24 : tunnel ? 180 : stream ? 128 : fall ? CONFIG.elevationStep * 20 : 248;
  const profile = themeProfile(theme);
  const themeShape = fall
    ? "liquid_fall"
    : tunnel
      ? "liquid_tunnel"
      : useStreamModel
        ? "liquid_stream"
        : shallow
          ? "liquid_shallow"
          : "liquid";
  const model = chooseTerrainModel(profile.name, themeShape);
                                                                          
                                                                            
                                                      
  let themedSkin = hazardous ? profile.hazardLiquidSkin : profile.liquidSkin;
  if (fall || stream) themedSkin++;
  if (genericStream && shallow) themedSkin = hazardous ? 12 : 4;
  const fallAngles = waterfall
    ? { pitch: 0, yaw: normalizeYaw(waterfall.worldYaw), roll: 0 }
    : { pitch: 0, yaw: 0, roll: 0 };
                                                                   
                                                                         
                                                                           
                                                                           
                                                                           
  const visualAngles = fall ? fallAngles : stream ? anglesFor(streamDirection)
    : { pitch: 0, yaw: hazardous && profile.name === "nature"
      ? [0, 90, 180, 270][Math.floor(Math.random() * 4)] : 0, roll: 0 };
  return {
    hazardous, shallow, fall, tunnel, tunnelWall, stream, genericStream,
    shallowJump, drown, streamDirection, pushDirection, triggerDepth,
    depth, skin: themedSkin, body, model, themeName: profile.name, themeShape,
    waterfall, visualAngles, fallAngles,
  };
}
function elevatorModel(tile) {
  if (tile === 148) return "models/luffaren/collective_floor.vmdl";
  if (tile === 149) return "models/luffaren/collective_floorceiling.vmdl";
  if (tile === 150) return "models/luffaren/collective_floorceilingtall.vmdl";
  if (tile === 151) return "models/luffaren/collective_elevatorbig.vmdl";
  if (tile === 152) return "models/luffaren/collective_elevatorhuge.vmdl";
  return "models/luffaren/collective_elevator.vmdl";
}

function movePlatformModel(size) {
  if (size === 2) return "models/luffaren/collective_elevatorhuge.vmdl";
  if (size === 1) return "models/luffaren/collective_elevatorbig.vmdl";
  return "models/luffaren/collective_elevator.vmdl";
}

function climbPlacement(rows, x, y, incoming, entry, entryCenter, entryElevation, random = Math.random, worldPosition = gridWorld) {
  const directions = [
    { dx: -1, dy: 0, yaw: 180 }, { dx: 1, dy: 0, yaw: 0 },
                                                                         
                                                                        
                                                           
    { dx: 0, dy: -1, yaw: 90 }, { dx: 0, dy: 1, yaw: 270 },
  ].map((candidate) => ({
    ...candidate,
    worldYaw: normalizeYaw(yawOf(incoming) + candidate.yaw),
    tile: rows[y + candidate.dy]?.[x + candidate.dx],
    elevation: elevationAt(rows, x + candidate.dx, y + candidate.dy),
  }));
                                                                         
                                                                            
  const worldOrder = [180, 0, 90, 270];
  directions.sort((a, b) => worldOrder.indexOf((a.worldYaw + 360) % 360)
    - worldOrder.indexOf((b.worldYaw + 360) % 360));
  const baseline = sourceNeighborElevation(rows, x, y);
  let low = baseline;
  let high = baseline;
  let facing = [];
  for (const candidate of directions) {
    if (candidate.elevation === undefined) continue;
                                                                          
                                                                            
                                                                         
    if (candidate.elevation < baseline) low = candidate.elevation;
    else if (candidate.elevation >= high) {
      if (candidate.elevation > high) facing = [];
      facing.push(candidate.worldYaw);
      high = candidate.elevation;
    }
  }
  const differingElevations = high !== low;
  const floorOnly = differingElevations && high <= low + 2;
  const spawnBaseFloor = floorOnly || (facing.length > 0 && differingElevations);
  if (floorOnly) facing = [];
                                                                           
                                                                        
  if (!spawnBaseFloor && facing.length === 0) {
    high = 20;
    facing = directions.filter(candidate => candidate.tile === 1).map(candidate => candidate.worldYaw);
  }
  if (facing.length === 0) facing = [0, 90, 180, 270];
  const ledgeYaw = normalizeYaw(facing[Math.floor(random() * facing.length)]);
                                                                           
                                                                            
                                                                             
  const neighboringFloor = sourceNeighborTerrainData(rows, x, y);
  const baseFamily = neighboringFloor.family === "floor" ? "floor" : "platform";
  const baseTile = (baseFamily === "floor" ? 4 : 24) + baseline;
  return {
    floorPosition: worldPosition(entry, incoming, entryCenter, x, y, low, entryElevation),
                                                                            
                                                                            
    position: add(worldPosition(entry, incoming, entryCenter, x, y, high - 20, entryElevation), vec(0, 0, 1)),
                                                                        
                                                                        
                                                                        
    angles: { pitch: 0, yaw: normalizeYaw(ledgeYaw - 90), roll: 0 },
    surfaceAngles: { pitch: 0, yaw: ledgeYaw, roll: 0 },
    low,
    high,
    baseFamily,
    baseTile,
    spawnBaseFloor,
    floorOnly,
  };
}

function gridPosition(rows, x, y, entry, incoming, entryCenter, entryElevation, zOffset = 0) {
  const elevation = nearestFloor(rows, x, y).elevation;
  return add(gridWorld(entry, incoming, entryCenter, x, y, elevation, entryElevation), vec(0, 0, zOffset));
}

function elevatorPlan(rows, x, y, entry, incoming, entryCenter, entryElevation) {
  const directions = [
    { dx: -1, dy: 0 }, { dx: 1, dy: 0 }, { dx: 0, dy: -1 }, { dx: 0, dy: 1 },
  ];
  const adjacent = directions.map(({ dx, dy }) => elevationAt(rows, x + dx, y + dy)).filter((value) => value !== undefined);
  const low = adjacent.length ? Math.min(...adjacent) : 1;
  const high = adjacent.length ? Math.max(...adjacent) : 20;
  const start = add(gridWorld(entry, incoming, entryCenter, x, y, low, entryElevation), vec(0, 0, 1));
  if (adjacent.length === 0) {
                                                                         
                                                                            
    return { position: start, destination: add(start, vec(0, 0, 19 * CONFIG.elevationStep)),
      angles: anglesFor(incoming), horizontal: false, fallback: true };
  }
  if (adjacent.length > 0 && high > low) {
    const neighbor = sourceNeighborTerrainData(rows, x, y);
                                                                     
                                                                      
                                                                            
    const supportShape = neighbor.family === "floor" ? "floor" : "platform";
    return {
      position: start,
      destination: add(start, vec(0, 0, (high - low) * CONFIG.elevationStep)),
      angles: anglesFor(incoming),
      horizontal: false,
      fallback: false,
      support: {
        shape: supportShape,
        position: sub(start, vec(0, 0, 2)),
        sourceTile: (supportShape === "floor" ? 4 : 24) + sourceNeighborElevation(rows, x, y),
      },
    };
  }

  const horizontal = [];
  for (const direction of directions) {
                                                                          
                                                                       
                                                                        
                                         
    const immediateTile = rows[y + direction.dy]?.[x + direction.dx];
    if (immediateTile === undefined || immediateTile === 1) continue;
    if (explicitElevation(immediateTile) !== undefined) continue;
    for (let step = 2; step < CONFIG.mapSize; step++) {
      const tx = x + direction.dx * step;
      const ty = y + direction.dy * step;
      const tile = rows[ty]?.[tx];
      if (tile === undefined || tile === 1) break;
      const elevation = explicitElevation(tile);
      if (elevation === undefined) continue;
      if (elevation === low) {
        horizontal.push({ step, tx, ty, dx: direction.dx, dy: direction.dy });
        break;
      }
      break;
    }
  }
  if (horizontal.length > 0) {
    const shortest = Math.min(...horizontal.map(({ step }) => step));
    const choices = horizontal.filter(({ step }) => step === shortest);
    const choice = choices[Math.floor(Math.random() * choices.length)];
                                                                         
                                                                      
                      
    const stopX = x + choice.dx * (choice.step - 1);
    const stopY = y + choice.dy * (choice.step - 1);
    const destination = add(gridWorld(entry, incoming, entryCenter, stopX, stopY, low, entryElevation), vec(0, 0, 1));
    return {
      position: start,
      destination,
      angles: anglesFor(sub(destination, start)),
      horizontal: true,
      fallback: true,
    };
  }

  const fallbackLow = 1;
                                                                        
                                                                      
  const fallbackHigh = low <= 2 ? 20 : low;
  const fallbackStart = add(gridWorld(entry, incoming, entryCenter, x, y, fallbackLow, entryElevation), vec(0, 0, 1));
  return {
    position: fallbackStart,
    destination: add(fallbackStart, vec(0, 0, (fallbackHigh - fallbackLow) * CONFIG.elevationStep)),
    angles: anglesFor(incoming),
    horizontal: false,
    fallback: true,
  };
}

function enqueueLevelWideMovers(runtime, rows, entry, incoming, entryCenter, entryElevation) {
  const destinations = Array.from({ length: 14 }, () => undefined);
  let moveSpeed = CONFIG.movePlatformSpeed;
  let hazardBottom;
  let hazardTop;
  let hazardSpeed = CONFIG.hazardPlaneSpeed;
  let hazardHarsh = false;

  for (let y = 0; y < CONFIG.mapSize; y++) {
    for (let x = 0; x < CONFIG.mapSize; x++) {
      const tile = rows[y][x];
      const destinationIndex = movePlatformDestinationIndex(tile);
      if (destinationIndex >= 0) {
        destinations[destinationIndex] ??= { positions: [], sizes: [] };
        destinations[destinationIndex].positions.push(gridPosition(rows, x, y, entry, incoming, entryCenter, entryElevation, 2));
      } else if (tile === 171) moveSpeed = CONFIG.movePlatformSlowSpeed;
      else if (tile === 172) moveSpeed = CONFIG.movePlatformFastSpeed;
      else if (tile === 153) hazardBottom = nearestFloor(rows, x, y).elevation;
      else if (tile === 154) hazardTop = nearestFloor(rows, x, y).elevation;
      else if (tile === 155) hazardSpeed = CONFIG.hazardPlaneSlowSpeed;
      else if (tile === 156) hazardSpeed = CONFIG.hazardPlaneFastSpeed;
      else if (tile === 157) hazardHarsh = true;
    }
  }

  for (let y = 0; y < CONFIG.mapSize; y++) {
    for (let x = 0; x < CONFIG.mapSize; x++) {
      const tile = rows[y][x];
      if (!isMovePlatformTile(tile)) continue;
      const adjacent = [[-1, 0], [1, 0], [0, -1], [0, 1]]
        .map(([dx, dy]) => movePlatformDestinationIndex(rows[y + dy]?.[x + dx]))
        .filter((value) => value >= 0);
      if (adjacent.length === 0) continue;
      const destination = destinations[adjacent[Math.floor(Math.random() * adjacent.length)]];
      if (destination) destination.sizes.push(tile - 168);
    }
  }

  const paths = [];
  let path = [];
  for (const destination of [...destinations, undefined]) {
    if (destination) path.push(destination);
    else if (path.length > 0) {
      paths.push(path);
      path = [];
    }
  }
  for (const moverPath of paths) {
    for (let pathIndex = 0; pathIndex < moverPath.length; pathIndex++) {
      const destination = moverPath[pathIndex];
      if (destination.sizes.length === 0 || destination.positions.length === 0) continue;
      const size = destination.sizes.includes(0) ? 0 : destination.sizes.includes(1) ? 1 : 2;
      const position = destination.positions[Math.floor(Math.random() * destination.positions.length)];
      enqueueFeature(runtime, "movePlatform", position, anglesFor(incoming), { moverPath, pathIndex, speed: moveSpeed, size });
    }
  }

  if (hazardBottom !== undefined && hazardTop !== undefined) {
    if (hazardBottom > hazardTop) [hazardBottom, hazardTop] = [hazardTop, hazardBottom];
    const position = add(gridWorld(entry, incoming, entryCenter, 9.5, 9.5, hazardBottom, entryElevation), vec(0, 0, -CONFIG.hazardPlaneLip));
    const destination = add(position, vec(0, 0, (hazardTop - hazardBottom) * CONFIG.elevationStep));
    enqueueFeature(runtime, "hazardPlane", position, anglesFor(incoming), { destination, speed: hazardSpeed, harsh: hazardHarsh });
  }
}

function featureThemeShape(feature, data = {}) {
  if (feature === "ladder") return "ladder";
  if (feature === "climb") return data.tile === 4 ? "climbhard" : "climb";
  if (feature === "crouch") return data.tile === 143 ? "crouchtall" : "crouch";
  if (feature === "breakable") return "breakable";
  if (feature === "genericHold") return "generic_hold";
  if (feature === "endButton" || feature === "button") return "button";
  if (feature === "hold") return "hold";
  if (feature === "boost") return "boost";
  if (["teleport", "teleportDestination"].includes(feature)) return "teleport";
  if (feature === "lowgrav") return "lowgrav";
  if (feature === "airslide") return "airslide";
  if (feature === "trap" && data.tile === 85) return "trapfloor";
  if (feature === "elevator") {
    if (data.tile === 148) return "floor";
    if (data.tile === 149) return "floorceiling";
    if (data.tile === 150) return "tall";
    if (data.tile === 151) return "race_surface";
    if (data.tile === 152) return "elevatorhuge";
    return "elevator";
  }
  if (feature === "movePlatform") {
    if (data.size === 2) return "elevatorhuge";
    if (data.size === 1) return "race_surface";
    return "elevator";
  }
  return undefined;
}

function enqueueFeature(runtime, feature, position, angles, data = {}) {
  const profile = data.themeName
    ? themeProfile(data.themeName)
    : runtime?.kind === "FINALE" && runtime.finaleThemeRandom
      ? themeProfile(chooseFinaleThemeName(runtime))
      : themeProfile(runtime.themeSnapshot ?? runtime.stageSnapshot?.theme);
  const themeName = profile.name;
  const themeShape = featureThemeShape(feature, data);
  const themeModel = themeShape ? chooseTerrainModel(themeName, themeShape) : undefined;
  const themeSkin = feature === "lowgrav"
    ? profile.lowgravSkin
    : feature === "airslide"
      ? profile.airslideSkin
      : feature === "hazardPlane"
        ? profile.hazardLiquidSkin
      : undefined;
  const interactionId = ["button", "genericHold", "endButton"].includes(feature)
    ? registerBlockInteraction(runtime, { feature, position, ...data }).id
    : undefined;
  const postSpawn = data.postSpawn === true || Array.isArray(runtime.postSpawnFeatures)
    && ((feature === "item" && !data.debugItem && !data.endingItem && !data.zombieSpawn)
      || (feature === "trap" && data.tile >= 86 && data.tile <= 89 && !data.debugTrap));
  (runtime.preloadRequests ?? state.spawnQueue).push({
    levelIndex: runtime.index, kind: "feature", feature, position, angles, ...data,
    themeName, themeShape, themeModel, themeSkin, interactionId, postSpawn,
    renderColor: data.renderColor ?? featureRenderColor(feature, data.tile, themeName),
  });
  runtime.remaining++;
}









function resolveGenerationTile(tile, random = Math.random) {
  if (tile !== 144) return tile;
                                                                      
                                                                            
                                                                       
  const maximum = Object.keys(TILE_REGISTRY).length - 3;
  const sample = Math.max(0, Math.min(0.9999999999999999, Number(random()) || 0));
  const index = Math.floor(sample * (maximum + 1));
  if (index === 2 || index === 100 || index === 144 || index === 145
    || (index >= 151 && index <= 157)
    || (index >= 168 && index <= 182)
    || (index >= 186 && index <= 194)) return 9998;
  return index;
}

function sourcePixelProcessingOrder(size = CONFIG.mapSize, random = Math.random, rows) {
  const queue = [];
                                                                              
                                                                           
                                                                           
  for (let y = 0; y < size; y++) {
    for (let x = 0; x < size; x++) {
                                                                        
                                                                             
                                                    
      const task = rows ? { x, y, tile: resolveGenerationTile(rows[y][x], random) } : { x, y };
      const sample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
      const index = queue.length ? Math.floor(sample * queue.length) : 0;
      queue.splice(index, 0, task);
    }
  }
  return queue;
}

function buildLevel(level, mirrored, index, entry, incoming, bridgeStart, bufferSize, stageSnapshot,
  deferPlanning = state.deferTerrainPlanning === true) {
  const rows = tileRows(level, mirrored);
  const markers = markerData(rows);
  const elevations = entryExitElevations(rows, markers);
  const outgoing = exitDirection(markers, incoming);
  const immutableStage = stageSnapshot ?? campaignStageSnapshot();
                                                                          
                                                                             
                                                                            
                                                                   
  const exitPosition = add(
    gridWorld(
      entry,
      incoming,
      markers.entryCenter,
      markers.exitCenter.x,
      markers.exitCenter.y,
      elevations.exit,
      elevations.entry,
    ),
    mul(outgoing, CONFIG.gridSize / 2),
  );
                                                                          
                                                                         
                                                                  
  const gridCorners = [0, CONFIG.mapSize - 1].flatMap(x =>
    [0, CONFIG.mapSize - 1].map(y =>
      gridWorld(entry, incoming, markers.entryCenter, x, y, 0, elevations.entry)));
  const sourceGenerationOrigin = vec(
    Math.min(...gridCorners.map(point => point.x)) - CONFIG.gridSize / 2,
    Math.min(...gridCorners.map(point => point.y)) - CONFIG.gridSize / 2,
    gridCorners[0].z,
  );
  const runtime = {
    index,
    id: level.id,
    name: level.name,
    author: level.author,
    debugSpiders: level.debugSpiders === true,
    debugTeleport: level.debugTeleport === true,
    debugLiquidFall: level.debugLiquidFall === true,
    debugKarts: level.debugKarts === true,
    debugLiquidFallSamples: level.debugLiquidFall ? new Map() : undefined,
    stageSnapshot: immutableStage,
    stageConfigSnapshot: immutableStage,
    themeSnapshot: immutableStage.themeProfile,
    stage: immutableStage.stage,
    stageLevel: state.campaign.stageLevelCount + 1,
    lifecycle: "queued",
    lifecycleHistory: ["queued"],
    interactionsRetired: false,
    fadeStartedAt: undefined,
    mirrored,
    incoming: clone(incoming),
    outgoing,
    entry: clone(entry),
    sourceGenerationOrigin,
    sourceAreaBounds: sourceAreaBounds(entry, incoming, markers.entryCenter, elevations.entry),
                                                                        
    spawnSafetyReturn: spawnSafetyReturnFor(index),
    end: exitPosition,
    center: mul(add(entry, exitPosition), 0.5),
    tp: add(sub(entry, mul(incoming, (bufferSize - 0.5) * CONFIG.gridSize)), vec(0, 0, 8)),
    entities: new Set(),
    terrainEntities: new Set(),
    safeTerrainEntities: new Set(),
    outputConnections: new Set(),
    buttons: new Set(),
    breakables: new Set(),
    holds: new Map([[1, []], [2, []], [3, []], [4, []]]),
    teleportDestinations: new Map([[1, []], [2, []], [3, []], [4, []]]),
    teleportSources: new Set(),
    teleportEntries: new Set(),
    liquids: new Set(),
    liquidPawns: new Set(),
    movers: new Set(),
    traps: new Set(),
    trapCost: 0,
    items: new Set(),
    postSpawnFeatures: [],
    sourceItemTileCounts: { human: 0, zombie: 0 },
    sourceStageCost: Number(level.cost ?? level.computedCost) || 0,
    itemDeployables: new Set(),
    healOrbQueued: false,
    endProvider: level.tiles.includes(100) ? "button" : "position",
    endIndicator: undefined,
    endIndicatorState: "pending",
                                                                          
                                                                          
    previewRows: rows.map((row) => row.slice()),
    completed: false,
    remaining: 0,
  };

  if (level.debugTraps) message(`[TRAP DEBUG] ${level.debugTrapSummary}`);
  if (level.debugShowcase) message("[FLOOR DEBUG] two 3x2 patches: tile 85 grenade-contact collapse (armed after 5s), tile 91 brown damage-count breakables");

  // A speculative level plans into its own queue until the handoff adopts it.
  const planningQueue = () => runtime.preloadRequests ?? state.spawnQueue;
  function* planPixels() {
  for (const pixel of sourcePixelProcessingOrder(CONFIG.mapSize, Math.random, rows)) {
    const { x, y } = pixel;
    let tile = pixel.tile;
    if (state.finaleEscapeActive) {
      const flags = state.endingRuntime?.escape?.flags;
      if (tile === 91 || (tile >= 95 && tile <= 104) || (tile >= 195 && tile <= 198)
        || tile === 93 || tile === 94 || (tile >= 85 && tile <= 89 && flags?.trapsDisabled !== false)) tile = 9998;
      else if (tile === 4) tile = 3;
      else if (tile === 70) tile = 66;
      else if (tile === 80) tile = 76;
    }
    const pixelStart = planningQueue().length;
    try {
      if (tile === 93) runtime.sourceItemTileCounts.human++;
      if (tile === 94) runtime.sourceItemTileCounts.zombie++;
      const debugThemeName = level.debugMovementThemes || level.debugLiquidFall ? level.debugThemeRows[y] : undefined;
      if (isColorTile(tile)) {
                                                                             
                                                                             
                                                                           
        const colorElevation = sourceNeighborElevation(rows, x, y);
        const colorAngles = { pitch: 0, yaw: [0, 90, 180, 270][Math.floor(Math.random() * 4)], roll: 0 };
        enqueueSpawn(
          runtime,
          "floor",
          gridWorld(entry, incoming, markers.entryCenter, x, y, colorElevation, elevations.entry),
          colorAngles,
          "color",
          { terrainModel: COLOR_TILE_MODEL, renderColor: colorToEntityColor(tile.color), colorTile: true },
        );
        continue;
      }
      const feature = featureKind(tile);
      if (feature) {
        const nearest = nearestFloor(rows, x, y);
                                                                      
                                                                             
                                                                               
                                              
        const elevation = sourceNeighborElevation(rows, x, y);
        const position = gridWorld(entry, incoming, markers.entryCenter, x, y, elevation, elevations.entry);
        if (feature !== "airslide" && feature !== "lowgrav"
          && !["ladder", "climb", "liquid", "elevator"].includes(feature)
          && !(feature === "trap" && tile === 85) && tile !== 147) {
          // Source GetNeighboringFloorData: majority family of the four neighbours at the
          // neighbour elevation (platform when none); its index also drives the GENERIC tint.
          const baseTerrain = sourceNeighborTerrainData(rows, x, y);
          const baseShape = baseTerrain.family ?? "platform";
          const baseTile = baseTerrain.tile ?? SOURCE_TERRAIN_BASES[1] + elevation;
          enqueueSpawn(
            runtime,
            baseShape,
            position,
            anglesFor(incoming),
            feature === "trap" ? "trapfloor" : baseShape,
            { sourceTile: baseTile, themeName: debugThemeName },
          );
        }
        if (feature === "ladder" || feature === "climb") {
          const placement = climbPlacement(rows, x, y, incoming, entry, markers.entryCenter, elevations.entry);
          if (placement.spawnBaseFloor) {
            enqueueSpawn(
              runtime,
              placement.baseFamily,
              placement.floorPosition,
              anglesFor(incoming),
              placement.baseFamily,
              { sourceTile: placement.baseTile, themeName: debugThemeName },
            );
          }
          if (placement.floorOnly) continue;
          enqueueFeature(runtime, feature, placement.position, placement.angles, {
            tile, surfaceAngles: placement.surfaceAngles, themeName: debugThemeName,
            height: 20 * CONFIG.elevationStep,
          });
          continue;
        }
        if (feature === "liquid") {
          const liquid = liquidTileData(tile, incoming, mirrored, runtime.themeSnapshot, rows, x, y, elevation);
                                                                        
                                                                       
                                                                 
          const surfaceElevation = liquid.fall ? (Number.isFinite(liquid.waterfall?.elevation) ? liquid.waterfall.elevation : elevation)
            : liquidSurfaceElevation(rows, x, y);
          const liquidPosition = add(position, vec(0, 0, (surfaceElevation - elevation) * CONFIG.elevationStep));
          const surface = add(liquidPosition, vec(0, 0, -8));
                                                                        
                                                                           
                                                                            
                                                    
          const fallBottom = liquid.fall
            ? waterfallBottomPlan(liquid.waterfall, position, elevation, incoming, mirrored, runtime.themeSnapshot)
            : undefined;
          if (fallBottom) {
            enqueueSpawn(
              runtime,
              "floor",
              fallBottom.floorPosition,
              anglesFor(incoming),
              "floor",
              { sourceTile: 5 },
            );
            enqueueFeature(runtime, feature, fallBottom.liquidPosition, fallBottom.liquid.visualAngles,
              { tile: liquid.waterfall.bottom.tile, mirrored, ...fallBottom.liquid });
          }
          if (liquid.tunnelWall) {
            enqueueSpawn(
              runtime,
              "platform",
              add(surface, vec(0, 0, 8)),
              anglesFor(incoming),
              "tunnelwall_block",
            );
          }
                                                                          
                                                                             
          const liquidAngles = liquid.visualAngles;
          enqueueFeature(runtime, feature, surface, liquidAngles, { tile, mirrored, ...liquid });
          continue;
        }
        if (feature === "elevator") {
          const plan = elevatorPlan(rows, x, y, entry, incoming, markers.entryCenter, elevations.entry);
          if (plan.support) {
            const { shape, position: supportPosition, sourceTile } = plan.support;
                                                                            
                                                                           
            const terrainModel = terrainModelsFor(debugThemeName ?? immutableStage.theme, shape)[0];
            enqueueSpawn(runtime, shape, supportPosition, anglesFor(incoming), shape,
              { sourceTile, terrainModel, themeName: debugThemeName });
          }
          enqueueFeature(runtime, feature, plan.position, plan.angles, {
            tile, mirrored, destination: plan.destination, horizontal: plan.horizontal,
            fallback: plan.fallback, model: elevatorModel(tile),
          });
          continue;
        }
        const data = { tile, mirrored, group: holdGroup(tile) || teleportGroup(tile), themeName: debugThemeName };
        if (level.debugShowcase && tile === 85) {
                                                                           
                                                                          
          data.debugTrap = true;
          data.debugTrapPixel = true;
        }
        const debugTrapAssignment = level.debugTraps
          ? level.debugTrapAssignments?.[y * CONFIG.mapSize + x]
          : undefined;
        if (debugTrapAssignment) Object.assign(data, debugTrapAssignment);
        // The spider-only lab remains deterministic after row normalization
        // and mirroring; its trap pixels all select the same named NPC.
        if (level.debugSpiders && tile === 88) Object.assign(data,
          { trapName: "thigh_spider", debugTrap: true, debugTrapPixel: true });
        if (feature === "lowgrav") {
                                                                            
                                                                          
                                                                         
          data.triggerPosition = vec(position.x, position.y, runtime.sourceGenerationOrigin.z - 60);
          if (tile === 140) {
                                                                            
                                                                            
            const floorTile = Math.max(5, Math.min(24, 4 + elevation));
            enqueueSpawn(runtime, "floor", position, anglesFor(incoming), "floor", {
              sourceTile: floorTile, themeName: debugThemeName,
              renderColor: (debugThemeName ?? immutableStage.theme) === "generic"
                ? { r: 77, g: 68, b: 234, a: 255 } : undefined,
            });
          }
        }
        if (feature === "item") {
          data.team = tile === 93 ? 3 : 2;
                                                                             
                                                                           
                                                                                
          data.itemGroundAnchored = true;
          if (level.debugShowcase && tile === 93) {
            data.itemName = "heal_orb";
            data.debugItem = true;
            data.debugShowcase = true;
          }
        }
        if (feature === "teleportDestination") runtime.teleportDestinations.get(data.group).push(add(position, vec(0, 0, 8)));
        if (feature === "teleport") runtime.teleportSources.add(data.group);
        const featureAngles = feature === "boost"
          ? boostFeatureAngles(tile, incoming, mirrored)
          : anglesFor(incoming);
        enqueueFeature(runtime, feature, position, featureAngles, data);
        continue;
      }
      const markerTerrain = tile === 2 ? sourceNeighborTerrainData(rows, x, y) : undefined;
      const assumedTerrain = tile === 9998 ? sourceNeighborTerrainData(rows, x, y) : undefined;
      const family = markerTerrain ? (markerTerrain.family ?? "platform")
        : assumedTerrain ? (assumedTerrain.family ?? "platform") : tileFamily(tile, rows, x, y);
      if (!family) continue;
                                                                             
                                                                              
      if (tile !== 2 && tile !== 9998 && isFloorFamily(family) && blockedByFloorMarker(rows, x, y)) continue;

      const nearest = nearestFloor(rows, x, y);
      const hiddenWallData = family === "hiddenwall"
        ? sourceNeighborTerrainData(rows, x, y)
        : undefined;
                                                                           
                                                                          
                                                                
      const detailFloorData = family === "detail"
        ? sourceNeighborTerrainData(rows, x, y, CONFIG.defaultElevation)
        : undefined;
      let elevation = tile === 2
        ? (x === 0 ? elevations.entry : elevations.exit)
        : assumedTerrain ? sourceNeighborElevation(rows, x, y)
        : explicitElevation(tile)
        ?? (family === "hiddenwall" || family === "hidden" || family === "detail"
          ? sourceNeighborElevation(rows, x, y)
          : nearest.elevation);
      let shape = family;
      const randomYaw = [0, 90, 180, 270][Math.floor(Math.random() * 4)];
      let angles = { pitch: 0, yaw: randomYaw, roll: 0 };
      let supportTile;
      let supportFamily;
      if (family === "wall") {
        elevation += 30;
      } else if (family === "hiddenwall") {
        if (hiddenWallData.validfound) {
          elevation = hiddenWallData.elevation;
          supportTile = hiddenWallData.tile;
          supportFamily = hiddenWallData.family;
          enqueueSpawn(
            runtime,
            supportFamily,
            gridWorld(entry, incoming, markers.entryCenter, x, y, elevation, elevations.entry),
            angles,
            supportFamily,
            { sourceTile: supportTile },
          );
        } else {
                                                                             
                                                                  
          elevation -= 40;
        }
      } else if (tile === 184) {
        const bridge = hiddenBridgePlan(rows, x, y);
        if (bridge.validfound) {
          if (bridge.tallestElevation !== bridge.lowestElevation) {
            enqueueSpawn(
              runtime,
              "hidden",
              gridWorld(entry, incoming, markers.entryCenter, x, y, bridge.tallestElevation, elevations.entry),
              angles,
              "hidden",
              { sourceTile: 184 },
            );
          }
          supportTile = normalizeHiddenBridgeSupportTile(bridge.lowestTile);
          supportFamily = tileFamily(supportTile, rows, x, y) || "platform";
          elevation = bridge.lowestElevation;
          shape = supportFamily;
        }
      } else if (isFloorFamily(family) && explicitElevation(tile) !== undefined) {
        const slope = slopeShape(family, rows, x, y, elevation, incoming, angles);
        shape = slope.shape;
        angles = slope.angles;
      }
      if (!state.templates.has(shape)) throw new Error(`missing terrain shape '${shape}'`);
      const themeShape = tile === 185
        ? "platform_bridge"
        : tile === 9998
          ? family
          : shape;
      enqueueSpawn(
        runtime,
        shape,
        gridWorld(entry, incoming, markers.entryCenter, x, y, elevation, elevations.entry),
        angles,
        themeShape,
        { sourceTile: supportTile ?? tile, themeName: debugThemeName },
      );
      if (detailFloorData) {
                                                                           
                                                                             
                                                                            
                                      
        const supportShape = detailFloorData.family ?? "platform";
        enqueueSpawn(
          runtime,
          supportShape,
          gridWorld(entry, incoming, markers.entryCenter, x, y, elevation, elevations.entry),
          angles,
          supportShape,
          { sourceTile: 90, themeName: debugThemeName },
        );
      }
    } finally {
                                                                           
                                                                           
                                                                         
      for (let n = pixelStart; n < planningQueue().length; n++) {
        planningQueue()[n].generationPixel = `pixel:${x},${y}`;
        planningQueue()[n].generationGroup = featureKind(tile) === "boost"
          ? `pixel:${x},${y}:boost` : `pixel:${x},${y}:task:${n - pixelStart}`;
      }
      runtime.plannedPixels = (runtime.plannedPixels ?? 0) + 1;
      yield;
    }
  }
                                                                            
                                                                               
                                                                        
                                                                          
  const step2QueueStart = planningQueue().length;
  if (!state.finaleEscapeActive) enqueueLevelWideMovers(runtime, rows, entry, incoming, markers.entryCenter, elevations.entry);
  enqueueBridge(runtime, bridgeStart, entry, incoming, bufferSize);
  const step2Requests = planningQueue().splice(step2QueueStart);
  for (const request of step2Requests) request.generationGroup = "step2";
                                                                          
                                                                             
  const firstPixelIndex = planningQueue().findIndex(request => request.levelIndex === runtime.index);
  const pixelQueueStart = firstPixelIndex < 0 ? planningQueue().length : firstPixelIndex;
  planningQueue().splice(pixelQueueStart, 0, ...step2Requests);
                                                                          
                                                                           
                                                                       
  const firstStep2Request = planningQueue()[pixelQueueStart];
  if (level.debugShowcase) DEBUG_HOOKS.enqueueShowcaseGalleries(runtime);
  if (level.debugAllModels) DEBUG_HOOKS.enqueueAllModelsGallery(runtime, markers, elevations);
  if (level.debugLiquidFall) DEBUG_HOOKS.enqueueLiquidFallGallery(runtime, markers, elevations);
  if (level.debugKarts) DEBUG_HOOKS.enqueueKarts(runtime, markers, elevations);
  const debugOnlyLevel = level.debugShowcase || level.debugGravity || level.debugMovementThemes || level.debugAllModels || level.debugTraps || level.debugTeleport || level.debugLiquidFall || level.debugKarts;
  runtime.genericEventEligible = !debugOnlyLevel && !state.finaleEscapeActive;
  if (runtime.genericEventEligible && firstStep2Request)
    firstStep2Request.genericEventStep2 = true;
  if (P7_TEST_HEAL_ORB && index === 1 && !debugOnlyLevel) {
    const left = leftOf(incoming);
    enqueueFeature(
      runtime,
      "item",
      add(runtime.entry, add(mul(incoming, CONFIG.gridSize * 1.5), add(mul(left, CONFIG.gridSize), vec(0, 0, 64)))),
      anglesFor(incoming),
      { tile: 93, team: 3, itemName: "heal_orb", debugItem: true },
    );
  }
  if (FEATURE_FLAGS.zombieItems && index === 1 && !debugOnlyLevel) {
    for (let itemIndex = 0; itemIndex < immutableStage.zombieItemsAtSpawn; itemIndex++) {
      const yaw = Math.random() * 360;
      const radians = yaw * Math.PI / 180;
      enqueueFeature(runtime, "item", vec(
        Math.cos(radians) * CONFIG.zombieItemsSpawnRadius,
        Math.sin(radians) * CONFIG.zombieItemsSpawnRadius,
        40,
      ), { pitch: 0, yaw: 0, roll: 0 }, {
        tile: 94,
        team: 2,
        zombieSpawn: true,
      });
    }
  }
  }
  const planner = planPixels();
  if (deferPlanning) runtime.planningIterator = planner;
  else for (const _ of planner) {                                              }
  return runtime;
}

function enqueueBridge(runtime, start, end, direction, amount) {
  const left = leftOf(direction);
  for (let step = 0; step < amount; step++) {
    const progress = (step + 0.5) / amount;
    const center = add(start, mul(sub(end, start), progress));
                                                                          
                                                                    
    for (const lane of state.finaleEscapeActive ? [-0.5, 0.5] : [-1.5, -0.5, 0.5, 1.5]) {
      enqueueSpawn(
        runtime,
        "platform",
        add(center, mul(left, lane * CONFIG.gridSize)),
        anglesFor(direction),
        "platform_bridge",
        { bufferBridge: true },
      );
    }
  }
}

function enqueueSpawn(runtime, shape, position, angles, themeShape = shape, options = {}) {
  const themeName = options.themeName
    ? themeProfile(options.themeName).name
    : runtime?.kind === "FINALE" && runtime.finaleThemeRandom
      ? chooseFinaleThemeName(runtime)
      : themeProfile(runtime.themeSnapshot ?? runtime.stageSnapshot?.theme).name;
  const terrainModel = options.terrainModel ?? chooseTerrainModel(themeName, themeShape);
  const renderColor = options.renderColor ?? genericRenderColor(options.sourceTile, themeName);
  (runtime.preloadRequests ?? state.spawnQueue).push({
    levelIndex: runtime.index,
    kind: "terrain",
    shape,
    position,
    angles,
    themeName,
    themeTerrainShape: themeShape,
    terrainModel,
    renderColor,
    colorTile: options.colorTile === true,
    bufferBridge: options.bufferBridge === true,
  });
  runtime.remaining++;
}

function projectedWithinLimits(runtime) {
  const end = runtime.end;
  if (Math.abs(end.x) > CONFIG.edgeLimit || Math.abs(end.y) > CONFIG.edgeLimit || Math.abs(end.z) > CONFIG.heightLimit) {
    return false;
  }
  if (Math.abs(end.x) <= CONFIG.edgeWarning && Math.abs(end.y) <= CONFIG.edgeWarning) return true;
  const before = Math.hypot(runtime.entry.x, runtime.entry.y);
  const after = Math.hypot(end.x, end.y);
  return after <= before;
}

function itemDesireIncrement(team = 3) {
  const values = team === 2 ? CONFIG.zombieItemDesireIncrements : CONFIG.itemDesireIncrements;
  return values[Math.floor(Math.random() * values.length)];
}

function finalizeLevelItemDesire(runtime) {
  if (runtime.itemDesireTracked) return;
  const increment = itemDesireIncrement();
  state.humanItemDesired += increment;
  state.zombieItemDesired += CONFIG.itemDesireShared ? increment : itemDesireIncrement(2);
  runtime.itemDesireTracked = true;
}

function commitSourceStageCost(runtime) {
  if (runtime.sourceStageCostCommitted || runtime.sourceStageCost === undefined) return;
  runtime.sourceStageCostCommitted = true;
                                                                           
                                                                         
                                                                          
  while (state.sourceStageCosts.length > CONFIG.maxAreaHistory) state.sourceStageCosts.shift();
  state.sourceStageCosts.push({ index: runtime.index, cost: runtime.sourceStageCost });
}

function sourceFeatureEstimatedCost(cost = 0) {
                                                                           
                                                      
  let total = CONFIG.sourceEntityBaseEstimate + cost + terrainPreloadEntityCount()
    + state.sourceStageCosts.reduce((sum, entry) => sum + entry.cost, 0)
    + CONFIG.bufferSize * 4;
  for (const [entity, extra] of state.sourceExtraCosts) {
    if (!validEntity(entity)) state.sourceExtraCosts.delete(entity);
    else total += extra;
  }
  for (const event of state.genericEvents.active.values()) if (!event.ended) total += event.cost ?? 0;
  return total;
}

function registerSourceFeatureCost(entity, cost) {
  if (validEntity(entity)) state.sourceExtraCosts.set(entity, cost);
}

function activeItemCount() {
  let count = 0;
  for (const runtime of activeRuntimes()) for (const item of runtime.items ?? []) {
    if (item.state !== "consumed" && item.state !== "cleaned" && validEntity(item.carrier)) count++;
  }
  return count;
}

function releaseLevelPostSpawn(runtime, planningComplete = false) {
  if (runtime.postSpawnReleased || (runtime.remaining > 0 && !planningComplete)) return;
  runtime.postSpawnReleased = true;
  commitSourceStageCost(runtime);
  for (const request of runtime.postSpawnFeatures ?? []) {
    if (request.feature === "item" && !runtime.escapeNoItems) state.itemSpawnQueue.push(request);
    if (request.feature === "trap" && !runtime.escapeNoTraps) state.trapSpawnQueue.push(request);
  }
  runtime.postSpawnFeatures?.splice(0);
  if (!runtime.itemDesireTracked) return;
                                                                      
                                                                            
  const teams = Math.random() < 0.5 ? [3, 2] : [2, 3];
  for (const team of teams) {
    const key = team === 3 ? "human" : "zombie";
    const enabled = team === 3 ? FEATURE_FLAGS.humanItems : FEATURE_FLAGS.zombieItems;
    const desired = team === 3 ? state.humanItemDesired : state.zombieItemDesired;
    if (!enabled || (runtime.sourceItemTileCounts?.[key] ?? 0) > 0 || desired < CONFIG.itemForceDesire) continue;
                                                                            
                                                                         
    if (team === 3) state.humanItemDesired--;
    else state.zombieItemDesired--;
    if (activeItemCount() >= CONFIG.itemMaximum) continue;
    const side = team === 3 ? 1 : -1;
    const position = add(runtime.entry, add(mul(runtime.incoming, CONFIG.gridSize / 2),
      mul(leftOf(runtime.incoming), side * CONFIG.gridSize / 2)));
    spawnItemFeature(runtime, { position, angles: { pitch: 0, yaw: 0, roll: 0 },
      tile: team === 3 ? 93 : 94, team, itemGroundAnchored: true,
      forcedByDesire: true, desireSpent: true });
  }
}

function processPostSpawnQueues(rounds = CONFIG.postSpawnPerThink, budget = Infinity) {
  let spent = 0;
  const spawnNext = queue => {
    if (!queue.length || spent >= budget) return;
    const requestIndex = Math.floor(Math.random() * queue.length);
    const request = queue[requestIndex];
    const runtime = state.levels.get(request.levelIndex);
    // Step3 may release while physical terrain makers still have work queued.
    if (runtime?.debugKarts && (runtime.planningIterator
      || state.spawnQueue.some(entry => entry.levelIndex === runtime.index && entry.kind === "terrain")
      || [...state.generationQueues.values()].some(entries =>
        entries.some(entry => entry.levelIndex === runtime.index && entry.kind === "terrain")))) return;
    queue.splice(requestIndex, 1);
    if (!runtime || runtime.lifecycle === "destroyed") return;
    spent++;
    try {
      if (request.generationCounted) spawnOne(request);
      else if (request.feature === "item") spawnItemFeature(runtime, request);
      else spawnTrapFeature(runtime, request);
    } catch (error) {
      failRuntime(`postspawn failed for level ${runtime.index}/${request.feature}: ${error}`);
    }
  };
  for (let index = 0; index < rounds && !state.fatal; index++) {
    if (!state.itemSpawnQueue.length && !state.trapSpawnQueue.length) break;
    if (CONFIG.prioritizeItemSpawns) {
      spawnNext(state.itemSpawnQueue.length ? state.itemSpawnQueue : state.trapSpawnQueue);
    } else {
      const order = Math.random() < 0.5
        ? [state.itemSpawnQueue, state.trapSpawnQueue] : [state.trapSpawnQueue, state.itemSpawnQueue];
      spawnNext(order[0]);
      if (!state.fatal) spawnNext(order[1]);
    }
  }
  return spent;
}

function generationQueueKey(request) {
  if (request.kind === "terrain") return "terrain";
  if (request.feature === "liquid") return "liquid";
  if (request.feature === "ladder") return "ladder";
  if (request.feature === "boost") return "boost";
  return "model";
}

function clearGenerationWork(owner) {
  if (owner === undefined || state.terrainPreload?.source.index === owner
    || state.terrainPreload?.runtime.index === owner) clearTerrainPreload();
  for (const runtime of state.levels.values()) {
    if (owner === undefined || runtime.index === owner) runtime.planningIterator = undefined;
  }
  for (const queue of state.generationQueues.values()) {
    if (owner === undefined) queue.length = 0;
    else {
      const kept = queue.filter(request => request.levelIndex !== owner);
      queue.splice(0, queue.length, ...kept);
    }
  }
  for (const [entity, fade] of state.terrainSpawnFades) {
    if (owner === undefined || fade.owner === owner) state.terrainSpawnFades.delete(entity);
  }
}

function processGenerationQueues() {
  const foregroundAtStart = !!state.pendingLevel || state.spawnQueue.length > 0
    || state.itemSpawnQueue.length > 0 || state.trapSpawnQueue.length > 0
    || [...state.generationQueues.values()].some(queue => queue.length);
                                                                                     
                                                                           
                                                                          
                                                                         
  const fast = state.finaleEscapeActive === true;
  let logicalLimit = state.debugAllModelsMode ? 2 : fast ? 10 : CONFIG.spawnPerThink;
  const planning = state.pendingLevel;
  if (planning?.planningIterator) {
    planning.sourceGenerationScheduled = true;
    try {
      while (logicalLimit > 0 && planning.planningIterator) {
        logicalLimit--;
        if (planning.planningIterator.next().done) planning.planningIterator = undefined;
      }
    } catch (error) {
      failRuntime(`pixel planning failed for level ${planning.index}: ${error}`);
      return;
    }
  }
                                                                       
                                                                          
  if (planning?.planningIterator) logicalLimit = 0;
  const touched = new Set();
  for (let task = 0; task < logicalLimit && state.spawnQueue.length && !state.fatal; task++) {
    const first = state.spawnQueue[0];
    do {
      const request = state.spawnQueue.shift();
      const runtime = state.levels.get(request.levelIndex);
      if (!runtime || runtime.lifecycle === "destroyed") continue;
      runtime.sourceGenerationScheduled = true;
      touched.add(runtime);
      if (request.kind === "feature" && ((runtime.escapeNoItems && request.feature === "item")
        || (runtime.escapeNoTraps && request.feature === "trap"))) {
        finishRuntimeSpawn(runtime);
        continue;
      }
      if (request.genericEventStep2) {
        processGenericLevelStep2(runtime);
        request.genericEventStep2 = false;
        if (state.fatal) return;
      }
      if (request.kind === "feature" && (request.feature === "item"
        || (request.feature === "trap" && request.tile >= 86 && request.tile <= 89))) {
        const deferred = request.postSpawn === true;
        request.postSpawn = false;
        request.generationCounted = true;
        if (deferred) runtime.postSpawnFeatures.push(request);
        else (request.feature === "item" ? state.itemSpawnQueue : state.trapSpawnQueue).push(request);
      } else state.generationQueues.get(generationQueueKey(request)).push(request);
    } while (first.generationGroup !== undefined && state.spawnQueue.length
      && state.spawnQueue[0].levelIndex === first.levelIndex
      && state.spawnQueue[0].generationGroup === first.generationGroup && !state.fatal);
  }
  for (const runtime of touched) {
    if (!state.spawnQueue.some(request => request.levelIndex === runtime.index)) {
      try { releaseLevelPostSpawn(runtime, true); }
      catch (error) { failRuntime(`generation Step3 failed for level ${runtime.index}: ${error}`); return; }
    }
  }
  const rounds = state.debugAllModelsMode ? 2 : fast ? 5 : CONFIG.spawnQueuePerThink;
  // Ordinary generation shares one physical budget across every maker so a
  // stage with many feature kinds cannot multiply the per-Think spawn spike.
  let budget = fast || state.debugAllModelsMode ? Infinity : CONFIG.spawnBudgetPerThink;
  for (let round = 0; round < rounds && budget > 0 && !state.fatal; round++) {
    for (const [kind, queue] of state.generationQueues) {
      if (budget <= 0) break;
      if (kind === "terrain" && !fast && !state.debugAllModelsMode
        && round >= CONFIG.terrainDeployPerThink) continue;
      if (queue.length) {
        spawnOne(queue.shift());
        budget--;
      }
      if (state.fatal) return;
    }
    budget -= processPostSpawnQueues(1, budget);
  }
  // Foreground creation and deployment have priority. Background work uses
  // idle generation passes only, so their terrain budgets never add up.
  if (!state.fatal && !processThemeTerrainWarmup(foregroundAtStart)) processTerrainPreload(foregroundAtStart);
}

function chooseLevel(index, trackItemDesire = true) {
  if (state.debugStageId) {
    const level = DEBUG_HOOKS.levelDefinition(state.debugStageId);
    if (!level) throw new Error(`debug stage '${state.debugStageId}' is no longer present in the stage data`);
    const runtime = buildLevel(
      level,
      state.debugStageMirror === true,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      level.debugSpiders || level.debugTeleport || level.debugLiquidFall || level.debugKarts ? createStageSnapshot(0, "generic") : campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error(`debug stage '${level.id}' would exceed world limits`);
    }
    if (trackItemDesire && !level.debugSpiders && !level.debugTeleport && !level.debugLiquidFall && !level.debugKarts) finalizeLevelItemDesire(runtime);
    return runtime;
  }
  if (state.debugMovementThemesMode) {
    const runtime = buildLevel(
      DEBUG_DATA.movementThemesLevel,
      false,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error("debug movement themes lab would exceed world limits");
    }
    return runtime;
  }
  if (state.debugAllModelsMode) {
    const runtime = buildLevel(
      DEBUG_DATA.allModelsLevel,
      false,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error("debug model gallery would exceed world limits");
    }
    return runtime;
  }
  if (state.debugTrapMode) {
    const runtime = buildLevel(
      DEBUG_DATA.trapLevel,
      false,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error("debug trap pixel lab would exceed world limits");
    }
    return runtime;
  }
  if (state.debugGravityMode) {
    const runtime = buildLevel(
      DEBUG_DATA.gravityLevel,
      false,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error("debug gravity lab would exceed world limits");
    }
    return runtime;
  }
  if (state.debugShowcaseMode) {
    const runtime = buildLevel(
      DEBUG_DATA.showcaseLevel,
      false,
      index,
      state.nextEntry,
      state.currentDirection,
      state.nextBridgeStart,
      state.nextBufferSize,
      campaignStageSnapshot(),
    );
    if (!projectedWithinLimits(runtime)) {
      state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
      throw new Error("debug showcase would exceed world limits");
    }
    return runtime;
  }
  const candidates = LEVELS.filter((level) => level.id !== state.lastLevelId);
  for (let attempt = 0; attempt < 80; attempt++) {
    const level = candidates[Math.floor(Math.random() * candidates.length)];
    const mirrored = Math.random() >= 0.5;
    const queueStart = state.spawnQueue.length;
    let runtime;
    try {
      runtime = buildLevel(
        level,
        mirrored,
        index,
        state.nextEntry,
        state.currentDirection,
        state.nextBridgeStart,
        state.nextBufferSize,
        campaignStageSnapshot(),
      );
    } catch (error) {
      state.spawnQueue.splice(queueStart);
      message(`rejected level '${level.name}': ${error}`);
      continue;
    }
    if (projectedWithinLimits(runtime)) {
      if (trackItemDesire) finalizeLevelItemDesire(runtime);
      return runtime;
    }
    state.spawnQueue.splice(state.spawnQueue.length - runtime.remaining, runtime.remaining);
  }
  throw new Error("could not select a level within world limits");
}

function terrainPreloadEntityCount() {
  let count = state.terrainPreloadRetiring.size
    + (state.terrainPreload?.runtime.terrainPreloadedEntities?.size ?? 0);
  for (const runtime of state.levels.values()) count += runtime.terrainPreloadedEntities?.size ?? 0;
  return count;
}

function terrainPreloadBlockReason(source) {
  if (!CONFIG.terrainPreloadEnabled) return "disabled";
  if (!state.running || state.fatal) return "not running";
  if (!source) return "no current level";
  if (state.levels.get(source.index) !== source || source.index !== state.levelIndex) return "level not current";
  if (isStageGoalLevel(source)) return "stage goal level";
  if (state.debugNextEnding) return "debug next ending armed";
  if (source.raceLevel || source.kind) return "special level";
  if (source.debugTeleport || source.debugLiquidFall || source.debugKarts) return "debug level";
  if (state.endingRuntime || state.finaleEscapeActive) return "ending";
  if (state.themePreload) return "theme preload";
  if (state.themeMusic.infiniteThemePending) return "infinite theme pending";
  if (state.debugStageId || state.debugShowcaseMode || state.debugGravityMode
    || state.debugMovementThemesMode || state.debugAllModelsMode || state.debugTrapMode) return "debug mode";
  if (!["active", "transition"].includes(state.campaign.phase)) return `campaign phase ${state.campaign.phase}`;
  if (!["active", "end_delay", "transition"].includes(source.lifecycle)) return `level lifecycle ${source.lifecycle}`;
  return undefined;
}

function terrainPreloadContextAllowed(source) {
  return terrainPreloadBlockReason(source) === undefined;
}

// The Finale escape route (finite and infinite) stages its next segment
// while the current one is being run; the final segment has no successor.
function finaleEscapePreloadBlockReason(ending) {
  if (!CONFIG.terrainPreloadEnabled) return "disabled";
  if (!state.running || state.fatal) return "not running";
  const escape = ending?.escape;
  if (ending?.kind !== "FINALE" || ending.lifecycle !== "active" || ending.bossPhase !== "escape" || !escape) {
    return "no escape route";
  }
  if (escape.levelCount >= escape.levelTarget) return "last escape level";
  if (escape.current?.lifecycle !== "active") return "escape level not active";
  if (state.themePreload) return "theme preload";
  if (state.debugShowcaseMode || state.debugGravityMode || state.debugMovementThemesMode
    || state.debugAllModelsMode || state.debugTrapMode) return "debug mode";
  return undefined;
}

function finaleEscapePreloadMatches(preload) {
  const ending = preload.ending, escape = ending?.escape, after = preload.source;
  if (!CONFIG.terrainPreloadEnabled || !state.running || state.fatal
    || preload.round !== state.roundBootstrapSerial || state.endingRuntime !== ending
    || ending.lifecycle !== "active" || ending.bossPhase !== "escape" || !escape
    || after.lifecycle === "destroyed" || escape.levelCount + 1 !== preload.segment) return false;
  // Planned while `after` was current; still valid once it completes.
  if (escape.current ? escape.current !== after : escape.history?.at(-1) !== after) return false;
  const direction = escape.current ? after.outgoing : escape.direction;
  return distance2D(escape.nextEntry, preload.nextEntry) < 0.01
    && Math.abs(escape.nextEntry.z - preload.nextEntry.z) < 0.01
    && direction.x === preload.direction.x && direction.y === preload.direction.y;
}

function startFinaleEscapePreload(ending) {
  const escape = ending?.escape, after = escape?.current;
  const blocked = finaleEscapePreloadBlockReason(ending)
    ?? (after.terrainPreloadFailed ? "failed earlier on this level" : undefined);
  // Spawning is transient and would log once per segment; say the rest once.
  const key = blocked && blocked !== "escape level not active"
    && `${after?.index ?? "escape"}:${blocked}`;
  if (key && key !== state.terrainPreloadBlockedLog) {
    message(`[TERRAIN PRELOAD] not starting for escape segment ${(escape?.levelCount ?? 0) + 1}: ${blocked}`);
  }
  if (key) state.terrainPreloadBlockedLog = key;
  if (blocked) return;
  const plan = finaleEscapePlanContext(escape, after);
  try {
    const runtime = planFinaleEscapeLevel(ending, plan, true);
    runtime.terrainPreloadedEntities = new Set();
    state.terrainPreload = { kind: "finale_escape", source: after, ending, runtime, segment: plan.segment,
      nextEntry: clone(plan.nextEntry), direction: clone(plan.direction), round: state.roundBootstrapSerial,
      cursor: 0, prepared: 0, templates: new Map() };
    message(`[TERRAIN PRELOAD] planning escape segment ${plan.segment}/${escape.levelTarget}: '${runtime.name}'`);
  } catch (error) {
    after.terrainPreloadFailed = true;
    message(`[TERRAIN PRELOAD] escape planning skipped: ${error}`);
  }
}

function terrainPreloadMatches(preload) {
  if (preload?.kind === "finale_escape") return finaleEscapePreloadMatches(preload);
  if (!preload || !terrainPreloadContextAllowed(preload.source)) return false;
  return preload.round === state.roundBootstrapSerial
    && preload.runtime.index === state.levelIndex + 1
    && preload.runtime.stageSnapshot === campaignStageSnapshot()
    && [state.currentLevel, state.transitionLevel].includes(preload.source)
    && distance2D(preload.runtime.entry, state.nextEntry) < 0.01
    && Math.abs(preload.runtime.entry.z - state.nextEntry.z) < 0.01
    && preload.runtime.incoming.x === state.currentDirection.x
    && preload.runtime.incoming.y === state.currentDirection.y
    && preload.bufferSize === state.nextBufferSize
    && distance2D(preload.bridgeStart, state.nextBridgeStart) < 0.01
    && Math.abs(preload.bridgeStart.z - state.nextBridgeStart.z) < 0.01;
}

function clearTerrainPreload(immediate = false) {
  const preload = state.terrainPreload;
  state.terrainPreload = undefined;
  if (preload) {
    preload.runtime.lifecycle = "destroyed";
    preload.runtime.planningIterator = undefined;
    for (const entity of preload.runtime.terrainPreloadedEntities ?? []) state.terrainPreloadRetiring.add(entity);
    preload.runtime.terrainPreloadedEntities?.clear();
    preload.runtime.preloadRequests?.splice(0);
  }
  if (immediate) {
    for (const runtime of state.levels.values()) {
      for (const entity of runtime.terrainPreloadedEntities ?? []) state.terrainPreloadRetiring.add(entity);
      runtime.terrainPreloadedEntities?.clear();
    }
    destroyEntities(state.terrainPreloadRetiring);
    state.terrainPreloadRetiring.clear();
  }
}

function prepareTerrainRequest(preload, request, slot) {
  const bakedSlope = /_slope(?:half)?$/.test(request.shape);
  let template = state.templates.get(request.shape);
  let bakedYaw;
  let bakedName = TEMPLATE_NAMES[request.shape];
  if (bakedSlope) {
    const yaw = ((request.angles.yaw % 360) + 360) % 360;
    if (![0, 90, 180, 270].includes(yaw)) return false;
    bakedYaw = yaw;
    if (yaw !== 0) bakedName = `${TEMPLATE_NAMES[request.shape]}_yaw${yaw}`;
    if (preload.misorientedTemplates?.has(bakedName)) return false;
    if (yaw !== 0) {
      const name = bakedName;
      if (!preload.templates.has(name)) preload.templates.set(name, Instance.FindEntityByName(name));
      template = preload.templates.get(name);
      // Old compiled maps may lack directional templates. Leave this request
      // cold rather than trying to rotate an authored collision shape at runtime.
      if (!validEntity(template) || typeof template.ForceSpawn !== "function") return false;
    }
  }
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") throw new Error(`missing template '${request.shape}'`);
  // In-place staging spawns at the final transform, hidden and non-solid; the
  // plan is discarded if the entry/direction it was built for ever changes.
  // Parking staging stays inside engine coordinates, outside the playable limits.
  // No triggers/physics are staged either way.
  const inPlace = CONFIG.terrainPreloadInPlace === true;
  const position = inPlace ? clone(request.position)
    : vec(11000 + (slot % 32) * 128, 11000 + Math.floor(slot / 32) * 128, -8000);
  const spawned = (bakedSlope ? spawnRoundEntities(template, position)
    : spawnRoundEntities(template, position, request.angles)) ?? [];
  // The engine may report prop_dynamic_override as prop_dynamic; both are
  // the same static dynamic prop. Physics props and multi-entity templates stay out.
  const classNames = spawned.map(entity => String(entity?.GetClassName?.() ?? "invalid").toLowerCase());
  if (spawned.length !== 1 || !validEntity(spawned[0])
    || !["prop_dynamic", "prop_dynamic_override"].includes(classNames[0])) {
    destroyEntities(spawned);
    throw new Error(`terrain '${request.shape}' must spawn one prop_dynamic for preloading`
      + ` (got ${spawned.length}: ${classNames.join(", ") || "none"})`);
  }
  const entity = spawned[0];
  // A baked slope keeps its prototype's authored angles. A prototype authored
  // with any other rotation (terrain_proto_platform_slopehalf shipped as
  // "0 270 -90") would stage the slope on its side, so leave such requests to
  // the cold path, which spawns with the request angles.
  if (bakedSlope && !bakedSlopeOrientationMatches(entity, bakedYaw)) {
    destroyEntities(spawned);
    preload.misorientedTemplates ??= new Set();
    preload.misorientedTemplates.add(bakedName);
    message(`[TERRAIN PRELOAD] '${bakedName}' is not authored at yaw ${bakedYaw} with zero pitch/roll; its slopes use cold spawning`);
    // null: the request stays cold, but this spawn still spent preload budget.
    return null;
  }
  if (inPlace) {
    fireTarget(entity, "DisableCollision");
    if (CONFIG.terrainPreloadDebugVisible !== true) fireTarget(entity, "TurnOff");
  }
  preload.runtime.terrainPreloadedEntities.add(entity);
  const prepared = { entity, inPlace, model: request.themeName === "silenthill"
    ? silentHillDesiredModel(request.terrainModel) : request.terrainModel };
  request.preloadedTerrain = prepared;
  entity.SetEntityName(`collective_terrain_preload_${preload.runtime.index}_${slot}`);
  // Do not register with live terrain, Silent Hill, fades, or event ownership.
  entity.collectiveSpawnFadeAlpha = 0;
  if (prepared.model) entity.SetModel(prepared.model);
  const restore = () => {
    if (preload.round !== state.roundBootstrapSerial || !validEntity(entity)
      || preload.runtime.lifecycle === "destroyed"
      || !preload.runtime.terrainPreloadedEntities.has(entity)) return;
    entity.Teleport(bakedSlope ? { position, velocity: vec() }
      : { position, angles: request.angles, velocity: vec() });
    const color = colorToEntityColor(request.renderColor) ?? { r: 255, g: 255, b: 255, a: 255 };
    entity.collectiveBaseColor = color;
    entity.collectiveBodyGroup = 0;
    entity.SetColor({ ...color, a: inPlace && CONFIG.terrainPreloadDebugVisible === true ? 128 : 0 });
    fireTarget(entity, "SetBodyGroup", "Main,0");
  };
  restore();
  afterThink(restore);
  return true;
}

function bakedSlopeOrientationMatches(entity, yaw) {
  const angles = entity.GetAbsAngles?.();
  if (!angles) return true;
  const offset = (value, target) => Math.abs((((value - target) % 360) + 540) % 360 - 180);
  return offset(angles.pitch ?? 0, 0) < 1 && offset(angles.roll ?? 0, 0) < 1 && offset(angles.yaw ?? 0, yaw) < 1;
}

function processTerrainPreload(foregroundUsed = false) {
  if (!state.running || state.fatal) return;
  if (state.terrainPreload && !terrainPreloadMatches(state.terrainPreload)) clearTerrainPreload();
  const foregroundBusy = state.pendingLevel || state.spawnQueue.length || state.itemSpawnQueue.length
    || state.trapSpawnQueue.length || [...state.generationQueues.values()].some(queue => queue.length);
  if (foregroundUsed || foregroundBusy) return;
  // Cancellation is also drained in batches; do not Kill a whole staged level
  // in one ordinary gameplay frame or immediately refill its entity allowance.
  if (state.terrainPreloadRetiring.size) {
    let count = 0;
    for (const entity of state.terrainPreloadRetiring) {
      if (count++ >= CONFIG.terrainPreloadPerThink) break;
      if (validEntity(entity)) entity.Kill();
      state.terrainPreloadRetiring.delete(entity);
    }
    return;
  }
  const source = state.currentLevel ?? state.transitionLevel;
  const ending = state.endingRuntime;
  if (!state.terrainPreload && ending?.kind === "FINALE" && ending.bossPhase === "escape") {
    startFinaleEscapePreload(ending);
    if (!state.terrainPreload) return;
  } else if (!state.terrainPreload) {
    const blocked = terrainPreloadBlockReason(source)
      ?? (source.lifecycle !== "active" ? `level lifecycle ${source.lifecycle}`
        : source.terrainPreloadFailed ? "failed earlier on this level" : undefined);
    // Say once per level/reason why nothing is being staged.
    const key = blocked && `${source?.index}:${blocked}`;
    if (key && key !== state.terrainPreloadBlockedLog) message(`[TERRAIN PRELOAD] not starting for level ${source?.index}: ${blocked}`);
    state.terrainPreloadBlockedLog = key;
    if (blocked) return;
    const priorDefer = state.deferTerrainPlanning;
    try {
      state.deferTerrainPlanning = true;
      const runtime = chooseLevel(state.levelIndex + 1, false);
      runtime.preloadRequests = [];
      runtime.terrainPreloadedEntities = new Set();
      state.terrainPreload = { source, runtime, round: state.roundBootstrapSerial,
        cursor: 0, prepared: 0, templates: new Map(),
        bridgeStart: clone(state.nextBridgeStart), bufferSize: state.nextBufferSize };
      message(`[TERRAIN PRELOAD] planning level ${runtime.index}: '${runtime.name}'`);
    } catch (error) {
      source.terrainPreloadFailed = true;
      message(`[TERRAIN PRELOAD] planning skipped: ${error}`);
      return;
    } finally { state.deferTerrainPlanning = priorDefer; }
  }
  const preload = state.terrainPreload, runtime = preload.runtime;
  try {
    if (runtime.planningIterator) {
      for (let n = 0; n < CONFIG.spawnPerThink && runtime.planningIterator; n++) {
        if (runtime.planningIterator.next().done) runtime.planningIterator = undefined;
      }
      // Escape segments draw a Finale theme per request, as the cold path
      // does; staging needs the final models, so theme before any block.
      if (!runtime.planningIterator && preload.kind === "finale_escape") {
        themeFinaleEscapeRequests(preload.ending, runtime, runtime.preloadRequests);
        preload.themed = true;
      }
      return;
    }
    let live = activeRuntimes().reduce((count, owner) => count + (owner.entities?.size ?? 0), 0);
    for (const event of state.genericEvents.active.values()) live += event.entityRuntime.entities.size + event.cost;
    let budget = CONFIG.terrainPreloadPerThink;
    while (budget > 0 && preload.cursor < runtime.preloadRequests.length) {
      if (terrainPreloadEntityCount() >= CONFIG.terrainPreloadMaxEntities
        || live + terrainPreloadEntityCount() >= 10000) break;
      const request = runtime.preloadRequests[preload.cursor++];
      if (request.kind !== "terrain") continue;
      const prepared = prepareTerrainRequest(preload, request, preload.prepared);
      if (prepared) preload.prepared++;
      if (prepared || prepared === null) budget--;
    }
    if (!preload.ready && (preload.cursor === runtime.preloadRequests.length
      || preload.prepared >= CONFIG.terrainPreloadMaxEntities)) {
      preload.ready = true;
      message(`[TERRAIN PRELOAD] level ${runtime.index}: ${preload.prepared} static blocks prepared`);
    }
  } catch (error) {
    preload.source.terrainPreloadFailed = true;
    clearTerrainPreload();
    message(`[TERRAIN PRELOAD] staging cancelled; normal generation retained: ${error}`);
  }
}

function generateNextLevel() {
  if (!state.running || state.fatal || state.pendingLevel) return;
  if (["ending_pending", "ending_handoff", "ended"].includes(state.campaign.phase)) return;
  if (state.themeMusic.infiniteThemePending) {
    schedule(0.1, generateNextLevel);
    return;
  }
  try {
    const index = state.levelIndex + 1;
    let runtime;
    const preload = state.terrainPreload;
    if (preload?.kind !== "finale_escape" && terrainPreloadMatches(preload)) {
      runtime = preload.runtime;
      state.terrainPreload = undefined;
      state.spawnQueue.push(...runtime.preloadRequests);
      runtime.preloadRequests = undefined;
      finalizeLevelItemDesire(runtime);
      message(`[TERRAIN PRELOAD] deploying level ${index}: ${runtime.terrainPreloadedEntities.size} prepared blocks`);
    } else {
      clearTerrainPreload();
      const priorDefer = state.deferTerrainPlanning;
      state.deferTerrainPlanning = true;
      try { runtime = chooseLevel(index); }
      finally { state.deferTerrainPlanning = priorDefer; }
    }
    state.levelIndex = index;
    state.pendingLevel = runtime;
    state.levels.set(index, runtime);
    state.lastLevelId = runtime.id;
    message(`${runtime.planningIterator ? "planning" : "queued"} level ${index}: '${runtime.name}' by ${runtime.author}`
      + (runtime.planningIterator ? " (20x20 pixels)" : ` (${runtime.remaining} requests)`));
    if (runtime.remaining === 0 && !runtime.planningIterator) finishPendingLevel();
  } catch (error) {
    failRuntime(`level generation failed: ${error}`);
  }
}

// Measured 2026-10-14: every Instance.ConnectOutput call leaves one V8 global
// handle on the callback for the life of the script context, even after
// DisconnectOutput. Hand the engine one shared, capture-free dispatcher per
// output name so the leaked handle never retains a closure (runtime, level
// data, entities); per-connection callbacks live in round-scoped routes that
// the arena drops.
const outputDispatchers = new Map();

function outputDispatcher(output) {
  let dispatcher = outputDispatchers.get(output);
  if (!dispatcher) {
    dispatcher = (data) => dispatchEntityOutput(output, data);
    outputDispatchers.set(output, dispatcher);
  }
  return dispatcher;
}

function dispatchEntityOutput(output, data) {
  const routes = state.outputRoutes.get(data?.caller)?.get(output);
  if (!routes) return;
  for (const callback of [...routes.values()]) {
    try { callback(data); }
    catch (error) { reportGuardedError(`output ${output}`, error); }
  }
}

function connectEntityOutput(entity, output, callback) {
  const id = Instance.ConnectOutput(entity, output, outputDispatcher(output));
  if (id === undefined || id === null) return id;
  let byOutput = state.outputRoutes.get(entity);
  if (!byOutput) state.outputRoutes.set(entity, byOutput = new Map());
  let routes = byOutput.get(output);
  if (!routes) byOutput.set(output, routes = new Map());
  routes.set(id, callback);
  state.outputRouteIndex.set(id, { entity, output });
  return id;
}

function disconnectEntityOutput(id) {
  Instance.DisconnectOutput(id);
  const route = state.outputRouteIndex.get(id);
  if (!route) return;
  state.outputRouteIndex.delete(id);
  const byOutput = state.outputRoutes.get(route.entity);
  const routes = byOutput?.get(route.output);
  routes?.delete(id);
  if (routes && routes.size === 0) byOutput.delete(route.output);
  if (byOutput && byOutput.size === 0) state.outputRoutes.delete(route.entity);
}

function connectOwnedOutput(runtime, entity, output, callback) {
  const id = connectEntityOutput(entity, output, callback);
  if (id !== undefined && id !== null) {
    runtime.outputConnections.add(id);
    state.outputConnections.set(id, runtime.index);
  }
  return id;
}

function setPlayerGravity(pawn, gravity) {
  if (!CONFIG.useCs2FixesGravity || !pawn?.IsValid?.()) return false;
                                                                            
                                                                          
                                                                           
  const airslide = state.airslidePlayers.get(pawn);
  if (airslide && validAirslideContact(pawn, airslide)) return true;
  const numericGravity = Number(gravity);
  const normalizedGravity = Number.isFinite(numericGravity)
    ? Math.max(0, Math.min(4, numericGravity))
    : 1;
  try {
                                                                            
                                                                             
                                   
    fireTarget(pawn, "KeyValues", `gravity ${normalizedGravity}`);
    return true;
  } catch (error) {
    message(`CS2Fixes gravity update failed: ${error}`);
    return false;
  }
}

function applyGravitySources(pawn, effect) {
  effect.engineSources ??= new Set();
  const engineValues = CONFIG.useCs2FixesGravity
    ? [...effect.engineSources]
      .map((source) => effect.gravitySources.get(source))
      .filter((gravity) => Number.isFinite(Number(gravity)))
    : [];
  const gravity = engineValues.length > 0 ? Math.min(...engineValues) : 1;
  setPlayerGravity(pawn, gravity);
}

function addGravitySource(runtime, pawn, source, gravity = CONFIG.lowGravity, options = {}) {
  if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) return;
  let effect = state.playerEffects.get(pawn);
  if (!effect) {
    effect = {
      gravitySources: new Map(),
      engineSources: new Set(),
      simulatedSources: new Set(),
      owners: new Set(),
    };
    state.playerEffects.set(pawn, effect);
  }
  effect.engineSources ??= new Set();
  effect.simulatedSources ??= new Set();
  effect.gravitySources.set(source, gravity);
  const engineRequested = options.engine !== false;
  if (CONFIG.useCs2FixesGravity && engineRequested) effect.engineSources.add(source);
  else effect.engineSources.delete(source);
                                                                               
                                                                             
                                                                            
                             
  if (options.simulate === true || (options.simulate !== false && !CONFIG.useCs2FixesGravity && engineRequested)) {
    effect.simulatedSources.add(source);
  } else {
    effect.simulatedSources.delete(source);
  }
  effect.owners.add(runtime.index);
  applyGravitySources(pawn, effect);
}

function removeGravitySource(pawn, source) {
  const contacts = state.lowgravContacts.get(pawn);
  contacts?.delete(source);
  if (contacts && contacts.size === 0) state.lowgravContacts.delete(pawn);
  const effect = state.playerEffects.get(pawn);
  if (!effect) return;
  effect.gravitySources.delete(source);
  effect.engineSources?.delete(source);
  effect.simulatedSources?.delete(source);
  if (effect.gravitySources.size === 0) {
    setPlayerGravity(pawn, 1);
    state.playerEffects.delete(pawn);
  } else applyGravitySources(pawn, effect);
}

function restorePlayerEffects(ownerIndex) {
  for (const [pawn, contacts] of state.lowgravContacts) {
    for (const [source, volume] of contacts) {
      if (ownerIndex === undefined || volume.runtime.index === ownerIndex) contacts.delete(source);
    }
    if (!contacts.size) state.lowgravContacts.delete(pawn);
  }
  for (const [pawn, contact] of state.airslidePlayers) {
    if (ownerIndex === undefined || contact.runtime.index === ownerIndex) clearAirslide(pawn);
  }
  for (const [pawn, effect] of state.playerEffects) {
    if (ownerIndex !== undefined && !effect.owners.has(ownerIndex)) continue;
    if (ownerIndex !== undefined) {
      const prefix = `${ownerIndex}:`;
      for (const source of [...effect.gravitySources.keys()]) {
        if (!source.startsWith(prefix)) continue;
        effect.gravitySources.delete(source);
        effect.engineSources?.delete(source);
        effect.simulatedSources?.delete(source);
      }
      effect.owners.delete(ownerIndex);
      if (effect.gravitySources.size > 0) {
        applyGravitySources(pawn, effect);
        continue;
      }
    }
    if (pawn && pawn.IsValid()) setPlayerGravity(pawn, 1);
    state.playerEffects.delete(pawn);
  }
}

function addPlayerStatus(runtime, pawn, source, duration, data = {}) {
  if (!pawn?.IsValid() || !pawn.IsAlive()) return;
  let statuses = state.playerStatuses.get(pawn);
  if (!statuses) state.playerStatuses.set(pawn, statuses = new Map());
  statuses.set(source, {
    owner: runtime.index,
    until: Instance.GetGameTime() + Math.max(0, duration),
    speedCap: data.speedCap,
    speedMultiplier: data.speedMultiplier,
    nativeSpeedAdd: data.nativeSpeedAdd,
    damageScale: data.damageScale,
    blockedAttackerTeam: data.blockedAttackerTeam,
    frozenPosition: data.frozenPosition ? clone(data.frozenPosition) : undefined,
    ...(data.squidBlind === true ? { squidBlind: true } : {}),
  });
  if (data.nativeSpeedAdd !== undefined) syncNativeStatusSpeed(pawn, statuses);
  if (source.endsWith(":invincible")) syncNativeInvincibleContext(pawn, statuses);
}

function syncNativeInvincibleContext(pawn, statuses, now = Instance.GetGameTime()) {
  if (!validEntity(pawn)) return;
  const active = pawn.IsAlive?.() === true && [...statuses ?? []]
    .some(([source, status]) => source.endsWith(":invincible") && status.until > now);
  if (Boolean(pawn.collectiveInvincibleContext) === active) return;
  pawn.collectiveInvincibleContext = active;
  fireTarget(pawn, active ? "AddContext" : "RemoveContext", active ? "invincible:1" : "invincible");
}

function syncNativeStatusSpeed(pawn, statuses, now = Instance.GetGameTime()) {
  let addition = 0;
  for (const status of statuses?.values?.() ?? []) {
    if (status.until > now) addition += status.nativeSpeedAdd ?? 0;
  }
  const multiplier = Math.max(0.01, Number((1 + addition).toFixed(6)));
  const previous = state.nativeStatusSpeeds.get(pawn) ?? 1;
  if (multiplier !== previous && validEntity(pawn)) {
                                                                         
                                                                           
    fireTarget(pawn, "KeyValues", `speed ${multiplier}`);
  }
  if (multiplier === 1 || !validEntity(pawn)) state.nativeStatusSpeeds.delete(pawn);
  else state.nativeStatusSpeeds.set(pawn, multiplier);
}

function clearPlayerStatuses(ownerIndex, pawnFilter) {
  for (const [pawn, statuses] of [...state.playerStatuses]) {
    if (pawnFilter && pawn !== pawnFilter) continue;
    for (const [source, status] of [...statuses]) {
      if (ownerIndex === undefined || status.owner === ownerIndex) statuses.delete(source);
    }
    syncNativeStatusSpeed(pawn, statuses);
    syncNativeInvincibleContext(pawn, statuses);
    if (statuses.size === 0) state.playerStatuses.delete(pawn);
  }
  syncSquidBlindHud(Instance.GetGameTime(), true);
}

function processPlayerStatuses(now) {
  for (const [pawn, statuses] of [...state.playerStatuses]) {
    if (!pawn?.IsValid() || !pawn.IsAlive()) {
      syncNativeStatusSpeed(pawn);
      syncNativeInvincibleContext(pawn);
      state.playerStatuses.delete(pawn);
      continue;
    }
    let speedCap;
    let speedMultiplier = 0;
    let frozenPosition;
    for (const [source, status] of [...statuses]) {
      if (status.until <= now || (!state.levels.has(status.owner)
        && state.endingRuntime?.index !== status.owner)) {
        statuses.delete(source);
        continue;
      }
      if (status.speedCap !== undefined) speedCap = Math.min(speedCap ?? Infinity, status.speedCap);
      if (status.speedMultiplier !== undefined) speedMultiplier += status.speedMultiplier;
      if (status.frozenPosition !== undefined) frozenPosition = status.frozenPosition;
    }
    syncNativeStatusSpeed(pawn, statuses, now);
    syncNativeInvincibleContext(pawn, statuses, now);
    if (statuses.size === 0) {
      state.playerStatuses.delete(pawn);
      continue;
    }
    if (speedMultiplier !== 0) {
      const multiplierCap = 250 * Math.max(0.05, 1 + speedMultiplier);
      speedCap = Math.min(speedCap ?? Infinity, multiplierCap);
    }
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    if (frozenPosition !== undefined) {
      pawn.Teleport({ position: frozenPosition, velocity: vec() });
      continue;
    }
    if (speedCap === undefined) continue;
    const xy = Math.hypot(velocity.x, velocity.y);
    if (xy <= speedCap) continue;
    const scale = speedCap / xy;
    pawn.Teleport({ velocity: vec(velocity.x * scale, velocity.y * scale, velocity.z) });
  }
  syncSquidBlindHud(now);
}

function processPlayerEffects(now) {
  const elapsed = state.lastEffectTickAt > 0 ? Math.min(0.1, Math.max(0, now - state.lastEffectTickAt)) : 0;
  state.lastEffectTickAt = now;
  if (elapsed <= 0) return;
  for (const [pawn, effect] of [...state.playerEffects]) {
    if (!pawn?.IsValid() || !pawn.IsAlive()) {
      state.playerEffects.delete(pawn);
      continue;
    }
    if (pawn.GetGroundEntity?.()) continue;
    const simulatedValues = [...(effect.simulatedSources ?? [])]
      .map((source) => effect.gravitySources.get(source))
      .filter((gravity) => Number.isFinite(Number(gravity)));
    const gravity = simulatedValues.length > 0 ? Math.min(...simulatedValues) : 1;
    if (gravity >= 1) continue;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport({ velocity: vec(velocity.x, velocity.y, velocity.z + (1 - gravity) * CONFIG.worldGravity * elapsed) });
  }
}

function capVelocity(velocity) {
  const xy = Math.hypot(velocity.x, velocity.y);
  const scale = xy > CONFIG.gravitySlideXYVelocityCap ? CONFIG.gravitySlideXYVelocityCap / xy : 1;
  return vec(velocity.x * scale, velocity.y * scale, Math.min(velocity.z, CONFIG.gravitySlideZVelocityCap));
}

function capGravitySlideVelocity(pawn) {
  if (!pawn?.IsValid?.()) return;
  pawn.Teleport?.({ velocity: capVelocity(pawn.GetAbsVelocity?.() ?? vec()) });
}

function airslideOrigin(volume) {
  return volume?.trigger?.GetAbsOrigin?.() ?? volume?.position;
}

function validAirslideContact(pawn, contact) {
  const volume = contact?.volume;
  if (!volume || volume.active === false || !validEntity(volume.trigger)
    || contact.runtime.lifecycle === "destroyed" || !validEntity(pawn) || !pawn.IsAlive?.()) return false;
  const position = pawn.GetAbsOrigin?.();
  const origin = airslideOrigin(volume);
                                                                         
                                                                             
  return !!position && !!origin && Math.hypot(position.x - origin.x,
    position.y - origin.y, position.z - origin.z) <= CONFIG.airslideFailsafeDistance;
}

function clearAirslide(pawn) {
                                                                             
                                                                          
  if (!state.airslidePlayers.delete(pawn)) return;
  const effect = state.playerEffects.get(pawn);
  if (!effect?.engineSources?.size) return;
  if (effect.nativeGravityRestoreTask) effect.nativeGravityRestoreTask.cancelled = true;
                                                                              
                                                                            
                                                                             
  const round = state.roundBootstrapSerial;
  const task = schedule(0.02, () => {
    if (effect.nativeGravityRestoreTask === task) effect.nativeGravityRestoreTask = undefined;
    if (state.roundBootstrapSerial !== round || state.playerEffects.get(pawn) !== effect
      || !validEntity(pawn) || !pawn.IsAlive?.()) return;
    const current = state.airslidePlayers.get(pawn);
    if (current && validAirslideContact(pawn, current)) return;
    if (effect.engineSources?.size) applyGravitySources(pawn, effect);
  });
  effect.nativeGravityRestoreTask = task;
}

function refreshAirslide(pawn, contact, failsafeCheck = false) {
  if (!validAirslideContact(pawn, contact)) {
    clearAirslide(pawn);
    return;
  }
  const position = pawn.GetAbsOrigin();
  const origin = airslideOrigin(contact.volume);
  const update = { position: vec(position.x, position.y, origin.z + CONFIG.airslideHeightOffset) };
  if (!failsafeCheck) {
    const velocity = capVelocity(pawn.GetAbsVelocity?.() ?? vec());
                                                                   
    update.velocity = vec(velocity.x, velocity.y, CONFIG.airslideLift);
  }
                                                                             
  pawn.Teleport(update);
}

function activateAirslide(runtime, pawn, volume) {
  const contact = { runtime, volume };
  if (!validAirslideContact(pawn, contact)) return;
  const effect = state.playerEffects.get(pawn);
  if (effect?.nativeGravityRestoreTask) {
    effect.nativeGravityRestoreTask.cancelled = true;
    effect.nativeGravityRestoreTask = undefined;
  }
  state.airslidePlayers.set(pawn, contact);
  refreshAirslide(pawn, contact);
}

function endAirslideTouch(pawn, volume) {
  const contact = state.airslidePlayers.get(pawn);
  if (contact?.volume === volume || (contact && !validAirslideContact(pawn, contact))) clearAirslide(pawn);
  else if (contact) refreshAirslide(pawn, contact);
                                                                            
  if (!state.airslidePlayers.has(pawn) && validEntity(pawn) && pawn.IsAlive?.()) capGravitySlideVelocity(pawn);
}

function processAirslideVolumes(now) {
  if (now < state.nextAirslideRefreshAt) return;
  state.nextAirslideRefreshAt = now + CONFIG.airslideRefreshInterval;
  const disabled = [];
  for (const runtime of activeRuntimes()) {
    for (const volume of runtime.airslides ?? []) {
      if (volume.active === false || !validEntity(volume.trigger) || now < volume.nextRefreshAt) continue;
      volume.nextRefreshAt = now + CONFIG.airslideRefreshInterval;
      fireTarget(volume.trigger, "Disable");
      disabled.push(volume);
    }
  }
                                                                          
                                                                           
  if (disabled.length) schedule(CONFIG.airslideReenableDelay, () => {
    for (const volume of disabled) {
      if (volume.active !== false && validEntity(volume.trigger) && !state.fatal) fireTarget(volume.trigger, "Enable");
    }
  });
}

function processAirslideFailsafe(now) {
  if (now < state.nextAirslideFailsafeAt) return;
  state.nextAirslideFailsafeAt = now + CONFIG.airslideFailsafeInterval;
  if (state.airslideFailsafeCursor >= state.airslideFailsafeQueue.length) {
                                                                         
    state.airslideFailsafeQueue = [...state.airslidePlayers.keys()];
    state.airslideFailsafeCursor = 0;
  }
  if (!state.airslideFailsafeQueue.length) return;
  const pawn = state.airslideFailsafeQueue[state.airslideFailsafeCursor++];
  const contact = state.airslidePlayers.get(pawn);
  if (contact) refreshAirslide(pawn, contact, true);
}

function lowgravSource(runtime, request) {
  return `${runtime.index}:lowgrav:${request.position.x}:${request.position.y}:${request.position.z}`;
}

function trackLowgravContact(pawn, runtime, volume) {
  let contacts = state.lowgravContacts.get(pawn);
  if (!contacts) state.lowgravContacts.set(pawn, contacts = new Map());
  contacts.set(volume.source, { runtime, volume, trigger: volume.trigger });
}

function processLowgravFailsafe(now) {
  if (now < state.nextLowgravFailsafeAt) return;
  state.nextLowgravFailsafeAt = now + 0.01;
  if (state.lowgravFailsafeCursor >= state.lowgravFailsafeQueue.length) {
                                                                           
                                                                         
    state.lowgravFailsafeQueue = [...state.lowgravContacts.keys()];
    state.lowgravFailsafeCursor = 0;
  }
  const pawn = state.lowgravFailsafeQueue[state.lowgravFailsafeCursor++];
  const contacts = state.lowgravContacts.get(pawn);
  if (!contacts) return;
  if (!validEntity(pawn) || !pawn.IsAlive?.()) {
    state.lowgravContacts.delete(pawn);
    return;
  }
                                                                         
  if ([...state.genericEvents.active.values()].some(e => e.name === "LOWGRAV" && !e.ended)) return;
  const position = pawn.GetAbsOrigin?.();
  if (!position) return;
  for (const [source, contact] of [...contacts]) {
    const bottom = validEntity(contact.trigger) ? contact.trigger.GetAbsOrigin?.() : undefined;
    const valid = contact.volume.active !== false && contact.runtime.lifecycle !== "destroyed"
      && validEntity(contact.trigger) && bottom
                                                                            
                                                                 
      && position.z >= bottom.z - 90 && position.z <= bottom.z + 960
      && Math.abs(position.x - bottom.x) <= 130 && Math.abs(position.y - bottom.y) <= 130;
    if (!valid) removeGravitySource(pawn, source);
  }
                                                                              
}

                                                                           
                                                                            
                                                                         
function attachMovementVolumeTerrain(runtime, entity) {
  if (!validEntity(entity)) return;
  // KeyValues may be delivered through the entity I/O queue. Associate static
  // preloaded terrain by its committed placement, not its old parking position.
  const placement = entity.collectiveTerrainPlacement;
  const position = placement?.owner === runtime.index ? placement.position : entity?.GetAbsOrigin?.();
  if (!position) return;
  for (const volume of runtime.movementVolumes ?? []) {
    if (volume.active === false) continue;
    if (Math.abs(position.x - volume.position.x) <= 0.01
      && Math.abs(position.y - volume.position.y) <= 0.01
      && Math.abs(position.z - volume.position.z) <= 0.01) volume.terrain.add(entity);
  }
}

function registerMovementVolume(runtime, volume) {
  volume.active = true;
  volume.terrain ??= new Set();
  volume.outputConnections ??= new Set();
  runtime.movementVolumes ??= new Set();
  runtime.movementVolumes.add(volume);
  for (const entity of runtime.terrainEntities ?? []) attachMovementVolumeTerrain(runtime, entity);
  return volume;
}

function disableMovementVolume(runtime, volume) {
  if (!volume || volume.active === false) return;
  volume.active = false;
  if (validEntity(volume.trigger)) fireTarget(volume.trigger, "Disable");
  for (const id of volume.outputConnections ?? []) {
    if (id === undefined || id === null) continue;
    disconnectEntityOutput(id);
    runtime.outputConnections?.delete(id);
    state.outputConnections.delete(id);
  }
  volume.outputConnections?.clear();
  for (const [pawn, contact] of state.airslidePlayers) {
    if (contact.volume === volume) clearAirslide(pawn);
  }
  for (const [pawn, effect] of state.playerEffects) {
    if (effect.gravitySources.has(volume.source)) removeGravitySource(pawn, volume.source);
  }
  runtime.airslides?.delete(volume);
  runtime.movementVolumes?.delete(volume);
}

                                                                              
                                                                              
                                                                            
                                                                        
function teleportVelocity(velocity) {
  const current = velocity ?? vec();
  let z = Number(current.z ?? 0);
  if (z < -CONFIG.teleportFallInvertThreshold) z *= -1;
  z = Math.min(z, CONFIG.teleportZVelocityCap);
  return vec(Number(current.x ?? 0), Number(current.y ?? 0), z);
}

function spawnNativeHold(runtime, request, child) {
                                                                           
                                                                     
  const inverted = request.tile >= 195 && request.tile <= 198;
  const spawned = spawnRoundEntities(featureTemplate("hold"), request.position, { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  const driver = spawned[0];
  if (spawned.length !== 1 || !validEntity(driver) || driver.GetClassName?.() !== "func_movelinear") {
    destroyEntities(spawned);
    throw new Error("hold: template_movelinear must spawn exactly one func_movelinear");
  }
  runtime.entities.add(driver);
  driver.SetEntityName?.(`hold_driver_${runtime.index}_${runtime.entities.size}`);
  const anchor = spawnVisual(runtime, { ...request, feature: "holdFrame",
    angles: { pitch: 0, yaw: 0, roll: 0 } }, request.themeModel ?? "models/luffaren/collective_hold.vmdl");
  if (!validEntity(anchor) || !validEntity(child)) throw new Error("hold: native child/frame did not spawn");
  const hide = () => {
    if (!validEntity(anchor)) return;
    fireTarget(anchor, "TurnOff");
    fireTarget(anchor, "TurnOff", undefined, 0.05);
    fireTarget(anchor, "DisableShadow");
  };
  hide();
  const themeRecord = state.silentHillWorld.visuals.get(anchor);
  if (themeRecord) themeRecord.restore = hide;
                                                                           
                                                                           
  driver.SetParent(anchor);
  driver.Teleport({ position: clone(request.position), angles: { pitch: 0, yaw: 0, roll: 0 }, velocity: vec() });
  fireTarget(driver, "ResetPosition", "0");
  anchor.Teleport({ position: clone(request.position), angles: { pitch: inverted ? -90 : 90, yaw: 0, roll: 0 }, velocity: vec() });
  child.SetParent(driver);
  child.Teleport({ position: add(request.position, vec(0, 0, inverted ? -148 : 0)), angles: request.angles, velocity: vec() });
  fireTarget(driver, "SetMoveDistanceFromStart", "148");
                                                                      
  fireTarget(driver, "SetSpeed", "100");
  const hold = { kind: "nativeHold", runtime, child, driver, anchor, inverted,
    opened: false, retiring: false };
  runtime.nativeHolds ??= new Set();
  runtime.nativeHolds.add(hold);
                                                                        
                                                                       
                                                                         
                                                                           
                                                                             
                                                                              
  return hold;
}

function openHoldEntity(entity, retire = false) {
  if (entity?.kind === "nativeHold") {
    const hold = entity;
    if (hold.runtime.lifecycle === "destroyed" || !validEntity(hold.driver)) return;
    if (retire && hold.inverted) {
      if (hold.retiring) return;
      hold.retiring = true;
      hold.opened = true;
      fireTarget(hold.driver, "Open");
      for (const delay of [0, 0.1, 0.2, 0.5, 1]) fireTarget(hold.driver, "Close", undefined, delay);
    } else if (!hold.opened) {
      hold.opened = true;
      fireTarget(hold.driver, "Open");
    }
    return;
  }
                                                                          
  if (!entity || !entity.IsValid()) return;
  entity.Kill();
}

function openHoldGroup(runtime, group) {
  for (const hold of runtime.holds.get(group) ?? []) openHoldEntity(hold);
}

function registerBlockInteraction(runtime, request) {
  runtime.blockInteractions ??= new Map();
  const existing = runtime.blockInteractions.get(request.interactionId);
  if (existing) return existing;
  const record = {
    id: runtime.blockInteractions.size + 1,
    feature: request.feature,
    group: request.group,
    position: clone(request.position),
    entities: new Set(),
    connections: new Set(),
    used: false,
    opened: false,
  };
  runtime.blockInteractions.set(record.id, record);
                                                                            
                                                                             
  if (request.feature !== "genericHold") {
    runtime.remainingBlockButtons ??= new Map();
    const key = request.feature === "endButton" ? "end" : request.group;
    runtime.remainingBlockButtons.set(key, (runtime.remainingBlockButtons.get(key) ?? 0) + 1);
  }
  return record;
}

function clearBlockInteraction(runtime, record) {
  record.opened = true;
  for (const entity of record.entities) {
    if (validEntity(entity)) entity.Kill();
    runtime.entities.delete(entity);
    runtime.buttons.delete(entity);
  }
  record.entities.clear();
  for (const id of record.connections) {
    disconnectEntityOutput(id);
    runtime.outputConnections.delete(id);
    state.outputConnections.delete(id);
  }
  record.connections.clear();
}

function disconnectBlockUse(runtime, record) {
                                                                       
                                                                         
  for (const id of record.connections) {
    disconnectEntityOutput(id);
    runtime.outputConnections.delete(id);
    state.outputConnections.delete(id);
  }
  record.connections.clear();
}

function openGenericHold(runtime, record) {
  if (runtime.lifecycle === "destroyed" || record.opened) return;
  if (!record.door) return clearBlockInteraction(runtime, record);
  record.opened = true;
  disconnectBlockUse(runtime, record);
  openHoldEntity(record.door);
}

function startGenericHoldGroup(runtime, record, announceCountdown = true) {
  const connected = connectedGenericHolds(runtime, record);
  if (connected.every(member => member.used)) return;
  for (const member of connected) {
    member.used = true;
    disconnectBlockUse(runtime, member);
  }
  const openTime = stageSnapshotForRuntime(runtime).genericHoldTime;
                                                                         
                                                                  
  if (announceCountdown) announce(`Level ${runtime.index}: defend for ${openTime} seconds`);
  schedule(openTime, () => {
    if (runtime.lifecycle === "destroyed" || runtime.interactionsRetired) return;
    for (const member of connected) openGenericHold(runtime, member);
    if (announceCountdown) announce(`Level ${runtime.index}: generic hold opened`);
  }, runtime.index);
}

function connectedGenericHolds(runtime, start) {
                                                                          
                                                                           
                                                               
  const candidates = [...runtime.blockInteractions.values()]
    .filter(record => record.feature === "genericHold" && !record.opened);
  const visited = new Set([start]);
  const connected = [start];
  for (let index = 0; index < connected.length; index++) {
    const origin = connected[index].position;
    for (const candidate of candidates) {
      if (visited.has(candidate)) continue;
      const delta = sub(candidate.position, origin);
      if (delta.x * delta.x + delta.y * delta.y + delta.z * delta.z > 100 * 100) continue;
      visited.add(candidate);
      connected.push(candidate);
    }
  }
  return connected;
}

function retireInteractions(runtime) {
  if (runtime.interactionsRetired) return;
  for (const record of runtime.blockInteractions?.values() ?? []) {
    if (record.feature === "genericHold") {
      if (!record.opened) startGenericHoldGroup(runtime, record, false);
                                                                      
      schedule(0.05, () => openGenericHold(runtime, record), runtime.index);
    } else clearBlockInteraction(runtime, record);
  }
  for (const holds of runtime.holds.values()) for (const hold of holds) openHoldEntity(hold, true);
  const genericButtons = new Set([...runtime.blockInteractions?.values() ?? []]
    .filter(record => record.feature === "genericHold").map(record => record.button));
  for (const entity of [...runtime.buttons]) {
    if (genericButtons.has(entity)) continue;
    if (validEntity(entity)) entity.Kill();
    runtime.buttons.delete(entity);
  }
  for (const entity of runtime.breakables) if (validEntity(entity)) entity.Kill();
  runtime.breakables.clear();
  runtime.interactionsRetired = true;
}

function featureTemplate(name) {
  const template = state.featureTemplates.get(name);
  if (!template || !template.IsValid()) throw new Error(`feature template '${name}' became invalid`);
  return template;
}

function lowgravTemplateKey(tile) {
  const preferred = tile === 140 ? "lowgravFloor" : "lowgrav";
  let template = state.featureTemplates.get(preferred);
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
    template = Instance.FindEntityByName(FEATURE_TEMPLATE_NAMES[preferred]);
    if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
      throw new Error(`LOWGRAV tile=${tile}: ${FEATURE_TEMPLATE_NAMES[preferred]} is missing or is not a point_template`);
    }
    state.featureTemplates.set(preferred, template);
  }
  return preferred;
}

function airslideTemplateKey() {
  let template = state.featureTemplates.get("airslide");
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
    template = Instance.FindEntityByName(FEATURE_TEMPLATE_NAMES.airslide);
    if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
      throw new Error("AIRSLIDE: template_airslide is missing or is not a point_template; recompile the updated VMAP");
    }
    state.featureTemplates.set("airslide", template);
  }
  return "airslide";
}

function lowgravTriggerPosition(runtime, request) {
  if (!request?.position) throw new Error("LOWGRAV: missing pixel anchor for trigger placement");
                                                                          
                                                                            
  if (Number.isFinite(runtime?.sourceGenerationOrigin?.z)) {
    return vec(request.position.x, request.position.y, runtime.sourceGenerationOrigin.z - 60);
  }
                                                                                
  return clone(request.triggerPosition ?? request.position);
}

function finalizeSpawned(runtime, request, spawned, preserveTemplateTransforms = false) {
  for (const entity of spawned) if (entity) runtime.entities.add(entity);
  for (const entity of spawned) {
    if (!entity || !entity.IsValid()) continue;
    if (!preserveTemplateTransforms) {
      entity.Teleport({ position: request.position, angles: request.angles, velocity: vec() });
    }
    entity.SetEntityName(`block_${runtime.index}_${request.feature}`);
    runtime.entities.add(entity);
  }
}

function terrainRenderAlpha(entity, baseAlpha = 255) {
  return Math.round(baseAlpha * Math.min(entity.collectiveSpawnFadeAlpha ?? 255,
    entity.collectiveRetireAlpha ?? 255) / 255);
}

function applyTerrainAppearance(entity, bodyGroup, renderColor) {
  if (!validEntity(entity)) return;
  const color = colorToEntityColor(renderColor) ?? { r: 255, g: 255, b: 255, a: 255 };
  const apply = () => {
    if (!validEntity(entity)) return;
    entity.collectiveBaseColor = color;
    entity.collectiveBodyGroup = bodyGroup;
    entity.SetColor?.({ ...color, a: terrainRenderAlpha(entity, color.a) });
                                                                           
                                                                     
    fireTarget(entity, "SetBodyGroup", `Main,${bodyGroup}`);
  };
                                                                             
                                                                   
  apply();
  afterThink(apply);
}

function beginTerrainSpawnFade(entity, runtime) {
  if (!validEntity(entity) || typeof entity.SetColor !== "function") return;
  const fast = state.finaleEscapeActive === true;
  const color = entity.collectiveBaseColor ?? entity.GetColor?.() ?? { r: 255, g: 255, b: 255, a: 255 };
  if (!CONFIG.ordinaryTerrainSpawnFadeEnabled && !fast && !state.debugAllModelsMode
    && !runtime.raceLevel && !runtime.kind) {
    state.terrainSpawnFades.delete(entity);
    entity.collectiveSpawnFadeAlpha = undefined;
    entity.SetColor({ ...color, a: terrainRenderAlpha(entity, color.a ?? 255) });
    return;
  }
  entity.collectiveSpawnFadeAlpha = 0;
  entity.SetColor({ ...color, a: 0 });
  state.terrainSpawnFades.set(entity, { owner: runtime.index, color: { ...color },
    startedAt: Instance.GetGameTime(), interval: fast ? 0.03 : CONFIG.spawnFadeInterval,
    step: fast ? 50 : CONFIG.spawnFadeStep, lastStep: 0 });
}

function processTerrainSpawnFades(now) {
  for (const [entity, fade] of state.terrainSpawnFades) {
    if (!validEntity(entity) || !state.levels.has(fade.owner)) {
      state.terrainSpawnFades.delete(entity);
      continue;
    }
    const step = Math.floor((now - fade.startedAt + 1e-6) / fade.interval);
    if (step === fade.lastStep) continue;
    fade.lastStep = step;
    const alpha = Math.min(255, step * fade.step);
    entity.collectiveSpawnFadeAlpha = alpha === 255 ? undefined : alpha;
                                                                          
    if (state.levels.get(fade.owner)?.lifecycle !== "fading")
      entity.SetColor({ ...fade.color, a: Math.round(fade.color.a * alpha / 255) });
    if (alpha === 255) state.terrainSpawnFades.delete(entity);
  }
}

function applyBoostPadAppearance(entity, request) {
  if (!validEntity(entity)) return;
                                                                        
                                                                         
                                                                
  const bodyGroup = request.tile === 125 ? 0 : 1;
                                                                          
                                                                             
                                                                       
  const visualAngles = request.angles;
  const apply = () => {
    if (!validEntity(entity)) return;
                                                                           
                                
    // Source template_boostpad PreSpawnInstance sets only model/spawnflags/rendermode: the pad
    // stays white in every theme. The GENERIC tint belongs to the separate base floor block.
    const color = { r: 255, g: 255, b: 255, a: 255 };
    entity.collectiveBaseColor = color;
    entity.SetColor?.(color);
    fireTarget(entity, "SetBodyGroup", `TYPES,${bodyGroup}`);
                                                                               
                                                                               
                                                                   
    entity.Teleport?.({ position: request.position, angles: visualAngles, velocity: vec() });
  };
  apply();
  afterThink(apply);
}

function applyThemeSkin(entity, skin) {
  if (!validEntity(entity) || skin === undefined) return;
  const numericSkin = Number(skin);
  if (!Number.isFinite(numericSkin)) return;
  const normalizedSkin = Math.max(0, Math.floor(numericSkin));
  const skinValue = String(normalizedSkin);
                                                                         
                                                                             
                                                                           
                                                                         
  fireTarget(entity, "Skin", skinValue);
  fireTarget(entity, "Skin", skinValue, 0.05);
}

function spawnModelBlock(runtime, request, model, health = 0, terrainBodyGroup) {
                                                                          
                                                                          
                                                                 
  const template = state.templates.get("floor");
  if (!template || !template.IsValid()) throw new Error("terrain floor template became invalid");
  const spawned = spawnRoundEntities(template, request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
  let block;
  for (const entity of spawned) {
    if (!entity || !entity.IsValid()) continue;
    if (entity.GetClassName?.().startsWith("trigger_")) {
      entity.Kill();
      runtime.entities.delete(entity);
      continue;
    }
    block = entity;
    if (typeof entity.SetModel === "function") entity.SetModel(rememberSilentHillVisual(runtime, entity, model, request));
    if (terrainBodyGroup !== undefined) {
      applyTerrainAppearance(entity, terrainBodyGroup);
      const record = state.silentHillWorld.visuals.get(entity);
      if (record) record.restore = () => applyTerrainAppearance(entity, terrainBodyGroup);
    }
    if (health > 0) {
      entity.SetMaxHealth?.(health);
      entity.SetHealth(health);
    }
  }
  return block;
}

                                                                             
                                                                              
                                                               
const BREAKABLE_NATIVE_HEALTH = 1000000;
let breakableFxTimes = [];

function playBreakableAudio(runtime, block, broken) {
                                                                              
                                                                          
  const now = Instance.GetGameTime();
  breakableFxTimes = breakableFxTimes.filter(at => at <= now && at + 0.01 > now);
  if (breakableFxTimes.length > 5) return;
  breakableFxTimes.push(now);
  playSourceAudioCue(broken ? 20620 : 20630,
    add(block.GetAbsOrigin(), vec(0, 0, 50)), { owner: runtime.index });
}

function spawnBreakableGibs(runtime, position) {
  const template = state.featureTemplates.get("breakableFx");
  if (!validEntity(template)) return;
  const request = { position, angles: { pitch: 0, yaw: Math.floor(Math.random() * 4) * 90, roll: 0 },
    feature: "breakableGibs" };
  const spawned = spawnRoundEntities(template, request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
  for (const visual of spawned) {
    if (!validEntity(visual)) continue;
    fireTarget(visual, "SetAnimation", "break");
    fireTarget(visual, "SetPlaybackRate", String(0.7 + Math.random() * 0.2), 0.02);
    fireTarget(visual, "FadeAndKill", "1", 1);
    schedule(1.98, () => {
      if (validEntity(visual)) visual.Kill();
      runtime.entities.delete(visual);
    }, runtime.index);
  }
}

function spawnBreakableBlock(runtime, request, model) {
  const spawned = spawnRoundEntities(featureTemplate("breakable"), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
                                                                         
                                                                          
                                                                       
  const block = spawned.find(entity => validEntity(entity)
    && ["prop_dynamic", "prop_dynamic_override"].includes(String(entity.GetClassName?.() ?? "").toLowerCase()));
  if (!block) {
    const classes = spawned.map(entity => validEntity(entity)
      ? String(entity.GetClassName?.() ?? "unknown") : "invalid");
    throw new Error(`breakable damageable prototype did not spawn: template_breakable returned ${spawned.length} entities [${classes.join(", ")}]; expected prop_dynamic/prop_dynamic_override`);
  }
  block.SetModel(rememberSilentHillVisual(runtime, block, model, request));
  const baseColor = request.renderColor ?? (request.themeName === "generic"
    ? { r: 136, g: 84, b: 55, a: 255 } : { r: 255, g: 255, b: 255, a: 255 });
  applyTerrainAppearance(block, 1, baseColor);
  const record = state.silentHillWorld.visuals.get(block);
  if (record) record.restore = () => applyTerrainAppearance(block, 1, baseColor);
  runtime.breakables.add(block);
  const stage = stageSnapshotForRuntime(runtime);
  let hits = Math.max(1, CONFIG.breakableHealthBase
    + Math.floor((stage.breakableHealthMultiplier ?? 1) * allPlayerPawns().length));
  let flashUntil = -Infinity;
  let repairQueued = false;
  const active = () => validEntity(block) && runtime.breakables.has(block);
  const repairNativeHealth = () => {
    repairQueued = false;
    if (!active()) return;
    block.SetMaxHealth?.(BREAKABLE_NATIVE_HEALTH);
    block.SetHealth(BREAKABLE_NATIVE_HEALTH);
  };
  repairNativeHealth();
  afterThink(repairNativeHealth);
  connectOwnedOutput(runtime, block, "OnTakeDamage", () => {
    if (!active()) return;
                                                                           
    if (--hits <= 0) {
      const position = block.GetAbsOrigin();
      runtime.breakables.delete(block);
      playBreakableAudio(runtime, block, true);
      block.Kill();
      runtime.entities.delete(block);
      state.silentHillWorld.visuals.delete(block);
      spawnBreakableGibs(runtime, position);
      return;
    }
                                                                           
                                                                           
    if (!repairQueued) {
      repairQueued = true;
      afterThink(repairNativeHealth);
    }
    const now = Instance.GetGameTime();
    if (now < flashUntil) return;
    flashUntil = now + 0.15;
    block.SetColor?.({ r: 255, g: 100, b: 100, a: 255 });
    schedule(0.05, () => {
      if (active()) block.SetColor?.(block.collectiveBaseColor ?? baseColor);
    }, runtime.index);
    playBreakableAudio(runtime, block, false);
  });
  connectOwnedOutput(runtime, block, "OnBreak", () => runtime.breakables.delete(block));
  return block;
}

function detachAndRetireTemplateHelper(runtime, child, helper) {
  if (!validEntity(helper)) return;
                                                                            
                                                                            
                                                                              
  if (validEntity(child)) fireTarget(child, "ClearParent");
  afterThink(() => {
    if (validEntity(helper)) helper.Kill();
    runtime.entities.delete(helper);
  });
}

function spawnBakedClimb(runtime, request) {
  const quadrant = ((Math.round(normalizeYaw(request.angles.yaw) / 90) * 90) % 360 + 360) % 360;
  const prefix = request.tile === 4 ? "climbhard" : "climb";
  const template = featureTemplate(`${prefix}${quadrant}`);
  const spawned = spawnRoundEntities(template, request.position) ?? [];
  let visual;
  for (const entity of spawned) {
    if (!entity?.IsValid()) continue;
    if (request.themeModel) {
      if (typeof entity.SetModel !== "function") throw new Error(`${request.feature}: themed climb model replacement is unavailable`);
      entity.SetModel(rememberSilentHillVisual(runtime, entity, request.themeModel, request));
      applyTerrainAppearance(entity, 0, request.renderColor);
      const record = state.silentHillWorld.visuals.get(entity);
      if (record) record.restore = () => applyTerrainAppearance(entity, 0, request.renderColor);
    }
    entity.SetEntityName(`block_${runtime.index}_${request.feature}`);
    runtime.entities.add(entity);
    visual ??= entity;
  }
  if (!visual) throw new Error(`${request.feature}: baked ${prefix} prototype did not spawn`);
  return visual;
}

function spawnTriggerFeature(runtime, request) {
  const templateKind = request.feature === "lowgrav"
    ? lowgravTemplateKey(request.tile)
    : request.feature === "airslide" ? airslideTemplateKey() : "trigger";
  const triggerRequest = request.feature === "lowgrav"
    ? { ...request, position: lowgravTriggerPosition(runtime, request), angles: { pitch: 0, yaw: 0, roll: 0 } }
    : request.feature === "airslide"
      ? { ...request, angles: { pitch: 0, yaw: 0, roll: 0 } }
      : request;
  const spawned = spawnRoundEntities(featureTemplate(templateKind), triggerRequest.position, triggerRequest.angles) ?? [];
                                                                          
                                                                            
                                                                          
                                                                           
                                                                          
  finalizeSpawned(runtime, triggerRequest, spawned, request.feature === "boost");
  const trigger = spawned.find((entity) => entity?.IsValid() && entity.GetClassName?.().startsWith("trigger_"));
  const visual = spawned.find((entity) => entity?.IsValid() && !entity.GetClassName?.().startsWith("trigger_"));
  if (!trigger) throw new Error(`${request.feature}: trigger prototype did not spawn`);
  if (request.feature === "airslide" && trigger.GetClassName?.() !== "trigger_gravity") {
    throw new Error("AIRSLIDE: template_airslide must spawn trigger_gravity; recompile the updated VMAP");
  }
  if (request.feature === "boost" && visual && request.themeModel) {
    visual.SetModel?.(rememberSilentHillVisual(runtime, visual, request.themeModel, request));
    applyBoostPadAppearance(visual, request);
    const record = state.silentHillWorld.visuals.get(visual);
    if (record) record.restore = () => applyBoostPadAppearance(visual, request);
  }
                                                                       
                                                                   
  if (request.feature !== "boost" && request.feature !== "teleport") detachAndRetireTemplateHelper(runtime, trigger, visual);
  if (request.feature === "teleport") {
    const entry = {
      position: clone(request.position), trigger, group: request.group,
      touches: 0, teleports: 0, bounces: 0, invalidActivators: 0,
      ready: false,
    };
    if (runtime.debugTeleport) {
      entry.mode = DEBUG_DATA.teleportLanes.find((lane) => lane.group === request.group)?.mode;
      trigger.SetEntityName(`debug_teleport_${entry.mode}_trigger`);
    } else {
      trigger.SetEntityName(`block_${runtime.index}_teleport_${request.group}_${runtime.teleportEntries?.size ?? 0}`);
    }
    runtime.teleportEntries ??= new Set();
    runtime.teleportEntries.add(entry);
    trigger.__teleportEntry = entry;
    const triggerPosition = add(request.position, vec(0, 0, CONFIG.teleportTriggerZOffset));
    const placeTrigger = () => {
      if (!validEntity(trigger)) return;
                                                                       
                                                                           
                                                                  
      if (typeof trigger.SetParent === "function") trigger.SetParent(undefined);
      else fireTarget(trigger, "ClearParent");
      trigger.Teleport({ position: triggerPosition, angles: request.angles, velocity: vec() });
    };
    fireTarget(trigger, "Disable");
    placeTrigger();
    afterThink(() => {
      if (!validEntity(trigger) || runtime.lifecycle === "destroyed") return;
      placeTrigger();
      if (validEntity(visual)) {
                                                                           
                                                                            
        if (typeof trigger.SetParent === "function") visual.Kill();
        else fireTarget(visual, "Kill", undefined, 0.05);
        runtime.entities.delete(visual);
      }
      fireTarget(trigger, "Enable");
                                                                           
                                                                        
      fireTarget(trigger, "Enable", undefined, 0.05);
      entry.ready = true;
    });
    spawnVisual(runtime, { ...request, feature: "teleportVisual" }, request.themeModel ?? TELEPORT_MODEL);
  }
  if (request.feature === "boost") {
    const pad = { trigger, request, cooldowns: new Map(), pendingLaunches: new Map() };
    runtime.boostPads ??= new Set();
    runtime.boostPads.add(pad);
    connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      touchBoostPad(runtime, pad, resolvePawn(data?.activator));
    });
  } else if (request.feature === "teleport") {
    const connection = connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      const entry = trigger.__teleportEntry;
      entry.touches++;
      entry.lastTouchAt = Instance.GetGameTime();
      if (runtime.debugTeleport) {
        message(`[TELEPORT DEBUG] ${entry.mode} OnStartTouch count=${entry.touches}`);
      }
      const pawn = resolvePawn(data?.activator);
      const destinations = runtime.teleportDestinations.get(request.group) ?? [];
      if (!pawn || !pawn.IsAlive()) {
        entry.invalidActivators++;
        if (runtime.debugTeleport) message(`[TELEPORT DEBUG] ${entry.mode} activator is not a living player`);
        return;
      }
                                                                         
                                                                          
                                                                         
      state.teleportEntryFallDamageTokens.set(
        pawn,
        Instance.GetGameTime() + CONFIG.teleportEntryDamageCancelWindow,
      );
      const inputVelocity = pawn.GetAbsVelocity?.() ?? vec();
      const velocity = teleportVelocity(inputVelocity);
      const bounced = inputVelocity.z < -CONFIG.teleportFallInvertThreshold;
      if (destinations.length === 0) {
                                                                          
                                                                  
        pawn.Teleport({ velocity });
        if (bounced) playSourceAudioCue(18194, request.position, { recipient: pawn });
        entry.bounces++;
        return;
      }
                                                                            
                                                                             
      pawn.Teleport({ position: destinations[Math.floor(Math.random() * destinations.length)], velocity });
      playSourceAudioCue(bounced ? 18200 : 18202, request.position, { recipient: pawn });
      entry.teleports++;
      if (runtime.debugTeleport) {
        message(`[TELEPORT DEBUG] ${entry.mode} teleport=${entry.teleports}`
          + ` velocity ${formatVector(inputVelocity)} -> ${formatVector(velocity)}`);
      }
    });
    trigger.__teleportEntry.connection = connection;
  } else if (request.feature === "airslide") {
                                                                              
    const volume = registerMovementVolume(runtime, {
      position: clone(request.position),
      trigger,
      nextRefreshAt: Instance.GetGameTime() + CONFIG.airslideRefreshStartDelay,
    });
    runtime.airslides ??= new Set();
    runtime.airslides.add(volume);
    trigger.__airslideVolume = volume;
    volume.outputConnections.add(connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      if (volume.active) activateAirslide(runtime, resolvePawn(data?.activator), volume);
    }));
    volume.outputConnections.add(connectOwnedOutput(runtime, trigger, "OnEndTouch", (data) => {
      if (volume.active) endAirslideTouch(resolvePawn(data?.activator), volume);
    }));
    if (request.themeModel) {
      const airslideVisual = spawnVisual(runtime, { ...request, feature: "airslideVisual" }, request.themeModel);
      if (validEntity(airslideVisual)) {
        volume.terrain.add(airslideVisual);
        trigger.SetParent?.(airslideVisual);
        trigger.Teleport({ position: request.position, angles: triggerRequest.angles, velocity: vec() });
      }
    }
  } else if (request.feature === "lowgrav") {
                                                                              
                                                                           
                                                                              
    const gravitySource = lowgravSource(runtime, request);
    const volume = registerMovementVolume(runtime, {
      position: clone(request.position), source: gravitySource, trigger,
    });
    trigger.__lowgravVolume = volume;
    runtime.lowgravSpawnCounts ??= {};
    const count = runtime.lowgravSpawnCounts[request.tile] = (runtime.lowgravSpawnCounts[request.tile] ?? 0) + 1;
    const entityName = `block_${runtime.index}_lowgrav_${request.tile}_${count}`;
    trigger.SetEntityName(entityName);
    volume.outputConnections.add(connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      if (!volume.active) return;
      const pawn = resolvePawn(data?.activator);
      if (!pawn || !pawn.IsAlive()) return;
      trackLowgravContact(pawn, runtime, volume);
      addGravitySource(runtime, pawn, gravitySource, CONFIG.lowGravity, {
        engine: true,
        simulate: false,
      });
      capGravitySlideVelocity(pawn);
      runtime.lowgravTouchLogged ??= new Set();
      if (!runtime.lowgravTouchLogged.has(request.tile)) {
        runtime.lowgravTouchLogged.add(request.tile);
        message(`[LOWGRAV] touch entity=${entityName} KeyValues gravity ${CONFIG.lowGravity}`);
      }
    }));
    volume.outputConnections.add(connectOwnedOutput(runtime, trigger, "OnEndTouch", (data) => {
      const pawn = resolvePawn(data?.activator);
      removeGravitySource(pawn, gravitySource);
      capGravitySlideVelocity(pawn);
    }));
    if (count === 1) {
      const p = trigger.GetAbsOrigin?.() ?? triggerRequest.position;
      message(`[LOWGRAV] spawned level=${runtime.index} tile=${request.tile} template=${FEATURE_TEMPLATE_NAMES[templateKind]} entity=${entityName} origin=${p.x},${p.y},${p.z} zRange=${p.z}..${p.z + 960}`);
    }
  } else {
    const gravitySource = `${runtime.index}:${request.feature}:${request.position.x}:${request.position.y}`;
    connectOwnedOutput(runtime, trigger, "OnStartTouch", (data) => {
      const pawn = resolvePawn(data?.activator);
      if (!pawn) return;
      addGravitySource(runtime, pawn, gravitySource, CONFIG.lowGravity, { engine: true, simulate: false });
    });
    connectOwnedOutput(runtime, trigger, "OnEndTouch", (data) => removeGravitySource(resolvePawn(data?.activator), gravitySource));
  }
  if (request.feature === "boost" || request.feature === "airslide") fireTarget(trigger, "Enable", undefined, 0.05);
  else if (request.feature !== "teleport") fireTarget(trigger, "Enable");
  if (request.feature === "lowgrav" && request.themeModel) {
                                                                            
                                                                             
                                                                           
    const visual = spawnVisual(runtime, { ...request, feature: "lowgravVisual" }, request.themeModel);
    if (validEntity(visual)) trigger.__lowgravVolume.terrain.add(visual);
    if (request.themeName === "generic" && request.tile === 140) {
                                                                  
                                                                       
                                                              
      const floorTint = { r: 196, g: 188, b: 254, a: 255 };
      visual?.SetColor?.(floorTint);
      afterThink(() => { if (validEntity(visual)) visual.SetColor?.(floorTint); });
    }
  }
  return trigger;
}

function boostPadActive(runtime, pad) {
  return !state.fatal && validEntity(pad.trigger) && runtime.boostPads?.has(pad)
    && !["outcome_pending", "resolved", "destroyed"].includes(runtime.lifecycle);
}

function touchBoostPad(runtime, pad, pawn) {
  if (!boostPadActive(runtime, pad) || !validEntity(pawn) || !pawn.IsAlive()) return;
  const now = Instance.GetGameTime();
  if ((pad.cooldowns.get(pawn) ?? -Infinity) > now) return;
  pad.cooldowns.set(pawn, now + CONFIG.boostCooldown);
  const { request, trigger } = pad;
  const team = pawn.GetTeamNumber();
  const current = pawn.GetAbsVelocity?.() ?? vec();
  const xy = Math.hypot(current.x, current.y);
  const scale = xy > CONFIG.boostJumpMaxXY ? CONFIG.boostJumpMaxXY / xy : 1;
                                                                         
                                                                         
  pawn.Teleport({
    position: clone(trigger.GetAbsOrigin?.() ?? request.position),
    velocity: request.tile === 125 ? vec(current.x * scale, current.y * scale, 0) : vec(),
  });
  const task = schedule(CONFIG.boostPostDelay, () => {
    if (pad.pendingLaunches.get(pawn) !== task) return;
    pad.pendingLaunches.delete(pawn);
    if (!boostPadActive(runtime, pad) || !validEntity(pawn) || !pawn.IsAlive()
      || pawn.GetTeamNumber() !== team) return;
    const position = clone(trigger.GetAbsOrigin?.() ?? request.position);
    const velocity = request.tile === 125
      ? pawn.GetAbsVelocity?.() ?? vec() : vec();
    pawn.Teleport({
      position,
      velocity: request.tile === 125 ? vec(velocity.x, velocity.y, CONFIG.boostJumpZ)
        : add(mul(boostDirection(request.tile, runtime.incoming, request.mirrored), CONFIG.boostDirectionalXY),
          vec(0, 0, CONFIG.boostDirectionalZ)),
    });
    playSourceAudioCue(21409, position, { recipient: pawn });
  }, runtime.owner ?? runtime.index);
  pad.pendingLaunches.set(pawn, task);
}

function clearBoostPads(runtime, pawn) {
  for (const pad of runtime.boostPads ?? []) {
    for (const [player, task] of pad.pendingLaunches) {
      if (pawn !== undefined && player !== pawn) continue;
      task.cancelled = true;
      pad.pendingLaunches.delete(player);
    }
    if (pawn === undefined) pad.cooldowns.clear();
    else pad.cooldowns.delete(pawn);
  }
  if (pawn === undefined) runtime.boostPads?.clear();
}

function spawnButtonFeature(runtime, request) {
  const record = registerBlockInteraction(runtime, request);
                                                                                      
                                                                                 
  const smallButton = request.feature === "button" || request.feature === "endButton";
  const templateKey = smallButton ? "doorButton" : "button";
  const spawned = spawnRoundEntities(featureTemplate(templateKey), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
  for (const entity of spawned) if (validEntity(entity)) record.entities.add(entity);
  const button = spawned[0];
  const output = smallButton ? "OnPressed" : "OnPlayerUse";
  const expectedClass = smallButton ? "func_button" : "func_physbox";
  if (spawned.length !== 1 || !validEntity(button) || button.GetClassName?.() !== expectedClass) {
    for (const entity of spawned) {
      if (validEntity(entity)) entity.Kill();
      runtime.entities.delete(entity);
      record.entities.delete(entity);
    }
    throw new Error(`${request.feature}: ${FEATURE_TEMPLATE_NAMES[templateKey]} must spawn exactly one ${expectedClass}`);
  }
  if (smallButton) {
    const beforeVisual = new Set(runtime.entities);
    const visual = spawnVisual(runtime, request, request.themeModel ?? "models/luffaren/collective_button.vmdl");
    for (const entity of runtime.entities) if (!beforeVisual.has(entity)) record.entities.add(entity);
    if (!validEntity(visual)) throw new Error(`${request.feature}: button visual did not spawn`);
    record.visual = visual;
    applyTerrainAppearance(visual, 0, request.renderColor);
    const silentHillRecord = state.silentHillWorld.visuals.get(visual);
    if (silentHillRecord) silentHillRecord.restore = () => applyTerrainAppearance(visual, 0, request.renderColor);
  } else if (request.themeModel) {
    if (typeof button.SetModel === "function") {
      button.SetModel(rememberSilentHillVisual(runtime, button, request.themeModel, request));
    } else {
      throw new Error(`${request.feature}: interaction prototype cannot display its themed model`);
    }
  }
  runtime.buttons.add(button);
  button.SetEntityName?.(`block_${runtime.index}_${request.feature}_${record.id}_use`);
  record.visual?.SetEntityName?.(`block_${runtime.index}_${request.feature}_${record.id}_visual`);
  record.button = button;
  record.output = output;
  if (request.feature === "genericHold") {
                                                                         
                                                                             
    record.door = spawnNativeHold(runtime, request, button);
  }
  const press = () => {
    if (record.used || record.opened || runtime.interactionsRetired || runtime.lifecycle === "destroyed") return;
    if (request.feature === "genericHold") {
      startGenericHoldGroup(runtime, record);
      return;
    }
    record.used = true;
    disconnectBlockUse(runtime, record);
    if (request.feature === "button") {
                                                                       
                                                                            
      clearBlockInteraction(runtime, record);
      const remaining = Math.max(0, (runtime.remainingBlockButtons.get(request.group) ?? 1) - 1);
      runtime.remainingBlockButtons.set(request.group, remaining);
      if (remaining > 0) return;
      const stage = stageSnapshotForRuntime(runtime);
      const open = () => {
        if (runtime.lifecycle === "destroyed" || runtime.interactionsRetired) return;
        openHoldGroup(runtime, request.group);
        announce(`Level ${runtime.index}: hold ${request.group} opened`);
      };
      if (stage.holdOpenTime > 0) schedule(stage.holdOpenTime, open, runtime.index);
      else open();
    } else if (request.feature === "endButton") {
                                                                           
                                                                          
                                                                             
      clearBlockInteraction(runtime, record);
      const remaining = Math.max(0, (runtime.remainingBlockButtons.get("end") ?? 1) - 1);
      runtime.remainingBlockButtons.set("end", remaining);
      if (remaining === 0 && state.currentLevel === runtime && Instance.GetGameTime() >= state.endLockedUntil) reachEnd();
    }
  };
  record.press = press;
  const connection = connectOwnedOutput(runtime, button, output, press);
  if (connection !== undefined && connection !== null) record.connections.add(connection);
                                                                          
                                                                   
  if (runtime.interactionsRetired) {
    record.used = true;
    if (request.feature === "genericHold") {
      record.opened = false;
      openGenericHold(runtime, record);
    } else clearBlockInteraction(runtime, record);
  } else if (record.opened && request.feature === "genericHold") {
    record.opened = false;
    openGenericHold(runtime, record);
  } else if (record.opened) clearBlockInteraction(runtime, record);
  else if (record.used) disconnectBlockUse(runtime, record);
}

function applyLiquidAppearance(entity, request) {
  if (!validEntity(entity)) return;
  const isFallModel = request.fall === true || request.themeShape === "liquid_fall";
  const isStreamModel = request.themeShape === "liquid_stream"
    || /collective_liquid_stream(?:[a-z0-9_]*)?\.vmdl$/i.test(request.model ?? "");
                                                                        
                                                                           
                                                                      
  if (!isFallModel) {
    const groups = ["TOP", "RIGHT", "LEFT", "FORWARD", "BACK", "body"];
    const counts = isStreamModel ? [3, 2, 2, 2, 2, 1] : [2, 2, 2, 2, 2, 1];
    const choices = [];
    let packed = Number(request.body ?? 31);
    for (const count of counts) {
      choices.push(packed % count);
      packed = Math.floor(packed / count);
    }
    for (let index = 0; index < groups.length; index++) {
      fireTarget(entity, "SetBodyGroup", `${groups[index]},${choices[index]}`);
    }
  }
  applyThemeSkin(entity, request.skin ?? (request.hazardous ? 3 : 1));
  entity.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
                                                                            
                                                                         
                                                    
  afterThink(() => {
    if (!validEntity(entity)) return;
    if (!isFallModel) {
      const groups = ["TOP", "RIGHT", "LEFT", "FORWARD", "BACK", "body"];
      const counts = isStreamModel ? [3, 2, 2, 2, 2, 1] : [2, 2, 2, 2, 2, 1];
      const choices = [];
      let packed = Number(request.body ?? 31);
      for (const count of counts) {
        choices.push(packed % count);
        packed = Math.floor(packed / count);
      }
      for (let index = 0; index < groups.length; index++) {
        fireTarget(entity, "SetBodyGroup", `${groups[index]},${choices[index]}`);
      }
    }
  });
}

function spawnVisual(runtime, request, model, solid = false) {
  if (solid) return spawnModelBlock(runtime, request, model);
  const spawned = spawnRoundEntities(featureTemplate("model"), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
  let visual;
  for (const entity of spawned) {
    if (!entity?.IsValid()) continue;
    if (entity.GetClassName?.().startsWith("trigger_")) {
      entity.Kill();
      runtime.entities.delete(entity);
      continue;
    }
    visual ??= entity;
    entity.SetModel?.(rememberSilentHillVisual(runtime, entity, model, request));
    if (request.renderColor) applyTerrainAppearance(entity, 0, request.renderColor);
  }
  return visual;
}

function spawnTriggerVolume(runtime, request, mins, maxs) {
  const templateKey = request.templateKey ?? "trigger";
  const spawned = spawnRoundEntities(featureTemplate(templateKey), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, request, spawned);
  const trigger = spawned.find((entity) => entity?.IsValid() && entity.GetClassName?.().startsWith("trigger_"));
  for (const entity of spawned) {
    if (entity === trigger || !entity?.IsValid()) continue;
    detachAndRetireTemplateHelper(runtime, trigger, entity);
  }
  if (!trigger) throw new Error(`${request.feature}: trigger prototype did not spawn`);
                                                                            
                                                                         
                                                            
  void mins;
  void maxs;
  return trigger;
}

function pawnHorizontalDirection(pawn, fallback = vec(1, 0, 0)) {
  const velocity = pawn.GetAbsVelocity?.() ?? vec();
  const length = Math.hypot(velocity.x, velocity.y);
  if (length > 0.01) return vec(velocity.x / length, velocity.y / length, 0);
  const forward = pawn.GetForwardVector?.();
  if (forward && Number.isFinite(forward.x) && Number.isFinite(forward.y)) {
    const forwardLength = Math.hypot(forward.x, forward.y);
    if (forwardLength > 0.01) return vec(forward.x / forwardLength, forward.y / forwardLength, 0);
  }
  const angles = pawn.GetAbsAngles?.();
  if (angles && Number.isFinite(angles.yaw)) {
    const radians = angles.yaw * Math.PI / 180;
    return vec(Math.cos(radians), Math.sin(radians), 0);
  }
  return clone(fallback);
}

function liquidOrigin(liquid) {
  return liquid.visual?.GetAbsOrigin?.() ?? liquid.trigger?.GetAbsOrigin?.();
}

function rememberShallowStreamTouch(liquid, pawn, now) {
  if (!liquid.shallowStream || liquid.shallowJump) return;
  const origin = liquidOrigin(liquid);
  if (!origin) return;
                                                                             
                                                                             
                                                                            
  state.liquidShallowStreamHistory.set(pawn, {
    origin: clone(origin),
    time: now,
    owner: liquid.ownerIndex,
  });
}

function shallowStreamHistoryDirection(liquid, pawn, now) {
  const previous = state.liquidShallowStreamHistory.get(pawn);
  if (!previous) return undefined;
  const origin = liquidOrigin(liquid);
  if (!origin || now - previous.time >= 2 || Math.hypot(
    origin.x - previous.origin.x,
    origin.y - previous.origin.y,
    origin.z - previous.origin.z,
  ) > 100) {
    state.liquidShallowStreamHistory.delete(pawn);
    return undefined;
  }
  const cardinal = [vec(-1, 0, 0), vec(1, 0, 0), vec(0, -1, 0), vec(0, 1, 0)];
  let bestDirection;
  let bestDistance = Infinity;
  for (const direction of cardinal) {
    const candidate = add(origin, mul(direction, 40));
    const distance = Math.hypot(
      candidate.x - previous.origin.x,
      candidate.y - previous.origin.y,
      candidate.z - previous.origin.z,
    );
    if (distance < bestDistance) {
      bestDistance = distance;
      bestDirection = vec(-direction.x || 0, -direction.y || 0, 0);
    }
  }
  state.liquidShallowStreamHistory.delete(pawn);
  return bestDirection;
}

function applyShallowStreamJump(runtime, liquid, pawn, now) {
  if (!liquid.shallowJump || !pawn?.IsAlive?.()) return;
  if ((state.liquidShallowJumpCooldowns.get(pawn) ?? 0) > now) return;
  state.liquidShallowJumpCooldowns.set(pawn, now + CONFIG.liquidShallowJumpCooldown);
  const origin = pawn.GetAbsOrigin?.();
  if (!origin) return;
  const direction = shallowStreamHistoryDirection(liquid, pawn, now)
    ?? pawnHorizontalDirection(pawn, vec(1, 0, 0));
  const velocity = add(mul(direction, CONFIG.liquidShallowJumpXY), vec(0, 0, CONFIG.liquidShallowJumpZ));
                                                                        
                                                                             
                                                         
  const surface = liquid.visual?.GetAbsOrigin?.() ?? liquid.trigger?.GetAbsOrigin?.();
  pawn.Teleport({
    position: surface ? vec(origin.x, origin.y, surface.z) : origin,
    velocity,
  });
  schedule(CONFIG.liquidShallowJumpRestoreDelay, () => {
    if (pawn?.IsValid?.() && pawn.IsAlive?.()) pawn.Teleport({ velocity });
  }, runtime.index);
  playSourceAudioCue(21064, origin, { recipient: pawn });
}

function markLiquidContact(runtime, liquid, pawn, now) {
  if (!pawn || !pawn.IsAlive?.()) return;
  runtime.liquidPawns?.add(pawn);
  liquid.contacts.set(pawn, now);
  rememberShallowStreamTouch(liquid, pawn, now);
  applyShallowStreamJump(runtime, liquid, pawn, now);
  if (!liquid.shallow && !liquid.nativePush) {
                                                                               
                                                                               
                                     
    addGravitySource(runtime, pawn, liquid.source, CONFIG.liquidGravity, { engine: false, simulate: true });
  }
  const velocity = pawn.GetAbsVelocity?.() ?? vec();
  if (!liquid.nativePush && velocity.z < -150) pawn.Teleport({ velocity: vec(velocity.x, velocity.y, -150) });
  applyLiquidHazardTouch(runtime, liquid, pawn, now);
}

function registerLiquidContact(runtime, trigger, data) {
  const liquid = {
    trigger,
    scripted: Boolean(trigger),
    contacts: new Map(),
    ownerIndex: runtime.index,
    nextHazardTouchAt: Instance.GetGameTime() + CONFIG.liquidHazardFirstTouchDelay,
    speedPulseSerial: 0,
    ...data,
  };
  runtime.liquids.add(liquid);
  const source = `${runtime.index}:liquid:${runtime.liquids.size}`;
  liquid.source = source;
  if (!trigger) return liquid;
  liquid.outputConnections = [connectOwnedOutput(runtime, trigger, "OnStartTouch", (event) => {
    if (liquid.disabledForFinale) return;
    const pawn = resolvePawn(event?.activator);
    if (!pawn || !pawn.IsAlive()) return;
    markLiquidContact(runtime, liquid, pawn, Instance.GetGameTime());
  }), connectOwnedOutput(runtime, trigger, "OnEndTouch", (event) => {
    const pawn = resolvePawn(event?.activator);
    liquid.contacts.delete(pawn);
    removeGravitySource(pawn, source);
  })];
  fireTarget(trigger, "Enable");
  return liquid;
}

function applySilentHillHazard(runtime, liquid, pawn) {
  if (liquidHazardTheme(runtime, liquid) !== "silenthill" || !liquid.hazardous) return;
                                                                          
                                                                      
  if (state.silentHillWorld.requestedDark && pawn.GetTeamNumber?.() === 2) return;
  addLiquidHazardSlow(runtime, liquid, pawn, -0.45, 1.2);
  const velocity = pawn.GetAbsVelocity?.() ?? vec();
  pawn.Teleport({ velocity: vec(0, 0, velocity.z) });
  if (state.silentHillWorld.requestedDark && pawn.GetTeamNumber?.() !== 2) {
    pawn.SetHealth?.(1);
    schedule(0.05, () => {
      if (pawn?.IsValid?.() && pawn.IsAlive?.()) pawn.SetHealth?.(1);
    }, runtime.index);
  }
}

function liquidHazardTheme(runtime, liquid) {
  return liquid.themeName ?? stageSnapshotForRuntime(runtime).theme;
}

function addLiquidHazardSlow(runtime, liquid, pawn, amount, durationFactor) {
                                                                            
                                                                           
  liquid.speedPulseSerial = (liquid.speedPulseSerial ?? 0) + 1;
  addPlayerStatus(runtime, pawn, `${liquid.source}:hurt:${liquid.speedPulseSerial}`,
    CONFIG.hazardDamageCooldown * durationFactor, { nativeSpeedAdd: amount });
}

function applyLiquidHazardEffect(runtime, liquid, pawn) {
  if (!liquid.hazardous || liquid.shallowJump || !validEntity(pawn) || !pawn.IsAlive?.()) return;
  const theme = liquidHazardTheme(runtime, liquid);
  const igniteTime = theme === "generic" ? 1 : theme === "castle" ? 3
    : theme === "hell" ? CONFIG.hellLiquidIgniteTime : 0;
  if (igniteTime) fireTarget(pawn, "IgniteLifetime", String(igniteTime));
  if (theme === "temple") addLiquidHazardSlow(runtime, liquid, pawn, -0.30, 2.5);
  if (theme === "frost") addLiquidHazardSlow(runtime, liquid, pawn, -0.10, 5);
  if (theme === "nature" || theme === "frost") {
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport({ velocity: vec(0, 0, velocity.z) });
  }
  if (theme === "silenthill") applySilentHillHazard(runtime, liquid, pawn);
}

function applyLiquidHazardTouch(runtime, liquid, pawn, now) {
  if (!liquid.hazardous || liquid.harsh || !validEntity(pawn) || !pawn.IsAlive?.()) return;
  if ((state.liquidDamageCooldowns.get(pawn) ?? 0) > now + 1e-7) return;
  state.liquidDamageCooldowns.set(pawn, now + CONFIG.hazardDamageCooldown);
  const damage = liquidHazardTheme(runtime, liquid) === "silenthill"
    ? 0 : stageSnapshotForRuntime(runtime).hazardDamage;
                                                                          
                                                                     
  if (damage > 0) damagePawn(pawn, damage);
  if (pawn.IsAlive?.()) applyLiquidHazardEffect(runtime, liquid, pawn);
}

function finishRuntimeSpawn(runtime) {
  if (!state.levels.has(runtime.index)) return;
  runtime.remaining--;
  if (runtime.remaining === 0) {
    closeBlockSpawnSafety(runtime);
    try { releaseLevelPostSpawn(runtime); }
    catch (error) { failRuntime(`postspawn release failed for level ${runtime.index}: ${error}`); return; }
  }
  if (runtime.raceLevel && runtime.remaining === 0) completeRaceLevelSpawn(runtime);
  if (state.pendingLevel === runtime && runtime.remaining === 0) finishPendingLevel();
}

function liquidNativePushPlan(request) {
  if (!request.stream) throw new Error("liquid push requires an authored stream");
  if (request.shallowJump) return { angles: { pitch: -90, yaw: 0, roll: 0 }, speed: 0.01 };
  if (request.genericStream) return { angles: { pitch: 90, yaw: 0, roll: 0 }, speed: CONFIG.liquidStreamPush };
  const direction = request.pushDirection ?? request.streamDirection;
  if (!direction || !Number.isFinite(direction.x) || !Number.isFinite(direction.y)
    || Math.hypot(direction.x, direction.y) < 0.01) throw new Error("liquid push direction is invalid");
  return { angles: { pitch: 0, yaw: Math.atan2(direction.y, direction.x) * 180 / Math.PI, roll: 0 },
    speed: CONFIG.liquidStreamPush };
}

function spawnLiquidPushTrigger(runtime, request) {
  const plan = liquidNativePushPlan(request);
                                                                              
                                                                       
  const spawned = spawnRoundEntities(featureTemplate("liquidPush"), request.position,
    { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  if (spawned.length !== 1 || !validEntity(spawned[0]) || spawned[0].GetClassName?.() !== "trigger_push") {
    for (const entity of spawned) if (validEntity(entity)) entity.Kill();
    throw new Error("liquid: native trigger_push prototype did not spawn");
  }
  const trigger = spawned[0];
  runtime.entities.add(trigger);
  trigger.SetEntityName?.(`liquid_push_${runtime.index}_${runtime.entities.size}`);
  fireTarget(trigger, "Disable");
  fireTarget(trigger, "SetPushDirection", `${plan.angles.pitch} ${plan.angles.yaw} ${plan.angles.roll}`);
  fireTarget(trigger, "SetPushSpeed", String(plan.speed));
                                                                                 
  return trigger;
}

function spawnLiquidFeature(runtime, request) {
                                                                             
                                                                            
                                                                              
                                                                         
  let analog;
  if (!request.fall) {
    const spawned = spawnRoundEntities(featureTemplate("liquid"), request.position, request.angles) ?? [];
    finalizeSpawned(runtime, { ...request, feature: "liquid" }, spawned);
    analog = spawned.find((entity) => entity?.IsValid?.()
      && ["func_water", "func_water_analog"].includes(entity.GetClassName?.()))
      ?? spawned.find((entity) => entity?.IsValid?.());
    if (!analog) throw new Error("liquid: native water prototype did not spawn");
                                                                      
                                                                 
    fireTarget(analog, "DisableDraw");
  }
                                                                           
                                                                           
                                                                           
                                                                         
                                                                           
  const visual = spawnVisual(runtime, request, request.model, !request.fall);
  if (!validEntity(visual)) throw new Error("liquid: surface model prototype did not spawn");
  if (runtime.debugLiquidFall && request.debugLiquidFallMode) {
    const mode = request.debugLiquidFallMode;
    const target = `debug_liquid_fall_${request.themeName}_${mode}`;
    visual.SetEntityName(target);
    visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
    if (mode === "default" || mode === "legacy") {
                                                                            
                                                                              
      applyThemeSkin(visual, 0);
      if (mode === "legacy") {
        fireTarget(visual, "SetSkin", String(request.skin));
        fireTarget(visual, "SetSkin", String(request.skin), 0.05);
      }
    } else {
      applyLiquidAppearance(visual, request);
    }
    runtime.debugLiquidFallSamples.set(target, {
      visual, target, theme: request.themeName, mode, model: request.model,
      skin: mode === "default" ? 0 : request.skin,
    });
                                                                        
                                                                
    return true;
  }
  applyLiquidAppearance(visual, request);
  const silentHillRecord = state.silentHillWorld.visuals.get(visual);
  if (silentHillRecord) silentHillRecord.restore = () => applyLiquidAppearance(visual, request);
  const triggerDepth = request.triggerDepth ?? (request.fall ? (request.hazardous ? 5000 : 0) : 240);
                                                                        
                                                                             
                                                                         
                                                                             
                                                               
  const needsScriptedTrigger = Boolean(request.hazardous || request.stream || (request.fall && request.hazardous));
  const trigger = request.stream ? spawnLiquidPushTrigger(runtime, request)
    : needsScriptedTrigger
                                                                        
                                                                          
      ? spawnTriggerVolume(runtime, { ...request, position: add(request.position, vec(0, 0, -14)) },
        vec(-47, -47, -triggerDepth), vec(47, 47, 0))
      : undefined;
  registerLiquidContact(runtime, trigger, {
    analog,
    visual,
    fallSafe: request.shallow,
    shallow: request.shallow,
    stream: request.stream ?? false,
    nativePush: Boolean(request.stream),
    genericStream: request.genericStream ?? false,
    hazardous: request.hazardous,
    themeName: request.themeName ?? stageSnapshotForRuntime(runtime).theme,
    harsh: false,
    streamDirection: request.pushDirection ?? request.streamDirection ?? vec(),
    visualDirection: request.streamDirection ?? vec(),
    drown: request.drown ?? false,
    shallowJump: request.shallowJump ?? false,
    shallowStream: request.stream && request.shallow,
    mins: request.stream ? vec(-32.5, -32.5, -240) : vec(-47, -47, -triggerDepth),
    maxs: request.stream ? vec(32.5, 32.5, 0) : vec(47, 47, 0),
  });
  return true;
}

function attachNearbyLiquids(runtime, mover, position) {
  const attached = [];
  for (const liquid of runtime.liquids ?? []) {
    const origin = liquid.visual?.GetAbsOrigin?.()
      ?? liquid.analog?.GetAbsOrigin?.()
      ?? liquid.trigger?.GetAbsOrigin?.();
    if (!origin || Math.hypot(origin.x - position.x, origin.y - position.y, origin.z - position.z) > CONFIG.gridSize) continue;
    liquid.analog?.SetParent?.(mover);
    liquid.visual?.SetParent?.(mover);
    liquid.trigger?.SetParent?.(mover);
    liquid.movingParent = mover;
    attached.push(liquid);
  }
  return attached;
}

function spawnElevatorFeature(runtime, request) {
  const delta = sub(request.destination, request.position);
  const distance = Math.hypot(delta.x, delta.y, delta.z);
  if (!(distance > 0) || !Number.isFinite(distance)) throw new Error("elevator: invalid native travel distance");
                                                                             
                                                                          
                                                                           
  const spawned = spawnRoundEntities(featureTemplate("hold"), request.position, { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  const driver = spawned.find(entity => validEntity(entity) && entity.GetClassName?.() === "func_movelinear");
  if (!driver || spawned.length !== 1) {
    destroyEntities(spawned);
    throw new Error("elevator: template_movelinear must spawn exactly one func_movelinear");
  }
  driver.SetEntityName(`elevator_driver_${runtime.index}_${runtime.entities.size}`);
  runtime.entities.add(driver);
  const model = request.themeModel ?? request.model;
  const anchor = spawnVisual(runtime, { ...request, feature: "elevatorFrame",
    angles: { pitch: 0, yaw: 0, roll: 0 } }, model);
  const collider = spawnVisual(runtime, { ...request, feature: "elevatorCollision" }, model, true);
  const visual = spawnVisual(runtime, { ...request, feature: "elevatorVisual" }, model);
  if (![anchor, collider, visual].every(validEntity)) throw new Error("elevator: native child models did not spawn");
                                                                        
                                                                         
                                                                         
                                                                             
                                                                      
  for (const helper of [anchor, collider]) {
    const hide = () => {
      if (!validEntity(helper)) return;
      fireTarget(helper, "TurnOff");
      fireTarget(helper, "TurnOff", undefined, 0.05);
      fireTarget(helper, "DisableShadow");
    };
    hide();
                                                                   
    const record = state.silentHillWorld.visuals.get(helper);
    if (record) record.restore = hide;
  }
  driver.SetParent(anchor);
  driver.Teleport({ position: clone(request.position), angles: { pitch: 0, yaw: 0, roll: 0 }, velocity: vec() });
  fireTarget(driver, "ResetPosition", "0");
  anchor.Teleport({ position: clone(request.position), angles: {
    pitch: -Math.atan2(delta.z, Math.hypot(delta.x, delta.y)) * 180 / Math.PI,
    yaw: yawOf(delta), roll: 0,
  }, velocity: vec() });
  collider.SetParent(driver);
  collider.Teleport({ position: clone(request.position), angles: request.angles, velocity: vec() });
                                                                       
                                                             
  visual.SetColor?.(colorToEntityColor(genericRenderColor(92, request.themeName))
    ?? { r: 255, g: 255, b: 255, a: 255 });
  const speed = CONFIG.elevatorSpeedMin + Math.random() * (CONFIG.elevatorSpeedMax - CONFIG.elevatorSpeedMin);
  const mover = { kind: "nativeElevator", driver, anchor, collider, visual,
    start: clone(request.position), destination: clone(request.destination),
    position: clone(request.position), speed, nextVisualAt: 0 };
  runtime.movers.add(mover);
  const reverse = input => {
    if (!state.running || state.fatal || runtime.lifecycle === "destroyed"
      || !validEntity(driver) || !validEntity(collider)) return;
    fireTarget(driver, input, undefined, CONFIG.elevatorWait);
  };
  connectOwnedOutput(runtime, driver, "OnFullyOpen", () => reverse("Close"));
  connectOwnedOutput(runtime, driver, "OnFullyClosed", () => reverse("Open"));
  fireTarget(driver, "SetMoveDistanceFromStart", String(distance));
  fireTarget(driver, "SetSpeed", String(speed));
  fireTarget(driver, "Open", undefined,
    CONFIG.elevatorStartDelayMin + Math.random() * (CONFIG.elevatorStartDelayMax - CONFIG.elevatorStartDelayMin));
  attachNearbyLiquids(runtime, collider, request.position);
}

function choosePathPosition(destination) {
  return destination.positions[Math.floor(Math.random() * destination.positions.length)];
}



function continueMovePlatform(runtime, controller) {
  if (!nativeMoverAlive(runtime, controller) || controller.path.length <= 1) return;
  const position = clone(controller.collider.GetAbsOrigin());
                                                                         
                                                                              
  let destination;
  for (let count = 0; count < controller.path.length; count++) {
    controller.pathIndex = (controller.pathIndex + 1) % controller.path.length;
    destination = choosePathPosition(controller.path[controller.pathIndex]);
    const delta = sub(destination, position);
    if (Math.hypot(delta.x, delta.y, delta.z) > 0.01) break;
    destination = undefined;
  }
  if (!destination) return;
  const previous = controller.leg;
  const leg = spawnNativeMoverLeg(runtime, controller.request, controller.model, position, destination, controller.speed);
  controller.collider.SetParent(leg.driver);
  controller.collider.Teleport({ position, angles: controller.request.angles, velocity: vec() });
  controller.leg = leg;
  controller.driver = leg.driver;
  controller.anchor = leg.anchor;
  controller.destination = clone(destination);
  controller.position = position;
  releaseNativeMoverLeg(runtime, previous, 0.1);
  let arrived = false;
  leg.connections.push(connectOwnedOutput(runtime, leg.driver, "OnFullyOpen", () => {
    if (arrived || controller.leg !== leg || !nativeMoverAlive(runtime, controller)) return;
    arrived = true;
    try {
      continueMovePlatform(runtime, controller);
    } catch (error) {
      failRuntime(`native move platform path failed for level ${runtime.index}: ${error}`);
    }
  }));
                                                                               
                                                             
  fireTarget(leg.driver, "Open", undefined, 0.03);
}

function hideNativeMoverHelper(helper) {
  const hide = () => {
    if (!validEntity(helper)) return;
    fireTarget(helper, "TurnOff");
    fireTarget(helper, "TurnOff", undefined, 0.05);
    fireTarget(helper, "DisableShadow");
  };
  hide();
  const record = state.silentHillWorld.visuals.get(helper);
  if (record) record.restore = hide;
}

function nativeMoverAlive(runtime, controller) {
  return state.running && !state.fatal && !["outcome_pending", "resolved", "destroyed"].includes(runtime.lifecycle)
    && runtime.movers.has(controller) && validEntity(controller.collider) && validEntity(controller.visual)
    && (!controller.driver || validEntity(controller.driver)) && (!controller.anchor || validEntity(controller.anchor));
}

function spawnNativeMoverLeg(runtime, request, model, position, destination, speed) {
  const delta = sub(destination, position);
  const distance = Math.hypot(delta.x, delta.y, delta.z);
  if (!Number.isFinite(distance) || !Number.isFinite(speed) || speed <= 0) {
    throw new Error(`${request.feature}: invalid native mover distance/speed`);
  }
  const angles = { pitch: 0, yaw: 0, roll: 0 };
  const templateKey = request.nativeTemplateKey ?? "hold";
  const spawned = spawnRoundEntities(featureTemplate(templateKey), position, angles) ?? [];
  const driver = spawned.find(entity => validEntity(entity) && entity.GetClassName?.() === "func_movelinear");
  if (!driver || spawned.length !== 1) {
    destroyEntities(spawned);
    throw new Error(`${request.feature}: ${FEATURE_TEMPLATE_NAMES[templateKey]} must spawn exactly one func_movelinear`);
  }
  runtime.nativeMoverSerial = (runtime.nativeMoverSerial ?? 0) + 1;
  driver.SetEntityName(`block_${runtime.index}_${request.feature}_driver_${runtime.nativeMoverSerial}`);
  runtime.entities.add(driver);
  let anchor;
  try {
    anchor = spawnVisual(runtime, { ...request, position, angles, feature: `${request.feature}Frame` }, model);
    if (!validEntity(anchor)) throw new Error(`${request.feature}: native mover frame did not spawn`);
    hideNativeMoverHelper(anchor);
                                                                        
                                                                         
    driver.SetParent(anchor);
    driver.Teleport({ position: clone(position), angles, velocity: vec() });
    fireTarget(driver, "ResetPosition", "0");
    anchor.Teleport({ position: clone(position), angles: {
      pitch: distance > 0 ? -Math.atan2(delta.z, Math.hypot(delta.x, delta.y)) * 180 / Math.PI : 0,
      yaw: distance > 0 ? yawOf(delta) : 0, roll: 0,
    }, velocity: vec() });
    fireTarget(driver, "SetMoveDistanceFromStart", String(distance));
    fireTarget(driver, "SetSpeed", String(speed));
    return { driver, anchor, distance, connections: [] };
  } catch (error) {
    releaseNativeMoverLeg(runtime, { driver, anchor, connections: [] });
    throw error;
  }
}

function releaseNativeMoverLeg(runtime, leg, delay = 0) {
  if (!leg || leg.retired) return;
  leg.retired = true;
  for (const id of leg.connections) {
    if (id === undefined || id === null) continue;
    disconnectEntityOutput(id);
    runtime.outputConnections.delete(id);
    state.outputConnections.delete(id);
  }
  const dispose = () => {
    for (const entity of [leg.driver, leg.anchor]) {
      if (validEntity(entity)) entity.Kill();
      runtime.entities.delete(entity);
      runtime.levelFadeColors?.delete(entity);
      state.silentHillWorld.visuals.delete(entity);
    }
  };
  if (delay > 0) schedule(delay, dispose, runtime.index);
  else dispose();
}

function spawnMovePlatformFeature(runtime, request) {
  if (!Array.isArray(request.moverPath) || request.moverPath.length === 0
    || request.moverPath.some(stop => !stop.positions?.length)) throw new Error("move platform has no valid native path");
  const model = request.themeModel ?? movePlatformModel(request.size);
  const collider = spawnVisual(runtime, { ...request, feature: "movePlatformCollision" }, model, true);
  const visual = spawnVisual(runtime, { ...request, feature: "movePlatformVisual" }, model);
  if (![collider, visual].every(validEntity)) throw new Error("move platform native child models did not spawn");
  hideNativeMoverHelper(collider);
  const controller = { kind: "nativeMovePlatform", collider, visual, model, request,
    path: request.moverPath, pathIndex: request.pathIndex, speed: request.speed,
    position: clone(request.position), nextVisualAt: 0 };
  runtime.movers.add(controller);
  continueMovePlatform(runtime, controller);
  attachNearbyLiquids(runtime, collider, request.position);
}

function spawnNativeHazardPlaneTrigger(runtime, request, driver) {
  const angles = { pitch: 0, yaw: 0, roll: 0 };
  const spawned = spawnRoundEntities(featureTemplate("hazardPlaneTrigger"), request.position, angles) ?? [];
  if (spawned.length !== 1 || !validEntity(spawned[0]) || spawned[0].GetClassName?.() !== "trigger_multiple") {
    destroyEntities(spawned);
    throw new Error("hazard plane: template_hazard_plane must spawn exactly one trigger_multiple");
  }
  const trigger = spawned[0];
  runtime.entities.add(trigger);
  trigger.SetEntityName?.(`block_${runtime.index}_hazardPlane_trigger_${runtime.nativeMoverSerial}`);
  fireTarget(trigger, "Disable");
  trigger.SetParent(driver);
  trigger.Teleport({ position: clone(request.position), angles, velocity: vec() });
  return trigger;
}

function registerNativeHazardPlane(runtime, controller, request) {
  const liquid = {
    trigger: controller.trigger, visual: controller.collider,
    scripted: false, nativeHazardPlane: true,
    contacts: new Map(), ownerIndex: runtime.index,
    shallow: true, hazardous: !request.harsh, harsh: request.harsh,
    themeName: request.themeName ?? stageSnapshotForRuntime(runtime).theme,
    drown: false, mins: vec(-958, -958, -1), maxs: vec(958, 958, 1),
    speedPulseSerial: 0,
  };
  runtime.liquids.add(liquid);
  liquid.source = `${runtime.index}:hazardPlane:${runtime.liquids.size}`;
  liquid.outputConnections = [connectOwnedOutput(runtime, liquid.trigger, "OnStartTouch", event => {
    if (!nativeMoverAlive(runtime, controller) || !validEntity(liquid.trigger)) return;
    const pawn = resolvePawn(event?.activator);
    if (!validEntity(pawn) || !pawn.IsAlive?.()) return;
    (runtime.liquidPawns ??= new Set()).add(pawn);
    if (liquid.harsh) {
      if (pawn.GetTeamNumber?.() === 2) pawn.Teleport({ position: vec(0, 0, -16160), velocity: vec() });
      else if (pawn.GetTeamNumber?.() === 3) damagePawn(pawn, 999999);
    } else applyLiquidHazardTouch(runtime, liquid, pawn, Instance.GetGameTime());
  })];
  // Source 1: initial Enable/Tick at .05 s; each Tick disables then enables
  // after .01 s, repeating every .30 s. Only native OnStartTouch applies hurt.
  const retouch = () => {
    if (!nativeMoverAlive(runtime, controller) || !validEntity(liquid.trigger)) return;
    fireTarget(liquid.trigger, "Disable");
    fireTarget(liquid.trigger, "Enable", undefined, CONFIG.liquidHazardEnableDelay);
    controller.hazardTouchTask = schedule(CONFIG.liquidHazardTouchInterval, retouch, runtime.index);
  };
  fireTarget(liquid.trigger, "Enable", undefined, CONFIG.liquidHazardFirstTouchDelay);
  controller.hazardTouchTask = schedule(CONFIG.liquidHazardFirstTouchDelay, retouch, runtime.index);
  return liquid;
}

function spawnHazardPlaneFeature(runtime, request) {
  const model = "models/luffaren/collective_hazfloor.vmdl";
                                                                           
                                                                             
  const collider = spawnVisual(runtime, { ...request, feature: "hazardPlaneMaster" }, model);
  const visual = spawnVisual(runtime, { ...request, feature: "hazardPlaneVisual" }, model);
  if (![collider, visual].every(validEntity)) throw new Error("hazard plane native child models did not spawn");
  hideNativeMoverHelper(collider);
  applyThemeSkin(visual, request.themeSkin);
  const leg = spawnNativeMoverLeg(runtime, request, model, request.position, request.destination, request.speed);
  collider.SetParent(leg.driver);
  collider.Teleport({ position: clone(request.position), angles: request.angles, velocity: vec() });
  const trigger = spawnNativeHazardPlaneTrigger(runtime, request, leg.driver);
  const controller = { kind: "nativeHazardPlane", driver: leg.driver, anchor: leg.anchor, leg, collider, visual, trigger,
    destination: clone(request.destination), speed: request.speed, position: clone(request.position), nextVisualAt: 0 };
  runtime.movers.add(controller);
  controller.liquid = registerNativeHazardPlane(runtime, controller, request);
  const reverse = input => {
    if (!nativeMoverAlive(runtime, controller) || !validEntity(leg.driver)) return;
    fireTarget(leg.driver, input, undefined, CONFIG.hazardPlaneWait);
  };
  leg.connections.push(connectOwnedOutput(runtime, leg.driver, "OnFullyOpen", () => reverse("Close")));
  leg.connections.push(connectOwnedOutput(runtime, leg.driver, "OnFullyClosed", () => reverse("Open")));
                                                                          
  if (leg.distance > 15) fireTarget(leg.driver, "Open", undefined, 0.1);
  if (request.harsh) announce(`Level ${runtime.index}: WARNING - harsh hazard plane`);
}

function retireNativeLevelMover(runtime, mover) {
  if (mover.hazardTouchTask) mover.hazardTouchTask.cancelled = true;
  runtime.movers.delete(mover);
  releaseNativeMoverLeg(runtime, mover.leg);
  if (mover.liquid) {
    for (const pawn of mover.liquid.contacts.keys()) removeGravitySource(pawn, mover.liquid.source);
    mover.liquid.contacts.clear();
    runtime.liquids.delete(mover.liquid);
    for (const id of mover.liquid.outputConnections ?? []) {
      if (id === undefined || id === null) continue;
      disconnectEntityOutput(id);
      runtime.outputConnections.delete(id);
      state.outputConnections.delete(id);
    }
  }
  for (const entity of [mover.trigger, mover.collider, mover.visual]) {
    if (validEntity(entity)) entity.Kill();
    runtime.entities.delete(entity);
    runtime.levelFadeColors?.delete(entity);
    state.silentHillWorld.visuals.delete(entity);
  }
}



function processMovers(now) {
  let pawns;
  for (const runtime of activeRuntimes()) {
    for (const mover of runtime.movers ?? []) {
      if (["nativeElevator", "nativeMovePlatform", "nativeHazardPlane"].includes(mover.kind)) {
                                                                              
                                                                              
                                                                          
                                                                              
        if ((mover.driver && !validEntity(mover.driver)) || (mover.anchor && !validEntity(mover.anchor))
          || !validEntity(mover.collider) || !validEntity(mover.visual) || (mover.trigger && !validEntity(mover.trigger))) {
          if (mover.kind !== "nativeElevator") retireNativeLevelMover(runtime, mover);
          continue;
        }
        if (now < mover.nextVisualAt) continue;
        mover.nextVisualAt = now + CONFIG.elevatorVisualInterval;
        mover.position = clone(mover.collider.GetAbsOrigin());
        mover.visual.Move({ position: mover.position, angles: mover.collider.GetAbsAngles() });
        continue;
      }
      if (!mover.visual?.IsValid() || now < (mover.waitUntil ?? 0)) continue;
      mover.lastAt ??= now;
      const elapsed = Math.min(0.1, Math.max(0, now - mover.lastAt));
      mover.lastAt = now;
      if (elapsed <= 0) continue;
      const destination = mover.destination;
      if (!destination) continue;
      const delta = sub(destination, mover.position);
      const distance = Math.hypot(delta.x, delta.y, delta.z);
      const amount = Math.min(distance, mover.speed * elapsed);
      const movement = distance > 0 ? mul(delta, amount / distance) : vec();
      mover.position = add(mover.position, movement);
      mover.visual.Teleport({ position: mover.position, velocity: vec() });
      for (const pawn of pawns ??= allLivingPawns()) {
        if (pawn.GetGroundEntity?.() !== mover.visual) continue;
        pawn.Teleport({ position: add(pawn.GetAbsOrigin(), movement) });
      }
      if (amount < distance) continue;
      mover.position = clone(destination);
      mover.waitUntil = now + CONFIG.hazardPlaneWait;
    }
  }
}

function damagePawn(pawn, damage, attacker, inflictor, damageTypes) {
  const event = { damage, damageFlags: 0 };
  if (validEntity(attacker)) event.attacker = attacker;
  if (validEntity(inflictor)) event.inflictor = inflictor;
  if (damageTypes !== undefined) event.damageTypes = damageTypes;
  pawn.TakeDamage?.(event);
}

function pawnTouchesFallSafeLiquid(pawn) {
  const position = pawn?.GetAbsOrigin?.();
  if (!position) return false;
  for (const runtime of activeRuntimes()) {
    for (const liquid of runtime.liquids ?? []) {
      if (!liquid.fallSafe || !liquid.mins || !liquid.maxs) continue;
      const origin = liquid.visual?.GetAbsOrigin?.() ?? liquid.trigger?.GetAbsOrigin?.();
      if (!origin) continue;
      if (position.x < origin.x + liquid.mins.x || position.x > origin.x + liquid.maxs.x) continue;
      if (position.y < origin.y + liquid.mins.y || position.y > origin.y + liquid.maxs.y) continue;
      if (position.z < origin.z + liquid.mins.z - 8 || position.z > origin.z + liquid.maxs.z + 8) continue;
      return true;
    }
  }
  return false;
}

function pawnTouchesTeleportEntry(pawn) {
  const position = pawn?.GetAbsOrigin?.();
  if (!position) return false;
  for (const runtime of activeRuntimes()) {
    for (const entry of runtime.teleportEntries ?? []) {
      const source = entry?.position;
      if (!source) continue;
      if (Math.abs(position.x - source.x) > CONFIG.teleportEntryFallSafeRadius) continue;
      if (Math.abs(position.y - source.y) > CONFIG.teleportEntryFallSafeRadius) continue;
      if (position.z < source.z + CONFIG.teleportEntryFallSafeMinZ) continue;
      if (position.z > source.z + CONFIG.teleportEntryFallSafeMaxZ) continue;
      return true;
    }
  }
  return false;
}

function zombieStartAreaProtected(pawn) {
  if (!state.running || state.fatal || state.firstInfectionAt === undefined
    || !state.zombieSpawnInvincibilityEnabled
    || !validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 2) return false;
  const position = pawn.GetAbsOrigin?.();
  if (!position) return false;
  const finale = state.endingRuntime?.kind === "FINALE" && state.endingRuntime.lifecycle === "active"
    ? state.endingRuntime : undefined;
  const anchor = finale?.finaleStructure?.zPlatformTp
    ?? finale?.escape?.current?.tp
    ?? finale?.tpPosition
    ?? (validEntity(state.teleportDestination) ? state.teleportDestination.GetAbsOrigin?.() : undefined);
  const range = Number.isFinite(finale?.finaleZombieInvincibilityRange)
    ? finale.finaleZombieInvincibilityRange : 50;
                                                                        
                                                                             
  if (anchor && Math.hypot(position.x - anchor.x, position.y - anchor.y, position.z - anchor.z) < range) return true;
  return !state.spawnPlatformKilled && Math.hypot(position.x, position.y, position.z) < 500;
}

function modifyPlayerDamage(event) {
                                                                         
                                                                          
  if (state.adminSlayActive) return;
  if ((event.damageTypes & CSDamageTypes.FALL) && Instance.GetGameTime() < state.genericEvents.fallDamageDisabledUntil)
    return { abort: true };
  if (event.damageTypes & CSDamageTypes.FALL) {
    const cancelUntil = state.teleportEntryFallDamageTokens.get(event.player);
    if (cancelUntil !== undefined) {
      state.teleportEntryFallDamageTokens.delete(event.player);
      if (Instance.GetGameTime() <= cancelUntil) return { abort: true };
    }
                                                                             
                                                                           
                                                                           
                                                                   
    if (pawnTouchesFallSafeLiquid(event.player) || pawnTouchesTeleportEntry(event.player)) return { abort: true };
  }
  const attacker = resolvePawn(event.attacker);
  if (attacker && activeImpostorController(attacker)?.hidden) return { abort: true };
  const hunt = state.endingRuntime?.kind === "HUNT" ? state.endingRuntime : undefined;
  if (
    hunt?.lifecycle === "active"
    && (hunt.infectionImmunityUntil?.get(event.player) ?? 0) > Instance.GetGameTime()
    && attacker?.GetTeamNumber?.() === 2
  ) return { abort: true };
  const conflict = state.endingRuntime?.kind === "CONFLICT" ? state.endingRuntime : undefined;
  if (
    conflict?.lifecycle === "active"
    && event.player?.GetTeamNumber?.() === 3
    && attacker?.GetTeamNumber?.() === 2
  ) return { abort: true };
  if (attacker?.GetTeamNumber?.() === 3 && zombieStartAreaProtected(event.player)) return { abort: true };
  const statuses = state.playerStatuses.get(event.player);
  if (!statuses || !Number.isFinite(event.damage)) return;
  let scale = 1;
  for (const status of statuses.values()) {
    if (
      status.blockedAttackerTeam !== undefined
      && attacker?.GetTeamNumber?.() === status.blockedAttackerTeam
    ) return { abort: true };
    if (status.damageScale !== undefined) scale = Math.min(scale, status.damageScale);
  }
  if (scale < 1) return { damage: event.damage * scale };
}

function capLiquidStreamVelocity(velocity) {
  const cap = CONFIG.liquidStreamVelocityCap;
  const length = Math.hypot(velocity.x, velocity.y, velocity.z);
  if (length <= cap || length <= 0.01) return velocity;
  const scale = cap / length;
  return vec(velocity.x * scale, velocity.y * scale, velocity.z * scale);
}

function liquidStreamPushVector(liquid) {
  if (!liquid.stream || liquid.shallowJump) return vec();
  if (liquid.genericStream) return vec(0, 0, -CONFIG.liquidStreamPush);
  const direction = liquid.streamDirection ?? vec();
  const length = Math.hypot(direction.x, direction.y);
  if (length <= 0.01) return vec();
  return vec(
    direction.x / length * CONFIG.liquidStreamPush,
    direction.y / length * CONFIG.liquidStreamPush,
    0,
  );
}

function liquidStreamVelocity(liquid, current) {
                                                                               
                                                                          
  if (!liquid.nativePush || !liquid.stream || liquid.shallowJump || liquid.hazardous) return current;
  return capLiquidStreamVelocity(current);
}

function liquidSwimVelocity(liquid, pawn, current) {
                                                                            
                                                                         
  if (!liquid?.drown || liquid.stream || liquid.shallow || liquid.fall) return current;
  const jump = Boolean(pawn?.IsInputPressed?.(CSInputs.JUMP));
  const duck = Boolean(pawn?.IsInputPressed?.(CSInputs.DUCK));
  if (!jump && !duck) return current;
  let vertical = current.z;
  if (jump && !duck) vertical = Math.max(vertical, CONFIG.liquidSwimUpVelocity);
  else if (duck && !jump) vertical = Math.min(vertical, -CONFIG.liquidSwimDownVelocity);
  vertical = Math.max(-CONFIG.liquidSwimVelocityCap, Math.min(CONFIG.liquidSwimVelocityCap, vertical));
  return vec(current.x, current.y, vertical);
}

function processLiquids(now) {
  if (now < state.nextLiquidTickAt) return;
  state.nextLiquidTickAt = now + CONFIG.liquidTickInterval;
  let pawns;
  const escape = state.endingRuntime?.kind === "FINALE" && state.endingRuntime.escape;
  const streamDrownDisabled = state.finaleEscapeActive
    && escape?.flags?.streamDrownDisabled === true;
  for (const runtime of activeRuntimes()) {
    for (const liquid of runtime.liquids ?? []) {
      if (!liquid.scripted) continue;
      if (streamDrownDisabled && (liquid.stream || liquid.drown)) {
        if (liquid.nativePush && !liquid.disabledForFinale) {
          liquid.disabledForFinale = true;
          fireTarget(liquid.trigger, "Disable");
        }
                                                                           
                                                                         
                                                                            
        for (const pawn of liquid.contacts?.keys?.() ?? []) removeGravitySource(pawn, liquid.source);
        liquid.contacts?.clear?.();
        continue;
      }
      const origin = liquid.visual?.GetAbsOrigin?.() ?? liquid.trigger?.GetAbsOrigin?.();
                                                                               
                                                                           
      if (!liquid.nativePush && origin && liquid.mins && liquid.maxs) {
        const inside = new Set();
        for (const pawn of pawns ??= allLivingPawns()) {
          const position = pawn.GetAbsOrigin?.();
          if (!position) continue;
          if (position.x < origin.x + liquid.mins.x || position.x > origin.x + liquid.maxs.x) continue;
          if (position.y < origin.y + liquid.mins.y || position.y > origin.y + liquid.maxs.y) continue;
          if (position.z < origin.z + liquid.mins.z || position.z > origin.z + liquid.maxs.z) continue;
          inside.add(pawn);
          if (!liquid.contacts.has(pawn)) {
            markLiquidContact(runtime, liquid, pawn, now);
          }
        }
        for (const pawn of liquid.contacts.keys()) {
          if (inside.has(pawn)) continue;
          liquid.contacts.delete(pawn);
          removeGravitySource(pawn, liquid.source);
        }
      }
      const hazardTouchDue = now + 1e-7 >= (liquid.nextHazardTouchAt ?? now);
      if (hazardTouchDue) {
        const previous = liquid.nextHazardTouchAt ?? now;
        liquid.nextHazardTouchAt = previous + CONFIG.liquidHazardTouchInterval
          * (Math.floor((now + 1e-7 - previous) / CONFIG.liquidHazardTouchInterval) + 1);
      }
      for (const [pawn, enteredAt] of [...liquid.contacts]) {
        if (!pawn?.IsValid() || !pawn.IsAlive()) {
          liquid.contacts.delete(pawn);
          state.liquidDamageCooldowns.delete(pawn);
          state.liquidShallowJumpCooldowns.delete(pawn);
          state.liquidShallowStreamHistory.delete(pawn);
          continue;
        }
        const velocity = pawn.GetAbsVelocity?.() ?? vec();
        if (liquid.nativePush) {
          rememberShallowStreamTouch(liquid, pawn, now);
          applyShallowStreamJump(runtime, liquid, pawn, now);
        }
        const swimVelocity = liquidSwimVelocity(liquid, pawn, velocity);
        if (liquid.nativePush) {
          const nextVelocity = liquidStreamVelocity(liquid, velocity);
          if (Math.hypot(
            nextVelocity.x - velocity.x,
            nextVelocity.y - velocity.y,
            nextVelocity.z - velocity.z,
          ) > 0.01) pawn.Teleport({ velocity: nextVelocity });
        } else {
          const nextVelocity = !liquid.shallow && swimVelocity.z < -150
            ? vec(swimVelocity.x, swimVelocity.y, -150)
            : swimVelocity;
          if (Math.hypot(
            nextVelocity.x - velocity.x,
            nextVelocity.y - velocity.y,
            nextVelocity.z - velocity.z,
          ) > 0.01) pawn.Teleport({ velocity: nextVelocity });
        }
        if (liquid.harsh) {
          if (pawn.GetTeamNumber?.() === 2) pawn.Teleport({ position: vec(0, 0, -16160), velocity: vec() });
          else damagePawn(pawn, 999999);
          continue;
        }
        const cooldown = state.liquidDamageCooldowns.get(pawn) ?? 0;
        if (liquid.hazardous) {
          if (hazardTouchDue) applyLiquidHazardTouch(runtime, liquid, pawn, now);
        } else if (liquid.drown && now - enteredAt >= CONFIG.liquidDrownDelay && cooldown <= now) {
          state.liquidDamageCooldowns.set(pawn, now + 1);
          damagePawn(pawn, CONFIG.liquidDrownDamage);
        }
      }
    }
  }
}

function trapPoolForTile(tile, profile) {
  if (tile === 86) return profile?.trapsStep ?? TRAP_POOLS.step;
  if (tile === 87) return profile?.trapsVicinity ?? TRAP_POOLS.vicinity;
  if (tile === 88) return profile?.trapsSpawn ?? TRAP_POOLS.spawn;
  return [];
}

function selectTrapForTile(tile, budgetRemaining = Infinity, profile) {
                                                                            
  const selectedTile = tile === 89 ? 86 + Math.floor(Math.random() * 3) : tile;
  const candidates = trapPoolForTile(selectedTile, profile);
  if (!candidates.length) return undefined;
  const name = candidates[Math.floor(Math.random() * candidates.length)];
  if (!TRAP_DEFINITIONS[name]) throw new Error(`unknown configured trap '${name}'`);
                                                                         
  return TRAP_DEFINITIONS[name].cost <= budgetRemaining ? name : undefined;
}

function spawnTrapVisual(runtime, request, name) {
  const spawned = spawnRoundEntities(featureTemplate(`trap_${name}`), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, { ...request, feature: `trap_${name}` }, spawned);
  const visual = spawned.find((entity) => entity?.IsValid() && !entity.GetClassName?.().startsWith("trigger_"));
  for (const entity of spawned) {
    if (entity === visual || !entity?.IsValid()) continue;
    entity.Kill();
    runtime.entities.delete(entity);
  }
  if (!visual) throw new Error(`trap '${name}' prototype did not spawn`);
  return visual;
}

function randomTrapOffset(range, z = 0) {
  return vec(
    Math.floor(Math.random() * (range * 2 + 1)) - range,
    Math.floor(Math.random() * (range * 2 + 1)) - range,
    z,
  );
}

function trapSpawnTransform(name, request) {
  let position = clone(request.position);
  let angles = { pitch: 0, yaw: Math.random() * 360, roll: 0 };
                                                                   
  if (name === "thigh_spider") position = add(position, randomTrapOffset(30, 1));
  else if (name === "landmine") position = add(position, randomTrapOffset(32));
  else if (name === "beartrap" || name === "bomb" || name === "flinger") {
    position = add(position, randomTrapOffset(20));
  } else if (name === "guster" || name === "blackhole") position = add(position, randomTrapOffset(20, 40));
  else if (name === "pizza") position = add(position, randomTrapOffset(18, 3));
  else if (name === "chatter_curse") position = add(position, randomTrapOffset(18, 5));
  else if (name === "banana") position = add(position, randomTrapOffset(40));
  else if (name === "explosive_barrel") {
    position = add(position, randomTrapOffset(10));
    position = add(position, vec(Math.random() < 0.5 ? -15 : 15, Math.random() < 0.5 ? -15 : 15, 0));
  }
  else if (name === "slotmachine") {
    position = add(position, vec(Math.random() < 0.5 ? -25 : 25, Math.random() < 0.5 ? -25 : 25, 0));
  }
  if (["buttonmimic", "spikes"].includes(name)) angles.yaw = Math.floor(Math.random() * 4) * 90;
  if (["chatter_curse", "guster", "flinger"].includes(name)) angles.pitch = -90;
  return { position, angles };
}

function configureTrapController(runtime, controller, request) {
  const { name, definition, visual } = controller;
  visual.SetEntityName?.(`trap_${name}_${runtime.index}`);
  if (name === "buttonmimic") {
    const themeName = themeProfile(request.themeName ?? runtime.themeSnapshot).name;
    const renderColor = { r: 255, g: 150, b: 150, a: 255 };
    const restore = () => applyTerrainAppearance(visual, 0, renderColor);
    visual.SetModel?.(rememberSilentHillVisual(runtime, visual,
      chooseTerrainModel(themeName, "button"),
      { ...request, feature: "buttonmimic", themeName, renderColor }, restore));
    restore();
  } else if (name === "mimic") {
    const itemName = HUMAN_ITEM_SELECTION_POOL[Math.floor(Math.random() * HUMAN_ITEM_SELECTION_POOL.length)];
    controller.fakeItemName = itemName;
    visual.SetModel?.(ITEM_DEFINITIONS[itemName]?.model ?? ITEM_DEFINITIONS.heal_orb.model);
    visual.SetModelScale?.(1.5);
    visual.SetColor?.({ r: 255, g: 0, b: 0, a: 255 });
  } else if (name === "banana") visual.SetModelScale?.(0.8);
  else if (name === "flinger") {
    visual.SetModelScale?.(0.8);
    visual.SetColor?.({ r: 255, g: 0, b: 0, a: 255 });
  } else if (name === "blackhole") {
    visual.SetModelScale?.(0.9);
    visual.SetColor?.({ r: 0, g: 0, b: 0, a: 255 });
    controller.battery = definition.battery;
  } else if (name === "spikes") visual.SetModelScale?.(4.9);
  else if (name === "chatter_curse") {
    visual.SetModelScale?.(2);
    visual.SetColor?.({ r: 255, g: 255, b: 255, a: 50 });
  } else if (name === "guster") {
    visual.SetModelScale?.(1.5);
    visual.SetColor?.({ r: 0, g: 0, b: 0, a: 180 });
  } else if (name === "bomb") {
    visual.SetModelScale?.(2);
    visual.SetColor?.({ r: 255, g: 200, b: 200, a: 100 });
  } else if (name === "pizza") visual.SetModelScale?.(15);
  else if (name === "beartrap") {
    fireTarget(visual, "SetAnimation", "idle");
    fireTarget(visual, "SetDefaultAnimation", "idle", 0.02);
  } else if (name === "slotmachine") {
    controller.usesRemaining = definition.usesMin
      + Math.floor(Math.random() * (definition.usesMax - definition.usesMin + 1));
    fireTarget(visual, "SetAnimation", "win");
    fireTarget(visual, "SetDefaultAnimation", "win", 0.02);
  } else if (name === "explosive_barrel") {
    // Script reloads can precede a map rebuild. An old prototype must not abort
    // the entire level; retain its damage output while reporting the mismatch.
    if (visual.GetClassName?.().startsWith("prop_dynamic")) {
      const key = "trap_barrel_legacy_prototype";
      if (!state.missingOptionalTemplateWarnings.has(key)) {
        state.missingOptionalTemplateWarnings.add(key);
        message("explosive barrel is using its old dynamic prototype; rebuild the map for native physics damage");
      }
    }
    controller.runtime = runtime;
    controller.hitsRemaining = definition.hitsMin
      + Math.floor(Math.random() * (definition.hitsMax - definition.hitsMin + 1));
    visual.SetMaxHealth?.(100000);
    if (typeof visual.SetHealth === "function") visual.SetHealth(100000);
    else fireTarget(visual, "SetHealth", "100000");
    fireTarget(visual, "DisableMotion");
    connectOwnedOutput(runtime, visual, "OnTakeDamage", (event) => damageTrapController(controller, event));
  } else if (name === "thigh_spider") {
    controller.health = definition.healthBase + definition.healthPerHuman
      * allPlayerPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3).length;
    controller.grounded = false;
    controller.velocity = vec();
    controller.jumpedOnce = false;
    controller.jumping = false;
    settleThighSpiderSpawn(controller);
    visual.SetModelScale?.(1.5);
    fireTarget(visual, "SetAnimation", "idle");
    fireTarget(visual, "SetDefaultAnimation", "idle", 0.02);
    spawnThighSpiderDamageHitbox(runtime, controller);
  }
}

function spawnThighSpiderDamageHitbox(runtime, controller) {
  const spawned = spawnRoundEntities(featureTemplate("trapSpiderDamage"), controller.position, controller.angles) ?? [];
  finalizeSpawned(runtime, { position: controller.position, angles: controller.angles,
    feature: "trapSpiderDamage" }, spawned);
  const hitbox = spawned.length === 1 && spawned[0];
  if (!validEntity(hitbox) || hitbox.GetClassName?.() !== "prop_physics_override"
      || typeof hitbox.SetHealth !== "function"
      || String(hitbox.GetModelName?.()).replace(/_c$/i, "") !== controller.definition.damageModel) {
    for (const entity of spawned) { entity?.Kill?.(); runtime.entities.delete(entity); }
    throw new Error("thigh spider requires its authored damage hitbox");
  }
  controller.damageHitbox = hitbox;
  controller.damageHitboxHealth = controller.definition.healthSentinel + controller.health;
  hitbox.SetEntityName?.(`trap_spider_damage_${runtime.index}_${runtime.traps.size + 1}`);
  hitbox.SetMaxHealth?.(controller.damageHitboxHealth);
  hitbox.SetHealth(controller.damageHitboxHealth);
  hitbox.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(hitbox, "SetRenderMode", "1");
  fireTarget(hitbox, "SetRenderAlpha", "0");
  fireTarget(hitbox, "DisableMotion");
  raceSetCollisionGroup(hitbox, 10);
                                                                      
                                                                              
  controller.visual.SetParent?.(hitbox);
  syncThighSpiderTransform(controller, controller.angles);
  // Parenting/physics activation may finish after the initial world teleport.
  afterThink(() => {
    if (controller.spent || controller.health <= 0 || !validEntity(controller.visual)
        || !validEntity(controller.damageHitbox)) return;
    if (!controller.biting && !controller.jumping) settleThighSpiderSpawn(controller);
    controller.spiderVisualAttached = false;
    syncThighSpiderTransform(controller, controller.angles);
  });
  connectOwnedOutput(runtime, hitbox, "OnTakeDamage", (event) => thighSpiderDamageEvent(controller, event));
  connectOwnedOutput(runtime, hitbox, "OnHealthChanged", (event) => thighSpiderDamageEvent(controller, event, "health"));
}

function syncThighSpiderTransform(controller, angles) {
  const hitbox = controller.damageHitbox;
  if (validEntity(hitbox)) hitbox.Teleport?.({ position: controller.position, angles, velocity: vec() });
  const expected = add(controller.position, vec(0, 0, 15));
  const actual = controller.visual.GetAbsOrigin?.();
  const misplaced = actual && Math.hypot(actual.x - expected.x, actual.y - expected.y,
    actual.z - expected.z) > 0.1;
  if (!controller.spiderVisualAttached || !validEntity(hitbox)
      || controller.visual.GetParent?.() !== hitbox || misplaced) {
    controller.visual.Teleport?.({ position: expected, angles, velocity: vec() });
    controller.spiderVisualAttached = validEntity(hitbox) && controller.visual.GetParent?.() === hitbox;
  }
}

function thighSpiderDamageEvent(controller, event, source = "take") {
  if (controller.spent || controller.health <= 0 || !validEntity(controller.damageHitbox)) return false;
                                                                           
                                                                          
  if (source === "take") controller.pendingDamageAttacker = event?.attacker ?? event?.activator;
  const current = Number(controller.damageHitbox.GetHealth?.());
  const previous = controller.damageHitboxHealth;
  if (!Number.isFinite(current) || !Number.isFinite(previous)) return false;
  if (current >= previous) {
    if (source === "take" && !controller.damageReadQueued) {
      controller.damageReadQueued = true;
      afterThink(() => {
        controller.damageReadQueued = false;
        thighSpiderDamageEvent(controller, event, "health");
      });
    }
    return false;
  }
  controller.damageHitboxHealth = current;
  controller.health = Math.max(0, current - controller.definition.healthSentinel);
  controller.jumpedOnce = true;
  const attacker = resolvePawn(event?.attacker ?? event?.activator ?? controller.pendingDamageAttacker);
  controller.pendingDamageAttacker = undefined;
  const position = attacker?.GetAbsOrigin?.();
  if (!controller.target && attacker?.GetTeamNumber?.() === 3 && attacker?.IsAlive?.()
      && position && trapHorizontalDistance(position, controller.position) < controller.definition.targetLoseRange)
    controller.target = attacker;
  if (controller.health <= 0) {
                                                                            
                                                                            
    if (typeof controller.visual.SetParent === "function") {
      controller.visual.SetParent(undefined);
      controller.damageHitbox.Kill?.();
    }
  }
  else if (Instance.GetGameTime() >= (controller.hitFlashUntil ?? 0)) {
    controller.hitFlashUntil = Instance.GetGameTime() + 0.1;
    controller.visual.SetColor?.({ r: 255, g: 70, b: 70, a: 255 });
    afterThink(() => {
      if (!controller.spent && validEntity(controller.visual))
        controller.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
    });
  }
  return true;
}

function trapHorizontalDistance(a, b) {
  return Math.hypot(a.x - b.x, a.y - b.y);
}

function trapTargets() {
  return allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
}

function trapExplosionTargets() {
  return allLivingPawns();
}

function pawnInsideTrap(pawn, position, radius, zRange = 96) {
  const pawnPosition = pawn.GetAbsOrigin?.();
  return pawnPosition
    && trapHorizontalDistance(pawnPosition, position) <= radius
    && Math.abs(pawnPosition.z - position.z) <= zRange;
}

function pawnInsideTrapBox(pawn, position, halfSize, minZ, maxZ) {
  const pawnPosition = pawn.GetAbsOrigin?.();
  return pawnPosition
    && pawnPosition.x >= position.x - halfSize && pawnPosition.x <= position.x + halfSize
    && pawnPosition.y >= position.y - halfSize && pawnPosition.y <= position.y + halfSize
    && pawnPosition.z >= position.z + minZ && pawnPosition.z <= position.z + maxZ;
}

function pushPawn(pawn, direction, horizontal, vertical) {
  const current = pawn.GetAbsVelocity?.() ?? vec();
  pawn.Teleport({
    velocity: vec(
      current.x + direction.x * horizontal,
      current.y + direction.y * horizontal,
      Math.max(current.z, vertical),
    ),
  });
  if (pawn.GetTeamNumber?.() === 3) nullifyFalldownCheckpoint(pawn);
}

function directionBetween(from, to) {
  const delta = sub(to, from);
  const length = Math.hypot(delta.x, delta.y);
  return length > 0.001 ? vec(delta.x / length, delta.y / length, 0) : vec(1, 0, 0);
}

function directionBetween3D(from, to) {
  const delta = sub(to, from);
  const length = Math.hypot(delta.x, delta.y, delta.z);
  return length > 0.001
    ? vec(delta.x / length, delta.y / length, delta.z / length)
    : vec(1, 0, 0);
}

                                                                           
                                                                            
                                                                       
function sourceDirectionDifference(from, to, direction) {
  const targetDirection = directionBetween3D(from, to);
  const dot = Math.max(-1, Math.min(1,
    direction.x * targetDirection.x
    + direction.y * targetDirection.y
    + direction.z * targetDirection.z,
  ));
  return 90 - dot * 90;
}

function spendTrap(controller, keepVisual = false) {
  controller.spent = true;
  if (validEntity(controller.damageHitbox)) controller.damageHitbox.Kill?.();
  if (!keepVisual && controller.visual?.IsValid()) controller.visual.Kill();
}

function handleTrapFloorGrenadeBounce({ projectile, hitEntity } = {}) {
                                                                           
                                                                            
                                                                           
                                                                          
  if (!state.running || !validEntity(projectile) || !validEntity(hitEntity)) return false;
  const now = Instance.GetGameTime();
  for (const runtime of activeRuntimes()) {
    const escape = state.endingRuntime?.kind === "FINALE" && state.endingRuntime.escape;
    if (state.finaleEscapeActive && escape?.flags?.trapsDisabled !== false) continue;
    for (const controller of runtime.traps ?? []) {
      if (controller.kind !== "trapfloor" || controller.spent || controller.visual !== hitEntity) continue;
      if (now < controller.armedAt || now < (controller.disabledUntil ?? 0)) return false;
                                                                         
                                                                         
      spendTrap(controller);
      return true;
    }
  }
  return false;
}

function explodeTrap(controller, targets, radius, damage, force = 650, keepVisual = false) {
  const cue = controller.name === "landmine" ? 6031
    : controller.name === "explosive_barrel" ? 5886 : 5662;
  playSourceAudioCue(cue, add(controller.position, vec(0, 0, controller.name === "explosive_barrel" ? 48 : 8)));
  for (const pawn of targets) {
    const pawnPosition = pawn.GetAbsOrigin?.();
    if (!pawnPosition) continue;
    const distance = Math.hypot(
      pawnPosition.x - controller.position.x,
      pawnPosition.y - controller.position.y,
      pawnPosition.z - controller.position.z,
    );
    if (distance > radius) continue;
    const scale = Math.max(0.15, 1 - distance / radius);
    damagePawn(pawn, Math.max(1, Math.round(damage * scale)));
    pushPawn(pawn, directionBetween(controller.position, pawnPosition), force * scale, Math.max(220, force * 0.55 * scale));
  }
  spendTrap(controller, keepVisual);
}

function trapCanAffect(controller, pawn, now, cooldown = 1) {
  const ready = controller.cooldowns.get(pawn) ?? 0;
  if (ready > now) return false;
  controller.cooldowns.set(pawn, now + cooldown);
  return true;
}

function activateStepTrap(runtime, controller, pawn, now) {
  const { name, definition } = controller;
  if (name === "landmine") {
    if (!trapCanAffect(controller, pawn, now, 9999)) return;
    playSourceAudioCue(6032, controller.position);
    explodeTrap(controller, trapExplosionTargets(), definition.explosionRadius, definition.explosionDamage, 1100);
  } else if (name === "banana") {
    if (!trapCanAffect(controller, pawn, now, 9999)) return;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    const position = pawn.GetAbsOrigin?.() ?? controller.position;
    controller.spinVictim = pawn;
    controller.spinStartedAt = now;
    controller.spinUntil = now + definition.spinTime;
    controller.spinStartYaw = viewAngles(pawn)?.yaw ?? bodyAngles(pawn)?.yaw ?? 0;
    controller.spinDirection = Math.random() < 0.5 ? -1 : 1;
    controller.spinVelocity = vec(velocity.x, velocity.y, 0);
    controller.visual?.Kill?.();
    pawn.Teleport?.({ velocity: vec(velocity.x, velocity.y, 0) });
    nullifyFalldownCheckpoint(pawn);
    playSourceAudioCue(5115, position, {parent:pawn,lifetime:controller.definition.spinTime + 0.2});
  } else if (name === "spikes") {
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    if (Math.hypot(velocity.x, velocity.y, velocity.z) <= definition.runSpeed) return;
    if (!trapCanAffect(controller, pawn, now, 0.25)) return;
    const falling = velocity.z < -definition.fallSpeed;
    damagePawn(pawn, falling ? definition.fallDamage : definition.runDamage);
    if (!falling) pawn.Teleport?.({ velocity: vec(0, 0, velocity.z) });
    playSourceAudioStack(falling ? [5356, 5357] : [5363], pawn.GetAbsOrigin?.() ?? controller.position);
  } else if (name === "pizza") {
    if (!trapCanAffect(controller, pawn, now, 0.20)) return;
    damagePawn(pawn, 999999);
    for (let i = 0; i < 3; i++) {
      playSourceAudioCue(6086, controller.position);
      playSourceAudioCue(6087, controller.position);
    }
  } else if (name === "beartrap") {
    if (!trapCanAffect(controller, pawn, now, 9999)) return;
    damagePawn(pawn, definition.damage);
    if (pawn.IsAlive?.()) addPlayerStatus(runtime, pawn, `${controller.source}:beartrap`, definition.freezeTime, {
      frozenPosition: pawn.GetAbsOrigin?.() ?? controller.position,
    });
    fireTarget(controller.visual, "SetAnimation", "snap");
    fireTarget(controller.visual, "SetDefaultAnimation", "snapped", 0.02);
    playSourceAudioStack([6147, 6148, 6149], controller.position);
    controller.releaseAt = now + definition.freezeTime;
    controller.removeAt = now + definition.freezeTime + 2.4;
    spendTrap(controller, true);
  } else if (name === "chatter_curse") {
    if (controller.victim || !trapCanAffect(controller, pawn, now, 9999)) return;
    controller.victim = pawn;
    controller.phrase = TRAP_CHATTER_PHRASES[Math.floor(Math.random() * TRAP_CHATTER_PHRASES.length)];
    controller.nextCurseAt = now + 0.10;
    controller.visual?.Kill?.();
    playSourceAudioCue(5520, pawn.GetAbsOrigin?.() ?? controller.position, {recipient:pawn});
  }
}

function activateVicinityTrap(runtime, controller, pawn, now) {
  if (controller.name === "bomb") {
    if (controller.triggeredAt !== undefined) return;
    controller.triggeredAt = now + controller.definition.fuseTime;
    controller.nextBeepAt = now;
    controller.beepRate = 1;
    playSourceAudioCue(5834, controller.position);
    return;
  }
  if (controller.name === "blackhole" || controller.triggeredAt !== undefined) return;
  controller.triggeredAt = now;
  const pawnPosition = pawn.GetAbsOrigin?.() ?? controller.position;
  if (controller.name === "flinger") {
    for (const target of trapTargets()) {
      const targetPosition = target.GetAbsOrigin?.();
      if (!targetPosition || Math.hypot(
        targetPosition.x - controller.position.x,
        targetPosition.y - controller.position.y,
        targetPosition.z - controller.position.z,
      ) > controller.definition.radius) continue;
      pushPawn(
        target,
        directionBetween(controller.position, targetPosition),
        controller.definition.force,
        controller.definition.zMin + Math.random() * (controller.definition.zMax - controller.definition.zMin),
      );
    }
    playSourceAudioStack([5195, 5196], controller.position);
    spendTrap(controller);
  } else if (controller.name === "guster") {
    const direction = directionBetween(controller.position, add(pawnPosition, vec(0, 0, 40)));
    controller.wave = {
      position: clone(controller.position), direction,
      expiresAt: now + controller.definition.waveLifetime,
      hitCooldowns: new Map(),
    };
    controller.visual?.SetModelScale?.(2);
    playSourceAudioCue(5599, controller.position);
  }
}

function activeMinislotCount() {
  let count = 0;
  for (const level of activeRuntimes()) {
    for (const item of level.items ?? []) {
      if (item.name === "minislots" && !["consumed", "cleaned"].includes(item.state)) count++;
    }
  }
  return count;
}

function destroySlotMachine(runtime, controller) {
  controller.minislotRoll = Math.random() * 100 <= controller.definition.minislotSpawnChance;
  if (controller.minislotRoll && activeMinislotCount() < controller.definition.minislotMaximum) {
    const template = state.featureTemplates.get("item_minislots");
    if (validEntity(template) && typeof template.ForceSpawn === "function") {
      spawnItemFeature(runtime, {
        kind: "feature", feature: "item", tile: 93, team: 3,
        debugItem: true, itemName: "minislots",
        position: add(controller.position, vec(0, 0, 40)),
        angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 },
      });
      controller.minislotSpawned = true;
    } else controller.minislotSpawnSkipped = "template_item_minislots unavailable";
  }
  playSourceAudioCue(5663, add(controller.position, vec(0, 0, 48)));
  explodeTrap(
    controller, trapExplosionTargets(),
    controller.definition.explosionRadius, controller.definition.explosionDamage, 650,
  );
}

function useSlotMachine(runtime, controller, pawn, now) {
  if (controller.inUse || now < (controller.reuseAt ?? 0)) return false;
  controller.usesRemaining--;
  if (controller.usesRemaining < 0) {
    destroySlotMachine(runtime, controller);
    return true;
  }
  controller.inUse = true;
  controller.player = pawn;
  controller.outcomeAt = now + controller.definition.spinTime;
  controller.reuseAt = now + controller.definition.reuseDelay;
  fireTarget(controller.visual, "SetAnimation", "spin");
  fireTarget(controller.visual, "SetDefaultAnimation", "spin", 0.02);
  fireTarget(controller.visual, "SetPlaybackRate", "11", 0.03);
  playSourceAudioCue(5723, add(controller.position, vec(0, 0, 48)));
  return true;
}

function finishSlotOutcome(controller) {
  const pawn = controller.player;
  controller.inUse = false;
  controller.player = undefined;
  const won = Math.random() * 100 <= controller.definition.winChance;
  fireTarget(controller.visual, "SetAnimation", won ? "win" : "lose");
  fireTarget(controller.visual, "SetDefaultAnimation", won ? "win" : "lose", 0.02);
  if (won) {
    playSourceAudioCue(5680, add(controller.position, vec(0, 0, 48)));
    if (pawn?.IsValid?.() && pawn.IsAlive?.() && pawn.GetTeamNumber?.() === 3) {
      pawn.SetHealth?.((pawn.GetHealth?.() ?? 0) + controller.definition.winHealth);
    }
  } else {
    playSourceAudioCue(5689, add(controller.position, vec(0, 0, 48)));
    if (pawn?.IsValid?.() && pawn.IsAlive?.() && pawn.GetTeamNumber?.() === 3) {
      damagePawn(pawn, controller.definition.loseHealth);
    }
  }
}

function activateFatalMimic(controller, pawn, button = false) {
  if (controller.spent || pawn.GetTeamNumber?.() !== 3 || !pawn.IsAlive?.()) return false;
  state.silentHillWorld.visuals.delete(controller.visual);
  controller.visual?.SetModel?.("models/luffaren/beartrap.vmdl");
  controller.visual?.SetModelScale?.(1.8);
  controller.visual?.Teleport?.({
    position: add(controller.position, vec(0, 0, -8)),
    angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 }, velocity: vec(),
  });
  fireTarget(controller.visual, "SetAnimation", "snap");
  fireTarget(controller.visual, "SetDefaultAnimation", "snapped", 0.03);
  playSourceAudioCue(5021, controller.position);
  playSourceAudioCue(5022, controller.position);
  damagePawn(pawn, 999999);
  controller.removeAt = Instance.GetGameTime() + 0.35;
  controller.mimicKind = button ? "button" : "item";
  spendTrap(controller, true);
  return true;
}

function trapHasLineOfSight(controller, pawn) {
  if (typeof Instance.TraceLine !== "function") return true;
  const targetPosition = pawn?.GetAbsOrigin?.();
  if (!targetPosition) return false;
  try {
    const end = add(targetPosition, vec(0, 0, 40));
    const trace = Instance.TraceLine({
      start: add(controller.position, vec(0, 0, 30)),
      end,
      ignoreEntity: [controller.visual, controller.damageHitbox].filter(validEntity),
    });
    if (!trace || !(trace.didHit ?? trace.hit ?? false)) return true;
    const hitEntity = trace.entity ?? trace.hitEntity;
    if (hitEntity === pawn) return true;
    const hitPosition = trace.end ?? trace.position;
    return !!hitPosition && Math.hypot(
      hitPosition.x - end.x,
      hitPosition.y - end.y,
      hitPosition.z - end.z,
    ) <= 4;
  } catch {
    return true;
  }
}

function traceThighSpiderWorld(controller, start, end) {
  // Original movement root: (-10,-10,0)..(10,10,15), independent of the
  // taller damage box and the 1.5x display model.
  const trace = Instance.TraceBox({
    start, end, mins: vec(-10, -10, 0), maxs: vec(10, 10, 15),
    ignoreEntity: [controller.visual, controller.damageHitbox].filter(validEntity),
    ignorePlayers: true,
  });
  if (!trace) return trace;
  // fraction locates the swept movement root, independent of contact-point
  // or hull-center coordinates returned in end for an asymmetric box.
  const fraction = Math.max(0, Math.min(1, trace.fraction));
  return { ...trace, end: add(start, mul(sub(end, start), fraction)) };
}

function recoverThighSpiderGround(controller) {
  const origin = clone(controller.position);
  // Only repair shallow vertical spawn penetration. Do not move sideways
  // through a wall or jump onto a distant floor/ceiling.
  for (const lift of [2, 4, 8, 16, 32]) {
    const start = add(origin, vec(0, 0, lift));
    const clear = traceThighSpiderWorld(controller, start, start);
    if (!clear || clear.startedInSolid || clear.didHit) continue;
    const support = traceThighSpiderWorld(controller, start, origin);
    if (!support?.didHit || support.startedInSolid || support.normal.z < 0.7
        || support.end.z - origin.z > CONFIG.elevationStep) continue;
    const position = add(support.end, vec(0, 0, 0.05));
    const placed = traceThighSpiderWorld(controller, position, position);
    if (!placed || placed.startedInSolid || placed.didHit) continue;
    controller.position = position;
    controller.velocity = vec();
    controller.grounded = true;
    controller.embedded = false;
    controller.spawnGroundAdjusted = true;
    return true;
  }
  return false;
}

function settleThighSpiderSpawn(controller) {
  const trace = traceThighSpiderWorld(controller, controller.position, controller.position);
  if (trace?.startedInSolid) {
    controller.embedded = true;
    recoverThighSpiderGround(controller);
  } else if (trace) {
    controller.grounded = thighSpiderSupport(controller);
  }
}

function thighSpiderSupport(controller) {
  if ((controller.velocity?.z ?? 0) > 0) return false;
  const trace = traceThighSpiderWorld(controller,
    add(controller.position, vec(0, 0, 2)), add(controller.position, vec(0, 0, -5)));
  if (!trace.didHit || trace.startedInSolid || trace.normal.z < 0.7) return false;
  controller.position = add(trace.end, vec(0, 0, 0.05));
  controller.velocity = vec();
  return true;
}

function finishThighSpiderJump(controller, now) {
  controller.jumping = false;
  controller.nextJumpAt = now + controller.definition.jumpCooldown
    + Math.random() * controller.definition.jumpCooldownJitter;
  controller.nudgeAt = undefined;
  controller.nudgeVelocity = undefined;
  fireTarget(controller.visual, "SetAnimation", "idle");
  fireTarget(controller.visual, "SetDefaultAnimation", "idle", 0.02);
}

function advanceThighSpider(controller, elapsed) {
  controller.velocity ??= vec();
  controller.grounded = false;
  controller.velocity.z -= CONFIG.worldGravity * elapsed;
  let remaining = elapsed;
  // Sweep the hull and remove velocity into walls/ceilings. Bounded repeat
  // sweeps let gravity continue along a wall instead of freezing in midair.
  for (let pass = 0; pass < 3 && remaining > 0.0001; pass++) {
    const start = controller.position;
    const end = add(start, mul(controller.velocity, remaining));
    const trace = traceThighSpiderWorld(controller, start, end);
    if (trace.startedInSolid) {
      controller.embedded = true;
      if (!recoverThighSpiderGround(controller)) controller.velocity = vec();
      break;
    }
    controller.embedded = false;
    controller.position = clone(trace.end);
    if (!trace.didHit) break;
    const normal = trace.normal;
    controller.position = add(controller.position, mul(normal, 0.05));
    if (normal.z >= 0.7 && controller.velocity.z <= 0) {
      controller.velocity = vec();
      controller.grounded = true;
      break;
    }
    const intoSurface = controller.velocity.x * normal.x
      + controller.velocity.y * normal.y + controller.velocity.z * normal.z;
    if (intoSurface < 0) controller.velocity = sub(controller.velocity, mul(normal, intoSurface));
    remaining *= 1 - trace.fraction;
  }
  if (!controller.grounded) controller.grounded = thighSpiderSupport(controller);
}

function updateThighSpider(runtime, controller, targets, now, elapsed) {
  const definition = controller.definition;
  if (controller.health <= 0) {
    if (!controller.deadAt) {
      controller.deadAt = now;
      fireTarget(controller.visual, "SetAnimation", "dead");
      fireTarget(controller.visual, "SetDefaultAnimation", "dead", 0.02);
      fireTarget(controller.visual, "FadeAndKill", "3", 7);
      playSourceAudioCue(4781, controller.position);
      playSourceAudioStack([4782, 4783], controller.position);
    }
    if (now >= controller.deadAt + 10) spendTrap(controller);
    return;
  }
  let target = controller.target;
  let targetPosition = target?.GetAbsOrigin?.();
  if (!target?.IsValid?.() || !target.IsAlive?.() || target.GetTeamNumber?.() !== 3
      || !targetPosition || Math.hypot(targetPosition.x - controller.position.x, targetPosition.y - controller.position.y,
        targetPosition.z - controller.position.z) > definition.targetLoseRange) {
    if (controller.biting) {
      controller.velocity = vec(0, 0, -300);
      fireTarget(controller.visual, "SetAnimation", "idle");
      fireTarget(controller.visual, "SetDefaultAnimation", "idle", 0.02);
    }
    target = undefined;
    targetPosition = undefined;
    controller.target = undefined;
    controller.biting = false;
    controller.jumpedOnce = false;
  }
  if (!target) {
    const candidates = targets
      .map((pawn) => ({ pawn, position: pawn.GetAbsOrigin?.() }))
      .filter(({ pawn, position }) => position
        && Math.hypot(position.x - controller.position.x, position.y - controller.position.y,
          position.z - controller.position.z) <= definition.targetRange
        && trapHasLineOfSight(controller, pawn));
    if (candidates.length > 0) {
      ({ pawn: target, position: targetPosition } = candidates[Math.floor(Math.random() * candidates.length)]);
      controller.target = target;
      playSourceAudioCue(4836, controller.position);
    }
  }
  const delta = targetPosition && sub(add(targetPosition, vec(0, 0, 30)), add(controller.position, vec(0, 0, 15)));
  const distance = delta ? Math.hypot(delta.x, delta.y, delta.z) : Infinity;
  const direction = targetPosition ? directionBetween(controller.position, targetPosition) : undefined;
  if (target && (controller.biting || distance <= definition.biteRange)) {
    const wasBiting = controller.biting;
    controller.biting = true;
    controller.jumping = false;
    controller.grounded = false;
    if (!wasBiting) {
      const yaw = Math.random() * Math.PI * 2;
      controller.biteOffset = vec(Math.cos(yaw) * 20, Math.sin(yaw) * 20, 20 + Math.random() * 5);
      fireTarget(controller.visual, "SetDefaultAnimation", "stuck", 0.02);
    }
    controller.position = add(targetPosition, controller.biteOffset);
    controller.velocity = vec();
    controller.nudgeAt = undefined;
    controller.nudgeVelocity = undefined;
    const targetVelocity = target.GetAbsVelocity?.() ?? vec();
    target.Teleport?.({ velocity: vec(0, 0, Math.min(0, targetVelocity.z)) });
    if (now >= (controller.nextBiteAt ?? 0)) {
      controller.nextBiteAt = now + definition.biteInterval;
      damagePawn(target, definition.biteDamage);
      playSourceAudioCue(4852, add(targetPosition, vec(0, 0, 35)));
    }
    fireTarget(controller.visual, "SetAnimation", "stuck");
  } else {
    controller.biting = false;
    controller.grounded = thighSpiderSupport(controller);
    if (controller.jumping && (controller.grounded || now >= (controller.jumpStartedAt ?? now) + definition.jumpTimeout))
      finishThighSpiderJump(controller, now);
    if (controller.nudgeAt !== undefined && now >= controller.nudgeAt) {
      controller.velocity = add(controller.velocity ?? vec(), controller.nudgeVelocity ?? vec());
      controller.nudgeAt = undefined;
      controller.nudgeVelocity = undefined;
    }
    const jumpRange = controller.jumpedOnce && definition.jumpAfterFirst
      ? definition.targetLoseRange : definition.jumpRange;
    if (targetPosition && controller.grounded && now >= (controller.nextJumpAt ?? 0)
        && !controller.jumping
        && Math.hypot(targetPosition.x - controller.position.x, targetPosition.y - controller.position.y,
          targetPosition.z - controller.position.z) <= jumpRange) {
      const jumpHeight = targetPosition.z > controller.position.z + definition.jumpHeightThreshold
        ? definition.jumpHeightHigh : definition.jumpHeight;
      controller.velocity = vec(direction.x * definition.jumpSpeed, direction.y * definition.jumpSpeed, jumpHeight);
      controller.jumpedOnce = true;
      controller.jumping = true;
      controller.grounded = false;
      controller.jumpStartedAt = now;
      controller.position.z += 1;
      controller.nudgeAt = now + definition.jumpNudgeDelay;
      controller.nudgeVelocity = mul(direction, definition.jumpNudgeForce);
      fireTarget(controller.visual, "SetAnimation", "jumping");
      fireTarget(controller.visual, "SetDefaultAnimation", "jumping", 0.02);
      playSourceAudioCue(4868, controller.position);
    }
    if (!controller.grounded) advanceThighSpider(controller, elapsed);
    if (controller.grounded && controller.jumping) finishThighSpiderJump(controller, now);
    if (controller.position.z < -11000) controller.health = 0;
  }
  const angles = { pitch: 0, yaw: direction ? yawOf(direction) : (controller.angles?.yaw ?? 0), roll: 0 };
  controller.angles = angles;
  syncThighSpiderTransform(controller, angles);
}

function processChatterCurse(controller, now) {
  const victim = controller.victim;
  if (!victim?.IsValid?.() || !victim.IsAlive?.() || victim.GetTeamNumber?.() !== 3) {
    controller.spent = true;
    return;
  }
  if (now < controller.nextCurseAt) return;
  controller.nextCurseAt = now + controller.definition.tickInterval;
  damagePawn(victim, controller.definition.damage);
  message(`[CURSE] ${victim.GetPlayerController?.()?.GetPlayerName?.() ?? "human"}: type '${controller.phrase}' or die`);
}

function processBananaSpin(controller, now) {
  const pawn = controller.spinVictim;
  if (!pawn?.IsValid?.() || !pawn.IsAlive?.() || now >= controller.spinUntil) {
    controller.spent = true;
    controller.spinVictim = undefined;
    return;
  }
  const progress = Math.max(0, Math.min(1, (now - controller.spinStartedAt) / controller.definition.spinTime));
  const angles = viewAngles(pawn) ?? { pitch: 0, yaw: 0, roll: 0 };
  const velocity = pawn.GetAbsVelocity?.() ?? vec();
  pawn.Teleport?.({
    angles: {
      pitch: 0,
      yaw: normalizeYaw(controller.spinStartYaw
        + controller.spinDirection * controller.definition.spinDegrees * progress),
      roll: angles.roll ?? 0,
    },
    velocity: vec(controller.spinVelocity.x, controller.spinVelocity.y, velocity.z),
  });
}

function processGusterWave(controller, targets, now, elapsed) {
  const wave = controller.wave;
  if (!wave || now >= wave.expiresAt) {
    spendTrap(controller);
    return;
  }
  wave.position = add(wave.position, mul(wave.direction, controller.definition.waveSpeed * elapsed));
  controller.position = wave.position;
  controller.visual?.Teleport?.({
    position: wave.position,
    angles: { pitch: 0, yaw: yawOf(wave.direction), roll: 0 }, velocity: vec(),
  });
  for (const pawn of targets) {
    if (!pawnInsideTrap(pawn, wave.position, controller.definition.waveRadius, 40)) continue;
    if ((wave.hitCooldowns.get(pawn) ?? 0) > now) continue;
    wave.hitCooldowns.set(pawn, now + 0.1);
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport?.({ velocity: vec(
      wave.direction.x * controller.definition.pushSpeed,
      wave.direction.y * controller.definition.pushSpeed,
      velocity.z <= 1 ? controller.definition.pushUp : velocity.z,
    ) });
    nullifyFalldownCheckpoint(pawn);
  }
}

function processBlackhole(controller, targets, now) {
  if (now < (controller.nextActionAt ?? 0)) return;
  controller.nextActionAt = now + 0.2;
  let pulling = false;
  for (const pawn of targets) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const distance = Math.hypot(
      position.x - controller.position.x,
      position.y - controller.position.y,
      position.z - controller.position.z,
    );
    if (distance > controller.definition.radius) continue;
    pulling = true;
    if (distance <= controller.definition.killDistance) {
      controller.battery -= controller.definition.killDrain;
      damagePawn(pawn, 999999);
      playSourceAudioCue(5265, controller.position);
      continue;
    }
    const pull = (controller.definition.radius - distance) * controller.definition.pullMultiplier;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    const direction = directionBetween(position, controller.position);
    pawn.Teleport?.({ velocity: add(velocity, mul(direction, pull)) });
    controller.battery -= (controller.definition.radius - distance) * 0.1
      * controller.definition.distanceDrainMultiplier;
  }
  // Source 1 cut a 0.05s hum every tick; CS2 emitters play the full clip, so
  // only hum while pulling and wait for the previous clip to finish.
  if (pulling && now >= (controller.nextHumAt ?? 0)) {
    const pitch = 25 + Math.floor(Math.random() * 11);
    playSourceAudioCue(5275, controller.position, { pitch });
    controller.nextHumAt = now + SOURCE_AUDIO_ASSETS.whip_me_daddy.seconds / (pitch / 100);
  }
  if (controller.battery <= 0) spendTrap(controller);
}

function detonateBarrel(controller) {
  if (controller.spent) return;
  // Source env_explosion was centered 32 units above the barrel origin.
  // Reuse the authored transient particle templates and their level-owned cleanup.
  try {
    spawnItemParticles(controller.runtime, undefined,
      ["explosion_hegrenade_brief", "explosion_child_distort01b"],
      add(controller.position, vec(0, 0, 32)), undefined, 0.5);
  } catch (error) {
    const key = "trap_barrel_explosion_fx";
    if (!state.missingOptionalTemplateWarnings.has(key)) {
      state.missingOptionalTemplateWarnings.add(key);
      message(`explosive barrel particle unavailable: ${error}`);
    }
  }
  const targets = trapExplosionTargets();
  for (const pawn of targets) {
    const position = pawn.GetAbsOrigin?.();
    if (!position || Math.hypot(
      position.x - controller.position.x,
      position.y - controller.position.y,
      position.z - controller.position.z,
    ) > controller.definition.igniteRadius) continue;
    fireTarget(pawn, "IgniteLifeTime", String(controller.definition.igniteTime));
  }
  playSourceAudioCue(5887, add(controller.position, vec(0, 0, 48)));
  explodeTrap(controller, targets, controller.definition.explosionRadius, controller.definition.explosionDamage, 650);
}

function damageTrapController(controller, event) {
  if (controller.spent) return;
  if (controller.name === "explosive_barrel") {
    controller.hitsRemaining--;
    if (controller.hitsRemaining <= 0) detonateBarrel(controller);
    else {
      // OnTakeDamage can run before the engine commits health loss.
      afterThink(() => {
        if (controller.spent || !validEntity(controller.visual)) return;
        if (typeof controller.visual.SetHealth === "function") controller.visual.SetHealth(100000);
        else fireTarget(controller.visual, "SetHealth", "100000");
      });
      const now = Instance.GetGameTime();
      if (now >= (controller.hitFlashUntil ?? 0)) {
        controller.hitFlashUntil = now + 0.06;
        controller.visual?.SetColor?.({ r: 200, g: 0, b: 0, a: 255 });
        schedule(0.05, () => {
          if (!controller.spent && validEntity(controller.visual))
            controller.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
        }, controller.runtime.index);
      }
    }
  } else if (controller.name === "thigh_spider") {
    thighSpiderDamageEvent(controller, event);
  }
}

function processChatterCurseChat(event) {
  const pawn = resolvePawn(event?.player ?? event?.controller ?? event?.pawn);
  const text = String(event?.text ?? event?.message ?? "").toLowerCase();
  if (!pawn || !text) return false;
  for (const runtime of activeRuntimes()) {
    for (const controller of runtime.traps ?? []) {
      if (controller.name !== "chatter_curse" || controller.victim !== pawn || controller.spent) continue;
      if (text !== controller.phrase.toLowerCase()) continue;
      controller.spent = true;
      controller.victim = undefined;
      playSourceAudioCue(5557, pawn.GetAbsOrigin?.() ?? controller.position, {recipient:pawn});
      return true;
    }
  }
  return false;
}

function trapInteractionCandidate(pawn) {
  const origin = pawn.GetAbsOrigin?.();
  if (!origin) return undefined;
  const direction = directionWithPitchOffset(pawn);
  let best;
  for (const runtime of activeRuntimes()) {
    for (const controller of runtime.traps ?? []) {
      if (controller.spent || !["buttonmimic", "slotmachine"].includes(controller.name)) continue;
      const range = controller.definition.useRadius;
      const delta = sub(controller.position, add(origin, vec(0, 0, 48)));
      const distance = Math.hypot(delta.x, delta.y, delta.z);
      if (distance > range) continue;
      const dot = distance > 0.001
        ? (delta.x * direction.x + delta.y * direction.y + delta.z * direction.z) / distance
        : 1;
      if (dot < 0.45 || (best && best.distance <= distance)) continue;
      best = { runtime, controller, distance };
    }
  }
  return best;
}

function processTrapInputs(usePressed, consumed = new Set()) {
  const escape = state.endingRuntime?.kind === "FINALE" && state.endingRuntime.escape;
  if (state.finaleEscapeActive && escape?.flags?.trapsDisabled !== false) return consumed;
  const now = Instance.GetGameTime();
  for (const pawn of usePressed ?? []) {
    if (consumed.has(pawn) || pawn.GetTeamNumber?.() !== 3 || !pawn.IsAlive?.()) continue;
    const candidate = trapInteractionCandidate(pawn);
    if (!candidate) continue;
    const { runtime, controller } = candidate;
    const used = controller.name === "buttonmimic"
      ? activateFatalMimic(controller, pawn, true)
      : useSlotMachine(runtime, controller, pawn, now);
    if (used) consumed.add(pawn);
  }
  return consumed;
}

function processTraps(now) {
  if (now < state.nextTrapTickAt) return;
  state.nextTrapTickAt = now + CONFIG.trapTickInterval;
  const targets = trapTargets();
  for (const runtime of activeRuntimes()) {
    const escape = state.endingRuntime?.kind === "FINALE" && state.endingRuntime.escape;
    if (state.finaleEscapeActive && escape?.flags?.trapsDisabled !== false) continue;
    for (const controller of runtime.traps ?? []) {
      if (controller.releaseAt !== undefined && now >= controller.releaseAt) {
        fireTarget(controller.visual, "SetAnimation", "idle");
        fireTarget(controller.visual, "SetDefaultAnimation", "idle", 0.02);
        playSourceAudioCue(6136, controller.position);
        controller.releaseAt = undefined;
      }
      if (controller.removeAt !== undefined && now >= controller.removeAt) {
        controller.visual?.Kill?.();
        controller.removeAt = undefined;
      }
      if (controller.name === "chatter_curse" && controller.victim && !controller.spent) {
        processChatterCurse(controller, now);
        continue;
      }
      if (controller.name === "banana" && controller.spinVictim && !controller.spent) {
        processBananaSpin(controller, now);
        continue;
      }
      if (controller.spent || !controller.visual?.IsValid()) continue;
      if (now < (controller.disabledUntil ?? 0)) continue;
      if (controller.name === "kart") {
        updateKartController(runtime, controller, CONFIG.trapTickInterval, now);
        processKartJihad(runtime, [controller], now);
      } else if (controller.kind === "trapfloor") {
        if (now >= controller.armedAt && targets.some((pawn) => pawnInsideTrap(pawn, controller.position, 52, 120))) spendTrap(controller);
      } else if (controller.definition.pool === "step") {
        const { triggerHalfSize, triggerMinZ, triggerMaxZ } = controller.definition;
        for (const pawn of targets) {
          if (triggerHalfSize !== undefined
            ? pawnInsideTrapBox(pawn, controller.position, triggerHalfSize, triggerMinZ, triggerMaxZ)
            : pawnInsideTrap(
              pawn, controller.position, controller.definition.radius, controller.definition.zRange,
            )) activateStepTrap(runtime, controller, pawn, now);
          if (controller.spent) break;
        }
      } else if (controller.definition.pool === "vicinity") {
        if (controller.name === "blackhole") {
          processBlackhole(controller, targets, now);
        } else if (controller.name === "guster" && controller.wave) {
          processGusterWave(controller, targets, now, CONFIG.trapTickInterval);
        } else {
          for (const pawn of targets) {
            if (pawnInsideTrapBox(
              pawn, controller.position, controller.definition.triggerRadius,
              controller.definition.triggerMinZ, controller.definition.triggerMaxZ,
            )) {
              activateVicinityTrap(runtime, controller, pawn, now);
            }
          }
          if (controller.spent) continue;
          if (controller.name === "bomb" && controller.triggeredAt !== undefined && now >= (controller.nextBeepAt ?? Infinity)) {
            playSourceAudioCue(5827, controller.position, { pitch: Math.min(255, 80 + (controller.definition.fuseTime - Math.max(0, controller.triggeredAt - now)) * 5) });
            controller.beepRate = Math.max(0.15, (controller.beepRate ?? 1) - 0.08);
            controller.nextBeepAt = now + controller.beepRate;
          }
          if (controller.name === "bomb" && controller.triggeredAt !== undefined && now >= controller.triggeredAt) {
            playSourceAudioStack([5798, 5799], add(controller.position, vec(0, 0, 8)));
            explodeTrap(
              controller, trapExplosionTargets(),
              controller.definition.explosionRadius, controller.definition.explosionDamage, 800,
            );
          }
        }
      } else if (controller.name === "slotmachine") {
        if (controller.inUse && now >= controller.outcomeAt) finishSlotOutcome(controller);
      } else if (controller.name === "explosive_barrel") {
                                                                             
      } else if (controller.name === "mimic") {
        const victim = targets.find((pawn) => pawnInsideTrap(
          pawn, controller.position, controller.definition.radius, controller.definition.zRange,
        ));
        if (victim) activateFatalMimic(controller, victim, false);
      } else if (controller.name === "buttonmimic") {
                                                                        
      } else if (controller.name === "thigh_spider") {
        const elapsed = Math.max(0, Math.min(0.1, now - (controller.lastMotionAt ?? now - CONFIG.trapTickInterval)));
        controller.lastMotionAt = now;
        updateThighSpider(runtime, controller, targets, now, elapsed);
      } else {
        throw new Error(`unhandled trap controller '${controller.name}'`);
      }
    }
  }
}

function spawnTrapFeature(runtime, request) {
  const stage = stageSnapshotForRuntime(runtime);
  if (request.tile === 85) {
    const visual = spawnModelBlock(
      runtime,
      { ...request, feature: "trapfloor" },
      request.themeModel ?? chooseTerrainModel(request.themeName, "trapfloor"),
    );
    if (!visual) throw new Error("trapfloor prototype did not spawn");
    const armed = request.debugTrap === true || (!CONFIG.disableTrapFloors
      && Math.random() * 100 <= (stage.trapfloorChance ?? stage.trapChance));
    applyTerrainAppearance(visual, armed ? 1 : 0);
    if (!armed) spawnBlockSafetyTrigger(runtime, request);
    if (armed) {
      runtime.traps.add({
        kind: "trapfloor", name: "trapfloor", visual, position: clone(request.position),
        armedAt: Instance.GetGameTime() + CONFIG.trapFloorArmDelay, spent: false,
      });
    }
    return;
  }
  if (!request.debugTrap && (!FEATURE_FLAGS.traps || CONFIG.disableTraps)) return;
  const tile = request.tile === 89 ? 86 + Math.floor(Math.random() * 3) : request.tile;
  const chanceKey = { 86: "trapstepChance", 87: "trapvicinityChance", 88: "trapspawnChance" }[tile];
  if (!request.debugTrap && Math.random() * 100 > (stage[chanceKey] ?? stage.trapChance)) return;
  const profile = themeProfile(request.themeName ?? runtime.themeSnapshot);
  const name = request.trapName
    ?? selectTrapForTile(tile, Infinity, profile);
  if (!name) return;
  const definition = TRAP_DEFINITIONS[name];
  if (!definition) throw new Error(`unknown debug trap '${name}'`);
  if (!request.debugTrap && sourceFeatureEstimatedCost(definition.cost) > CONFIG.sourceTrapCostLimit) return;
  const { position, angles } = trapSpawnTransform(name, request);
  if (name === "kart") {
    const controller = spawnKartController(runtime, position, angles, {
      mode: "normal", frozen: false, jumpLocked: false, getoffLocked: false,
    });
    Object.assign(controller, {
      kind: "trap", name, definition,
      source: `${runtime.index}:trap:${runtime.traps.size + 1}`,
      cooldowns: new Map(), createdAt: Instance.GetGameTime(),
    });
    runtime.trapCost += definition.cost;
    runtime.traps.add(controller);
    registerSourceFeatureCost(controller.body, definition.cost);
    return;
  }
  const controller = {
    kind: "trap",
    name,
    definition,
    visual: spawnTrapVisual(runtime, { ...request, position, angles }, name),
    position: clone(position),
    angles,
    source: `${runtime.index}:trap:${runtime.traps.size + 1}`,
    cooldowns: new Map(),
    spent: false,
    createdAt: Instance.GetGameTime(),
  };
  configureTrapController(runtime, controller, request);
  runtime.trapCost += definition.cost;
  runtime.traps.add(controller);
  registerSourceFeatureCost(controller.visual, definition.cost);
}

function itemPoolForTeam(team, runtime, forceGlobal = false) {
  const profile = forceGlobal ? undefined : themeProfile(runtime?.themeSnapshot);
  return team === 3 ? (profile?.humanItems ?? ITEM_POOLS.human) : (profile?.zombieItems ?? ITEM_POOLS.zombie);
}

function selectItemForTeam(team, runtime, forceGlobal = false) {
  const pool = itemPoolForTeam(team, runtime, forceGlobal);
  return pool[Math.floor(Math.random() * pool.length)];
}

function itemExists(name) {
  for (const runtime of activeRuntimes()) {
    for (const item of runtime.items ?? []) {
      if (item.name === name && item.state !== "consumed" && item.state !== "cleaned"
        && validEntity(item.carrier)) return true;
    }
  }
  return false;
}

function readItemPrototypeAngles(name) {
                                                                        
                                                                            
                                                                             
                                                                    
  const spawned = spawnRoundEntities(featureTemplate(`item_${name}`), 
    clone(THEME_PRELOAD_ORIGIN), { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  try {
    const visual = spawned.find(entity => validEntity(entity)
      && String(entity.GetClassName?.() ?? "").startsWith("prop_dynamic"));
    const angles = visual?.GetAbsAngles?.();
    if (!angles || ![angles.pitch, angles.yaw, angles.roll].every(Number.isFinite))
      throw new Error(`item '${name}' VMAP prototype has no readable angles`);
    return { pitch: angles.pitch, yaw: angles.yaw, roll: angles.roll };
  } finally {
    for (const entity of spawned) if (validEntity(entity)) entity.Kill();
  }
}

function spawnDedicatedItemVisual(runtime, request, name, feature = `item_${name}`) {
  const definition = ITEM_DEFINITIONS[name];
  const templateName = definition?.templateName ?? name;
  let spawned = spawnRoundEntities(featureTemplate(`item_${templateName}`), request.position, request.angles) ?? [];
  finalizeSpawned(runtime, { ...request, feature }, spawned);
  let visual = spawned.find((entity) => entity?.IsValid() && !entity.GetClassName?.().startsWith("trigger_"));
  if (!visual && definition?.model) {
    message(`WARNING: item '${name}' dedicated prototype returned no entity; using template_model fallback`);
    spawned = spawnRoundEntities(featureTemplate("model"), request.position, request.angles) ?? [];
    finalizeSpawned(runtime, { ...request, feature: `${feature}_fallback` }, spawned);
    visual = spawned.find((entity) => entity?.IsValid() && !entity.GetClassName?.().startsWith("trigger_"));
    visual?.SetModel?.(definition.model);
  }
  for (const entity of spawned) {
    if (entity === visual || !entity?.IsValid()) continue;
    entity.Kill();
    runtime.entities.delete(entity);
  }
  if (!visual) throw new Error(`item '${name}' prototype did not spawn`);
  return visual;
}

function setRuntimeKeyValue(entity, key, value) {
  if (!validEntity(entity)) return false;
  const text = String(value ?? "");
  if (typeof entity.__KeyValueFromString === "function") {
    try {
      const result = entity.__KeyValueFromString(key, text);
      if (result !== false) return true;
    } catch {                                             }
  }
  try {
    fireTarget(entity, "KeyValues", `${key} ${text}`);
    return true;
  } catch {
    return false;
  }
}

function configureItemMeasureMovement(measureMovement, carrier, measureReference, visual) {
  if (!validEntity(measureMovement)
    || !validEntity(carrier)
    || !validEntity(measureReference)
    || !validEntity(visual)) return false;
  const measureReferenceName = entityName(measureReference);
  const values = {
    MeasureTarget: entityName(carrier),
    MeasureReference: measureReferenceName,
    Target: entityName(visual),
    TargetReference: measureReferenceName,
    TargetScale: "1",
                                                                                                   
                                                                           
                                                            
    MeasureType: "0",
  };
  let configured = true;
  for (const [key, value] of Object.entries(values)) {
    if (!value || !setRuntimeKeyValue(measureMovement, key, value)) configured = false;
  }
  if (!configured) return false;
                                                                       
                                                                           
                                                                            
                                             
  fireTarget(measureMovement, "Disable");
  fireTarget(measureMovement, "SetMeasureTarget", values.MeasureTarget);
  fireTarget(measureMovement, "SetMeasureReference", values.MeasureReference);
  fireTarget(measureMovement, "Target", values.Target);
  fireTarget(measureMovement, "SetTargetReference", values.TargetReference);
  fireTarget(measureMovement, "SetTargetScale", values.TargetScale);
  fireTarget(measureMovement, "Enable", "", 0.01);
  return configured;
}

function spawnItemCarrier(runtime, request, definition, itemId) {
  const carrierClass = itemCarrierClass(definition);
  const kind = carrierClass === "weapon_knife" ? "knife" : "p250";
  const spawned = spawnRoundEntities(featureTemplate(`item_carrier_${kind}`), request.position, request.angles) ?? [];
  const templateEntityName = (entity) => String(
    entity?.GetEntityName?.() ?? entity?.GetName?.() ?? "",
  ).toLowerCase();
  const findTemplateEntity = (targetName, className) => {
    const expected = String(targetName).toLowerCase();
    const candidates = spawned.filter((entity) => entity?.IsValid?.()
      && (!className || entity.GetClassName?.() === className));
    return candidates.find((entity) => {
      const actual = templateEntityName(entity);
      return actual === expected || actual.startsWith(`${expected}&`);
    }) ?? (candidates.length === 1 ? candidates[0] : undefined);
  };
                                                                        
                                   
                                                                             
                                                                  
  const carrier = findTemplateEntity(`item_carrier_proto_${kind}`, carrierClass);
  const visual = findTemplateEntity(`item_carrier_visual_proto_${kind}`, "prop_dynamic");
  const measureMovement = findTemplateEntity(
    `item_carrier_measure_movement_proto_${kind}`,
    "logic_measure_movement",
  );
  const measureReference = findTemplateEntity(`item_carrier_anchor_proto_${kind}`, "info_target");
  if (!carrier || !visual || !measureMovement || !measureReference) {
    const inventory = spawned.map((entity) => entity?.IsValid?.()
      ? `${entity.GetClassName?.()}:${entity.GetEntityName?.() ?? entity.GetName?.() ?? "unnamed"}`
      : "invalid").join(", ");
    for (const entity of spawned) {
      if (entity?.IsValid?.()) entity.Kill();
      runtime.entities.delete(entity);
    }
    const error = new Error(`item carrier '${kind}' authored LMM incomplete; expected weapon, visual, logic_measure_movement and info_target anchor; rebuild the updated VMAP; spawned=[${inventory}]`);
    error.code = "ITEM_AUTHORED_LMM_INCOMPLETE";
    throw error;
  }
  for (const entity of spawned) if (entity?.IsValid?.()) runtime.entities.add(entity);
                                                                          
                                                                         
                                                                      
  const carrierMapPose = readItemMapPose(measureReference, carrier);
  const mapVisualPose = definition.mapAuthoredVisualPose ? carrierMapPose : undefined;
  if (!carrierMapPose) {
    for (const entity of spawned) if (entity?.IsValid?.()) {
      entity.Kill();
      runtime.entities.delete(entity);
    }
    throw new Error("map-authored item anchor has no readable transform");
  }
                                                                            
                                                                         
                                                                            
                                                                       
                                                                              
                                                                        
  const spawnPlacement = {
    requested: clone(request.position),
    templateOrigin: clone(carrier.GetAbsOrigin()),
  };
  const spawnDelta = sub(spawnPlacement.templateOrigin, spawnPlacement.requested);
  spawnPlacement.corrected = Math.hypot(spawnDelta.x, spawnDelta.y, spawnDelta.z) > 0.01;
  if (spawnPlacement.corrected) {
    carrier.Teleport({ position: clone(request.position), angles: request.angles, velocity: vec() });
  }
  spawnPlacement.alignedOrigin = clone(carrier.GetAbsOrigin());
  if (spawnPlacement.corrected) {
    message(`[ITEM SPAWN] ${kind} #${itemId} root offset=${JSON.stringify(spawnDelta)}; after placement=${JSON.stringify(spawnPlacement.alignedOrigin)}`);
  }
  return { carrier, visual, measureMovement, measureReference, mapVisualPose,
    mapAnchorUp: carrierMapPose.position.z, authoredMeasure: true, spawnPlacement };
}

function nextPlanetCrystalVariant(requested) {
  if (ITEM_DEFINITIONS.planetcrystal.variants.includes(requested)) return requested;
  if (state.planetCrystalShuffle.length === 0) {
    state.planetCrystalShuffle.push(...ITEM_DEFINITIONS.planetcrystal.variants);
  }
  return state.planetCrystalShuffle.splice(Math.floor(Math.random() * state.planetCrystalShuffle.length), 1)[0];
}

function knifeStripAllowed(item, pawn, now) {
  if (!pawn?.IsAlive?.() || pawn.GetTeamNumber?.() !== item.definition.team) return false;
  if (item.definition.team !== 2) return true;
                                                                             
                                                                             
  if (item.debugShowcase === true) return true;
  if ((pawn.GetHealth?.() ?? 0) < CONFIG.zombieItemMinimumHealth) return false;
  if (state.firstInfectionAt === undefined) return false;
  if (state.motherZombies.has(pawn)) return true;
  const protectionEndsAt = state.firstInfectionAt + CONFIG.zombieItemAntiInflateTime;
  if (now < protectionEndsAt) {
    showZombieItemLock(item, pawn, now, protectionEndsAt, "protection");
    return false;
  }
  item.data ??= {};
  item.data.nonMotherUnlockAt ??= now + CONFIG.zombieItemMotherPriorityTime;
  if (now < item.data.nonMotherUnlockAt) {
    showZombieItemLock(item, pawn, now, item.data.nonMotherUnlockAt, "priority");
    return false;
  }
  hideZombieItemLockForPlayer(pawn);
  return true;
}

function unlockKnifeItem(item) {
  if (item?.stripUnlocked === true) return true;
  if (!validEntity(item?.carrier)) return false;
                                                                      
                                                                             
                                                                             
                                                                 
  fireTarget(item.carrier, "ToggleCanBePickedUp");
  item.stripUnlocked = true;
  return true;
}

// Keep the native weapon locked until a script-approved player has a free
// knife slot. No trigger entity or OnStartTouch edge controls this state.
function initializeKnifeItemPickup(item) {
  if (itemCarrierClass(item.definition) !== "weapon_knife") return;
  item.stripUnlocked = false;
  fireTarget(item.carrier, "ToggleCanBePickedUp");
}

function prepareKnifeItemPickup(item, pawn, now) {
  if (!["world", "dropped"].includes(item.state) || !validEntity(item.carrier)
    || validEntity(item.carrier.GetOwner?.()) || !validEntity(pawn)
    || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== item.definition.team
    || playerItemInSlot(pawn, "knife")) return false;
  if (item.stripUnlocked !== true && !knifeStripAllowed(item, pawn, now)) return false;
  // Without inventory inspection there is no safe way to strip a plain knife.
  if (typeof pawn.FindWeaponBySlot !== "function") return false;
  const oldKnife = pawn.FindWeaponBySlot(CSGearSlot.KNIFE);
  if (oldKnife === item.carrier) return false;
  if (validEntity(oldKnife)) {
    // Native ownership can precede claimItem by one Item Tick. Protect that
    // artifact too, even while state.playerItems has not registered it yet.
    for (const runtime of activeRuntimes()) {
      for (const other of runtime.items ?? []) {
        if (other.carrier === oldKnife && !["consumed", "cleaned"].includes(other.state)) return false;
      }
    }
    try { pawn.DestroyWeapon?.(oldKnife); } catch { /* Try the entity fallback. */ }
    if (validEntity(oldKnife)) {
      try { oldKnife.Kill?.(); } catch { return false; }
    }
    // DestroyWeapon returns void. Unlock only after removal is observable;
    // otherwise the next tick retries instead of leaving a false success flag.
    if (validEntity(oldKnife)) return false;
  }
  return unlockKnifeItem(item);
}

function knifeItemTouchesPawn(item, pawn) {
  const position = item.carrier?.GetAbsOrigin?.() ?? item.position;
  const hull = playerCollisionHull(pawn);
  if (!position || !hull) return false;
  // Source CreateItem uses a +/-1 trigger around the carrier. Intersect that
  // box with the same standing/crouching player hull used by item attacks.
  return Math.abs(position.x - hull.center.x) <= hull.halfWidth + 1
    && Math.abs(position.y - hull.center.y) <= hull.halfWidth + 1
    && Math.abs(position.z - hull.center.z) <= hull.halfHeight + 1;
}

function processKnifeItemPickup(item, now, pawns, reservedPawns) {
  if (itemCarrierClass(item.definition) !== "weapon_knife"
    || !["world", "dropped"].includes(item.state)
    || !validEntity(item.carrier) || validEntity(item.carrier.GetOwner?.())) return false;
  if (now < (item.knifePickupUntil ?? 0)) return false;
  const candidates = pawns.filter(pawn => !reservedPawns.has(pawn) && knifeItemTouchesPawn(item, pawn));
  // A rejected ordinary zombie must never obstruct an eligible mother.
  candidates.sort((a, b) => Number(state.motherZombies.has(b)) - Number(state.motherZombies.has(a)));
  for (const pawn of candidates) {
    if (!prepareKnifeItemPickup(item, pawn, now)) continue;
    // Give the engine half a second to acquire this existing world weapon.
    // Do not strip every overlapping player's knife in the same tick.
    item.knifePickupPawn = pawn;
    item.knifePickupUntil = now + 0.5;
    reservedPawns.add(pawn);
    return true;
  }
  return false;
}

function spawnItemFeature(runtime, request) {
  const team = request.team ?? (request.tile === 93 ? 3 : 2);
  const enabled = team === 3 ? FEATURE_FLAGS.humanItems : FEATURE_FLAGS.zombieItems;
  if (!enabled && !request.debugItem) return;
  const spendDesire = !request.debugItem && !request.desireSpent && !request.zombieSpawn;
  if (!request.debugItem && !request.zombieSpawn) {
    if (activeItemCount() >= CONFIG.itemMaximum) return;
    const desired = team === 3 ? state.humanItemDesired : state.zombieItemDesired;
    if (spendDesire && desired <= 0) return;
  }
  if (spendDesire) {
    if (team === 3) state.humanItemDesired--;
    else state.zombieItemDesired--;
  }
  const forceGlobalPool = request.forcedByDesire === true || request.zombieSpawn === true;
  const profile = themeProfile(runtime.themeSnapshot);
  let name = request.itemName ?? selectItemForTeam(team, runtime, forceGlobalPool);
  const globalHumanPool = forceGlobalPool || profile.humanItems === null;
  if (!request.itemName && team === 3 && globalHumanPool
    && state.healOrbSpawnsRemaining > 0 && !itemExists("heal_orb")) {
    name = "heal_orb";
    state.healOrbSpawnsRemaining--;
    if (CONFIG.ensureHealOrbMessage) announce("heal-orb spawned due to not existing");
  }
  if (!name) return;                                                         
  // Source ITEMS.flight.Spawn(): no new flight once slay_enabled is set.
  if (name === "flight" && state.flightSlayEnabled) return;
  const baseDefinition = ITEM_DEFINITIONS[name];
  const definition = request.endingItem === true && request.teamOverride === team && baseDefinition
    ? Object.freeze({ ...baseDefinition, team })
    : baseDefinition;
  if (!definition || definition.team !== team) throw new Error(`invalid ${team === 3 ? "human" : "zombie"} item '${name}'`);
  const sourceCost = name === "moonboost" ? 2 : 3;
  if (!request.debugItem && !request.forcedByDesire && !request.zombieSpawn
    && sourceFeatureEstimatedCost(sourceCost) > CONFIG.sourceItemCostLimit) return;
  const behavior = ITEM_BEHAVIORS[definition.behavior];
  if (!behavior) throw new Error(`item '${name}' is quarantined: original behaviour is not implemented`);
  const itemId = state.nextItemId++;
  const visualAttachment = createItemVisualAttachment(definition);
  if (definition.mapAuthoredAttachmentAngles) {
    Object.assign(visualAttachment, readItemPrototypeAngles(name));
  }
  const carrierRequest = request.itemGroundAnchored
    ? {
      ...request,
      position: add(request.position, vec(0, 0, 40)),
                                                                         
                                                                         
      angles: { pitch: 0, yaw: 0, roll: 0 },
    }
    : request;
  let carrierBundle;
  try {
    carrierBundle = spawnItemCarrier(runtime, carrierRequest, definition, itemId);
  } catch (error) {
    if (!request.debugShowcase || error?.code !== "ITEM_AUTHORED_LMM_INCOMPLETE") throw error;
    announce(`DEBUG: skipped '${name}' gallery item: ${error.message}`);
    return;
  }
                                                                            
                                                                               
                                                                           
  const visual = carrierBundle.visual ?? spawnDedicatedItemVisual(runtime, request, name);
  if (!carrierBundle.mapVisualPose) {
    visual.SetModel?.(definition.model);
    visual.SetModelScale?.(visualAttachment.scale ?? definition.worldScale ?? 1);
  }
  const item = {
    id: itemId,
    owner: runtime.index,
    name,
    definition,
    visual,
    carrier: carrierBundle.carrier,
    state: "spawning",
    position: clone(carrierRequest.position),
    holder: undefined,
    usesRemaining: definition.uses,
    fuel: definition.fuel,
    variant: name === "planetcrystal" ? nextPlanetCrystalVariant(request.itemVariant) : undefined,
    endingItem: request.endingItem === true,
    debugShowcase: request.debugShowcase === true,
    nextUseAt: 0,
    readyNotified: false,
    spent: false,
    active: false,
                                                                              
                                                                                
    everPickedUp: false,
    droppedAt: undefined,
    tasks: new Set(),
    effects: new Set(),
    auxiliaryVisuals: new Set(),
    data: {},
    riftOrigin: undefined,
    visualAttachment,
                                                        
    visualAuthoredParent: false,
    visualAuthoredMeasure: carrierBundle.authoredMeasure === true,
    mapVisualPose: carrierBundle.mapVisualPose,
    mapAnchorUp: carrierBundle.mapAnchorUp,
    spawnPlacement: carrierBundle.spawnPlacement,
    measureReference: carrierBundle.measureReference,
    measureMovement: carrierBundle.measureMovement,
    stripUnlocked: itemCarrierClass(definition) !== "weapon_knife",
  };
  attachItemVisual(item, item.carrier);
  applyInitialItemVisualState(item);
  if (definition.idleAnimation) {
    fireTarget(visual, "SetAnimation", definition.idleAnimation);
    fireTarget(visual, "SetDefaultAnimation", definition.idleAnimation, 0.02);
  }
  runtime.items.add(item);
  registerSourceFeatureCost(item.carrier, sourceCost);
  initializeKnifeItemPickup(item);
  item.state = "world";
  behavior.onSpawn?.(runtime, item);
}

function itemCarrierClass(definition) {
  return definition.carrierKind === "knife" ? "weapon_knife" : "weapon_p250";
}

function itemCarrierSlot(definition) {
  if (typeof CSGearSlot === "undefined") return undefined;
  return itemCarrierClass(definition) === "weapon_knife"
    ? CSGearSlot.KNIFE
    : CSGearSlot.PISTOL;
}

function validEntity(entity) {
  return !!entity?.IsValid?.();
}

function itemSlotKey(definition) {
  return itemCarrierClass(definition) === "weapon_knife" ? "knife" : "pistol";
}

function playerItemSlots(pawn, create = false) {
  let slots = state.playerItems.get(pawn);
  if (!slots && create) {
    slots = new Map();
    state.playerItems.set(pawn, slots);
  }
  return slots;
}

function playerItemInSlot(pawn, slot) {
  return playerItemSlots(pawn)?.get(slot);
}

function rememberPlayerItem(pawn, item) {
  const slots = playerItemSlots(pawn, true);
  const slot = itemSlotKey(item.definition);
  if (slots.has(slot)) return false;
  slots.set(slot, item);
  return true;
}

function forgetPlayerItem(pawn, item) {
  const slots = playerItemSlots(pawn);
  if (!slots) return;
  const slot = itemSlotKey(item.definition);
  if (slots.get(slot) === item) slots.delete(slot);
  if (slots.size === 0) state.playerItems.delete(pawn);
}

function activePlayerItem(pawn) {
  const activeWeapon = pawn.GetActiveWeapon?.();
  if (!validEntity(activeWeapon)) return undefined;
  for (const item of playerItemSlots(pawn)?.values() ?? []) {
    if (item.carrier === activeWeapon) return item;
  }
  return undefined;
}

function usableHeldPlayerItem(pawn) {
                                                                         
                                                                          
                                                                           
  const owned = item => item?.state === "held" && item.holder === pawn
    && validEntity(item.carrier) && item.carrier.GetOwner?.() === pawn;
  // Source items use a func_button parented to the weapon, so E works whichever
  // weapon is drawn. Prefer the drawn item, then any held item that can be used.
  const active = activePlayerItem(pawn);
  const candidates = [active, ...(playerItemSlots(pawn)?.values() ?? [])].filter(owned);
  return candidates.find(item => ITEM_BEHAVIORS[item.definition.behavior]?.canUse?.(item, pawn))
    ?? candidates[0];
}

function createItemVisualAttachment(definition) {
  const attachment = { ...(definition.attachment ?? {}) };
  for (const axis of ["pitch", "yaw", "roll"]) {
    const range = definition.attachmentRandom?.[axis];
    if (Number.isFinite(range) && range > 0) {
      attachment[axis] = (attachment[axis] ?? 0) + Math.random() * range;
    }
  }
  return attachment;
}

                                                                           
                                                                            
const SOURCE_ITEM_BUTTON_ANCHOR = Object.freeze({ forward: 15, up: 47 });

                                                                           
                                                                                 
function itemPoseBasis(angles) {
  return [forwardFromAngles(angles), leftFromAngles(angles), upFromAngles(angles)];
}

function itemPoseRotate(basis, position) {
  return add(mul(basis[0], position.x), add(mul(basis[1], position.y), mul(basis[2], position.z)));
}

function itemPoseUnrotate(basis, position) {
  return vec(...basis.map((axis) => axis.x * position.x + axis.y * position.y + axis.z * position.z));
}

function itemPoseAngles(basis) {
  const [forward, left, up] = basis;
  const horizontal = Math.hypot(forward.x, forward.y);
  const degrees = 180 / Math.PI;
  return {
    pitch: Math.atan2(-forward.z, horizontal) * degrees,
    yaw: normalizeYaw((horizontal > 0.000001
      ? Math.atan2(forward.y, forward.x) : Math.atan2(-left.x, left.y)) * degrees),
    roll: horizontal > 0.000001 ? Math.atan2(left.z, up.z) * degrees : 0,
  };
}

function readItemMapPose(anchor, carrier) {
  const position = anchor.GetAbsOrigin?.();
  const origin = carrier.GetAbsOrigin?.();
  const angles = bodyAngles(anchor);
  const parentAngles = bodyAngles(carrier);
  if (!position || !origin || !angles || !parentAngles) return undefined;
  const parentBasis = itemPoseBasis(parentAngles);
  const local = itemPoseUnrotate(parentBasis, vec(position.x - origin.x, position.y - origin.y, position.z - origin.z));
  const localBasis = itemPoseBasis(angles).map((axis) => itemPoseUnrotate(parentBasis, axis));
  if (![local.x, local.y, local.z, ...localBasis.flatMap((axis) => [axis.x, axis.y, axis.z])].every(Number.isFinite)) return undefined;
  return { position: local, basis: localBasis };
}

function applyItemMapPose(pose, origin, angles) {
  const parentBasis = itemPoseBasis(angles);
  return {
    position: add(origin, itemPoseRotate(parentBasis, pose.position)),
    angles: itemPoseAngles(pose.basis.map((axis) => itemPoseRotate(parentBasis, axis))),
  };
}

                                                                             
                                                                                
                                                                          

function itemVisualTransform(item, carrier, parentOverride) {
  if (!validEntity(carrier)) return undefined;
  const carrierPosition = carrier.GetAbsOrigin?.() ?? item.position;
  const carrierAngles = bodyAngles(carrier) ?? { pitch: 0, yaw: 0, roll: 0 };
  const logicMeasured = item.visualAuthoredMeasure === true
    || (validEntity(item.measureMovement) && validEntity(item.measureReference));
  const parent = item.visualAuthoredParent === true
    ? carrier
    : logicMeasured
      ? carrier
    : (validEntity(parentOverride)
      ? parentOverride
      : (item.state === "held" && validEntity(item.holder) ? item.holder : carrier));
  const parentPosition = parent?.GetAbsOrigin?.() ?? carrierPosition;
  const parentAngles = bodyAngles(parent) ?? carrierAngles;
                                                                          
                                                                            
  const heldParent = !logicMeasured
    && item.visualAuthoredParent !== true
    && item.state === "held"
    && parent === item.holder;
  const anchorPosition = parentPosition;
  const angles = (heldParent ? viewAngles(parent) : undefined) ?? parentAngles;
                                                                             
  if (item.mapVisualPose) return applyItemMapPose(item.mapVisualPose, anchorPosition, angles);
                                                                           
                                                                          
                                                                            
  const attachment = item.visualAttachment ?? item.definition.attachment ?? {};
  const pitch = angles.pitch * Math.PI / 180;
  const yaw = angles.yaw * Math.PI / 180;
  const forward = vec(
    Math.cos(pitch) * Math.cos(yaw),
    Math.cos(pitch) * Math.sin(yaw),
    -Math.sin(pitch),
  );
  const left = leftFromAngles(angles);
  const up = upFromAngles(angles);
  const position = add(
    anchorPosition,
    add(
      mul(forward, SOURCE_ITEM_BUTTON_ANCHOR.forward + (attachment.forward ?? 0)),
      add(
        mul(left, attachment.left ?? 0),
        mul(up, (item.mapAnchorUp ?? SOURCE_ITEM_BUTTON_ANCHOR.up) + (attachment.up ?? 0)
          + (item.mapAnchorUp !== undefined ? (item.definition.mapVisualUpCorrection ?? 0) : 0)),
      ),
    ),
  );
  return {
    position,
    angles: {
      pitch: angles.pitch + (attachment.pitch ?? 0),
      yaw: normalizeYaw(angles.yaw + (attachment.yaw ?? 0)),
      roll: angles.roll + (attachment.roll ?? 0),
    },
  };
}

function attachItemVisual(item, carrier) {
  if (!validEntity(item.visual) || !validEntity(carrier)) return false;
  if (item.visualAuthoredMeasure) {
                                                                          
                                                                            
                                                                              
    if (!validEntity(item.measureMovement) || !validEntity(item.measureReference)) return false;
    if (item.mapVisualPose) {
                                                                              
                                                                                
      item.visualInitialized = true;
      fireTarget(item.visual, "Enable");
      return true;
    }
    item.visual.SetModelScale?.(
      item.visualAttachment?.scale ?? item.definition.worldScale ?? 1,
    );
    if (!item.visualInitialized) {
      const transform = itemVisualTransform(item, carrier, carrier);
      if (!transform) return false;
      const anchor = item.measureReference;
      if (anchor.GetParent?.() !== carrier) {
        if (typeof anchor.SetParent !== "function") return false;
        anchor.SetParent(carrier);
      }
      anchor.Teleport({ ...transform, velocity: vec() });
      item.visual.Teleport({ ...transform, velocity: vec() });
    }
    item.visualInitialized = true;
    fireTarget(item.visual, "Enable");
    return true;
  }
  const logicMeasured = validEntity(item.measureMovement) && validEntity(item.measureReference);
  if (logicMeasured) {
    if (!item.measureMovementConfigured) {
      item.measureMovementConfigured = configureItemMeasureMovement(
        item.measureMovement,
        carrier,
        item.measureReference,
        item.visual,
      );
    }
    if (!item.measureMovementConfigured) return false;
                                                                            
                                                                             
                                                             
    if (typeof item.visual.GetParent === "function" && item.visual.GetParent?.()) {
      fireTarget(item.visual, "ClearParent");
      item.visualParent = undefined;
    }
    item.visual.SetModelScale?.(
      item.visualAttachment?.scale ?? item.definition.worldScale ?? 1,
    );
    if (!item.visualInitialized) {
      const transform = itemVisualTransform(item, carrier, carrier);
      if (!transform) return false;
      item.visual.Teleport({ ...transform, velocity: vec() });
      item.visualInitialized = true;
    }
    fireTarget(item.visual, "Enable");
    return true;
  }
  const authoredParent = item.visualAuthoredParent === true;
  const parent = authoredParent
    ? carrier
    : (item.state === "held" && validEntity(item.holder) ? item.holder : carrier);
  const transform = itemVisualTransform(item, carrier, parent);
  if (!transform) return false;
  const attachment = item.visualAttachment ?? item.definition.attachment ?? {};
  const currentParent = item.visual.GetParent?.();
  if (authoredParent && typeof item.visual.GetParent === "function" && currentParent !== parent) {
                                                                          
                                                                           
                                                          
    message(`WARNING: item '${item.name}' authored visual parent was not resolved; applying one-time carrier fallback`);
    if (typeof item.visual.SetParent !== "function") return false;
    fireTarget(item.visual, "ClearParent");
    item.visual.SetParent(parent);
  }
  const alreadyParented = authoredParent || (typeof item.visual.GetParent === "function"
    ? currentParent === parent
    : item.visualParent === parent);
  if (!authoredParent && !alreadyParented) {
    if (typeof item.visual.SetParent !== "function") {
      message(`WARNING: item '${item.name}' visual does not support native parenting`);
      return false;
    }
    fireTarget(item.visual, "ClearParent");
    item.visual.SetParent(parent);
  }
  item.visual.SetModelScale?.(attachment.scale ?? item.definition.worldScale ?? 1);
                                                                             
                                                                             
                                                                
                                                                       
                                                                            
                                                                     
  const shouldPlace = authoredParent ? !item.visualInitialized : (!alreadyParented || !item.visualInitialized);
  if (shouldPlace) {
    item.visual.Teleport({ ...transform, velocity: vec() });
    item.visualInitialized = true;
  }
  item.visualParent = parent;
  fireTarget(item.visual, "Enable");
  return true;
}

                                                                            
                                                                      
                                                                            
                                                                            
                                            
function applyInitialItemVisualState(item) {
  if (!validEntity(item?.visual)) return;
  switch (item.name) {
    case "impostor":
      // Source 1's knife attachment uses rendercolor 255 0 0 and renderamt 50.
      item.visual.SetColor?.({ r: 255, g: 0, b: 0, a: 50 });
      break;
    case "minislots":
      item.visual.SetColor?.({ r: 150, g: 255, b: 200, a: 255 });
      break;
    case "moonboost":
      item.visual.Unglow?.();
      break;
    case "rift":
    case "rift_z":
      item.visual.Unglow?.();
      break;
    case "storm_blade":
      item.visual.Glow?.({ r: 0, g: 200, b: 255, a: 255 });
      break;
    case "greasy_fingers":
      item.visual.SetColor?.({ r: 0, g: 0, b: 0, a: 100 });
      item.visual.Unglow?.();
      break;
    case "planetcrystal": {
      const colors = {
        earth: { r: 200, g: 150, b: 0, a: 100 },
        fire: { r: 255, g: 0, b: 0, a: 100 },
        wind: { r: 255, g: 255, b: 255, a: 100 },
        water: { r: 0, g: 255, b: 255, a: 100 },
      };
      const color = colors[item.variant] ?? colors.wind;
      item.visual.SetColor?.(color);
      item.visual.Unglow?.();
      break;
    }
    case "billnye":
      fireTarget(item.visual, "SetBodyGroup", "0");
      fireTarget(item.visual, "Skin", "0");
      break;
    default:
      break;
  }
}

// Ending runtimes own items under a string index outside state.levels.
function itemRuntime(item) {
  const owner = item?.owner;
  const level = state.levels.get(owner);
  if (level) return level;
  const ending = state.endingRuntime;
  return ending && ending.index === owner && ending.lifecycle !== "destroyed" ? ending : undefined;
}

function destroyItemCarrier(item) {
  const carrier = item?.carrier;
  const measureReference = item?.measureReference;
  const measureMovement = item?.measureMovement;
  item.carrier = undefined;
  item.measureReference = undefined;
  item.measureMovement = undefined;
  if (validEntity(item.visual)) fireTarget(item.visual, "ClearParent");
  if (validEntity(carrier)) {
    const owner = carrier.GetOwner?.();
    if (validEntity(owner) && typeof owner.DestroyWeapon === "function") {
      owner.DestroyWeapon(carrier);
    }
    if (validEntity(carrier)) carrier.Kill();
  }
  if (validEntity(measureReference)) measureReference.Kill();
  if (validEntity(measureMovement)) measureMovement.Kill();
}

function claimItem(item, pawn, carrier) {
  if (!["world", "dropped"].includes(item.state) || !validEntity(carrier)) return false;
  if (itemCarrierClass(item.definition) === "weapon_knife" && item.stripUnlocked !== true) return false;
  const behavior = ITEM_BEHAVIORS[item.definition.behavior];
  if (!behavior?.canPickup?.(item, pawn) || !rememberPlayerItem(pawn, item)) return false;
  hideZombieItemLockForPlayer(pawn);
  const firstPickup = !item.everPickedUp;
  item.carrier = carrier;
  item.state = "held";
  item.holder = pawn;
  item.everPickedUp = true;
                                                                           
                                                                    
  const runtime = itemRuntime(item);
  for (const entity of itemOwnedEntities(item)) restoreLevelFadeColor(runtime, entity);
  item.droppedAt = undefined;
  item.position = clone(carrier.GetAbsOrigin?.() ?? pawn.GetAbsOrigin?.() ?? item.position);


  cleanupItemStripTrigger(runtime, item);
  attachItemVisual(item, carrier);
  if (firstPickup) {
    item.nextUseAt = Math.max(
      item.nextUseAt ?? 0,
      Instance.GetGameTime() + CONFIG.itemFirstPickupCooldown,
    );
    item.readyNotified = false;
  }
  behavior.onPickup?.(runtime, item, pawn);
  showItemTutorial(item, pawn);
  message(`${item.definition.team === 3 ? "human" : "zombie"} picked up ${item.name}; press E to use`);
  return true;
}

function nearbyPawns(position, radius, team, exclude) {
  return allLivingPawns().filter((pawn) => {
    if (pawn === exclude || (team !== undefined && pawn.GetTeamNumber?.() !== team)) return false;
    const pawnPosition = pawn.GetAbsOrigin?.();
    return pawnPosition && Math.hypot(
      pawnPosition.x - position.x,
      pawnPosition.y - position.y,
      pawnPosition.z - position.z,
    ) <= radius;
  });
}

function pickupItem(item, pawn) {
  const carrier = item.carrier;
  if (!validEntity(carrier) || carrier.GetOwner?.() !== pawn) return false;
  return claimItem(item, pawn, carrier);
}

function dropItem(item, position) {
  if (!item || item.state !== "held") return;
  const holder = item.holder;
  if (holder) forgetPlayerItem(holder, item);
  item.position = clone(position ?? item.position);
  item.holder = undefined;
  item.state = "dropped";
  item.droppedAt = Instance.GetGameTime();
  const runtime = itemRuntime(item);
  ITEM_BEHAVIORS[item.definition.behavior]?.onDrop?.(runtime, item, holder);
  if (item.spent || item.usesRemaining <= 0) {
    // Source has already killed the button of a used-up item, so dropping it
    // leaves only the plain weapon (removed after ITEM_CLEANUP_TIME).
    if (validEntity(item.carrier) && validEntity(holder) && item.carrier.GetOwner?.() === holder) {
      holder.DropWeapon?.(item.carrier);
    }
    consumeItem(runtime, item, true);
    return;
  }
  if (validEntity(item.carrier)) {
    const carrierOwner = item.carrier.GetOwner?.();
    if (validEntity(holder) && (typeof item.carrier.GetOwner !== "function" || carrierOwner === holder)) {
      holder.DropWeapon?.(item.carrier);
    }
    if (validEntity(item.carrier)) {
      item.carrier.Teleport?.({
        position: item.position,
        angles: item.carrier.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 },
        velocity: vec(),
      });
      attachItemVisual(item, item.carrier);
      return;
    }
  }
  if (validEntity(item.visual)) {
    item.carrier = undefined;
    if (validEntity(item.measureReference)) item.measureReference.Kill();
    item.measureReference = undefined;
    if (validEntity(item.measureMovement)) item.measureMovement.Kill();
    item.measureMovement = undefined;
    fireTarget(item.visual, "ClearParent");
    item.visual.Teleport({ position: item.position, angles: { pitch: 0, yaw: 0, roll: 0 }, velocity: vec() });
    fireTarget(item.visual, "Enable");
  }
}

function dropHeldItem(pawn, position, allSlots = true) {
  const items = allSlots
    ? [...(playerItemSlots(pawn)?.values() ?? [])]
    : [activePlayerItem(pawn)].filter(Boolean);
  for (const item of items) dropItem(item, position ?? pawn?.GetAbsOrigin?.() ?? item.position);
}

// Source CreateItem only kills the item button/model when it is used up; the
// P250/knife stays with its living owner as an ordinary weapon.
function releaseItemCarrier(item, allowUnowned = false) {
  const carrier = item?.carrier;
  const owner = carrier?.GetOwner?.();
  if (!validEntity(carrier)) return false;
  if (validEntity(owner) ? !owner.IsAlive?.() : !allowUnowned) return false;
  const measureReference = item.measureReference;
  const measureMovement = item.measureMovement;
  item.carrier = undefined;
  item.measureReference = undefined;
  item.measureMovement = undefined;
  if (validEntity(item.visual)) fireTarget(item.visual, "ClearParent");
  if (validEntity(measureMovement)) measureMovement.Kill();
  if (validEntity(measureReference)) measureReference.Kill();
  for (const runtime of [...state.levels.values(), state.endingRuntime]) runtime?.entities?.delete(carrier);
  state.sourceExtraCosts.delete(carrier);
  state.releasedItemCarriers.set(carrier, undefined);
  return true;
}

// Source TickDropKilled: a button-less item weapon left on the ground for
// ITEM_CLEANUP_TIME is removed.
function processReleasedItemCarriers(now) {
  for (const [carrier, groundSince] of [...state.releasedItemCarriers]) {
    if (!validEntity(carrier)) {
      state.releasedItemCarriers.delete(carrier);
    } else if (validEntity(carrier.GetOwner?.())) {
      if (groundSince !== undefined) state.releasedItemCarriers.set(carrier, undefined);
    } else if (groundSince === undefined) {
      state.releasedItemCarriers.set(carrier, now);
    } else if (now - groundSince >= CONFIG.releasedItemCarrierCleanupTime) {
      carrier.Kill();
      state.releasedItemCarriers.delete(carrier);
    }
  }
}

function consumeItem(runtime, item, keepUnownedCarrier = false) {
  if (item.holder) forgetPlayerItem(item.holder, item);
  item.holder = undefined;
  item.state = "consumed";
  ITEM_BEHAVIORS[item.definition.behavior]?.onCleanup?.(runtime, item);
  cleanupItemStripTrigger(runtime, item);
  if (!releaseItemCarrier(item, keepUnownedCarrier)) destroyItemCarrier(item);
  if (item.visual?.IsValid()) item.visual.Kill();
  runtime?.entities?.delete(item.visual);
  runtime?.items?.delete(item);
}

function cleanupItemStripTrigger(runtime, item) {
  item.knifePickupPawn = undefined;
  item.knifePickupUntil = undefined;
  // Retire any legacy trigger retained by an older item record.
  if (item.stripConnection !== undefined) {
    disconnectEntityOutput(item.stripConnection);
    runtime?.outputConnections?.delete(item.stripConnection);
    state.outputConnections.delete(item.stripConnection);
    item.stripConnection = undefined;
  }
  if (validEntity(item.stripTrigger)) item.stripTrigger.Kill();
  runtime?.entities?.delete(item.stripTrigger);
  item.stripTrigger = undefined;
  item.stripTriggerParented = false;
}

function damageItemTargets(targets, damage, center, force = 0) {
  for (const pawn of targets) {
    damagePawn(pawn, damage);
    if (force <= 0) continue;
    const position = pawn.GetAbsOrigin?.();
    if (position) pushPawn(pawn, directionBetween(center, position), force, Math.max(180, force * 0.4));
  }
}

function dropEnemyItems(position, radius, team) {
  for (const pawn of nearbyPawns(position, radius, team)) dropHeldItem(pawn);
}

function dropActiveWeapon(pawn) {
  const weapon = pawn?.GetActiveWeapon?.();
  if (!validEntity(weapon)) return;
  const item = activePlayerItem(pawn);
  if (item) {
    dropItem(item, pawn.GetAbsOrigin?.() ?? item.position);
    return;
  }
  pawn.DropWeapon?.(weapon);
}

function useGreasyFingers(runtime, item, holder, now) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return false;
  playSourceAudioCue(8735, origin);
  const buttonPosition = sourceItemButtonPosition(item, holder);
  spawnItemParticle(runtime, item, "explosion_child_distort01b", buttonPosition, undefined, 0.10);
  for (let yaw = 0; yaw < 360; yaw += 50) {
    spawnItemParticle(runtime, item, "extinsguish_fire_blastout_01",
      add(buttonPosition, mul(forwardFromAngles({ pitch: 0, yaw, roll: 0 }), item.definition.range - 40)),
      { pitch: 90, yaw, roll: 0 }, 0.05);
  }

                                                                            
                                                                             
                                                                              
  const targets = nearbyPawns(origin, item.definition.range, 3);
  for (const pawn of targets) dropActiveWeapon(pawn);
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "greasy_fingers",
    item,
    targets,
    nextDropAt: now + item.definition.dropInterval,
    expiresAt: now + item.definition.duration,
  });
                                                                          
                                                                              
  return true;
}

function useFling(runtime, item, holder, now) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return false;
  playSourceAudioStack([8065, 8066, 8067], origin);
  spawnItemParticle(runtime, item, "explosion_child_distort01b", sourceItemButtonPosition(item, holder), undefined, 0.10);
  for (const pawn of nearbyPawns(origin, item.definition.radius, 3)) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const delta = sub(position, origin);
    const distance = Math.hypot(delta.x, delta.y, delta.z);
    const horizontal = Math.hypot(delta.x, delta.y);
    const direction = horizontal > 0
      ? vec(delta.x / horizontal, delta.y / horizontal, 0)
      : vec();

                                                                            
                                                                            
                                                                               
    const force = Math.max(0, item.definition.radius - distance);
    const velocityZ = Math.max(item.definition.zMin, Math.min(item.definition.zMax, 0));
    pawn.Teleport?.({
      velocity: vec(direction.x * force, direction.y * force, velocityZ),
    });
    nullifyFalldownCheckpoint(pawn);
  }
  const burst = spawnItemEffectVisual(runtime, item, {
    template: "fling",
    model: "models/luffaren/heal_orb.vmdl",
    position: origin,
    angles: {
      pitch: Math.random() * 360,
      yaw: Math.random() * 360,
      roll: Math.random() * 360,
    },
    scale: item.definition.burstStartScale,
    color: { r: 255, g: 0, b: 0, a: 255 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "fling_burst",
    item,
    visual: burst,
    startsAt: now,
    expiresAt: now + item.definition.burstDuration,
  });
  return true;
}

function useRoar(runtime, item, holder, now) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return false;
  playSourceAudioCue(8638, add(origin, vec(0, 0, 50)));
  spawnItemParticles(runtime, item, ["explosion_child_distort01b", "explosion_child_distort01d_1k"],
    sourceItemButtonPosition(item, holder), undefined, 0.10);
  const direction = horizontalViewDirection(holder);
  for (const pawn of nearbyPawns(origin, item.definition.range, 2)) {
    const health = pawn.GetHealth?.();
    if (Number.isFinite(health) && health < item.definition.healthFloor) {
      pawn.SetHealth?.(item.definition.healthFloor);
    }
    if (pawn === holder) continue;
    const current = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport?.({
      velocity: vec(
        direction.x * item.definition.velocityXY,
        direction.y * item.definition.velocityXY,
        current.z >= item.definition.preserveZAt ? current.z : item.definition.velocityZ,
      ),
    });
  }
  const burst = spawnItemEffectVisual(runtime, item, {
    template: "roar",
    position: add(origin, vec(0, 0, 50)),
    angles: anglesFor(direction),
    scale: item.definition.burstStartScale,
    color: { r: 255, g: 255, b: 255, a: 255 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "roar_burst",
    item,
    visual: burst,
    position: add(origin, vec(0, 0, 50)),
    startsAt: now,
    fadeAt: now
      + item.definition.burstGrowTime
      + item.definition.burstFadeDelay,
    expiresAt: now
      + item.definition.burstGrowTime
      + item.definition.burstFadeDelay
      + item.definition.burstFadeTime,
  });
  return true;
}

function spawnLinearZombieProjectile(runtime, item, holder, now, kind) {
  const origin = holder.GetEyePosition?.()
    ?? add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 64));
  const direction = forwardVector(holder, true);
  const visualAngles = anglesFromDirection(direction);
  if (kind === "pizzabaker") visualAngles.pitch += 90;
  else if (kind === "gust") {
                                                                            
                                                                              
    visualAngles.roll = Math.random() * 360;
  }
  const visual = spawnItemEffectVisual(runtime, item, {
    template: item.name,
    model: item.definition.model,
    position: origin,
    angles: visualAngles,
    scale: item.definition.projectileScale,
    color: kind === "gust" ? { r: 255, g: 255, b: 255, a: 200 } : undefined,
  });
  const controller = {
    id: state.nextItemEffectId++,
    kind,
    item,
    visual,
    user: holder,
    position: clone(origin),
    direction,
    lastAt: now,
    touchCooldowns: new Map(),
    visuals: new Set(),
    visualAngles: new Map(),
    sounds: new Set(),
    expiresAt: now + item.definition.lifetime,
  };
  // Track the controller before spawning glows/sounds so a failed spawn
  // cannot leave an untracked visual that follows the item across levels.
  runtime.itemDeployables.add(controller);
  try {
    visual.Teleport?.({
      position: controller.position,
      angles: visualAngles,
      velocity: mul(direction, item.definition.speed),
    });
    if (kind === "pizzabaker") {
      for (let index = 0; index < item.definition.glowAmount; index++) {
        const glowAngles = {
          pitch: visualAngles.pitch + (index === 0 ? 180 : 0),
          yaw: visualAngles.yaw,
          roll: visualAngles.roll,
        };
        const glow = spawnItemEffectVisual(runtime, item, {
          template: item.name,
          model: item.definition.model,
          position: origin,
          angles: glowAngles,
          scale: item.definition.glowScale,
          color: { r: 255, g: 255, b: 255, a: 0 },
          glow: { r: 255, g: 0, b: 0, a: 255 },
        });
        controller.visuals.add(glow);
        controller.visualAngles.set(glow, glowAngles);
        glow.Teleport?.({
          position: controller.position,
          angles: glowAngles,
          velocity: mul(direction, item.definition.speed),
        });
      }
      const sounds = spawnItemSoundTemplate(
        runtime,
        item,
        "item_pizzabaker_launch_sound",
        origin,
        ["song", "spork_high", "spork_low"],
      );
      controller.sounds = new Set(sounds.values());
      parentProjectileSounds(controller, visual, origin);
      for (const sound of controller.sounds) playItemSound(sound);
    } else if (kind === "gust") {
      controller.nextEchoAt = now + item.definition.echoFirstDelay;
      const sounds = spawnItemSoundTemplate(
        runtime,
        item,
        "item_gust_sound",
        origin,
        ["gust_high", "gust_low", "spork"],
      );
      controller.sounds = new Set(sounds.values());
      parentProjectileSounds(controller, visual, origin);
      for (const sound of controller.sounds) playItemSound(sound);
    }
  } catch (error) {
    cleanupDeployable(runtime, controller);
    throw error;
  }
  scheduleDeployableKill([visual, ...controller.visuals, ...controller.sounds], item.definition.lifetime);
  return controller;
}

// Source parented its launch sounds to the func_movelinear. CS2 ambient_generic
// pins a started sound where PlaySound fired, so moving or parenting it later is
// inaudible; point_soundevent's SetSourceEntity is the input that tracks a mover.
function parentProjectileSounds(controller, visual, origin) {
  controller.parentedSounds = new Set();
  if (!validEntity(visual)) return;
  let sourceName;
  for (const sound of controller.sounds) {
    if (!validEntity(sound)) continue;
    if (sound.GetClassName?.() === "point_soundevent") {
      if (!sourceName) {
        sourceName = `item_projectile_${controller.id}_sound_source`;
        visual.SetEntityName?.(sourceName);
      }
      fireTarget(sound, "SetSourceEntity", sourceName);
      controller.parentedSounds.add(sound);
      continue;
    }
    if (typeof sound.SetParent !== "function") continue;
    sound.Teleport?.({ position: origin });
    try {
      sound.SetParent(visual);
      controller.parentedSounds.add(sound);
    } catch {}
  }
}

function usePizzaBaker(runtime, item, holder, now) {
  spawnLinearZombieProjectile(runtime, item, holder, now, "pizzabaker");
                                                                          
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 255 });
  return true;
}

function useGust(runtime, item, holder, now) {
  spawnLinearZombieProjectile(runtime, item, holder, now, "gust");
                                                                             
                                           
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 50 });
  return true;
}

function spawnPizzaImpactSounds(runtime, deployable, now) {
  const roles = [];
  for (let index = 1; index <= deployable.item.definition.soundStack; index++) {
    roles.push(`aggressive_${index}`, `splotion_${index}`);
  }
  const sounds = spawnItemSoundTemplate(
    runtime,
    deployable.item,
    "item_pizzabaker_impact_sound",
    deployable.position,
    roles,
  );
  for (const sound of sounds.values()) playItemSound(sound);
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "short_sound",
    item: deployable.item,
    sounds: new Set(sounds.values()),
    expiresAt: now + 0.2,
  });
}

function usePuller(runtime, item, holder, now) {
  const origin = holder.GetEyePosition?.()
    ?? add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 64));
                                                                         
                                                                              
  const direction = directionWithPitchOffset(holder);
  const effectAngles = anglesFromDirection(direction);
                                                                        
                                                                              
  playSourceAudioCue(9330, origin);
  playSourceAudioCue(9331, origin);
                                                                          
                                                                         
  item.visual?.SetColor?.({ r: 50, g: 0, b: 80, a: 40 });
  item.visual?.Glow?.({ r: 30, g: 0, b: 0, a: 255 });
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "puller",
    model: item.definition.effectModel,
    position: origin,
    angles: effectAngles,
    scale: 4,
    color: { r: 80, g: 20, b: 50, a: 100 },
    glow: { r: 80, g: 20, b: 50, a: 255 },
  });
                                                                           
                                                                            
                                              
  visual.Teleport?.({ position: origin, angles: effectAngles, velocity: vec() });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "puller",
    item,
    visual,
    user: holder,
    position: clone(origin),
    direction,
    touchers: new Set(),
    activeAt: now + item.definition.pullDelay,
    expiresAt: now + item.definition.pullDelay + item.definition.activeTime,
  });
  return true;
}

function setZombieItemPickupHealth(runtime, item, holder) {
  void runtime;
  item.data ??= {};
  item.data.nextIdleSoundAt = undefined;
  holder.SetHealth?.(CONFIG.zombieItemPickupHealth);
}

function onSquidPickup(runtime, item, holder) {
  setZombieItemPickupHealth(runtime, item, holder);
  item.data.nextIdleSoundAt = Instance.GetGameTime() + 0.5;
}

function tickSquidIdle(runtime, item, holder, now) {
  void runtime;
  if (item.state !== "held" || !validEntity(holder) || !holder.IsAlive?.()
    || holder.GetTeamNumber?.() !== 2) return;
  if (now < (item.data.nextIdleSoundAt ?? Infinity)) return;
  playSourceAudioCue(6633, holder.GetAbsOrigin?.() ?? item.position, {parent:item.button});
  item.data.nextIdleSoundAt = now + 0.4 + Math.random() * 29.6;
}

function onDragonSlayerDrop(runtime, item, holder) {
  item.data ??= {};
  if (item.data.dragonDeathSoundPlayed) return;
  const ownerLost = !validEntity(holder)
    || !holder.IsAlive?.()
    || holder.GetTeamNumber?.() !== item.definition.team;
  if (!ownerLost) return;
  item.data.dragonDeathSoundPlayed = true;
  playSourceAudioCue(6912, (validEntity(holder) ? holder.GetAbsOrigin?.() : undefined) ?? item.position);
  void runtime;
}

function directionWithPitchOffset(holder, pitchOffset = 0) {
  const angles = viewAngles(holder)
    ?? { pitch: 0, yaw: 0, roll: 0 };
  const pitch = (angles.pitch + pitchOffset) * Math.PI / 180;
  const yaw = angles.yaw * Math.PI / 180;
  return vec(
    Math.cos(pitch) * Math.cos(yaw),
    Math.cos(pitch) * Math.sin(yaw),
    -Math.sin(pitch),
  );
}

function horizontalViewDirection(holder) {
  const view = directionWithPitchOffset(holder);
  const length = Math.hypot(view.x, view.y);
  if (length > 0.0001) return vec(view.x / length, view.y / length, 0);
  return forwardVector(holder);
}

function randomWorldAngles() {
  return {
    pitch: Math.random() * 360,
    yaw: Math.random() * 360,
    roll: Math.random() * 360,
  };
}

function squidFlightAngles(direction) {
  const angles = anglesFromDirection(direction);
  angles.pitch += 90;
  return angles;
}

function spawnBallisticZombieProjectile(runtime, item, holder, now, kind) {
  const origin = holder.GetEyePosition?.()
    ?? add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 64));
  const direction = directionWithPitchOffset(holder, item.definition.pitchOffset);
  const initialAngles = kind === "squid"
    ? squidFlightAngles(direction)
    : kind === "bomb_chuck"
      ? anglesFromDirection(direction)
      : randomWorldAngles();
  const visual = spawnItemEffectVisual(runtime, item, {
    template: item.name,
    model: item.definition.model,
    position: origin,
    angles: initialAngles,
    scale: kind === "squid" ? 2 : kind === "stone" ? 0.8 : 0.7,
  });
  const speed = item.definition.throwSpeed ?? item.definition.launchSpeed;
  const controller = {
    id: state.nextItemEffectId++,
    kind,
    item,
    visual,
    user: holder,
    position: clone(origin),
    direction: clone(direction),
    velocity: mul(direction, speed),
    angles: initialAngles,
    gravity: item.definition.gravity,
    radius: item.definition.projectileRadius,
    bounce: item.definition.bounce,
    lastAt: now,
    descending: false,
    touched: new Set(),
    restSample: kind === "stone" ? clone(origin) : undefined,
    nextRestCheckAt: kind === "stone" ? now + item.definition.restCheckInterval : undefined,
    restCleanupAt: undefined,
    expiresAt: now + (item.definition.lifetime ?? item.definition.fuseTime),
    detonateAt: kind === "bomb_chuck" ? now + item.definition.fuseTime : undefined,
    nextTrailAt: item.definition.trailInterval ? now + item.definition.trailInterval : undefined,
  };
  if (kind === "bomb_chuck") playSourceAudioCue(8532, origin);
  if (kind === "squid") playSourceAudioCue(6779, origin);
  visual.Teleport?.({
    position: controller.position,
    angles: controller.angles,
    velocity: clone(controller.velocity),
  });
  runtime.itemDeployables.add(controller);
  return controller;
}

function useStone(runtime, item, holder, now) {
  spawnBallisticZombieProjectile(runtime, item, holder, now, "stone");
  playSourceAudioCue(9609, holder.GetAbsOrigin?.() ?? item.position);
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 150 });
  return true;
}

function useBombChuck(runtime, item, holder, now) {
  spawnBallisticZombieProjectile(runtime, item, holder, now, "bomb_chuck");
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 150 });
  return true;
}

function useSquid(runtime, item, holder, now) {
  spawnBallisticZombieProjectile(runtime, item, holder, now, "squid");
  return true;
}

function spawnPoiseIllusion(runtime, item, holder, now) {
  const playerModel = item.definition.illusionModel ?? holder.GetModelName?.();
  if (!playerModel) return;
  const origin = add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 15));
  const holderAngles = viewAngles(holder) ?? { pitch: 0, yaw: 0, roll: 0 };
  const yaw = holderAngles.yaw + (Math.random() * 40 - 20);
  const radians = yaw * Math.PI / 180;
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "poise",
    model: playerModel,
    position: origin,
    angles: { pitch: 0, yaw, roll: 0 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "poise_illusion",
    item,
    visual,
    position: clone(origin),
    velocity: vec(
      Math.cos(radians) * (200 + Math.random() * 100),
      Math.sin(radians) * (200 + Math.random() * 100),
      150 + Math.random() * 150,
    ),
    lastAt: now,
    expiresAt: now + 2.5 + Math.random() * 0.5,
  });
}

function usePoise(runtime, item, holder, now) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return false;
  playSourceAudioCue(8802, add(origin, vec(0, 0, 48)), {parent:item.button});
  item.spent = true;
  addPlayerStatus(
    runtime,
    holder,
    `${runtime.index}:item:${item.id}:poise:invincible`,
    item.definition.invincibleTime,
    { blockedAttackerTeam: 3 },
  );
  for (const pawn of nearbyPawns(origin, item.definition.fearRange, 3)) {
    addPlayerStatus(
      runtime,
      pawn,
      itemEffectSource(runtime, item, "poise_fear"),
      item.definition.fearSlowTime,
      { speedMultiplier: -item.definition.fearSlowdown },
    );
  }

  const direction = horizontalViewDirection(holder);
  const burst = spawnItemEffectVisual(runtime, item, {
    template: "poise",
    position: add(add(origin, vec(0, 0, 50)), mul(direction, -20)),
    angles: anglesFor(direction),
    scale: 1.5,
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "poise_burst",
    item,
    visual: burst,
    position: clone(burst.GetAbsOrigin?.() ?? origin),
    startsAt: now,
    expiresAt: now + 0.5,
  });
  for (let index = 0; index < item.definition.illusionAmount; index++) {
    spawnPoiseIllusion(runtime, item, holder, now);
  }
  scheduleItemTask(runtime, item, item.definition.invincibleTime, (activeRuntime) => consumeItem(activeRuntime, item));
  return { success: true, deferConsume: true };
}

function itemEffectSource(runtime, item, suffix) {
  return `${runtime.index}:item:${item.id}:${suffix}:${state.nextItemEffectId++}`;
}

function scheduleItemTask(runtime, item, delay, callback) {
  let task;
  task = schedule(delay, () => {
    item.tasks.delete(task);
    const activeRuntime = itemRuntime(item);
    if (item.state === "cleaned" || !activeRuntime) return;
    callback(activeRuntime);
  }, runtime.index);
  item.tasks.add(task);
  return task;
}

function cancelItemTasks(runtime, item) {
  for (const task of item?.tasks ?? []) task.cancelled = true;
  item?.tasks?.clear();
}

const ITEM_NATIVE_PARTICLE_EFFECTS = new Set([
  "aztec_copter_takeoff_grass", "blood_impact_headshot", "chicken_gone", "copter_takeoff_1_dust_low",
  "env_sparks_omni", "explosion_child_core04c_1k", "explosion_child_distort01b",
  "explosion_child_distort01c", "explosion_child_distort01d_1k", "explosion_coop_mission_shrapnel02e_1k",
  "explosion_hegrenade_brief", "extinsguish_fire_blastout_01", "impact_dirt", "storm_lightning_01",
  "storm_lightning_01_modglow", "water_impact_bubbles_1", "weapon_sensorgren_detonate", "weapon_sensorgren_spark_02", "weapon_taser_flash",
]);

function reserveItemParticleBurst(name, maximum, duration, countRejected = false) {
  const now = Instance.GetGameTime();
  state.itemParticleFxWindows ??= new Map();
  const active = (state.itemParticleFxWindows.get(name) ?? []).filter(batch => batch.expiresAt > now);
  const allowed = active.reduce((count, batch) => count + batch.count, 0) < maximum;
  if (allowed || countRejected) {
    const expiresAt = now + duration;
    const last = active.at(-1);
    if (last?.expiresAt === expiresAt) last.count++;
    else active.push({ expiresAt, count: 1 });
  }
  state.itemParticleFxWindows.set(name, active);
  return allowed;
}

function spawnItemParticle(runtime, item, effect, position, angles = { pitch: 0, yaw: 0, roll: 0 }, lifetime = 0.1) {
  if (!ITEM_NATIVE_PARTICLE_EFFECTS.has(effect) || !Number.isFinite(lifetime) || lifetime <= 0)
    throw new Error(`invalid item particle '${effect}'`);
  if (!runtime || ["outcome_pending", "resolved", "destroyed"].includes(runtime.lifecycle)) return;
  const key = `item_fx_${effect}`;
  let template = state.featureTemplates.get(key);
  if (!validEntity(template)) template = Instance.FindEntityByName(`template_${key}`);
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
    // A missing cosmetic template must not abort the item use halfway (and kill think()).
    state.missingItemParticleTemplates ??= new Set();
    if (!state.missingItemParticleTemplates.has(key)) {
      state.missingItemParticleTemplates.add(key);
      message(`WARNING: item particle template 'template_${key}' missing from map; skipping`);
    }
    return undefined;
  }
  state.featureTemplates.set(key, template);
  const spawned = spawnRoundEntities(template, position, angles) ?? [];
  if (spawned.length !== 1 || !validEntity(spawned[0]) || spawned[0].GetClassName?.() !== "info_particle_system") {
    destroyEntities(spawned);
    throw new Error(`item particle '${effect}' must spawn one info_particle_system`);
  }
  const particle = spawned[0];
  runtime.entities.add(particle);
  const record = { id: state.nextItemEffectId++, kind: "native_item_particle", item,
    visual: particle, expiresAt: Instance.GetGameTime() + lifetime };
  runtime.itemDeployables.add(record);
  try {
    particle.Teleport({ position: clone(position), angles, velocity: vec() });
    fireTarget(particle, "Start");
    fireTarget(particle, "Kill", undefined, lifetime);
    return record;
  } catch (error) {
    cleanupDeployable(runtime, record);
    throw error;
  }
}

function sourceItemImpactAngles() {
  return { pitch: 90 + Math.floor(Math.random() * 31) - 15,
    yaw: Math.floor(Math.random() * 361), roll: Math.floor(Math.random() * 31) - 15 };
}

// Source button.GetOrigin(): the same anchor the crystal casts already use.
function sourceItemButtonPosition(item, holder) {
  return crystalCastTransform(item, holder).position;
}

// Source model.GetOrigin()/holder.GetOrigin(): the held visual, else the button anchor.
function sourceItemModelPosition(item, holder) {
  const origin = validEntity(item.visual) ? item.visual.GetAbsOrigin?.() : undefined;
  return clone(origin ?? sourceItemButtonPosition(item, holder));
}

function spawnItemParticles(runtime, item, effects, position, angles, lifetime) {
  for (const effect of effects) spawnItemParticle(runtime, item, effect, position, angles, lifetime);
}

// Source EntFire'd ::Particle calls outlive the item; only the level owner gates them.
function scheduleItemParticle(runtime, item, delay, callback) {
  return schedule(delay, () => {
    const activeRuntime = itemRuntime(item) ?? runtime;
    if (activeRuntime?.lifecycle === "destroyed") return;
    callback(activeRuntime);
  }, runtime.index);
}

function spawnItemEffectVisual(runtime, item, {
  template = item.name,
  model = item.definition.model,
  position = item.position,
  angles = { pitch: 0, yaw: 0, roll: 0 },
  scale = 1,
  color,
  glow,
  terrainBodyGroup,
} = {}) {
  const visual = spawnDedicatedItemVisual(
    runtime,
    { position, angles, feature: `item_effect_${item.id}_${state.nextItemEffectId}` },
    template,
    `item_effect_${item.id}`,
  );
  visual.SetModel?.(model);
  visual.SetModelScale?.(scale);
  if (color) visual.SetColor?.(color);
  if (glow) visual.Glow?.(glow);
  if (terrainBodyGroup !== undefined) applyTerrainAppearance(visual, terrainBodyGroup);
  item.effects.add(visual);
  return visual;
}

function entityName(entity) {
  return entity?.GetEntityName?.() ?? entity?.GetName?.() ?? "";
}

const ITEM_SOUND_EMITTER_CLASSES = new Set(["ambient_generic", "point_soundevent"]);

function spawnItemSoundTemplate(runtime, item, templateKey, position, roles) {
  const template = state.featureTemplates.get(templateKey);
  if (!template || !template.IsValid()) {
    if (!state.missingOptionalTemplateWarnings.has(templateKey)) {
      state.missingOptionalTemplateWarnings.add(templateKey);
      announce(`WARN: optional sound template '${FEATURE_TEMPLATE_NAMES[templateKey]}' is unavailable`);
    }
    return new Map();
  }
  const spawned = spawnRoundEntities(template, 
    position,
    { pitch: 0, yaw: 0, roll: 0 },
  ) ?? [];
  const available = spawned.filter(
    (entity) => validEntity(entity) && ITEM_SOUND_EMITTER_CLASSES.has(entity.GetClassName?.()),
  );
  const sounds = new Map();
  for (const role of roles) {
    const index = available.findIndex((sound) => entityName(sound).includes(role));
    if (index < 0) {
      for (const entity of spawned) {
        if (validEntity(entity)) entity.Kill();
        runtime.entities.delete(entity);
      }
      throw new Error(`${templateKey}: missing ambient role '${role}'`);
    }
    sounds.set(role, available.splice(index, 1)[0]);
  }
  if (available.length > 0 || sounds.size !== roles.length) {
    for (const entity of spawned) {
      if (validEntity(entity)) entity.Kill();
      runtime.entities.delete(entity);
    }
    throw new Error(`${templateKey}: expected ${roles.length} named ambient emitters`);
  }
                                                                               
                          
  finalizeSpawned(runtime, {
    position,
    angles: { pitch: 0, yaw: 0, roll: 0 },
    feature: `item_effect_${item.id}_${templateKey}`,
  }, spawned);
  return sounds;
}

function playItemSound(sound) {
  if (!validEntity(sound)) return;
  fireTarget(sound, sound.GetClassName?.() === "point_soundevent" ? "StartSound" : "PlaySound", "");
}

function catalogSoundEntity(token) {
  let sound = state.soundEvents.get(token);
  if (!validEntity(sound)) {
    sound = Instance.FindEntityByName(`soundevent_sfx_${token}`);
    if (validEntity(sound)) state.soundEvents.set(token, sound);
  }
  return sound;
}

function playCatalogSound(token, position, options = {}) {
  return !!spawnSourceAudio(token, position ?? vec(), options);
}

function stopCatalogSound(token, owner) {
  let stopped = false;
  for (const record of [...sourceAudio.live]) {
    if (record.token !== token || (owner !== undefined && record.owner !== owner)) continue;
    retireSourceAudio(record); stopped = true;
  }
  return stopped;
}

                                                                            
