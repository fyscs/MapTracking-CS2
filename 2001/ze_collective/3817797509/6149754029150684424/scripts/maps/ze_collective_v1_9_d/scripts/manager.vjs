function freezeThemeTerrainCatalog(catalog) {
  for (const shapes of Object.values(catalog)) {
    for (const models of Object.values(shapes)) Object.freeze(models);
    Object.freeze(shapes);
  }
  return Object.freeze(catalog);
}

                             
                                                                
                                                                             
                                                  
