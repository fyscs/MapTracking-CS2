const ACTIVE_CAPABILITIES = new Set(Object.entries(FEATURE_FLAGS).filter(([, enabled]) => enabled).map(([name]) => name));
const LEVEL_CAPABILITY_OVERRIDES = Object.freeze({});

function requiredCapabilitiesForLevel(level) {
  const required = new Set(LEVEL_CAPABILITY_OVERRIDES[level.id] ?? level.requiredCapabilities);
  required.delete("items");
  if (level.tiles.includes(93)) required.add("humanItems");
  if (level.tiles.includes(94)) required.add("zombieItems");
  return [...required];
}

