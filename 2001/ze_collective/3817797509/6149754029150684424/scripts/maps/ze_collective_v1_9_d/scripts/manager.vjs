const ITEM_TEMPLATE_KEYS = new Set(
  Object.keys(FEATURE_TEMPLATE_NAMES).filter((key) => key.startsWith("item_")),
);
const OPTIONAL_ITEM_SOUND_TEMPLATE_KEYS = new Set([
  "item_storm_blade_sound",
  "item_gust_sound",
  "item_pizzabaker_launch_sound",
  "item_pizzabaker_impact_sound",
  "item_flight_sound",
]);
const HUMAN_ITEM_TEMPLATE_KEYS = new Set([
  "item_dragonslayer", "item_baguette", "item_minislots", "item_billnye",
  "item_peanutbutter", "item_claymore", "item_piggyback", "item_hackerman",
  "item_bhop_steroids", "item_planetcrystal", "item_rift", "item_storm_blade", "item_storm_blade_refract",
  "item_storm_blade_sound",
  "item_heal_orb", "item_moonboost", "item_carrier_p250", "item_carrier_knife",
]);
const TRAP_TEMPLATE_KEYS = new Set(
  Object.keys(FEATURE_TEMPLATE_NAMES).filter((key) => key.startsWith("trap_")),
);

function featureTemplateIsRequired(key) {
                                                                           
                                                                    
  if (["bossPieceTouch", "bossEyeTouch", "bossEyeDamage", "bossGrenadeDamage", "finaleCheckoutDamage", "finaleMover", "finaleZombieMover", "finaleCheckoutText", "finaleThunder", "finaleRain", "finaleRainGround"].includes(key)) return false;
                                                                         
                                                                           
                                                           
  if (key === "lowgrav" || key === "lowgravFloor" || key === "airslide") return false;
                                                                             
  if (key === "breakable" || key === "breakableFx") return false;
                                                                        
                                                                            
                                                                            
                                                                               
  if (String(key).startsWith("race_")) return false;
  if (ITEM_TEMPLATE_KEYS.has(key)) {
                                                                              
                                                                              
                                                         
    if (OPTIONAL_ITEM_SOUND_TEMPLATE_KEYS.has(key)) return false;
    if (key === "item_carrier_knife") {
      return FEATURE_FLAGS.humanItems || FEATURE_FLAGS.zombieItems
        || P7_TEST_HUMAN_ITEMS || P8_TEST_ZOMBIE_ITEMS;
    }
    if (key.startsWith("item_") && ZOMBIE_ITEM_RELEASE_TEMPLATE_SET.has(key.slice(5))) {
      const sharedWithHumans = HUMAN_ITEM_TEMPLATE_KEYS.has(key);
      return FEATURE_FLAGS.zombieItems || P8_TEST_ZOMBIE_ITEMS
        || (sharedWithHumans && (FEATURE_FLAGS.humanItems || P7_TEST_HUMAN_ITEMS));
    }
    if (HUMAN_ITEM_TEMPLATE_KEYS.has(key)) {
      return FEATURE_FLAGS.humanItems || P7_TEST_HUMAN_ITEMS;
    }
    return FEATURE_FLAGS.zombieItems;
  }
  if (TRAP_TEMPLATE_KEYS.has(key)) return FEATURE_FLAGS.traps;
  return true;
}

