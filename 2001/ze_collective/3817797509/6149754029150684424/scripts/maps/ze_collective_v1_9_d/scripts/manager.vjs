// Based on the original CreateItem descriptions in script/manager.nut.
// Values that can change in CS2 come from the current item's definition/state.
const ITEM_TUTORIALS = Object.freeze({
  squid: { name: "Squid", describe: d =>
    `Throw a squid towards your look-direction; it can bounce on walls.\nFloor impact blinds and slows nearby humans.\nInked humans cannot use items for ${d.inkTime}s.` },
  dragonslayer: { name: "DragonSlayer", describe: () =>
    "Use while falling to downslash; otherwise swing sideways.\nUsing it strains your body and costs health; unusable at 5 HP or lower.\nBlood buildup makes it heavier to wield.\nWaterCrystal washes off blood; FireCrystal temporarily strengthens it." },
  pizzabaker: { name: "PizzaBaker", describe: () =>
    "Launch a pizza towards your look-direction.\nIt instantly kills humans on touch and goes through walls." },
  baguette: { name: "Baguette", describe: () =>
    "Hold zombies back with wide swings that hurt and push them.\nEach swing increases the chance that the baguette breaks.\nWaterCrystal reduces the break chance.\nCan hurt and stun the boss." },
  minislots: { name: "MiniSlots", describe: () =>
    "A portable slot machine to gamble on the go.\nWin chance: 5% | Win: gain 42 HP | Lose: lose 7 HP." },
  billnye: { name: "BillNye", describe: () =>
    "Place a TV showing a Bill Nye VHS.\nNearby zombies have their attention drawn to the TV.\nCan stun the boss." },
  peanutbutter: { name: "PeanutButter", describe: () =>
    "Smear a patch of peanut butter that heavily slows zombies on touch.\nThe same patch cannot slow the same zombie twice.\nCan hurt and stun the boss." },
  claymore: { name: "Claymore", describe: () =>
    "Plant a claymore in front of you.\nIt explodes when zombies pass in front, hurting, burning and stopping them.\nFireCrystal can increase its damage.\nCan hurt and stun the boss." },
  fling: { name: "Fling", describe: () =>
    "Fling nearby humans away from you.\nPush them off edges or fling away their defenses.\nYou only have one shot." },
  piggyback: { name: "Piggyback", describe: () =>
    "Let a human teammate ride on your back.\nThe rider presses E on the saddle to get on or off.\nDismounting gives the rider a jump boost.\nDying or dropping the knife forces the rider off." },
  hackerman: { name: "Hackerman", describe: () =>
    "Gain aim assistance and infinite ammo; keep firing.\nNearby or targeted zombies become one-hit kills.\nCan hurt and stun the boss." },
  bomb_chuck: { name: "BombChuck", describe: d =>
    `Throw a bomb towards your look-direction.\nIt explodes after ${d.fuseTime}s, dealing area damage.` },
  roar: { name: "Roar", describe: d =>
    `Push nearby zombies towards your horizontal look-direction.\nSurprise the human defenses.\nHeals you and nearby zombies to at least ${d.healthFloor} HP.` },
  greasy_fingers: { name: "GreasyFingers", describe: d =>
    `Make nearby humans drop their held weapons for ${d.duration}s.\nYou only get one chance; use it wisely.` },
  poise: { name: "Poise", describe: d =>
    `Gain ${d.invincibleTime}s of invincibility against human items and bullets.\nNearby humans are briefly slowed by fear.\nForward-moving illusion copies also spawn.\nTime it wisely; you only have one shot.` },
  flight: { name: "Flight", describe: () =>
    "Activate wings to fly until you die.\nFly by looking around and using WASD; momentum builds slowly.\nYour health cap depends on the number of living humans.\nInfected humans teleport back.\nYou teleport back if too close to the stage exit." },
  gust: { name: "Gust", describe: () =>
    "Launch a gust towards your look-direction.\nIt pushes humans away and goes through walls." },
  puller: { name: "Puller", describe: d =>
    `Create a long, thin beam towards your look-direction.\nAfter ${d.pullDelay}s it pulls humans towards you.\nDeals ${d.damage} damage on pull.` },
  bhop_steroids: { name: "BhopSteroids", describe: () =>
    "Automatic bunnyhopping with limited fuel.\nPress E to toggle it on or off.\nEach activation immediately consumes 2 fuel.\nYou can clear a four-tile gap from the edge." },
  stone: { name: "Stone", describe: d =>
    `Throw a stone towards your look-direction.\nDeals ${d.damage} damage to humans on hit and stops their velocity.` },
  impostor: { name: "Impostor", describe: d =>
    `Teleport to a random human with ${d.invincibleTime}s of invincibility.\nTake human form for ${d.hiddenTime}s; you cannot infect while disguised.\nHumans can still damage you after invincibility ends.\nOnce your form reverts you can infect; victims teleport back.\nYour health remains dynamically capped.` },
  planetcrystal: { name: "PlanetCrystal", describe: () =>
    "Release the crystal's elemental power in front of you.\nCan hurt and stun the boss." },
  rift: { name: "Rift", describe: () =>
    "Create a shortcut for defenders to retreat safely.\n1st use: place the entry portal (big).\n2nd use: place the destination portal (small).\nThe destination cannot be placed over a gap.\nZombie contact clears the portal." },
  rift_z: { name: "RiftZ", describe: () =>
    "Create a shortcut to help your zombie teammates get ahead.\n1st use: place the destination portal (small), on solid ground.\n2nd use: place the entry portal (big).\nThe entry locks when too close to the main teleport." },
  storm_blade: { name: "StormBlade", describe: () =>
    "Freeze and weaken nearby zombies with a dimension-breaking slice.\nThe initial freeze affects zombies nearby at activation.\nAfter the cut, nearby zombies lose health and are slowed.\nCan hurt and stun the boss." },
  destructo_hammer: { name: "DestructoHammer", describe: d =>
    `Break map tiles immediately in front of you; aim carefully.\nDestroys nearby human items and deals area damage to humans.\nHit tiles turn red and fall after ${d.tileFallTime}s.\nZombies passing through the broken area are heavily slowed.\nUnusable during the early finale.` },
  heal_orb: { name: "HealOrb", describe: d =>
    `Create a healing orb that stays with its item weapon for ${d.healDuration}s.\nNearby humans gain ${d.healAmount} HP every ${d.healRate}s, up to ${d.healCap} HP.\nProvides infinite ammo and one extra grenade.` },
  moonboost: { name: "MoonBoost", describe: () =>
    "Give yourself an upward boost.\nCombine it with jumping for extra height." },
});

function itemTutorialContent(item) {
  const d = item.definition;
  const tutorial = ITEM_TUTORIALS[item.name];
  let title = tutorial?.name ?? item.name;
  let description = tutorial?.describe(d) ?? "Use this item to activate its ability.";
  if (item.name === "planetcrystal") {
    const elements = {
      earth: ["EarthCrystal", "Spawn a wall just in front of you.\nHuman contact can break it to prevent blocking teammates.\nIt also breaks near the main teleport.\nCan hurt and stun the boss."],
      fire: ["FireCrystal", `Damage zombies and set them on fire for ${d.fireIgniteTime}s.\nThe fire shoots out in front and briefly slows zombies.\nStrengthens DragonSlayer and nearby claymores.\nCan hurt and stun the boss.`],
      wind: ["WindCrystal", `Push zombies back with a gust in front of you.\nThe gust stays active for ${d.windLifetime}s.\nCancels nearby zombie gust projectiles.\nCan hurt and stun the boss.`],
      water: ["WaterCrystal", "Stop and heavily slow zombies in front of you.\nWashes blood from DragonSlayer and reduces Baguette break chance.\nCan hurt and stun the boss."],
    };
    if (elements[item.variant]) [title, description] = elements[item.variant];
  }
  // The original CLIMB ending replaces Flight's normal stage-exit instructions.
  if (item.name === "flight" && itemRuntime(item)?.kind === "CLIMB") {
    description = "You are an angel.\nActivate your wings, then fly by looking around and using WASD.\nMomentum builds slowly.\nKill the humans climbing the tower.";
  }
  let usage;
  if (d.useMode === "passiveAttachment") usage = "1 seat";
  else if (d.useMode === "fuelToggle") usage = `${Math.max(0, Math.floor(item.fuel * 10) / 10)} fuel left`;
  else if (d.useMode === "twoStage") usage = `${item.usesRemaining} portal steps left`;
  else usage = Number.isFinite(item.usesRemaining) ? `${item.usesRemaining} uses left` : "Unlimited uses";
  if (["finiteCharges", "cooldownUnlimited", "conditionalUnlimited"].includes(d.useMode)) {
    usage = `${d.cooldown}s cooldown | ${usage}`;
  }
  return { title, usage, description, control: d.useMode === "passiveAttachment"
    ? "Teammates: press E on the saddle to ride"
    : "Carry the item and press E to use" };
}

const ITEM_POOLS = Object.freeze({
  human: HUMAN_ITEM_SELECTION_POOL,
                                                                    
  zombie: Object.freeze(ZOMBIE_ITEM_RELEASE_NAMES.filter((name) => ITEM_DEFINITIONS[name]?.team === 2)),
});

function itemNoop() {}

function humanItemCanPickup(item, pawn) {
  return pawn.GetTeamNumber?.() === item.definition.team;
}

function humanItemCanUse(item, holder) {
  return holder?.IsAlive?.()
    && holder.GetTeamNumber?.() === 3
    && !item.spent
    && !playerHasItemStatus(holder, ":squid");
}

function humanItemBehavior(hooks = {}) {
  return Object.freeze({
    onSpawn: hooks.onSpawn ?? itemNoop,
    canPickup: hooks.canPickup ?? humanItemCanPickup,
    onPickup: hooks.onPickup ?? itemNoop,
    onDrop: hooks.onDrop ?? itemNoop,
    canUse: hooks.canUse ?? humanItemCanUse,
    onUse: hooks.onUse ?? (() => false),
    onUseFailed: hooks.onUseFailed ?? itemNoop,
    onReady: hooks.onReady ?? itemNoop,
    onCleanup: hooks.onCleanup ?? itemNoop,
    onTick: hooks.onTick ?? itemNoop,
  });
}

function zombieItemCanPickup(item, pawn) {
  return pawn.GetTeamNumber?.() === item.definition.team;
}

function zombieItemCanUse(item, holder) {
  return holder?.IsAlive?.()
    && holder.GetTeamNumber?.() === 2
    && !item.spent;
}

function zombieItemBehavior(hooks = {}) {
  return Object.freeze({
    onSpawn: hooks.onSpawn ?? itemNoop,
    canPickup: hooks.canPickup ?? zombieItemCanPickup,
    onPickup: hooks.onPickup ?? itemNoop,
    onDrop: hooks.onDrop ?? itemNoop,
    canUse: hooks.canUse ?? zombieItemCanUse,
    onUse: hooks.onUse ?? (() => false),
    onUseFailed: hooks.onUseFailed ?? itemNoop,
    onReady: hooks.onReady ?? itemNoop,
    onCleanup: hooks.onCleanup ?? itemNoop,
    onTick: hooks.onTick ?? itemNoop,
  });
}

                                                                               
                                                                        
const ITEM_BEHAVIORS = Object.freeze({
  squid: zombieItemBehavior({
    onPickup: onSquidPickup,
    onUse: useSquid,
    onTick: tickSquidIdle,
  }),
  pizzabaker: zombieItemBehavior({ onUse: usePizzaBaker, onReady: restoreItemReady }),
  fling: zombieItemBehavior({ onUse: useFling }),
  bomb_chuck: zombieItemBehavior({
    onPickup: setZombieItemPickupHealth,
    onUse: useBombChuck,
    onReady: restoreItemColor,
  }),
  puller: zombieItemBehavior({ onUse: usePuller, onReady: restorePullerReady }),
  gust: zombieItemBehavior({ onUse: useGust, onReady: restoreItemReady }),
  roar: zombieItemBehavior({ onUse: useRoar, onReady: restoreItemColor }),
  greasy_fingers: zombieItemBehavior({ onUse: useGreasyFingers, onCleanup: cancelItemTasks }),
  poise: zombieItemBehavior({ onUse: usePoise, onCleanup: cancelItemTasks }),
  stone: zombieItemBehavior({
    onPickup: setZombieItemPickupHealth,
    onUse: useStone,
    onReady: restoreItemColor,
  }),
  rift_z: zombieItemBehavior({ onUse: useZombieRift, onCleanup: cancelItemTasks }),
  flight: zombieItemBehavior({
    onUse: useFlight,
    onDrop: stopFlight,
    onCleanup: stopFlight,
    onTick: tickFlight,
  }),
  impostor: zombieItemBehavior({ onPickup: setZombieItemPickupHealth, onUse: useImpostor }),
  destructo_hammer: zombieItemBehavior({
    onPickup: setZombieItemPickupHealth,
    onUse: useDestructoHammer,
    onReady: restoreDestructoHammerReady,
    onCleanup: cancelItemTasks,
  }),
  heal_orb: humanItemBehavior({ onUse: useHealOrb }),
  piggyback: humanItemBehavior({
    onSpawn: spawnPiggybackSaddle,
    canUse: () => false,
    onDrop: dismountPiggyback,
    onCleanup: cleanupPiggyback,
    onTick: tickPiggyback,
  }),
  moonboost: humanItemBehavior({ onUse: useMoonBoost, onUseFailed: flashItemFailed, onReady: restoreItemReady }),
  minislots: humanItemBehavior({
    onPickup: onMiniSlotsPickup,
    onUse: useMiniSlots,
    onDrop: cancelItemTasks,
    onCleanup: cancelItemTasks,
  }),
  bhop_steroids: humanItemBehavior({
    canUse: canUseBhopSteroids,
    onUse: useBhopSteroids,
    onDrop: stopBhopSteroids,
    onCleanup: stopBhopSteroids,
    onTick: tickBhopSteroids,
  }),
  baguette: humanItemBehavior({
    onUse: useBaguette,
    onDrop: cancelItemTasks,
    onCleanup: cancelItemTasks,
  }),
  peanutbutter: humanItemBehavior({ onUse: usePeanutButter, onReady: restoreItemColor }),
  claymore: humanItemBehavior({ onUse: useClaymore, onReady: restoreItemColor }),
  billnye: humanItemBehavior({ onUse: useBillNye }),
  dragonslayer: humanItemBehavior({
    onUse: useDragonSlayer,
    onDrop: (runtime, item, holder) => {
      onDragonSlayerDrop(runtime, item, holder);
      cancelItemTasks(runtime, item);
    },
    onTick: tickDragonSlayer,
    onCleanup: cancelItemTasks,
  }),
  hackerman: humanItemBehavior({ onUse: useHackerman }),
  rift: humanItemBehavior({ onSpawn: spawnRiftSecondVisual, onUse: useHumanRift, onCleanup: cleanupRiftItem }),
  storm_blade: humanItemBehavior({ onUse: useStormBlade, onUseFailed: flashItemFailed, onReady: restoreItemReady }),
  planetcrystal: humanItemBehavior({ onUse: usePlanetCrystal }),
});


