function debugLevelDefinition(id) {
  if (id === DEBUG_DATA.spiderLevel.id) return DEBUG_DATA.spiderLevel;
  if (id === DEBUG_DATA.teleportLevel.id) return DEBUG_DATA.teleportLevel;
  if (id === DEBUG_DATA.liquidFallLevel.id) return DEBUG_DATA.liquidFallLevel;
  if (id === DEBUG_DATA.kartsLevel.id) return DEBUG_DATA.kartsLevel;
  return ALL_LEVELS.find((candidate) => candidate.id === id);
}

function enqueueDebugKarts(runtime, markers, elevations) {
  for (const placement of DEBUG_DATA.kartsLevel.debugKartPlacements) {
    const position = gridWorld(runtime.entry, runtime.incoming, markers.entryCenter,
      placement.x, placement.y, elevations.entry, elevations.entry);
    enqueueFeature(runtime, "trap", position, anglesFor(runtime.incoming), {
      tile: 88, trapName: "kart", debugTrap: true, postSpawn: true,
    });
  }
}

function debugKartsCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase() || "on";
  const selected = state.debugStageId === DEBUG_DATA.kartsLevel.id;
  if (command === "status") {
    const runtime = state.currentLevel?.debugKarts ? state.currentLevel
      : state.pendingLevel?.debugKarts ? state.pendingLevel : undefined;
    const karts = [...(runtime?.traps ?? [])].filter(kart => kart.name === "kart" && !kart.spent && validEntity(kart.body));
    message(`[KART DEBUG] selected=${selected} floorReady=${runtime?.lifecycle === "active"}`
      + ` karts=${karts.length}/100 riders=${karts.filter(kart => validEntity(kart.rider)).length}`);
    return selected;
  }
  if (["off", "stop", "clear"].includes(command)) {
    if (!selected) { message("debug kart lab is already OFF"); return false; }
    return debugStageCommand("off");
  }
  if (!["on", "restart", "reset", "toggle"].includes(command)) {
    message("usage: ze_debug_karts [on|off|restart|status]");
    return false;
  }
  if (command === "toggle" && selected) return debugStageCommand("off");
  if (command === "on" && selected) {
    message("debug kart lab already selected; use status or restart");
    return true;
  }
  if (!validEntity(state.featureTemplates.get("race_kart"))) {
    message("debug kart lab requires template_race_kart; current selection unchanged");
    return false;
  }
  state.debugStageId = DEBUG_DATA.kartsLevel.id;
  state.debugStageMirror = false;
  state.debugShowcaseMode = false;
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  announce("debug kart lab enabled: flat floor + 100 driveable karts; rebuilding generated area");
  beginRound();
  return true;
}

function debugSquidBlindCommand(args) {
  const command = String(args ?? "status").trim().toLowerCase() || "status";
  if (command === "on") {
    const pawn = allLivingPawns().find((player) => player.GetTeamNumber?.() === 3);
    const runtime = activeRuntimes().find((level) => state.levels.has(level.index));
    if (!state.running || state.fatal || !pawn || !runtime) {
      message("Squid HUD debug requires a running round, an alive human and a generated level");
      return;
    }
    // Visual-only test: no slow status and no :squid item-lock suffix.
    addPlayerStatus(runtime, pawn, `${runtime.index}:debug:squid_blind`, ITEM_DEFINITIONS.squid.inkTime, { squidBlind: true });
    syncSquidBlindHud(Instance.GetGameTime(), true);
    message(`Squid HUD debug: 10s overlay for player slot ${playerSlotForHud(pawn)}`);
  } else if (command === "off") {
    for (const [pawn, statuses] of state.playerStatuses) {
      for (const source of statuses.keys()) {
        if (source.endsWith(":debug:squid_blind")) statuses.delete(source);
      }
      if (!statuses.size) state.playerStatuses.delete(pawn);
    }
    syncSquidBlindHud(Instance.GetGameTime(), true);
    message("Squid HUD debug cleared (real Squid hits are unchanged)");
  } else if (command === "status") {
    const now = Instance.GetGameTime();
    message(`Squid HUD: entity=${!!findSquidBlindHud()} affected=${squidBlindPlayers(now).size} shown=${squidBlindHudPlayers.size}`);
  } else message("usage: ze_debug_squid_blind on|off|status");
}

function debugStageInfoCommand(args) {
  const command = String(args ?? "status").trim().toLowerCase() || "status";
  const hud = findTerrainPreviewHud();
  if (command === "status") {
    message(`stage info HUD: entity=${!!hud} strings=${typeof hud?.SetDialogVariableString === "function"}`
      + ` tiles=${terrainPreviewHudTileClasses.length} map=${terrainPreviewHudMetadata?.id ?? "none"}`
      + " binding=xml-prefix-v2");
    return;
  }
  if (!["on", "off"].includes(command)) {
    message("usage: ze_debug_stage_info on|off|status");
    return;
  }
  if (!hud) { message("stage info HUD: collective_stage_preview entity unavailable"); return; }
  try {
    if (command === "off") {
      hud.SetHasClass("stage_header", "MetadataDisabled", true);
      message("stage info HUD debug hidden; pixel grid unchanged");
      return;
    }
    if (!terrainPreviewRuntimeReady(terrainPreviewRuntime)) {
      hideTerrainPreviewHud("debug-no-stage");
      message("stage info HUD: no completed terrain to display");
      return;
    }
    const metadata = terrainPreviewHudMetadata;
    const shown = showTerrainPreviewHudStatic("debug-on");
    message(`stage info HUD debug: sent=${shown} map=${metadata.id ?? "unknown"} author=${metadata.author ?? "unknown"}`);
  } catch (error) { message(`stage info HUD debug failed: ${error}`); }
}

function debugSkyboxCommand(args) {
  const key = String(args?.value ?? args ?? "").trim().toLowerCase();
  if (key === "status") {
    message("skybox requested: " + collectiveSkyboxSelection + " (visual confirmation required)");
    return true;
  }
  if (key === "off" || key === "reset") {
    resetCollectiveSkybox();
    message("skybox restored to generic");
    return true;
  }
  if (setCollectiveSkybox(key)) {
    message("skybox switch requested: " + key);
    return true;
  }
  return false;
}

function debugSkyModelsCommand(args) {
  const key = String(args?.value ?? args ?? "").trim().toLowerCase();
  if (key === "status") {
    message("model sky: " + (themeModelSky.active?.theme ?? "none") + ", clouds=" +
      (themeModelSky.active?.clouds.length ?? 0) + ", entities=" + (themeModelSky.active?.entities.size ?? 0) +
      ", retiring=" + themeModelSky.retiring.length);
    return true;
  }
  if (key === "off") {
    clearThemeModelSky(); themeModelSky.override = "off";
    return true;
  }
  if (key === "auto") {
    themeModelSky.override = undefined; themeModelSky.failedTheme = undefined;
    return ensureThemeModelSky(campaignStageSnapshot().theme);
  }
  if (!Object.hasOwn(THEME_MODEL_SKY_PROFILES, key)) {
    message("usage: ze_debug_sky_models [generic|castle|factory|temple|nature|hell|frost|silenthill|off|auto|status]");
    return false;
  }
  themeModelSky.failedTheme = undefined;
  if (!ensureThemeModelSky(key, state.currentLevel?.end?.z ?? 0, true)) return false;
  themeModelSky.override = key;
  return true;
}

function debugGalleryPosition(runtime, column, row, side) {
  const forward = mul(runtime.incoming, (2 + column * 1.25) * CONFIG.gridSize);
  const lateral = mul(leftOf(runtime.incoming), side * (10.5 + row * 1.35) * CONFIG.gridSize);
  return add(runtime.entry, add(forward, lateral));
}

function enqueueDebugShowcaseGalleries(runtime) {
  const angles = anglesFor(runtime.incoming);
  const humanItems = HUMAN_ITEM_RELEASE_NAMES.filter((name) => name !== "heal_orb" && name !== "planetcrystal")
    .map(name => ({ name }));
  humanItems.push(...["earth", "fire", "wind", "water"].map(variant => ({ name: "planetcrystal", variant })));
  for (let index = 0; index < humanItems.length; index++) {
    const position = debugGalleryPosition(runtime, index % 7, Math.floor(index / 7), 1);
    enqueueSpawn(runtime, "platform", position, angles);
    enqueueFeature(runtime, "item", add(position, vec(0, 0, 48)), angles, {
      tile: 93,
      team: 3,
      itemName: humanItems[index].name,
      itemVariant: humanItems[index].variant,
      debugItem: true,
      debugShowcase: true,
    });
  }

  // Keep zombie artifacts separate from the human gallery and the trap rows.
  // Their native knife carriers still use the script-controlled pickup checks.
  for (let index = 0; index < ZOMBIE_ITEM_RELEASE_NAMES.length; index++) {
    const position = debugGalleryPosition(runtime, index % 7, 2 + Math.floor(index / 7), -1);
    enqueueSpawn(runtime, "platform", position, angles);
    enqueueFeature(runtime, "item", add(position, vec(0, 0, 48)), angles, {
      tile: 94,
      team: 2,
      itemName: ZOMBIE_ITEM_RELEASE_NAMES[index],
      debugItem: true,
      debugShowcase: true,
    });
  }

  const trapNames = Object.keys(TRAP_DEFINITIONS);
  for (let index = 0; index < trapNames.length; index++) {
    const position = debugGalleryPosition(runtime, index % 8, Math.floor(index / 8), -1);
    enqueueSpawn(runtime, "platform", position, angles);
    enqueueFeature(runtime, "trap", add(position, vec(0, 0, 12)), angles, {
      tile: 89,
      trapName: trapNames[index],
      debugTrap: true,
      debugShowcase: true,
    });
  }

  const moverSpeeds = [CONFIG.movePlatformSlowSpeed, CONFIG.movePlatformSpeed, CONFIG.movePlatformFastSpeed];
  for (let size = 0; size < 3; size++) {
    const position = debugGalleryPosition(runtime, 8.5, size, 1);
    const destination = add(position, mul(runtime.incoming, CONFIG.gridSize * 2));
    const moverPath = [
      { positions: [position], sizes: [size] },
      { positions: [destination], sizes: [] },
    ];
    enqueueFeature(runtime, "movePlatform", position, angles, {
      moverPath,
      pathIndex: 0,
      speed: moverSpeeds[size],
      size,
      debugShowcase: true,
    });
  }
}

function enqueueDebugAllModelsGallery(runtime, markers, elevations) {
  const themes = Object.keys(THEME_PROFILES);
  if (themes.length !== 8 || THEME_RUNTIME_TERRAIN_SHAPES.length > 45) {
    throw new Error("debug model gallery no longer fits its 20x20 layout");
  }
  for (let themeIndex = 0; themeIndex < themes.length; themeIndex++) {
    const themeName = themes[themeIndex];
    for (let shapeIndex = 0; shapeIndex < THEME_RUNTIME_TERRAIN_SHAPES.length; shapeIndex++) {
      const themeShape = THEME_RUNTIME_TERRAIN_SHAPES[shapeIndex];
      const x = 1 + (themeIndex % 2) * 9 + shapeIndex % 9;
      const y = Math.floor(themeIndex / 2) * 5 + Math.floor(shapeIndex / 9);
      const position = add(
        gridWorld(runtime.entry, runtime.incoming, markers.entryCenter, x, y, elevations.entry, elevations.entry),
        vec(0, 0, 96),
      );
      state.spawnQueue.push({
        levelIndex: runtime.index,
        kind: "debugModel",
        feature: "debug_model",
        position,
        angles: anglesFor(runtime.incoming),
        themeName,
        themeShape,
        model: terrainModelsFor(themeName, themeShape)[0],
      });
      runtime.remaining++;
    }
  }
}

function enqueueDebugLiquidFallGallery(runtime, markers, elevations) {
  for (const [themeIndex, themeName] of Object.keys(THEME_PROFILES).entries()) {
    for (const [column, mode] of DEBUG_DATA.liquidFallColumns.entries()) {
      const tile = mode === "hazard" ? 77 : 67;
      // Use the normal pixel planner and liquid feature spawn path. Raising
      // the top-origin waterfall leaves its curtain visible above the floor.
      const liquid = liquidTileData(tile, runtime.incoming, false, themeName);
      const floor = gridWorld(runtime.entry, runtime.incoming, markers.entryCenter,
        3 + column * 4, 2 + themeIndex * 2, elevations.entry, elevations.entry);
      enqueueFeature(runtime, "liquid", add(floor, vec(0, 0, liquid.depth)),
        anglesFor(runtime.incoming), { tile, ...liquid, debugLiquidFallMode: mode });
    }
  }
}

function debugElevatorsCommand() {
  const records = activeRuntimes().flatMap(runtime => [...runtime.movers ?? []]
    .filter(mover => mover.kind === "nativeElevator").map(mover => ({ runtime, mover })));
  message(`[ELEVATOR DEBUG] native elevators=${records.length}; showing first ${Math.min(records.length, 16)}`);
  for (const { runtime, mover } of records.slice(0, 16)) {
    const origin = validEntity(mover.collider) ? mover.collider.GetAbsOrigin() : undefined;
    const driverOrigin = validEntity(mover.driver) ? mover.driver.GetAbsOrigin() : undefined;
    message(`[ELEVATOR DEBUG] level=${runtime.index} id=${runtime.id}`
      + ` driver=${validEntity(mover.driver)} collision=${validEntity(mover.collider)} visual=${validEntity(mover.visual)}`
      + ` parentOK=${validEntity(mover.collider) && mover.collider.GetParent() === mover.driver}`
      + ` speed=${mover.speed.toFixed(2)} start=${formatVector(mover.start)} end=${formatVector(mover.destination)}`
      + ` driverOrigin=${driverOrigin ? formatVector(driverOrigin) : "missing"}`
      + ` collisionOrigin=${origin ? formatVector(origin) : "missing"}`);
  }
  return records.length > 0;
}

function debugNativeMoversCommand() {
  const records = activeRuntimes().flatMap(runtime => [...runtime.movers ?? []]
    .filter(mover => ["nativeElevator", "nativeMovePlatform", "nativeHazardPlane"].includes(mover.kind))
    .map(mover => ({ runtime, mover })));
  message(`[MOVER DEBUG] native movers=${records.length}; showing first ${Math.min(records.length, 16)}`);
  for (const { runtime, mover } of records.slice(0, 16)) {
    const origin = validEntity(mover.collider) ? mover.collider.GetAbsOrigin() : undefined;
    message(`[MOVER DEBUG] level=${runtime.index} id=${runtime.id} kind=${mover.kind}`
      + ` driver=${validEntity(mover.driver)} master=${validEntity(mover.collider)} visual=${validEntity(mover.visual)}`
      + ` parentOK=${validEntity(mover.driver) && mover.collider.GetParent() === mover.driver}`
      + ` speed=${mover.speed} stop=${mover.pathIndex ?? "-"}`
      + ` origin=${origin ? formatVector(origin) : "missing"}`
      + ` target=${mover.destination ? formatVector(mover.destination) : "stationary"}`);
  }
  return records.length > 0;
}

function debugAudioCommand(args) {
  const [token = "status", mode = "spatial", radiusText] = String(args ?? "").trim().toLowerCase().split(/\s+/);
  if (token === "status") { message(`AUDIO active=${sourceAudio.live.size} warnings=${sourceAudio.warnings.size}`); return; }
  if (token === "stop") { clearSourceAudio(); return; }
  const pawn = allLivingPawns()[0];
  if (!pawn) { message("ze_debug_audio needs a living player"); return; }
  const position = pawn.GetAbsOrigin?.() ?? vec();
  if (mode === "private") playCatalogSound(token, position, {recipient:pawn});
  else if (mode === "global") playCatalogSound(token, position, {radius:0});
  else if (mode === "stack") for(let i=0;i<3;i++)playCatalogSound(token,position,{pitch:90+i*10,radius:Number(radiusText??10000)});
  else playCatalogSound(token,position,{radius:Number(radiusText??10000)});
}

function genericEventDebugIssue(name, runtime, { manualProbe = false } = {}) {
  const definition = GENERIC_EVENT_DEFINITIONS[name];
  if (definition?.disabled) return definition.pending;
  if (!(definition?.supported || (manualProbe && definition?.manualProbe)))
    return definition?.pending ?? "unknown event; use ze_debug_event list";
  const resourceIssue = genericEventResourceIssue(name);
  if (resourceIssue) return resourceIssue;
  if (!runtime || runtime.lifecycle !== "active" || runtime.raceLevel || runtime.kind === "FINALE")
    return "requires an active ordinary generated level (not RACE/Finale)";
  if ([...state.genericEvents.active.values()].some(event => event.name === name
    && !event.ended && Instance.GetGameTime() < (event.repeatAfter ?? Infinity)))
    return "already active; use ze_debug_event off to stop it first";
  if (!genericEventBudgetAllows(definition.cost)) return "entity budget exceeded";
  if (["BIGNADES", "BLOODLUST", "KAMIKAZE"].includes(name) && !state.motherZombies.size)
    return "requires mother-zombie infection first";
  if (name === "BLOODLUST" && !genericEventPlayers(2).length) return "requires a living zombie";
  if (name === "KAMIKAZE") {
    if (!state.spawnPlatformKilled) return "requires the spawn platform to be removed first";
    if (!finaleKamikazeCandidates().length) return "requires a living moving zombie not already piloting";
  }
  if (name === "DOORHUG_BOMB" && Number(runtime.index) <= 1) return "requires level 2 or later";
  if (name === "COLLAPSE" && !genericCollapseSource(runtime)) return "requires a retained previous terrain level";
  if (name === "THICK_FOG" && !validEntity(Instance.FindEntityByName("fog"))) return "missing fog entity";
  if (name === "SILENCE" && !genericSilenceEmitter())
    return `missing ambient_generic '${GENERIC_SILENCE_CONFIG.entity}'; load the updated compiled map`;
  return undefined;
}

function debugEventCommand(args) {
  const raw = String(args?.value ?? args ?? "").trim();
  const tokens = raw.split(/\s+/).filter(Boolean);
  const command = tokens[0]?.toUpperCase() ?? "";
  if (command === "HELP") {
    message("ze_debug_event: on [NAME|random], NAME, random, list, status, off, toggle, auto [on|off]");
    return true;
  }
  if (command === "ON") {
    const requested = tokens[1]?.toUpperCase();
    if (tokens.length > 2 || (requested && requested !== "RANDOM" && !GENERIC_EVENT_DEFINITIONS[requested])) {
      message("usage: ze_debug_event on [NAME|random]; use list for names");
      return false;
    }
    if (GENERIC_EVENT_DEFINITIONS[requested]?.disabled) {
      message(`${requested}: ${GENERIC_EVENT_DEFINITIONS[requested].pending}`);
      return false;
    }
    setGenericEventManualMode(true);
    message("event manual debug ON; automatic rolls paused; use ze_debug_event NAME or random (existing events keep running)");
    return requested ? debugEventCommand(requested) : true;
  }
  if (command === "TOGGLE") return debugEventCommand(state.genericEvents.manualEnabled ? "off" : "on");
  if (command === "LIST" || command === "CATALOG") {
    for (const name of GENERIC_EVENT_NAMES) {
      const definition = GENERIC_EVENT_DEFINITIONS[name];
      const resourceIssue = definition.supported ? genericEventResourceIssue(name) : undefined;
      message(`${name}: ${definition.manualProbe ? "manual global ringing substitute only; excluded from auto/random; not voice mute"
        : !definition.supported ? definition.pending : resourceIssue
        ? `not ready: ${resourceIssue}` : "available (game acceptance pending)"}`);
    }
    return true;
  }
  if (command === "STATUS" || command === "") {
    const active = [...state.genericEvents.active.values()];
    message(`event manual=${state.genericEvents.manualEnabled ? "ON" : "OFF"} auto=${state.genericEvents.autoEnabled ? "ON" : "OFF"}`);
    message(active.length > 0
      ? `debug events active: ${active.map((event) => `${event.name}#${event.id}`).join(", ")}`
      : "debug events are idle");
    return true;
  }
  if (["OFF", "STOP", "CLEAR", "0"].includes(command)) {
    for (const event of [...state.genericEvents.active.values()]) endGenericEvent(event);
    setGenericEventManualMode(false);
    message(`debug events stopped; automatic rolls ${state.genericEvents.autoEnabled ? "ON" : "OFF"}`);
    return true;
  }
  if (command === "AUTO") {
    const value = tokens[1]?.toLowerCase();
    if (tokens.length > 2 || (value && !["on", "off"].includes(value))) {
      message("usage: ze_debug_event auto [on|off]"); return false;
    }
    if (value) {
      if (state.genericEvents.manualEnabled) state.genericEvents.manualAutoBefore = value === "on";
      else state.genericEvents.autoEnabled = value === "on";
    }
    if (state.genericEvents.manualEnabled) {
      message(`event auto is OFF during manual debug; after off it will be ${state.genericEvents.manualAutoBefore ? "ON" : "OFF"}`);
      return true;
    }
    message(`event auto is ${state.genericEvents.autoEnabled ? "ON" : "OFF"}`);
    return true;
  }
  const runtime = state.currentLevel;
  let selected = command;
  if (command === "RANDOM") {
    const ready = GENERIC_EVENT_NAMES.filter(name => !genericEventDebugIssue(name, runtime));
    if (!ready.length) {
      message("debug event random: no ready event on this level; use list and status");
      return false;
    }
    selected = ready[Math.floor(Math.random() * ready.length)];
  }
  const manualProbe = command !== "RANDOM" && GENERIC_EVENT_DEFINITIONS[selected]?.manualProbe === true;
  const issue = genericEventDebugIssue(selected, runtime, { manualProbe });
  if (issue) { message(`debug event ${selected}: ${issue}`); return false; }
  // Explicit requests bypass only the random chance and map-count cooldown.
  // Native resources, prerequisites, duplicate and entity-budget guards stay.
  const started = tryStartGenericEvent(selected, runtime, { manualProbe });
  message(started ? `debug event ${selected} started on level=${runtime.index}` : `debug event ${selected} could not start; check preceding EVENT log`);
  return started;
}

function debugRaceDirection() {
  const raw = state.currentLevel?.outgoing ?? state.currentDirection ?? vec(1, 0, 0);
  if (Math.abs(raw.x ?? 0) >= Math.abs(raw.y ?? 0)) return vec((raw.x ?? 1) < 0 ? -1 : 1, 0, 0);
  return vec(0, (raw.y ?? 1) < 0 ? -1 : 1, 0);
}

function debugRaceSource(direction, position) {
  return {
    index: `debug_race_source:${Math.floor(Instance.GetGameTime() * 1000)}`,
    id: "#debug_race_source",
    name: "Debug RACE Source",
    lifecycle: "debug_source",
    lifecycleHistory: ["debug_source"],
    endProvider: "debug",
    end: clone(position),
    tp: clone(position),
    incoming: clone(direction),
    outgoing: clone(direction),
    entities: new Set(),
    terrainEntities: new Set(),
    safeTerrainEntities: new Set(),
    outputConnections: new Set(),
    items: new Set(),
    itemDeployables: new Set(),
    liquids: new Set(),
    movers: new Set(),
    traps: new Set(),
  };
}

function debugFinaleSource(direction, position, mode = "boss") {
  return {
    index: `debug_finale_source:${Math.floor(Instance.GetGameTime() * 1000)}`,
    id: "#debug_finale_source",
    name: "Debug Finale Source",
    lifecycle: "debug_source",
    lifecycleHistory: ["debug_source"],
    endProvider: "debug",
    end: clone(position),
    entry: clone(position),
    tp: clone(position),
    center: clone(position),
    incoming: clone(direction),
    outgoing: clone(direction),
    finaleMode: mode === "pyramid" ? "pyramid" : "boss",
    entities: new Set(),
    terrainEntities: new Set(),
    safeTerrainEntities: new Set(),
    outputConnections: new Set(),
    items: new Set(),
    itemDeployables: new Set(),
    liquids: new Set(),
    liquidPawns: new Set(),
    movers: new Set(),
    traps: new Set(),
  };
}

function validateDebugFinaleEntities(mode = "boss") {
  const missing = missingFinaleFeatureTemplates(mode);
  for (const shape of Object.keys(TEMPLATE_NAMES)) {
    if (!state.templates.has(shape)) missing.push(TEMPLATE_NAMES[shape]);
  }
  if (!state.teleportDestination?.IsValid?.()) missing.push("teledest");
  if (missing.length === 0) return true;
  message(`debug FINALE cannot start; missing required entities: ${missing.join(", ")}`);
  return false;
}

function prepareDebugDirectBoss(runtime) {
  if (!runtime || runtime.kind !== "FINALE" || runtime.bossMode !== "boss") return false;
  // startFinaleEnding normally queues the bridge and tower first.  A direct
  // Boss debug run keeps only the authored arena and discards those unspawned
  // requests before the queue is exposed to the normal incremental spawner.
  runtime.spawnQueue.length = 0;
  runtime.remaining = 0;
  runtime.finaleBridgePieces.clear();
  runtime.finaleTowerPieces.clear();
  runtime.finaleArenaPieces.clear();
  const structure = runtime.finaleStructure;
  structure.bridge = [];
  structure.bridgeTpQueue = [];
  structure.tower = [];
  structure.lowgravRequests = [];
  structure.lowgravVisualRequests = [];
  structure.lowgravSteps = [];
  structure.elevatorPieces = [];
  structure.arena = [];
  structure.zPlatform = [];
  structure.bridgeHeight = 0;
  structure.arenaBuildRequested = false;
  structure.arenaSpawned = false;
  structure.bossReady = false;
  structure.elevatorLeaving = true;
  structure.towerCleanupStarted = false;
  structure.towerCleanupOrder = [];
  runtime.debugDirectBoss = true;
  queueFinaleBossArena(runtime);
  return true;
}

function debugThunderCommand(args) {
  const parts = String(args ?? "status").trim().toLowerCase().split(/\s+/);
  const action = parts[0] || "status";
  if (action === "status") {
    const debug = state.debugThunder;
    message(`[THUNDER DEBUG] enabled=${debug?.enabled === true} flashes=${debug?.count ?? 0}`
      + ` active=${debug?.runtime.entities.size ?? 0} distance=${debug?.distance ?? 12000}`
      + ` template=${state.featureTemplates.has("finaleThunder")}`);
    return true;
  }
  if (action === "off" || (action === "toggle" && state.debugThunder?.enabled)) {
    stopDebugThunder(); message("[THUNDER DEBUG] off"); return true;
  }
  if (!["on", "once", "toggle"].includes(action) || parts.length > 2) {
    message("usage: ze_debug_thunder on|once [distance 512..12000] / off / toggle / status"); return false;
  }
  const distance = parts[1] === undefined ? 12000 : Number(parts[1]);
  if (!Number.isFinite(distance) || distance < 512 || distance > 12000) {
    message("[THUNDER DEBUG] distance must be 512..12000"); return false;
  }
  if (!state.featureTemplates.has("finaleThunder")) {
    message("[THUNDER DEBUG] template_finale_thunder missing; rebuild the map"); return false;
  }
  if (!allLivingPawns().length) {
    message("[THUNDER DEBUG] requires a living player"); return false;
  }
  stopDebugThunder();
  state.debugThunder = { enabled: true, once: action === "once", distance, count: 0,
    nextAt: Instance.GetGameTime(), expires: new Map(),
    runtime: { sequence: "debug", entities: new Set() } };
  processDebugThunder();
  message(`[THUNDER DEBUG] ${action} distance=${distance}; follows the first living player's facing direction`);
  return !!state.debugThunder;
}

function debugFinaleCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase();
  const tokens = command.split(/\s+/).filter(Boolean);
  if (tokens[0] === "attack") {
    const runtime = state.endingRuntime;
    const boss = runtime?.kind === "FINALE" ? [...(runtime.bosses ?? [])].find((candidate) => !candidate.dead) : undefined;
    const attack = tokens[1] ?? "";
    if (!boss || runtime.lifecycle !== "active" || !["boss_intro", "boss_active"].includes(runtime.bossPhase)) {
      message("debug FINALE attack requires an active Boss");
      return false;
    }
    const now = Instance.GetGameTime();
    if (attack === "spin") finaleBossStartSpin(boss, now);
    else if (attack === "tailsnap") {
      finaleBossSetTailAim(boss, true, now - FINALE_BOSS_CONFIG.tailAimAttackCooldown);
      if (!finaleBossStartTailSnap(runtime, boss, now)) return false;
    } else if (attack === "tailshoot") {
      finaleBossSetTailAim(boss, true, now - FINALE_BOSS_CONFIG.tailAimAttackCooldown);
      if (!finaleBossStartTailShoot(runtime, boss, now)) return false;
    } else if (attack === "fling") finaleBossBeginFling(runtime, boss, now);
    else if (attack === "sight") finaleBossSightAttack(runtime, boss, now);
    else if (attack === "stun") damageFinaleBoss(runtime, boss, 1, undefined, { critical: true });
    else {
      message("usage: ze_debug_finale attack [sight|spin|tailsnap|tailshoot|fling|stun]");
      return false;
    }
    message(`debug FINALE attack=${attack} dispatched`);
    return true;
  }
  if (command === "status") {
    const runtime = state.endingRuntime;
    if (runtime?.kind === "FINALE" && runtime.lifecycle !== "destroyed") {
      message(`debug FINALE is ${runtime.lifecycle}; mode=${runtime.bossMode ?? "unknown"} `
        + `phase=${runtime.bossPhase ?? runtime.finaleStructurePhase ?? "setup"}`);
      for (const boss of runtime.bosses ?? []) {
        const p = boss.position ?? vec();
        message(`[FINALE BOSS] id=${boss.id} pos=${Math.round(p.x)},${Math.round(p.y)},${Math.round(p.z)} `
          + `moves=${boss.movementCount ?? 0} progress=${(boss.interpolationProgress ?? 0).toFixed(3)} `
          + `midspin=${boss.midspin === true} fling=${boss.flingUntil > Instance.GetGameTime()}`);
        message(`[FINALE HITBOX] id=${boss.id} hp=${boss.health}/${boss.maxHealth}`
          + ` eye=${validEntity(boss.damageHitbox)} grenade=${validEntity(boss.grenadeHitbox)}`
          + ` touch=${validEntity(boss.hitbox)} grenadeHits=${boss.grenadeHitCount ?? 0}`
          + ` template=${boss.damageHitboxTemplate ?? "none"}`);
      }
      message(`[FINALE TAILSHOOT] native bullets=${runtime.bossBullets?.size ?? 0}`);
      message(`[FINALE NATIVE] lifts=${runtime.finaleNativeLifts?.size ?? 0}`
        + ` towerArrived=${runtime.finaleStructure?.elevatorArrivalAt ?? "waiting"}`
        + ` infinite=${runtime.infinite === true}`);
      message(`[FINALE WEATHER] thunderTicks=${runtime.finaleThunder?.tickCount ?? 0}`
        + ` rainEntity=${validEntity(runtime.finaleRainParticle)} source=de_train`
        + ` ground=${runtime.finaleRainGround?.size ?? 0}/${FINALE_RAIN_CONFIG.maxGroundEmitters}`
        + ` rainStarted=${runtime.finaleRainStartedAt ?? "waiting"}`);
      const sky = runtime.finaleSky;
      message(`[FINALE SKY] clouds=${sky?.clouds.filter(cloud => validEntity(cloud.visual)).length ?? 0}/7`
        + ` rotating=${sky?.rotating === true} scale=${FINALE_SKY_CONFIG.modelScale}`
        + ` z=${finaleSkyCenter(runtime).z + FINALE_SKY_CONFIG.cloudOffsetZ}`);
      if (runtime.escape) message(`[FINALE ESCAPE] maps=${runtime.escape.levelCount}/${runtime.escape.levelTarget}`
        + ` history=${runtime.escape.history.length} vellerJobs=${runtime.escape.vellerPlayers.size}`);
      for (const bullet of [...runtime.bossBullets ?? []].slice(0, 4)) {
        message(`[FINALE TAILSHOOT] driver=${validEntity(bullet.leg?.driver)}`
          + ` trigger=${validEntity(bullet.trigger)} speed=${bullet.speed}`
          + ` remaining=${Math.max(0, bullet.expiresAt - Instance.GetGameTime()).toFixed(2)}s`);
      }
      if (runtime.kamikaze) {
        message(`[FINALE KAMIKAZE] active hitbox=${validEntity(runtime.kamikaze.damageHitbox)} `
          + `template=${runtime.kamikaze.damageHitboxTemplate ?? "none"} `
          + `health=${runtime.kamikaze.damageHitbox?.GetHealth?.() ?? "unknown"}`);
      } else if (runtime.kamikazeHitboxNote) {
        message(`[FINALE KAMIKAZE] ${runtime.kamikazeHitboxNote}`);
      }
      return true;
    }
    message("debug FINALE is inactive");
    return false;
  }
  const directBoss = ["direct", "boss_direct", "bossdirect"].includes(command);
  const infinite = command === "infinite";
  if (command && !["restart", "start", "boss", "pyramid", "direct", "boss_direct", "bossdirect", "infinite"].includes(command)) {
    message("usage: ze_debug_finale [start|restart|status|pyramid|boss_direct|infinite] or attack [sight|spin|tailsnap|tailshoot|fling|stun]");
    return false;
  }
  const mode = command === "pyramid" ? "pyramid" : "boss";
  const activeFinale = state.endingRuntime?.kind === "FINALE"
    && ["spawning", "active"].includes(state.endingRuntime.lifecycle);
  if (activeFinale && command !== "restart" && command !== "pyramid" && !directBoss && !infinite) {
    message("debug FINALE is already active; use ze_debug_finale restart to rebuild it");
    return true;
  }

  if (!state.teleportDestination?.IsValid?.() || state.templates.size === 0) cacheEntities();
  if (state.fatal) {
    message("debug FINALE cannot start while the manager is in a fatal state; restart the round first");
    return false;
  }
  if (!validateDebugFinaleEntities(mode)) return false;

  const direction = debugRaceDirection();
  const sourcePosition = vec(0, 0, 0);
  destroyEndingRuntime(state.endingRuntime, "debug_finale_restart");
  for (const index of [...state.levels.keys()]) destroyLevel(index);
  state.levels.clear();
  state.spawnQueue.length = 0;
  state.scheduledTasks.length = 0;
  state.currentLevel = undefined;
  state.transitionLevel = undefined;
  state.pendingLevel = undefined;
  state.endLockedUntil = Number.POSITIVE_INFINITY;

  const stageIndex = FINALE_STAGE_INDEX + (infinite ? 1 : 0);
  const stageSnapshot = createStageSnapshot(stageIndex, "generic", "FINALE");
  const source = debugFinaleSource(direction, sourcePosition, mode);
  state.campaign.stageIndex = stageIndex;
  state.campaign.currentStageSnapshot = stageSnapshot;
  state.campaign.phase = "ending_handoff";
  state.campaign.endingStarted = true;
  state.campaign.endingResolved = false;
  state.campaign.endingOutcomePending = false;
  state.campaign.endingContractCalls++;
  state.campaign.lastEnding = {
    stage: stageSnapshot.stage,
    theme: stageSnapshot.theme,
    ending: "FINALE",
    levelIndex: source.index,
    debug: true,
    mode,
  };
  stopThemeMusic("debug_finale_handoff", 10);
  state.themeMusic.enabled = false;
  state.running = true;
  moveTeleportDestination(sourcePosition, direction);

  try {
    const runtime = startFinaleEnding(stageSnapshot, source);
    if (directBoss && !prepareDebugDirectBoss(runtime)) {
      throw new Error("direct Boss preparation failed");
    }
    // Standalone debug paths skip the tower elevator that normally arms rain.
    if (directBoss || mode === "pyramid") startFinaleThunder(runtime);
    runtime.debugForced = true;
    runtime.debugCommand = command || "start";
    runtime.debugUsesFormalTimeline = true;
    runtime.debugMode = mode;
    announce(mode === "pyramid"
      ? "DEBUG: entering Finale pyramid tail"
      : directBoss
        ? "DEBUG: entering direct Finale Boss arena"
        : "DEBUG: entering full Finale Boss ending");
    return true;
  } catch (error) {
    failRuntime(`debug FINALE startup failed: ${error}`);
    return false;
  }
}

function validateDebugRaceEntities() {
  const missing = [];
  for (const shape of Object.keys(TEMPLATE_NAMES)) {
    if (!state.templates.has(shape)) missing.push(TEMPLATE_NAMES[shape]);
  }
  for (const key of [
    "race_surface_flat",
    "race_surface_slope_yaw0",
    "race_surface_slope_yaw90",
    "race_surface_slope_yaw180",
    "race_surface_slope_yaw270",
    "race_kart",
  ]) {
    if (!state.featureTemplates.has(key)) missing.push(FEATURE_TEMPLATE_NAMES[key]);
  }
  if (!state.teleportDestination?.IsValid?.()) missing.push("teledest");
  if (missing.length === 0) return true;
  message(`debug RACE cannot start; missing required entities: ${missing.join(", ")}`);
  return false;
}


function debugNextEndingCommand(args) {
  const tokens = String(args?.value ?? args ?? "status").trim().toUpperCase().split(/\s+/).filter(Boolean);
  const name = tokens[0] ?? "STATUS";
  if (tokens.length > 1) {
    message("usage: ze_debug_next_ending <NAME|list|status|off>");
    return false;
  }
  if (name === "LIST") {
    message(`ze_debug_next_ending ${[...ENDING_NAMES, "FINALE"].join("|")}; status checks the one-shot request; off cancels it`);
    return true;
  }
  if (name === "STATUS") {
    const selected = state.transitionLevel?.debugEndingSnapshot?.ending;
    message(state.debugNextEnding ? `[NEXT ENDING DEBUG] armed=${state.debugNextEnding}; waiting for the next endpoint`
      : selected && !state.campaign.endingStarted ? `[NEXT ENDING DEBUG] handoff=${selected}; request already consumed`
      : `[NEXT ENDING DEBUG] no pending request; active=${state.endingRuntime?.kind ?? "none"}`);
    return true;
  }
  if (name === "OFF") {
    state.debugNextEnding = undefined;
    message("[NEXT ENDING DEBUG] pending request cleared; an endpoint handoff already in progress is unchanged");
    return true;
  }
  if (!Object.hasOwn(ENDING_STARTERS, name)) {
    message("usage: ze_debug_next_ending <NAME|list|status|off>; use list for ending names");
    return false;
  }
  if (!state.running || state.fatal || state.endingRuntime || state.campaign.endingStarted || state.finaleEscapeActive) {
    message("[NEXT ENDING DEBUG] requires a running round before an ending starts");
    return false;
  }
  const source = state.currentLevel ?? state.pendingLevel;
  if (!source || source.completed || state.debugAllModelsMode
    || source.debugTeleport || source.debugLiquidFall || source.debugKarts) {
    message("[NEXT ENDING DEBUG] wait for a playable level with a normal endpoint");
    return false;
  }
  state.debugNextEnding = name;
  clearTerrainPreload();
  message(`[NEXT ENDING DEBUG] armed=${name}; the next endpoint starts this ending once`);
  return true;
}

function debugEndingCommand(args) {
  const tokens = String(args?.value ?? args ?? "list").trim().toUpperCase().split(/\s+/).filter(Boolean);
  const name = tokens[0] ?? "LIST";
  if (name === "LIST") {
    message("ze_debug_ending BUNKER|BRIDGE|HUNT|RISE|CLIMB|CONFLICT|ASCEND|RACE|FINALE; status reports the active ending");
    return true;
  }
  if (name === "STATUS") {
    const runtime = state.endingRuntime;
    message(runtime ? `[ENDING DEBUG] ${runtime.kind} lifecycle=${runtime.lifecycle} music=${[...(runtime.musicTokens ?? [])].join(",") || "none"}`
      : "[ENDING DEBUG] no active ending");
    return true;
  }
  if (tokens.length !== 1 || (!ENDING_NAMES.includes(name) && name !== "FINALE")) {
    message("usage: ze_debug_ending <NAME|list|status>");
    return false;
  }
  if (name === "RACE") return debugRaceCommand("start");
  if (name === "FINALE") return debugFinaleCommand("start");
  if (state.fatal || !state.running) {
    message("[ENDING DEBUG] manager is not running; restart the round first");
    return false;
  }
  if (state.endingRuntime || state.campaign.endingStarted) {
    message("[ENDING DEBUG] an ending already started; use mp_restartgame 1 before testing another ordinary ending");
    return false;
  }
  const source = state.currentLevel;
  if (!source || source.lifecycle !== "active" || source.remaining > 0 || state.pendingLevel || state.themePreload) {
    message("[ENDING DEBUG] wait for the current terrain/theme to finish generating before starting an ending");
    return false;
  }
  // Keep real source terrain: ASCEND and several ending ownership/cleanup
  // paths depend on it. Do not manufacture an empty debug platform runtime.
  const previous = stageSnapshotForRuntime(source);
  const stage = Object.freeze({ ...previous, ending: name, infiniteMode: false });
  state.campaign.currentStageSnapshot = stage;
  state.campaign.phase = "ending_handoff";
  state.campaign.endingResolved = false;
  state.campaign.endingOutcomePending = false;
  state.endLockedUntil = Number.POSITIVE_INFINITY;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber() === 3) pawn.Teleport({ position: add(source.end, vec(0, 0, 8)), velocity: vec() });
  }
  callEndingStartContract(stage, source);
  const runtime = state.endingRuntime;
  if (state.fatal || !runtime || runtime.kind !== name) return false;
  runtime.debugForced = true;
  runtime.debugUsesFormalTimeline = true;
  schedule(CONFIG.interactionRetirementDelay, () => {
    if (state.endingRuntime === runtime && source.lifecycle !== "destroyed") retireInteractions(source);
  }, source.index);
  announce(`DEBUG: entering formal ${name}; restart the round before selecting another ordinary ending`);
  return true;
}

function debugRaceCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase();
  if (command === "status") {
    const runtime = state.endingRuntime;
    if (runtime?.kind === "RACE" && runtime.lifecycle !== "destroyed") {
      message(`debug RACE is ${runtime.lifecycle}; maps=${runtime.raceLevels?.length ?? 0}`);
      for (const record of (runtime.raceLevels ?? []).slice(-5)) {
        message(`[RACE] status slot=${record.raceSlot} id=${record.id} name="${record.name}" `
          + `lifecycle=${record.lifecycle} queued=${record.remaining} gaps=${record.raceCoverageGaps?.length ?? 0}`);
      }
    } else {
      message("debug RACE is inactive");
    }
    return runtime?.kind === "RACE";
  }
  if (command && command !== "restart" && command !== "start") {
    message("usage: ze_debug_race [start|restart|status]");
    return false;
  }
  const activeRace = state.endingRuntime?.kind === "RACE"
    && ["spawning", "active"].includes(state.endingRuntime.lifecycle);
  if (activeRace && command !== "restart") {
    message("debug RACE is already active; use ze_debug_race restart to rebuild it");
    return true;
  }

  if (!state.teleportDestination?.IsValid?.() || state.templates.size === 0) cacheEntities();
  if (state.fatal) {
    message("debug RACE cannot start while the manager is in a fatal state; restart the round first");
    return false;
  }
  try {
    validateLevels();
  } catch (error) {
    failRuntime(`debug RACE level validation failed: ${error}`);
    return false;
  }
  if (!validateDebugRaceEntities()) return false;

  const direction = debugRaceDirection();
  // Authored RACE levels are built around world origin. The ordinary loop may
  // have moved teledest far away, so reset it before RACE captures it at t+16.
  const sourcePosition = vec(0, 0, 0);
  destroyEndingRuntime(state.endingRuntime, "debug_race_restart");
  for (const index of [...state.levels.keys()]) destroyLevel(index);
  state.levels.clear();
  state.spawnQueue.length = 0;
  state.scheduledTasks.length = 0;
  state.currentLevel = undefined;
  state.transitionLevel = undefined;
  state.pendingLevel = undefined;
  state.endLockedUntil = Number.POSITIVE_INFINITY;

  // Theme preload props are intentionally absent from the stable VMAP. Use
  // the authored generic RACE road family here so the direct debug entry is
  // independent from the ordinary round's theme fallback state.
  const stageSnapshot = createStageSnapshot(state.campaign.stageIndex, "generic", "RACE");
  state.campaign.currentStageSnapshot = stageSnapshot;
  state.campaign.phase = "ending_handoff";
  state.campaign.endingStarted = true;
  state.campaign.endingContractCalls++;
  stopThemeMusic("debug_race_handoff", 10);
  state.themeMusic.enabled = false;
  state.campaign.endingResolved = false;
  state.campaign.endingOutcomePending = false;
  state.campaign.lastEnding = {
    stage: stageSnapshot.stage,
    theme: stageSnapshot.theme,
    ending: "RACE",
    levelIndex: "debug_race_source",
    debug: true,
  };
  state.running = true;
  moveTeleportDestination(sourcePosition, direction);

  try {
    const runtime = startRaceEnding(stageSnapshot, debugRaceSource(direction, sourcePosition));
    runtime.debugForced = true;
    runtime.debugCommand = command || "start";
    runtime.debugUsesFormalTimeline = true;
    announce(`DEBUG: entering formal RACE; authored RACE levels build at +${RACE_CONFIG.generateBuildTimes[0]}s and +${RACE_CONFIG.generateBuildTimes[1]}s`);
    return true;
  } catch (error) {
    failRuntime(`debug RACE startup failed: ${error}`);
    return false;
  }
}

function clearDebugTeleportTest() {
  const test = state.debugTeleportTest;
  if (!test) return;
  for (const id of test.connections ?? []) {
    disconnectEntityOutput(id);
    state.outputConnections?.delete(id);
    test.runtime?.outputConnections?.delete(id);
  }
  for (const entity of test.entities ?? []) {
    const entry = entity?.__teleportEntry;
    if (entry) test.runtime?.teleportEntries?.delete(entry);
    if (entity?.IsValid?.()) entity.Kill();
    test.runtime?.entities?.delete(entity);
  }
  const destinations = test.runtime?.teleportDestinations?.get(test.group);
  if (destinations) {
    for (let index = destinations.length - 1; index >= 0; index--) {
      if (destinations[index] === test.destination) destinations.splice(index, 1);
    }
  }
  state.debugTeleportTest = undefined;
}

function printDebugLiquidFallLayout() {
  message("[LIQUID FALL DEBUG] each theme lane, from entrance toward exit: default | legacy SetSkin | normal Skin | hazard Skin");
  for (const [index, theme] of Object.keys(THEME_PROFILES).entries()) {
    const profile = THEME_PROFILES[theme];
    message(`[LIQUID FALL DEBUG] lane ${index + 1}: ${theme}; normal=${profile.liquidSkin + 1}, hazard=${profile.hazardLiquidSkin + 1}`);
  }
  message("[LIQUID FALL DEBUG] targets: debug_liquid_fall_<theme>_<default|legacy|normal|hazard>; examples: ent_fire debug_liquid_fall_hell_normal Skin 10");
}

function debugLiquidFallCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase() || "on";
  if (command === "list") {
    printDebugLiquidFallLayout();
    return true;
  }
  if (command === "status") {
    const runtime = state.currentLevel;
    message(`[LIQUID FALL DEBUG] selected=${state.debugStageId === DEBUG_DATA.liquidFallLevel.id}`
      + ` ready=${runtime?.debugLiquidFall === true && runtime.lifecycle === "active"}`
      + ` samples=${runtime?.debugLiquidFallSamples?.size ?? 0}/32 pending=${Boolean(state.pendingLevel)}`);
    if (!runtime?.debugLiquidFall) return false;
    for (const theme of Object.keys(THEME_PROFILES)) {
      const samples = DEBUG_DATA.liquidFallColumns.map(mode => runtime.debugLiquidFallSamples.get(`debug_liquid_fall_${theme}_${mode}`));
      message(`[LIQUID FALL DEBUG] ${theme}: ` + samples.map((sample, index) =>
        `${DEBUG_DATA.liquidFallColumns[index]}=${validEntity(sample?.visual)} requested=${sample?.skin ?? "pending"}`
      ).join("; "));
    }
    return true;
  }
  if (command.startsWith("skin ")) {
    const value = command.slice(5).trim();
    const skin = Number(value);
    const runtime = state.currentLevel;
    if (!runtime?.debugLiquidFall || !/^\d+$/.test(value) || !Number.isInteger(skin) || skin > 20) {
      message("usage after the lab is ready: ze_debug_liquid_fall skin <0..20> (changes only the normal column)");
      return false;
    }
    for (const sample of runtime.debugLiquidFallSamples.values()) {
      if (sample.mode !== "normal" || !validEntity(sample.visual)) continue;
      applyThemeSkin(sample.visual, skin);
      sample.skin = skin;
    }
    message(`[LIQUID FALL DEBUG] normal column: sent Skin ${skin}; restart restores each theme's authored skin`);
    return true;
  }
  if (["off", "stop", "clear"].includes(command)) {
    if (state.debugStageId !== DEBUG_DATA.liquidFallLevel.id) {
      message("debug LIQUID FALL lab is already OFF");
      return false;
    }
    return debugStageCommand("off");
  }
  if (!["on", "restart"].includes(command)) {
    message("usage: ze_debug_liquid_fall <on|off|restart|status|list|skin N>");
    return false;
  }
  if (command === "on" && state.debugStageId === DEBUG_DATA.liquidFallLevel.id) {
    message("debug LIQUID FALL lab already selected; use status or restart");
    return true;
  }
  state.debugStageId = DEBUG_DATA.liquidFallLevel.id;
  state.debugStageMirror = false;
  state.debugShowcaseMode = false;
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  printDebugLiquidFallLayout();
  announce("debug LIQUID FALL skin lab enabled; rebuilding generated area");
  beginRound();
  return true;
}

function debugTeleportMapCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase() || "on";
  if (command === "status") {
    const runtime = state.currentLevel;
    message(`[TELEPORT DEBUG] selected=${state.debugStageId === DEBUG_DATA.teleportLevel.id}`
      + ` ready=${runtime?.debugTeleport === true} pending=${Boolean(state.pendingLevel)}`);
    if (!runtime?.debugTeleport) return false;
    for (const lane of DEBUG_DATA.teleportLanes) {
      const entry = [...runtime.teleportEntries].find((candidate) => candidate.group === lane.group);
      const trigger = entry?.trigger;
      message(`[TELEPORT DEBUG] ${lane.mode} trigger=debug_teleport_${lane.mode}_trigger`
        + ` valid=${validEntity(trigger)} callback=${entry?.connection !== undefined && entry?.connection !== null}`
        + ` parent=${trigger?.GetParent?.()?.GetEntityName?.() ?? "none"}`
        + ` origin=${formatVector(trigger?.GetAbsOrigin?.() ?? vec())}`
        + ` destinations=${runtime.teleportDestinations.get(lane.group)?.length ?? 0}`
        + ` touches=${entry?.touches ?? 0} teleports=${entry?.teleports ?? 0}`);
    }
    return true;
  }
  if (["off", "stop", "clear"].includes(command)) {
    if (state.debugStageId !== DEBUG_DATA.teleportLevel.id) {
      message("debug TELEPORT lab is already OFF");
      return false;
    }
    return debugStageCommand("off");
  }
  if (!["on", "restart"].includes(command)) {
    message("usage: ze_debug_teleport_map [on|off|restart|status]");
    return false;
  }
  if (command === "on" && state.debugStageId === DEBUG_DATA.teleportLevel.id) {
    message("debug TELEPORT lab already selected; use status or restart");
    return true;
  }
  state.debugStageId = DEBUG_DATA.teleportLevel.id;
  state.debugStageMirror = false;
  state.debugShowcaseMode = false;
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  announce("debug TELEPORT lab enabled; rebuilding generated area");
  beginRound();
  return true;
}

function armDebugTeleportLane(runtime, pawn, mode) {
  const lane = DEBUG_DATA.teleportLanes.find((candidate) => candidate.mode === mode);
  const entry = [...runtime.teleportEntries].find((candidate) => candidate.group === lane.group);
  if (!validEntity(entry?.trigger) || !runtime.teleportDestinations.get(lane.group)?.length) {
    message(`[TELEPORT DEBUG] ${mode} source/destination not ready; use ze_debug_teleport_map status`);
    return false;
  }
  clearDebugTeleportTest();
  const forward = runtime.incoming;
  let position;
  let velocity;
  if (mode === "fastfall" || mode === "slowfall") {
    position = add(entry.position, vec(0, 0, mode === "fastfall" ? 180 : 60));
    velocity = vec(0, 0, mode === "fastfall" ? -800 : -100);
  } else if (mode === "upward") {
    // Start below the brush's bottom (floor +20), but with the player's
    // hull intersecting it, so the native trigger sees the upward entry.
    position = add(entry.position, vec(0, 0, 2));
    velocity = add(mul(forward, 700), vec(0, 0, 1600));
  } else {
    position = add(add(entry.position, mul(forward, -128)), vec(0, 0, 2));
    velocity = mul(forward, 700);
  }
  pawn.Teleport({ position, angles: anglesFor(forward), velocity });
  message(`[TELEPORT DEBUG] armed ${mode}; source=${formatVector(entry.position)}`
    + ` destination=${formatVector(runtime.teleportDestinations.get(lane.group)[0])}`
    + "; normal generated trigger, no simulated touch; ensure noclip OFF");
  return true;
}

function debugTeleportCommand(args) {
  let command = String(args?.value ?? args ?? "").trim().toLowerCase() || "horizontal";
  if (["off", "stop", "clear"].includes(command)) {
    const wasActive = Boolean(state.debugTeleportTest);
    clearDebugTeleportTest();
    message(wasActive ? "debug TELEPORT test cleared" : "debug TELEPORT test is already inactive");
    return wasActive;
  }
  if (command === "on") command = "horizontal";
  if (command === "status") {
    if (state.currentLevel?.debugTeleport) return debugTeleportMapCommand("status");
    const hasGenerated = reportGeneratedTeleports();
    const test = state.debugTeleportTest;
    const pawn = allLivingPawns()[0];
    const velocity = pawn?.GetAbsVelocity?.() ?? vec();
    message(test
      ? `debug TELEPORT active=${test.mode} source=${formatVector(test.source)} destination=${formatVector(test.destination)}`
        + ` playerVelocity=${formatVector(velocity)}`
      : `debug TELEPORT inactive playerVelocity=${formatVector(velocity)}`);
    return hasGenerated || Boolean(test);
  }
  if (!["start", "horizontal", "fastfall", "slowfall", "upward"].includes(command)) {
    message("usage: ze_debug_teleport [on|off|horizontal|fastfall|slowfall|upward|status]");
    return false;
  }
  const runtime = state.currentLevel;
  const pawn = allLivingPawns()[0];
  if (!runtime || runtime.lifecycle === "destroyed") {
    message("debug TELEPORT requires an active generated level");
    return false;
  }
  if (!pawn?.IsValid?.() || !pawn.IsAlive?.()) {
    message("debug TELEPORT requires one living player");
    return false;
  }
  if (runtime.debugTeleport) return armDebugTeleportLane(runtime, pawn, command === "start" ? "horizontal" : command);
  if (!state.featureTemplates.has("trigger") || !state.featureTemplates.has("model")) cacheEntities();
  if (!state.featureTemplates.has("trigger") || !state.featureTemplates.has("model")) {
    message("debug TELEPORT missing template_trigger or template_model");
    return false;
  }

  clearDebugTeleportTest();
  const base = pawn.GetAbsOrigin?.() ?? vec();
  const pawnYaw = bodyAngles(pawn)?.yaw ?? yawOf(runtime.incoming ?? vec(1, 0, 0));
  const yaw = Number(pawnYaw) * Math.PI / 180;
  const forward = vec(Math.cos(yaw), Math.sin(yaw), 0);
  const right = vec(-forward.y, forward.x, 0);
  const mode = command === "start" ? "horizontal" : command;
  let source;
  let destination;
  let armPosition;
  let velocity;
  if (mode === "fastfall" || mode === "slowfall") {
    source = add(base, mul(right, 128));
    destination = add(source, mul(right, 256));
    armPosition = add(source, vec(0, 0, mode === "fastfall" ? 180 : 100));
    velocity = vec(0, 0, mode === "fastfall" ? -800 : -250);
  } else {
    source = add(base, mul(forward, 128));
    destination = add(source, mul(forward, 256));
    armPosition = add(source, mul(forward, -128));
    velocity = mode === "upward" ? add(mul(forward, 700), vec(0, 0, 1600)) : mul(forward, 700);
  }
  const group = 4;
  const destinations = runtime.teleportDestinations.get(group) ?? [];
  runtime.teleportDestinations.set(group, destinations);
  destinations.push(destination);
  const beforeEntities = new Set(runtime.entities);
  const beforeConnections = new Set(runtime.outputConnections);
  try {
    spawnTriggerFeature(runtime, {
      feature: "teleport",
      position: source,
      angles: anglesFor(runtime.incoming),
      group,
      debugTeleport: true,
    });
  } catch (error) {
    for (let index = destinations.length - 1; index >= 0; index--) {
      if (destinations[index] === destination) destinations.splice(index, 1);
    }
    message(`debug TELEPORT spawn failed: ${error}`);
    return false;
  }
  const entities = [...runtime.entities].filter((entity) => !beforeEntities.has(entity));
  const connections = [...runtime.outputConnections].filter((id) => !beforeConnections.has(id));
  state.debugTeleportTest = { runtime, group, mode, source, destination, entities, connections };
  pawn.Teleport({ position: armPosition, velocity });
  message(`debug TELEPORT armed ${mode}; cross the temporary portal to test velocity preservation`);
  return true;
}

function normalizeDebugStageId(value) {
  const text = String(value ?? "").trim();
  if (/^\d+$/.test(text)) return `#${text}`;
  return text;
}

function debugStageCommand(args) {
  const raw = String(args?.value ?? args ?? "").trim();
  const parts = raw.split(/\s+/).filter(Boolean);
  const command = parts[0]?.toLowerCase() ?? "";

  if (command === "list" || command === "find") {
    const query = command === "find" ? parts.slice(1).join(" ").toLowerCase() : "";
    if (command === "find" && !query) {
      message("usage: ze_debug_level find <name|id|author>");
      return false;
    }
    const page = command === "list" && parts[1] !== undefined ? Number(parts[1]) : 1;
    const levels = query ? ALL_LEVELS.filter(level =>
      `${level.id} ${level.name} ${level.author}`.toLowerCase().includes(query)) : ALL_LEVELS;
    const pageCount = Math.max(1, Math.ceil(levels.length / 50));
    if (!Number.isInteger(page) || page < 1 || page > pageCount) {
      message(`usage: ze_debug_level list <page 1..${pageCount}>`);
      return false;
    }
    message(`debug levels: ${levels.length} matches; page ${page}/${pageCount}`);
    for (const level of levels.slice((page - 1) * 50, page * 50))
      message(`${level.id} '${level.name}' by ${level.author} [${level.direction}, elev ${level.elevation}]`);
    if (query && levels.length > 50) message("showing first 50 matches; narrow the search");
    return true;
  }

  if (command === "catalog") {
    message(`debug stage catalog: ${DEBUG_DATA.stageCatalog.length} authored maps`);
    for (let index = 0; index < DEBUG_DATA.stageCatalog.length; index++) {
      const id = DEBUG_DATA.stageCatalog[index];
      const level = ALL_LEVELS.find((candidate) => candidate.id === id);
      if (level) {
        message(`${index + 1}. ${level.id} '${level.name}' by ${level.author}`
          + ` [${level.direction}, elev ${level.elevation}]`);
      } else {
        message(`${index + 1}. ${id} [missing from embedded stage data]`);
      }
    }
    return true;
  }

  if (command === "status") {
    const level = state.debugStageId
      ? debugLevelDefinition(state.debugStageId)
      : undefined;
    message(level
      ? `debug stage is ON: ${level.id} '${level.name}' by ${level.author}`
        + ` mirror=${state.debugStageMirror === true}`
      : "debug stage is OFF");
    return Boolean(level);
  }

  if (["", "off", "0", "false", "disable", "stop", "clear"].includes(command)) {
    if (!state.debugStageId) {
      message("debug stage is already OFF");
      return false;
    }
    state.debugStageId = undefined;
    state.debugStageMirror = false;
    announce("debug stage disabled; rebuilding generated area");
    beginRound();
    return true;
  }

  const id = normalizeDebugStageId(parts[0]);
  const level = ALL_LEVELS.find((candidate) => candidate.id === id);
  if (!level) {
    message(`unknown debug stage '${id}'; use ze_debug_level list or ze_debug_level find <name>`);
    return false;
  }
  const mirrored = parts.slice(1).some((part) =>
    ["mirror", "mirrored", "1", "true", "on"].includes(part.toLowerCase())
  );
  state.debugStageId = id;
  state.debugStageMirror = mirrored;
  state.debugShowcaseMode = false;
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  announce(`debug stage ${level.id} '${level.name}' by ${level.author}`
    + ` selected; mirror=${mirrored}; rebuilding generated area`);
  beginRound();
  return true;
}

function debugShowcaseCommand(args) {
  const command = String(args ?? "").trim().toLowerCase();
  if (command === "status") {
    message(`debug showcase is ${state.debugShowcaseMode ? "ON" : "OFF"}`);
    return;
  }
  let enabled;
  if (["on", "1", "true", "enable"].includes(command)) enabled = true;
  else if (["off", "0", "false", "disable"].includes(command)) enabled = false;
  else if (command === "" || command === "toggle") enabled = !state.debugShowcaseMode;
  else {
    message("usage: ze_debug_map <on|off|toggle|status>");
    return;
  }
  if (state.debugShowcaseMode === enabled && !state.debugGravityMode && !state.debugMovementThemesMode && !state.debugAllModelsMode && !state.debugTrapMode && !state.debugStageId) {
    message(`debug showcase is already ${enabled ? "ON" : "OFF"}`);
    return;
  }
  state.debugShowcaseMode = enabled;
  state.debugStageId = undefined;
  state.debugStageMirror = false;
  // Debug maps are mutually exclusive. Turning the general showcase on also
  // acts as the documented escape hatch from the focused labs.
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  announce(`debug showcase ${enabled ? "enabled" : "disabled"}; rebuilding generated area`);
  beginRound();
}

function debugGravityCommand(args) {
  const command = String(args ?? "").trim().toLowerCase();
  if (command === "status") {
    message(`debug gravity lab is ${state.debugGravityMode ? "ON" : "OFF"}`);
    return;
  }
  let enabled;
  if (["on", "1", "true", "enable"].includes(command)) enabled = true;
  else if (["off", "0", "false", "disable"].includes(command)) enabled = false;
  else if (command === "" || command === "toggle") enabled = !state.debugGravityMode;
  else {
    message("usage: ze_debug_lowgrav <on|off|toggle|status>");
    return;
  }
  if (state.debugGravityMode === enabled && !state.debugShowcaseMode && !state.debugMovementThemesMode && !state.debugAllModelsMode && !state.debugTrapMode && !state.debugStageId) {
    message(`debug gravity lab is already ${enabled ? "ON" : "OFF"}`);
    return;
  }
  state.debugGravityMode = enabled;
  if (enabled) {
    state.debugShowcaseMode = false;
    state.debugMovementThemesMode = false;
    state.debugAllModelsMode = false;
    state.debugTrapMode = false;
    state.debugStageId = undefined;
    state.debugStageMirror = false;
  }
  announce(`debug gravity lab ${enabled ? "enabled" : "disabled"}; rebuilding generated area`);
  beginRound();
}

