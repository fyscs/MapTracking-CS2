function stopDebugThunder() {
  const debug = state.debugThunder;
  if (!debug) return;
  destroyEntities([...debug.runtime.entities]);
  debug.runtime.entities.clear();
  debug.expires.clear();
  state.debugThunder = undefined;
}

function processDebugThunder(now = Instance.GetGameTime()) {
  const debug = state.debugThunder;
  if (!debug) return false;
  for (const [particle, until] of debug.expires) {
    if (now < until && validEntity(particle)) continue;
    if (validEntity(particle)) particle.Kill();
    debug.runtime.entities.delete(particle);
    debug.expires.delete(particle);
  }
  if (!debug.enabled || now < debug.nextAt) return false;
  const pawn = allLivingPawns()[0];
  if (!pawn) { debug.nextAt = now + 0.5; return false; }
  const origin = pawn.GetEyePosition?.() ?? add(pawn.GetAbsOrigin(), vec(0, 0, 64));
  const angles = viewAngles(pawn) ?? { pitch: 0, yaw: 0, roll: 0 };
  const position = add(origin, add(mul(forwardFromAngles({ pitch: 0, yaw: angles.yaw, roll: 0 }), debug.distance), vec(0, 0, debug.distance * 0.2)));
  for (const axis of ["x", "y", "z"]) position[axis] = Math.max(-14000, Math.min(14000, position[axis]));
  try {
    const particle = spawnFinaleWeatherParticle(debug.runtime, "finaleThunder", position);
    debug.expires.set(particle, now + 0.35);
    debug.count++;
    debug.lastPosition = clone(position);
    debug.nextAt = now + 0.5;
    if (debug.once) debug.enabled = false;
    return true;
  } catch (error) {
    stopDebugThunder();
    message(`[THUNDER DEBUG] stopped: ${error}`);
    return false;
  }
}

// DEBUG_NATIVE_BACKEND_BEGIN
let DEBUG_SHOWCASE_EXCLUDED_TILES = DEBUG_DATA.showcaseExcludedTiles;
let DEBUG_SHOWCASE_LEVEL = DEBUG_DATA.showcaseLevel;
let DEBUG_GRAVITY_LEVEL = DEBUG_DATA.gravityLevel;
let DEBUG_MOVEMENT_THEMES_LEVEL = DEBUG_DATA.movementThemesLevel;
let DEBUG_TELEPORT_LANES = DEBUG_DATA.teleportLanes;
let DEBUG_TELEPORT_LEVEL = DEBUG_DATA.teleportLevel;
let DEBUG_LIQUID_FALL_COLUMNS = DEBUG_DATA.liquidFallColumns;
let DEBUG_LIQUID_FALL_LEVEL = DEBUG_DATA.liquidFallLevel;
let DEBUG_ALL_MODELS_LEVEL = DEBUG_DATA.allModelsLevel;
let DEBUG_TRAP_LEVEL = DEBUG_DATA.trapLevel;
let DEBUG_STAGE_CATALOG = DEBUG_DATA.stageCatalog;
let DEBUG_STAGE_IDS = DEBUG_DATA.stageIds;

function refreshNativeDebugAliases() {
  DEBUG_SHOWCASE_EXCLUDED_TILES = DEBUG_DATA.showcaseExcludedTiles;
  DEBUG_SHOWCASE_LEVEL = DEBUG_DATA.showcaseLevel;
  DEBUG_GRAVITY_LEVEL = DEBUG_DATA.gravityLevel;
  DEBUG_MOVEMENT_THEMES_LEVEL = DEBUG_DATA.movementThemesLevel;
  DEBUG_TELEPORT_LANES = DEBUG_DATA.teleportLanes;
  DEBUG_TELEPORT_LEVEL = DEBUG_DATA.teleportLevel;
  DEBUG_LIQUID_FALL_COLUMNS = DEBUG_DATA.liquidFallColumns;
  DEBUG_LIQUID_FALL_LEVEL = DEBUG_DATA.liquidFallLevel;
  DEBUG_ALL_MODELS_LEVEL = DEBUG_DATA.allModelsLevel;
  DEBUG_TRAP_LEVEL = DEBUG_DATA.trapLevel;
