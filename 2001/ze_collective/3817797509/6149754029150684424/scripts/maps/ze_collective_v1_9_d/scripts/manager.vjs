const SILENTHILL_MODEL_TICK_BUFFER = 5;
const SILENTHILL_FADE_STEP = 25;
const SILENTHILL_FADE_RATE = 0.03;
const SILENTHILL_FADE_STEPS = Math.ceil(255 / SILENTHILL_FADE_STEP);
const THEME_PRELOAD_TIMEOUT = 12;
const REQUIRED_ENTITY_WAIT_TIMEOUT = 20;
const REQUIRED_ENTITY_RETRY_INTERVAL = 0.25;
const THEME_PRELOAD_ORIGIN = Object.freeze({ x: 0, y: 0, z: -16384 });
const THEME_PRELOAD_NAMES = Object.freeze(Object.keys(THEME_PROFILES).filter((theme) => theme !== "generic"));
const GENERATION_THEME_NAMES = Object.freeze(Object.keys(THEME_PROFILES));
                                                                               
                                                                               
                                                                          
const FINALE_THEME_NAMES = Object.freeze(Object.keys(THEME_PROFILES));
                                                                           
                                                                             
                                                                            
                                                              
const FIXED_GENERATION_THEME = "generic";

function shuffleGenerationThemeNames(random = Math.random) {
  const result = [...GENERATION_THEME_NAMES];
  for (let index = result.length - 1; index > 0; index--) {
    const sample = Math.max(0, Math.min(0.999999, Number(random()) || 0));
    const swap = Math.floor(sample * (index + 1));
    [result[index], result[swap]] = [result[swap], result[index]];
  }
  return result;
}

function themePreloadModels(theme) {
  const selected = themeProfile(theme).name;
  if (selected === "generic") return [];
  const genericModels = new Set(Object.values(THEME_TERRAIN_MODELS.generic).flat());
  return [...new Set(THEME_RUNTIME_TERRAIN_SHAPES
    .flatMap((shape) => terrainModelsFor(selected, shape))
    .filter(Boolean))]
    .filter((model) => !genericModels.has(model))
    .sort();
}

function themePreloadTarget(theme, model) {
  const filename = String(model).split("/").pop() ?? "";
  const stem = filename.toLowerCase().endsWith(".vmdl") ? filename.slice(0, -5) : filename;
  return `assetdep_theme_${themeProfile(theme).name}_${stem}`;
}

function themeRootPreloadTarget(model) {
  const filename = String(model).split("/").pop() ?? "";
  const stem = filename.toLowerCase().endsWith(".vmdl") ? filename.slice(0, -5) : filename;
  return `assetdep_theme_${stem}`;
}

function musicTrack(token, volume, pitch, duration, options = {}) {
  return Object.freeze({ token, volume, pitch, duration, ...options });
}

                                                                         
                                                                              
                                                                             
                                                            
