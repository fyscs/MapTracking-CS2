const PRIVATE_QUIET_AUDIO = new Set(["tp_bounce", "tp_tpbounce", "tp_tp", "boostpad", "boostpad_wet"]);
const sourceAudio = { live: new Set(), templates: new Map(), warnings: new Set(), serial: 0, nextFollowAt: 0 };
function sourceAudioWarn(key, text) {
  if (sourceAudio.warnings.has(key)) return;
  sourceAudio.warnings.add(key);
  message(`AUDIO: ${text}`);
}
function sourceAudioSample(value) {
  return Array.isArray(value) ? value[0] + Math.floor(Math.random() * (value[1] - value[0] + 1)) : Number(value);
}
function retireSourceAudio(record) {
  if (!record || !sourceAudio.live.delete(record)) return;
  if (validEntity(record.sound)) {
    fireTarget(record.sound, "Volume", "0");
    fireTarget(record.sound, "StopSound");
    fireTarget(record.sound, "Kill", "", 0.02);
  }
}
function clearSourceAudio(owner) {
  for (const record of [...sourceAudio.live])
    if (owner === undefined || record.owner === owner) retireSourceAudio(record);
  if (owner === undefined) { sourceAudio.templates.clear(); sourceAudio.nextFollowAt = 0; }
}
function spawnSourceAudio(token, position, options = {}) {
  const asset = SOURCE_AUDIO_ASSETS[token];
  if (!asset) { sourceAudioWarn(token, `unknown sound '${token}'`); return undefined; }
                                                                          
  if (options.recipient || options.radius < 0) {
    const slot = playerSlotForHud(options.recipient);
    if (slot === undefined || typeof Instance.ClientCommand !== "function") {
      sourceAudioWarn(`private:${token}`, `cannot deliver '${token}' to its player`);
      return undefined;
    }
    const privateSource = PRIVATE_QUIET_AUDIO.has(token)
      ? `sounds/collective_private/${token}.vsnd` : asset.source;
    try { Instance.ClientCommand(slot, `play "${privateSource}"`); }
    catch (error) {
      sourceAudioWarn(`private-command:${token}`, `client rejected '${token}': ${error}`);
      return undefined;
    }
    return { token, recipient: options.recipient, private: true };
  }
  const radius = Number(options.radius ?? 10000);
  const key = `${token}_${radius === 0 ? "global" : `r${radius}`}`;
  let template = sourceAudio.templates.get(key);
  if (!validEntity(template)) {
    template = Instance.FindEntityByName(`template_audio_${key}`);
    if (validEntity(template)) sourceAudio.templates.set(key, template);
  }
  if (!validEntity(template) || typeof template.ForceSpawn !== "function") {
    sourceAudioWarn(key, `missing template_audio_${key}; update/compile the map`);
    return undefined;
  }
  let spawned;
  try { spawned = spawnRoundEntities(template, position, {pitch:0,yaw:0,roll:0}) ?? []; }
  catch (error) { sourceAudioWarn(key, `cannot spawn ${key}: ${error}`); return undefined; }
  const sound = spawned.find(e => validEntity(e) && e.GetClassName?.() === "ambient_generic");
  if (!sound) {
    for (const e of spawned) if (validEntity(e)) e.Kill();
    sourceAudioWarn(key, `${key} template has no ambient_generic`); return undefined;
  }
  for (const e of spawned) if (e !== sound && validEntity(e)) e.Kill();
  const now = Instance.GetGameTime(), pitch = Number(options.pitch ?? 100), volume = Number(options.volume ?? 10);
  const life = Math.max(0.02, Number(options.lifetime ?? 0.05));
                                                                              
                                                                               
  const clipTime = asset.seconds / Math.max(0.01, pitch / 100);
  const record = { token, sound, owner: options.owner, parent: options.parent,
    position: clone(position), followUntil: now + life,
    expiresAt: now + Math.max(life, clipTime + 0.1), pitch, volume, radius };
  sound.SetEntityName?.(`audio_live_${++sourceAudio.serial}_${token}`);
  sound.Teleport?.({position:clone(position)});
  if (validEntity(record.parent)) {
    const origin = record.parent.GetAbsOrigin?.();
    if (origin) {
      const offset = sub(position, origin), angles = bodyAngles(record.parent) ?? {pitch:0,yaw:0,roll:0};
      const basis = [forwardFromAngles(angles),leftFromAngles(angles),upFromAngles(angles)];
      record.offset = basis.map(v => offset.x*v.x + offset.y*v.y + offset.z*v.z);
    }
  }
  sourceAudio.live.add(record);
  fireTarget(sound, "PlaySound");
  fireTarget(sound, "Volume", String(volume));
  fireTarget(sound, "Pitch", String(pitch), 0.01);
  fireTarget(sound, "Volume", String(volume), 0.02);
  return record;
}
function processSourceAudio(now) {
  if (now < sourceAudio.nextFollowAt) return;
  sourceAudio.nextFollowAt = now + 0.05;
  for (const record of [...sourceAudio.live]) {
    if (!validEntity(record.sound) || now >= record.expiresAt) { retireSourceAudio(record); continue; }
    if (record.offset && now < record.followUntil && validEntity(record.parent)) {
      const origin=record.parent.GetAbsOrigin?.(), angles=bodyAngles(record.parent)??{pitch:0,yaw:0,roll:0};
      if (!origin) continue;
      const [x,y,z]=record.offset;
      record.position=add(origin,add(add(mul(forwardFromAngles(angles),x),mul(leftFromAngles(angles),y)),mul(upFromAngles(angles),z)));
      record.sound.Teleport?.({position:record.position});
    }
  }
}
function playSourceAudioCue(line, position, options = {}) {
  const cue = SOURCE_AUDIO_CUES[line];
  if (!cue) { sourceAudioWarn(`cue:${line}`, `unknown original sound cue ${line}`); return false; }
  const [token, authoredRadius, lifetime, pitch, volume, follow] = cue;
                                                                             
                                                                             
  const radius = Array.isArray(authoredRadius)
    ? Math.round(sourceAudioSample(authoredRadius) / 500) * 500 : authoredRadius;
  return playCatalogSound(token, position, { radius, lifetime:sourceAudioSample(lifetime),
    pitch:sourceAudioSample(pitch), volume:sourceAudioSample(volume), ...options,
    parent: follow ? options.parent : undefined });
}
function playSourceAudioStack(lines, position, options = {}) {
  let played = false;
  for (const line of lines) played = playSourceAudioCue(line, position, options) || played;
  return played;
}
function spawnRiftTeleportParticles(runtime, pair, pawn, touchedPortal, portalCenter) {
  const now = Instance.GetGameTime();
  pair.particleCooldowns ??= new Map();
  if ((pair.particleCooldowns.get(touchedPortal) ?? 0) > now) return;
  pair.particleCooldowns.set(touchedPortal, now + 0.10);
  spawnItemParticle(runtime, pair.item, "weapon_sensorgren_detonate",
    add(pawn.GetAbsOrigin?.() ?? touchedPortal, vec(0, 0, 48)), undefined, 0.05);
  spawnItemParticle(runtime, pair.item, "weapon_sensorgren_detonate",
    portalCenter, undefined, 0.05);
}

function playRiftTeleportAudio(pawn, entry, exit) {
  playSourceAudioCue(10942, exit, { recipient: pawn });
  playSourceAudioCue(10946, add(entry, vec(0,0,48)));
  playSourceAudioCue(10948, add(exit, vec(0,0,48)));
}


function removeItemEffect(runtime, item, visual) {
  item?.effects?.delete(visual);
  if (validEntity(visual)) visual.Kill();
  runtime?.entities?.delete(visual);
}

function cleanupItemEffects(runtime, item) {
  cancelItemTasks(runtime, item);
  for (const visual of item?.effects ?? []) removeItemEffect(runtime, item, visual);
  item?.effects?.clear();
  for (const visual of item?.auxiliaryVisuals ?? []) {
    if (validEntity(visual)) visual.Kill();
    runtime?.entities?.delete(visual);
  }
  item?.auxiliaryVisuals?.clear();
}

function forwardVector(entity, includePitch = false) {
  const angles = includePitch
    ? (viewAngles(entity) ?? { pitch: 0, yaw: 0, roll: 0 })
    : (bodyAngles(entity) ?? { pitch: 0, yaw: 0, roll: 0 });
  const pitch = includePitch ? angles.pitch * Math.PI / 180 : 0;
  const yaw = angles.yaw * Math.PI / 180;
  return vec(Math.cos(pitch) * Math.cos(yaw), Math.cos(pitch) * Math.sin(yaw), -Math.sin(pitch));
}

                                                                            
                                                                               
                                                                             
                                                                               
function viewAngles(entity) {
  if (!entity) return undefined;
  const angles = entity.GetEyeAngles?.()
    ?? entity.GetViewAngles?.()
    ?? entity.GetAbsAngles?.();
  if (!angles) return undefined;
  return {
    pitch: Number(angles.pitch ?? angles.x ?? 0),
    yaw: Number(angles.yaw ?? angles.y ?? 0),
    roll: Number(angles.roll ?? angles.z ?? 0),
  };
}

                                                                            
                                                                             
                                                                        
                                                       
function bodyAngles(entity) {
  const angles = entity?.GetAbsAngles?.();
  if (!angles) return undefined;
  return {
    pitch: Number(angles.pitch ?? angles.x ?? 0),
    yaw: Number(angles.yaw ?? angles.y ?? 0),
    roll: Number(angles.roll ?? angles.z ?? 0),
  };
}

function anglesFromDirection(direction) {
  const horizontal = Math.hypot(direction.x, direction.y);
  return {
    pitch: -Math.atan2(direction.z, Math.max(0.0001, horizontal)) * 180 / Math.PI,
    yaw: Math.atan2(direction.y, direction.x) * 180 / Math.PI,
    roll: 0,
  };
}

function forwardFromAngles(angles) {
  const pitch = Number(angles.pitch ?? 0) * Math.PI / 180;
  const yaw = Number(angles.yaw ?? 0) * Math.PI / 180;
  return vec(
    Math.cos(pitch) * Math.cos(yaw),
    Math.cos(pitch) * Math.sin(yaw),
    -Math.sin(pitch),
  );
}

function leftFromAngles(angles) {
  const pitch = Number(angles.pitch ?? 0) * Math.PI / 180;
  const yaw = Number(angles.yaw ?? 0) * Math.PI / 180;
  const roll = Number(angles.roll ?? 0) * Math.PI / 180;
  const sp = Math.sin(pitch);
  const cp = Math.cos(pitch);
  const sy = Math.sin(yaw);
  const cy = Math.cos(yaw);
  const sr = Math.sin(roll);
  const cr = Math.cos(roll);
                                                                         
  return vec(
    sr * sp * cy - cr * sy,
    sr * sp * sy + cr * cy,
    sr * cp,
  );
}

function upFromAngles(angles) {
  const pitch = Number(angles.pitch ?? 0) * Math.PI / 180;
  const yaw = Number(angles.yaw ?? 0) * Math.PI / 180;
  const roll = Number(angles.roll ?? 0) * Math.PI / 180;
  const sp = Math.sin(pitch);
  const cp = Math.cos(pitch);
  const sy = Math.sin(yaw);
  const cy = Math.cos(yaw);
  const sr = Math.sin(roll);
  const cr = Math.cos(roll);
  return vec(
    cr * sp * cy + sr * sy,
    cr * sp * sy - sr * cy,
    cr * cp,
  );
}

function placeOnGround(holder, forwardDistance = 15, downDistance = 40, direction = horizontalViewDirection(holder)) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return undefined;
  const base = add(origin, vec(0, 0, 1));
  let start = base;
  if (forwardDistance > 0) {
    const forward = mul(direction, forwardDistance);
    const forwardTrace = Instance.TraceLine({
      start: base,
      end: add(base, forward),
      ignoreEntity: holder,
    });
                                                                       
                                                                              
    if (forwardTrace?.didHit) start = clone(forwardTrace.end);
    else start = add(base, forward);
  }
  const result = Instance.TraceLine({
    start,
    end: add(start, vec(0, 0, -downDistance)),
    ignoreEntity: holder,
  });
  return result?.didHit ? clone(result.end) : undefined;
}

function targetInForwardBox(holder, target, length, halfWidth, minZ, maxZ, minAlong = 0,
  origin = holder.GetAbsOrigin?.()) {
  const hull = playerCollisionHull(target);
  if (!origin || !hull) return false;
                                                                           
                                                                              
                                                                               
                                                               
  const angles = viewAngles(holder) ?? { pitch: 0, yaw: 0, roll: 0 };
  const forward = forwardFromAngles(angles);
  const left = leftFromAngles(angles);
  const up = upFromAngles(angles);
  const center = add(origin, add(mul(forward, (minAlong + length) * 0.5),
    mul(up, (minZ + maxZ) * 0.5)));
  const half = [(length - minAlong) * 0.5, halfWidth, (maxZ - minZ) * 0.5];
  const basis = [forward, left, up];
  const worldAxes = [vec(1, 0, 0), vec(0, 1, 0), vec(0, 0, 1)];
  const delta = sub(hull.center, center);
  const dot = (a, b) => a.x * b.x + a.y * b.y + a.z * b.z;
  const separatedOn = axis => {
    const axisLength = Math.hypot(axis.x, axis.y, axis.z);
    if (axisLength < 1e-8) return false;
    const attackExtent = half.reduce((sum, extent, index) =>
      sum + extent * Math.abs(dot(axis, basis[index])), 0);
    const playerExtent = hull.halfWidth * (Math.abs(axis.x) + Math.abs(axis.y))
      + hull.halfHeight * Math.abs(axis.z);
    return Math.abs(dot(delta, axis)) > attackExtent + playerExtent + 1e-7 * axisLength;
  };
  // OBB versus player AABB: test both sets of face normals and all nine
  // edge cross products. Projecting onto attack axes alone admits corner hits.
  for (const axis of [...basis, ...worldAxes]) if (separatedOn(axis)) return false;
  for (const attackAxis of basis) {
    for (const worldAxis of worldAxes) {
      if (separatedOn(vec(
        attackAxis.y * worldAxis.z - attackAxis.z * worldAxis.y,
        attackAxis.z * worldAxis.x - attackAxis.x * worldAxis.z,
        attackAxis.x * worldAxis.y - attackAxis.y * worldAxis.x,
      ))) return false;
    }
  }
  return true;
}

function targetInOrientedBeam(origin, direction, target, beamLength, halfWidth) {
  return projectileTouchesPlayerHull(
    target,
    origin,
    add(origin, mul(direction, beamLength)),
    halfWidth,
  );
}

function validZombieTarget(pawn) {
  return pawn?.IsValid?.() && pawn.IsAlive?.() && pawn.GetTeamNumber?.() === 2
    && !playerHasItemStatus(pawn, ":invincible");
}

function infectionHasStarted() {
  return state.firstInfectionAt !== undefined || state.infectionActivated;
}

function flashItemFailed(runtime, item) {
  if (!validEntity(item?.visual)) return;
  item.visual.SetColor?.({ r: 50, g: 50, b: 50, a: 255 });
  scheduleItemTask(runtime, item, 0.05, () => {
    if (validEntity(item.visual)) item.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
  });
}

function restoreItemReady(runtime, item) {
  if (!validEntity(item?.visual)) return;
  item.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
  const glowColors = {
    storm_blade: { r: 0, g: 200, b: 255, a: 255 },
  };
  const glow = glowColors[item.name];
  if (glow) item.visual.Glow?.(glow);
  else item.visual.Unglow?.();
}

function restoreItemColor(runtime, item) {
  if (validEntity(item?.visual)) item.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
}

function restorePullerReady(runtime, item) {
  if (!validEntity(item?.visual)) return;
  item.visual.SetColor?.({ r: 50, g: 0, b: 80, a: 200 });
  item.visual.Glow?.({ r: 255, g: 0, b: 0, a: 255 });
}

function restoreDestructoHammerReady(runtime, item) {
  if (!validEntity(item?.visual)) return;
  item.visual.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
  item.visual.SetModelScale?.(1);
}

function useHealOrb(runtime, item, holder, now) {
  if (!deployHealOrb(runtime, holder, item, now)) return false;
  playSourceAudioStack([11554, 11555, 11556], add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 48)));
  item.spent = true;
  return { success: true, deferConsume: true };
}

function spawnPiggybackSaddle(runtime, item) {
  item.data.rider = undefined;
  item.data.lastHolderPosition = undefined;
}

function dismountPiggyback(runtime, item) {
  const rider = item?.data?.rider;
  if (!validEntity(rider)) {
    if (item?.data) item.data.rider = undefined;
    return;
  }
  const holder = item.holder;
  rider.SetParent?.(undefined);
  const holderPosition = holder?.GetAbsOrigin?.() ?? item.data.lastHolderPosition;
  if (!holderPosition || rider.GetTeamNumber?.() !== 3 || !rider.IsAlive?.()) {
    if (rider.IsAlive?.()) damagePawn(rider, 999999);
  } else {
    const direction = horizontalViewDirection(holder ?? item.carrier);
    const velocity = holder?.GetAbsVelocity?.() ?? vec();
    rider.Teleport({
      position: add(holderPosition, mul(leftOf(direction), 28)),
      velocity: vec(
        velocity.x + direction.x * 250,
        velocity.y + direction.y * 250,
        Math.max(550, velocity.z + 550),
      ),
    });
  }
  item.data.rider = undefined;
}

function cleanupPiggyback(runtime, item) {
  dismountPiggyback(runtime, item);
  cleanupItemEffects(runtime, item);
}

function tickPiggyback(runtime, item, holder) {
  if (validEntity(holder)) item.data.lastHolderPosition = clone(holder.GetAbsOrigin?.() ?? item.position);
  const rider = item.data.rider;
  if (!validEntity(rider)) {
    item.data.rider = undefined;
    return;
  }
  if (
    item.state !== "held"
    || !validEntity(holder)
    || !holder.IsAlive?.()
    || holder.GetTeamNumber?.() !== 3
    || !rider.IsAlive?.()
    || rider.GetTeamNumber?.() !== 3
  ) {
    dismountPiggyback(runtime, item);
    return;
  }
  const saddlePosition = item.visual?.GetAbsOrigin?.() ?? holder.GetAbsOrigin?.();
  if (!saddlePosition) return;
  rider.SetParent?.(item.visual);
  rider.Teleport({ position: add(saddlePosition, vec(0, 0, 18)), velocity: vec() });
}

function useMoonBoost(runtime, item, holder) {
  const velocity = holder.GetAbsVelocity?.() ?? vec();
  playSourceAudioCue(11617, holder.GetAbsOrigin?.() ?? item.position);
  const moonPosition = clone(item.carrier?.GetAbsOrigin?.() ?? holder.GetAbsOrigin?.() ?? item.position);
  spawnItemParticles(runtime, item, ["explosion_child_distort01b", "chicken_gone"], moonPosition, undefined, 0.10);
  holder.Teleport({ velocity: add(velocity, vec(0, 0, 500)) });
  addPlayerStatus(runtime, holder, `${runtime.index}:item:${item.id}:moonboosting`, 0.1);
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 255 });
  return true;
}

function onMiniSlotsPickup(runtime, item) {
  fireTarget(item.visual, "SetAnimation", "idle");
  fireTarget(item.visual, "SetDefaultAnimation", "idle", 0.01);
}

function useMiniSlots(runtime, item, holder) {
  playSourceAudioCue(7535, add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 48)));
  fireTarget(item.visual, "SetAnimation", "spin");
  fireTarget(item.visual, "SetDefaultAnimation", "spin", 0.02);
  fireTarget(item.visual, "SetPlaybackRate", "11", 0.03);
  item.data.pendingRolls = (item.data.pendingRolls ?? 0) + 1;
  const user = holder;
  const won = Math.random() * 100 <= 5;
  scheduleItemTask(runtime, item, 0.8, () => {
    item.data.pendingRolls = Math.max(0, (item.data.pendingRolls ?? 1) - 1);
    if (!validEntity(user) || !user.IsAlive?.() || user.GetTeamNumber?.() !== 3) return;
    fireTarget(item.visual, "SetAnimation", won ? "win" : "lose");
    fireTarget(item.visual, "SetDefaultAnimation", won ? "win" : "lose", 0.02);
    if (won) user.SetHealth?.(user.GetHealth() + 42);
    else damagePawn(user, 7);
    playSourceAudioCue(
      won ? 5680 : 5689,
      add(item.visual?.GetAbsOrigin?.() ?? item.position, vec(0, 0, 48)),
    );
  });
  return true;
}

function stopBhopSteroids(runtime, item) {
  if (!item?.data) return;
  if (item.data.bhopActive) stopCatalogSound("bhop_steroids", item);
  item.data.bhopActive = false;
  item.data.bhopLastAt = undefined;
}

function useBhopSteroids(runtime, item, holder, now) {
  if (!item.data.bhopActive && item.fuel <= 2) return false;
  if (item.data.bhopActive) {
    stopBhopSteroids(runtime, item);
  } else {
    item.data.bhopActive = true;
    item.data.bhopLastAt = now;
    item.fuel -= 2;
    playSourceAudioCue(9424, holder.GetAbsOrigin?.() ?? item.position, {parent:item.button,owner:item});
  }
  return { success: true, consumeCharge: false };
}

function canUseBhopSteroids(item, holder) {
  if (!holder?.IsAlive?.() || holder.GetTeamNumber?.() !== 3 || item.spent) return false;
                                                                           
                                                                           
  return item.data?.bhopActive === true || !playerHasItemStatus(holder, ":squid");
}

function tickBhopSteroids(runtime, item, holder, now) {
  if (!item.data.bhopActive) return;
  if (item.state !== "held" || !validEntity(holder) || holder.GetTeamNumber?.() !== 3) {
    stopBhopSteroids(runtime, item);
    return;
  }
  const elapsed = Math.max(0, Math.min(0.25, now - (item.data.bhopLastAt ?? now)));
  item.data.bhopLastAt = now;
  item.fuel = Math.max(0, item.fuel - elapsed);
  if (item.fuel <= 0) {
    stopBhopSteroids(runtime, item);
    item.spent = true;
    consumeItem(runtime, item);
    return;
  }
  const velocity = holder.GetAbsVelocity?.() ?? vec();
  let grounded = false;
  if (velocity.z < 0.05) {
    const origin = holder.GetAbsOrigin?.();
    if (origin) {
      const outer = item.definition.groundRayOuter;
      for (const offset of [
        vec(),
        vec(-outer, 0, 0),
        vec(outer, 0, 0),
        vec(0, -outer, 0),
        vec(0, outer, 0),
      ]) {
        const rayOrigin = add(origin, offset);
        const trace = Instance.TraceLine({
          start: add(rayOrigin, vec(0, 0, item.definition.groundRayUpper)),
          end: add(rayOrigin, vec(0, 0, item.definition.groundRayLower)),
          ignoreEntity: holder,
        });
        if (trace?.didHit) {
          grounded = true;
          break;
        }
      }
    }
  }
  if (!grounded) return;
  const direction = forwardVector(holder);
  holder.Teleport({
    velocity: vec(
      direction.x * item.definition.jumpVelocityXY,
      direction.y * item.definition.jumpVelocityXY,
      item.definition.jumpVelocityZ,
    ),
  });
}

function resolveBaguetteSwing(runtime, item, holder) {
  if (
    item.state !== "held"
    || item.holder !== holder
    || !validEntity(holder)
    || !holder.IsAlive?.()
    || holder.GetTeamNumber?.() !== 3
    || item.spent
  ) return;
  const definition = item.definition;
  // The thin slap volume pivots at the holder's body, rather than feet.
  // This also lowers its origin when the holder crouches.
  const attackOrigin = playerCollisionHull(holder)?.center;
  const targets = allLivingPawns().filter((pawn) => validZombieTarget(pawn)
    && targetInForwardBox(
      holder,
      pawn,
      definition.hitLength,
      definition.hitHalfWidth,
      definition.hitMinZ,
      definition.hitMaxZ,
      definition.hitMinAlong,
      attackOrigin,
    ));
  const bossOrigin = holder.GetAbsOrigin?.() ?? item.position;
  const bossDirection = directionWithPitchOffset(holder);
  hurtFinaleBossAt(add(bossOrigin, mul(bossDirection, 200)), definition.bossRadius, definition.bossDamage, definition.bossStunChance, definition.bossStunTimeAdd, holder, "baguette");
  const breakChance = item.data.breakChance ?? definition.breakChanceInitial;
  const broke = Math.random() * 100 <= breakChance;
  for (const pawn of targets) {
    damagePawn(pawn, definition.hitDamage, holder, item.carrier);
    if (reserveItemParticleBurst("baguette", 6, 0.05)) {
      const position = add(pawn.GetAbsOrigin?.() ?? item.position, vec(0, 0, 40));
      playSourceAudioCue(7419, position);
      spawnItemParticle(runtime, item, "weapon_taser_flash", position, sourceItemImpactAngles(), 0.03);
    }
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    const direction = directionWithPitchOffset(holder);
    pawn.Teleport({
      velocity: vec(
        direction.x * definition.hitVelocityXY,
        direction.y * definition.hitVelocityXY,
        velocity.z < 30 ? definition.hitVelocityZ : velocity.z,
      ),
    });
  }
  item.data.breakChance = breakChance + (
    targets.length > 0
      ? targets.length * definition.breakChanceHit
      : definition.breakChanceMiss
  );
  if (broke) {
                                                                           
                                                                      
                                                                          
                                                                             
    item.data.baguetteBroken = true;
    item.spent = true;
    item.data.baguetteSwingToken = (item.data.baguetteSwingToken ?? 0) + 1;
    scheduleItemTask(runtime, item, 0.22, () => {
      if (!validEntity(item.visual)) return;
      const applyBrokenBodyGroup = () => {
        if (!validEntity(item.visual)) return;
        fireTarget(item.visual, "SetBodyGroup", "main,1");
      };
      applyBrokenBodyGroup();
      afterThink(applyBrokenBodyGroup);
      const breakPosition = item.visual.GetAbsOrigin?.() ?? item.position;
      playSourceAudioCue(7374, breakPosition);
      playSourceAudioCue(7375, breakPosition);
      playSourceAudioCue(7376, breakPosition);
    });
                                                                          
                                                                             
    for (let step = 1; step <= 10; step++) {
      scheduleItemTask(runtime, item, 0.22 + 7 + step * 0.2, () => {
        if (!validEntity(item.visual)) return;
        item.visual.SetColor?.({ r: 255, g: 255, b: 255, a: Math.max(0, 255 - step * 26) });
      });
    }
    scheduleItemTask(runtime, item, 10, (activeRuntime) => consumeItem(activeRuntime, item));
  }
}

function useBaguette(runtime, item, holder) {
  if (!infectionHasStarted()) return false;
  const swingOrigin = holder.GetAbsOrigin?.() ?? item.position;
  playSourceAudioCue(7479, swingOrigin);
  playSourceAudioCue(7480, swingOrigin);
  fireTarget(item.visual, "SetAnimation", `swing_${((item.data.swing ?? 0) % 2) + 1}`);
  fireTarget(item.visual, "SetPlaybackRate", "0.1", 0.01);
  fireTarget(item.visual, "SetPlaybackRate", "0.1", 0.03);
  fireTarget(item.visual, "SetPlaybackRate", "1.5", 0.20);
  const swingToken = (item.data.baguetteSwingToken ?? 0) + 1;
  item.data.baguetteSwingToken = swingToken;
  const firstArc = (item.data.swing ?? 0) % 2 === 0;
  for (let step = 0; step < 7; step++) {
    const offset = firstArc ? -70 + step * 20 : 70 - step * 20;
    scheduleItemTask(runtime, item, 0.20 + step * 0.02, (activeRuntime) => {
      if (!validEntity(item.visual)) return;
      const angles = item.visual.GetAbsAngles();
      const direction = forwardFromAngles({ ...angles, yaw: angles.yaw + offset });
      spawnItemParticle(activeRuntime, item, "explosion_child_distort01b",
        add(item.visual.GetAbsOrigin(), mul(direction, 320)), undefined, 0.03);
    });
  }
  const baseScale = item.definition.attachment?.scale ?? 0.7;
  for (let step = 0; step < 8; step++) {
    scheduleItemTask(runtime, item, 0.14 + step * 0.01, () => {
      if (item.data.baguetteSwingToken !== swingToken || item.data.baguetteBroken || !validEntity(item.visual)) return;
      item.visual.SetModelScale?.(baseScale + step * 0.1);
    });
  }
  scheduleItemTask(runtime, item, 0.22, () => {
    if (item.data.baguetteSwingToken === swingToken && !item.data.baguetteBroken && validEntity(item.visual)) item.visual.SetModelScale?.(1.5);
    if (item.data.baguetteSwingToken === swingToken && !item.data.baguetteBroken && validEntity(item.visual)) item.visual.Glow?.();
  });
  for (let step = 0; step < 8; step++) {
    scheduleItemTask(runtime, item, 0.32 + step * 0.01, () => {
      if (item.data.baguetteSwingToken !== swingToken || item.data.baguetteBroken || !validEntity(item.visual)) return;
      item.visual.SetModelScale?.(1.5 - step * 0.1);
    });
  }
  scheduleItemTask(runtime, item, 0.40, () => {
    if (item.data.baguetteSwingToken === swingToken && !item.data.baguetteBroken && validEntity(item.visual)) {
      item.visual.SetModelScale?.(baseScale);
      item.visual.Unglow?.();
    }
  });
  item.data.swing = (item.data.swing ?? 0) + 1;
  scheduleItemTask(runtime, item, item.definition.hitDelay, (activeRuntime) => {
    resolveBaguetteSwing(activeRuntime, item, holder);
  });
  return { success: true, consumeCharge: false };
}

function usePeanutButter(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const position = clone(item.carrier?.GetAbsOrigin?.() ?? holder.GetAbsOrigin?.());
  const angles = { pitch: 0, yaw: Math.random() * 360, roll: 0 };
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "peanutbutter",
                                                                              
                                                                             
                                                       
    model: item.definition.effectModel,
    position,
    angles,
    scale: 1,
    color: { r: 200, g: 180, b: 100, a: 255 },
  });
  hurtFinaleBossAt(position, item.definition.bossRadius, item.definition.bossDamage, item.definition.bossStunChance, item.definition.bossStunTimeAdd, holder, "peanutbutter");
                                                                        
                                                                      
  visual.Teleport?.({ position, angles, velocity: vec() });
  playSourceAudioStack([7798, 7799], position);
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "peanutbutter",
    visual,
    item,
    position,
    touched: new Set(),
    source: itemEffectSource(runtime, item, "peanut"),
    expiresAt: now + 15,
  });
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 150 });
  return true;
}

function useClaymore(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const direction = horizontalViewDirection(holder);
  const position = placeOnGround(holder, 15, 40, direction);
  if (!position) return false;
  const angles = anglesFor(direction);
  playSourceAudioCue(7979, position);
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "claymore",
    model: "models/luffaren/claymore.vmdl",
    position,
    angles,
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "claymore",
    visual,
    item,
    position,
    direction,
    owner: holder,
    damageMultiplier: 1,
    armedAt: now + 0.1,
    detonateAt: undefined,
    expiresAt: now + 90,
  });
  item.visual?.SetColor?.({ r: 255, g: 0, b: 0, a: 150 });
  return true;
}

function useBillNye(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const direction = horizontalViewDirection(holder);
  const position = placeOnGround(holder, 15, 40, direction);
  if (!position) return false;
  position.z += Math.random() * 3 - 3;
  const visualAngles = anglesFor(direction);
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "billnye",
                                                                           
                                                                 
    model: "models/luffaren/billnye.vmdl",
    position,
    angles: visualAngles,
    scale: 1.1,
  });
                                                                          
                                                                       
  visual.Teleport?.({ position, angles: visualAngles, velocity: vec() });
  const applyBillNyeBodyGroup = () => {
    if (validEntity(visual)) fireTarget(visual, "SetBodyGroup", "main,1");
  };
  applyBillNyeBodyGroup();
  afterThink(applyBillNyeBodyGroup);
  fireTarget(visual, "Skin", "0");
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "billnye",
    visual,
    item,
    position,
    direction,
    startsAt: now + 1,
    scansAt: now + 2.9,
    stopsAt: now + 15,
    removeAt: now + 30,
    startSoundPlayed: false,
    stopSoundPlayed: false,
  });
  return true;
}

function dragonSlayerAttackStillValid(item, holder, token) {
  return item.data.dragonAttackToken === token
    && item.state === "held"
    && item.holder === holder
    && validEntity(holder)
    && holder.IsAlive?.()
    && holder.GetTeamNumber?.() === 3
    && !item.spent;
}

function resolveDragonSlayerHit(runtime, item, holder, downslash, token) {
  if (!dragonSlayerAttackStillValid(item, holder, token)) return;
  const definition = item.definition;
  const targets = allLivingPawns().filter((pawn) => validZombieTarget(pawn)
    && targetInForwardBox(
      holder,
      pawn,
      downslash ? definition.downslashHitLength : definition.swipeHitLength,
      downslash ? definition.downslashHitHalfWidth : definition.swipeHitHalfWidth,
      downslash ? definition.downslashHitMinZ : definition.swipeHitMinZ,
      downslash ? definition.downslashHitMaxZ : definition.swipeHitMaxZ,
      downslash ? definition.downslashHitMinAlong : definition.swipeHitMinAlong,
    ));
  const now = Instance.GetGameTime();
  const fireMultiplier = (item.data.fireUntil ?? 0) > now ? definition.fireDamageMultiplier : 1;
  const direction = directionWithPitchOffset(holder);
  hurtFinaleBossAt(add(holder.GetAbsOrigin?.() ?? item.position, mul(direction, 150)), downslash ? definition.bossDownslashRadius : definition.bossSwipeRadius, downslash ? definition.bossDownslashDamage : definition.bossSwipeDamage, downslash ? definition.bossDownslashStunChance : definition.bossSwipeStunChance, downslash ? definition.bossDownslashStunTimeAdd : definition.bossSwipeStunTimeAdd, holder, downslash ? "dragon_downslash" : "dragon_swipe");
  for (const pawn of targets) {
    damagePawn(
      pawn,
      (downslash ? definition.downslashDamage : definition.swipeDamage) * fireMultiplier,
      holder,
      item.carrier,
    );
    playSourceAudioStack(downslash ? [7009,7011] : [7009], add(pawn.GetAbsOrigin?.() ?? item.position, vec(0,0,40)));
    // Source 7000-7008: fx_limit 10 is checked before the increment, so eleven may overlap.
    if (reserveItemParticleBurst("dragonslayer", 11, 0.05)) {
      scheduleItemParticle(runtime, item, Math.random() * (downslash ? 0.03 : 0.20), (activeRuntime) => {
        if (!validEntity(pawn)) return;
        spawnItemParticle(activeRuntime, item, "blood_impact_headshot",
          add(pawn.GetAbsOrigin(), vec(0, 0, 40)), sourceItemImpactAngles(), 0.03);
      });
    }
    if (fireMultiplier > 1) fireTarget(pawn, "IgniteLifetime", String(definition.fireIgniteTime));
    item.data.bloodStack = (item.data.bloodStack ?? 0)
      + definition.bloodStackMin
      + Math.random() * (definition.bloodStackMax - definition.bloodStackMin);
    const targetVelocity = pawn.GetAbsVelocity?.() ?? vec();
    if (downslash) {
      pawn.Teleport({
        velocity: vec(
          direction.x * definition.hitVelocityXY,
          direction.y * definition.hitVelocityXY,
          targetVelocity.z > 10 ? 0 : definition.hitVelocityZ,
        ),
      });
      addPlayerStatus(runtime, pawn, itemEffectSource(runtime, item, "dragon_downslow"), definition.downslashSlowTime, {
        speedMultiplier: definition.downslashSlowAmount,
      });
    } else {
      pawn.Teleport({ velocity: vec(0, 0, Math.min(0, targetVelocity.z)) });
      addPlayerStatus(runtime, pawn, itemEffectSource(runtime, item, "dragon_swipeslow"), definition.hitSlowTime, {
        speedMultiplier: definition.hitSlowAmount,
      });
    }
  }
}

function applyDragonSlayerSelfDamage(runtime, item, holder, amount, token) {
  if (!dragonSlayerAttackStillValid(item, holder, token)) return;
  holder.SetHealth?.(Math.max(5, (holder.GetHealth?.() ?? 5) - amount));
}

function scheduleDragonSlayerScale(runtime, item, token, resetDelay) {
  const baseScale = item.definition.attachment?.scale ?? 1.8;
  const peakScale = 2.5;
  for (let step = 0; step < 7; step++) {
    scheduleItemTask(runtime, item, 0.14 + step * 0.01, () => {
      if (item.data.dragonAttackToken !== token || !validEntity(item.visual)) return;
      item.visual.SetModelScale?.(baseScale + step * 0.1);
    });
  }
  scheduleItemTask(runtime, item, 0.21, () => {
    if (item.data.dragonAttackToken === token && validEntity(item.visual)) item.visual.SetModelScale?.(peakScale);
  });
  for (let step = 0; step < 7; step++) {
    scheduleItemTask(runtime, item, 0.21 + resetDelay + step * 0.01, () => {
      if (item.data.dragonAttackToken !== token || !validEntity(item.visual)) return;
      item.visual.SetModelScale?.(peakScale - step * 0.1);
    });
  }
  scheduleItemTask(runtime, item, 0.28 + resetDelay, () => {
    if (item.data.dragonAttackToken === token && validEntity(item.visual)) item.visual.SetModelScale?.(baseScale);
  });
}

function useDragonSlayer(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const definition = item.definition;
  const health = holder.GetHealth?.() ?? 0;
  if (health <= 5) {
    const feedbackPosition = holder.GetAbsOrigin?.() ?? item.position;
    playSourceAudioCue(7065, feedbackPosition);
    playSourceAudioCue(7066, feedbackPosition);
    item.visual.SetModelScale?.(1.5);
    scheduleItemTask(runtime, item, 0.2, () => {
      if (validEntity(item.visual)) item.visual.SetModelScale?.(1.8);
    });
    return { success: true, consumeCharge: false, cooldown: 0.4 };
  }
  cancelItemTasks(runtime, item);
  const velocity = holder.GetAbsVelocity?.() ?? vec();
  const downslash = velocity.z < -definition.downslashVelocityThreshold;
  const cooldown = downslash ? 1 : 0.45;
  const token = (item.data.dragonAttackToken ?? 0) + 1;
  item.data.dragonAttackToken = token;
  const side = ((item.data.swing ?? 0) % 2) ? "R" : "L";
  item.data.swing = (item.data.swing ?? 0) + 1;
  const swingOrigin = holder.GetAbsOrigin?.() ?? item.position;
  playSourceAudioCue(7155, swingOrigin);
  const strikePosition = add(swingOrigin, mul(directionWithPitchOffset(holder), 200));
  playSourceAudioCue(7156, strikePosition);
  if ((item.data.fireUntil ?? 0) > now) playSourceAudioCue(7157, strikePosition);
  scheduleDragonSlayerScale(runtime, item, token, downslash ? 0.60 : 0.20);
  if (downslash) {
    playSourceAudioStack([7120,7121], strikePosition);
    // Source 7122-7128: the Process queue fires the impact burst after its 0.15 qrate.
    scheduleItemParticle(runtime, item, 0.15, (activeRuntime) => {
      if (!validEntity(holder)) return;
      const cast = crystalCastTransform(item, holder);
      spawnItemParticles(activeRuntime, item, ["explosion_child_distort01b", "explosion_child_distort01c",
        "explosion_hegrenade_brief", "copter_takeoff_1_dust_low"],
      add(add(cast.position, mul(cast.direction, 200)), vec(0, 0, -40)), undefined, 0.10);
    });
    fireTarget(item.visual, "SetAnimation", "swing_down");
    fireTarget(item.visual, "SetDefaultAnimation", "idle", 0.02);
    fireTarget(item.visual, "SetPlaybackRate", "0.01", 0.01);
    fireTarget(item.visual, "SetPlaybackRate", "0.01", 0.03);
    fireTarget(item.visual, "SetPlaybackRate", "0.5", 0.15);
    for (let elapsed = 0; elapsed < 0.15; elapsed += 0.01) {
      scheduleItemTask(runtime, item, elapsed, () => {
        if (!dragonSlayerAttackStillValid(item, holder, token)) return;
        const current = holder.GetAbsVelocity?.() ?? vec();
        if (current.z > -500) holder.Teleport?.({ velocity: vec(current.x, current.y, -500) });
      });
    }
    scheduleItemTask(runtime, item, definition.downslashHitDelay, (activeRuntime) => {
      resolveDragonSlayerHit(activeRuntime, item, holder, true, token);
    });
    scheduleItemTask(runtime, item, definition.downslashSelfDamageDelay, (activeRuntime) => {
      applyDragonSlayerSelfDamage(activeRuntime, item, holder, definition.downslashSelfDamage, token);
    });
    scheduleItemTask(runtime, item, 0, (activeRuntime) => {
      if (dragonSlayerAttackStillValid(item, holder, token)) {
        addPlayerStatus(activeRuntime, holder, itemEffectSource(activeRuntime, item, "dragon_selfslow"), definition.downslashSelfSlowTime, {
          speedMultiplier: definition.downslashSelfSlowAmount,
        });
      }
    });
  } else {
    fireTarget(item.visual, "SetAnimation", `swing_${side}`);
    fireTarget(item.visual, "SetPlaybackRate", "0.1", 0.01);
    fireTarget(item.visual, "SetPlaybackRate", "0.1", 0.03);
    fireTarget(item.visual, "SetPlaybackRate", "2.5", 0.20);
    scheduleItemTask(runtime, item, definition.swipeHitDelay, (activeRuntime) => {
      resolveDragonSlayerHit(activeRuntime, item, holder, false, token);
    });
    scheduleItemTask(runtime, item, 0.20, (activeRuntime) => {
      if (dragonSlayerAttackStillValid(item, holder, token)) {
        const current = holder.GetAbsVelocity?.() ?? vec();
        const lateral = leftOf(horizontalViewDirection(holder));
        const sign = side === "L" ? -1 : 1;
        holder.Teleport?.({
          velocity: vec(
            current.x + lateral.x * sign * 200,
            current.y + lateral.y * sign * 200,
            current.z,
          ),
        });
        addPlayerStatus(activeRuntime, holder, itemEffectSource(activeRuntime, item, "dragon_selfslow"), definition.selfSlowTime, {
          speedMultiplier: definition.selfSlowAmount,
        });
      }
    });
    scheduleItemTask(runtime, item, definition.swipeSelfDamageDelay, (activeRuntime) => {
      applyDragonSlayerSelfDamage(activeRuntime, item, holder, definition.swipeSelfDamage, token);
    });
    scheduleItemTask(runtime, item, 0.40, () => {
      if (dragonSlayerAttackStillValid(item, holder, token)) {
        fireTarget(item.visual, "SetAnimation", `idle_${side}`);
        fireTarget(item.visual, "SetDefaultAnimation", `idle_${side}`, 0.01);
      }
    });
  }
  scheduleItemTask(runtime, item, 5, () => {
    if (validEntity(item.visual) && item.state === "held") {
      fireTarget(item.visual, "SetAnimation", `reset_${side}`);
      fireTarget(item.visual, "SetDefaultAnimation", "idle", 0.01);
    }
  });
  return { success: true, consumeCharge: false, cooldown };
}

function tickDragonSlayer(runtime, item, holder) {
  if (item.state !== "held" || !validEntity(holder)) return;
  const definition = item.definition;
  const blood = Math.max(0, Math.min(4, Math.floor(item.data.bloodStack ?? 0)));
  if (blood <= 0) return;
  const velocity = holder.GetAbsVelocity?.() ?? vec();
  const cap = 250 * Math.max(0.1, 1 - blood * definition.bloodStackSlowMultiplier);
  const xy = Math.hypot(velocity.x, velocity.y);
  if (xy > cap) holder.Teleport({ velocity: vec(velocity.x * cap / xy, velocity.y * cap / xy, velocity.z) });
}

function useHackerman(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const controller = {
    id: state.nextItemEffectId++,
    kind: "hackerman",
    item,
    user: holder,
    position: clone(holder.GetAbsOrigin?.() ?? item.position),
    nextTickAt: now,
    expiresAt: now + 10,
    indicators: new Set(),
  };
  hurtFinaleBossAt(controller.position, item.definition.bossRadius, item.definition.bossDamage, item.definition.bossStunChance, item.definition.bossStunTimeAdd, holder, "hackerman");
  playSourceAudioCue(8330, add(controller.position, vec(0, 0, 50)));
  spawnItemParticle(runtime, item, "explosion_child_distort01b", sourceItemButtonPosition(item, holder), undefined, 0.05);
  for (const pawn of allLivingPawns()) {
    if (!validZombieTarget(pawn)) continue;
    const position = pawn.GetAbsOrigin?.();
    if (!position || Math.hypot(
      position.x - controller.position.x,
      position.y - controller.position.y,
      position.z - controller.position.z,
    ) > item.definition.targetRange) continue;
    const indicator = spawnItemEffectVisual(runtime, item, {
      template: "heal_orb",
      model: "models/luffaren/heal_orb.vmdl",
      position: add(position, vec(0, 0, 48)),
      scale: 0.45,
      color: { r: 200, g: 0, b: 0, a: 100 },
      glow: { r: 255, g: 0, b: 50, a: 255 },
    });
    indicator.SetParent?.(pawn);
    controller.indicators.add(indicator);
  }
  runtime.itemDeployables.add(controller);
  return true;
}

function spawnRiftSecondVisual(runtime, item) {
  // Source spawns both rift models at button origin +/-4 along the button's
  // left vector with the same angles; mirror the attached first model.
  const carrierAngles = bodyAngles(item.carrier) ?? { pitch: 0, yaw: 0, roll: 0 };
  const firstPosition = item.visual?.GetAbsOrigin?.();
  const firstAngles = item.visual?.GetAbsAngles?.();
  const left = leftFromAngles(carrierAngles);
  const offset = 2 * (item.visualAttachment?.left ?? 4);
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "rift",
    model: "models/luffaren/rift.vmdl",
    position: firstPosition ? add(firstPosition, mul(left, -offset)) : item.position,
    angles: firstAngles ?? carrierAngles,
  });
  visual.SetParent?.(item.carrier);
  item.auxiliaryVisuals.add(visual);
}

function cleanupRiftItem(runtime, item) {
  if (item.data.riftPair && !item.data.riftPair.complete) {
    if (runtime) cleanupDeployable(runtime, item.data.riftPair);
    item.data.riftPair = undefined;
  }
  // A completed portal pair outlives its used-up item and is removed by its
  // own deployable lifetime.
  const portals = new Set();
  for (const deployable of runtime?.itemDeployables ?? []) {
    if (deployable.kind === "rift" && deployable.item === item && deployable.complete) {
      portals.add(deployable.entryVisual);
      portals.add(deployable.exitVisual);
    }
  }
  for (const visual of portals) item.effects?.delete(visual);
  cleanupItemEffects(runtime, item);
}

function useHumanRift(runtime, item, holder, now) {
  if (holder.IsDucking?.() || holder.IsDucked?.()) return false;
  if (!item.data.riftPair) {
                                                                             
                                                                           
                                                                      
    const origin = holder.GetAbsOrigin?.();
    if (!origin) return false;
    const entry = add(origin, vec(0, 0, 3));
    const visual = spawnItemEffectVisual(runtime, item, {
      template: "rift",
      model: "models/luffaren/rift.vmdl",
      position: add(entry, vec(0, 0, 61)),
      scale: 1.5,
      glow: { r: 255, g: 255, b: 255, a: 255 },
    });
    const pair = {
      id: state.nextItemEffectId++,
      kind: "rift",
      item,
      entry,
      entryVisual: visual,
      exit: undefined,
      exitVisual: undefined,
      complete: false,
      touchCooldowns: new Map(),
      fallForgivenessTasks: new Set(),
      expiresAt: now + 100,
      removeAt: now + 200,
    };
    item.data.riftPair = pair;
    runtime.itemDeployables.add(pair);
    playSourceAudioCue(10805, add(entry, vec(0, 0, 61)));
    spawnItemParticle(runtime, item, "water_impact_bubbles_1", add(entry, vec(0, 0, 61)), undefined, 0.05);
    const firstAux = [...item.auxiliaryVisuals][0];
    if (validEntity(firstAux)) firstAux.Kill();
    return true;
  }
  const pair = item.data.riftPair;
  if (pair.complete) return false;
  const exit = placeOnGround(holder);
  if (!exit || Math.hypot(exit.x - pair.entry.x, exit.y - pair.entry.y, exit.z - pair.entry.z) < 60) return false;
  pair.exit = add(exit, vec(0, 0, 3));
  pair.exitVisual = spawnItemEffectVisual(runtime, item, {
    template: "rift",
    model: "models/luffaren/rift.vmdl",
    position: add(pair.exit, vec(0, 0, 61)),
    scale: 0.75,
    glow: { r: 255, g: 255, b: 255, a: 255 },
  });
  pair.complete = true;
  item.data.riftPair = undefined;
  playSourceAudioCue(10805, add(pair.exit, vec(0, 0, 61)));
  spawnItemParticle(runtime, item, "water_impact_bubbles_1", add(pair.exit, vec(0, 0, 61)), undefined, 0.05);
  return true;
}

function useZombieRift(runtime, item, holder, now) {
  const holderOrigin = holder.GetAbsOrigin?.();
  const holderEye = holder.GetEyePosition?.();
  const eyeHeight = holderOrigin && holderEye
    ? Math.hypot(
      holderEye.x - holderOrigin.x,
      holderEye.y - holderOrigin.y,
      holderEye.z - holderOrigin.z,
    )
    : undefined;
  if (
    (Number.isFinite(eyeHeight) && eyeHeight < 60)
    || (eyeHeight === undefined && (holder.IsDucking?.() || holder.IsDucked?.()))
  ) return false;
  if (!item.data.riftPair) {
                                                                       
                                                                               
    if (!placeOnGround(holder, 0, 40)) return false;
    const destination = add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 3));
    const visual = spawnItemEffectVisual(runtime, item, {
      template: "rift",
      model: "models/luffaren/rift.vmdl",
      position: add(destination, vec(0, 0, 61)),
      scale: 1.5,
      glow: { r: 255, g: 160, b: 32, a: 255 },
    });
    spawnItemParticle(runtime, item, "water_impact_bubbles_1", add(destination, vec(0, 0, 61)), undefined, 0.05);
    const pair = {
      id: state.nextItemEffectId++,
      kind: "rift_z",
      item,
      destination,
      exitVisual: visual,
      entry: undefined,
      entryVisual: undefined,
      complete: false,
      touchCooldowns: new Map(),
      lastPositions: new Map(),
      mustExitBeforeTouch: new Set(),
      activeAt: undefined,
      expiresAt: now + item.definition.activeTime,
      removeAt: now + item.definition.timeout,
    };
    item.data.riftPair = pair;
    runtime.itemDeployables.add(pair);
    return true;
  }

  const pair = item.data.riftPair;
  if (pair.complete) return false;
  const entry = add(holder.GetAbsOrigin?.() ?? item.position, vec(0, 0, 3));
  if (Math.hypot(
    entry.x - pair.destination.x,
    entry.y - pair.destination.y,
    entry.z - pair.destination.z,
  ) < item.definition.minimumSeparation) return false;
  pair.entry = entry;
  pair.entryVisual = spawnItemEffectVisual(runtime, item, {
    template: "rift",
    model: "models/luffaren/rift.vmdl",
    position: add(entry, vec(0, 0, 61)),
    scale: 9,
    glow: { r: 255, g: 0, b: 180, a: 255 },
  });
  spawnItemParticle(runtime, item, "water_impact_bubbles_1", add(entry, vec(0, 0, 61)), undefined, 0.05);
  pair.complete = true;
                                                                            
                                                                           
                                                                              
  pair.activeAt = now + item.definition.portalArmDelay;
  item.data.riftPair = undefined;
  return true;
}

function livingHumanCount() {
  return allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3).length;
}

function humanTeamCount() {
  return allPlayerPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3).length;
}

function useFlight(runtime, item, holder, now) {
  if (state.adminSlayActive || state.flightSlayEnabled) return false;
  if (item.data.flightActive) return false;
  item.spent = true;
  item.data.flightActive = true;
  item.data.flightVelocity = vec(0, 0, 300);
  item.data.flightLastAt = now;
  item.data.flightHealthCap =
    item.definition.healthBase + item.definition.healthPerHuman * livingHumanCount();
  item.data.flightNextHealthCapAt = now + item.definition.healthCapInterval;
  fireTarget(item.visual, "SetAnimation", "flap");
  fireTarget(item.visual, "SetDefaultAnimation", "flap");
  fireTarget(item.visual, "SetPlaybackRate", "2");
  const flightSounds = spawnItemSoundTemplate(
    runtime,
    item,
    "item_flight_sound",
    holder.GetAbsOrigin?.() ?? item.position,
    ["wing"],
  );
  item.data.flightSound = flightSounds.get("wing");
  item.data.nextFlightSoundAt = now + item.definition.flapSoundFirstDelay;
  holder.Teleport?.({ velocity: clone(item.data.flightVelocity) });
  return { success: true, deferConsume: true };
}

function stopFlight(runtime, item) {
  if (!item?.data) return;
  const sound = item.data.flightSound;
  if (validEntity(sound)) {
    fireTarget(sound, "StopSound", "");
    fireTarget(sound, "Volume", "0");
    sound.Kill();
  }
  runtime?.entities?.delete(sound);
  item.data.flightSound = undefined;
  item.data.nextFlightSoundAt = undefined;
  item.data.flightActive = false;
  item.data.flightVelocity = undefined;
  item.data.flightLastAt = undefined;
  item.data.flightHealthCap = undefined;
  item.data.flightNextHealthCapAt = undefined;
}

function tickFlight(runtime, item, holder, now) {
  if (!item.data.flightActive) return;
  const definition = item.definition;
  const dt = Math.min(0.15, Math.max(0.01, now - (item.data.flightLastAt ?? now - CONFIG.itemTickInterval)));
  item.data.flightLastAt = now;
  if (validEntity(item.data.flightSound)) {
    item.data.flightSound.Teleport?.({ position: holder.GetAbsOrigin?.() ?? item.position });
    if (now >= (item.data.nextFlightSoundAt ?? Infinity)) {
      playItemSound(item.data.flightSound);
      item.data.nextFlightSoundAt = now + definition.flapSoundInterval;
    }
  }

  if (now >= (item.data.flightNextHealthCapAt ?? 0)) {
    item.data.flightHealthCap =
      definition.healthBase + definition.healthPerHuman * livingHumanCount();
    item.data.flightNextHealthCapAt = now + definition.healthCapInterval;
  }
  const cap = item.data.flightHealthCap
    ?? definition.healthBase + definition.healthPerHuman * livingHumanCount();
  const health = holder.GetHealth?.();
  if (Number.isFinite(health) && health > cap) holder.SetHealth?.(cap);

  const eyeForward = forwardVector(holder, true);
  const horizontalLength = Math.hypot(eyeForward.x, eyeForward.y);
  const flatForward = horizontalLength > 0.001
    ? vec(eyeForward.x / horizontalLength, eyeForward.y / horizontalLength, 0)
    : vec(1, 0, 0);
  const right = rightOf(flatForward);
  let wish = vec();
  if (holder.IsInputPressed?.(CSInputs.FORWARD)) wish = add(wish, eyeForward);
  if (holder.IsInputPressed?.(CSInputs.BACK)) wish = sub(wish, eyeForward);
  if (holder.IsInputPressed?.(CSInputs.RIGHT)) wish = add(wish, right);
  if (holder.IsInputPressed?.(CSInputs.LEFT)) wish = sub(wish, right);
  if (holder.IsInputPressed?.(CSInputs.JUMP)) wish.z += 1;
  if (holder.IsInputPressed?.(CSInputs.DUCK)) wish.z -= 1;
  const wishLength = Math.hypot(wish.x, wish.y, wish.z);
  if (wishLength > 0.001) wish = mul(wish, 1 / wishLength);

  let velocity = item.data.flightVelocity ?? vec();
  velocity = add(
    mul(velocity, Math.pow(definition.drag, dt / definition.dragReferenceInterval)),
    mul(wish, definition.acceleration * dt),
  );
  const speed = Math.hypot(velocity.x, velocity.y, velocity.z);
  if (speed > definition.velocityCap) velocity = mul(velocity, definition.velocityCap / speed);
  item.data.flightVelocity = velocity;

  const origin = holder.GetAbsOrigin?.() ?? item.position;
  const predictedPosition = add(origin, mul(velocity, dt));
  const current = state.currentLevel;
  const safeDistance = current?.endProvider === "button"
    ? definition.endButtonSafeDistance
    : definition.endSafeDistance;
  if (current && !current.completed && Math.hypot(
    predictedPosition.x - current.end.x,
    predictedPosition.y - current.end.y,
    predictedPosition.z - current.end.z,
  ) <= safeDistance) {
    item.data.flightVelocity = vec();
    holder.Teleport?.({ position: clone(current.tp), velocity: vec() });
    return;
  }
                                                                          
                                                                           
                                                                              
                                                                              
                                                                         
  const collision = traceFlightHullWorld(origin, predictedPosition, holder);
  if (collision?.didHit) {
    let safeVelocity = item.data.flightVelocity;
    const normal = collision.normal;
    if (normal && Number.isFinite(normal.x) && Number.isFinite(normal.y) && Number.isFinite(normal.z)) {
      const normalSpeed = safeVelocity.x * normal.x
        + safeVelocity.y * normal.y
        + safeVelocity.z * normal.z;
      if (normalSpeed < 0) safeVelocity = sub(safeVelocity, mul(normal, normalSpeed));
    } else {
      safeVelocity = vec();
    }
    item.data.flightVelocity = safeVelocity;
    const offset = normal && Number.isFinite(normal.x) && Number.isFinite(normal.y) && Number.isFinite(normal.z)
      ? mul(normal, 1)
      : vec();
    holder.Teleport?.({
      position: add(collision.position, offset),
      velocity: clone(safeVelocity),
    });
    return;
  }
                                                                              
                                                                 
  holder.Teleport?.({ velocity: clone(item.data.flightVelocity) });
}

function spawnImpostorIllusion(runtime, item, target, now) {
  const model = item.definition.illusionModel ?? target.GetModelName?.();
  if (!model) return;
  const origin = add(target.GetAbsOrigin?.() ?? item.position, vec(0, 0, 15));
  const yaw = (target.GetAbsAngles?.().yaw ?? 0) + Math.random() * 60 - 30;
  const radians = yaw * Math.PI / 180;
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "impostor",
    model,
    position: origin,
    angles: { pitch: 0, yaw, roll: 0 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "impostor_illusion",
    item,
    visual,
    position: clone(origin),
    velocity: vec(Math.cos(radians) * 180, Math.sin(radians) * 180, 180),
    lastAt: now,
    expiresAt: now + item.definition.illusionLifetime,
  });
}

function useImpostor(runtime, item, holder, now) {
                                                                             
                                                                             
                                                                           
  if (Number(now) < (state.finalePostImpostorUntil ?? 0)) return false;
                                                                               
                                                                
  if (activeImpostorController(holder)) return false;
  const humans = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 3);
                                                                             
                                                                        
  if (humans.length === 0) return true;
  const target = humans[Math.floor(Math.random() * humans.length)];
  const targetPosition = target.GetAbsOrigin?.();
  if (!targetPosition) return false;

  item.spent = true;
  const originalModel = holder.GetModelName?.();
  const humanModel = item.definition.forceModel ?? target.GetModelName?.();
  if (humanModel) holder.SetModel?.(humanModel);
  playSourceAudioStack([9842, 9843], add(targetPosition, vec(0, 0, 48)));
  holder.Teleport?.({
    position: add(targetPosition, vec(0, 0, 1)),
    angles: {
      pitch: 0,
      yaw: target.GetAbsAngles?.().yaw ?? 0,
      roll: 0,
    },
    velocity: target.GetAbsVelocity?.() ?? vec(),
  });
  // Source TpUserPost runs 0.03 s after TpUser and skips a dead/cured user.
  scheduleItemParticle(runtime, item, 0.03, (activeRuntime) => {
    if (!validEntity(holder) || !holder.IsAlive?.() || holder.GetTeamNumber?.() !== 2) return;
    spawnItemParticle(activeRuntime, item, "explosion_child_distort01b",
      add(holder.GetAbsOrigin(), vec(0, 0, 32)), undefined, 0.10);
  });
  const hiddenSource = `${runtime.index}:item:${item.id}:impostor:hidden`;
  addPlayerStatus(
    runtime,
    holder,
    `${hiddenSource}:invincible`,
    item.definition.invincibleTime,
    { blockedAttackerTeam: 3 },
  );
  for (let index = 0; index < item.definition.illusionAmount; index++) {
    spawnImpostorIllusion(runtime, item, humans[Math.floor(Math.random() * humans.length)], now);
  }
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "impostor",
    item,
    user: holder,
    originalModel,
    hiddenSource,
    hidden: true,
    revealAt: now + item.definition.hiddenTime,
    healthCap: undefined,
    nextHealthCapAt: now + item.definition.healthCapInterval,
  });
  Instance.ServerCommand("sv_disable_radar 1");
  return true;
}

function terrainNearEndpoint(runtime, position) {
  return [runtime.entry, runtime.end].some((endpoint) => endpoint && Math.hypot(
    position.x - endpoint.x,
    position.y - endpoint.y,
    position.z - endpoint.z,
  ) <= CONFIG.gridSize * 0.8);
}

function breakTerrainForHammer(itemRuntime, item, center, now) {
  for (const runtime of activeRuntimes()) {
    runtime.brokenTerrain ??= new Set();
    for (const entity of runtime.entities ?? []) {
      if (!validEntity(entity) || runtime.brokenTerrain.has(entity)) continue;
      const name = entity.GetEntityName?.() ?? "";
      if (!name.startsWith(`block_${runtime.index}_`)) continue;
      const position = entity.GetAbsOrigin?.();
      if (!position || terrainNearEndpoint(runtime, position)) continue;
      if (Math.hypot(position.x - center.x, position.y - center.y) > item.definition.tileRadius) continue;
      if (Math.abs(position.z - center.z) > item.definition.tileZRadius) continue;
      runtime.brokenTerrain.add(entity);
      entity.SetColor?.({ r: 255, g: 50, b: 50, a: 255 });
      // Owned by the tile's level: recycling the item's level must not strand
      // a red, unbreakable tile.
      schedule(item.definition.tileFallTime - 1.5, () => {
        if (validEntity(entity)) entity.Teleport?.({ position: add(position, vec(0, 0, -16)) });
      }, runtime.index);
      schedule(item.definition.tileFallTime, () => {
                                                                             
                                                                           
                                                   
        if (validEntity(entity)) entity.Kill();
        runtime.entities.delete(entity);
      }, runtime.index);
      itemRuntime.itemDeployables.add({
        id: state.nextItemEffectId++,
        kind: "destructo_slow",
        item,
        position: clone(position),
        touched: new Set(),
        activeAt: now + item.definition.tileFallTime,
        expiresAt: now + item.definition.tileFallTime + item.definition.slowCleanupTime,
      });
    }
  }
}

function destroyHumanItemsForHammer(center, item) {
  for (const runtime of activeRuntimes()) {
    for (const humanItem of [...runtime.items ?? []]) {
      if (humanItem.definition.team !== 3 || humanItem.state === "consumed") continue;
      const position = humanItem.holder?.GetAbsOrigin?.()
        ?? humanItem.carrier?.GetAbsOrigin?.()
        ?? humanItem.position;
      const radius = humanItem.state === "held"
        ? item.definition.heldItemRadius
        : item.definition.placedItemRadius;
      if (position && Math.hypot(position.x - center.x, position.y - center.y, position.z - center.z) <= radius) {
        consumeItem(runtime, humanItem);
      }
    }
    for (const deployable of [...runtime.itemDeployables ?? []]) {
      const position = deployable.position ?? deployable.entry ?? deployable.visual?.GetAbsOrigin?.();
      if (!position) continue;
      const distance = Math.hypot(position.x - center.x, position.y - center.y, position.z - center.z);
      if (deployable.kind === "storm_blade" && distance <= item.definition.stormBladeRadius) {
        deployable.released = true;
        playSourceAudioStack([11126,11127,11128], position);
        cleanupDeployable(runtime, deployable);
      } else if (
        ["peanutbutter", "claymore", "planet_earth", "billnye"].includes(deployable.kind)
        && distance <= item.definition.placedItemRadius
      ) cleanupDeployable(runtime, deployable);
    }
  }
}

function useDestructoHammer(runtime, item, holder, now) {
  const origin = holder.GetAbsOrigin?.();
  if (!origin) return false;
                                                                            
                                                                            
                                                 
  const tileCenter = add(origin, mul(horizontalViewDirection(holder), 96));
  const explosionCenter = add(tileCenter, vec(0, 0, -10));
  const itemCenter = add(tileCenter, vec(0, 0, -40));
  playSourceAudioStack([11368, 11369, 11370, 11371], explosionCenter);
  spawnItemParticles(runtime, item, ["explosion_child_distort01b", "explosion_child_distort01c",
    "explosion_coop_mission_shrapnel02e_1k", "storm_lightning_01"], explosionCenter, undefined, 0.10);
  fireTarget(item.visual, "SetAnimation", "smash");
  fireTarget(item.visual, "SetDefaultAnimation", item.definition.idleAnimation, 0.02);
                                                                            
                                                                    
  scheduleItemTask(runtime, item, 1, () => {
    if (!validEntity(item.visual)) return;
    item.visual.SetModelScale?.(0.5);
    item.visual.SetColor?.({ r: 50, g: 50, b: 50, a: 255 });
  });
  breakTerrainForHammer(runtime, item, tileCenter, now);
  destroyHumanItemsForHammer(itemCenter, item);
  for (const pawn of nearbyPawns(explosionCenter, item.definition.explosionRadius)) {
    const position = pawn.GetAbsOrigin?.() ?? explosionCenter;
    const distance = Math.hypot(
      position.x - explosionCenter.x,
      position.y - explosionCenter.y,
      position.z - explosionCenter.z,
    );
    const scale = Math.max(0, 1 - distance / item.definition.explosionRadius);
                                                                         
                                                                           
                                                 
    damagePawn(pawn, item.definition.magnitude * scale, undefined, undefined, CSDamageTypes.GENERIC);
    pushPawn(
      pawn,
      directionBetween(explosionCenter, position),
      item.definition.magnitude * 2 * scale,
      180 * scale,
    );
  }
  return true;
}

function useStormBlade(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const position = clone(item.carrier?.GetAbsOrigin?.() ?? holder.GetAbsOrigin?.());
  hurtFinaleBossAt(add(position, vec(0, 0, 100)), item.definition.bossRadius, item.definition.bossDamage, item.definition.bossStunChance, item.definition.bossStunTimeAdd, holder, "storm_blade");
                                                                             
  const sounds = new Set(), borrowedSounds = new Set();
  for (let i = 0; i < 3; i++) {
    const record = spawnSourceAudio("i_am_the_storm_cut", position,
      { radius:100000, lifetime:8, pitch:100, volume:10 });
    if (record) { record.expiresAt = now + 8; sounds.add(record.sound); }
  }
  const frozen = new Set();
  const pieces = new Set();
  const pieceStates = new Map();
  for (let index = 0; index < 25; index++) {
    const pieceScale = 5 + Math.random() * 25;
    const burstDirection = vec(
      Math.random() * 2 - 1,
      Math.random() * 2 - 1,
      Math.random() * 2 - 1,
    );
    const directionLength = Math.hypot(burstDirection.x, burstDirection.y, burstDirection.z) || 1;
    const burstDistance = 120 + Math.random() * 280;
    const burstTarget = add(position, mul(burstDirection, burstDistance / directionLength));
    const pieceAngles = {
      pitch: Math.random() * 360,
      yaw: Math.random() * 360,
      roll: Math.random() * 360,
    };
    const piece = spawnDedicatedItemVisual(runtime, {
      position,
      angles: pieceAngles,
      feature: `item_effect_${item.id}_storm_blade_refract`,
    }, "storm_blade_refract", `item_effect_${item.id}`);
    // Source ParticleRun(false) when each shard spawns.
    if (Math.floor(Math.random() * 8) === 0)
      spawnItemParticle(runtime, item, "storm_lightning_01", position, undefined, 0.05);
    piece.SetModelScale?.(pieceScale);
    piece.Glow?.({ r: 60, g: 190, b: 255, a: 255 });
    item.effects.add(piece);
    fireTarget(piece, "SetAnimation", `move_${1 + Math.floor(Math.random() * 5)}`);
    fireTarget(piece, "SetPlaybackRate", String(1 + Math.random() * 9), 0.02);
    pieces.add(piece);
    pieceStates.set(piece, {
      position: clone(position),
      angles: pieceAngles,
      burstStart: clone(position),
      burstTarget,
      burstStartAngles: { ...pieceAngles },
      burstTargetAngles: {
        pitch: pieceAngles.pitch + Math.random() * 360 - 180,
        yaw: pieceAngles.yaw + Math.random() * 360 - 180,
        roll: pieceAngles.roll + Math.random() * 360 - 180,
      },
      burstStartAt: now,
      burstEndAt: now + 0.35 + Math.random() * 0.3,
      glowOffAt: now + 0.1 + Math.random() * 0.7,
      killAt: now + 7.1 + 0.1 + Math.random() * 4.9,
      ending: false,
    });
  }
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "storm_blade",
    item,
    position,
    frozen,
    pieces,
    pieceStates,
    sounds,
    borrowedSounds,
    activeAt: now + 0.1,
    freezeAt: now + 0.9,
    started: false,
    endsAt: now + 7.1,
                                                                            
                                                                             
                                                                          
                                                                       
                                     
    soundStopAt: now + 8.0,
    removeAt: now + 12.2,
  });
  const hiltPosition = sourceItemModelPosition(item, holder);
  spawnItemParticle(runtime, item, "env_sparks_omni", hiltPosition, undefined, 0.05);
  for (let index = 0; index < 3; index++) {
    spawnItemParticle(runtime, item, "weapon_sensorgren_spark_02",
      add(hiltPosition, vec(0, 0, Math.random() * 7 - 5)), undefined, 0.05);
  }
  scheduleItemTask(runtime, item, 7, (activeRuntime) => {
    if (!validEntity(item.visual)) return;
    const closePosition = add(item.visual.GetAbsOrigin(), vec(0, 0, -2));
    spawnItemParticles(activeRuntime, item, ["env_sparks_omni", "weapon_sensorgren_spark_02",
      "weapon_sensorgren_spark_02", "weapon_sensorgren_spark_02", "weapon_sensorgren_spark_02"],
    closePosition, undefined, 0.05);
  });
  fireTarget(item.visual, "SetAnimation", "use");
  fireTarget(item.visual, "SetDefaultAnimation", "idle", 0.02);
  fireTarget(item.visual, "SetPlaybackRate", "0.20", 0.01);
  item.visual?.SetColor?.({ r: 50, g: 50, b: 50, a: 255 });
  item.visual?.Unglow?.();
  return true;
}

function planetTargets(position, radius) {
  return allLivingPawns().filter((pawn) => {
    if (!validZombieTarget(pawn)) return false;
    const target = pawn.GetAbsOrigin?.();
    return target && Math.hypot(target.x - position.x, target.y - position.y, target.z - position.z) <= radius;
  });
}

function advancePlanetCombo(runtime, item, variant, position, now) {
  const order = ["earth", "fire", "wind", "water"];
  let combo = state.planetCombo;
  if (variant === "earth") {
    state.planetCombo = { owner: runtime.index, step: 1, position: clone(position), expiresAt: now + 7 };
    return;
  }
  if (!combo || combo.expiresAt <= now || order[combo.step] !== variant) {
    state.planetCombo = undefined;
    return;
  }
  if (Math.hypot(position.x - combo.position.x, position.y - combo.position.y, position.z - combo.position.z) > 1500) {
    state.planetCombo = undefined;
    return;
  }
  combo.step++;
  combo.expiresAt = now + 7;
  if (combo.step < order.length) return;
  const visual = spawnItemEffectVisual(runtime, item, {
    template: "planetcrystal",
    model: "models/luffaren/captain_planet.vmdl",
    position: clone(combo.position),
    angles: { pitch: 0, yaw: Math.random() * 360, roll: 0 },
    glow: { r: 20, g: 60, b: 100, a: 255 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "captain_planet",
    item,
    visual,
    position: clone(combo.position),
    startsAt: now + 6,
    stopsAt: now + 24,
    buffAt: now + 26.15,
    removeAt: now + 27.5,
    nextTickAt: now + 6,
    buffed: false,
  });
  playSourceAudioStack([10475, 10477, 10477], combo.position);
  // Source ShowTheCaptain at +0.82 s, around the captain's spawn origin.
  const captainShowPosition = add(combo.position, vec(0, 0, 50));
  scheduleItemParticle(runtime, item, 0.82, (activeRuntime) => {
    spawnItemParticles(activeRuntime, item, ["weapon_sensorgren_detonate", "aztec_copter_takeoff_grass",
      "storm_lightning_01_modglow", "explosion_child_distort01b", "explosion_child_distort01c"],
    captainShowPosition, undefined, 0.10);
  });
  state.planetCombo = undefined;
  announce("Captain Planet combo completed");
}

function spawnPlanetCrystalEffect(runtime, item, controller, position, angles, type, now) {
  const definition = item.definition;
  const interval = type === 1 ? 0.07 : 0.02;
  const baseAlpha = type === 1 ? 100 : 50;
  let longestFade = 0;
                                                                          
                                                                          
                                                            
  for (let index = 0; index < 5; index++) {
    const alpha = Math.max(0, Math.min(255, baseAlpha + Math.floor(Math.random() * 71) - 20));
    const visualAngles = {
      pitch: angles.pitch + (Math.random() * 25 - 20),
      yaw: angles.yaw + (Math.random() * 20 - 10),
      roll: angles.roll + Math.random() * 360,
    };
    const visual = spawnItemEffectVisual(runtime, item, {
      template: "planetcrystal",
      model: definition.effectModel,
      position,
      angles: visualAngles,
      scale: 1 + Math.random(),
      color: { r: 255, g: 255, b: 255, a: alpha },
      glow: { r: 20, g: 20, b: 20, a: 255 },
    });
    const forward = forwardFromAngles(visualAngles);
                                                                                
                                                                              
                                                               
    visual.Teleport?.({ position, angles: visualAngles, velocity: vec() });
                                                                            
                                                                              
                                                                  
    const applyBodyGroup = () => {
      if (!validEntity(visual)) return;
      fireTarget(visual, "SetBodyGroup", `main,${type}`);
    };
    applyBodyGroup();
    afterThink(applyBodyGroup);
    controller.visuals.add(visual);
    let fadeAlpha = alpha;
    let step = 0;
    while (fadeAlpha > 0) {
      const fadeAt = 0.01 + step * interval;
      const nextAlpha = Math.max(0, fadeAlpha - (2 + Math.floor(Math.random() * 4)));
      scheduleItemTask(runtime, item, fadeAt, () => {
        if (!validEntity(visual)) return;
        const current = visual.GetAbsOrigin?.() ?? position;
        const drift = add(
          vec(Math.random() * 10 - 5, Math.random() * 10 - 5, Math.random() * 10 - 5),
          mul(forward, Math.random() * 40 - 10),
        );
        visual.Teleport?.({
          position: add(current, drift),
          angles: visualAngles,
          velocity: vec(),
        });
        visual.SetColor?.({ r: 255, g: 255, b: 255, a: nextAlpha });
      });
      fadeAlpha = nextAlpha;
      step++;
    }
    const killAt = 0.01 + step * interval;
    longestFade = Math.max(longestFade, killAt);
    scheduleItemTask(runtime, item, killAt, (activeRuntime) => {
      controller.visuals.delete(visual);
      item.effects.delete(visual);
      if (validEntity(visual)) visual.Kill();
      activeRuntime.entities.delete(visual);
    });
  }
  controller.expiresAt = Math.max(controller.expiresAt, now + longestFade + 0.05);
}

function crystalCastTransform(item, holder) {
  const angles = viewAngles(holder) ?? { pitch: 0, yaw: 0, roll: 0 };
                                                                             
                                                                              
  const position = item.measureReference?.GetAbsOrigin?.()
    ?? add(holder.GetAbsOrigin?.() ?? item.position,
      add(mul(forwardFromAngles(angles), SOURCE_ITEM_BUTTON_ANCHOR.forward),
        mul(upFromAngles(angles), SOURCE_ITEM_BUTTON_ANCHOR.up)));
  return { position: clone(position), angles: { ...angles }, direction: forwardFromAngles(angles) };
}

function crystalNativeEntity(runtime, controller, key, position, angles, classname) {
  const spawned = spawnRoundEntities(featureTemplate(key), position, angles) ?? [];
  const entity = spawned.find(e => validEntity(e) && (classname
    ? e.GetClassName?.() === classname
    : String(e.GetClassName?.() ?? "").startsWith("prop_dynamic")));
  if (!entity || spawned.length !== 1) {
    for (const e of spawned) if (validEntity(e)) e.Kill();
    throw new Error(`crystal: '${key}' did not spawn one native prototype`);
  }
  runtime.entities.add(entity);
  entity.SetEntityName?.(`crystal_${controller.id}_${key}_${runtime.entities.size}`);
  controller.nativeEntities.add(entity);
  return entity;
}

function crystalConnect(runtime, controller, entity, output, callback) {
  const id = connectOwnedOutput(runtime, entity, output, callback);
  if (id !== undefined && id !== null) controller.nativeConnections.add(id);
}

function cleanupEarthCrystalPiece(runtime, controller, piece) {
  if (piece.cleaned) return;
  piece.cleaned = true;
  for (const entity of [piece.trigger, piece.wall]) {
    if (!validEntity(entity)) continue;
    entity.Kill(); runtime.entities.delete(entity); controller.nativeEntities.delete(entity);
    state.silentHillWorld.visuals.delete(entity);
  }
}

function spawnEarthCrystalPieces(runtime, controller, angles) {
  const theme = stageSnapshotForRuntime(runtime).theme;
  controller.earthPieces = [];
  controller.nextTickAt = Instance.GetGameTime();
  for (let index = 0; index < 4; index++) {
    const side1 = index % 2 === 0;
    const position = add(controller.position, vec(0, 0, index >= 2 ? 96 : 0));
    const pieceAngles = { pitch: 90, yaw: angles.yaw + (side1 ? -90 : 90), roll: 0 };
    const trigger = crystalNativeEntity(runtime, controller,
      side1 ? "crystalEarthLeft" : "crystalEarthRight", position, pieceAngles, "trigger_multiple");
    const piece = { trigger, position, angles: pieceAngles, postchecked: false, occupied: false, cleaned: false };
    controller.earthPieces.push(piece);
    crystalConnect(runtime, controller, trigger, "OnStartTouch", ({ activator }) => {
      const pawn = resolvePawn(activator);
      if (!pawn?.IsAlive?.() || pawn.GetTeamNumber?.() !== 3 || piece.cleaned) return;
      if (!piece.postchecked) piece.occupied = true;
      else cleanupEarthCrystalPiece(runtime, controller, piece);
    });
    fireTarget(trigger, "Enable", "", 0.01);
    fireTarget(trigger, "Disable", "", 0.02);
    schedule(0.03, () => {
      if (piece.cleaned || !validEntity(trigger) || !runtime.itemDeployables.has(controller)) return;
      piece.postchecked = true;
      if (piece.occupied) { cleanupEarthCrystalPiece(runtime, controller, piece); return; }
      const wall = crystalNativeEntity(runtime, controller, "crystalEarthWall", position, pieceAngles);
      const model = chooseTerrainModel(theme, "breakable");
      wall.SetModel(rememberSilentHillVisual(runtime, wall, model, { themeName: theme }));
                                                                             
                                                                            
      wall.Teleport?.({ position, angles: pieceAngles, velocity: vec() });
      applyTerrainAppearance(wall, 1);
      piece.wall = wall;
      fireTarget(trigger, "Enable", "", 0.1);
    }, runtime.index);
  }
}

function spawnElementCrystalTrigger(runtime, controller, holder, angles) {
  const wind = controller.kind === "planet_wind";
  const trigger = crystalNativeEntity(runtime, controller, wind ? "crystalWind" : "crystalTouch",
    controller.position, angles, wind ? "trigger_push" : "trigger_multiple");
  const definition = controller.item.definition;
  if (wind) {
    fireTarget(trigger, "SetPushDirection", `${angles.pitch} ${angles.yaw} ${angles.roll}`);
    fireTarget(trigger, "SetPushSpeed", String(definition.windPushSpeed));
    crystalConnect(runtime, controller, trigger, "OnEndTouch", ({ activator }) => {
      const pawn = resolvePawn(activator);
      for (const delay of [0, 0.05, 0.1, 0.2, 0.5]) schedule(delay, () => {
        if (validZombieTarget(pawn)) pawn.Teleport({ velocity: vec() });
      }, runtime.index);
    });
    fireTarget(trigger, "Enable", "", 0.02);
    fireTarget(trigger, "Disable", "", definition.windLifetime);
  } else {
    crystalConnect(runtime, controller, trigger, "OnStartTouch", ({ activator }) => {
      const pawn = resolvePawn(activator);
      if (!validZombieTarget(pawn)) return;
      if (controller.kind === "planet_fire") {
        fireTarget(pawn, "IgniteLifetime", String(definition.fireIgniteTime));
        damagePawn(pawn, definition.fireDamage, holder, trigger);
        addPlayerStatus(runtime, pawn, controller.source, definition.fireSlowTime,
          { speedMultiplier: definition.fireSlowAmount });
      } else addPlayerStatus(runtime, pawn, controller.source, 10, { speedMultiplier: -0.85 });
      if (pawn.IsAlive?.()) pawn.Teleport({ velocity: vec() });
    });
    fireTarget(trigger, "Enable", "", 0.05);
  }
                                                                             
  schedule(wind ? definition.windLifetime + 0.05 : 0.2, () => {
    if (validEntity(trigger)) trigger.Kill();
    runtime.entities.delete(trigger); controller.nativeEntities.delete(trigger);
  }, runtime.index);
}

function usePlanetCrystal(runtime, item, holder, now) {
  if (!infectionHasStarted()) return false;
  const definition = item.definition;
  const variant = item.variant ?? nextPlanetCrystalVariant();
  const cast = crystalCastTransform(item, holder);
  const origin = cast.position;
                                                                            
                                                                             
                                                                          
  const direction = cast.direction;
  const position = variant === "earth"
    ? add(origin, mul(direction, definition.earthForwardDistance))
    : clone(origin);
                                                                             
                                                                            
                                                                          
  const effectAngles = cast.angles;
  const effectPosition = clone(origin);
  const source = itemEffectSource(runtime, item, `planet_${variant}`);
  const controller = {
    id: state.nextItemEffectId++,
    kind: `planet_${variant}`,
    item,
    source,
    position: clone(position),
    direction: clone(direction),
    visuals: new Set(),
    nativeEntities: new Set(),
    nativeConnections: new Set(),
    nextTickAt: now,
    expiresAt: now + (
      variant === "earth"
        ? 12
        : variant === "wind"
          ? definition.windLifetime + 0.05
      : definition.effectLifetime
    ),
  };
  const bossSuffix = `${variant}Boss`;
  const bossHitPosition = variant === "earth"
    ? add(position, vec(0, 0, 100))
    : variant === "fire"
      ? add(effectPosition, add(mul(direction, 300), vec(0, 0, 100)))
      : add(effectPosition, vec(0, 0, 100));
  hurtFinaleBossAt(bossHitPosition, definition[`${bossSuffix}Radius`], definition[`${bossSuffix}Damage`], definition[`${bossSuffix}StunChance`], definition[`${bossSuffix}StunTimeAdd`], holder, `planet_${variant}`);
  playCatalogSound(`cplanet_${variant}`, effectPosition);
  const elementCues = { earth: [10164,10165,10166], fire: [10223,10224],
    wind: [10300,10301], water: [10368,10369,10370] };
  playSourceAudioStack(elementCues[variant] ?? [], effectPosition);
  spawnItemParticle(runtime, item, "weapon_taser_flash", sourceItemModelPosition(item, holder), undefined, 0.10);

  if (variant !== "earth") {
    const effectType = variant === "fire" ? 0 : variant === "wind" ? 1 : 2;
                                                                               
                                                                               
                                                                            
    spawnPlanetCrystalEffect(
      runtime,
      item,
      controller,
      effectPosition,
      effectAngles,
      effectType,
      now,
    );
  }

  if (variant === "earth") {
    spawnEarthCrystalPieces(runtime, controller, effectAngles);
  } else if (variant === "fire") {
    spawnElementCrystalTrigger(runtime, controller, holder, effectAngles);
    const synergyCenter = add(origin, mul(direction, definition.synergyForwardDistance));
    for (const level of state.levels.values()) {
      for (const other of level.items ?? []) {
        const otherPosition = other.carrier?.GetAbsOrigin?.() ?? other.position;
        if (other.name !== "dragonslayer" || !otherPosition || Math.hypot(
          otherPosition.x - synergyCenter.x,
          otherPosition.y - synergyCenter.y,
          otherPosition.z - synergyCenter.z,
        ) > definition.synergyRadius) continue;
        other.data.fireUntil = Math.max(now, other.data.fireUntil ?? now) + definition.dragonFireTimeAdd;
      }
      for (const deployable of level.itemDeployables ?? []) {
        if (deployable.kind !== "claymore" || !deployable.position || Math.hypot(
          deployable.position.x - synergyCenter.x,
          deployable.position.y - synergyCenter.y,
          deployable.position.z - synergyCenter.z,
        ) > definition.synergyRadius) continue;
        deployable.damageMultiplier = Math.min(
          definition.claymoreDamageMultiplierMax,
          (deployable.damageMultiplier ?? 1) + definition.claymoreDamageMultiplierAdd,
        );
      }
    }
  } else if (variant === "wind") {
    spawnElementCrystalTrigger(runtime, controller, holder, effectAngles);
    const gustCenter = add(origin, mul(direction, definition.windGustCenterDistance));
    for (const level of state.levels.values()) {
      for (const deployable of [...level.itemDeployables ?? []]) {
        if (deployable.kind !== "gust" || !deployable.position || Math.hypot(
          deployable.position.x - gustCenter.x,
          deployable.position.y - gustCenter.y,
          deployable.position.z - gustCenter.z,
        ) > definition.windGustKillRadius) continue;
        cleanupDeployable(level, deployable);
      }
    }
  } else {
    spawnElementCrystalTrigger(runtime, controller, holder, effectAngles);
    const synergyCenter = add(origin, mul(direction, definition.synergyForwardDistance));
    for (const level of state.levels.values()) {
      for (const other of level.items ?? []) {
        const otherPosition = other.carrier?.GetAbsOrigin?.() ?? other.position;
        if (!otherPosition || Math.hypot(
          otherPosition.x - synergyCenter.x,
          otherPosition.y - synergyCenter.y,
          otherPosition.z - synergyCenter.z,
        ) > definition.synergyRadius) continue;
        if (other.name === "dragonslayer") other.data.bloodStack = definition.dragonWaterBloodStack;
        if (other.name === "baguette") other.data.breakChance = definition.baguetteWaterBreakChance;
      }
    }
  }

  runtime.itemDeployables.add(controller);
  advancePlanetCombo(runtime, item, variant, origin, now);
  fireTarget(item.visual, "SetAnimation", variant);
  return true;
}

function playerHasItemStatus(pawn, suffix) {
  const statuses = state.playerStatuses.get(pawn);
  if (!statuses) return false;
  for (const source of statuses.keys()) if (source.endsWith(suffix)) return true;
  return false;
}

function deployHealOrb(runtime, holder, item, now) {
  if (playerHasItemStatus(holder, ":squid")) return false;
  const definition = item.definition;
  // The active orb follows the item pistol, not the player who used it.
  const carrier = validEntity(item.carrier) ? item.carrier : undefined;
  const position = clone(carrier?.GetAbsOrigin?.() ?? add(holder.GetAbsOrigin(), vec(0, 0, 48)));
  const request = {
    position,
    angles: carrier?.GetAbsAngles?.() ?? holder.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 },
    feature: "heal_orb_active",
  };
  const visual = spawnDedicatedItemVisual(runtime, request, "heal_orb", "heal_orb_active");
  visual.SetModelScale?.(0.5);
  visual.SetColor?.({ r: 255, g: 255, b: 255, a: 100 });
  visual.Glow?.({ r: 100, g: 200, b: 255, a: 255 });
  const growDuration = (2.3 - 0.5) / 4;
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "heal_orb",
    item,
    visual,
    holder,
    carrier,
    position,
    radius: definition.healRadius,
    healAmount: definition.healAmount,
    healCap: definition.healCap,
    healRate: definition.healRate,
    growStartedAt: now,
    activeAt: now + growDuration,
    expiresAt: now + growDuration + definition.healDuration,
    removeAt: now + growDuration + definition.healDuration + 0.3,
    nextHealAt: now + growDuration,
    grenadeRecipients: new Set(),
  });
  message(`${holder.GetPlayerController?.()?.GetPlayerName?.() ?? "human"} used heal orb`);
  return true;
}

function refillHealOrbAmmo(pawn, orb) {
  for (const slot of [CSGearSlot.RIFLE, CSGearSlot.PISTOL]) {
    const weapon = pawn.FindWeaponBySlot?.(slot);
    if (!validEntity(weapon)) continue;
    const data = weapon.GetData?.();
    const name = String(data?.GetName?.() ?? weapon.GetClassName?.() ?? "");
    let amount = 20;
    if (name === "weapon_bizon") amount = 64;
    else if (name === "weapon_negev") amount = 150;
    else if (name === "weapon_m249") amount = 100;
    weapon.SetReserveAmmo?.(amount);
  }

  if (validEntity(pawn.FindWeapon?.("weapon_hegrenade")) || orb.grenadeRecipients.has(pawn)) return;
  pawn.GiveNamedItem?.("weapon_hegrenade", false);
  orb.grenadeRecipients.add(pawn);
}

function processHealOrb(runtime, orb, now, humans) {
  if (!validEntity(orb.visual)) {
    runtime.itemDeployables.delete(orb);
    return;
  }

  // Track the pistol wherever it goes (held, dropped or picked up again);
  // once it is gone the orb stays at its last position.
  const carrierPosition = validEntity(orb.carrier) ? orb.carrier.GetAbsOrigin?.() : undefined;
  if (carrierPosition) {
    orb.position = clone(carrierPosition);
    orb.visual.Teleport({
      position: orb.position,
      angles: orb.carrier.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 },
      velocity: vec(),
    });
  } else if (!orb.carrier && validEntity(orb.holder) && orb.holder.IsAlive?.() && orb.holder.GetTeamNumber?.() === 3) {
    orb.position = add(orb.holder.GetAbsOrigin(), vec(0, 0, 48));
    orb.visual.Teleport({
      position: orb.position,
      angles: orb.holder.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 },
      velocity: vec(),
    });
  }

  if (now < orb.activeAt) {
    const progress = Math.max(0, Math.min(1, (now - orb.growStartedAt) / (orb.activeAt - orb.growStartedAt)));
    orb.visual.SetModelScale?.(0.5 + 1.8 * progress);
    return;
  }

  if (now >= orb.expiresAt) {
    const progress = Math.max(0, Math.min(1, (now - orb.expiresAt) / (orb.removeAt - orb.expiresAt)));
    orb.visual.SetModelScale?.(2.3 * (1 - progress));
    if (now >= orb.removeAt) {
      orb.visual.Kill();
      runtime.entities.delete(orb.visual);
      runtime.itemDeployables.delete(orb);
      if (orb.item?.state !== "consumed" && orb.item?.state !== "cleaned") consumeItem(runtime, orb.item);
    }
    return;
  }

  orb.visual.SetModelScale?.(2.3);
  if (now < orb.nextHealAt) return;
  let healTicks = 0;
  while (orb.nextHealAt <= now) {
    orb.nextHealAt += orb.healRate;
    healTicks++;
  }
  for (const pawn of humans) {
    const pawnPosition = pawn.GetAbsOrigin?.();
    if (!pawnPosition || Math.hypot(
      pawnPosition.x - orb.position.x,
      pawnPosition.y - orb.position.y,
      pawnPosition.z - orb.position.z,
    ) > orb.radius) continue;
    const health = pawn.GetHealth?.();
    if (Number.isFinite(health) && health > 0 && health < orb.healCap) {
      pawn.SetHealth?.(Math.min(orb.healCap, health + orb.healAmount * healTicks));
    }
    refillHealOrbAmmo(pawn, orb);
  }
}

function useItemBehavior(runtime, item, holder, now) {
  const behavior = ITEM_BEHAVIORS[item.definition.behavior];
  if (!behavior || !behavior.canUse?.(item, holder, now)) return false;
  const result = behavior.onUse?.(runtime, item, holder, now);
  if (result === true) return { success: true };
  if (!result || result.success !== true) return false;
  return result;
}

// TEMP USE_DIAG: log why an E press on a held item failed; remove when done.
function useDiag(pawn, item, reason) {
  message(`USE_DIAG ${item?.name ?? "none"} fail=${reason} t=${Instance.GetGameTime().toFixed(2)} next=${item?.nextUseAt?.toFixed?.(2)} state=${item?.state} lc=${item ? itemRuntime(item)?.lifecycle : "-"} running=${state.running} infect=${infectionHasStarted()}`);
}

function useHeldItem(pawn) {
  const item = usableHeldPlayerItem(pawn);
  if (!item || item.state !== "held" || item.holder !== pawn) { useDiag(pawn, item, "no_held_item"); return false; }
                                                                           
                                                                              
  if (state.finaleEscapeActive && item.endingItem !== true) { useDiag(pawn, item, "finale_escape"); return false; }
  const runtime = itemRuntime(item);
  if (!runtime || pawn.GetTeamNumber?.() !== item.definition.team) {
    useDiag(pawn, item, "no_runtime_or_team");
    dropHeldItem(pawn);
    return false;
  }
  // processItems never ticks these runtimes, so anything spawned now would
  // freeze in place (chat/ping use bypasses the Think gate).
  if (!state.running || state.fatal || ["outcome_pending", "resolved", "destroyed"].includes(runtime.lifecycle)) { useDiag(pawn, item, "runtime_gate"); return false; }
  const now = Instance.GetGameTime();
  const behavior = ITEM_BEHAVIORS[item.definition.behavior];
  if (now < item.nextUseAt) {
    useDiag(pawn, item, "cooldown");
    behavior?.onUseFailed?.(runtime, item, pawn, "cooldown");
    return false;
  }
  let result;
  try {
    result = useItemBehavior(runtime, item, pawn, now);
  } catch (error) {
    useDiag(pawn, item, `threw: ${error?.stack ?? error}`);
    throw error;
  }
  if (!result) {
    useDiag(pawn, item, "behavior_returned_false");
    behavior?.onUseFailed?.(runtime, item, pawn, "failed");
    return false;
  }
  const cooldown = result.cooldown ?? item.definition.cooldown;
  item.nextUseAt = now + cooldown;
  item.readyNotified = cooldown <= 0;
  if (result.consumeCharge !== false) item.usesRemaining--;
  if (item.usesRemaining <= 0 && !result.deferConsume) consumeItem(runtime, item);
  return true;
}

function useItemFromPing(event) {
  const pawn = resolvePawn(event?.player ?? event?.controller ?? event?.pawn ?? event);
  if (pawn) useHeldItem(pawn);
}

function useItemFromChat(event) {
  genericEventChat(event);
  processChatterCurseChat(event);
  const text = String(event?.text ?? event?.message ?? "").trim().toLowerCase();
  if (text !== "!item" && text !== "!useitem") return;
  const pawn = resolvePawn(event?.player ?? event?.controller ?? event?.pawn);
  if (pawn) useHeldItem(pawn);
}

function sampleUseInputs(pawns) {
  return new Set(pawns.filter((pawn) => pawn.WasInputJustPressed?.(CSInputs.USE)));
}

function processHeldItemInputs(usePressed, pawns = allLivingPawns()) {
  const pressed = usePressed ?? sampleUseInputs(pawns);
  const consumed = new Set();
  for (const runtime of activeRuntimes()) {
    for (const item of runtime.items ?? []) {
      if (item.name !== "piggyback" || item.state !== "held" || !validEntity(item.holder)) continue;
      if (validEntity(item.data.rider)) {
        if (pressed.has(item.holder)) {
          dismountPiggyback(runtime, item);
          consumed.add(item.holder);
        }
        continue;
      }
      const saddle = item.visual?.GetAbsOrigin?.() ?? item.holder.GetAbsOrigin?.();
      if (!saddle) continue;
      const rider = pawns.find((pawn) => {
        if (pawn === item.holder || pawn.GetTeamNumber?.() !== 3 || !pressed.has(pawn)) return false;
        const position = pawn.GetAbsOrigin?.();
        return position && Math.hypot(position.x - saddle.x, position.y - saddle.y, position.z - saddle.z) <= 96;
      });
      if (!rider) continue;
      item.data.rider = rider;
      consumed.add(rider);
      tickPiggyback(runtime, item, item.holder);
    }
  }
  for (const [pawn, slots] of [...state.playerItems]) {
    if (!pawn?.IsValid() || !pawn.IsAlive() || slots.size === 0 || consumed.has(pawn)) continue;
    if (!pressed.has(pawn)) continue;
                                                                          
                                                                        
    if (usableHeldPlayerItem(pawn)) {
      consumed.add(pawn);
      useHeldItem(pawn);
    } else {
      // TEMP USE_DIAG
      for (const held of slots.values()) {
        message(`USE_DIAG ${held.name} fail=not_usable state=${held.state} holderMatch=${held.holder === pawn} carrierValid=${validEntity(held.carrier)} ownerMatch=${held.carrier?.GetOwner?.() === pawn}`);
      }
    }
  }
  return consumed;
}

function processWorldItemInputs(consumed = new Set(), usePressed, pawns = allLivingPawns()) {
  const pressed = usePressed ?? sampleUseInputs(pawns);
  const worldItems = [];
  for (const runtime of activeRuntimes()) {
    for (const item of runtime.items ?? []) {
      if (
        ["world", "dropped"].includes(item.state)
        && validEntity(item.carrier)
        && (!state.finaleEscapeActive || item.endingItem === true)
      ) {
        worldItems.push(item);
      }
    }
  }
  if (worldItems.length === 0) return consumed;

  for (const pawn of pawns) {
    if (consumed.has(pawn) || !pressed.has(pawn)) continue;
    const pawnPosition = pawn.GetAbsOrigin?.();
    if (!pawnPosition) continue;

    let nearest;
    let nearestDistance = Infinity;
    for (const item of worldItems) {
      if (!ITEM_BEHAVIORS[item.definition.behavior]?.canPickup?.(item, pawn)) continue;
      const slot = itemCarrierSlot(item.definition);
      if (slot !== undefined && validEntity(pawn.FindWeaponBySlot?.(slot))) continue;
      const carrierPosition = item.carrier.GetAbsOrigin?.() ?? item.position;
      const distance = Math.hypot(
        carrierPosition.x - pawnPosition.x,
        carrierPosition.y - pawnPosition.y,
        carrierPosition.z - pawnPosition.z,
      );
      const pickupRadius = Math.max(CONFIG.itemPickupRadius, item.definition.pickupUseRadius ?? 0);
      if (distance <= pickupRadius && distance < nearestDistance) {
        nearest = item;
        nearestDistance = distance;
      }
    }
    if (!nearest) continue;
    if (itemCarrierClass(nearest.definition) === "weapon_knife") {
      if (!prepareKnifeItemPickup(nearest, pawn, Instance.GetGameTime())) continue;
      nearest.knifePickupPawn = pawn;
      nearest.knifePickupUntil = Instance.GetGameTime() + 0.5;
    }
    consumed.add(pawn);

                                                                           
                                                                            
    nearest.carrier.Teleport?.({
      position: add(pawnPosition, vec(0, 0, 8)),
      angles: nearest.carrier.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 },
      velocity: vec(),
    });
  }
  return consumed;
}

function queueDeployableUseInputs(usePressed, consumed = new Set()) {
  for (const pawn of usePressed ?? []) {
    if (!consumed.has(pawn)) state.pendingDeployableUsePawns.add(pawn);
  }
}

// Source 1 queued an engine-side Kill when gust/pizza spawned, so they expired
// even if no script tick reached them (outcome_pending, fatal, thrown tick).
function scheduleDeployableKill(entities, lifetime) {
  for (const entity of entities) {
    if (validEntity(entity)) fireTarget(entity, "Kill", "", Math.max(0, lifetime) + 0.1);
  }
}

const LINEAR_ZOMBIE_PROJECTILE_KINDS = new Set(["pizzabaker", "gust", "gust_echo"]);

function retireLinearZombieProjectiles(runtime, filter = () => true) {
  for (const deployable of [...runtime?.itemDeployables ?? []]) {
    if (LINEAR_ZOMBIE_PROJECTILE_KINDS.has(deployable.kind) && filter(deployable)) cleanupDeployable(runtime, deployable);
  }
}

function cleanupDeployable(runtime, deployable) {
  clearSourceAudio(deployable);
  for (const id of deployable.nativeConnections ?? []) {
    disconnectEntityOutput(id);
    runtime.outputConnections.delete(id);
    state.outputConnections.delete(id);
  }
  deployable.nativeConnections?.clear();
  for (const piece of deployable.earthPieces ?? []) piece.cleaned = true;
  runtime.itemDeployables?.delete(deployable);
  for (const task of deployable.fallForgivenessTasks ?? []) task.cancelled = true;
  deployable.fallForgivenessTasks?.clear?.();
  for (const key of ["visual", "entryVisual", "exitVisual"]) {
    const visual = deployable[key];
    if (validEntity(visual)) visual.Kill();
    runtime.entities?.delete(visual);
    deployable.item?.effects?.delete(visual);
  }
  for (const collection of [deployable.visuals, deployable.pieces, deployable.indicators, deployable.sounds, deployable.nativeEntities]) {
    for (const visual of collection ?? []) {
      if (!validEntity(visual)) {
        runtime.entities?.delete(visual);
        deployable.item?.effects?.delete(visual);
        continue;
      }
      if (visual.GetClassName?.() === "point_soundevent") {
        fireTarget(visual, "StopSound", "");
      } else if (visual.GetClassName?.() === "ambient_generic") {
                                                                      
                                                                             
                                                                        
        if (deployable.kind !== "storm_blade") fireTarget(visual, "StopSound", "");
        fireTarget(visual, "Volume", "0");
      }
      if (deployable.borrowedSounds?.has(visual)) continue;
      if (validEntity(visual)) visual.Kill();
      runtime.entities?.delete(visual);
      deployable.item?.effects?.delete(visual);
      if (deployable.kind === "planet_earth") state.silentHillWorld.visuals.delete(visual);
    }
    collection?.clear?.();
  }
  deployable.pieceStates?.clear?.();
  deployable.borrowedSounds?.clear?.();
}

function processPoiseBurst(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const progress = Math.max(0, Math.min(1, (now - deployable.startsAt) / (deployable.expiresAt - deployable.startsAt)));
  deployable.visual.SetModelScale?.(1.5 + progress * 28.5);
  deployable.visual.Teleport?.({
    position: add(deployable.position, vec(0, 0, progress * 9)),
    velocity: vec(),
  });
  deployable.visual.SetColor?.({
    r: 255,
    g: 255,
    b: 255,
    a: Math.round(255 * (1 - progress)),
  });
}

function processFlingBurst(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const definition = deployable.item.definition;
  const progress = Math.max(
    0,
    Math.min(1, (now - deployable.startsAt) / definition.burstDuration),
  );
  deployable.visual.SetModelScale?.(
    definition.burstStartScale
      + (definition.burstEndScale - definition.burstStartScale) * progress,
  );
  deployable.visual.SetColor?.({
    r: 255,
    g: 0,
    b: 0,
    a: Math.round(255 * (1 - progress)),
  });
}

function processRoarBurst(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const definition = deployable.item.definition;
  const growProgress = Math.max(
    0,
    Math.min(1, (now - deployable.startsAt) / definition.burstGrowTime),
  );
  deployable.visual.SetModelScale?.(
    definition.burstStartScale
      + (definition.burstEndScale - definition.burstStartScale) * growProgress,
  );
  deployable.visual.Teleport?.({
    position: add(deployable.position, vec(0, 0, definition.burstRise * growProgress)),
    velocity: vec(),
  });
  const fadeProgress = now <= deployable.fadeAt
    ? 0
    : Math.min(1, (now - deployable.fadeAt) / definition.burstFadeTime);
  deployable.visual.SetColor?.({
    r: 255,
    g: 255,
    b: 255,
    a: Math.round(255 * (1 - fadeProgress)),
  });
}

function processGreasyFingers(runtime, deployable, now) {
  while (
    deployable.nextDropAt < deployable.expiresAt
    && deployable.nextDropAt <= now + 0.0001
  ) {
    for (const pawn of deployable.targets) {
      if (pawn?.IsValid?.() && pawn.IsAlive?.() && pawn.GetTeamNumber?.() === 3) {
        dropActiveWeapon(pawn);
      }
    }
    deployable.nextDropAt += deployable.item.definition.dropInterval;
  }
  if (now >= deployable.expiresAt) cleanupDeployable(runtime, deployable);
}

function processPoiseIllusion(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const elapsed = Math.max(0, Math.min(0.1, now - deployable.lastAt));
  deployable.lastAt = now;
  if (elapsed <= 0) return;
  deployable.position = add(deployable.position, mul(deployable.velocity, elapsed));
  deployable.velocity = add(deployable.velocity, vec(0, 0, -CONFIG.worldGravity * elapsed));
  deployable.visual.Teleport?.({ position: deployable.position, velocity: vec() });
  const remaining = deployable.expiresAt - now;
  if (remaining < 0.4) {
    deployable.visual.SetColor?.({
      r: 255,
      g: 255,
      b: 255,
      a: Math.round(255 * Math.max(0, remaining / 0.4)),
    });
  }
}

function playerCollisionHull(target) {
  const origin = target.GetAbsOrigin?.();
  if (!origin) return undefined;
  const crouched = target.IsDucking?.() === true || target.IsDucked?.() === true;
  const height = crouched ? 54 : 72;
  return {
    center: add(origin, vec(0, 0, height * 0.5)),
    halfWidth: 16,
    halfHeight: height * 0.5,
  };
}

function segmentIntersectsBox(start, end, halfExtents) {
  const delta = sub(end, start);
  let near = 0;
  let far = 1;
  for (const axis of ["x", "y", "z"]) {
    const extent = halfExtents[axis];
    const offset = start[axis];
    const movement = delta[axis];
    if (Math.abs(movement) <= 0.000001) {
      if (offset < -extent || offset > extent) return false;
      continue;
    }
    let axisNear = (-extent - offset) / movement;
    let axisFar = (extent - offset) / movement;
    if (axisNear > axisFar) [axisNear, axisFar] = [axisFar, axisNear];
    near = Math.max(near, axisNear);
    far = Math.min(far, axisFar);
    if (near > far) return false;
  }
  return true;
}

function projectileTouchesPlayerHull(target, start, end, radius) {
  const hull = playerCollisionHull(target);
  if (!hull) return false;
  return segmentIntersectsBox(
    sub(start, hull.center),
    sub(end, hull.center),
    vec(hull.halfWidth + radius, hull.halfWidth + radius, hull.halfHeight + radius),
  );
}

function linearTriggerTouchesPlayerHull(target, start, end, definition) {
  const hull = playerCollisionHull(target);
  if (!hull) return false;
  const movement = sub(end, start);
  const movementLength = Math.hypot(movement.x, movement.y, movement.z);
  if (movementLength <= 0.000001) return false;
  const direction = mul(movement, 1 / movementLength);
  const worldUp = Math.abs(direction.z) < 0.99 ? vec(0, 0, 1) : vec(1, 0, 0);
  const sideRaw = vec(
    worldUp.y * direction.z - worldUp.z * direction.y,
    worldUp.z * direction.x - worldUp.x * direction.z,
    worldUp.x * direction.y - worldUp.y * direction.x,
  );
  const sideLength = Math.hypot(sideRaw.x, sideRaw.y, sideRaw.z);
  const side = mul(sideRaw, 1 / sideLength);
  const up = vec(
    direction.y * side.z - direction.z * side.y,
    direction.z * side.x - direction.x * side.z,
    direction.x * side.y - direction.y * side.x,
  );
  const offset = definition.triggerOffset ?? 0;
  const triggerStart = add(start, mul(direction, offset));
  const triggerEnd = add(end, mul(direction, offset));
  const toLocal = (point) => {
    const relative = sub(point, hull.center);
    return vec(
      relative.x * direction.x + relative.y * direction.y + relative.z * direction.z,
      relative.x * side.x + relative.y * side.y + relative.z * side.z,
      relative.x * up.x + relative.y * up.y + relative.z * up.z,
    );
  };
  const playerExtentOn = (axis) =>
    hull.halfWidth * Math.abs(axis.x)
    + hull.halfWidth * Math.abs(axis.y)
    + hull.halfHeight * Math.abs(axis.z);
  return segmentIntersectsBox(
    toLocal(triggerStart),
    toLocal(triggerEnd),
    vec(
      definition.triggerDepth + playerExtentOn(direction),
      definition.triggerWidth + playerExtentOn(side),
      definition.triggerWidth + playerExtentOn(up),
    ),
  );
}

function traceProjectileWorld(start, end, radius, ignoreEntity) {
  const trace = typeof Instance.TraceSphere === "function"
    ? Instance.TraceSphere({ start, end, radius, ignoreEntity, ignorePlayers: true })
    : typeof Instance.TraceLine === "function"
      ? Instance.TraceLine({ start, end, ignoreEntity, ignorePlayers: true })
      : undefined;
  const didHit = trace?.didHit ?? trace?.hit ?? false;
  return {
    didHit,
    position: clone(trace?.end ?? trace?.position ?? end),
    normal: trace?.normal ?? trace?.hitNormal,
  };
}

function traceFlightHullWorld(start, end, holder) {
  if (typeof Instance.TraceBox !== "function") return undefined;
  const crouched = holder?.IsDucking?.() === true || holder?.IsDucked?.() === true;
  const maxZ = crouched ? 54 : 72;
  const trace = Instance.TraceBox({
    start,
    end,
    mins: vec(-16, -16, 0),
    maxs: vec(16, 16, maxZ),
    ignoreEntity: holder,
    ignorePlayers: true,
  });
  const didHit = trace?.didHit ?? trace?.hit ?? false;
  return {
    didHit,
                                                                    
                                                                           
    position: clone(trace?.end ?? trace?.position ?? (didHit ? start : end)),
    normal: trace?.normal ?? trace?.hitNormal,
  };
}

function advanceBallisticProjectile(deployable, now) {
  const elapsed = Math.max(0, Math.min(0.1, now - deployable.lastAt));
  deployable.lastAt = now;
  const start = clone(deployable.position);
  if (elapsed <= 0) return { start, end: start, collided: false, wasDescending: deployable.velocity.z < 0 };
  const wasDescending = deployable.velocity.z < 0;
  deployable.velocity = add(
    deployable.velocity,
    vec(0, 0, -CONFIG.worldGravity * deployable.gravity * elapsed),
  );
  const intended = add(start, mul(deployable.velocity, elapsed));
  const trace = traceProjectileWorld(start, intended, deployable.radius, deployable.user);
  deployable.position = trace.position;
  if (trace.didHit) {
    const normal = trace.normal;
    if (normal && Number.isFinite(normal.x) && Number.isFinite(normal.y) && Number.isFinite(normal.z)) {
      const dot = deployable.velocity.x * normal.x
        + deployable.velocity.y * normal.y
        + deployable.velocity.z * normal.z;
      deployable.velocity = mul(sub(deployable.velocity, mul(normal, 2 * dot)), deployable.bounce);
      deployable.position = add(deployable.position, mul(normal, Math.max(1, deployable.radius * 0.1)));
    } else {
      deployable.velocity = vec();
    }
  }
  if (deployable.kind === "squid"
    && Math.hypot(deployable.velocity.x, deployable.velocity.y) >= 0.5) {
                                                                              
                                                                               
                                                                           
    deployable.angles = squidFlightAngles(deployable.velocity);
  }
  deployable.visual.Teleport?.({
    position: deployable.position,
    angles: deployable.angles,
    velocity: clone(deployable.velocity),
  });
  return { start, end: deployable.position, collided: trace.didHit, wasDescending };
}

function spawnBallisticTrail(runtime, deployable, now) {
  const definition = deployable.item.definition;
  const color = definition.trailColor;
  const visual = spawnItemEffectVisual(runtime, deployable.item, {
    template: deployable.item.name,
    model: "models/luffaren/heal_orb.vmdl",
    position: deployable.position,
    angles: randomWorldAngles(),
    scale: definition.trailScale,
    color,
    glow: color,
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "ballistic_trail",
    item: deployable.item,
    visual,
    startsAt: now,
    expiresAt: now + definition.trailLifetime,
    startScale: definition.trailScale,
    startColor: color,
  });
}

function emitBallisticTrail(runtime, deployable, now) {
  const interval = deployable.item.definition.trailInterval;
  if (!interval || now < deployable.nextTrailAt) return;
                                                                               
                                                                           
  spawnBallisticTrail(runtime, deployable, now);
  deployable.nextTrailAt = now + interval;
}

function processBallisticTrail(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const progress = Math.max(0, Math.min(
    1,
    (now - deployable.startsAt) / (deployable.expiresAt - deployable.startsAt),
  ));
  deployable.visual.SetModelScale?.(deployable.startScale * (1 - progress * 0.75));
  deployable.visual.SetColor?.({
    r: deployable.startColor.r,
    g: deployable.startColor.g,
    b: deployable.startColor.b,
    a: Math.round(deployable.startColor.a * (1 - progress)),
  });
}

function stoneHasSettled(deployable, now) {
  const definition = deployable.item.definition;
  if (deployable.restCleanupAt !== undefined) return now >= deployable.restCleanupAt;
  if (now < deployable.nextRestCheckAt) return false;
  const moved = Math.hypot(
    deployable.position.x - deployable.restSample.x,
    deployable.position.y - deployable.restSample.y,
    deployable.position.z - deployable.restSample.z,
  );
  deployable.restSample = clone(deployable.position);
  while (deployable.nextRestCheckAt <= now) {
    deployable.nextRestCheckAt += definition.restCheckInterval;
  }
                                                                             
                               
  if (moved <= definition.restDistance) {
    deployable.restCleanupAt = now + definition.restCheckInterval;
  }
  return false;
}

function hitStoneTarget(runtime, deployable, pawn, stonePosition) {
  if (deployable.touched.has(pawn)) return;
  deployable.touched.add(pawn);
  playSourceAudioCue(9656, pawn.GetAbsOrigin?.() ?? deployable.position);
  spawnItemParticle(runtime, deployable.item, "weapon_taser_flash", stonePosition, sourceItemImpactAngles(), 0.03);
  const damage = deployable.item.definition.damage;
  const health = pawn.GetHealth?.() ?? 0;
  if (health > damage) pawn.SetHealth?.(health - damage);
  else damagePawn(pawn, 999999, deployable.user, deployable.visual);
  if (!deployable.item.definition.stopTargetVelocity) return;
  const velocity = pawn.GetAbsVelocity?.() ?? vec();
  pawn.Teleport?.({ velocity: vec(0, 0, Math.min(0, velocity.z)) });
}

function explodeBombChuck(runtime, deployable, pawns) {
  const definition = deployable.item.definition;
  playSourceAudioStack([8498,8499], deployable.position);
  for (const pawn of pawns) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const distance = Math.hypot(
      position.x - deployable.position.x,
      position.y - deployable.position.y,
      position.z - deployable.position.z,
    );
    if (distance > definition.explosionRadius) continue;
                                                                            
                                                                            
                                                                            
                                                                           
                                                                 
    const damage = definition.magnitude
      * definition.explosionDamageScale
      * Math.max(0.05, 1 - distance / definition.explosionRadius);
                                                                              
                                                                                 
    damagePawn(pawn, damage, undefined, undefined, CSDamageTypes.BLAST);
    pushPawn(
      pawn,
      directionBetween(deployable.position, position),
      damage * 1.5,
      Math.max(180, damage),
    );
  }
  cleanupDeployable(runtime, deployable);
}

function humanUsesBomb(pawn, deployable, usePressed) {
  if (!usePressed?.has(pawn)) return false;
  const origin = pawn.GetEyePosition?.() ?? pawn.GetAbsOrigin?.();
  if (!origin) return false;
  const delta = sub(deployable.position, origin);
  const distance = Math.hypot(delta.x, delta.y, delta.z);
  if (distance > deployable.item.definition.useRadius) return false;
  if (typeof pawn.GetEyeAngles !== "function" && typeof pawn.GetAbsAngles !== "function") return true;
  const direction = forwardVector(pawn, true);
  const dot = distance > 0
    ? (delta.x * direction.x + delta.y * direction.y + delta.z * direction.z) / distance
    : 1;
  return dot >= 0.8;
}

function spawnSquidInkVisual(runtime, deployable, now, index) {
  const offset = index === 0
    ? vec()
    : vec(Math.random() * 70 - 35, Math.random() * 70 - 35, Math.random() * 25);
  const visual = spawnItemEffectVisual(runtime, deployable.item, {
    template: "squid",
    model: "models/luffaren/heal_orb.vmdl",
    position: add(deployable.position, offset),
    angles: {
      pitch: Math.random() * 360,
      yaw: Math.random() * 360,
      roll: Math.random() * 360,
    },
    scale: 0.01,
    color: { r: 0, g: 0, b: 0, a: 255 },
    glow: { r: 20, g: 0, b: 10, a: 255 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "squid_ink_visual",
    item: deployable.item,
    visual,
    startsAt: now,
    expiresAt: now + 0.6,
    targetScale: index === 0 ? 2.5 : 0.1 + Math.random() * 2.4,
  });
}

function explodeSquid(runtime, deployable, now, humans) {
  const definition = deployable.item.definition;
  playSourceAudioStack([6695, 6696], deployable.position);
  playSourceAudioCue(6697, deployable.position);
  for (const pawn of humans) {
    const position = pawn.GetAbsOrigin?.();
    if (!position || Math.hypot(
      position.x - deployable.position.x,
      position.y - deployable.position.y,
      position.z - deployable.position.z,
    ) > definition.impactRadius) continue;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport?.({ velocity: vec(0, 0, Math.min(0, velocity.z)) });
    playSourceAudioCue(6712, position, { recipient: pawn });
    addPlayerStatus(
      runtime,
      pawn,
      itemEffectSource(runtime, deployable.item, "squid_slow"),
      definition.slowTime,
      { speedMultiplier: definition.slowAmount },
    );
    addPlayerStatus(
      runtime,
      pawn,
      `${runtime.index}:item:${deployable.item.id}:squid`,
      definition.inkTime,
      { squidBlind: true },
    );
  }
  syncSquidBlindHud(now, true);
  cleanupDeployable(runtime, deployable);
  for (let index = 0; index < 5; index++) spawnSquidInkVisual(runtime, deployable, now, index);
}

function processSquidInkVisual(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const progress = Math.max(0, Math.min(1, (now - deployable.startsAt) / (deployable.expiresAt - deployable.startsAt)));
  deployable.visual.SetModelScale?.(deployable.targetScale * Math.min(1, progress * 2));
  if (progress > 0.65) {
    deployable.visual.SetColor?.({
      r: 0, g: 0, b: 0,
      a: Math.round(255 * (1 - (progress - 0.65) / 0.35)),
    });
  }
}

function processBallisticZombieProjectile(runtime, deployable, now, humans, zombies, usePressed) {
  if (!validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (deployable.kind === "bomb_chuck") {
    for (const pawn of humans) {
      if (!humanUsesBomb(pawn, deployable, usePressed)) continue;
      damagePawn(pawn, 999999, deployable.user, deployable.visual);
    }
    if (now >= deployable.detonateAt) {
      explodeBombChuck(runtime, deployable, [...humans, ...zombies]);
      return;
    }
  } else if (now >= deployable.expiresAt) {
    if (deployable.kind === "squid") explodeSquid(runtime, deployable, now, humans);
    else cleanupDeployable(runtime, deployable);
    return;
  }

  const step = advanceBallisticProjectile(deployable, now);
  emitBallisticTrail(runtime, deployable, now);
  if (deployable.kind === "stone") {
    for (const pawn of humans) {
      if (projectileTouchesPlayerHull(pawn, step.start, step.end, deployable.radius)) {
        hitStoneTarget(runtime, deployable, pawn, step.end);
      }
    }
    if (stoneHasSettled(deployable, now)) cleanupDeployable(runtime, deployable);
    return;
  }
  if (deployable.kind === "squid") {
    const direct = humans.find((pawn) =>
      projectileTouchesPlayerHull(pawn, step.start, step.end, deployable.radius)
    );
    if (direct) {
      damagePawn(direct, deployable.item.definition.directDamage, deployable.user, deployable.visual);
      explodeSquid(runtime, deployable, now, humans);
      return;
    }
    const speed = Math.hypot(deployable.velocity.x, deployable.velocity.y, deployable.velocity.z);
    if (speed < 3.5 || (step.collided && step.wasDescending && deployable.velocity.z > 0)) {
      explodeSquid(runtime, deployable, now, humans);
    }
  }
}

function spawnGustEcho(runtime, deployable, startsAt) {
  const definition = deployable.item.definition;
  const angles = anglesFromDirection(deployable.direction);
                                                                                
  angles.roll = Math.random() * 360;
  const visual = spawnItemEffectVisual(runtime, deployable.item, {
    template: "gust",
    model: definition.model,
    position: deployable.position,
    angles,
    scale: definition.projectileScale * (
      definition.echoScaleMin
      + Math.random() * (definition.echoScaleMax - definition.echoScaleMin)
    ),
    color: { r: 255, g: 255, b: 255, a: 200 },
  });
  runtime.itemDeployables.add({
    id: state.nextItemEffectId++,
    kind: "gust_echo",
    item: deployable.item,
    visual,
    startsAt,
    expiresAt: startsAt + definition.echoFadeTime,
  });
  visual.Teleport?.({ position: deployable.position, angles, velocity: vec() });
  scheduleDeployableKill([visual], startsAt + definition.echoFadeTime - Instance.GetGameTime());
}

function processGustEcho(runtime, deployable, now) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const progress = Math.max(
    0,
    Math.min(
      1,
      (now - deployable.startsAt) / deployable.item.definition.echoFadeTime,
    ),
  );
  deployable.visual.SetColor?.({
    r: 255,
    g: 255,
    b: 255,
    a: Math.round(200 * (1 - progress)),
  });
}

function processLinearZombieProjectile(runtime, deployable, now, humans) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const elapsed = Math.max(0, Math.min(0.1, now - deployable.lastAt));
  deployable.lastAt = now;
  if (elapsed <= 0) return;
  const start = clone(deployable.position);
  deployable.position = add(start, mul(deployable.direction, deployable.item.definition.speed * elapsed));
  deployable.visual.Teleport?.({
    position: deployable.position,
    velocity: mul(deployable.direction, deployable.item.definition.speed),
  });
  for (const visual of deployable.visuals ?? []) {
    if (!validEntity(visual)) continue;
    visual.Teleport?.({
      position: deployable.position,
      angles: deployable.visualAngles?.get(visual),
      velocity: mul(deployable.direction, deployable.item.definition.speed),
    });
  }
  for (const sound of deployable.sounds ?? []) {
    if (deployable.parentedSounds?.has(sound)) continue;
    if (validEntity(sound)) sound.Teleport?.({ position: deployable.position });
  }
  if (deployable.kind === "gust") {
    while (deployable.nextEchoAt <= now + 0.0001) {
      // Advance first: a failed echo spawn must not retry forever and stall
      // every deployable queued after this one.
      const startsAt = deployable.nextEchoAt;
      deployable.nextEchoAt += deployable.item.definition.echoInterval;
      if (startsAt + deployable.item.definition.echoFadeTime <= now) continue;
      try {
        spawnGustEcho(runtime, deployable, startsAt);
      } catch (error) {
        reportGuardedError("gust echo", error);
      }
    }
  }
  for (const pawn of humans) {
    if (!linearTriggerTouchesPlayerHull(
      pawn,
      start,
      deployable.position,
      deployable.item.definition,
    )) continue;
    if (deployable.kind === "pizzabaker") {
      const impactPosition = clone(pawn.GetAbsOrigin());
      damagePawn(pawn, 999999, deployable.user, deployable.visual);
      spawnPizzaImpactSounds(runtime, deployable, now);
      spawnItemParticle(runtime, deployable.item, "blood_impact_headshot", impactPosition, sourceItemImpactAngles(), 0.05);
      spawnItemParticle(runtime, deployable.item, "weapon_taser_flash", impactPosition, sourceItemImpactAngles(), 0.05);
      continue;
    }
    if ((deployable.touchCooldowns.get(pawn) ?? 0) > now) continue;
    deployable.touchCooldowns.set(pawn, now + 0.1);
    const current = pawn.GetAbsVelocity?.() ?? vec();
    pawn.Teleport?.({
      velocity: vec(
        deployable.direction.x * deployable.item.definition.pushVelocity,
        deployable.direction.y * deployable.item.definition.pushVelocity,
        current.z <= 1 ? deployable.item.definition.pushVelocityUp : current.z,
      ),
    });
    nullifyFalldownCheckpoint(pawn, deployable.user);
  }
}

function processShortSound(runtime, deployable, now) {
  if (now >= deployable.expiresAt) cleanupDeployable(runtime, deployable);
}

function processPuller(runtime, deployable, now, humans) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (now < deployable.activeAt) return;
  deployable.visual.SetModelScale?.(8);
  deployable.visual.SetColor?.({ r: 255, g: 255, b: 0, a: 255 });
  for (const pawn of humans) {
    if (deployable.touchers.has(pawn)) continue;
    if (!targetInOrientedBeam(
      deployable.position,
      deployable.direction,
      pawn,
      deployable.item.definition.beamLength,
      deployable.item.definition.beamHalfWidth,
    )) continue;
    deployable.touchers.add(pawn);
    pawn.Teleport?.({
      velocity: vec(
        -deployable.direction.x * deployable.item.definition.pullVelocity || 0,
        -deployable.direction.y * deployable.item.definition.pullVelocity || 0,
        deployable.item.definition.pullVelocityUp,
      ),
    });
    nullifyFalldownCheckpoint(pawn, deployable.user);
    playSourceAudioCue(9315, add(pawn.GetAbsOrigin?.() ?? deployable.position, vec(0, 0, 40)));
    spawnItemParticle(runtime, deployable.item, "weapon_taser_flash",
      add(pawn.GetAbsOrigin?.() ?? deployable.position, vec(0, 0, 40)), undefined, 0.03);
    damagePawn(pawn, deployable.item.definition.damage, deployable.user, deployable.visual);
  }
}

function processPeanutButter(runtime, deployable, now, zombies) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  for (const pawn of zombies) {
    if (!validZombieTarget(pawn)) continue;
    if (deployable.touched.has(pawn)) continue;
    const position = pawn.GetAbsOrigin?.();
    if (!position || Math.hypot(
      position.x - deployable.position.x,
      position.y - deployable.position.y,
      position.z - deployable.position.z,
    ) > 50) continue;
    deployable.touched.add(pawn);
    addPlayerStatus(runtime, pawn, deployable.source, 6, { speedMultiplier: -0.85 });
    // Source gates the squish sound and dirt burst by fx_amt > 10 over 0.20 seconds.
    if (!reserveItemParticleBurst("peanutbutter", 11, 0.20)) continue;
    playSourceAudioCue(7786, position);
    spawnItemParticle(runtime, deployable.item, "impact_dirt", position, { pitch: 0, yaw: Math.floor(Math.random() * 361), roll: 0 }, 0.03);
  }
}

function processClaymore(runtime, deployable, now, zombies) {
  if (now >= deployable.expiresAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (deployable.detonateAt === undefined && now >= deployable.armedAt) {
    const triggered = zombies.some((pawn) => {
      if (!validZombieTarget(pawn)) return false;
      const position = pawn.GetAbsOrigin?.();
      if (!position) return false;
      const delta = sub(position, deployable.position);
      const left = leftOf(deployable.direction);
      const forward = delta.x * deployable.direction.x + delta.y * deployable.direction.y;
      const side = delta.x * left.x + delta.y * left.y;
       return forward >= deployable.item.definition.triggerMinAlong
         && forward <= 100
         && Math.abs(side) <= 25
         && delta.z >= deployable.item.definition.triggerMinZ
         && delta.z <= deployable.item.definition.triggerMaxZ;
    });
    if (triggered) {
      deployable.detonateAt = now + 0.5;
      playSourceAudioCue(7993, add(deployable.position, vec(0, 0, 4)));
    }
  }
  if (deployable.detonateAt === undefined || now < deployable.detonateAt) return;
  hurtFinaleBossAt(add(deployable.position, vec(0, 0, 100)), deployable.item.definition.bossRadius, deployable.item.definition.bossDamage * (deployable.damageMultiplier ?? 1), deployable.item.definition.bossStunChance, deployable.item.definition.bossStunTimeAdd, undefined, "claymore");
  for (const pawn of zombies) {
    if (!validZombieTarget(pawn)) continue;
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    const distance = Math.hypot(
      position.x - deployable.position.x,
      position.y - deployable.position.y,
      position.z - deployable.position.z,
    );
    if (distance > 500) continue;
     const damage = 3000 * (deployable.damageMultiplier ?? 1) * Math.max(0, 1 - distance / 500);
     damagePawn(pawn, damage);
     if (!pawn.IsAlive?.()) continue;
    if (distance <= 200) pawn.Teleport({ velocity: vec() });
    if (distance <= 100) {
      fireTarget(pawn, "IgniteLifetime", "7");
      addPlayerStatus(runtime, pawn, itemEffectSource(runtime, deployable.item, "claymore"), 7, {
        speedMultiplier: -0.44,
      });
    }
  }
  if (reserveItemParticleBurst("claymore", 10, 0.20, true)) {
    const position = add(deployable.position, vec(0, 0, 4));
    playSourceAudioCue(7958, position);
    playSourceAudioCue(7959, position);
    spawnItemParticle(runtime, deployable.item, "explosion_child_distort01d_1k", position, undefined, 0.10);
  }
  cleanupDeployable(runtime, deployable);
}

function processBillNye(runtime, deployable, now, zombies) {
  if (now >= deployable.removeAt || !validEntity(deployable.visual)) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  const definition = deployable.item?.definition ?? ITEM_DEFINITIONS.billnye;
  if (now >= deployable.startsAt && !deployable.startSoundPlayed) {
    deployable.startSoundPlayed = true;
    fireTarget(deployable.visual, "Skin", "1");
    hurtFinaleBossAt(add(deployable.position, vec(0, 0, 78)), definition.bossRadius, definition.bossDamage, definition.bossStunChance, definition.bossStunTimeAdd, undefined, "billnye");
    playSourceAudioCue(7679, add(deployable.position, vec(0, 0, 78)), {parent:deployable.visual,owner:deployable});
  }
  if (now >= deployable.stopsAt) {
    if (!deployable.stopSoundPlayed) {
      deployable.stopSoundPlayed = true;
      fireTarget(deployable.visual, "Skin", "0");
      playSourceAudioCue(7661, add(deployable.position, vec(0, 0, 78)), {parent:deployable.visual,owner:deployable});
    }
    return;
  }
  if (now < deployable.startsAt) return;
  if (!deployable.animationStarted) {
    deployable.animationStarted = true;
    fireTarget(deployable.visual, "SetAnimation", "play");
    fireTarget(deployable.visual, "SetDefaultAnimation", "play", 0.02);
  }
  if (now < deployable.scansAt) return;
  for (const pawn of zombies) {
    if (!validZombieTarget(pawn)) continue;
    const target = pawn.GetAbsOrigin?.();
    if (!target) continue;
    const delta = sub(target, deployable.position);
    const distance = Math.hypot(delta.x, delta.y, delta.z);
    const facing = delta.x * deployable.direction.x + delta.y * deployable.direction.y;
    if (distance <= 500 && facing > 0) {
      const velocity = pawn.GetAbsVelocity?.() ?? vec();
      const eye = pawn.GetEyePosition?.() ?? add(target, vec(0, 0, 64));
      pawn.Teleport({
        angles: anglesFromDirection(sub(add(deployable.position, vec(0, 0, 78)), eye)),
        velocity: vec(0, 0, Math.min(0, velocity.z)),
      });
    }
  }
  deployable.scansAt = now + 0.2;
}

function processHackerman(runtime, deployable, now) {
  if (now >= deployable.expiresAt) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (!validEntity(deployable.user) || !deployable.user.IsAlive?.() || deployable.user.GetTeamNumber?.() !== 3) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (now >= deployable.nextTickAt) {
    deployable.nextTickAt = now + 0.15;
    const userPosition = deployable.user.GetAbsOrigin?.();
    let target;
    let targetDistance = Infinity;
    for (const pawn of allLivingPawns()) {
      if (!validZombieTarget(pawn)) continue;
      const position = pawn.GetAbsOrigin?.();
      if (!position || !userPosition) continue;
      const distance = Math.hypot(
        position.x - userPosition.x,
        position.y - userPosition.y,
        position.z - userPosition.z,
      );
      if (distance <= 800 && distance < targetDistance) {
        target = pawn;
        targetDistance = distance;
      }
    }
    if (target) {
      target.SetHealth?.(1);
      const eye = deployable.user.GetEyePosition?.() ?? add(userPosition, vec(0, 0, 64));
      const targetPosition = add(target.GetAbsOrigin?.(), vec(
        Math.random() * 40 - 20,
        Math.random() * 40 - 20,
        Math.random() * 70 - 50,
      ));
      deployable.user.Teleport?.({ angles: anglesFromDirection(sub(targetPosition, eye)) });
      for (const slot of [CSGearSlot.RIFLE, CSGearSlot.PISTOL]) {
        const weapon = deployable.user.FindWeaponBySlot?.(slot);
        if (!validEntity(weapon)) continue;
        weapon.SetClipAmmo?.(30);
        weapon.SetReserveAmmo?.(30);
      }
      spawnItemParticle(runtime, deployable.item, "explosion_child_distort01b",
        add(target.GetAbsOrigin(), vec(0, 0, 30)), undefined, 0.05);
    }
  }
  for (const indicator of [...deployable.indicators]) {
    if (!validEntity(indicator)) deployable.indicators.delete(indicator);
  }
}

function processRift(runtime, pair, now, pawns) {
  if (now >= pair.removeAt || !validEntity(pair.entryVisual) || (pair.complete && !validEntity(pair.exitVisual))) {
    cleanupDeployable(runtime, pair);
    if (pair.item?.usesRemaining <= 0 && pair.item.state !== "consumed" && pair.item.state !== "cleaned") {
      consumeItem(runtime, pair.item);
    }
    return;
  }
  if (!pair.complete || now >= pair.expiresAt) return;
  const touchesPortal = (pawn, portalBase) => {
    if (!portalBase) return false;
                                                                       
                                                                          
                                                                          
                                                                          
    const center = add(portalBase, vec(0, 0, 61));
    return projectileTouchesPlayerHull(pawn, center, center, 1);
  };
  for (const pawn of pawns) {
                                                                          
                                                               
    if (pair.item?.definition?.team === 3 && pawn.GetTeamNumber?.() !== 3) continue;
    const position = pawn.GetAbsOrigin?.();
    if (!position || (pair.touchCooldowns.get(pawn) ?? 0) > now) continue;
    const atEntry = touchesPortal(pawn, pair.entry);
    const atExit = touchesPortal(pawn, pair.exit);
    if (!atEntry && !atExit) continue;
    const destination = atEntry ? pair.exit : pair.entry;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pair.touchCooldowns.set(pawn, now + 1);
    const safePosition = clone(destination);
    pawn.Teleport({
      position: add(destination, vec(0, 0, 12)),
      velocity: vec(velocity.x, velocity.y, velocity.z < -300 ? 0 : velocity.z),
    });
    playRiftTeleportAudio(pawn, atEntry ? pair.entry : pair.exit, destination);
    spawnRiftTeleportParticles(runtime, pair, pawn, atEntry ? pair.entry : pair.exit,
      add(atEntry ? pair.entry : pair.exit, vec(0, 0, 61)));
    if (pair.item?.definition?.team === 3) {
      let forgivenessTask;
      forgivenessTask = schedule(1, () => {
        pair.fallForgivenessTasks?.delete(forgivenessTask);
        if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) return;
        const currentVelocity = pawn.GetAbsVelocity?.() ?? vec();
        if (currentVelocity.z < -300) {
          pawn.Teleport({ position: add(safePosition, vec(0, 0, 12)), velocity: vec() });
        }
      }, runtime.index);
      pair.fallForgivenessTasks?.add(forgivenessTask);
    }
  }
}

function processZombieRift(runtime, pair, now, zombies) {
  if (
    now >= pair.expiresAt
    || now >= pair.removeAt
    || !validEntity(pair.exitVisual)
    || (pair.complete && !validEntity(pair.entryVisual))
  ) {
    cleanupDeployable(runtime, pair);
    return;
  }
  if (!pair.complete) return;

  const samples = new Map();
  for (const pawn of zombies) {
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    samples.set(pawn, {
      previous: pair.lastPositions?.get(pawn) ?? clone(position),
      current: clone(position),
    });
    pair.lastPositions?.set(pawn, clone(position));
  }

  const insideEntry = (pawn, position) => {
    const definition = pair.item.definition;
    if (Math.hypot(position.x - pair.entry.x, position.y - pair.entry.y)
      > definition.portalTouchRadius) return false;
    const hullHeight = pawn.IsDucking?.() || pawn.IsDucked?.()
      ? definition.crouchedHullHeight
      : definition.standingHullHeight;
    const relativeFeet = position.z - pair.entry.z;
                                                                      
                                                                         
                                                                           
                                       
    return relativeFeet <= definition.portalTriggerTop
      && relativeFeet + hullHeight >= definition.portalTriggerBottom;
  };

  if (now < pair.activeAt) {
    for (const [pawn, sample] of samples) {
      if (insideEntry(pawn, sample.current)) pair.mustExitBeforeTouch.add(pawn);
    }
    return;
  }

                                                                              
                                                                              
                                           
  const destinationGround = Instance.TraceLine({
    start: pair.destination,
    end: add(pair.destination, vec(0, 0, -40)),
  });
  if (!destinationGround?.didHit) return;

  const chaseDestination = state.teleportDestination?.GetAbsOrigin?.();
  const entryModelCenter = add(pair.entry, vec(0, 0, 61));
  if (chaseDestination && Math.hypot(
    chaseDestination.x - entryModelCenter.x,
    chaseDestination.y - entryModelCenter.y,
    chaseDestination.z - entryModelCenter.z,
  ) <= pair.item.definition.teleportLockRange) return;

  for (const [pawn, sample] of samples) {
    if ((pair.touchCooldowns.get(pawn) ?? 0) > now) continue;
    if (pair.mustExitBeforeTouch.has(pawn)) {
      if (!insideEntry(pawn, sample.current)) pair.mustExitBeforeTouch.delete(pawn);
      continue;
    }
    const segment = sub(sample.current, sample.previous);
    const segmentLengthSquared = segment.x * segment.x + segment.y * segment.y;
    const relative = sub(pair.entry, sample.previous);
    const progress = segmentLengthSquared > 0.0001
      ? Math.max(0, Math.min(1, (
        relative.x * segment.x + relative.y * segment.y
      ) / segmentLengthSquared))
      : 0;
    const nearest = add(sample.previous, mul(segment, progress));
    if (Math.hypot(nearest.x - pair.entry.x, nearest.y - pair.entry.y)
      > pair.item.definition.portalTouchRadius) continue;
    if (!insideEntry(pawn, nearest)) continue;
    const velocity = pawn.GetAbsVelocity?.() ?? vec();
    pair.touchCooldowns.set(pawn, now + 1);
    pawn.Teleport?.({
      position: add(pair.destination, vec(0, 0, 12)),
      velocity,
    });
    playRiftTeleportAudio(pawn, pair.entry, pair.destination);
    spawnRiftTeleportParticles(runtime, pair, pawn, pair.entry, add(pair.entry, vec(0, 0, 61)));
  }
}

function otherHiddenImpostorExists(excluded) {
  for (const runtime of activeRuntimes()) {
    for (const deployable of runtime.itemDeployables ?? []) {
      if (deployable !== excluded && deployable.kind === "impostor" && deployable.hidden) return true;
    }
  }
  return false;
}

function activeImpostorController(pawn) {
  for (const runtime of activeRuntimes()) {
    for (const deployable of runtime.itemDeployables ?? []) {
      if (deployable.kind === "impostor" && deployable.user === pawn) return deployable;
    }
  }
  return undefined;
}

function cleanupImpostor(runtime, deployable) {
  const user = deployable.user;
  if (validEntity(user) && deployable.originalModel) user.SetModel?.(deployable.originalModel);
  deployable.hidden = false;
  cleanupDeployable(runtime, deployable);
  if (!otherHiddenImpostorExists(deployable)) Instance.ServerCommand("sv_disable_radar 0");
}

function processImpostor(runtime, deployable, now) {
  const user = deployable.user;
  if (!validEntity(user) || !user.IsAlive?.() || user.GetTeamNumber?.() !== 2) {
    cleanupImpostor(runtime, deployable);
    return;
  }
  const definition = deployable.item.definition;
  if (now >= deployable.nextHealthCapAt) {
    deployable.healthCap = definition.healthBase + definition.healthPerHuman * humanTeamCount();
    deployable.nextHealthCapAt = now + definition.healthCapInterval;
  }
  if (Number.isFinite(deployable.healthCap)) {
    const health = user.GetHealth?.();
    if (Number.isFinite(health) && health > deployable.healthCap) user.SetHealth?.(deployable.healthCap);
  }
  if (!deployable.hidden || now < deployable.revealAt) return;
  deployable.hidden = false;
  if (deployable.originalModel) user.SetModel?.(deployable.originalModel);
  playSourceAudioCue(9865, add(user.GetAbsOrigin?.() ?? vec(), vec(0, 0, 48)));
  if (!otherHiddenImpostorExists(deployable)) Instance.ServerCommand("sv_disable_radar 0");
}

function processDestructoSlow(runtime, deployable, now, zombies) {
  if (now >= deployable.expiresAt) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (now < deployable.activeAt) return;
  for (const pawn of zombies) {
    if (deployable.touched.has(pawn)) continue;
    const position = pawn.GetAbsOrigin?.();
    if (!position) continue;
    if (Math.hypot(position.x - deployable.position.x, position.y - deployable.position.y)
      > deployable.item.definition.slowHalfWidth) continue;
    if (position.z < deployable.position.z - 3000 || position.z > deployable.position.z + 2000) continue;
    deployable.touched.add(pawn);
    addPlayerStatus(
      runtime,
      pawn,
      `${runtime.index}:item:${deployable.item.id}:destructo:${deployable.id}`,
      deployable.item.definition.slowTime,
      { speedMultiplier: deployable.item.definition.slowAmount },
    );
  }
}

function stopStormBladeSounds(runtime, deployable) {
  if (deployable.soundsStopped) return;
  deployable.soundsStopped = true;
  for (const sound of deployable.sounds ?? []) {
    if (!validEntity(sound)) continue;
                                                                              
                                                                             
                                                                             
                                                                       
    fireTarget(sound, "Volume", "0");
    if (deployable.borrowedSounds?.has(sound)) continue;
    sound.Kill?.();
    runtime.entities?.delete(sound);
    deployable.sounds?.delete?.(sound);
  }
}

function spawnStormBladeEndParticles(runtime, item, position) {
  if (Math.floor(Math.random() * 8) !== 0) return;
  spawnItemParticle(runtime, item, "explosion_coop_mission_shrapnel02e_1k",
    add(position, vec(0, 0, -Math.floor(Math.random() * 201))), undefined, 0.05);
  if (Math.random() >= 0.5) return;
  spawnItemParticle(runtime, item, "explosion_child_core04c_1k", position, undefined, 0.05);
  if (Math.random() >= 0.5) return;
  spawnItemParticle(runtime, item, "explosion_child_distort01d_1k", position, undefined, 0.05);
  spawnItemParticle(runtime, item, "storm_lightning_01", position, undefined, 0.05);
}

function processStormBlade(runtime, deployable, now) {
  if (now >= deployable.removeAt) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (!deployable.soundsStopped && now >= (deployable.soundStopAt ?? deployable.removeAt)) {
    stopStormBladeSounds(runtime, deployable);
  }
  for (const [piece, pieceState] of deployable.pieceStates ?? []) {
    if (!validEntity(piece)) {
      deployable.pieces?.delete(piece);
      deployable.pieceStates?.delete(piece);
      continue;
    }
    if (!pieceState.glowDisabled && now >= pieceState.glowOffAt) {
      pieceState.glowDisabled = true;
      piece.Unglow?.();
    }
    if (now >= pieceState.killAt) {
      piece.Kill?.();
      runtime.entities?.delete(piece);
      deployable.item?.effects?.delete(piece);
      deployable.pieces?.delete(piece);
      deployable.pieceStates?.delete(piece);
      continue;
    }
    const burstProgress = Math.max(
      0,
      Math.min(1, (now - pieceState.burstStartAt) / (pieceState.burstEndAt - pieceState.burstStartAt)),
    );
    const easedProgress = 1 - ((1 - burstProgress) ** 3);
    pieceState.position = add(
      pieceState.burstStart,
      mul(sub(pieceState.burstTarget, pieceState.burstStart), easedProgress),
    );
    pieceState.angles = {
      pitch: pieceState.burstStartAngles.pitch
        + (pieceState.burstTargetAngles.pitch - pieceState.burstStartAngles.pitch) * easedProgress,
      yaw: pieceState.burstStartAngles.yaw
        + (pieceState.burstTargetAngles.yaw - pieceState.burstStartAngles.yaw) * easedProgress,
      roll: pieceState.burstStartAngles.roll
        + (pieceState.burstTargetAngles.roll - pieceState.burstStartAngles.roll) * easedProgress,
    };
    const alpha = pieceState.ending
      ? Math.round(255 * Math.max(0, Math.min(1, (pieceState.killAt - now) / 0.75)))
      : 255;
    piece.SetColor?.({ r: 255, g: 255, b: 255, a: alpha });
    piece.Teleport?.({
      position: pieceState.position,
      angles: pieceState.angles,
      velocity: vec(),
    });
  }
  if (!deployable.started && now >= deployable.activeAt) {
    deployable.started = true;
    for (const pawn of allLivingPawns()) {
      if (!validZombieTarget(pawn)) continue;
      const targetPosition = pawn.GetAbsOrigin?.();
      if (!targetPosition || Math.hypot(
        targetPosition.x - deployable.position.x,
        targetPosition.y - deployable.position.y,
        targetPosition.z - deployable.position.z,
      ) > 800) continue;
      deployable.frozen.add(pawn);
      pawn.Teleport({ velocity: vec(0, 0, 550) });
    }
  }
  if (now >= deployable.endsAt && !deployable.released) {
    deployable.released = true;
                                                                           
                                                                       
                                                                             
    const heldVisual = deployable.item?.visual;
    if (validEntity(heldVisual)) {
      fireTarget(heldVisual, "SetAnimation", "idle");
      fireTarget(heldVisual, "SetPlaybackRate", "1.0");
      heldVisual.SetColor?.({ r: 150, g: 220, b: 255, a: 255 });
    }
    for (const [piece, pieceState] of deployable.pieceStates ?? []) {
      spawnStormBladeEndParticles(runtime, deployable.item, pieceState.position);
      pieceState.ending = true;
      piece.Unglow?.();
      piece.SetModelScale?.(4 + Math.random() * 4);
    }
    scheduleItemTask(runtime, deployable.item, 0.18, () => {
      if (deployable.item?.state === "cleaned" || !validEntity(deployable.item?.visual)) return;
      deployable.item.visual.SetColor?.({ r: 50, g: 50, b: 50, a: 255 });
    });
    for (const pawn of deployable.frozen) {
      if (!validZombieTarget(pawn)) continue;
      const health = pawn.GetHealth?.() ?? 0;
      pawn.SetHealth?.(Math.max(1, Math.floor(health * 0.02)));
      const velocity = pawn.GetAbsVelocity?.() ?? vec();
      pawn.Teleport({ velocity: vec(velocity.x, velocity.y, Math.max(300, velocity.z)) });
    }
                                                                           
                                                                         
    const center = deployable.position;
    const source = itemEffectSource(runtime, deployable.item, "storm");
    for (const pawn of allLivingPawns()) {
      if (!validZombieTarget(pawn)) continue;
      const position = pawn.GetAbsOrigin?.();
      if (!position || Math.hypot(
        position.x - center.x,
        position.y - center.y,
        position.z - center.z,
      ) > 800) continue;
      addPlayerStatus(runtime, pawn, source, 15, { speedMultiplier: -0.45 });
    }
  } else if (!deployable.released && deployable.started && now >= deployable.freezeAt) {
    for (const pawn of deployable.frozen) if (validZombieTarget(pawn)) pawn.Teleport({ velocity: vec() });
  }
}

function processPlanet(runtime, deployable, now, zombies, humans = []) {
  if (now >= deployable.expiresAt) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (deployable.kind === "planet_earth" && now >= deployable.nextTickAt) {
    deployable.nextTickAt = now + 0.2;
    const destination = state.teleportIndicator?.GetAbsOrigin?.();
    for (const piece of deployable.earthPieces ?? []) {
      if (piece.cleaned) continue;
      if (destination && Math.hypot(destination.x - piece.position.x,
        destination.y - piece.position.y, destination.z - piece.position.z)
        <= deployable.item.definition.earthTeleportDenyDistance) {
        cleanupEarthCrystalPiece(runtime, deployable, piece);
      }
    }
    if (deployable.earthPieces?.every(piece => piece.cleaned)) cleanupDeployable(runtime, deployable);
  }
                                                                              
                                                                           
}

// Source 10535-10545/10568-10578: three delayed flashes on the victim, then distort and blood
// offset back along the captain's attack direction.
function spawnCaptainPlanetHitParticles(runtime, deployable, victimPosition, attackDirection) {
  const item = deployable.item;
  const position = victimPosition();
  if (!position) return;
  const randomInt = (min, max) => min + Math.floor(Math.random() * (max - min + 1));
  for (let delay = 0; delay < 0.25; delay += 0.12) {
    scheduleItemParticle(runtime, item, delay, (activeRuntime) => {
      const current = victimPosition();
      if (!current) return;
      spawnItemParticle(activeRuntime, item, "weapon_taser_flash",
        add(current, vec(randomInt(-30, 30), randomInt(-30, 30), randomInt(30, 50))), undefined, 0.10);
    });
  }
  const captainAngles = anglesFromDirection(attackDirection);
  spawnItemParticle(runtime, item, "explosion_child_distort01b",
    add(sub(position, mul(attackDirection, 10 + Math.random() * 40)), vec(0, 0, 40)), captainAngles, 0.10);
  spawnItemParticle(runtime, item, "blood_impact_headshot",
    add(position, vec(randomInt(-10, 10), randomInt(-10, 10), randomInt(30, 50))),
    { pitch: captainAngles.pitch + 45, yaw: captainAngles.yaw + 180, roll: captainAngles.roll }, 0.10);
}

function processCaptainPlanet(runtime, deployable, now, pawns) {
  if (now >= deployable.removeAt) {
    cleanupDeployable(runtime, deployable);
    return;
  }
  if (!deployable.buffed && now >= deployable.buffAt) {
    deployable.buffed = true;
    for (const pawn of pawns) {
      if (pawn.GetTeamNumber?.() !== 3) continue;
      pawn.SetHealth?.(Math.max(100, pawn.GetHealth?.() ?? 100));
    }
  }
  if (now < deployable.startsAt || now < deployable.nextTickAt) return;
  if (now >= deployable.stopsAt) {
    if (!deployable.stopFightHandled) {
      deployable.stopFightHandled = true;
      fireTarget(deployable.visual, "SetAnimation", "idle");
      fireTarget(deployable.visual, "SetDefaultAnimation", "idle", 0.01);
    }
    return;
  }
  deployable.nextTickAt = now + 0.3;
  const punchIndex = 1 + Math.floor(Math.random() * 5);
  fireTarget(deployable.visual, "SetAnimation", `punching_${punchIndex}`);
  fireTarget(deployable.visual, "SetDefaultAnimation", `punching_${punchIndex}`, 0.01);
  const bossTargets = deployable.item?.definition?.captainTargetBoss === true
    ? finaleBossLivingTargets()
    : [];
  if (bossTargets.length > 0) {
    const selected = bossTargets[Math.floor(Math.random() * bossTargets.length)];
    const boss = selected.boss;
    const attackDirection = finaleKamikazeNormalize(vec(Math.random() * 2 - 1, Math.random() * 2 - 1, Math.random() * -0.5 - 0.5), vec(0, 0, -1));
    const captainPosition = add(boss.position, mul(attackDirection, -(100 + Math.random() * 100)));
    deployable.visual?.Teleport?.({ position: captainPosition, angles: anglesFromDirection(attackDirection), velocity: vec() });
    damageFinaleBoss(selected.runtime, boss, deployable.item.definition.captainBossDamage, undefined, { source: "captain_planet" });
    playSourceAudioCue(10539, boss.position);
    spawnCaptainPlanetHitParticles(runtime, deployable, () => boss.position, attackDirection);
    return;
  }
  const zombies = pawns.filter(validZombieTarget);
  if (zombies.length === 0) return;
  const pawn = zombies[Math.floor(Math.random() * zombies.length)];
  const position = pawn.GetAbsOrigin?.() ?? deployable.position;
  const approach = directionBetween(position, deployable.position);
  deployable.visual?.Teleport?.({
    position: add(position, mul(approach, 75)),
    angles: anglesFromDirection(mul(approach, -1)),
  });
  damagePawn(pawn, 4600);
  playSourceAudioCue(10572, position);
  spawnCaptainPlanetHitParticles(runtime, deployable,
    () => (validEntity(pawn) ? pawn.GetAbsOrigin?.() : undefined), mul(approach, -1));
  pawn.Teleport({ velocity: vec(0, 0, 500) });
  schedule(0.5, () => {
    if (validZombieTarget(pawn)) pawn.Teleport({ velocity: vec(0, 0, -700) });
  }, runtime.index);
}

function processItemDeployables(runtime, now, targetsByTeam, usePressed = new Set()) {
  if (!runtime.itemDeployables) return;
  const humans = targetsByTeam.get(3) ?? [];
  const zombies = targetsByTeam.get(2) ?? [];
  const pawns = [...humans, ...zombies];
  for (const deployable of [...runtime.itemDeployables]) {
    if (deployable.kind === "native_item_particle") {
      if (now >= deployable.expiresAt || !validEntity(deployable.visual)) cleanupDeployable(runtime, deployable);
    }
    else if (deployable.kind === "squid_ink_visual") processSquidInkVisual(runtime, deployable, now);
    else if (deployable.kind === "ballistic_trail") processBallisticTrail(runtime, deployable, now);
    else if (deployable.kind === "short_sound") processShortSound(runtime, deployable, now);
    else if (["stone", "bomb_chuck", "squid"].includes(deployable.kind)) {
      processBallisticZombieProjectile(runtime, deployable, now, humans, zombies, usePressed);
    }
    else if (deployable.kind === "fling_burst") processFlingBurst(runtime, deployable, now);
    else if (deployable.kind === "roar_burst") processRoarBurst(runtime, deployable, now);
    else if (deployable.kind === "gust_echo") processGustEcho(runtime, deployable, now);
    else if (deployable.kind === "poise_burst") processPoiseBurst(runtime, deployable, now);
    else if (deployable.kind === "greasy_fingers") processGreasyFingers(runtime, deployable, now);
    else if (deployable.kind === "poise_illusion" || deployable.kind === "impostor_illusion") {
      processPoiseIllusion(runtime, deployable, now);
    }
    else if (deployable.kind === "pizzabaker" || deployable.kind === "gust") {
      processLinearZombieProjectile(runtime, deployable, now, humans);
    }
    else if (deployable.kind === "puller") processPuller(runtime, deployable, now, humans);
    else if (deployable.kind === "heal_orb") processHealOrb(runtime, deployable, now, humans);
    else if (deployable.kind === "peanutbutter") processPeanutButter(runtime, deployable, now, zombies);
    else if (deployable.kind === "claymore") processClaymore(runtime, deployable, now, zombies);
    else if (deployable.kind === "billnye") processBillNye(runtime, deployable, now, zombies);
    else if (deployable.kind === "hackerman") processHackerman(runtime, deployable, now);
    else if (deployable.kind === "rift_z") processZombieRift(runtime, deployable, now, zombies);
    else if (deployable.kind === "rift") processRift(runtime, deployable, now, pawns);
    else if (deployable.kind === "impostor") processImpostor(runtime, deployable, now);
    else if (deployable.kind === "destructo_slow") processDestructoSlow(runtime, deployable, now, zombies);
    else if (deployable.kind === "storm_blade") processStormBlade(runtime, deployable, now);
    else if (deployable.kind.startsWith("planet_")) processPlanet(runtime, deployable, now, zombies, humans);
    else if (deployable.kind === "captain_planet") processCaptainPlanet(runtime, deployable, now, pawns);
  }
}

function processItems(now, usePressed = state.pendingDeployableUsePawns) {
  if (now < state.nextItemTickAt) return false;
  state.nextItemTickAt = now + CONFIG.itemTickInterval;
  processReleasedItemCarriers(now);
  const pawns = allLivingPawns();
  const targetsByTeam = new Map([
    [2, pawns.filter((pawn) => pawn.GetTeamNumber?.() === 2)],
    [3, pawns.filter((pawn) => pawn.GetTeamNumber?.() === 3)],
  ]);
  const reservedKnifePawns = new Set();
  // Pickup qualification needs only 10 Hz; native claims and moving item
  // effects retain the 50 Hz Item Tick.
  const checkKnifePickups = now >= state.nextKnifePickupTickAt;
  if (checkKnifePickups) {
    state.nextKnifePickupTickAt = now + CONFIG.knifePickupCheckInterval;
    for (const runtime of activeRuntimes()) {
      for (const item of runtime.items ?? []) {
        if (["world", "dropped"].includes(item.state) && now < (item.knifePickupUntil ?? 0)
          && validEntity(item.carrier) && !validEntity(item.carrier.GetOwner?.())
          && validEntity(item.knifePickupPawn)) reservedKnifePawns.add(item.knifePickupPawn);
      }
    }
  }
  for (const runtime of activeRuntimes()) {
    for (const item of [...runtime.items ?? []]) {
      if (item.state === "consumed") continue;
      if (item.state === "dropped") {
        const droppedPosition = item.carrier?.GetAbsOrigin?.() ?? item.position;
        if (droppedPosition?.z <= CONFIG.itemFallCleanupZ) {
          consumeItem(runtime, item);
          continue;
        }
      }
      if (!item.visual?.IsValid()) {
        if (item.holder) forgetPlayerItem(item.holder, item);
        ITEM_BEHAVIORS[item.definition.behavior]?.onCleanup?.(runtime, item);
        destroyItemCarrier(item);
        runtime.items.delete(item);
        continue;
      }
      if (item.state === "held") {
        const holder = item.holder;
        if (!holder?.IsValid() || !holder.IsAlive() || holder.GetTeamNumber?.() !== item.definition.team) {
          dropItem(item, item.position);
        } else {
          const carrier = item.carrier;
          if (!validEntity(carrier)) {
            item.carrier = undefined;
            dropItem(item, holder.GetAbsOrigin?.() ?? item.position);
            continue;
          }
          const carrierOwner = carrier.GetOwner?.();
          if (typeof carrier.GetOwner === "function" && carrierOwner !== holder) {
            dropItem(item, carrier.GetAbsOrigin?.() ?? item.position);
            continue;
          }
                                                                             
                                                                              
                                                                         
          item.position = clone(holder.GetAbsOrigin?.() ?? carrier.GetAbsOrigin?.() ?? item.position);
          if (!item.readyNotified && now >= item.nextUseAt) {
            item.readyNotified = true;
            ITEM_BEHAVIORS[item.definition.behavior]?.onReady?.(runtime, item, holder);
          }
          ITEM_BEHAVIORS[item.definition.behavior]?.onTick?.(runtime, item, holder, now);
        }
        continue;
      }

      if (validEntity(item.carrier)) {
        item.position = clone(item.carrier.GetAbsOrigin?.() ?? item.position);
        const carrierOwner = item.carrier.GetOwner?.();
        if (validEntity(carrierOwner)) {
          if (
            carrierOwner.IsAlive?.()
            && carrierOwner.GetTeamNumber?.() === item.definition.team
            && !playerItemInSlot(carrierOwner, itemSlotKey(item.definition))
          ) {
            if (!claimItem(item, carrierOwner, item.carrier)) carrierOwner.DropWeapon?.(item.carrier);
          } else {
            carrierOwner.DropWeapon?.(item.carrier);
          }
          continue;
        }
        if (checkKnifePickups && (!state.finaleEscapeActive || item.endingItem === true)) {
          processKnifeItemPickup(item, now, pawns, reservedKnifePawns);
        }
        continue;
      }
    }
    processItemDeployables(runtime, now, targetsByTeam, usePressed);
  }
  if (usePressed === state.pendingDeployableUsePawns) {
    state.pendingDeployableUsePawns.clear();
  }
  return true;
}

function spawnFeature(request) {
  const runtime = state.levels.get(request.levelIndex);
  if (!runtime) return;
  if (request.postSpawn && !runtime.postSpawnReleased) {
    runtime.postSpawnFeatures ??= [];
    runtime.postSpawnFeatures.push(request);
    finishRuntimeSpawn(runtime);
    return;
  }
                                                                          
                                                                              
                                                                          
  const profile = themeProfile(request.themeName ?? runtime.themeSnapshot ?? runtime.stageSnapshot?.theme);
  const themeShape = request.themeShape ?? featureThemeShape(request.feature, request);
  request = {
    ...request,
    themeName: profile.name,
    themeShape,
    themeModel: request.themeModel ?? (themeShape ? chooseTerrainModel(profile.name, themeShape) : undefined),
    themeSkin: request.themeSkin ?? (request.feature === "lowgrav"
      ? profile.lowgravSkin
      : request.feature === "airslide"
        ? profile.airslideSkin
        : request.feature === "hazardPlane"
          ? profile.hazardLiquidSkin
        : undefined),
    renderColor: request.renderColor ?? featureRenderColor(request.feature, request.tile, profile.name),
  };
  if (runtime.lifecycle === "queued") setLevelLifecycle(runtime, "spawning");
  try {
    if (["boost", "teleport", "lowgrav", "airslide"].includes(request.feature)) {
      spawnTriggerFeature(runtime, request);
    } else if (["button", "genericHold", "endButton"].includes(request.feature)) {
      spawnButtonFeature(runtime, request);
    } else if (request.feature === "ladder") {
                                                                       
                                                                      
      const surfaceRequest = {
        ...request,
        feature: "ladderSurface",
        angles: request.surfaceAngles ?? {
          ...request.angles,
          yaw: normalizeYaw(request.angles.yaw + 90),
        },
      };
      const spawned = spawnRoundEntities(featureTemplate("ladder"), surfaceRequest.position, surfaceRequest.angles) ?? [];
      finalizeSpawned(runtime, surfaceRequest, spawned);
                                                                         
                                                                            
                                                                     
      const visual = spawnVisual(runtime, { ...request, feature: "ladderVisual" }, request.themeModel ?? LADDER_MODEL);
      if (!visual) throw new Error("ladder visual did not spawn");
      runtime.terrainCompanions ??= new Map();
      runtime.terrainCompanions.set(visual, new Set(spawned));
      registerTerrainEntity(runtime, visual);
    } else if (request.feature === "climb") {
      spawnBakedClimb(runtime, request);
    } else if (request.feature === "crouch") {
      spawnModelBlock(runtime, request, request.themeModel
        ?? (request.tile === 143 ? "models/luffaren/collective_crouchtall.vmdl" : "models/luffaren/collective_crouch.vmdl"));
    } else if (request.feature === "breakable") {
      spawnBreakableBlock(runtime, request, request.themeModel ?? "models/luffaren/collective_blockwall.vmdl");
    } else if (request.feature === "hold") {
      const holdModel = spawnModelBlock(runtime, { ...request, feature: "holdModel" }, request.themeModel ?? "models/luffaren/collective_hold.vmdl");
      if (!holdModel) throw new Error("hold model did not spawn");
      const hold = spawnNativeHold(runtime, request, holdModel);
      runtime.holds.get(request.group).push(hold);
      if (runtime.interactionsRetired) openHoldEntity(hold, true);
    } else if (request.feature === "teleportDestination") {
      spawnVisual(runtime, { ...request, feature: "teleportDestinationVisual" }, request.themeModel ?? TELEPORT_MODEL);
    } else if (request.feature === "liquid") {
      if (!spawnLiquidFeature(runtime, request)) return;
    } else if (request.feature === "elevator") {
      spawnElevatorFeature(runtime, request);
    } else if (request.feature === "movePlatform") {
      spawnMovePlatformFeature(runtime, request);
    } else if (request.feature === "hazardPlane") {
      spawnHazardPlaneFeature(runtime, request);
    } else if (request.feature === "trap") {
      spawnTrapFeature(runtime, request);
    } else if (request.feature === "item") {
      spawnItemFeature(runtime, request);
    }
                                                                           
                                                                             
                                                                               
    if (!["breakable", "movePlatform", "hazardPlane"].includes(request.feature)
      && !(request.feature === "trap" && request.tile === 85)) {
      spawnBlockSafetyTrigger(runtime, request);
    }
    finishRuntimeSpawn(runtime);
  } catch (error) {
    if (request.race) {
      raceLog(
        runtime,
        `SPAWN_FAIL slot=${request.raceRecord?.raceSlot ?? "?"} map=${request.raceRecord?.id ?? "?"} `
          + `name="${request.raceRecord?.name ?? "?"}" cell=${request.raceCell ? `${request.raceCell.x},${request.raceCell.y}` : "?"} `
          + `tile=${request.raceCell?.tile ?? request.tile ?? "?"} feature=${request.feature} error=${String(error)}`,
      );
    }
    failRuntime(`feature spawn failed for level ${runtime.index}/${request.feature}: ${error}`);
  }
}

// A ladder visual owns its invisible climb surface; retiring the visual alone
// would leave a climbable ghost ladder until the level is recycled.
function killTerrainCompanions(runtime, visual) {
  const companions = runtime?.terrainCompanions?.get(visual);
  if (!companions) return;
  for (const companion of companions) {
    if (validEntity(companion)) companion.Kill();
    runtime.entities?.delete(companion);
  }
  runtime.terrainCompanions.delete(visual);
}

function registerTerrainEntity(runtime, entity, safe = false) {
  if (!runtime || !entity?.IsValid?.()) return false;
  const className = String(entity.GetClassName?.() ?? "").toLowerCase();
  if (
    className.startsWith("trigger_")
    || className.startsWith("ambient_")
    || className.startsWith("weapon_")
    || className.startsWith("item_")
    || className.startsWith("logic_")
    || className.startsWith("point_")
  ) return false;
  runtime.terrainEntities ??= new Set();
  runtime.terrainEntities.add(entity);
  attachMovementVolumeTerrain(runtime, entity);
  if (safe) {
    runtime.safeTerrainEntities ??= new Set();
    runtime.safeTerrainEntities.add(entity);
  }
  return true;
}

function spawnOne(request) {
  const runtime = state.levels.get(request.levelIndex);
  if (!runtime) return;
  if (runtime.lifecycle === "queued") setLevelLifecycle(runtime, "spawning");
  if (request.genericEventStep2) processGenericLevelStep2(runtime);
  if (request.kind === "feature") {
    spawnFeature(request);
    return;
  }
  if (request.kind === "debugModel") {
    try {
      const visual = spawnVisual(runtime, request, request.model);
      if (!validEntity(visual)) throw new Error("model template produced no visual entity");
      visual.SetEntityName(`debug_model_${request.themeName}_${request.themeShape}`);
    } catch (error) {
      failRuntime(`debug model ${request.themeName}/${request.themeShape} failed: ${error}`);
      return;
    }
    finishRuntimeSpawn(runtime);
    return;
  }
  let templateKey = request.shape;
  let template = state.templates.get(templateKey);
                                                                        
                                                                        
                                                                        
  let bakedSlope = false;
                                                                           
                                                                           
                                
  if (request.race && request.raceSurfaceKey) {
    const raceTemplate = state.featureTemplates.get(request.raceSurfaceKey);
    if (raceTemplate?.IsValid?.() && typeof raceTemplate.ForceSpawn === "function") {
      templateKey = request.raceSurfaceKey;
      template = raceTemplate;
      bakedSlope = request.raceSurfaceKey.startsWith("race_surface_slope_");
      runtime.raceSurfaceTemplateUsed = true;
    } else {
      raceLog(runtime, `SPAWN_FAIL slot=${request.raceRecord?.raceSlot ?? "?"} map=${request.raceRecord?.id ?? "?"} name="${request.raceRecord?.name ?? "?"}" cell=${request.raceCell ? `${request.raceCell.x},${request.raceCell.y}` : "bridge"} tile=${request.raceCell?.tile ?? request.tile ?? "?"} shape=${request.shape} template=${request.raceSurfaceKey}`);
      failRuntime(`RACE surface template '${request.raceSurfaceKey}' became invalid`);
      return;
    }
  }
  if (!template || !template.IsValid()) {
    if (request.race) raceLog(runtime, `SPAWN_FAIL slot=${request.raceRecord?.raceSlot ?? "?"} map=${request.raceRecord?.id ?? "?"} name="${request.raceRecord?.name ?? "?"}" cell=${request.raceCell ? `${request.raceCell.x},${request.raceCell.y}` : "bridge"} tile=${request.raceCell?.tile ?? request.tile ?? "?"} shape=${request.shape} template=${templateKey}`);
    failRuntime(`template '${templateKey}' became invalid`);
    return;
  }
  const prepared = request.preloadedTerrain;
  const reuse = prepared && validEntity(prepared.entity)
    && runtime.terrainPreloadedEntities?.has(prepared.entity);
  // Consume the staged entity once. An externally removed prop falls back to
  // ordinary, budgeted creation instead of leaving a hole or stranding remaining.
  if (prepared) {
    if (reuse) runtime.entities.add(prepared.entity);
    runtime.terrainPreloadedEntities?.delete(prepared.entity);
    request.preloadedTerrain = undefined;
  }
  const spawned = reuse ? [prepared.entity]
    : bakedSlope || (request.race && templateKey === "race_surface_flat")
      ? spawnRoundEntities(template, request.position)
      : spawnRoundEntities(template, request.position, request.angles);
  if (!spawned || spawned.length === 0) {
    if (request.race) raceLog(runtime, `SPAWN_FAIL slot=${request.raceRecord?.raceSlot ?? "?"} map=${request.raceRecord?.id ?? "?"} name="${request.raceRecord?.name ?? "?"}" cell=${request.raceCell ? `${request.raceCell.x},${request.raceCell.y}` : "bridge"} tile=${request.raceCell?.tile ?? request.tile ?? "?"} shape=${request.shape} template=${templateKey} reason=ForceSpawn-empty`);
    failRuntime(`ForceSpawn failed for level ${runtime.index}/${request.shape}`);
    return;
  }
  for (const entity of spawned) if (entity) runtime.entities.add(entity);
  for (const entity of spawned) {
    if (!entity || !entity.IsValid()) continue;
    if (request.terrainModel) {
      if (typeof entity.SetModel !== "function") {
        failRuntime(`terrain model replacement is unavailable for ${request.themeName}/${request.shape}`);
        return;
      }
      const model = rememberSilentHillVisual(runtime, entity, request.terrainModel, request);
      if (!reuse || prepared.model !== model) entity.SetModel(model);
      applyTerrainAppearance(entity, 0, request.renderColor);
      const silentHillRecord = state.silentHillWorld.visuals.get(entity);
      if (silentHillRecord) silentHillRecord.restore = () => applyTerrainAppearance(entity, 0, request.renderColor);
    }
                                                                             
                                                                                  
    if (reuse && prepared.inPlace) {
      // Already at its final transform: no move, just make it real. The fade
      // below starts from alpha 0, so drawing on reveals nothing early.
      entity.collectiveTerrainPlacement = { owner: runtime.index, position: request.position };
      fireTarget(entity, "TurnOn");
      fireTarget(entity, "EnableCollision");
    } else if (reuse || !bakedSlope) {
      if (reuse) entity.collectiveTerrainPlacement = { owner: runtime.index, position: request.position };
      const applyFinalTransform = () => {
        if (!entity.IsValid() || runtime.lifecycle === "destroyed"
          || state.levels.get(runtime.index) !== runtime) return;
        // Preloaded props already have their final orientation/collision. Keep
        // that orientation, especially on slopes, and translate only.
        if (reuse) {
          const { x, y, z } = request.position;
          fireTarget(entity, "KeyValues", `origin ${x} ${y} ${z}`);
        } else {
          entity.Teleport({ position: request.position, angles: request.angles, velocity: vec() });
        }
      };
      applyFinalTransform();
      // Fresh template spawns need a post-Think correction. A staged prop has
      // settled long ago and nothing else moves it, so one origin input suffices.
      if (!reuse) afterThink(applyFinalTransform);
    }
    entity.SetEntityName(`block_${runtime.index}_${request.shape}`);
    runtime.entities.add(entity);
    registerTerrainEntity(runtime, entity, request.safe === true);
    beginTerrainSpawnFade(entity, runtime);
  }
  try {
    spawnBlockSafetyTrigger(runtime, request);
  } catch (error) {
    failRuntime(`spawn safety failed for level ${runtime.index}/${request.shape}: ${error}`);
    return;
  }
  finishRuntimeSpawn(runtime);
}

function genericEventBudgetAllows(cost) {
  let live = cost + terrainPreloadEntityCount();
  for (const runtime of activeRuntimes()) live += runtime.entities?.size ?? 0;
  for (const event of state.genericEvents.active.values()) live += event.entityRuntime.entities.size + event.cost;
  return live < 12000;
}
function genericEventWeapons() {
  const weapons = new Set();
  for (const className of GENERIC_EVENT_WEAPON_CLASSES)
    for (const weapon of Instance.FindEntitiesByClass?.(className) ?? []) if (validEntity(weapon)) weapons.add(weapon);
  for (const pawn of allLivingPawns()) {
    for (const weapon of pawn.GetWeapons?.() ?? []) if (validEntity(weapon)) weapons.add(weapon);
    const active = pawn.GetActiveWeapon?.();
    if (validEntity(active)) weapons.add(active);
  }
  return weapons;
}
const GENERIC_EVENT_WEAPON_CLASSES = Object.freeze([
  "weapon_ak47", "weapon_aug", "weapon_awp", "weapon_bizon", "weapon_cz75a",
  "weapon_deagle", "weapon_elite", "weapon_famas", "weapon_fiveseven", "weapon_g3sg1",
  "weapon_galilar", "weapon_glock", "weapon_hkp2000", "weapon_m249", "weapon_m4a1",
  "weapon_m4a1_silencer", "weapon_mac10", "weapon_mag7", "weapon_mp5sd", "weapon_mp7",
  "weapon_mp9", "weapon_negev", "weapon_nova", "weapon_p250", "weapon_p90",
  "weapon_revolver", "weapon_sawedoff", "weapon_scar20", "weapon_sg556", "weapon_ssg08",
  "weapon_tec9", "weapon_ump45", "weapon_usp_silencer", "weapon_xm1014",
]);
function genericTerrainAlpha(entity, alpha) {
  const color = entity.collectiveBaseColor ?? state.silentHillWorld.visuals.get(entity)?.color
    ?? { r: 255, g: 255, b: 255, a: 255 };
  entity.SetColor?.({ ...color, a: alpha });
}
function tryStartGenericEvent(name, runtime, options) {
  try { return startGenericEvent(name, runtime, options); }
  catch (error) {
    message(`[EVENT ${name}] startup failed: ${String(error)}`);
    return false;
  }
}

function genericEventResourceIssue(name) {
  if (name === "DEBRIS") {
    for (const tile of RACE_CONFIG.rubbleTypes) {
      const templateName = FEATURE_TEMPLATE_NAMES[`race_rubble_touch_${tile}`];
      const template = state.featureTemplates.get(`race_rubble_touch_${tile}`);
      if (!validEntity(template) || typeof template.ForceSpawn !== "function")
        return `missing native rubble contact template '${templateName}'; compile the updated VMAP`;
    }
  }
  const config = name === "PIZZADOOM" ? GENERIC_PIZZADOOM_CONFIG
    : name === "WORLD_EATER" ? GENERIC_WORLD_EATER_CONFIG : undefined;
  if (config) {
    const template = Instance.FindEntityByName(config.template);
    if (!validEntity(template) || typeof template.ForceSpawn !== "function")
      return `missing native event template '${config.template}'; compile the updated VMAP`;
    if (name === "PIZZADOOM") {
      const contactTemplate = Instance.FindEntityByName(config.contactFxTemplate);
      if (!validEntity(contactTemplate) || typeof contactTemplate.ForceSpawn !== "function")
        return `missing native pizza contact FX template '${config.contactFxTemplate}'; compile the updated VMAP`;
      const hitbox = Instance.FindEntityByName("assetdep_event_pizzadoom_hitbox");
      const model = String(hitbox?.GetModelName?.() ?? "").replace(/_c$/i, "");
      if (!validEntity(hitbox) || model !== config.hitboxModel)
        return `missing native pizza hitbox dependency '${config.hitboxModel}'`;
    }
  }
  const dependency = GENERIC_EVENT_MODEL_DEPENDENCIES[name];
  if (!dependency) return undefined;
  const marker = Instance.FindEntityByName(dependency.entity);
  if (!validEntity(marker)) return `missing model dependency entity '${dependency.entity}'`;
  try {
    const model = String(marker.GetModelName?.() ?? "").replace(/\\/g, "/").replace(/_c$/i, "").toLowerCase();
    if (model !== dependency.model.toLowerCase())
      return `model dependency '${dependency.entity}' must use '${dependency.model}' (found '${model || "unknown"}')`;
  } catch (error) {
    return `cannot inspect model dependency '${dependency.entity}': ${String(error)}`;
  }
                                                                          
                                                                              
  return undefined;
}
function setThemeFog(runtime) {
  if ([...state.genericEvents.active.values()].some(e => e.name === "THICK_FOG" && !e.ended)) return;
  if (state.endingRuntime?.kind === "FINALE"
      && ["spawning", "active"].includes(state.endingRuntime.lifecycle)) {
    setFinaleSkyFog(); return;
  }
  const stage = campaignStageSnapshot().infiniteMode && !state.endingRuntime
    ? campaignStageSnapshot() : stageSnapshotForRuntime(runtime);
  if (themeProfile(stage.theme).name === "silenthill") {
    setSilentHillFog(state.silentHillWorld.visualDark); return;
  }
  const fog = Instance.FindEntityByName("fog");
  const profile = THEME_FOG_PROFILES[themeProfile(stage.theme).name];
  if (!validEntity(fog) || !profile) return;
  fireTarget(fog, "SetFogStartDistance", String(profile.start));
  fireTarget(fog, "SetFogEndDistance", String(profile.end));
  fireTarget(fog, "SetFogMaxOpacity", String(profile.density));
  fireTarget(fog, "SetFogColor", profile.color);
}
function clearGenericEvents() {
  for (const event of [...state.genericEvents.active.values()]) endGenericEvent(event, { reset: true });
  clearPledgePrompt();
  state.genericEvents.cooldown = undefined; state.genericEvents.failChance = 0;
  state.genericEvents.lastEvaluatedLevel = undefined;
  state.genericEvents.fallDamageDisabledUntil = 0;
  state.genericEvents.bloodlustHits.clear();
}
function handleGenericPlayerDamage(event) {
  const attacker = resolvePawn(event.attacker);
  const victim = resolvePawn(event.player);
  if ([...state.genericEvents.active.values()].some(e => e.name === "BLOODLUST")
    && Number(event.damage) > 0 && attacker?.GetTeamNumber?.() === 3 && victim?.GetTeamNumber?.() === 2)
    state.genericEvents.bloodlustHits.set(attacker, true);
}
function genericEventChat(event) {
  const pawn = resolvePawn(event?.player ?? event?.controller ?? event?.pawn);
                                                                           
                                                                                
  const text = String(event?.text ?? event?.message ?? "").trim().toLowerCase();
  if (text !== "i pledge to do my part for the collective") return;
  for (const pledge of state.genericEvents.active.values()) {
    if (pledge.name === "PLEDGE" && pledge.pledged.delete(pawn)) {
      hidePledgePromptForPlayer(pawn);
      playSourceAudioCue(3529, pawn.GetAbsOrigin(), {recipient:pawn});
    }
  }
}

function genericEventTrackEntity(event, runtime, entity) {
  if (!validEntity(entity)) return entity;
  event.entities ??= new Set();
  event.entities.add(entity);
  event.entityRuntime?.entities?.add(entity);
  return entity;
}

function spawnGenericEventVisual(event, runtime, feature, model, position, angles = { pitch: 0, yaw: 0, roll: 0 }) {
  const visual = spawnVisual(event.entityRuntime, { position, angles, feature }, model);
  genericEventTrackEntity(event, runtime, visual);
  return visual;
}

function spawnGenericEventDamageCarrier(event, runtime, position, angles, health, feature) {
  const templates = [state.featureTemplates.get("model"), state.templates.get("floor")];
  let carrier;
  for (const template of templates) {
    if (!validEntity(template) || typeof template.ForceSpawn !== "function") continue;
    let spawned;
    try {
      spawned = spawnRoundEntities(template, position, angles) ?? [];
      finalizeSpawned(runtime, { position, angles, feature }, spawned);
    } catch {
      continue;
    }
    carrier = spawned.find((entity) => validEntity(entity)
      && !String(entity.GetClassName?.() ?? "").toLowerCase().startsWith("trigger_")
      && typeof entity.SetHealth === "function");
    if (carrier) {
      for (const entity of spawned) {
        if (entity === carrier || !validEntity(entity)) continue;
        entity.Kill?.();
        runtime.entities.delete(entity);
      }
      break;
    }
    for (const entity of spawned) {
      if (validEntity(entity)) entity.Kill?.();
      runtime.entities.delete(entity);
    }
  }
  if (!carrier) throw new Error(`${feature}: damage carrier prototype did not spawn`);
  carrier.SetEntityName?.(`${feature}_${event.id}`);
  carrier.SetMaxHealth?.(health);
  carrier.SetHealth?.(health);
  carrier.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(carrier, "SetRenderMode", "1");
  fireTarget(carrier, "SetRenderAlpha", "0");
  fireTarget(carrier, "SetSolid", "3");
  raceSetCollisionGroup(carrier, 10);
  fireTarget(carrier, "DisableMotion");
  genericEventTrackEntity(event, runtime, carrier);
  return carrier;
}

function genericPizzaBreak(event) {
  if (!event?.pizza || event.ended || event.pizza.broken) return false;
  event.pizza.broken = true;
  event.pizza.brokenAt = Instance.GetGameTime();
  event.pizza.visual?.SetColor?.({ r: 100, g: 50, b: 50, a: 255 });
  for (const [delay, text] of [[0, "WE DID IT!"], [1.03, "the pizza of doom is flying away"], [2.06, "we are finally safe"]])
    for (let i = 0; i < 3; i++) genericEventTask(event, delay + i * 0.01, () => announce(`EVENT: ${text}`));
  return true;
}

function genericNativeEventSpawn(event, templateName, position, roles) {
  const template = Instance.FindEntityByName(templateName);
  if (!validEntity(template) || typeof template.ForceSpawn !== "function")
    throw new Error(`missing native template '${templateName}'`);
                                                                             
                                                                             
  const spawned = spawnRoundEntities(template, position, { pitch: 0, yaw: 0, roll: 0 }) ?? [];
  for (const entity of spawned) genericEventTrackEntity(event, event.entityRuntime, entity);
  const result = {};
  for (const [role, prefix] of Object.entries(roles)) {
    const matches = spawned.filter(entity => validEntity(entity)
      && (entity.GetEntityName?.() === prefix || entity.GetEntityName?.().startsWith(`${prefix}&`)));
    if (matches.length !== 1) throw new Error(`${templateName}: expected exactly one '${prefix}', found ${matches.length}`);
    result[role] = matches[0];
  }
  return result;
}

function genericEventKillHuman(event, pawn, inflictor) {
  if (event.ended || !validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) return false;
  pawn.TakeDamage({ damage: 999999, inflictor,
    damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0) });
  return true;
}

function genericEventFinaleAllowed(name, runtime) {
  if (runtime?.kind !== "FINALE") return true;
  if (name === "PIZZADOOM") return runtime.escapeStartedAt !== undefined;
  if (name === "WORLD_EATER") return runtime.bossLogoScheduled === true;
  return true;
}

function genericBeamTouchesPawn(beam, pawn) {
  const hull = playerCollisionHull(pawn);
  if (!hull || !beam?.position) return false;
                                                                         
                                                                           
  const start = sub(beam.pawnCenters?.get(pawn) ?? hull.center, beam.previousPosition ?? beam.position);
  const end = sub(hull.center, beam.position);
  const radians = (beam.angles?.yaw ?? 0) * Math.PI / 180;
  const forward = vec(Math.cos(radians), Math.sin(radians), 0);
  const left = vec(-forward.y, forward.x, 0);
  let near = 0, far = 1;
                                                                         
                                                         
  for (const axis of [forward, left, vec(1, 0, 0), vec(0, 1, 0), vec(0, 0, 1)]) {
    const dot = (a, b) => a.x * b.x + a.y * b.y + a.z * b.z;
    const extent = GENERIC_BEAMGRID_CONFIG.halfLength * Math.abs(dot(axis, forward))
      + GENERIC_BEAMGRID_CONFIG.halfWidth * (Math.abs(dot(axis, left)) + Math.abs(axis.z))
      + hull.halfWidth * (Math.abs(axis.x) + Math.abs(axis.y)) + hull.halfHeight * Math.abs(axis.z);
    const offset = dot(start, axis), movement = dot(sub(end, start), axis);
    if (Math.abs(movement) < 0.000001) {
      if (Math.abs(offset) > extent) return false;
      continue;
    }
    const a = (-extent - offset) / movement, b = (extent - offset) / movement;
    near = Math.max(near, Math.min(a, b));
    far = Math.min(far, Math.max(a, b));
    if (near > far) return false;
  }
  return true;
}

function spawnGenericBeam(event, runtime, now) {
                                                                            
                                                                          
  const level = state.pendingLevel ?? state.currentLevel ?? runtime;
  const origin = runtime.kind === "FINALE" ? event.beamOrigin
    : level.center ?? level.anchor ?? event.beamOrigin;
  const position = add(origin, vec(
    (Math.random() * 2 - 1) * GENERIC_BEAMGRID_CONFIG.randomXY,
    (Math.random() * 2 - 1) * GENERIC_BEAMGRID_CONFIG.randomXY,
    GENERIC_BEAMGRID_CONFIG.spawnHeight,
  ));
  const angles = { pitch: 0, yaw: Math.random() * 360, roll: 0 };
  const visual = spawnGenericEventVisual(event, runtime, "genericBeamGrid", GENERIC_BEAMGRID_CONFIG.model, position, angles);
  visual.SetModelScale?.(3);
  visual.SetColor?.({ r: 0, g: 0, b: 0, a: 255 });
  visual.Glow({ r: 255, g: 255, b: 0, a: 255 });
  const beam = { visual, position, initialPosition: clone(position), angles,
    spawnedAt: now, armedAt: now + 0.02, moveAt: undefined, fadeAlpha: 255, glowLevel: 255,
    touched: new Set(), pawnCenters: new Map() };
  event.beams.push(beam);
  return beam;
}

function startGenericBeamMove(event) {
  const now = Instance.GetGameTime(), config = GENERIC_BEAMGRID_CONFIG;
  event.beamStartAt = now;
  event.beamMoveAt = now + config.moverOpenDelay;
  event.beamFadeAt = now + config.lifetime - config.fadeDuration;
  event.beamKillAt = now + config.lifetime;
  event.endsAt = event.beamKillAt + config.activeEndPadding;
  for (const beam of event.beams) beam.moveAt = event.beamMoveAt;
  announce("EVENT: look out for the grid of beams above");
  genericEventTask(event, 1.03, () => announce("EVENT: they're coming down"));
  genericEventTask(event, config.lifetime, () => retireGenericBeams(event));
  genericEventTask(event, config.lifetime + config.activeEndPadding,
    () => endGenericEvent(event, { natural: true }));
}

function spawnGenericBeamTick(event) {
  const config = GENERIC_BEAMGRID_CONFIG;
                                                                        
                                                                                 
  if (event.beamSpawned >= config.amount) {
    genericEventTask(event, config.startMoveDelay + config.startMovePadding,
      () => startGenericBeamMove(event));
    return;
  }
  spawnGenericBeam(event, event.runtime, Instance.GetGameTime());
  event.beamSpawned++;
  genericEventTask(event, config.spawnRate, () => spawnGenericBeamTick(event));
}

function retireGenericBeams(event) {
  for (const beam of event.beams ?? []) {
    if (validEntity(beam.visual)) beam.visual.Kill();
    event.entities.delete(beam.visual);
    event.entityRuntime.entities.delete(beam.visual);
    beam.retired = true;
    beam.pawnCenters.clear();
  }
}

function processGenericBeamGrid(event, now) {
  const config = GENERIC_BEAMGRID_CONFIG;
  if (event.beamKillAt !== undefined && now >= event.beamKillAt) {
    retireGenericBeams(event); return;
  }
  for (const beam of event.beams ?? []) {
    if (beam.retired || !validEntity(beam.visual)) continue;
    beam.previousPosition = clone(beam.position);
    if (beam.moveAt !== undefined && now >= beam.moveAt) {
                                                                         
                                                                            
      beam.position = add(beam.initialPosition, vec(0, 0, -config.speed * (now - beam.moveAt)));
      beam.visual.Teleport({ position: beam.position, angles: beam.angles, velocity: vec() });
    }
    if (event.beamFadeAt !== undefined && now >= event.beamFadeAt) {
      const elapsed = now - event.beamFadeAt;
      const alpha = Math.max(0, Math.round(255 * (1 - elapsed / config.fadeDuration)));
      if (beam.fadeAlpha !== alpha) {
        beam.visual.SetColor({ r: 0, g: 0, b: 0, a: alpha }); beam.fadeAlpha = alpha;
      }
                                                                                    
      const glow = Math.max(5, 255 - config.glowFadeStep * Math.floor(elapsed / config.glowFadeInterval + 0.000001));
      if (beam.glowLevel !== glow) {
        beam.visual.Glow({ r: glow, g: glow, b: 0, a: 255 }); beam.glowLevel = glow;
      }
    }
    if (now < beam.armedAt) continue;
    for (const pawn of genericEventPlayers()) {
      if (!beam.touched.has(pawn) && genericBeamTouchesPawn(beam, pawn)) {
        beam.touched.add(pawn);
                                                                               
        pawn.TakeDamage({ damage: config.damage,
          damageFlags: CSDamageFlags.FORCE_DEATH | CSDamageFlags.IGNORE_ARMOR,
          damageTypes: CSDamageTypes.GENERIC, inflictor: beam.visual });
      }
      beam.pawnCenters.set(pawn, clone(playerCollisionHull(pawn).center));
    }
    for (const pawn of beam.pawnCenters.keys()) {
      if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) beam.pawnCenters.delete(pawn);
    }
  }
}

function spawnGenericPizza(event, runtime) {
  const config = GENERIC_PIZZADOOM_CONFIG;
  const target = genericEventPlayers().find(pawn => pawn.GetAbsOrigin().z >= -5000);
  if (!target) { endGenericEvent(event); return false; }
  const position = add(target.GetAbsOrigin(), vec(0, 0, config.spawnHeight));
  position.z = Math.min(position.z, config.maxSpawnZ);
  const { visual, carrier, sound1, sound2, sound3 } = genericNativeEventSpawn(event, config.template, position, {
    visual: "event_pizza_visual", carrier: "event_pizza_hp",
    sound1: "event_pizza_sound1", sound2: "event_pizza_sound2", sound3: "event_pizza_sound3",
  });
  const now = Instance.GetGameTime();
  const angles = { pitch: 0, yaw: Math.random() * 360, roll: 0 };
  visual.Teleport({ position, angles, velocity: vec() });
  visual.SetModelScale(1.01);
  fireTarget(visual, "Enable");
  visual.SetColor?.({ r: 200, g: 120, b: 120, a: 255 });
  const health = config.healthFloor + config.hpBase + config.hpEachHuman * genericEventPlayers().length;
  carrier.SetMaxHealth?.(health); carrier.SetHealth(health);
  carrier.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(carrier, "SetRenderMode", "1"); fireTarget(carrier, "SetRenderAlpha", "0");
  fireTarget(carrier, "DisableMotion"); raceSetCollisionGroup(carrier, 10);
  carrier.Teleport({ position, angles, velocity: vec() });
  event.pizza = { visual, carrier, position, previousPosition: clone(position), angles,
    sounds: [sound1, sound2, sound3], scale: config.scaleStart, broken: false,
    lastAt: now, scaleAt: now, moveAt: now + 0.70, rotationAt: now + 0.10,
    startZ: position.z, contactAt: now + 0.10, fxUntil: [], contactBursts: new Set(),
    spin: Math.random() < 0.5 ? -1 : 1, pawnCenters: new Map(), nextPitchAt: now };
  const checkHealth = () => {
    if (!event.ended && (!validEntity(carrier) || Number(carrier.GetHealth()) <= config.healthFloor)) genericPizzaBreak(event);
  };
                                                                           
                                                                  
  connectOwnedOutput(event.entityRuntime, carrier, "OnHealthChanged", checkHealth);
  connectOwnedOutput(event.entityRuntime, carrier, "OnBreak", () => genericPizzaBreak(event));
  for (const sound of event.pizza.sounds) {
    sound.Teleport({ position }); fireTarget(sound, "Pitch", "50");
    fireTarget(sound, "PlaySound"); fireTarget(sound, "Volume", "100");
  }
  for (const [delay, text, repeats] of [[0.7, "WHAT THE HELL IS THAT?!", 1], [6, "LOOK UP!", 3],
    [9, "THE PIZZA OF DOOM IS COMING OUR WAY!", 3], [11, "SHOOT IT OR PERISH!", 3]])
    for (let i = 0; i < repeats; i++) genericEventTask(event, delay + i * 0.01, () => announce(`EVENT: ${text}`));
  return true;
}

function retireGenericPizzaContactFx(event, burst, stop = false) {
  if (!burst || burst.retired) return;
  burst.retired = true;
  for (const entity of burst.entities) {
    if (validEntity(entity)) {
                                                                           
                                                                        
      if (stop) fireTarget(entity, burst.particles.has(entity) ? "Stop" : "StopSound");
      entity.Kill?.();
    }
    event.entities?.delete(entity);
    event.entityRuntime?.entities?.delete(entity);
  }
  event.pizza?.contactBursts?.delete(burst);
}

function spawnGenericPizzaContactFx(event, position, now) {
  const pizza = event.pizza, config = GENERIC_PIZZADOOM_CONFIG;
  pizza.fxUntil = pizza.fxUntil.filter(until => until > now);
                                                                         
                                                                           
  if (pizza.fxUntil.length > config.fxLimit) return false;
  const roles = { blood: "event_pizza_contact_blood", flash: "event_pizza_contact_flash" };
  for (let i = 1; i <= config.soundStack; i++) {
    roles[`aggressive${i}`] = `event_pizza_contact_aggressive${i}`;
    roles[`splotion${i}`] = `event_pizza_contact_splotion${i}`;
  }
  const members = genericNativeEventSpawn(event, config.contactFxTemplate, position, roles);
  const entities = Object.values(members), particles = new Set([members.blood, members.flash]);
  const burst = { entities, particles, retired: false };
  pizza.contactBursts.add(burst);
                                                                         
                                                                           
  for (const entity of entities) {
    const expected = particles.has(entity) ? "info_particle_system" : "ambient_generic";
    if (entity.GetClassName?.() !== expected) throw new Error(`pizza contact FX expected ${expected}`);
  }
  pizza.fxUntil.push(now + config.contactFxWindow);
  const randomAngles = () => ({ pitch: 75 + Math.floor(Math.random() * 31),
    yaw: Math.floor(Math.random() * 361), roll: -15 + Math.floor(Math.random() * 31) });
  for (const particle of particles) {
    particle.Teleport({ position: clone(position), angles: randomAngles(), velocity: vec() });
    fireTarget(particle, "Start");
  }
  const pitch = 40 + Math.floor(Math.random() * 61), soundPosition = add(position, vec(0, 0, 8));
  for (const sound of entities.filter(entity => !particles.has(entity))) {
    sound.Teleport({ position: soundPosition });
    fireTarget(sound, "Pitch", String(pitch));
    fireTarget(sound, "Volume", "100");
    fireTarget(sound, "PlaySound");
  }
  genericEventTask(event, config.contactFxLifetime, () => retireGenericPizzaContactFx(event, burst));
  return true;
}

function processGenericPizza(event, now) {
  const pizza = event.pizza, config = GENERIC_PIZZADOOM_CONFIG;
  if (!validEntity(pizza.visual)) { endGenericEvent(event); return; }
  if (!pizza.broken && (!validEntity(pizza.carrier) || Number(pizza.carrier.GetHealth()) <= config.healthFloor))
    genericPizzaBreak(event);
  const oldAt = pizza.lastAt;
  pizza.lastAt = now;
  pizza.previousPosition = clone(pizza.position);
  const elapsed = Math.max(0, now - Math.max(oldAt, pizza.moveAt));
  pizza.position.z += (pizza.broken ? 1 : -1) * config.speed * elapsed;
  pizza.position.z = Math.max(pizza.startZ - config.moveDistance, Math.min(pizza.startZ, pizza.position.z));
  const ticks = Math.max(0, Math.floor((now - pizza.scaleAt + 1e-7) / config.tickRate));
  if (ticks) {
    pizza.scaleAt += ticks * config.tickRate;
    pizza.scale = pizza.broken ? Math.max(config.scaleBroken, pizza.scale * Math.pow(1 - config.scaleShrink, ticks))
      : Math.min(config.scaleMax, pizza.scale * Math.pow(1 + config.scaleGrow, ticks));
    pizza.visual.SetModelScale(pizza.scale);
  }
  pizza.angles.yaw = (pizza.angles.yaw + pizza.spin * config.rotationSpeed
    * Math.max(0, now - Math.max(oldAt, pizza.rotationAt))) % 360;
  pizza.visual.Teleport({ position: pizza.position, angles: pizza.angles, velocity: vec() });
  if (validEntity(pizza.carrier)) pizza.carrier.Teleport({ position: pizza.position, angles: pizza.angles, velocity: vec() });
  for (const sound of pizza.sounds) if (validEntity(sound)) sound.Teleport({ position: pizza.position });
  if (pizza.broken && now >= pizza.nextPitchAt) {
    pizza.nextPitchAt = now + 0.10;
    const pitch = Math.min(198, 50 + Math.floor((now - pizza.brokenAt) / 0.10) * 2);
    for (const sound of pizza.sounds) if (validEntity(sound)) fireTarget(sound, "Pitch", String(pitch));
  }
  if (pizza.broken && pizza.scale <= config.scaleBroken) { endGenericEvent(event); return; }
  if (now < pizza.contactAt) return;
                                                                            
                                                                             
  for (const pawn of genericEventPlayers()) {
    const hull = playerCollisionHull(pawn);
    if (!hull) continue;
    const start = sub(pizza.pawnCenters.get(pawn) ?? hull.center, pizza.previousPosition);
    const end = sub(hull.center, pizza.position);
    const touches = genericPizzaHullSweep(pizza.angles.yaw, start, end, hull);
    pizza.pawnCenters.set(pawn, clone(hull.center));
    const contactPosition = touches ? clone(pawn.GetAbsOrigin()) : undefined;
    if (touches && genericEventKillHuman(event, pawn, pizza.visual)) {
      genericEventTask(event, 1.55, () => announce("EVENT: THE PIZZA IS AGGRESSIVE!"));
      spawnGenericPizzaContactFx(event, contactPosition, now);
    }
  }
  for (const pawn of pizza.pawnCenters.keys()) if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3)
    pizza.pawnCenters.delete(pawn);
}

function genericPizzaHullSweep(yaw, start, end, hull) {
  const radians = yaw * Math.PI / 180;
  const forward = vec(Math.cos(radians), Math.sin(radians), 0), left = vec(-forward.y, forward.x, 0);
  const half = GENERIC_PIZZADOOM_CONFIG.contactHalfSize;
  const dot = (p, q) => p.x * q.x + p.y * q.y + p.z * q.z;
  let near = 0, far = 1;
                                                                             
                                                                             
  for (const axis of [forward, left, vec(1, 0, 0), vec(0, 1, 0), vec(0, 0, 1)]) {
    const extent = half.x * Math.abs(dot(axis, forward)) + half.y * Math.abs(dot(axis, left)) + half.z * Math.abs(axis.z)
      + hull.halfWidth * (Math.abs(axis.x) + Math.abs(axis.y)) + hull.halfHeight * Math.abs(axis.z);
    const offset = dot(start, axis), movement = dot(sub(end, start), axis);
    if (Math.abs(movement) < 1e-7) { if (Math.abs(offset) > extent) return false; continue; }
    const a = (-extent - offset) / movement, b = (extent - offset) / movement;
    near = Math.max(near, Math.min(a, b)); far = Math.min(far, Math.max(a, b));
    if (near > far) return false;
  }
  return true;
}

function spawnGenericDoorhug(event, runtime) {
                                                                           
  const level = state.pendingLevel ?? state.currentLevel ?? runtime;
  const direction = level.incoming ?? level.direction ?? state.currentDirection ?? vec(1, 0, 0);
  const base = level.start ?? level.entry ?? level.anchor ?? vec();
  const config = GENERIC_DOORHUG_CONFIG;
  const position = add(add(base, mul(direction, -(CONFIG.bufferSize * CONFIG.gridSize)
    + config.spawnOffset)), vec(0, 0, 64));
  const angles = {
    pitch: -25, yaw: normalizeYaw(yawOf(direction) + 180), roll: 0,
  };
  const visual = spawnGenericEventVisual(event, runtime, "genericDoorhug", config.model, position, angles);
  visual.SetModelScale?.(config.modelScale);
  visual.SetColor?.({ r: 255, g: 0, b: 0, a: 0 });
  visual.Glow({ r: 200, g: 100, b: 0, a: 255 });
  event.doorhug = { visual, position, angles, spawnedAt: Instance.GetGameTime(), exploded: false };
                                                                              
                                                                            
                                                                        
                                                                        
  const applyPose = () => {
    if (event.ended || event.doorhug.exploded || !validEntity(visual)) return;
    fireTarget(visual, "SetAnimation", "baseidle");
    fireTarget(visual, "SetDefaultAnimation", "baseidle");
    visual.Teleport({ position, angles, velocity: vec() });
  };
  applyPose();
  afterThink(applyPose);
                                                                          
                                                                              
  for (let alpha = 0, step = 0; alpha <= 255; alpha += config.fadeAlphaStep, step++) {
    genericEventTask(event, step * config.fadeInterval, () => {
      if (!validEntity(visual)) return;
      visual.SetColor?.({ r: 255, g: 0, b: 0, a: alpha });
      fireTarget(visual, "SetRenderAlpha", String(alpha));
    });
  }
  for (let index = 0; index < config.soundSpamPre; index++) {
    playSourceAudioCue(4407, position, { pitch: 60 + Math.floor(Math.random() * 41) });
  }
  genericEventTask(event, config.explodeTime, () => genericDoorhugExplode(event));
}

function genericDoorhugExplode(event) {
  if (!event?.doorhug || event.doorhug.exploded) return false;
  event.doorhug.exploded = true;
  const config = GENERIC_DOORHUG_CONFIG, visual = event.doorhug.visual;
  const origin = clone(visual?.GetAbsOrigin?.() ?? event.doorhug.position);
  const explosionOrigin = add(origin, vec(0, 0, -32));
  event.doorhug.explosionOrigin = explosionOrigin;
  genericEventTask(event, config.explosionDispatchDelay, () => {
                                                                       
                                                                         
    for (const pawn of genericEventPlayers()) {
      const position = pawn.GetAbsOrigin?.();
      if (!position) continue;
      const distance = Math.hypot(position.x - explosionOrigin.x,
        position.y - explosionOrigin.y, position.z - explosionOrigin.z);
      if (distance <= config.radius) damagePawn(pawn, config.damage, undefined, visual, CSDamageTypes.BLAST);
    }
  });
  for (let index = 0; index < config.soundSpamExplosion; index++) {
    playSourceAudioCue(4399, origin, { pitch: 200 + Math.floor(Math.random() * 56) });
    playSourceAudioCue(4400, origin, { pitch: 200 + Math.floor(Math.random() * 56) });
  }
  genericEventTask(event, config.visualKillDelay, () => {
    if (validEntity(visual)) visual.Kill();
    event.entities.delete(visual);
    event.entityRuntime.entities.delete(visual);
  });
  return true;
}

function genericWorldEaterSpawnCursor(runtime) {
                                                                          
                                                                          
                                                                
  if (runtime === state.pendingLevel && runtime.sourceGenerationOrigin)
    return runtime.sourceGenerationOrigin;
  if (runtime.kind === "FINALE")
    return runtime.escape?.lastEnd ?? runtime.anchor ?? state.nextBridgeStart ?? vec();
  return runtime.end ?? runtime.anchor ?? state.nextBridgeStart ?? vec();
}

function spawnGenericWorldEater(event, runtime) {
  const config = GENERIC_WORLD_EATER_CONFIG;
                                                                        
                                                           
  const spawnPosition = add(genericWorldEaterSpawnCursor(runtime), vec(0, 0, config.spawnHeight));
  spawnPosition.z = Math.min(spawnPosition.z, config.maxSpawnZ);
  const parts = genericNativeEventSpawn(event, config.template, spawnPosition, {
    visual: "event_world_eater_visual", carrier: "i_vauffworldeater_hp",
    trigger: "i_vauffworldeater_trigger", sound1: "event_world_eater_hum1", sound2: "event_world_eater_hum2",
  });
  const { visual, carrier, trigger, sound1, sound2 } = parts;
  if (typeof carrier.SetHealth !== "function" || typeof carrier.GetHealth !== "function")
    throw new Error("WORLD_EATER native func_physbox must expose health");
  let zombies = 0;
  for (const controller of Instance.GetAllPlayerControllers()) {
    const pawn = controller.GetPlayerPawn?.();
    if (controller.IsValid?.() && (controller.GetTeamNumber?.() ?? pawn?.GetTeamNumber?.()) === 2) zombies++;
  }
  const health = config.hpBase + config.hpEachHuman * genericEventPlayers().length + config.hpEachZombie * zombies;
  carrier.SetMaxHealth?.(health); carrier.SetHealth(health);
  fireTarget(carrier, "DisableMotion"); raceSetCollisionGroup(carrier, 10);
  carrier.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(carrier, "SetRenderMode", "1"); fireTarget(carrier, "SetRenderAlpha", "0");
  visual.SetModelScale(300);
  visual.SetColor?.({ r: 255, g: 255, b: 255, a: 0 });
  fireTarget(visual, "SetRenderMode", "1"); fireTarget(visual, "Enable");
  fireTarget(visual, "SetAnimation", "idle"); fireTarget(visual, "SetDefaultAnimation", "idle");
  const now = Instance.GetGameTime();
  const position = clone(visual.GetAbsOrigin());
  const angles = visual.GetAbsAngles();
  const basis = [forwardFromAngles(angles), leftFromAngles(angles), upFromAngles(angles)];
  const dot = (p, q) => p.x * q.x + p.y * q.y + p.z * q.z;
  const offsets = new Map([carrier, trigger].map(entity => {
    const delta = sub(entity.GetAbsOrigin(), position);
    return [entity, vec(...basis.map(axis => dot(delta, axis)))];
  }));
  event.worldEater = { ...parts, position, angles, offsets, dead: false, spawnedAt: now,
    lastAt: now + 0.10, nextLogicAt: now + 0.10, nextHumAt: now + 0.10,
    direction: forwardFromAngles(angles), target: undefined, humIndex: -1 };
  connectOwnedOutput(event.entityRuntime, trigger, "OnStartTouch", touch => {
    if (!event.worldEater.dead) genericEventKillHuman(event, resolvePawn(touch?.activator), visual);
  });
  connectOwnedOutput(event.entityRuntime, carrier, "OnBreak", () => genericWorldEaterDie(event));
  connectOwnedOutput(event.entityRuntime, carrier, "OnHealthChanged", () => {
    if (!validEntity(carrier) || Number(carrier.GetHealth()) <= 0) genericWorldEaterDie(event);
  });
  genericEventTask(event, 0.10, () => fireTarget(trigger, "Enable"));
  for (const [delay, text] of [[10, "you're feeling watched"], [30, "something is coming for you"],
    [50, "you sense a looming presence above you"]])
    genericEventTask(event, delay, () => announce(`EVENT: ${text}`));
  return true;
}

function genericWorldEaterDie(event) {
  const eater = event?.worldEater;
  if (!eater || event.ended || eater.dead) return false;
  eater.dead = true; eater.deadAt = Instance.GetGameTime();
  event.cost = 0;                                                               
  if (validEntity(eater.trigger)) eater.trigger.Kill();
  if (validEntity(eater.carrier)) eater.carrier.Kill();
  fireTarget(eater.visual, "SetAnimation", "die"); fireTarget(eater.visual, "SetDefaultAnimation", "die");
  for (const sound of [eater.sound1, eater.sound2]) {
    if (validEntity(sound)) fireTarget(sound, "Pitch", "255");
    genericEventTask(event, 0.25, () => { if (validEntity(sound)) fireTarget(sound, "Pitch", "255"); });
    genericEventTask(event, 0.50, () => { if (validEntity(sound)) { fireTarget(sound, "StopSound"); sound.Kill(); } });
  }
                                                                           
                                                                     
  return true;
}

function genericWorldEaterEat(event) {
  const eater = event.worldEater, config = GENERIC_WORLD_EATER_CONFIG;
  if (state.endingRuntime?.kind === "FINALE") return;
  const within = position => position && distance2D(position, eater.position) <= config.eatRadius
    && Math.abs(position.z - eater.position.z) <= config.eatHeight;
  event.eatingPieces ??= new Set();
  for (const runtime of activeRuntimes()) {
    if (runtime.kind === "FINALE") continue;
    const buttonEntities = new Set();
    for (const interaction of runtime.blockInteractions?.values() ?? []) {
      for (const entity of interaction.entities ?? []) buttonEntities.add(entity);
                                                                         
                                                                         
      if (within(interaction.position) && validEntity(interaction.button)) interaction.press?.();
    }
    for (const terrain of [...runtime.terrainEntities ?? []]) {
      if (!validEntity(terrain) || buttonEntities.has(terrain) || runtime.safeTerrainEntities?.has(terrain)
        || terrain === runtime.endIndicator || !within(terrain.GetAbsOrigin?.())) continue;
      for (const volume of [...runtime.movementVolumes ?? []])
        if (volume.terrain?.has(terrain)) disableMovementVolume(runtime, volume);
                                                                            
                                                                              
      let rubble;
      if (event.eatingPieces.size < 40 && !terrain.GetParent?.() && terrain.GetModelName?.()) {
        const position = terrain.GetAbsOrigin(), angles = terrain.GetAbsAngles();
        rubble = spawnRacePhysicsRubbleFallback(event.entityRuntime,
          { position, angles, feature: "worldEaterTerrain", velocity: vec() }, terrain.GetModelName());
        if (validEntity(rubble)) {
          const color = terrain.GetColor?.() ?? terrain.collectiveBaseColor;
          if (color) rubble.SetColor?.(color);
          if (terrain.collectiveBodyGroup !== undefined)
            fireTarget(rubble, "SetBodyGroup", `Main,${terrain.collectiveBodyGroup}`);
          event.eatingPieces.add(rubble); genericEventTrackEntity(event, event.entityRuntime, rubble);
          raceSetCollisionGroup(rubble, 10); fireTarget(rubble, "DisableMotion");
          genericEventTask(event, 0.02, () => { if (validEntity(rubble)) fireTarget(rubble, "EnableMotion"); });
          genericEventTask(event, 2.50, () => {
            if (validEntity(rubble)) rubble.Kill();
            event.eatingPieces.delete(rubble); event.entities.delete(rubble); event.entityRuntime.entities.delete(rubble);
          });
        }
      }
                                                                            
                                                                        
      killTerrainCompanions(runtime, terrain);
      terrain.Kill(); runtime.terrainEntities.delete(terrain); runtime.entities.delete(terrain);
    }
    for (const item of [...runtime.items ?? []]) {
                                                                            
                                                                     
      if (!item.holder && ["world", "dropped"].includes(item.state) && within(item.position)) {
        cancelItemTasks(runtime, item); cleanupItemEffects(runtime, item); consumeItem(runtime, item);
      }
    }
    for (const trap of runtime.traps ?? []) if (!trap.spent && within(trap.position)) {
      if (trap.name === "kart") cleanupKartController(runtime, trap, false);
      else spendTrap(trap);
    }
  }
  if (state.currentLevel && within(state.currentLevel.end)) reachEnd();
}

function processGenericWorldEater(event, now) {
  const eater = event.worldEater, config = GENERIC_WORLD_EATER_CONFIG;
  if (!validEntity(eater.visual)) { endGenericEvent(event); return; }
  if (!eater.dead && (!validEntity(eater.carrier) || Number(eater.carrier.GetHealth()) <= 0)) genericWorldEaterDie(event);
  if (eater.dead) {
    const steps = Math.max(0, Math.floor((now - eater.deadAt - 0.11) / 0.10));
    const alpha = Math.max(0, 255 - steps * 2);
    eater.visual.SetColor?.({ r: 255, g: 255, b: 255, a: alpha });
    if (now >= eater.deadAt + 12.91) endGenericEvent(event);
    return;
  }
  const age = now - eater.spawnedAt;
  eater.visual.SetColor?.({ r: 255, g: 255, b: 255,
    a: age < 0.11 ? 0 : Math.min(255, Math.floor((age - 0.11) / 0.05) * 5) });
  if (now < eater.spawnedAt + 0.10) return;
  if (now >= eater.nextLogicAt) {
    eater.nextLogicAt = now + config.logicInterval;
    fireTarget(eater.trigger, "Disable");
    genericEventTask(event, 0.02, () => { if (!eater.dead && validEntity(eater.trigger)) fireTarget(eater.trigger, "Enable"); });
    genericWorldEaterEat(event);
    if (!validEntity(eater.target) || !eater.target.IsAlive?.() || eater.target.GetTeamNumber?.() !== 3) {
      const humans = genericEventPlayers();
      eater.target = humans[Math.floor(Math.random() * humans.length)];
    }
    if (eater.humIndex >= 0) fireTarget([eater.sound1, eater.sound2][eater.humIndex], "Volume", "10");
  }
  if (now >= eater.nextHumAt) {
    eater.nextHumAt = now + config.humInterval; eater.humIndex = (eater.humIndex + 1) % 2;
    const sound = [eater.sound1, eater.sound2][eater.humIndex];
    fireTarget(sound, "StopSound"); fireTarget(sound, "Volume", "0");
    genericEventTask(event, 0.05, () => {
      if (!eater.dead && validEntity(sound)) { fireTarget(sound, "PlaySound"); fireTarget(sound, "Volume", "10"); }
    });
  }
                                                                            
                                                                      
  let remaining = Math.max(0, now - eater.lastAt); eater.lastAt = now;
  const steps = Math.min(100, Math.ceil(remaining / 0.01));
  for (let i = 0; i < steps; i++) {
    const dt = remaining / (steps - i); remaining -= dt;
    if (validEntity(eater.target) && eater.target.IsAlive?.())
      eater.direction = finaleKamikazeNormalize(sub(add(eater.target.GetAbsOrigin(), vec(0, 0, config.targetOffset)), eater.position), eater.direction);
    eater.position = add(eater.position, mul(eater.direction, config.speed * dt));
  }
  eater.angles = anglesFromDirection(eater.direction);
  eater.visual.Teleport({ position: eater.position, angles: eater.angles, velocity: vec() });
  const basis = [forwardFromAngles(eater.angles), leftFromAngles(eater.angles), upFromAngles(eater.angles)];
  for (const [entity, offset] of eater.offsets) {
    if (!validEntity(entity)) continue;
    const position = add(eater.position, add(add(mul(basis[0], offset.x), mul(basis[1], offset.y)), mul(basis[2], offset.z)));
    entity.Teleport({ position, angles: { ...eater.angles, pitch: eater.angles.pitch - 90 }, velocity: vec() });
  }
  for (const sound of [eater.sound1, eater.sound2]) if (validEntity(sound)) sound.Teleport({ position: eater.position });
}

function genericBigNadeExplode(event, projectile, position) {
  if (!event?.projectiles?.has(projectile)) return false;
  const record = event.projectiles.get(projectile);
  event.projectiles.delete(projectile);
  const origin = position ?? projectile.GetAbsOrigin?.();
  if (!origin) return false;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() !== 2 || !pawn.IsAlive?.()) continue;
    const pawnPosition = pawn.GetAbsOrigin?.();
    if (!pawnPosition) continue;
    const distance = Math.hypot(pawnPosition.x - origin.x, pawnPosition.y - origin.y, pawnPosition.z - origin.z);
    if (distance > GENERIC_BIGNADES_CONFIG.hitRange) continue;
    const amount = Math.max(0, 1 - distance / GENERIC_BIGNADES_CONFIG.hitRange);
    const direction = finaleKamikazeNormalize(sub(pawnPosition, add(origin, vec(0, 0, GENERIC_BIGNADES_CONFIG.flingZOffset))), vec(0, 0, 1));
    pawn.Teleport?.({ velocity: mul(direction, GENERIC_BIGNADES_CONFIG.flingVelocity * amount) });
    pawn.TakeDamage({ damage: GENERIC_BIGNADES_CONFIG.damage * amount,
      damageFlags: CSDamageFlags.IGNORE_ARMOR, damageTypes: CSDamageTypes.BLAST,
      ...(validEntity(record.attacker) ? { attacker: record.attacker } : {}),
      ...(validEntity(projectile) ? { inflictor: projectile } : {}),
    });
    fireTarget(pawn, "IgniteLifeTime", String(GENERIC_BIGNADES_CONFIG.igniteTime));
  }
  hurtFinaleBossAt(origin, GENERIC_BIGNADES_CONFIG.bossRadius, GENERIC_BIGNADES_CONFIG.bossDamage,
    GENERIC_BIGNADES_CONFIG.bossStunChance, GENERIC_BIGNADES_CONFIG.bossStunTimeAdd,
    record.attacker, "bignades");
  playSourceAudioCue(4295, origin);
  playSourceAudioCue(4296, origin);
  if (validEntity(projectile)) fireTarget(projectile, "Kill");
  return true;
}

function handleGenericGrenadeThrow({ projectile, weapon } = {}) {
  if (!validEntity(projectile)) return;
  if (projectile.GetClassName?.() !== "hegrenade_projectile") return;
  const event = [...state.genericEvents.active.values()].find((candidate) =>
    candidate.name === "BIGNADES" && candidate.acceptingThrows !== false && !candidate.ended);
  if (!event || Instance.GetGameTime() >= event.startedAt + GENERIC_BIGNADES_CONFIG.duration) return;
  event.projectiles ??= new Map();
  const now = Instance.GetGameTime();
  event.projectiles.set(projectile, {
    lastPosition: clone(projectile.GetAbsOrigin?.() ?? vec()),
    markedAt: now,
    originalModel: projectile.GetModelName?.(),
    originalScale: projectile.GetModelScale?.() ?? 1,
    attacker: resolvePawn(projectile.GetOwner?.() ?? weapon?.GetOwner?.()),
    blowAt: now + GENERIC_BIGNADES_CONFIG.blowTime,
  });
  projectile.SetModel?.(GENERIC_BIGNADES_CONFIG.model);
  projectile.SetModelScale?.(GENERIC_BIGNADES_CONFIG.modelScale);
  projectile.SetEntityName?.(`generic_bignade_${event.id}`);
}

function genericEventSource(event) {
  return `generic_event:${event.id}:${event.name}`;
}

function genericEventPlayers(team = 3) {
  return allLivingPawns().filter((pawn) => pawn?.IsAlive?.() && pawn.GetTeamNumber?.() === team);
}

function genericEventTask(event, delay, callback) {
  if (!event || event.ended) return undefined;
  const owner = event.owner ?? `generic:${event.id}`;
  let task;
  task = schedule(delay, () => {
    event.tasks?.delete(task);
    if (event.ended) return;
    try { callback(); } catch (error) {
      message(`[EVENT ${event.name}] failed: ${String(error)}`);
      endGenericEvent(event);
    }
  }, owner);
  event.tasks ??= new Set();
  event.tasks.add(task);
  return task;
}

function cancelGenericEventTasks(event) {
  if (!event) return;
  for (const task of event.tasks ?? []) task.cancelled = true;
  if (event.owner !== undefined) {
    state.scheduledTasks = state.scheduledTasks.filter((task) => task.owner !== event.owner);
  }
  event.tasks?.clear?.();
}

function genericCollapseSource(runtime) {
  if (!runtime || !Number.isFinite(Number(runtime.index))) return undefined;
  return [...state.levels.values()]
    .filter((candidate) => candidate !== runtime)
    .filter((candidate) => Number.isFinite(Number(candidate.index)) && Number(candidate.index) < Number(runtime.index))
    .filter((candidate) => !["destroyed", "outcome_pending"].includes(candidate.lifecycle))
    .filter((candidate) => (candidate.terrainEntities?.size ?? 0) > GENERIC_COLLAPSE_CONFIG.minimumBlocks)
    .sort((a, b) => Number(b.index) - Number(a.index))[0];
}

function genericCollapseCandidates(source) {
  if (!source) return [];
  const result = [];
  for (const entity of source.terrainEntities ?? source.entities ?? []) {
    if (!validEntity(entity)) continue;
    if (source.safeTerrainEntities?.has(entity)) continue;
    if (entity === source.endIndicator) continue;
    if (entity.GetParent?.()) continue;
    const name = String(entity.GetEntityName?.() ?? "").toLowerCase();
    if (name.includes("endindicator") || name.includes("teleport") || name.includes("preview")) continue;
    result.push(entity);
  }
  return shuffleCopy(result).slice(0, GENERIC_COLLAPSE_CONFIG.maxCollapseAmount);
}

function genericCollapsePiece(event, entity) {
  if (!event || event.ended || !validEntity(entity)) return;
  const source = event.collapseSource;
  if (!source || source.lifecycle === "destroyed") return;
  const origin = entity.GetAbsOrigin?.();
  if (!origin) return;
  event.collapsed?.add(entity);
  const angles = entity.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 };
  const position = vec(origin.x, origin.y, origin.z - GENERIC_COLLAPSE_CONFIG.crumbleZLower);
  const original = entity;
  const model = original.GetModelName?.();
  if (!model) throw new Error("COLLAPSE terrain model is unavailable");
  entity = spawnRacePhysicsRubbleFallback(event.entityRuntime, {
    position, angles, feature: "genericCollapse", velocity: vec(),
  }, model);
  entity.collectiveBaseColor = original.collectiveBaseColor;
  fireTarget(entity, "DisableMotion");
  original.Kill();
  killTerrainCompanions(source, original);
  source.terrainEntities?.delete(original);
  source.entities?.delete(original);
  event.entities.add(entity);
                                                                          
                                                                              
                                                                                  
  for (const volume of source.movementVolumes ?? []) {
    if (!volume.terrain.has(original)) continue;
    event.collapsedMovementVolumes ??= new Set();
    if (event.collapsedMovementVolumes.has(volume)) continue;
    event.collapsedMovementVolumes.add(volume);
    genericEventTask(event, GENERIC_COLLAPSE_CONFIG.crumbleDelay + 0.05,
      () => disableMovementVolume(source, volume));
  }
  genericEventTask(event, GENERIC_COLLAPSE_CONFIG.crumbleDelay, () => {
    if (!validEntity(entity)) return;
    fireTarget(entity, "ClearParent");
                                                                      
                                                                         
                                                             
    raceSetCollisionGroup(entity, 10);
  });
  genericEventTask(event, GENERIC_COLLAPSE_CONFIG.crumbleDelay + 0.05, () => {
    if (validEntity(entity)) fireTarget(entity, "EnableMotion");
  });
  const fadeStart = GENERIC_COLLAPSE_CONFIG.crumbleDelay + GENERIC_COLLAPSE_CONFIG.fadeStart;
  for (let alpha = 255, step = 0; alpha > 0; alpha -= GENERIC_COLLAPSE_CONFIG.fadeStep, step++) {
    genericEventTask(event, fadeStart + step * GENERIC_COLLAPSE_CONFIG.fadeInterval, () => {
      if (!validEntity(entity)) return;
      genericTerrainAlpha(entity, Math.max(0, alpha));
    });
  }
  genericEventTask(event, fadeStart + 255 / GENERIC_COLLAPSE_CONFIG.fadeStep * GENERIC_COLLAPSE_CONFIG.fadeInterval + GENERIC_COLLAPSE_CONFIG.fadeEndPadding, () => {
    if (validEntity(entity)) entity.Kill?.();
    source.terrainEntities?.delete(entity);
    source.entities?.delete(entity);
  });
}

function finishGenericCollapse(event) {
  if (!event || event.ended || event.collapseTeleportMoved) return;
  event.collapseTeleportMoved = true;
                                                                          
                                                                             
                                
  const next = state.currentLevel && state.currentLevel !== event.collapseSource
    ? state.currentLevel
    : state.pendingLevel;
  if (next?.tp && next.incoming) moveTeleportDestination(next.tp, next.incoming);
}

function genericEventVisibleAlpha(entity, baseAlpha = 255) {
  let alpha = baseAlpha;
  for (const event of state.genericEvents.active.values()) {
    if (event.ended) continue;
    if (event.name === "PHASING") alpha = Math.min(alpha, 30);
    if (event.name === "WALLBREAK") {
      const target = event.targets?.find(target => target.entity === entity);
      if (target) alpha = Math.min(alpha, target.alpha ?? 255);
    }
  }
  return alpha;
}

function endGenericEvent(event, { reset = false, natural = false } = {}) {
  if (!event || event.ended) return;
                                                                       
                                                                              
  if (natural && event.name === "BIGNADES" && event.projectiles?.size) {
    event.acceptingThrows = false;
    const now = Instance.GetGameTime();
    event.endsAt = Math.max(now, ...[...event.projectiles.values()].map(record => record.blowAt))
      + GENERIC_BIGNADES_CONFIG.tickRate;
    genericEventTask(event, Math.max(GENERIC_BIGNADES_CONFIG.tickRate, event.endsAt - now),
      () => endGenericEvent(event, { natural: true }));
    return;
  }
  event.ended = true;
  cancelGenericEventTasks(event);
                                                                      
                                                                        
  for (const volume of event.collapsedMovementVolumes ?? [])
    disableMovementVolume(event.collapseSource, volume);
  const source = genericEventSource(event);
  if (event.name === "DEBRIS") {
    const runtime = event.debrisRuntime;
    for (const piece of event.createdRubblePieces ?? []) {
      if (runtime && piece) cleanupRaceRubblePiece(runtime, piece);
    }
    if (runtime && runtime.lifecycle !== "destroyed") {
      runtime.rubblePieces = (runtime.rubblePieces ?? []).filter((piece) => !event.createdRubblePieces?.has(piece));
      runtime.raceRubbleStarted = event.previousDebrisState?.raceRubbleStarted;
      runtime.raceRubbleStopped = event.previousDebrisState?.raceRubbleStopped;
      runtime.rubbleProfile = event.previousDebrisState?.rubbleProfile;
      runtime.rubbleSpawnedCount = event.previousDebrisState?.rubbleSpawnedCount ?? 0;
      runtime.nextRubbleAt = event.previousDebrisState?.nextRubbleAt;
    }
  } else if (event.name === "LOWGRAV") {
    for (const pawn of state.playerEffects.keys()) removeGravitySource(pawn, source);
  } else if (event.name === "PLEDGE") {
    state.genericEvents.pledgeUntil = 0;
    clearPledgePrompt();
  } else if (event.name === "THICK_FOG") {
    setThemeFog(state.currentLevel ?? state.transitionLevel ?? { stageSnapshot: event.stageSnapshot });
  } else if (event.name === "BLOODLUST") {
    state.genericEvents.bloodlustHits.clear();
  } else if (event.name === "SILENCE") {
    if (validEntity(event.ringingEmitter)) {
      fireTarget(event.ringingEmitter, "Volume", "0");
      fireTarget(event.ringingEmitter, "StopSound", "");
    }
  } else if (event.name === "PHASING") {
    for (const entity of event.targets ?? []) {
      if (validEntity(entity)) genericTerrainAlpha(entity, genericEventVisibleAlpha(entity));
    }
    for (const scene of [themeModelSky.active, ...themeModelSky.retiring]) {
      for (const record of scene?.records ?? []) themeSkyAlpha(record, record.requestedAlpha ?? record.maxAlpha);
    }
  } else if (event.name === "WALLBREAK") {
    for (const { entity } of event.targets ?? []) {
      if (validEntity(entity)) genericTerrainAlpha(entity, genericEventVisibleAlpha(entity));
    }
  } else if (event.name === "DISTORT") {
    for (const pawn of genericEventPlayers()) fireName("client", "Command", "r_screenoverlay ", 0.05, pawn);
  }
  if (event.name === "KAMIKAZE" && event.kamikazeRuntime?.kamikaze) {
    cancelFinaleKamikaze(event.kamikazeRuntime);
  }
  if (event.name === "BIGNADES") {
                                                                             
                                                                              
    for (const [projectile, record] of event.projectiles ?? []) {
      if (!validEntity(projectile)) continue;
      if (record.originalModel) projectile.SetModel?.(record.originalModel);
      projectile.SetModelScale?.(record.originalScale);
    }
    event.projectiles?.clear?.();
  }
  for (const sound of event.pizza?.sounds ?? [event.worldEater?.sound1, event.worldEater?.sound2])
    if (validEntity(sound)) fireTarget(sound, "StopSound");
  for (const burst of event.pizza?.contactBursts ?? []) retireGenericPizzaContactFx(event, burst, true);
  for (const entity of event.entities ?? []) {
    if (validEntity(entity)) entity.Kill?.();
    event.entityRuntime?.entities?.delete(entity);
  }
  for (const id of event.entityRuntime?.outputConnections ?? []) {
    disconnectEntityOutput(id);
    state.outputConnections.delete(id);
  }
  event.entityRuntime?.outputConnections?.clear();
  for (const entity of event.entityRuntime?.entities ?? []) if (validEntity(entity)) entity.Kill();
  event.entityRuntime?.entities?.clear();
  state.genericEvents.active.delete(event.id);
                                                                        
                                                                             
  if (event.collapseSource && !reset && Number.isFinite(Number(state.currentLevel?.index)))
    cleanupExpiredLevels(Number(state.currentLevel.index));
}

function startGenericEvent(name, runtime, { manualProbe = false } = {}) {
  const definition = GENERIC_EVENT_DEFINITIONS[name];
  if (definition?.disabled) return false;
  if (!(definition?.supported || (manualProbe && definition?.manualProbe)) || !runtime || (runtime.lifecycle !== "active"
    && !(runtime === state.endingRuntime && runtime.kind === "FINALE" && runtime.lifecycle === "spawning")
    && !(runtime === state.pendingLevel && state.levels.get(runtime.index) === runtime
      && runtime.lifecycle === "spawning" && runtime.genericEventStep2Processed === true))) return false;
  const resourceIssue = genericEventResourceIssue(name);
  if (resourceIssue) { message(`[EVENT ${name}] not ready: ${resourceIssue}`); return false; }
  if (name === "SILENCE" && !genericSilenceEmitter()) {
    message(`SILENCE ringing probe: missing ambient_generic '${GENERIC_SILENCE_CONFIG.entity}'; load the updated compiled map`);
    return false;
  }
  const now = Instance.GetGameTime();
  if ([...state.genericEvents.active.values()].some(event => event.name === name
    && !event.ended && now < (event.repeatAfter ?? Infinity))) return false;
  if (runtime.kind === "FINALE" && !GENERIC_FINALE_EVENT_NAMES.includes(name)) return false;
  if (!genericEventFinaleAllowed(name, runtime)) return false;
  if (!genericEventBudgetAllows(definition.cost)) return false;
  const event = {
    id: ++state.genericEvents.serial,
    name,
    cost: definition.cost,
    runtimeIndex: runtime.index,
    stageSnapshot: stageSnapshotForRuntime(runtime),
    startedAt: now,
    endsAt: now + (definition.duration ?? 15),
    activeAt: now + (definition.activeDelay ?? 0),
    ended: false,
    lastTickAt: now,
    pledged: new Set(),
    phaseAlpha: 255,
    owner: `generic:${state.genericEvents.serial}`,
    tasks: new Set(),
    createdRubblePieces: new Set(),
    entities: new Set(),
    runtime,
    entityRuntime: { ...runtime, index: `generic:${state.genericEvents.serial}`, lifecycle: "active",
      entities: new Set(), outputConnections: new Set(), rubblePieces: [] },
  };
  state.genericEvents.active.set(event.id, event);
  let committed = false;
  try {
  if (name === "BIGNADES") {
    if (state.motherZombies.size === 0) return false;
    event.projectiles = new Map();
    event.acceptingThrows = true;
    event.endsAt = now + GENERIC_BIGNADES_CONFIG.duration;
    announce("EVENT: our grenades are big and strong");
    genericEventTask(event, 1, () => announce("EVENT: beware the knockback"));
  } else if (name === "KAMIKAZE") {
    if (!state.motherZombies.size || !state.spawnPlatformKilled) return false;
    event.kamikazeRuntime = event.entityRuntime;
    const delay = Math.random() * FINALE_KAMIKAZE_CONFIG.dispatchDelayMax;
    genericEventTask(event, delay, () => {
      if (!startFinaleKamikaze(event.kamikazeRuntime, "generic_event")) endGenericEvent(event);
    });
    event.endsAt = now + delay + FINALE_KAMIKAZE_CONFIG.explodeTime + 1;
    announce("EVENT: incoming kamikaze");
  } else if (name === "PIZZADOOM") {
    const delay = GENERIC_PIZZADOOM_CONFIG.runtimeMin
      + Math.random() * (GENERIC_PIZZADOOM_CONFIG.runtimeMax - GENERIC_PIZZADOOM_CONFIG.runtimeMin);
    event.activeAt = now + delay;
    event.endsAt = Infinity;
    genericEventTask(event, delay, () => spawnGenericPizza(event, runtime));
  } else if (name === "BEAMGRID") {
    event.beams = [];
    event.beamSpawned = 0;
    event.endsAt = Infinity;                                                        
    genericEventTask(event, GENERIC_BEAMGRID_CONFIG.startDelay, () => {
      const humans = genericEventPlayers();
      const target = humans[Math.floor(Math.random() * humans.length)];
      event.beamOrigin = clone(target?.GetAbsOrigin?.() ?? runtime.center ?? runtime.anchor ?? vec());
      announce("EVENT: something is happening above us");
    });
    genericEventTask(event, GENERIC_BEAMGRID_CONFIG.startDelay + 0.1, () => spawnGenericBeamTick(event));
  } else if (name === "DOORHUG_BOMB") {
    if (runtime.kind === "FINALE" || runtime.raceLevel || Number(runtime.index) <= 1) return false;
    event.endsAt = now + GENERIC_DOORHUG_CONFIG.explodeTime + GENERIC_DOORHUG_CONFIG.activeEndPadding;
    genericEventTask(event, GENERIC_DOORHUG_CONFIG.spawnDelay, () => spawnGenericDoorhug(event, runtime));
    announce("EVENT: doorhuggers watch out");
  } else if (name === "WORLD_EATER") {
    event.endsAt = Infinity;
    if (!spawnGenericWorldEater(event, runtime)) return false;
  } else if (name === "PLEDGE") {
                                                                           
                                                                           
                         
    event.pledged = new Set(genericEventPlayers());
    for (const pawn of event.pledged)
      playSourceAudioCue(3544, pawn.GetAbsOrigin?.() ?? vec(), { recipient: pawn });
    event.lastTickAt = now + 0.05;
    state.genericEvents.pledgeUntil = event.endsAt;
    syncPledgePrompt(event);
    announce("EVENT: pledge to do your part for the collective");
  } else if (name === "LOWGRAV") {
    state.genericEvents.fallDamageDisabledUntil = event.endsAt + 5;
    announce("EVENT: low gravity");
  } else if (name === "BLOODLUST") {
    if (state.motherZombies.size === 0 || genericEventPlayers(2).length === 0) return false;
    state.genericEvents.bloodlustHits.clear();
    announce("EVENT: shoot zombies to quench the bloodthirst");
  } else if (name === "THICK_FOG") {
    const fog = Instance.FindEntityByName("fog");
    if (!validEntity(fog)) return false;
                                                                          
                                                                       
    fireTarget(fog, "SetFogStartDistance", "-500");
    fireTarget(fog, "SetFogEndDistance", "750");
    fireTarget(fog, "SetFogMaxOpacity", "1");
    announce("EVENT: thick fog");
  } else if (name === "SILENCE") {
    event.ringingEmitter = genericSilenceEmitter();
    if (!event.ringingEmitter) return false;
    event.endsAt = now + GENERIC_SILENCE_CONFIG.duration;
                                                                             
                                                                           
                                                                    
    fireTarget(event.ringingEmitter, "Volume", "10");
    fireTarget(event.ringingEmitter, "PlaySound", "");
    message("SILENCE ringing substitute requested: 15s global low-volume ring; no explosion, blindness, DSP or voice mute (game verification pending)");
    announce("EVENT: ringing (test)");
  } else if (name === "WEAPON_JAM") {
    announce("EVENT: weapon jam");
  } else if (name === "WALLBREAK") {
    event.targets = [];
    for (const level of activeRuntimes()) {
      for (const entity of level.terrainEntities ?? level.entities ?? []) {
        const model = String(entity?.GetModelName?.() ?? entity?.GetModel?.() ?? "").toLowerCase();
        if (!validEntity(entity) || (!model.includes("collective_wall") && !model.includes("hiddenwall"))) continue;
        event.targets.push({ level, entity, alpha: 255 });
      }
    }
    genericEventTask(event, event.activeAt - now, () => {
      for (const target of event.targets ?? []) {
        const { entity } = target;
        if (!validEntity(entity)) continue;
        for (const [delay, alpha] of [[0, 200], [0.5, 150], [1, 100], [1.5, 50], [2, 20]]) {
          genericEventTask(event, delay, () => {
            target.alpha = alpha;
            if (validEntity(entity)) genericTerrainAlpha(entity, genericEventVisibleAlpha(entity));
          });
        }
        genericEventTask(event, 2.5, () => {
          if (validEntity(entity)) entity.Kill();
        });
      }
    });
    announce("EVENT: wall tiles are disappearing");
  } else if (name === "PHASING") {
    event.targets = [];
    for (const level of activeRuntimes()) {
      for (const entity of level.terrainEntities ?? []) {
        if (validEntity(entity)) event.targets.push(entity);
      }
    }
    announce("EVENT: our eyes are phasing");
  } else if (name === "DISTORT") {
    announce("EVENT: our eyes are tripping out");
  } else if (name === "DEBRIS") {
                                                                          
                                                                             
    if (runtime.raceLevel || (runtime.kind === "FINALE"
      && (runtime.escapeStartedAt !== undefined || runtime.finalPyramidStartedAt !== undefined
        || runtime.bossPhase === "escape" || runtime.bossMode === "pyramid"))) return false;
    runtime = event.entityRuntime;
    event.debrisRuntime = runtime;
    event.previousDebrisState = {
      raceRubbleStarted: runtime.raceRubbleStarted,
      raceRubbleStopped: runtime.raceRubbleStopped,
      rubbleProfile: runtime.rubbleProfile,
      rubbleSpawnedCount: runtime.rubbleSpawnedCount,
      nextRubbleAt: runtime.nextRubbleAt,
    };
    runtime.raceRubbleStarted = true;
    runtime.raceRubbleStopped = false;
    runtime.rubbleProfile = { ...GENERIC_DEBRIS_CONFIG,
      debrisDamage: runtime.kind === "FINALE" ? (runtime.infinite ? 16 : 11) : GENERIC_DEBRIS_CONFIG.debrisDamage };
    runtime.rubbleSpawnedCount = 0;
    runtime.nextRubbleAt = now;
    event.endsAt = now + GENERIC_DEBRIS_CONFIG.duration + GENERIC_DEBRIS_CONFIG.rubbleLifetime;
                                                                         
                                                                          
                                                                          
    event.repeatAfter = now + GENERIC_DEBRIS_CONFIG.duration + GENERIC_DEBRIS_CONFIG.repeatReleaseDelay;
    genericEventTask(event, GENERIC_DEBRIS_CONFIG.duration, () => { runtime.raceRubbleStopped = true; });
    genericEventTask(event, GENERIC_DEBRIS_CONFIG.duration + 3, () => announce("EVENT: the debris has stopped falling"));
    announce("EVENT: watch out for falling debris");
  } else if (name === "COLLAPSE") {
    const collapseSource = genericCollapseSource(runtime);
    const candidates = genericCollapseCandidates(collapseSource);
    if (!collapseSource || candidates.length < GENERIC_COLLAPSE_CONFIG.minimumBlocks) return false;
    event.collapseSource = collapseSource;
    event.collapseQueue = candidates;
    event.collapsed = new Set();
    let elapsed = GENERIC_COLLAPSE_CONFIG.startDelay;
    for (const entity of candidates) {
      elapsed += GENERIC_COLLAPSE_CONFIG.intervalMin
        + Math.random() * (GENERIC_COLLAPSE_CONFIG.intervalMax - GENERIC_COLLAPSE_CONFIG.intervalMin);
      genericEventTask(event, elapsed, () => genericCollapsePiece(event, entity));
    }
    const lastFade = GENERIC_COLLAPSE_CONFIG.crumbleDelay
      + GENERIC_COLLAPSE_CONFIG.fadeStart
      + (255 / GENERIC_COLLAPSE_CONFIG.fadeStep) * GENERIC_COLLAPSE_CONFIG.fadeInterval
      + GENERIC_COLLAPSE_CONFIG.fadeEndPadding;
    event.endsAt = now + elapsed + lastFade + 0.1;
    genericEventTask(event, elapsed + lastFade, () => finishGenericCollapse(event));
    announce("EVENT: the old stage is unstable");
    genericEventTask(event, 1, () => announce("EVENT: get out before it collapses"));
    genericEventTask(event, GENERIC_COLLAPSE_CONFIG.startDelay, () => announce("EVENT: the old stage is collapsing"));
  }
  state.genericEvents.active.set(event.id, event);
  state.genericEvents.history.push({ name, level: runtime.index, at: now });
  if (state.genericEvents.history.length > 64) state.genericEvents.history.shift();
  if (Number.isFinite(event.endsAt)) genericEventTask(event, Math.max(0.1, event.endsAt - now), () => endGenericEvent(event, { natural: true }));
  committed = true;
  return true;
  } finally {
    if (!committed) endGenericEvent(event);
  }
}

function genericInfiniteFinaleDelay() {
  const config = GENERIC_INFINITE_FINALE_CONFIG;
  return config.intervalMin + Math.random() * (config.intervalMax - config.intervalMin);
}

function processInfiniteFinaleEvents(runtime, now) {
  if (!runtime || runtime !== state.endingRuntime || runtime.kind !== "FINALE"
    || !runtime.infinite || runtime.eventEvaluateInfiniteEnabled === false
    || !["active", "spawning"].includes(runtime.lifecycle)) return false;
  if (runtime.finalPyramidStartedAt !== undefined && now >= runtime.finalPyramidStartedAt + 5) {
    runtime.eventEvaluateInfiniteEnabled = false;
    runtime.nextGenericEventAt = undefined;
    return false;
  }
  runtime.nextGenericEventAt ??= (runtime.runStartedAt ?? now) + genericInfiniteFinaleDelay();
  if (now < runtime.nextGenericEventAt) return false;
  runtime.lastGenericEventPulseAt = now;
  runtime.nextGenericEventAt = now + genericInfiniteFinaleDelay();
  return evaluateGenericEvents(runtime, { infiniteFinale: true });
}

function genericEventRandomCooldown(config) {
  const min = Math.max(0, Math.floor(Number(config.eventCooldownMin ?? config.event_cooldown_min ?? 0)));
  const max = Math.max(min, Math.floor(Number(config.eventCooldownMax ?? config.event_cooldown_max ?? min)));
  return min + Math.floor(Math.random() * (max - min + 1));
}

function initializeGenericEventCooldown(config = campaignStageSnapshot()) {
                                                                            
                                                                          
  state.genericEvents.cooldown ??= genericEventRandomCooldown(config);
  return state.genericEvents.cooldown;
}

function processGenericLevelStep2(runtime) {
  if (!runtime || runtime !== state.pendingLevel || state.levels.get(runtime.index) !== runtime
    || runtime.genericEventEligible === false
    || runtime.genericEventStep2Processed || !["queued", "spawning", "active"].includes(runtime.lifecycle)) return false;
  if (runtime.lifecycle === "queued") setLevelLifecycle(runtime, "spawning");
  runtime.genericEventStep2Processed = true;
  runtime.genericEventStep2At = Instance.GetGameTime();
  return evaluateGenericEvents(runtime, { sourceStep2: true });
}

function evaluateGenericEvents(runtime, { infiniteFinale = false, sourceStep2 = false } = {}) {
  if (!state.genericEvents.autoEnabled || state.debugShowcaseMode || state.debugGravityMode
    || state.debugMovementThemesMode || state.debugAllModelsMode || state.debugTrapMode || state.debugStageId) return false;
  if (!runtime || runtime.genericEventEligible === false || runtime.raceLevel || (runtime.lifecycle !== "active"
    && !((infiniteFinale || sourceStep2) && runtime.lifecycle === "spawning"))) return false;
  if (sourceStep2 && (runtime !== state.pendingLevel || state.levels.get(runtime.index) !== runtime
    || runtime.genericEventStep2Processed !== true)) return false;
  if (infiniteFinale) {
    if (runtime !== state.endingRuntime || runtime.kind !== "FINALE" || !runtime.infinite
      || runtime.eventEvaluateInfiniteEnabled === false) return false;
  } else {
    if (state.endingRuntime || state.campaign.phase === "ending_handoff" || state.campaign.phase === "ending_pending") return false;
    if (state.genericEvents.lastEvaluatedLevel === runtime.index) return false;
    state.genericEvents.lastEvaluatedLevel = runtime.index;
  }
  const config = stageSnapshotForRuntime(runtime);
  initializeGenericEventCooldown(config);
  if (state.genericEvents.cooldown > 0) {
    state.genericEvents.cooldown--;
    return false;
  }
  const baseChance = Math.max(0, Number(config.eventChanceBase ?? config.event_chance_base ?? 0));
  const failAdd = Math.max(0, Number(config.eventChanceFailAdd ?? config.event_chance_fail_add ?? 0));
  const chance = Math.min(100, baseChance + state.genericEvents.failChance);
  if (Math.random() * 100 > chance) {
    state.genericEvents.failChance += failAdd;
    return false;
  }
  const candidates = GENERIC_EVENT_NAMES.filter((name) => {
    const definition = GENERIC_EVENT_DEFINITIONS[name];
    return definition.supported && (!infiniteFinale || GENERIC_FINALE_EVENT_NAMES.includes(name))
      && genericEventFinaleAllowed(name, runtime)
      && !genericEventResourceIssue(name)
      && genericEventBudgetAllows(definition.cost);
  });
  state.genericEvents.cooldown = genericEventRandomCooldown(config);
  state.genericEvents.failChance = 0;
  if (candidates.length === 0) {
    message("EVENT: roll succeeded but no CS2-compatible event is available");
    return false;
  }
  const selected = candidates[Math.floor(Math.random() * candidates.length)];
  if (!tryStartGenericEvent(selected, runtime)) {
    return false;
  }
  state.genericEvents.failChance = 0;
  message(`EVENT: ${selected} level=${runtime.index} chance=${chance}%`);
  return true;
}

function processGenericEvents(now) {
  for (const event of [...state.genericEvents.active.values()]) {
    try {
    if (GENERIC_EVENT_DEFINITIONS[event.name]?.disabled) {
      endGenericEvent(event);
      continue;
    }
    if (now >= event.endsAt) {
      endGenericEvent(event, { natural: true });
      if (event.ended) continue;
    }
    const source = genericEventSource(event);
    if (event.name === "BIGNADES" && now >= event.lastTickAt) {
      for (const [projectile, record] of event.projectiles ?? []) {
        if (!validEntity(projectile)) {
          genericBigNadeExplode(event, projectile, record.lastPosition);
          continue;
        }
        if (now < record.markedAt + 0.02) continue;
        const position = projectile.GetAbsOrigin?.();
        if (!position) continue;
        const moved = record.lastPosition
          ? Math.hypot(position.x - record.lastPosition.x, position.y - record.lastPosition.y, position.z - record.lastPosition.z)
          : Infinity;
        if (now >= record.blowAt || moved < 0.02) genericBigNadeExplode(event, projectile, position);
        else record.lastPosition = clone(position);
      }
      event.lastTickAt = now + GENERIC_BIGNADES_CONFIG.tickRate;
    } else if (event.name === "KAMIKAZE") {
      processFinaleKamikaze(event.kamikazeRuntime ?? event.runtime, now);
    } else if (event.name === "PIZZADOOM" && event.pizza) {
      processGenericPizza(event, now);
    } else if (event.name === "WORLD_EATER" && event.worldEater) {
      processGenericWorldEater(event, now);
    } else if (event.name === "BEAMGRID") {
      processGenericBeamGrid(event, now);
    } else if (event.name === "DEBRIS" && now >= event.lastTickAt) {
      const runtime = event.debrisRuntime;
      if (runtime && runtime.lifecycle !== "destroyed") {
        const before = new Set(runtime.rubblePieces ?? []);
        processRaceRubble(runtime, now);
        for (const piece of runtime.rubblePieces ?? []) {
          if (!before.has(piece)) event.createdRubblePieces.add(piece);
        }
      }
      event.lastTickAt = now + 0.02;
    } else if (event.name === "LOWGRAV" && now >= event.lastTickAt) {
      for (const pawn of state.playerEffects.keys()) {
        if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3)
          removeGravitySource(pawn, source);
      }
      for (const pawn of genericEventPlayers()) {
        addGravitySource({ index: `generic:${event.id}` }, pawn, source, CONFIG.lowGravity, { engine: true, simulate: false });
      }
      event.lastTickAt = now + 0.25;
    } else if (event.name === "PLEDGE" && now >= event.lastTickAt) {
      for (const pawn of event.pledged) {
        if (!validEntity(pawn) || !pawn.IsAlive?.() || pawn.GetTeamNumber?.() !== 3) event.pledged.delete(pawn);
      }
      for (const pawn of genericEventPlayers()) {
        if (event.pledged.has(pawn)) damageRaceRubblePawn(pawn, 2);
      }
      syncPledgePrompt(event);
      if (!event.pledged.size) endGenericEvent(event);
      event.lastTickAt = now + 0.8;
    } else if (event.name === "BLOODLUST" && now >= event.lastTickAt) {
      if (!genericEventPlayers(2).some(pawn => !activeImpostorController(pawn)?.hidden)) continue;
      for (const pawn of genericEventPlayers()) {
        const health = Number(pawn.GetHealth?.() ?? 0);
        if (state.genericEvents.bloodlustHits.get(pawn)) {
          if (health < 150) pawn.SetHealth?.(Math.min(150, health + 3));
        } else {
          damageRaceRubblePawn(pawn, 2);
        }
        state.genericEvents.bloodlustHits.delete(pawn);
      }
      event.lastTickAt = now + 0.5;
    } else if (event.name === "WEAPON_JAM" && now >= event.lastTickAt) {
      for (const weapon of genericEventWeapons()) {
        if (validEntity(weapon)) {
          const className = String(weapon.GetClassName?.() ?? "");
          if (["weapon_hegrenade", "weapon_molotov", "weapon_incgrenade"].includes(className)) continue;
          weapon.SetClipAmmo?.(0);
          weapon.SetReserveAmmo?.(500);
        }
      }
      event.lastTickAt = now + 0.30;
    } else if (event.name === "SILENCE" && !validEntity(event.ringingEmitter)) {
      message("SILENCE ringing emitter was removed; stopping the probe");
      endGenericEvent(event);
    } else if (event.name === "PHASING" && now >= event.lastTickAt) {
      event.phaseAlpha = 30;
      for (const level of activeRuntimes()) {
        for (const entity of level.terrainEntities ?? []) {
          if (validEntity(entity) && !event.targets.includes(entity)) event.targets.push(entity);
        }
      }
      for (const entity of event.targets ?? []) {
        if (validEntity(entity)) genericTerrainAlpha(entity, genericEventVisibleAlpha(entity));
      }
      for (const scene of [themeModelSky.active, ...themeModelSky.retiring]) {
        for (const record of scene?.records ?? [])
          themeSkyAlpha(record, record.requestedAlpha ?? record.alpha ?? record.maxAlpha);
      }
      event.lastTickAt = now + 2;
    } else if (event.name === "DISTORT" && now >= event.lastTickAt) {
      for (const pawn of genericEventPlayers()) fireName("client", "Command", "r_screenoverlay luffaren/overlay_wonky", 0, pawn);
      event.lastTickAt = now + 1;
    }
    } catch (error) {
      message(`[EVENT ${event.name}] failed: ${String(error)}`);
      endGenericEvent(event);
    }
  }
}

function genericSilenceEmitter() {
  const emitter = Instance.FindEntityByName(GENERIC_SILENCE_CONFIG.entity);
  return validEntity(emitter) && emitter.GetClassName?.() === "ambient_generic" ? emitter : undefined;
}



function setGenericEventManualMode(enabled) {
  const events = state.genericEvents;
  if (enabled) {
    if (!events.manualEnabled) events.manualAutoBefore = events.autoEnabled;
    events.manualEnabled = true;
    events.autoEnabled = false;
  } else if (events.manualEnabled) {
    events.autoEnabled = events.manualAutoBefore ?? true;
    events.manualAutoBefore = undefined;
    events.manualEnabled = false;
  }
}



function finishPendingLevel() {
  const runtime = state.pendingLevel;
  if (!runtime) return;
  closeBlockSpawnSafety(runtime);
  try { releaseLevelPostSpawn(runtime); }
  catch (error) { failRuntime(`postspawn release failed for level ${runtime.index}: ${error}`); return; }
                                                                         
                                                                           
  if (!runtime.genericEventStep2Processed) processGenericLevelStep2(runtime);
  const previous = state.currentLevel ?? state.transitionLevel;
  state.pendingLevel = undefined;
  state.currentLevel = runtime;
  ensureThemeModelSky(campaignStageSnapshot().infiniteMode ? campaignStageSnapshot().theme
    : runtime.stageSnapshot?.theme ?? campaignStageSnapshot().theme, runtime.end.z);
  setLevelLifecycle(runtime, "active");
  updateTerrainPreviewHud(runtime, "spawn-complete");
  if (runtime.debugLiquidFall) {
    message(`[LIQUID FALL DEBUG] ready: ${runtime.debugLiquidFallSamples.size}/32 samples; use ze_debug_liquid_fall status`);
  }
  if (previous && previous !== runtime && previous.lifecycle !== "destroyed") {
    setLevelLifecycle(previous, "history");
  }
                                                                         
                                                                               
                                                             
  state.transitionLevel = undefined;
  state.currentDirection = clone(runtime.outgoing);
  state.nextBridgeStart = clone(runtime.end);
  state.nextEntry = add(runtime.end, mul(runtime.outgoing, CONFIG.bufferSize * CONFIG.gridSize));
  state.nextBufferSize = CONFIG.bufferSize;
  state.endLockedUntil = Instance.GetGameTime() + CONFIG.endCooldown;
  if (state.campaign.currentStageSnapshot?.stageIndex === runtime.stageSnapshot?.stageIndex) {
    state.campaign.stageLevelCount = Math.max(state.campaign.stageLevelCount, runtime.stageLevel ?? 0);
  }
                                                                        
                                                                          
                                                                           
                                    
  spawnEndIndicator(runtime);
  try { offerInfiniteCheckout(runtime); }
  catch (error) { failRuntime(`infinite checkout spawn failed: ${error}`); return; }
                                                                        
                                                                         
                                                                       
  if (previous && previous !== runtime && !runtime.sourceGenerationScheduled) {
    const fadeDelay = Math.max(0, CONFIG.previousLevelRetention - CONFIG.levelFadeDuration);
    schedule(fadeDelay, () => beginLevelFade(previous), runtime.index);
  }
  if (!runtime.sourceGenerationScheduled)
    schedule(CONFIG.previousLevelRetention, () => cleanupExpiredLevels(runtime.index), runtime.index);
  announce(`Level ${runtime.index}: '${runtime.name}' by ${runtime.author}`);
  setThemeFog(runtime);
  armThemeTerrainWarmup(runtime);
  if (runtime.debugTeleport) {
    message("[TELEPORT DEBUG] lab ready; disable noclip, then use ze_debug_teleport horizontal|fastfall|slowfall|upward");
    message("[TELEPORT DEBUG] ze_debug_teleport_map status reports native triggers and touch/teleport counters");
  }
}

function moveTrackedEntity(fromRuntime, toRuntime, entity) {
  if (!entity || !fromRuntime.entities?.delete(entity)) return;
  restoreLevelFadeColor(fromRuntime, entity);
  toRuntime.entities?.add(entity);
}

function moveTrackedEntityCollection(fromRuntime, toRuntime, entities) {
  if (!entities || typeof entities[Symbol.iterator] !== "function") return;
  for (const entity of entities) moveTrackedEntity(fromRuntime, toRuntime, entity);
}

function itemOwnedEntities(item) {
  return new Set([
    item.visual, item.carrier, item.measureReference, item.measureMovement,
    item.stripTrigger, ...(item.effects ?? []), ...(item.auxiliaryVisuals ?? []),
  ].filter(Boolean));
}

function deployableOwnedEntities(deployable) {
  return new Set([
    ...["visual", "entryVisual", "exitVisual", "trigger", "hitbox"].map(field => deployable[field]),
    ...["visuals", "effects", "sounds", "pieces"].flatMap(field => [...(deployable[field] ?? [])]),
  ].filter(Boolean));
}

function persistentItemEntities(runtime) {
  const entities = new Set();
  const addItem = item => {
    if (item?.everPickedUp) for (const entity of itemOwnedEntities(item)) entities.add(entity);
  };
  for (const item of runtime.items ?? []) addItem(item);
                                                                            
  for (const deployable of runtime.itemDeployables ?? []) {
    if (!deployable.item?.everPickedUp) continue;
    addItem(deployable.item);
    for (const entity of deployableOwnedEntities(deployable)) entities.add(entity);
  }
  return entities;
}

function restoreLevelFadeColor(runtime, entity) {
  const color = runtime?.levelFadeColors?.get(entity);
  if (!color) return;
  if (validEntity(entity)) {
    entity.collectiveRetireAlpha = undefined;
    entity.SetColor?.(color);
  }
  runtime.levelFadeColors.delete(entity);
}

function transferItemOwnership(item, fromRuntime, toRuntime) {
  if (!item || item.owner === toRuntime.index) return;
  item.owner = toRuntime.index;
  for (const task of item.tasks ?? []) task.owner = toRuntime.index;
  if (item.stripConnection !== undefined) {
    fromRuntime.outputConnections?.delete(item.stripConnection);
    toRuntime.outputConnections?.add(item.stripConnection);
    state.outputConnections.set(item.stripConnection, toRuntime.index);
  }
  for (const statuses of state.playerStatuses.values()) {
    for (const [source, status] of statuses) {
      if (
        status.owner === fromRuntime.index
        && String(source).includes(`:item:${item.id}:`)
      ) status.owner = toRuntime.index;
    }
  }
  moveTrackedEntityCollection(fromRuntime, toRuntime, itemOwnedEntities(item));
}

function transferDeployableEntities(fromRuntime, toRuntime, deployable) {
  moveTrackedEntityCollection(fromRuntime, toRuntime, deployableOwnedEntities(deployable));
}

function transferPickedItemState(fromRuntime, toRuntime) {
  if (!toRuntime || toRuntime === fromRuntime) return;
  for (const item of [...(fromRuntime.items ?? [])]) {
    if (!item.everPickedUp) continue;
    transferItemOwnership(item, fromRuntime, toRuntime);
    fromRuntime.items.delete(item);
    toRuntime.items?.add(item);
  }
  for (const deployable of [...(fromRuntime.itemDeployables ?? [])]) {
    const item = deployable.item;
    if (!item?.everPickedUp) continue;
    transferItemOwnership(item, fromRuntime, toRuntime);
    transferDeployableEntities(fromRuntime, toRuntime, deployable);
    fromRuntime.itemDeployables.delete(deployable);
    toRuntime.itemDeployables?.add(deployable);
  }
}

function cleanupExpiredLevels(currentIndex) {
  const maximumExpired = currentIndex - CONFIG.maxAreaHistory;
  for (const index of [...state.levels.keys()]) {
    if (index <= maximumExpired) {
      const runtime = state.levels.get(index);
      if (runtime.sourceCleanupScheduled) continue;
      if ([...state.genericEvents.active.values()].some(event => !event.ended && event.collapseSource === runtime)) continue;
      beginLevelFade(runtime);
      destroyLevel(index, true, true);
    }
  }
}

function beginLevelFade(runtime) {
  if ([...state.genericEvents.active.values()].some(event => !event.ended && event.collapseSource === runtime)) return;
  if (!runtime || runtime.lifecycle === "destroyed" || runtime.lifecycle === "fading") return;
  setLevelLifecycle(runtime, "fading");
  runtime.fadeStartedAt = Instance.GetGameTime();
  runtime.fadeStep = state.finaleEscapeActive ? 50 : CONFIG.despawnFadeStep;
  runtime.fadeInterval = state.finaleEscapeActive ? 0.05 : CONFIG.despawnFadeInterval;
  runtime.fadeAlpha = 255;
  runtime.fadeTickScheduled = false;
  fadeLevelTick(runtime);
}

// Entities with no rendered model gain nothing from Alpha I/O; skipping them
// keeps each retirement fade tick proportional to visible geometry only.
const NON_RENDERING_FADE_CLASS = /^(?:trigger_|logic_|filter_|ambient_|info_|game_|point_(?!worldtext))/;

function fadeRenderable(entity) {
  if (entity.collectiveFadeRenderable === undefined) {
    entity.collectiveFadeRenderable = !NON_RENDERING_FADE_CLASS.test(String(entity.GetClassName?.() ?? "").toLowerCase());
  }
  return entity.collectiveFadeRenderable;
}

function fadeLevelTick(runtime) {
  if (!runtime || runtime.lifecycle === "destroyed") return;
  const elapsed = Math.max(0, Instance.GetGameTime() - (runtime.fadeStartedAt ?? Instance.GetGameTime()));
  const step = runtime.fadeStep ?? CONFIG.despawnFadeStep;
  const interval = runtime.fadeInterval ?? CONFIG.despawnFadeInterval;
  const steps = Math.min(Math.ceil((255 - 3) / step) - 1, Math.floor((elapsed + 1e-6) / interval));
  runtime.fadeAlpha = Math.max(0, 255 - steps * step);
  const persistentEntities = persistentItemEntities(runtime);
  for (const entity of runtime.entities ?? []) {
    if (!validEntity(entity) || typeof entity.SetColor !== "function" || !fadeRenderable(entity)) continue;
                                                                             
                                                                              
    if (persistentEntities.has(entity)) {
      restoreLevelFadeColor(runtime, entity);
      continue;
    }
    runtime.levelFadeColors ??= new Map();
    if (!runtime.levelFadeColors.has(entity)) {
      const color = entity.collectiveBaseColor ?? entity.GetColor?.() ?? { r: 255, g: 255, b: 255, a: 255 };
      runtime.levelFadeColors.set(entity, { ...color });
    }
    const base = runtime.levelFadeColors.get(entity);
    entity.collectiveRetireAlpha = runtime.fadeAlpha;
                                                                          
                                                                          
                                                                             
    fireTarget(entity, "Alpha", Math.round((base.a ?? 255) * runtime.fadeAlpha / 255));
  }
  if (runtime.fadeAlpha <= 0 || runtime.fadeTickScheduled) return;
  runtime.fadeTickScheduled = true;
  const endAt = runtime.fadeStartedAt + Math.ceil((255 - 3) / step) * interval;
  if (Instance.GetGameTime() >= endAt) { runtime.fadeTickScheduled = false; return; }
  runtime.fadeTask = schedule(interval, () => {
    runtime.fadeTickScheduled = false;
    fadeLevelTick(runtime);
  }, runtime.index);
}

function retireSourceHistory(reached) {
                                                                      
                                                                          
                                                                     
  const stage = stageSnapshotForRuntime(reached);
  if (stage.stageIndex === FINALE_STAGE_INDEX || state.finaleEscapeActive
    || (isStageGoalLevel(reached) && ["ASCEND", "HUNT"].includes(stage.ending))) return;
  for (const runtime of state.levels.values()) {
    if (!Number.isFinite(Number(runtime.index)) || runtime.index > reached.index - CONFIG.maxAreaHistory || runtime === reached
      || runtime.sourceCleanupScheduled || runtime.lifecycle === "destroyed") continue;
    if ([...state.genericEvents.active.values()].some(event => !event.ended && event.collapseSource === runtime)) continue;
    beginLevelFade(runtime);
    runtime.sourceCleanupScheduled = true;
    const delay = Math.ceil((255 - 3) / runtime.fadeStep) * runtime.fadeInterval + 0.05;
    schedule(delay, () => destroyLevel(runtime.index, true, true), runtime.index);
  }
}

// True only inside releaseRoundToEngine: the engine's round restart removes
// every runtime-spawned entity, so tracked handles are dropped, not killed.
let entityReleaseByEngine = false;
// Handles dropped by the last engine-backed release, kept until the next
// explicit reset to verify the engine really removed them.
let engineRelease;

// force: kill even during an engine-backed release (entities the restart
// keeps, e.g. weapons still owned by a surviving player).
function destroyEntities(entities, force = false) {
  if (entityReleaseByEngine && !force) return;
  for (const entity of entities) {
    try {
      if (validEntity(entity)) entity.Kill();
      state.roundEntities.delete(entity);
    } catch (error) {
      // Keep failed handles registered for the next cleanup attempt.
      if (entity) state.roundEntities.add(entity);
      roundCleanupStep("entity Kill fallback", () => {
        fireTarget(entity, "Kill");
        state.roundEntities.delete(entity);
      });
    }
  }
}

// Retired (already faded) levels are killed over several Thinks instead of in
// one frame. Ownership/records are dropped immediately by destroyLevel.
let deferredEntityKills = [];
let deferredEntityKillCursor = 0;

function queueEntityKills(entities) {
  for (const entity of entities) if (entity) deferredEntityKills.push(entity);
}

function processDeferredEntityKills(limit = CONFIG.deferredKillPerThink) {
  let killed = 0;
  while (killed < limit && deferredEntityKillCursor < deferredEntityKills.length) {
    const entity = deferredEntityKills[deferredEntityKillCursor++];
    if (validEntity(entity)) {
      entity.Kill();
      killed++;
    }
  }
  if (deferredEntityKillCursor >= deferredEntityKills.length) {
    deferredEntityKills = [];
    deferredEntityKillCursor = 0;
  }
}

function flushDeferredEntityKills() {
  if (entityReleaseByEngine) return;
  processDeferredEntityKills(Infinity);
}

// OnRoundEnd / OnBeginRoundRestart: stop the round and restore what the
// engine keeps (players, ConVars, output callbacks, owned weapons), but leave
// spawned entities to the round restart instead of killing them one by one.
function releaseRoundToEngine(options) {
  const dropped = state.roundEntities;
  entityReleaseByEngine = true;
  try {
    resetRoundState(options);
  } finally {
    entityReleaseByEngine = false;
  }
  Object.assign(state, createRoundScope());
  if (!engineRelease) engineRelease = dropped;
  else for (const entity of dropped) engineRelease.add(entity);
}

// Runs at the start of every explicit reset. After a real round restart all
// dropped handles are invalid; anything still alive (no restart happened,
// e.g. a script reload during the round-end delay, or the engine kept it) is
// killed here so it can't leak into the rebuilt round.
function settleEngineRelease() {
  const dropped = engineRelease;
  engineRelease = undefined;
  if (!dropped?.size) return;
  const survivors = [];
  for (const entity of dropped) if (validEntity(entity)) survivors.push(entity);
  if (survivors.length === 0) {
    message(`round release: engine removed all ${dropped.size} dropped entities`);
    return;
  }
  message(`round release: ${survivors.length}/${dropped.size} dropped entities still alive; killing explicitly`);
  destroyEntities(survivors, true);
}

function destroyLevel(index, preservePickedItems = false, deferKill = false) {
  const runtime = state.levels.get(index);
  if (!runtime) return;
  clearGenerationWork(index);
  clearBoostPads(runtime);
  clearSpawnSafetyTriggers(index);
  if (state.debugTeleportTest?.runtime === runtime) DEBUG_HOOKS.clearTeleportTest();
  if (runtime.lifecycle !== "destroyed") setLevelLifecycle(runtime, "destroyed");
  if (runtime.fadeTask) runtime.fadeTask.cancelled = true;
  if (preservePickedItems) transferPickedItemState(runtime, state.currentLevel ?? state.transitionLevel ?? state.pendingLevel);
  state.scheduledTasks = state.scheduledTasks.filter((task) => task.owner !== index);
  for (const volume of [...runtime.movementVolumes ?? []]) disableMovementVolume(runtime, volume);
  runtime.airslides?.clear();
  for (const id of runtime.outputConnections) {
    disconnectEntityOutput(id);
    state.outputConnections.delete(id);
  }
  runtime.outputConnections.clear();
  restorePlayerEffects(index);
  clearPlayerStatuses(index);
  for (const item of runtime.items ?? []) {
    if (item.holder) forgetPlayerItem(item.holder, item);
    item.holder = undefined;
    item.state = "cleaned";
    ITEM_BEHAVIORS[item.definition.behavior]?.onCleanup?.(runtime, item);
    cleanupItemStripTrigger(runtime, item);
    destroyItemCarrier(item);
    // An engine-backed release skips runtime.entities; don't leave a visual
    // unparented from its holder floating through the round-end delay.
    if (entityReleaseByEngine && validEntity(item.visual)) item.visual.Kill();
  }
  runtime.items?.clear();
  for (const deployable of [...runtime.itemDeployables ?? []]) {
    if (deployable.kind === "impostor") cleanupImpostor(runtime, deployable);
    else cleanupDeployable(runtime, deployable);
  }
  runtime.itemDeployables?.clear();
  for (const liquid of runtime.liquids ?? []) {
    for (const pawn of liquid.contacts?.keys?.() ?? []) removeGravitySource(pawn, liquid.source);
    for (const pawn of liquid.contacts?.keys?.() ?? []) {
      state.liquidShallowStreamHistory.delete(pawn);
      state.liquidDamageCooldowns.delete(pawn);
      state.liquidShallowJumpCooldowns.delete(pawn);
    }
    liquid.contacts.clear();
  }
  for (const [pawn, history] of state.liquidShallowStreamHistory) {
    if (history?.owner === index) state.liquidShallowStreamHistory.delete(pawn);
  }
  for (const pawn of runtime.liquidPawns ?? []) {
    state.liquidDamageCooldowns.delete(pawn);
    state.liquidShallowJumpCooldowns.delete(pawn);
    state.liquidShallowStreamHistory.delete(pawn);
  }
  runtime.liquidPawns?.clear?.();
  runtime.liquids?.clear?.();
  runtime.movers?.clear?.();
  runtime.nativeHolds?.clear?.();
  for (const trap of runtime.traps ?? []) {
    if (trap?.name === "kart") cleanupKartController(runtime, trap, false);
  }
  runtime.traps?.clear?.();
  for (const [entity, record] of state.silentHillWorld.visuals) {
    if (record.runtime === runtime) state.silentHillWorld.visuals.delete(entity);
  }
  const destroy = deferKill ? queueEntityKills : destroyEntities;
  destroy([...runtime.entities]);
  destroy([...(runtime.terrainPreloadedEntities ?? [])]);
  runtime.terrainPreloadedEntities?.clear();
  runtime.levelFadeColors?.clear();
  runtime.terrainEntities?.clear?.();
  runtime.terrainCompanions?.clear?.();
  runtime.safeTerrainEntities?.clear?.();
  state.spawnQueue = state.spawnQueue.filter((entry) => entry.levelIndex !== index);
  state.itemSpawnQueue = state.itemSpawnQueue.filter(entry => entry.levelIndex !== index);
  state.trapSpawnQueue = state.trapSpawnQueue.filter(entry => entry.levelIndex !== index);
  runtime.postSpawnFeatures?.splice(0);
  state.levels.delete(index);
  if (terrainPreviewRuntime === runtime) hideTerrainPreviewHud("level-destroyed");
  if (state.currentLevel === runtime) state.currentLevel = undefined;
  if (state.transitionLevel === runtime) state.transitionLevel = undefined;
}

const endDiagnostics = { enabled: false, nextReportAt: 0, lastThinkAt: undefined, lastPollAt: undefined };

function endPositionStatus(runtime, position) {
  const end = runtime?.end;
  if (![end?.x, end?.y, end?.z, position?.x, position?.y, position?.z].every(Number.isFinite))
    return { reason: "invalid-position" };
  const xy = distance2D(position, end);
  const dz = position.z - end.z;
  return { xy, dz, reason: xy > CONFIG.endRadius ? "outside-radius"
    : dz < CONFIG.endMinZ ? "below-end" : dz > CONFIG.endMaxZ ? "above-end" : "inside" };
}

function endCheckGate(now) {
  if (state.fatal) return "fatal";
  if (!state.running) return "runtime-stopped";
  if (state.debugAllModelsMode || state.currentLevel?.debugTeleport || state.currentLevel?.debugLiquidFall || state.currentLevel?.debugKarts) return "debug-lab";
  if (state.endingRuntime?.kind === "RACE" && state.endingRuntime.lifecycle === "active") return "race-owns-end";
  if (!state.currentLevel) return "no-current-level";
  if (state.pendingLevel) return "level-still-spawning";
  if (now < state.endLockedUntil) return "cooldown";
  if (now < state.nextEndCheckAt) return "poll-interval";
  return "ready";
}

function reportEndDiagnostics(now = Instance.GetGameTime()) {
  const runtime = state.currentLevel ?? state.transitionLevel ?? state.pendingLevel;
  const fmt = point => point ? [point.x, point.y, point.z].map(n => Number(n).toFixed(1)).join(",") : "none";
  const age = at => at === undefined ? "never" : (now - at).toFixed(2);
  message(`[END DEBUG] map=${runtime?.id ?? "none"} index=${runtime?.index ?? "none"}`
    + ` lifecycle=${runtime?.lifecycle ?? "none"} provider=${runtime?.endProvider ?? "none"}`
    + ` completed=${runtime?.completed === true} gate=${endCheckGate(now)}`);
  message(`[END DEBUG] end=${fmt(runtime?.end)} ring=${fmt(runtime?.endIndicator?.GetAbsOrigin?.())}`
    + ` radius=${CONFIG.endRadius} zRange=${CONFIG.endMinZ}..${CONFIG.endMaxZ}`
    + ` thinkAge=${age(endDiagnostics.lastThinkAt)} pollAge=${age(endDiagnostics.lastPollAt)}`);
  message(`[END DEBUG] pending=${state.pendingLevel?.id ?? "none"} remaining=${state.pendingLevel?.remaining ?? 0}`
    + ` transition=${state.transitionLevel?.id ?? "none"} campaign=${state.campaign.phase}`
    + ` lockLeft=${Math.max(0, state.endLockedUntil - now).toFixed(2)}`
    + ` endButtons=${runtime?.remainingBlockButtons?.get("end") ?? "none"}`
    + ` retired=${runtime?.interactionsRetired === true}`);
  const tasks = state.scheduledTasks.filter(task => !task.cancelled && task.owner === runtime?.index);
  message(`[END DEBUG] ownedTasks=${tasks.length} nextTaskIn=${tasks.length
    ? (Math.min(...tasks.map(task => task.at)) - now).toFixed(2) : "none"}`);
  if (!runtime?.end) return;
  const candidates = allLivingPawns().map((pawn, slot) => {
    const position = pawn.GetAbsOrigin();
    return { slot, team: pawn.GetTeamNumber(), position, ...endPositionStatus(runtime, position) };
  }).sort((a, b) => (a.xy ?? Infinity) - (b.xy ?? Infinity));
                                                                                   
  const nearestHuman = candidates.find(candidate => candidate.team === 3);
  let shown = 0;
  for (const candidate of nearestHuman ? [nearestHuman, ...candidates.filter(c => c !== nearestHuman)] : candidates) {
    if (candidate !== nearestHuman && !(candidate.xy <= CONFIG.gridSize * 2)) continue;
    if (shown++ >= 8) break;
    message(`[END DEBUG] pawn=${candidate.slot} team=${candidate.team} pos=${fmt(candidate.position)}`
      + ` xy=${candidate.xy?.toFixed(1) ?? "invalid"} dz=${candidate.dz?.toFixed(1) ?? "invalid"}`
      + ` verdict=${candidate.team === 3 ? candidate.reason : "not-human"}`);
  }
  if (!nearestHuman) message("[END DEBUG] no living CT");
}

function debugEndCommand(args) {
  const command = String(args ?? "status").trim().toLowerCase() || "status";
  if (command === "off") { endDiagnostics.enabled = false; message("[END DEBUG] trace OFF"); return; }
  if (command === "on") { endDiagnostics.enabled = true; endDiagnostics.nextReportAt = Instance.GetGameTime() + 2; }
  else if (command !== "status") { message("usage: ze_debug_end [on|off|status]"); return; }
  reportEndDiagnostics();
}

function checkEnd(now) {
  endDiagnostics.lastPollAt = now;
  if (state.debugAllModelsMode || state.currentLevel?.debugTeleport || state.currentLevel?.debugLiquidFall || state.currentLevel?.debugKarts) return;
  if (state.endingRuntime?.kind === "RACE" && state.endingRuntime.lifecycle === "active") return;
  if (!state.currentLevel || state.pendingLevel || now < state.endLockedUntil || now < state.nextEndCheckAt) return;
  state.nextEndCheckAt = now + CONFIG.endCheckInterval;
  if (state.currentLevel.endProvider === "button") {
                                                                        
                                                                               
    if (!state.currentLevel.completed && !state.currentLevel.interactionsRetired
      && state.currentLevel.remainingBlockButtons?.get("end") === 0) reachEnd();
    return;
  }
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber() !== 3) continue;
    const position = pawn.GetAbsOrigin();
    if (endPositionStatus(state.currentLevel, position).reason !== "inside") continue;
    reachEnd();
    return;
  }
}

function isStageGoalLevel(runtime) {
  if (!runtime) return false;
  if (runtime.debugEndingSnapshot) return true;
  const stage = stageSnapshotForRuntime(runtime);
  if (stage.infiniteMode) return state.infiniteCheckout?.passed === true;
  return (runtime.stageLevel ?? state.campaign.stageLevelCount) >= stage.stageGoal;
}

function handoffTransition(reached) {
  if (!reached || reached.lifecycle === "destroyed") return;
                                                                      
                                                                     
  queueSpawnPlatformFall(reached);
  if (isStageGoalLevel(reached)) {
    if (state.campaign.phase === "ending_handoff" || state.campaign.endingStarted) {
                                                                       
                                                                         
                                                                             
                                                          
      return;
    }
    state.campaign.phase = "ending_handoff";
    let stage = stageSnapshotForRuntime(reached);
    if (reached.debugEndingSnapshot) {
      retireInfiniteCheckout();
      state.campaign.currentStageSnapshot = stage;
    }
    if (stage.infiniteMode) {
      const checkoutValue = state.infiniteCheckout.checkoutValue;
      retireInfiniteCheckout();
      stage = Object.freeze({ ...stage, ending: "FINALE", finaleMode: "boss", finaleInfiniteMusic: true, checkoutValue });
    }
    // Original GenerateNextMap still fires MoveTP at the stage goal unless the
    // ending sets movetp_clean=false (HUNT, ASCEND); FINALE always moves.
    if (!["HUNT", "ASCEND"].includes(String(stage.ending || "").toUpperCase())
      && reached.tp && reached.incoming) moveTeleportDestination(reached.tp, reached.incoming);
                                                                           
                                                                       
    callEndingStartContract(stage, reached);
    if (reached.debugEndingSnapshot && state.endingRuntime) {
      state.endingRuntime.debugForced = true;
      state.endingRuntime.debugUsesFormalTimeline = true;
    }
    reached.lifecycle = "transition";
    return;
  }
  moveTeleportDestination(reached.tp, reached.incoming);
  generateNextLevel();
}

function beginTransition(reached) {
  if (!reached || reached.lifecycle === "destroyed") return;
  if (reached.lifecycle === "transition") return;
  setLevelLifecycle(reached, "transition");
  queueSpawnPlatformFall(reached);
  if (reached.sourceGenerationScheduled) retireSourceHistory(reached);
  const stageGoal = isStageGoalLevel(reached);
  if (stageGoal) state.campaign.phase = "ending_pending";
  else state.campaign.phase = "transition";
                                                                              
                                                                           
                                                                             
  schedule(CONFIG.interactionRetirementDelay, () => {
    if (reached.lifecycle === "destroyed") return;
    retireInteractions(reached);
    reached.interactionsRetired = true;
  }, reached.index);
  schedule(CONFIG.handoffDelay, () => handoffTransition(reached), reached.index);
}

function reachEnd() {
  const reached = state.currentLevel;
  if (!reached || reached.completed || Instance.GetGameTime() < state.endLockedUntil) return;
  // Consume only on a real accepted endpoint. Keep the generated snapshot
  // intact, and give transition/cleanup an immutable ending override.
  if (state.debugNextEnding && !state.endingRuntime && !state.campaign.endingStarted) {
    reached.debugEndingSnapshot = Object.freeze({ ...stageSnapshotForRuntime(reached),
      ending: state.debugNextEnding, infiniteMode: false,
      finaleMode: "boss", finaleInfiniteMusic: false });
    state.debugNextEnding = undefined;
    clearTerrainPreload();
  }
  reached.completed = true;
  state.currentLevel = undefined;
  state.transitionLevel = reached;
  setLevelLifecycle(reached, "end_delay");
  state.endLockedUntil = Instance.GetGameTime() + CONFIG.endCooldown;
  setEndIndicatorState(reached, "triggered");
  if (state.lastTriggeredEndIndicator && state.lastTriggeredEndIndicator !== reached) {
    setEndIndicatorState(state.lastTriggeredEndIndicator, "old");
  }
  state.lastTriggeredEndIndicator = reached;
  const legacyRuntime = !reached.stageSnapshot;
  const delay = legacyRuntime ? CONFIG.transitionDelay : stageEndDelay(reached);
  announce(reached.debugEndingSnapshot
    ? `DEBUG: level ${reached.index} complete; entering ${reached.debugEndingSnapshot.ending} after the normal endpoint handoff`
    : `Level ${reached.index} complete; generating next level in ${delay} seconds`);
  if (legacyRuntime) schedule(delay, () => handoffTransition(reached), reached.index);
  else schedule(delay, () => beginTransition(reached), reached.index);
}

function moveTeleportDestination(position, direction) {
  const destination = state.teleportDestination;
  if (!destination || !destination.IsValid()) {
    failRuntime("teledest became invalid");
    return;
  }
  state.teleportFacing = anglesFor(direction);
  destination.Teleport({ position, angles: state.teleportFacing, velocity: vec() });
  positionTeleportIndicator(position, true);
}

function updateInfectionState(now) {
  if (!state.running) return;
  if (state.firstInfectionAt === undefined) {
    const firstZombies = allLivingPawns().filter((pawn) => pawn.GetTeamNumber?.() === 2);
    if (firstZombies.length > 0) {
      state.firstInfectionAt = now;
      state.motherZombies = new Set(firstZombies);
      applyCheapModelToMotherZombies(firstZombies);
    }
  }
  if (state.infectionActivated) return;
  const elapsed = now - state.roundStartedAt;
  const foundZombie = elapsed >= CONFIG.infectionMinTime && allLivingPawns().some((pawn) => pawn.GetTeamNumber() === 2);
  if (!foundZombie && elapsed < CONFIG.infectionFallback) return;
  state.infectionActivated = true;
  fireName("tele_spawninit", "Disable");
  fireName("tele_spawn", "Enable");
  fireName("afk_killer", "Enable");
  message(foundZombie ? "zombie detected; chase teleport enabled" : "infection fallback reached; chase teleport enabled");
}

function spawnTeleRoundStart(inputData) {
  const pawn = resolvePawn(inputData?.activator);
  if (!pawn) return;
  const position = pawn.GetAbsOrigin();
  pawn.Teleport({
    position: vec(position.x, position.y, 4),
    angles: anglesFor(state.startPoint.direction),
    velocity: vec(),
  });
  applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.humanModel);
}

function spawnTele(inputData) {
  const pawn = resolvePawn(inputData?.activator);
  if (!pawn) return;
  pawn.Teleport({
    velocity: vec(Math.floor(Math.random() * 41) - 20, Math.floor(Math.random() * 101) - 50, 0),
  });
  // 原生 trigger_teleport 套用 teledest 角度后实机朝向偏 90°；这里按 teledest
  // 摆放方向直接设视角，使传送后面对地形。输出与原生传送先后不定，故再补一次。
  const facing = state.teleportFacing
    ?? (state.startPoint?.direction ? anglesFor(state.startPoint.direction) : undefined);
  if (facing) {
    pawn.Teleport({ angles: { ...facing } });
    afterThink(() => {
      if (validEntity(pawn) && pawn.IsAlive?.()) pawn.Teleport({ angles: { ...facing } });
    });
  }
  if (infectionHasStarted() && pawn.GetTeamNumber?.() === 2) {
    applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.zombieModel);
  }
}

// 原版 ::CHEAP_PLAYERMODELS。CS2 版默认关闭，由服务器用 StripperCS2 添加名为
// switchName 的实体开启；tintSwitchName 对应 ::CHEAP_PLAYERMODELS_TINT（保留服务器染色）。
// 原版开局人类用 playercheap_ct_nohitbox，但该模型未被地图引用打包，这里用 playercheap_ct。
const CHEAP_PLAYERMODEL_CONFIG = Object.freeze({
  switchName: "collective_cfg_cheap_playermodels",
  tintSwitchName: "collective_cfg_cheap_playermodels_tint",
  humanModel: "models/player/custom_player/luffaren/playercheap_ct.vmdl",
  zombieModel: "models/player/custom_player/luffaren/playercheap_t.vmdl",
  tickInterval: 3,
  tickMinHealth: 1002,
  motherZombieReapplyDelay: 0.5,
  killReapplyDelay: 0.1,
});

// forced：ent_fire 测试用的手动覆盖（true/false），undefined 时跟随 Stripper 开关实体；换图后失效。
const cheapPlayerModels = { enabled: false, keepTint: false, nextTickAt: 0, forced: undefined };

function refreshCheapPlayerModelSwitch() {
  const wasEnabled = cheapPlayerModels.enabled;
  cheapPlayerModels.enabled = cheapPlayerModels.forced
    ?? validEntity(Instance.FindEntityByName(CHEAP_PLAYERMODEL_CONFIG.switchName));
  cheapPlayerModels.keepTint = validEntity(Instance.FindEntityByName(CHEAP_PLAYERMODEL_CONFIG.tintSwitchName));
  cheapPlayerModels.nextTickAt = 0;
  if (cheapPlayerModels.enabled !== wasEnabled) {
    message(`cheap player models ${cheapPlayerModels.enabled ? "enabled" : "disabled"}${cheapPlayerModels.keepTint ? " (keep tint)" : ""}`);
  }
}

function sameModelPath(left, right) {
  const normalize = (value) => String(value ?? "").toLowerCase().replace(/\\/g, "/").replace(/_c$/, "");
  return normalize(left) === normalize(right);
}

function applyCheapPlayerModel(pawn, model) {
  if (!cheapPlayerModels.enabled || !validEntity(pawn) || !pawn.IsAlive?.()) return;
  if (activeImpostorController(pawn)) return;
  if (!sameModelPath(pawn.GetModelName?.(), model)) pawn.SetModel?.(model);
  if (!cheapPlayerModels.keepTint) pawn.SetColor?.({ r: 255, g: 255, b: 255, a: 255 });
}

function applyCheapModelToMotherZombies(pawns) {
  if (!cheapPlayerModels.enabled) return;
  const model = CHEAP_PLAYERMODEL_CONFIG.zombieModel;
  for (const pawn of pawns) applyCheapPlayerModel(pawn, model);
  schedule(CHEAP_PLAYERMODEL_CONFIG.motherZombieReapplyDelay, () => {
    for (const pawn of pawns) {
      if (validEntity(pawn) && pawn.GetTeamNumber?.() === 2) applyCheapPlayerModel(pawn, model);
    }
  });
}

// ent_fire manager RunScriptInput CheapPlayerModelsOn / CheapPlayerModelsOff / CheapPlayerModelsAuto
function setCheapPlayerModelOverride(forced) {
  cheapPlayerModels.forced = forced;
  refreshCheapPlayerModelSwitch();
  message(`cheap player models override=${forced ?? "auto"} enabled=${cheapPlayerModels.enabled}`);
  if (!cheapPlayerModels.enabled) return;
  for (const pawn of allLivingPawns()) {
    const team = pawn.GetTeamNumber?.();
    if (team === 3) applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.humanModel);
    else if (team === 2) applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.zombieModel);
  }
}

function processCheapPlayerModels(now) {
  if (!cheapPlayerModels.enabled || !infectionHasStarted() || now < cheapPlayerModels.nextTickAt) return;
  cheapPlayerModels.nextTickAt = now + CHEAP_PLAYERMODEL_CONFIG.tickInterval;
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() !== 2) continue;
    if (Number(pawn.GetHealth?.() ?? 0) < CHEAP_PLAYERMODEL_CONFIG.tickMinHealth) continue;
    if (sameModelPath(pawn.GetModelName?.(), CHEAP_PLAYERMODEL_CONFIG.zombieModel)) continue;
    applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.zombieModel);
  }
}

function touchAfkTrigger(inputData) {
  const pawn = resolvePawn(inputData?.activator);
  if (!pawn || pawn.GetTeamNumber() !== 3 || !pawn.IsAlive()) return;
  const target = state.currentLevel?.tp
    ?? state.transitionLevel?.tp
    ?? add(state.startPoint.position, mul(state.startPoint.direction, CONFIG.gridSize / 2));
  pawn.Teleport({ position: target, angles: anglesFor(state.currentDirection), velocity: vec() });
}

function fallDownTouchTrigger(inputData) {
  const pawn = resolvePawn(inputData?.activator);
  if (!pawn || pawn.GetTeamNumber() !== 3 || !pawn.IsAlive()) return;
  const checkpoint = state.falldownCheckpoints.get(pawn);
  const checkpointEntity = checkpoint?.IsValid?.() ? checkpoint : undefined;
  const checkpointPosition = checkpointEntity?.GetAbsOrigin?.();
  const health = Number(pawn.GetHealth?.() ?? 0);
  const rescuedHealth = health - CONFIG.falldownCheckpointDamage;
  const suppressed = (state.falldownCheckpointSuppressions.get(pawn) ?? 0) > Instance.GetGameTime();
  const canRescue = state.falldownCheckpointEnabled
    && !suppressed
    && checkpointPosition
    && Number.isFinite(rescuedHealth)
    && rescuedHealth > 0;

  if (canRescue) {
    state.falldownCheckpoints.delete(pawn);
    pawn.Teleport({
      position: vec(
        checkpointPosition.x,
        checkpointPosition.y,
        checkpointPosition.z + CONFIG.falldownCheckpointRespawnOffsetZ,
      ),
      velocity: vec(),
    });
    if (typeof pawn.SetHealth === "function") pawn.SetHealth(rescuedHealth);
    else pawn.TakeDamage?.({ damage: CONFIG.falldownCheckpointDamage, damageFlags: CSDamageFlags.IGNORE_ARMOR ?? 0 });
    const checkpointName = checkpointEntity.GetEntityName?.() ?? "block_*";
    message(`[FALL] rescued CT: -${CONFIG.falldownCheckpointDamage} HP -> ${Math.round(rescuedHealth)}, checkpoint=${checkpointName}`);
    return;
  }

                                                                      
                                                                  
  const attackerRecord = state.falldownCheckpointAttackers.get(pawn);
  const attacker = attackerRecord?.expiresAt > Instance.GetGameTime() && validEntity(attackerRecord.attacker)
    ? attackerRecord.attacker
    : undefined;
  const damage = {
    damage: 999999,
    damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0),
  };
  if (attacker) damage.attacker = attacker;
  pawn.TakeDamage(damage);
  state.falldownCheckpoints.delete(pawn);
  message(`[FALL] lethal fall: checkpoint ${state.falldownCheckpointEnabled ? "missing/invalid" : "disabled"}`);
}

const BLOCK_SPAWN_SAFETY = Object.freeze({ lifetime: 0.10, maxDistance: 800 });

function spawnSafetyReturnFor(index) {
  if (index === 1) {
                                                                       
                                                                          
    const direction = state.startPoint?.direction;
    if (state.spawnPlatformKilled || state.spawnPlatformFallScheduled
      || !direction || !Number.isFinite(direction.x) || !Number.isFinite(direction.y)
      || Math.hypot(direction.x, direction.y) === 0) return undefined;
    return { position: vec(0, 0, 16), angles: anglesFor(direction), source: "spawnPlatform" };
  }
  const previous = state.levels.get(index - 1);
  if (!previous?.end || !previous?.outgoing) return undefined;
  return {
    position: add(sub(previous.end, mul(previous.outgoing, CONFIG.gridSize / 2)), vec(0, 0, 16)),
    angles: anglesFor(previous.outgoing),
  };
}

function blockSpawnSafetyIsOpen(runtime) {
  if (!runtime || runtime.spawnSafetyClosed || runtime.completed
    || ["active", "history", "end_delay", "transition", "outcome_pending", "destroyed"].includes(runtime.lifecycle)) return false;
  const ending = state.endingRuntime;
  if (ending && ["spawning", "active", "defending", "collapsing", "outcome_pending"].includes(ending.lifecycle)
    && !runtime.raceLevel && !runtime.finaleEscape) return false;
  return true;
}

function closeBlockSpawnSafety(runtime) {
  if (!runtime || runtime.spawnSafetyClosed) return;
  runtime.spawnSafetyClosed = true;
  clearSpawnSafetyTriggers(runtime.index);
}

function spawnBlockSafetyTrigger(runtime, request) {
  if (!blockSpawnSafetyIsOpen(runtime)) return undefined;
  let destination = Object.hasOwn(runtime, "spawnSafetyReturn")
    ? runtime.spawnSafetyReturn : spawnSafetyReturnFor(runtime.index);
                                                                        
  if (runtime.index === 1 && !destination) destination = spawnSafetyReturnFor(1);
                                                                             
  if (runtime.index === 1 && !destination) return undefined;
  const spawned = spawnRoundEntities(featureTemplate("spawnSafety"), request.position, request.angles) ?? [];
  const triggers = spawned.filter(entity => validEntity(entity)
    && entity.GetClassName?.() === "trigger_multiple");
  if (triggers.length !== 1 || spawned.length !== 1) {
    destroyEntities(spawned);
    throw new Error("template_spawn_safety must spawn exactly one trigger_multiple");
  }
  const trigger = triggers[0];
                                                                              
                                                                                
  trigger.SetEntityName(`spawn_safety_${runtime.index}`);
  runtime.entities.add(trigger);
  state.spawnSafetyTriggers.set(trigger, {
    runtime,
    destination,
    expiresAt: Instance.GetGameTime() + BLOCK_SPAWN_SAFETY.lifetime,
  });
  fireTarget(trigger, "Disable");
  fireTarget(trigger, "Enable", undefined, 0.01);
  fireTarget(trigger, "Enable", undefined, 0.03);
                                                              
  fireTarget(trigger, "Kill", undefined, BLOCK_SPAWN_SAFETY.lifetime);
  return trigger;
}

function clearSpawnSafetyTriggers(owner, now) {
  for (const [trigger, record] of state.spawnSafetyTriggers) {
    if (owner !== undefined && record.runtime.index !== owner) continue;
    if (now !== undefined && now < record.expiresAt && validEntity(trigger)) continue;
    if (validEntity(trigger)) trigger.Kill();
    record.runtime.entities.delete(trigger);
    state.spawnSafetyTriggers.delete(trigger);
  }
}

function touchBlockSpawnTrigger(inputData) {
  const record = state.spawnSafetyTriggers.get(inputData?.caller);
                                                                       
  if (!record || !state.running || state.fatal
    || !validEntity(inputData.caller) || Instance.GetGameTime() >= record.expiresAt
    || !blockSpawnSafetyIsOpen(record.runtime)) return;
  const pawn = resolvePawn(inputData?.activator);
  if (!pawn || !pawn.IsAlive()) return;
  if (pawn.GetTeamNumber() === 2) {
    pawn.Teleport({ position: vec(0, 0, -16160), velocity: vec() });
  } else if (pawn.GetTeamNumber() === 3) {
    const destination = record.destination;
    const initialPlatform = record.runtime.index === 1 && destination?.source === "spawnPlatform";
    if (initialPlatform && (state.spawnPlatformKilled || state.spawnPlatformFallScheduled)) return;
    const origin = pawn.GetAbsOrigin();
    if (!destination || (!initialPlatform && Math.hypot(origin.x - destination.position.x,
      origin.y - destination.position.y, origin.z - destination.position.z) > BLOCK_SPAWN_SAFETY.maxDistance)) {
                                                                              
      message(`[SPAWN SAFETY] lethal CT: level=${record.runtime.index}, reason=${destination ? "return farther than 800" : "missing predecessor return"}`);
      pawn.TakeDamage({ damage: 999999,
        damageFlags: (CSDamageFlags.FORCE_DEATH ?? 0) | (CSDamageFlags.IGNORE_ARMOR ?? 0) });
      return;
    }
    pawn.Teleport({ position: clone(destination.position), angles: { ...destination.angles }, velocity: vec() });
    if (initialPlatform && !record.runtime.spawnSafetyRescueLogged) {
      record.runtime.spawnSafetyRescueLogged = true;
      message("[SPAWN SAFETY] first-level CT returned to spawn platform (no damage)");
    }
  }
}

function zombieAttackerTeleportsVictim(attacker) {
  const flight = playerItemSlots(attacker)?.get("knife");
  if (flight?.name === "flight" && flight.data.flightActive) return true;
  return !!activeImpostorController(attacker);
}

function releaseItemsOnDeath(pawn) {
  for (const item of [...(playerItemSlots(pawn)?.values() ?? [])]) {
    const runtime = itemRuntime(item);
    if (runtime && (item.spent || item.usesRemaining <= 0)) consumeItem(runtime, item);
    else dropItem(item, pawn?.GetAbsOrigin?.() ?? item.position);
  }
}

function handlePlayerKill(event) {
  const pawn = resolvePawn(event?.player ?? event?.victim ?? event?.controller);
  if (pawn) hideInvincibilityForPlayer(pawn);
  if (pawn) hidePledgePromptForPlayer(pawn);
  if (pawn) hideSquidBlindForPlayer(pawn);
  if (pawn) hideItemTutorialForPlayer(pawn);
  if (pawn) hideZombieItemLockForPlayer(pawn);
  if (pawn) releaseItemsOnDeath(pawn);
  const attacker = resolvePawn(event?.attacker);
  if (pawn && attacker && cheapPlayerModels.enabled) {
    schedule(CHEAP_PLAYERMODEL_CONFIG.killReapplyDelay, () => {
      if (validEntity(pawn) && pawn.GetTeamNumber?.() === 2) applyCheapPlayerModel(pawn, CHEAP_PLAYERMODEL_CONFIG.zombieModel);
    });
  }
  if (!pawn || !attacker || attacker === pawn || !zombieAttackerTeleportsVictim(attacker)) return;
                                                                         
                                                                               
                                                       
  pawn.Teleport?.({ position: vec(0, 0, -16160), velocity: vec() });
}

                                                                              
                                                                          
const SPAWN_PLATFORM_CONFIG = Object.freeze({
  transitionFallDelay: 4.8,
  enableMotionDelay: 0.05,
  wakeDelay: 0.10,
  helperKillDelay: 1,
  secondWakeDelay: 1.05,
  fadeStart: 5,
  fadeInterval: 0.05,
  fadeStep: 5,
  cleanupDelay: 7.65,
});

function queueSpawnPlatformFall(reached) {
  if (!reached || reached.lifecycle === "destroyed" || reached.spawnPlatformTransitionRecorded) return;
  reached.spawnPlatformTransitionRecorded = true;
  if (state.spawnPlatformKilled || state.spawnPlatformFallScheduled || state.finaleEscapeActive) return;
                                                                         
                                                                          
  const stage = stageSnapshotForRuntime(reached);
  if (stage.stageIndex === FINALE_STAGE_INDEX
    || (isStageGoalLevel(reached) && ["ASCEND", "HUNT"].includes(stage.ending))) return;
  state.spawnPlatformTransitionCount++;
  if (state.spawnPlatformTransitionCount <= CONFIG.maxAreaHistory) return;
  state.spawnPlatformFallScheduled = true;
  const serial = state.roundBootstrapSerial;
  const platform = Instance.FindEntityByName("spawnplatform");
  schedule(SPAWN_PLATFORM_CONFIG.transitionFallDelay, () => {
    if (serial !== state.roundBootstrapSerial || !state.running || state.fatal || state.spawnPlatformKilled) return;
    if (validEntity(platform)) fireTarget(platform, "FireUser1");
  });                                                                       
}

function spawnPlatformKill() {
  if (state.spawnPlatformKilled || !state.running || state.fatal) return;
  state.spawnPlatformKilled = true;
  state.spawnPlatformFallScheduled = true;
  const serial = state.roundBootstrapSerial;
  const platform = Instance.FindEntityByName("spawnplatform");
  const helper = Instance.FindEntityByName("spawnplatform_fallhelper");
  const board = Instance.FindEntityByName("spawninfoboard");
  const label = Instance.FindEntityByName(SPAWN_STAGE_LABEL_TARGET);
  const buyzone = Instance.FindEntityByName("buyzone");
  if (validEntity(buyzone)) buyzone.Teleport({ position: vec(0, 0, -18000) });
  if (validEntity(helper)) {
    const yaw = Math.floor(Math.random() * 361) * Math.PI / 180;
    const radius = Math.floor(Math.random() * 501);
    helper.Teleport({ position: vec(Math.cos(yaw) * radius, Math.sin(yaw) * radius, -80) });
  }
                                                                          
                                                                             
  const later = (delay, callback) => schedule(delay, () => {
    if (serial !== state.roundBootstrapSerial || !state.running || state.fatal) return;
    callback();
  });
  const input = (entity, name, value) => {
    if (validEntity(entity)) fireTarget(entity, name, value);
  };
  later(SPAWN_PLATFORM_CONFIG.enableMotionDelay, () => input(platform, "EnableMotion"));
  later(SPAWN_PLATFORM_CONFIG.wakeDelay, () => input(platform, "Wake"));
  later(SPAWN_PLATFORM_CONFIG.helperKillDelay, () => input(helper, "Kill"));
  later(SPAWN_PLATFORM_CONFIG.secondWakeDelay, () => input(platform, "Wake"));
  let step = 0;
  for (let alpha = 255; alpha > 0; alpha -= SPAWN_PLATFORM_CONFIG.fadeStep) {
    const at = SPAWN_PLATFORM_CONFIG.fadeStart + (++step * SPAWN_PLATFORM_CONFIG.fadeInterval);
    later(at, () => {
                                                                        
                                                                            
      input(platform, "Alpha", alpha);
      input(board, "Alpha", alpha);
    });
  }
  later(SPAWN_PLATFORM_CONFIG.cleanupDelay, () => {
    input(platform, "Kill");
    input(board, "Kill");
    input(label, "Kill");
  });
}

function armAdminPlatformRetirement(serial = state.roundBootstrapSerial) {
                                                                          
                                                                            
  schedule(CONFIG.adminPlatformKillDelay, () => {
    if (serial !== state.roundBootstrapSerial) return;
    fireName("adminplatform", "Kill");
  });
}

function adminRoomPressed(inputData) {
  const caller = inputData?.caller;
  if (!validEntity(caller) || caller.GetClassName?.() !== "func_button") return false;
  const callerName = caller.GetEntityName?.() ?? "";
  if (!callerName.startsWith("adminbutton_")) return false;
  const button = callerName.slice("adminbutton_".length);
  if (button !== "slay" && !isAdminStageSelection(button)) return false;
  if (button === "slay" && state.adminSlayActive) return false;
  if (button !== "slay" && state.campaign.adminSelection === button) return false;
  const presser = resolvePawn(inputData?.activator);
  message(`ADMIN BUTTON PRESSED: ${button} by ${presser?.GetEntityName?.() || "console/player"}`);
  announce(`ADMIN BUTTON PRESSED: ${button}`);
  if (button !== "slay") {
                                                                          
                                                                        
                                                                    
    state.campaign.adminSelection = button;
    state.campaign.legitWin = button === "reset" || button === "stage1";
    if (button !== "reset") message(`[ADMIN] ${button} selected for the next round; use slay to end this round`);
  }
  if (button === "slay" || button === "reset") adminRoomSlay();
  return true;
}

const ADMIN_ROOM_STAGE_INDICES = Object.freeze({
  stage1: 0, stage2: 1, stage3: 2, stage4: 3,
  finale: FINALE_STAGE_INDEX, infinite: FINALE_STAGE_INDEX + 1,
});

function isAdminStageSelection(button) {
  return button === "reset" || Object.hasOwn(ADMIN_ROOM_STAGE_INDICES, button);
}

function applyPendingAdminSelection() {
  const button = state.campaign.adminSelection;
  if (!isAdminStageSelection(button)) return false;
  state.campaign.adminSelection = undefined;
  if (button === "reset") {
                                                                           
                                                                         
    state.campaign.themeOrder = shuffledCampaignThemeOrder();
    state.campaign.endingOrder = shuffledEndingOrder();
    state.campaign.stageWins = 0;
    state.campaign.lastFailure = undefined;
  }
  state.campaign.stageIndex = button === "reset" ? 0 : ADMIN_ROOM_STAGE_INDICES[button];
  state.campaign.legitWin = button === "reset" || button === "stage1";
  state.campaign.finaleAnchor = undefined;
  state.campaign.finaleDirection = undefined;
                                                                         
  for (const key of ["debugShowcaseMode", "debugGravityMode", "debugMovementThemesMode",
    "debugAllModelsMode", "debugTrapMode", "debugSilentHillTheme", "debugStageMirror"]) state[key] = false;
  state.debugStageId = undefined;
  state.campaign.currentStageSnapshot = createCampaignStageSnapshot(
    state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex],
  );
  return true;
}

function adminRoomSlay() {
  if (state.adminSlayActive) return false;
  state.adminSlayActive = true;
  setZombieRespawning(false);
                                                                         
                                                                       
                                                                       
  fireName("tele_spawninit", "Disable");
  fireName("tele_spawn", "Disable");
  fireName("spawnkiller", "Enable");
  fireName("tpdest_indicator", "Disable");
  const serial = state.roundBootstrapSerial;
  schedule(0.04, () => {
    if (state.adminSlayActive && serial === state.roundBootstrapSerial) fireName("KILL_ALL_REAL", "Enable");
  });
  for (const pawn of allLivingPawns()) {
    if (pawn.GetTeamNumber?.() === 3) raceKillPawn(pawn);
  }
                                                                            
                                                                            
  for (const runtime of new Set([...state.levels.values(), state.endingRuntime])) {
    if (!runtime || runtime.lifecycle === "destroyed") continue;
    for (const item of [...runtime.items ?? []]) {
      if (item.name !== "flight" || ["consumed", "cleaned"].includes(item.state)) continue;
      if (item.holder?.IsAlive?.()) raceKillPawn(item.holder);
      consumeItem(runtime, item);
    }
  }
  return true;
}







function missingFinaleFeatureTemplates(mode = "boss") {
  const keys = ["model", "finaleMover", "finaleThunder", "finaleRain", "finaleRainGround"];
  if (mode !== "pyramid") keys.push("hold", "bossPieceTouch", "trigger",
    "bossEyeTouch", "bossEyeDamage", "bossGrenadeDamage",
    FINALE_BOSS_CONFIG.lowgravTriggerTemplateKey, "finaleZombieMover");
  return [...new Set(keys)].filter(key => !state.featureTemplates.has(key)).map(key => FEATURE_TEMPLATE_NAMES[key]);
}





















function reportGeneratedTeleports() {
  const pawnPosition = allLivingPawns()[0]?.GetAbsOrigin?.();
  const records = activeRuntimes().flatMap(runtime =>
    [...runtime.teleportEntries ?? []].map(entry => ({ runtime, entry })));
  if (pawnPosition) records.sort((a, b) =>
    Math.hypot(a.entry.position.x - pawnPosition.x, a.entry.position.y - pawnPosition.y, a.entry.position.z - pawnPosition.z)
    - Math.hypot(b.entry.position.x - pawnPosition.x, b.entry.position.y - pawnPosition.y, b.entry.position.z - pawnPosition.z));
  message(`[TELEPORT STATUS] generated entries=${records.length}; showing nearest ${Math.min(16, records.length)}`);
  for (const { runtime, entry } of records.slice(0, 16)) {
    const trigger = entry.trigger;
    const expected = add(entry.position, vec(0, 0, CONFIG.teleportTriggerZOffset));
    const actual = validEntity(trigger) ? trigger.GetAbsOrigin?.() : undefined;
    const mismatch = actual ? Math.hypot(actual.x - expected.x, actual.y - expected.y, actual.z - expected.z) > 0.5 : true;
    const parent = validEntity(trigger) ? trigger.GetParent?.() : undefined;
    message(`[TELEPORT STATUS] level=${runtime.index} id=${runtime.id} group=${entry.group}`
      + ` trigger=${validEntity(trigger) ? trigger.GetEntityName?.() ?? "unnamed" : "missing"} valid=${validEntity(trigger)} ready=${entry.ready ?? "unknown"}`
      + ` callback=${entry.connection !== undefined && entry.connection !== null}`
      + ` parent=${parent?.GetEntityName?.() ?? (parent ? "unnamed" : "none")}`
      + ` origin=${actual ? formatVector(actual) : "missing"} expected=${formatVector(expected)} mismatch=${mismatch}`
      + ` destinations=${runtime.teleportDestinations?.get(entry.group)?.length ?? 0}`
      + ` touches=${entry.touches ?? 0} teleports=${entry.teleports ?? 0} bounces=${entry.bounces ?? 0}`
      + ` invalidActivators=${entry.invalidActivators ?? 0}`);
  }
  return records.length > 0;
}























function resetPlayerEffects(event) {
  const pawn = resolvePawn(event?.player ?? event?.controller ?? event?.pawn ?? event);
  if (!pawn) return;
  clearAirslide(pawn);
  hideInvincibilityForPlayer(pawn);
  hidePledgePromptForPlayer(pawn);
  hideItemTutorialForPlayer(pawn);
  hideZombieItemLockForPlayer(pawn);
  dropHeldItem(pawn);
  state.liquidDamageCooldowns.delete(pawn);
  state.teleportEntryFallDamageTokens.delete(pawn);
  for (const runtime of activeRuntimes()) clearBoostPads(runtime, pawn);
  state.liquidShallowJumpCooldowns.delete(pawn);
  state.liquidShallowStreamHistory.delete(pawn);
  state.falldownCheckpointQueue = state.falldownCheckpointQueue.filter((candidate) => candidate !== pawn);
  state.falldownCheckpoints.delete(pawn);
  state.falldownCheckpointSuppressions.delete(pawn);
  state.falldownCheckpointAttackers.delete(pawn);
  clearPlayerStatuses(undefined, pawn);
  for (const runtime of activeRuntimes()) for (const liquid of runtime.liquids ?? []) liquid.contacts.delete(pawn);
  const effect = state.playerEffects.get(pawn);
  if (!effect) return;
  setPlayerGravity(pawn, 1);
  state.playerEffects.delete(pawn);
}

// An uncaught throw used to skip SetNextThink and freeze the whole script.
// Each step is isolated and the next Think is always scheduled.
const guardedErrorLog = new Map();
function reportGuardedError(step, error) {
  const now = Instance.GetGameTime();
  if ((guardedErrorLog.get(step) ?? -Infinity) > now) return;
  guardedErrorLog.set(step, now + 5);
  message(`ERROR in ${step}: ${error?.stack ?? error}`);
}

function guardStep(step, callback, fallback) {
  try {
    return callback();
  } catch (error) {
    reportGuardedError(step, error);
    return fallback;
  }
}

function think() {
  try {
    thinkPlayerPawns = resolvePlayerPawns();
    thinkBody();
  } catch (error) {
    reportGuardedError("think", error);
  } finally {
    thinkPlayerPawns = undefined;
    try {
      Instance.SetNextThink(Instance.GetGameTime() + (state.running ? CONFIG.thinkInterval : CONFIG.idleThinkInterval));
    } catch (error) {
      reportGuardedError("SetNextThink", error);
    }
  }
}

function thinkBody() {
  const now = Instance.GetGameTime();
  guardStep("recoverStalledAfterThinks", () => recoverStalledAfterThinks(now));
  guardStep("processDeferredEntityKills", () => processDeferredEntityKills());
  guardStep("pruneRoundEntities", () => pruneRoundEntities(now));
  endDiagnostics.lastThinkAt = now;
  if (endDiagnostics.enabled && now >= endDiagnostics.nextReportAt) {
    endDiagnostics.nextReportAt = now + 2;
    guardStep("reportEndDiagnostics", () => reportEndDiagnostics(now));
  }
  guardStep("clearSpawnSafetyTriggers", () => clearSpawnSafetyTriggers(undefined, now));
  guardStep("processSourceAudio", () => processSourceAudio(now));
  guardStep("processTasks", () => processTasks(now));
  guardStep("processDebugThunder", () => processDebugThunder(now));
  guardStep("processThemeModelSky", () => processThemeModelSky(now));
  if (state.running && !state.fatal) {
    guardStep("processThemePreload", () => processThemePreload(now));
    guardStep("processThemeMusic", () => processThemeMusic(now));
    guardStep("processGenericEvents", () => processGenericEvents(now));
    guardStep("processSilentHillVisualChange", () => processSilentHillVisualChange());
    guardStep("processEndingRuntime", () => processEndingRuntime());
    guardStep("updateInfectionState", () => updateInfectionState(now));
    guardStep("processCheapPlayerModels", () => processCheapPlayerModels(now));
    guardStep("checkEnd", () => checkEnd(now));
    guardStep("processAirslideVolumes", () => processAirslideVolumes(now));
    guardStep("processAirslideFailsafe", () => processAirslideFailsafe(now));
    guardStep("processLowgravFailsafe", () => processLowgravFailsafe(now));
    guardStep("processFalldownCheckpoints", () => processFalldownCheckpoints(now));
    guardStep("processPlayerEffects", () => processPlayerEffects(now));
    guardStep("processPlayerStatuses", () => processPlayerStatuses(now));
    const itemInputPawns = guardStep("allLivingPawns", () => allLivingPawns(), []);
    const usePressed = guardStep("sampleUseInputs", () => sampleUseInputs(itemInputPawns), new Set());
    const itemUseConsumed = guardStep("processHeldItemInputs", () => processHeldItemInputs(usePressed, itemInputPawns), new Set());
    guardStep("processTrapInputs", () => processTrapInputs(usePressed, itemUseConsumed));
    guardStep("processWorldItemInputs", () => processWorldItemInputs(itemUseConsumed, usePressed, itemInputPawns));
    guardStep("queueDeployableUseInputs", () => queueDeployableUseInputs(usePressed, itemUseConsumed));
    guardStep("processMovers", () => processMovers(now));
    guardStep("processLiquids", () => processLiquids(now));
    guardStep("processTraps", () => processTraps(now));
    guardStep("processItems", () => processItems(now));
    guardStep("processGenerationQueues", () => processGenerationQueues());
    if (!state.fatal) guardStep("processTerrainSpawnFades", () => processTerrainSpawnFades(now));
  }
  guardStep("syncInvincibilityHud", () => syncInvincibilityHud(now));
  guardStep("syncItemTutorials", () => syncItemTutorials(now));
  guardStep("syncZombieItemLocks", () => syncZombieItemLocks(now));
}

function wakeRuntime(source) {
  const firstWake = !state.activated;
  state.activated = true;
  cacheEntities();
                                                                            
  showTerrainPreviewHudStatic(source);
  Instance.SetNextThink(Instance.GetGameTime());
  if (firstWake) message(`runtime awakened by ${source}`);
}

function activateRuntime() {
                                                                           
                                                                            
                                                                            
  resetRoundState();
  wakeRuntime("OnActivate");
  schedule(1, () => {
    if (state.running || state.roundBootstrapPending) return;
    message("round_start was not observed after activation; using activation fallback");
    beginRound();
  });
  message("CS2 core runtime activated; waiting for round_start");
}

function roundStartRuntime() {
                                                                             
                                                                              
                                                       
  wakeRuntime("OnRoundStart");
  schedule(0.5, beginRound);
}

function bootstrapMissedLifecycle() {
  if (state.running || state.roundBootstrapPending) return;
  wakeRuntime("module-load fallback");
  message("OnActivate/round_start was not observed; using module-load fallback");
  beginRound();
}

                                                                             
                             

































































































                           
















Instance.SetThink(think);
                                                                             
                                                                
Instance.SetNextThink(Instance.GetGameTime());
schedule(1, bootstrapMissedLifecycle);

Instance.OnActivate(activateRuntime);

Instance.OnScriptReload({
  before: () => {
    clearThemeTerrainWarmup();
    stopDebugThunder();
    clearSpawnSafetyTriggers();
    clearSourceAudio();
    const memory = {
      debugShowcaseMode: state.debugShowcaseMode,
      debugSilentHillTheme: state.debugSilentHillTheme,
      debugGravityMode: state.debugGravityMode,
      debugMovementThemesMode: state.debugMovementThemesMode,
      debugAllModelsMode: state.debugAllModelsMode,
      debugTrapMode: state.debugTrapMode,
      debugStageId: state.debugStageId,
      debugStageMirror: state.debugStageMirror,
      campaign: {
        stageIndex: state.campaign.stageIndex,
        adminSelection: state.campaign.adminSelection,
        legitWin: state.campaign.legitWin,
        stageWins: state.campaign.stageWins,
        lastFailure: state.campaign.lastFailure,
        currentStageSnapshot: state.campaign.currentStageSnapshot,
        phase: state.campaign.phase,
        endingStarted: state.campaign.endingStarted,
        endingContractCalls: state.campaign.endingContractCalls,
        lastEnding: state.campaign.lastEnding,
        endingResolved: state.campaign.endingResolved,
        endingOutcomePending: state.campaign.endingOutcomePending,
        complete: state.campaign.complete,
        finaleAnchor: state.campaign.finaleAnchor,
        finaleDirection: state.campaign.finaleDirection,
        endingOrder: [...state.campaign.endingOrder],
        themeOrder: state.campaign.themeOrder.map((theme) => themeProfile(theme).name),
      },
      endingRuntimeLifecycle: state.endingRuntime?.lifecycle,
      endingRuntimeKind: state.endingRuntime?.kind,
    };
                                                                            
                                                                            
    resetRoundState();
    return memory;
  },
  after: (memory) => {
    state.debugShowcaseMode = DEBUG_HOOKS.enabled && memory?.debugShowcaseMode === true;
    state.debugSilentHillTheme = DEBUG_HOOKS.enabled && memory?.debugSilentHillTheme === true;
    state.debugGravityMode = DEBUG_HOOKS.enabled && memory?.debugGravityMode === true;
    state.debugMovementThemesMode = DEBUG_HOOKS.enabled && memory?.debugMovementThemesMode === true;
    state.debugAllModelsMode = DEBUG_HOOKS.enabled && memory?.debugAllModelsMode === true;
    state.debugTrapMode = DEBUG_HOOKS.enabled && memory?.debugTrapMode === true;
    state.debugStageId = DEBUG_HOOKS.enabled && (ALL_LEVELS.some(level => level.id === memory?.debugStageId)
      || [DEBUG_DATA.spiderLevel.id, DEBUG_DATA.teleportLevel.id, DEBUG_DATA.liquidFallLevel.id, DEBUG_DATA.kartsLevel.id].includes(memory?.debugStageId))
      ? memory.debugStageId : undefined;
    state.debugStageMirror = state.debugStageId ? memory?.debugStageMirror === true : false;
    if (memory?.campaign) {
      state.campaign.stageIndex = Math.max(0, Math.min(Number.MAX_SAFE_INTEGER, memory.campaign.stageIndex ?? 0));
      state.campaign.adminSelection = isAdminStageSelection(memory.campaign.adminSelection)
        ? memory.campaign.adminSelection : undefined;
      state.campaign.legitWin = memory.campaign.legitWin !== false;
      state.campaign.stageWins = memory.campaign.stageWins ?? 0;
      state.campaign.lastFailure = memory.campaign.lastFailure;
      state.campaign.finaleAnchor = memory.campaign.finaleAnchor
        ? clone(memory.campaign.finaleAnchor)
        : undefined;
      state.campaign.finaleDirection = memory.campaign.finaleDirection
        ? clone(memory.campaign.finaleDirection)
        : undefined;
      if (Array.isArray(memory.campaign.endingOrder) && memory.campaign.endingOrder.length === STAGE_CONFIGS.length) {
        state.campaign.endingOrder = [...memory.campaign.endingOrder];
      }
      if (Array.isArray(memory.campaign.themeOrder) && memory.campaign.themeOrder.length === STAGE_CONFIGS.length) {
        state.campaign.themeOrder = memory.campaign.themeOrder.map((theme) => themeProfile(theme));
      }
      state.campaign.currentStageSnapshot = memory.campaign.currentStageSnapshot
        && Object.isFrozen(memory.campaign.currentStageSnapshot)
        ? memory.campaign.currentStageSnapshot
        : createCampaignStageSnapshot(state.campaign.stageIndex, state.campaign.endingOrder[state.campaign.stageIndex]);
    }
    wakeRuntime("OnScriptReload");
    message("script reloaded; rebuilding current round");
    beginRound();
    if (isAdminStageSelection(memory?.campaign?.adminSelection)) return;
    const endingWasLost = ["outcome_pending", "active", "spawning", "defending", "collapsing"].includes(memory?.endingRuntimeLifecycle)
      || memory?.campaign?.endingOutcomePending === true
      || (memory?.campaign?.endingStarted === true && !memory?.endingRuntimeLifecycle);
    if (endingWasLost) {
                                                                           
                                                                       
                                                                 
      retainCampaignStage(memory.endingRuntimeLifecycle === "outcome_pending"
        ? "script_reload_outcome_pending"
        : "script_reload_active_ending");
      state.campaign.phase = "active";
      return;
    }
    if (memory?.campaign?.phase === "ending_pending" || memory?.campaign?.phase === "ending_handoff") {
      state.campaign.phase = memory.campaign.phase;
      state.campaign.endingStarted = memory.campaign.endingStarted === true;
      state.campaign.endingContractCalls = memory.campaign.endingContractCalls ?? 0;
      state.campaign.lastEnding = memory.campaign.lastEnding;
      state.campaign.endingResolved = memory.campaign.endingResolved === true;
      state.campaign.endingOutcomePending = memory.campaign.endingOutcomePending === true;
      state.campaign.complete = memory.campaign.complete === true;
    }
  },
});

Instance.OnBeginRoundRestart(() => {
  hideTerrainPreviewHud("round-restart");
  releaseRoundToEngine();
});
Instance.OnRoundEnd((event = {}) => {
  state.running = false;
  cancelScheduledTasks();
  const ending = state.endingRuntime;
  const raceAudio = ending?.kind === "RACE" ? {
    sequence: ending.sequence,
    raceFinish: clone(ending.raceFinish ?? ending.anchor ?? vec()),
    raceRoundAudioArmed: ending.raceRoundAudioArmed,
  } : undefined;
  const winningTeam = Number(event?.winningTeam);
  roundCleanupStep("round result", () => {
    if (ending?.kind === "ASCEND") resolveAscension(ending, { roundEnded: true });
    const unresolvedOrdinaryEnding = ending && ending.kind !== "FINALE"
      && ending.debugForced !== true
      && ["active", "defending", "collapsing"].includes(ending.lifecycle)
      && !state.campaign.endingResolved;
    if (unresolvedOrdinaryEnding && winningTeam === 3) resolveStageEnding(true);
    else if (unresolvedOrdinaryEnding && winningTeam === 2) resolveStageEnding(false);
    if (!state.campaign.endingResolved)
      retainCampaignStage(ending?.debugForced ? "debug_race_round_end" : "round_end");
  });
  // The world stays up through the round-end delay; the round restart removes it.
  releaseRoundToEngine({ preserveCampaignOutcome: true });
  if (raceAudio) scheduleRaceRoundAudio(raceAudio, winningTeam);
});
Instance.OnRoundStart(roundStartRuntime);
Instance.OnPlayerReset(resetPlayerEffects);
Instance.OnPlayerKill?.(handlePlayerKill);
Instance.OnPlayerPing?.(useItemFromPing);
Instance.OnPlayerChat?.(useItemFromChat);
Instance.OnPlayerDamage?.(handleGenericPlayerDamage);
Instance.OnGrenadeThrow?.(handleGenericGrenadeThrow);
Instance.OnGrenadeBounce?.(handleTrapFloorGrenadeBounce);




Instance.OnModifyPlayerDamage(modifyPlayerDamage);





















