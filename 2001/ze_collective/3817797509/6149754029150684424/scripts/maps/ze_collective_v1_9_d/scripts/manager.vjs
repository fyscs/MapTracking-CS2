class ThemeProfile {
  constructor(name = "generic", options = {}) {
    this.name = String(name);
    this.id = this.name;
    this.visualMode = options.visualMode ?? "model_variants";
    this.assets = Object.freeze({ ...(options.assets ?? {}) });
                                                                       
                                                                               
    this.lowgravSkin = options.lowgravSkin ?? 1;
    this.airslideSkin = options.airslideSkin ?? 1;
    this.liquidSkin = options.liquidSkin ?? 1;
    this.hazardLiquidSkin = options.hazardLiquidSkin ?? 3;
                                                                            
                                                                           
    for (const key of ["trapsStep", "trapsVicinity", "trapsSpawn", "humanItems", "zombieItems"]) {
      this[key] = options[key] == null ? null : Object.freeze([...options[key]]);
    }
    for (const key of ["trapfloorChance", "trapstepChance", "trapvicinityChance", "trapspawnChance"]) {
      this[key] = options[key];
    }
    this.isGeneric = this.name === "generic";
    Object.freeze(this);
  }
}

