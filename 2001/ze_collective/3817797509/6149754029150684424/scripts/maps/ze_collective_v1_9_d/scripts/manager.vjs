function debugAllModelsCommand(args) {
  const command = String(args ?? "").trim().toLowerCase();
  if (command === "list") {
    const themes = Object.keys(THEME_PROFILES);
    message("debug model plots, left | right, preview top to bottom:");
    for (let row = 0; row < 4; row++) message(`${row + 1}: ${themes[row * 2]} | ${themes[row * 2 + 1]}`);
    message("model slots within each plot, left to right, row by row:");
    for (let row = 0; row < 5; row++) {
      const shapes = THEME_RUNTIME_TERRAIN_SHAPES.slice(row * 9, row * 9 + 9);
      message(`${row + 1}: ${shapes.join(", ")}`);
    }
    return;
  }
  if (command === "status") {
    message(`debug all models gallery is ${state.debugAllModelsMode ? "ON" : "OFF"}; ${Object.keys(THEME_PROFILES).length} themes x ${THEME_RUNTIME_TERRAIN_SHAPES.length} shapes; use 'list' for layout`);
    return;
  }
  let enabled;
  if (["on", "1", "true", "enable"].includes(command)) enabled = true;
  else if (["off", "0", "false", "disable"].includes(command)) enabled = false;
  else if (command === "" || command === "toggle") enabled = !state.debugAllModelsMode;
  else {
    message("usage: ze_debug_all_models <on|off|toggle|status|list>");
    return;
  }
  if (state.debugAllModelsMode === enabled && !state.debugShowcaseMode && !state.debugGravityMode && !state.debugMovementThemesMode && !state.debugTrapMode && !state.debugStageId) {
    message(`debug all models gallery is already ${enabled ? "ON" : "OFF"}`);
    return;
  }
  state.debugAllModelsMode = enabled;
  if (enabled) {
    state.debugShowcaseMode = false;
    state.debugGravityMode = false;
    state.debugMovementThemesMode = false;
    state.debugTrapMode = false;
    state.debugStageId = undefined;
    state.debugStageMirror = false;
  }
  announce(`debug all models gallery ${enabled ? "enabled" : "disabled"}; rebuilding generated area`);
  beginRound();
}

function debugSilentHillCommand(args) {
  const command = String(args ?? "").trim().toLowerCase();
  if (command === "status") {
    const world = state.silentHillWorld;
    message(`Silent Hill debug theme=${state.debugSilentHillTheme ? "forced" : "campaign"}`
      + ` current=${campaignStageSnapshot().theme}`
      + ` darkPreloaded=${state.silentHillDarkReady}`
      + ` requested=${world.requestedDark ? "dark" : "light"}`
      + ` music=${state.themeMusic.silenthillDark ? "dark" : "light"}`
      + ` models=${world.visualDark ? "dark" : "light"}`
      + ` tracked=${world.visuals.size} queued=${world.pending.length} fading=${world.active.length}`);
    return;
  }
  if (["on", "off"].includes(command)) {
    const enabled = command === "on";
    if (state.debugSilentHillTheme === enabled) {
      message(`Silent Hill theme override is already ${enabled ? "ON" : "OFF"}`);
      return;
    }
    state.debugSilentHillTheme = enabled;
    if (enabled) {
      state.debugShowcaseMode = false;
      state.debugGravityMode = false;
      state.debugMovementThemesMode = false;
      state.debugAllModelsMode = false;
      state.debugTrapMode = false;
      state.debugStageId = undefined;
      state.debugStageMirror = false;
    }
    announce(`Silent Hill theme override ${enabled ? "enabled" : "disabled"}; rebuilding generated area`);
    beginRound();
    return;
  }
  if (!["light", "dark", "toggle"].includes(command)) {
    message("usage: ze_debug_silenthill <on|off|light|dark|toggle|status>");
    return;
  }
  if (campaignStageSnapshot().theme !== "silenthill" || !state.running || state.fatal) {
    message("Silent Hill terrain is not active; use ze_debug_silenthill on first");
    return;
  }
  const dark = command === "toggle" ? !state.silentHillWorld.requestedDark : command === "dark";
  toggleSilentHillWorld(dark);
  message(`Silent Hill models switching to ${dark ? "dark" : "light"}`);
}

function debugSpidersCommand(args) {
  const command = String(args?.value ?? args ?? "").trim().toLowerCase() || "on";
  const selected = state.debugStageId === DEBUG_DATA.spiderLevel.id;
  if (command === "status") {
    const spiders = activeRuntimes().flatMap(runtime => [...runtime.traps ?? []])
      .filter(trap => trap.name === "thigh_spider" && !trap.spent && trap.health > 0);
    message(`[SPIDER DEBUG] selected=${selected} ready=${state.currentLevel?.debugSpiders === true}`
      + ` pending=${Boolean(state.pendingLevel)} live=${spiders.length}/12`);
    debugTrapsCommand("status");
    return true;
  }
  if (command === "off") {
    if (!selected) { message("debug spider lab is already OFF"); return false; }
    return debugStageCommand("off");
  }
  if (!["on", "restart"].includes(command)) {
    message("usage: ze_debug_spiders <on|off|restart|status>");
    return false;
  }
  if (command === "on" && selected) {
    message("debug spider lab already selected; use restart to respawn all 12 spiders");
    return true;
  }
  state.debugStageId = DEBUG_DATA.spiderLevel.id;
  state.debugStageMirror = false;
  state.debugShowcaseMode = false;
  state.debugGravityMode = false;
  state.debugMovementThemesMode = false;
  state.debugAllModelsMode = false;
  state.debugTrapMode = false;
  announce("debug flat spider lab enabled: 12 thigh spiders; rebuilding generated area");
  beginRound();
  return true;
}

function debugTrapsCommand(args) {
  const command = String(args ?? "").trim().toLowerCase();
  if (command === "status") {
    message(`debug trap pixel lab is ${state.debugTrapMode ? "ON" : "OFF"}`);
    for (const runtime of activeRuntimes()) for (const trap of runtime.traps ?? []) {
      if (trap.name !== "thigh_spider" || trap.spent) continue;
      message(`spider level=${runtime.index} hp=${trap.health} hitbox=${validEntity(trap.damageHitbox)}`
        + ` nativeHp=${trap.damageHitbox?.GetHealth?.() ?? "none"} biting=${trap.biting === true}`
        + ` jumping=${trap.jumping === true} grounded=${trap.grounded === true} z=${trap.position.z.toFixed(1)}`
        + ` embedded=${trap.embedded === true} adjusted=${trap.spawnGroundAdjusted === true}`
        + ` hitboxZ=${trap.damageHitbox?.GetAbsOrigin?.()?.z?.toFixed(1) ?? "none"}`
        + ` visualZ=${trap.visual?.GetAbsOrigin?.()?.z?.toFixed(1) ?? "none"}`);
    }
    return;
  }
  let enabled;
  if (["on", "1", "true", "enable"].includes(command)) enabled = true;
  else if (["off", "0", "false", "disable"].includes(command)) enabled = false;
  else if (command === "" || command === "toggle") enabled = !state.debugTrapMode;
  else {
    message("usage: ze_debug_traps <on|off|toggle|status>");
    return;
  }
  if (state.debugTrapMode === enabled && !state.debugShowcaseMode && !state.debugGravityMode && !state.debugMovementThemesMode && !state.debugAllModelsMode && !state.debugStageId) {
    message(`debug trap pixel lab is already ${enabled ? "ON" : "OFF"}`);
    return;
  }
  state.debugTrapMode = enabled;
  if (enabled) {
    state.debugShowcaseMode = false;
    state.debugGravityMode = false;
    state.debugMovementThemesMode = false;
    state.debugAllModelsMode = false;
    state.debugStageId = undefined;
    state.debugStageMirror = false;
  }
  announce(`debug trap pixel lab ${enabled ? "enabled" : "disabled"}; rebuilding generated area`);
  beginRound();
}

function debugSpawnItem(args) {
  const parts = String(args ?? "").trim().toLowerCase().replaceAll("-", "_").split(/[\s:]+/).filter(Boolean);
  const name = parts[0] ?? "";
  const itemVariant = parts[1];
  const definition = ITEM_DEFINITIONS[name];
  if (!definition) {
    message(`unknown item '${name}'; expected one of: ${Object.keys(ITEM_DEFINITIONS).join(", ")}`);
    return;
  }
  if (!ITEM_BEHAVIORS[definition.behavior]) {
    message(`item '${name}' remains quarantined; its original behaviour is not implemented`);
    return;
  }
  const pawn = allLivingPawns().find((candidate) => candidate.GetTeamNumber?.() === definition.team);
  const runtime = state.currentLevel;
  if (!pawn || !runtime) {
    message(`cannot spawn '${name}': no living team ${definition.team} tester or active level`);
    return;
  }
  const origin = pawn.GetAbsOrigin?.();
  const angles = pawn.GetAbsAngles?.() ?? { pitch: 0, yaw: 0, roll: 0 };
  if (!origin) return;
  const radians = angles.yaw * Math.PI / 180;
  const position = add(origin, vec(Math.cos(radians) * 96, Math.sin(radians) * 96, 12));
  try {
    spawnItemFeature(runtime, {
      position,
      angles: { pitch: 0, yaw: angles.yaw, roll: 0 },
      team: definition.team,
      itemName: name,
      itemVariant,
      debugItem: true,
      feature: `debug_item_${name}`,
    });
    message(`spawned acceptance-test item '${name}'`);
  } catch (error) {
    message(`debug item spawn failed: ${error}`);
  }
}

function debugItemPositions() {
  const format = position => position
    ? [position.x, position.y, position.z].map(value => Number(value).toFixed(2)).join(",")
    : "unavailable";
  let count = 0;
  for (const runtime of activeRuntimes()) for (const item of runtime.items ?? []) {
    if (!validEntity(item.carrier)) continue;
    const placement = item.spawnPlacement;
    const current = item.carrier.GetAbsOrigin?.();
    message(`[ITEM POSITION] #${item.id} ${item.name} state=${item.state} level=${runtime.id ?? runtime.index}`);
    message(`requested=${format(placement?.requested)} template=${format(placement?.templateOrigin)} aligned=${format(placement?.alignedOrigin)} current=${format(current)}`);
    message(`anchor=${format(item.measureReference?.GetAbsOrigin?.())} visual=${format(item.visual?.GetAbsOrigin?.())}`);
    count++;
  }
  if (!count) message("[ITEM POSITION] no live item carriers in active levels");
}


const DEBUG_COMMAND_HANDLERS = Object.freeze({
  debugEndCommand,
  debugNextEndingCommand,
  debugEndingCommand,
  debugEventCommand,
  debugAudioCommand,
  debugSquidBlindCommand,
  debugStageInfoCommand,
  debugShowcaseCommand,
  debugElevatorsCommand,
  debugNativeMoversCommand,
  debugStageCommand,
  debugGravityCommand,
  debugMovementThemesCommand,
  debugAllModelsCommand,
  debugSilentHillCommand,
  debugTrapsCommand,
  debugSpidersCommand,
  debugRaceCommand,
  debugKartsCommand,
  debugFinaleCommand,
  debugThunderCommand,
  debugTeleportCommand,
  debugTeleportMapCommand,
  debugLiquidFallCommand,
  debugSpawnItem,
  debugItemPositions,
  debugSkyboxCommand,
  debugSkyModelsCommand
});

// DEBUG_NATIVE_BACKEND_END

const debugNativeBridge = { owner: undefined, request: undefined, reply: undefined, rx: undefined, last: undefined,
  session: undefined, completedId: 0 };

const DEBUG_NATIVE_MAP_KEYS = Object.freeze({
  showcaseLevel: ["#debug_showcase", "debugShowcase"], gravityLevel: ["#debug_gravity", "debugGravity"],
  movementThemesLevel: ["#debug_movement_themes", "debugMovementThemes"],
  teleportLevel: ["#debug_teleport", "debugTeleport"], liquidFallLevel: ["#debug_liquid_fall", "debugLiquidFall"],
  allModelsLevel: ["#debug_all_models", "debugAllModels"], trapLevel: ["#debug_traps", "debugTraps"],
  kartsLevel: ["#debug_karts", "debugKarts"],
  spiderLevel: ["#debug_spiders", "debugSpiders"],
});

function installNativeDebugData(data) {
  // Check the complete transaction before changing any live fixture or hook.
  if (!data || typeof data !== "object" || Array.isArray(data)) throw Error("invalid debug data");
  const allowed = new Set([...Object.keys(DEBUG_NATIVE_MAP_KEYS), "showcaseExcludedTiles", "teleportLanes", "liquidFallColumns", "stageCatalog"]);
  if (Object.keys(data).some(key => !allowed.has(key))) throw Error("unknown debug data field");
  for (const [key, [id, flag]] of Object.entries(DEBUG_NATIVE_MAP_KEYS)) {
    const level = data[key];
    if (level?.id !== id || level[flag] !== true || !["forward", "left", "right"].includes(level.direction)
      || !Number.isFinite(level.elevation) || Math.abs(level.elevation) > 100
      || !Array.isArray(level.tiles) || level.tiles.length !== CONFIG.mapSize ** 2
      || level.tiles.some(tile => !Number.isInteger(tile) || !Object.hasOwn(TILE_REGISTRY, tile))
      || level.tiles.filter(tile => tile === 2).length !== 4
      || !Array.isArray(level.requiredCapabilities)) throw Error(`invalid debug map ${key}`);
  }
  if (!Array.isArray(data.stageCatalog) || data.stageCatalog.length > 100
    || data.stageCatalog.some(id => typeof id !== "string" || !ALL_LEVELS.some(level => level.id === id)))
    throw Error("invalid debug stage catalog");
  const karts = data.kartsLevel;
  if (karts.direction !== "forward" || karts.elevation !== 0
    || karts.tiles.some(tile => tile !== 2 && tile !== 14)
    || !Array.isArray(karts.debugKartPlacements) || karts.debugKartPlacements.length !== 100
    || karts.debugKartPlacements.some((placement, index) =>
      placement?.x !== 2 + (index % 10) * 1.7 || placement?.y !== 2 + Math.floor(index / 10) * 1.7))
    throw Error("invalid debug kart layout");
  if (!Array.isArray(data.showcaseExcludedTiles) || data.showcaseExcludedTiles.some(tile => !Number.isInteger(tile))
    || !Array.isArray(data.teleportLanes) || data.teleportLanes.length !== 4
    || !Array.isArray(data.liquidFallColumns) || data.liquidFallColumns.join(",") !== "default,legacy,normal,hazard")
    throw Error("invalid debug auxiliary data");
  for (const [index, lane] of data.teleportLanes.entries()) {
    if (lane.group !== index + 1 || !["horizontal", "fastfall", "slowfall", "upward"].includes(lane.mode)
      || !Number.isInteger(lane.row) || lane.row < 0 || lane.row >= CONFIG.mapSize
      || !Object.hasOwn(TILE_REGISTRY, lane.source) || !Object.hasOwn(TILE_REGISTRY, lane.destination))
      throw Error("invalid debug teleport lane");
  }
  for (const key of Object.keys(DEBUG_NATIVE_MAP_KEYS)) DEBUG_DATA[key] = data[key];
  DEBUG_DATA.showcaseExcludedTiles = new Set(data.showcaseExcludedTiles);
  DEBUG_DATA.teleportLanes = data.teleportLanes;
  DEBUG_DATA.liquidFallColumns = data.liquidFallColumns;
  DEBUG_DATA.stageCatalog = data.stageCatalog;
  DEBUG_DATA.stageIds = new Set(data.stageCatalog);
  refreshNativeDebugAliases();
  DEBUG_HOOKS.enabled = true;
  DEBUG_HOOKS.clearTeleportTest = clearDebugTeleportTest;
  DEBUG_HOOKS.enqueueShowcaseGalleries = enqueueDebugShowcaseGalleries;
  DEBUG_HOOKS.enqueueAllModelsGallery = enqueueDebugAllModelsGallery;
  DEBUG_HOOKS.enqueueLiquidFallGallery = enqueueDebugLiquidFallGallery;
  DEBUG_HOOKS.enqueueKarts = enqueueDebugKarts;
  DEBUG_HOOKS.levelDefinition = debugLevelDefinition;
}

function nativeDebugReply(session, id, part, ok, reason = "") {
  const bridge = debugNativeBridge;
  if (!validEntity(bridge.owner) || !validEntity(bridge.reply)) return;
  bridge.reply.SetEntityName(`zdbgr:${session}.${id}.${part}:${ok ? 1 : 0}:${reason.slice(0, 32)}`);
  Instance.EntFireAtTarget({ target: bridge.owner, input: "RunScriptInput", value: "CollectiveDebugAck",
    caller: bridge.reply });
}

function nativeDebugHello({ caller, activator } = {}) {
  const owner = Instance.FindEntityByName("collective_debug");
  const request = Instance.FindEntityByName("collective_debug_request");
  const reply = Instance.FindEntityByName("collective_debug_reply");
  if (!validEntity(owner) || activator !== owner || caller !== request || !validEntity(reply)
    || owner.GetClassName?.() !== "point_script" || request.GetClassName?.() !== "info_target"
    || reply.GetClassName?.() !== "info_target") return;
  Object.assign(debugNativeBridge, { owner, request, reply, rx: undefined, last: undefined,
    session: undefined, completedId: 0 });
  nativeDebugReply("hello", 0, 0, true);
}

function nativeDebugRequest({ caller, activator } = {}) {
  const bridge = debugNativeBridge;
  if (activator !== bridge.owner || caller !== bridge.request || !validEntity(bridge.owner)
    || Instance.FindEntityByName("collective_debug") !== bridge.owner) return;
  const frame = /^zdbgq:([0-9a-f]{1,8})\.(\d{1,6})\.(\d{1,4})\.(\d{1,4}):([A-Za-z0-9%_.!~*'()\-]{0,80})$/.exec(caller.GetEntityName());
  if (!frame) return;
  const [, session, idText, partText, countText, chunk] = frame;
  const id = Number(idText), part = Number(partText), count = Number(countText);
  const key = `${session}.${id}.${part}`;
  if (bridge.last?.key === key) {
    nativeDebugReply(session, id, part, bridge.last.ok, bridge.last.reason);
    return;
  }
  let ok = false, reason = "protocol";
  try {
    if (id < 1 || count < 1 || count > 1500 || part >= count) throw Error("bad frame bounds");
    if (part === 0) {
      if (bridge.rx || id <= bridge.completedId || (bridge.session && bridge.session !== session))
        throw Error("transaction already in progress or replayed");
      bridge.session = session;
      bridge.rx = { session, id, count, next: 0, chunks: [], deadline: Instance.GetGameTime() + 8 };
    }
    const rx = bridge.rx;
    if (!rx || rx.session !== session || rx.id !== id || rx.count !== count || rx.next !== part
      || Instance.GetGameTime() > rx.deadline) throw Error("out-of-order or expired frame");
    rx.chunks.push(chunk);
    rx.next++;
    rx.deadline = Instance.GetGameTime() + 8;
    if (rx.next === count) {
      // Claim the transaction before a handler can change gameplay or throw.
      bridge.completedId = id;
      const packet = JSON.parse(decodeURIComponent(rx.chunks.join("")));
      if (packet.action === "install") installNativeDebugData(packet.data);
      else if (packet.action === "command" && DEBUG_HOOKS.enabled
        && typeof packet.handler === "string" && Object.hasOwn(DEBUG_COMMAND_HANDLERS, packet.handler)
        && typeof packet.args === "string" && packet.args.length <= 512) {
        DEBUG_COMMAND_HANDLERS[packet.handler](packet.args);
      } else throw Error("unsupported debug request");
      bridge.rx = undefined;
    }
    ok = true; reason = "";
  } catch (error) {
    bridge.rx = undefined;
    reason = "rejected";
    // Debug failure is not a failure of the formal map runtime.
    message(`independent debug request rejected: ${error}`);
  }
  bridge.last = { key, ok, reason };
  nativeDebugReply(session, id, part, ok, reason);
}

Instance.OnScriptInput("CollectiveDebugHello", nativeDebugHello);

Instance.OnScriptInput("CollectiveDebugRequest", nativeDebugRequest);

Instance.EntFireAtName({ name: "collective_debug", input: "RunScriptInput", value: "CollectiveDebugReset" });
