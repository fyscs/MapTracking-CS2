const ENDING_NAMES = Object.freeze([
  "RISE",
  "CLIMB",
  "BUNKER",
  "BRIDGE",
  "ASCEND",
  "HUNT",
  "CONFLICT",
  "RACE",
]);

function shuffledEndingOrder(random = Math.random, count = STAGE_CONFIGS.length) {
  const pool = [...ENDING_NAMES];
  const result = [];
  while (pool.length > 0 && result.length < count) {
    const index = Math.floor(Math.max(0, Math.min(0.999999, random())) * pool.length);
    result.push(pool.splice(index, 1)[0]);
  }
  return result;
}

