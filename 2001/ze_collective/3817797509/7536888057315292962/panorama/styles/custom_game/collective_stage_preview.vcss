    border: 0;
    box-shadow: none;
}
.CollectivePreviewRoot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border: 0;
    box-shadow: none;
}
.CollectivePreviewRoot.Hidden {
    visibility: collapse;
}
.CollectiveStagePreview {
    width: 164px;
    height: fit-children;
    horizontal-align: left;
    vertical-align: center;
    margin-left: 9px;
    margin-bottom: 300px;
    padding: 0;
    flow-children: down;
    background-color: transparent;
    border: 2px solid #000000;
    box-shadow: none;
}
.StageHeader {
    width: 620px;
    height: 102px;
    horizontal-align: left;
    vertical-align: top;
    margin-left: 320px;
    margin-top: 40px;
    flow-children: down;
    color: #64ff20;
    font-size: 28px;
    font-weight: bold;
    opacity: 1;
}
.StageHeader.MetadataDisabled {
    opacity: 0;
}
.StageText {
    width: 620px;
    height: 34px;
    white-space: nowrap;
    text-overflow: shrink;
}
.PixelGrid {
