      {
        "output": "OnUser2",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **Defend here for 30 seconds until the gates open**",
        "delay": 0,
        "limit": -1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] There are accounts of the holy city here dating back to writings from the age of the Galtean Alliance**",
        "delay": 11,
        "limit": -1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] They did it to mark the place where the founder of the Light of Kiltia began to spread the teachings**",
        "delay": 8,
        "limit": -1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] The temple was built here by believers**",
        "delay": 5,
        "limit": -1
      },
      {
        "output": "OnUser2",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] On the understanding that Kiltia\u0027s followers would exempt themselves from political dealings in other lands**",
        "delay": 10,
        "limit": -1
      },
      {
        "output": "OnUser2",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] In its long history Mt Bur-Omisace has never fallen under the control of any foreign power**",
        "delay": 6,
        "limit": -1
      },
      {
        "output": "OnUser2",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **[Bash] Kingdom and Empire both formed a pact to guarantee the holy city\u0027s independence",
        "delay": 3,
        "limit": -1
      }
    ]
  },
