import { Instance } from "cs_script/point_script";

const TRIGGER_TEXT = "我是彩笔";
const ADD_HP = 1000;

Instance.OnPlayerChat(({ player, text }) => {
    // 系统消息或无效玩家
    if (!player) return;

    const pawn = player.GetPlayerPawn();
    if (!pawn || !pawn.IsValid()) return;
    if (!pawn.IsAlive()) return;

    // 精确匹配聊天内容
    if (text.trim() !== TRIGGER_TEXT) return;

    // 当前生命值 + 1000
    const currentHp = pawn.GetHealth();
    pawn.SetHealth(currentHp + ADD_HP);
});
