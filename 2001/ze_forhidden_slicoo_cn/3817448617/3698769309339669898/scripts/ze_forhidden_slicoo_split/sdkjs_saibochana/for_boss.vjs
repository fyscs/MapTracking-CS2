    loop.later("move", 12, () => (moving = true));
    return;
  }
  const choice = Math.floor(Math.random() * 1e3) % 4;
  if (t >= nextSpecial) {
    targetHuman = false;
    target = centerEntity;
    const duration = [32, 16, 16, 14][choice];
    nextSpecial = t + duration + (enraged ? 6 : 12);
    nextSkill = t + (choice === 3 ? 15 : duration);
    tip(["huochang", "longche", "paidiban", "tianfa"][choice]);
    text(
      [
        "Evil fellow! Burn to ashes!",
        "Come on, my conquerors!",
        "This is my power!",
        "This is god's punishment!",
      ][choice],
    );
    fire(
      ["lfkb_paodu2_sound", "lfkb_longche_sound", "lfkb_paidiban_sound", "lfkb_tianfa2_sound"][
        choice
      ],
      "StartSound",
      "",
      3,
    );
    loop.later("special", 3, () => {
      if (!alive) return;
      const slip = Math.max(0, now() - t - 3);
      nextSkill += slip;
      nextSpecial += slip;
      if (choice === 0) {
        animation("attack1");
        beginFire();
      } else if (choice === 1) {
        animation("attack1");
        lcdmg = 25;
        chargeNext = now();
        chargeUntil = now() + 7;
        chargeInterval = ex ? (enraged ? 0.5 : 0.54) : 0.7;
      } else if (choice === 2) fire("lfkb_paidiban_relay", "Trigger");
      else {
        animation("attack1");
        lightning();
      }
      resume(duration - 4);
    });
    return;
  }
  if (choice === 3) {
    fire("lfkb_model", "SetAnimationNotLooping", "attack2");
    loop.later("stop", 0.5, () => (moving = false));
    loop.later("move", 1.7, () => (moving = true));
    nextSkill = t + 4;
  } else {
    fire("lfkb_model", "SetAnimationNotLooping", "attack1");
    nextSkill = t + 5;
  }
}
function tick(t) {
  if (Number.isFinite(fadeStart)) {
    const e = find("lfkb_model");
    if (valid(e)) {
      const c = e.GetColor();
      e.SetColor({ ...c, a: Math.min(255, Math.floor((t - fadeStart) * 100)) });
    }
    if (t >= fadeStart + 2.55) fadeStart = -Infinity;
  }
  if (!alive) return Number.isFinite(fadeStart);
  turning(t);
  safety(t);
  fireStage(t);
  if (valid(axe)) {
    const p = axe.GetAbsOrigin();
    if (lastAxe && distance(p, lastAxe) >= 200 && t >= nextAxeSound) {
      fire("lfkb_huiwu_sound", "StartSound");
      nextAxeSound = t + 0.8;
    }
    lastAxe = { ...p };
  }
  if (t >= nextHud) {
    fire("lfkb_hpshow", "SetMessage", "HP:" + hp);
    fire("lfkb_boss_hpshow", "Display");
    nextHud = t + 1;
  }
  if (t >= nextSkill) skill(t);
  if (!alive) return false;
  if (t < chargeUntil && t >= chargeNext) {
    dragon();
    chargeNext = t + chargeInterval;
  }
  if (t < poisonUntil && t >= poisonNext) {
    safeZone();
    poisonNext = t + 7;
  }
  if (enraged && !pendingDeath && t >= nextExtra) {
    dragon();
    loop.later("extra4", 4, () => {
      if (alive) dragon();
    });
    if (ex) {
      loop.later("extra2", 2, () => {
        if (alive) dragon();
      });
      loop.later("extra3", 3, () => {
        if (alive) dragon();
      });
    }
    nextExtra = t + 8;
  }
  return true;
}
function hit({ activator: p }, axeHit = false) {
  if (!alive || !live(p)) return;
  if (axeHit) {
    if (p.GetHealth() > 25) damage(p, 24);
    else p.Kill();
    fire("lfkb_slash_sound", "StartSound");
  } else {
    move(p, { x: 0, y: 0, z: 500 });
    fire("lfkb_punch_sound", "StartSound");
    if (p.GetHealth() - lcdmg > 36) {
      damage(p, lcdmg);
      fire(p, "IgniteLifetime", "8");
    } else p.Kill();
  }
}
wiring(
  ["lfkb_tianfa_qiang_temp", "lfkb_paodu_anquan_maker_temp", "lfkb_longche_maker_temp"],
  (bind) => {
    refs();
    bind("lfkb_start_relay", "OnTrigger", "start", () => {
      fadeStart = now();
      loop.wake();
      loop.later("start", 3.5999999046, start);
    });
    bind("lfkb_hp_filter", "OnPass", "hp", () => {
      if (!pendingDeath) {
        hp += 604;
        loop.later("half", 1, () => (half = hp / 2));
      }
    });
    bind("lfkb_boss_phys", "OnHealthChanged", "hp", () => {
      if (!alive || !damageEnabled || hp <= 0) return;
      hp = Math.max(0, hp - 1);
      if (hp === 0) {
        pendingDeath = true;
        nextHud = now();
        loop.wake();
      }
    });
    bind("lfkb_finder", "OnFoundEntity", "target", ({ caller }) => {
      if (targetHuman && live(caller, 3)) {
        target = caller;
        nextFind = now() + 8;
      }
    });
    for (const n of ["lfkb_boss_telep", "lfkb_longche_trigger"])
      bind(n, "OnEndTouch", "hurt", (e) => hit(e));
    for (const n of ["lfkb_fuzi_hurt", "lfkb_fuzi_hurt_2"])
      bind(n, "OnStartTouch", "hurt", (e) => hit(e, true));
    bind("lfkb_boss_move_push", "OnStartTouch", "push", ({ activator: p }) => {
      if (alive && live(p) && valid(body)) {
        const d = direction(p, body.GetAbsOrigin());
        move(p, { x: d.x * 400, y: d.y * 400, z: 300 });
      }
    });
    bind("lfkb_fuzi_particle", "OnUser1", "axe", () => {
      axe = find("lfkb_fuzi_particle");
      lastAxe = valid(axe) ? axe.GetAbsOrigin() : void 0;
    });
    bind("ex_relay1", "OnTrigger", "ex", () => (ex = true), true);
  },
);
Instance.OnScriptInput("start", start);
Instance.OnScriptInput("jineng", () => skill(now()));
Instance.OnScriptInput("tianfa_strike", strike);

Instance.Msg("SLICOO_NATIVE_LOAD:boss:20261017-r4");
