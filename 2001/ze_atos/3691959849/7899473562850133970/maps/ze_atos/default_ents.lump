        "param": "OnTimer\u003Efunctions\u003ERunScriptInput\u003EPlayBGM(22)\u003E0\u003E0",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]functions",
        "input": "RunScriptInput",
        "param": "g_fish_counts[8]\u002B\u002B;",
        "delay": 4,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say \u25B2TRIP 5\u25B2",
        "delay": 5,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "sv_falldamage_scale 1",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]_stage_text",
        "input": "SetDataControlPointX",
        "param": "5",
        "delay": 3,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2OPEN LASER VOTE SYSTEM FOR 15 SECONDS\u25B2",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2INPUT \u0027!FISH NUMBER\u0027 IN THE CHAT WINDOW,WHICH NUMBER CAN BE 3-10\u25B2",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2THIS WILL DECIDE THE NUMBER OF LASERS\u25B2",
        "delay": 12,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2EVERYONE ONLY HAS 1 CHANCE TO VOTE EACH ROUND\u25B2",
        "delay": 10,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2CLOSE LASER VOTE SYSTEM\u25B2",
        "delay": 24,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]old_cmd",
        "input": "Command",
        "param": "say \u25B2DEFAULT ARE 5 LASERS\u25B2",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "_OnTrigger",
        "target": "[PR#]old_functions",
        "input": "RunScriptCode",
        "param": "ShowFishVote()",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "_OnTrigger",
        "target": "[PR#]old_database",
        "input": "RunScriptCode",
        "param": "g_fish_start = 1;",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "_OnTrigger",
        "target": "[PR#]old_database",
        "input": "RunScriptCode",
        "param": "g_fish_start = 0;",
        "delay": 24,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]skybox_scene4_relay",
        "input": "Trigger",
        "param": "",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnTrigger",
