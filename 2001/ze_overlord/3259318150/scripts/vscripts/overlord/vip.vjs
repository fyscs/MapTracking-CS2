import { CSPlayerPawn, Instance } from "cs_script/point_script";

/**
 * Vip脚本
 * @copyright 2026 皮皮猫233 <https://steamcommunity.com/profiles/76561198199142327/>
 * @creat 2026/7/27
 */

const vipPlayers = new Map();
let globalHud = Instance.FindEntityByName("vip_global_hud");
let vipHud = Instance.FindEntityByName("vip_hud");

Instance.OnRoundStart(() => {
    vipPlayers.forEach((state, player) => {
        if (!player.IsValid()) {
            vipPlayers.delete(player);
            return;
        }
        state.healthTimes = 1;
    });
    globalHud = Instance.FindEntityByName("vip_global_hud");
    vipHud = Instance.FindEntityByName("vip_hud");
});

Instance.OnScriptInput("Mapper", (inputData) => {
    const player = /** @type {CSPlayerPawn|undefined} */ (inputData.activator);
    if (!player || !player.IsValid()) return;
    ShowVipHud(player);
    Instance.EntFireAtTarget({ target: player, input: "AddContext", value: "mapper:1" });
    if (vipPlayers.has(player)) return;
    vipPlayers.set(player, { healthTimes: 1 });
    let name = player.GetPlayerController()?.GetPlayerName();
    if (!name) return;
    name = Sanitize(name);
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在连接至服务器.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在加载游戏世界.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在初始化资源.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在初始化游戏资源.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在加入进击的巨人：托洛斯特区.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 进入了服务器.");
});

Instance.OnScriptInput("Vip", (inputData) => {
    const player = /** @type {CSPlayerPawn|undefined} */ (inputData.activator);
    if (!player || !player.IsValid()) return;
    ShowVipHud(player);
    Instance.EntFireAtTarget({ target: player, input: "AddContext", value: "vipuser:1" });
    if (vipPlayers.has(player)) return;
    vipPlayers.set(player, { healthTimes: 1 });
    let name = player.GetPlayerController()?.GetPlayerName();
    if (!name) return;
    name = Sanitize(name);
    Instance.ServerCommand("say ★ 调查兵团 < " + name + " > 加入了战斗.");
    Instance.ServerCommand("say ★ 调查兵团 < " + name + " > 加入了战斗.");
    Instance.ServerCommand("say ★ 调查兵团 < " + name + " > 加入了战斗.");
});

Instance.OnPlayerReset((event) => {
    Instance.EntFireAtName({ name: "mapper_filter", input: "TestActivator", activator: event.player });
    Instance.EntFireAtName({ name: "vip_filter", input: "TestActivator", activator: event.player });
});

Instance.OnPlayerChat((event) => {
    const player = event.player?.GetPlayerPawn();
    if (!player || !player.IsValid()) return;
    if (!vipPlayers.has(player)) return;
    if (event.text === "health" || event.text === "heal" || event.text === "hx") {
        const state = vipPlayers.get(player);
        if (state.healthTimes <= 0 || player.GetTeamNumber() !== 3) return;
        state.healthTimes--;
        const health = Math.min(player.GetHealth() + 100, player.GetMaxHealth());
        player.SetHealth(health);
        ShowHud("< 驻屯兵团 >\n已为您补充状态至 <" + health + "> 血量", player);
    }
});

/**
 * 显示Vip文本
 * @param {CSPlayerPawn} player 
 */
function ShowVipHud(player) {
    if (!vipHud) return;
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给" });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 5 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 5 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 60 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 60 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 65 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 65 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 120 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 120 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 125 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 125 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 180 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 180 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 185 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 185 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 240 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 240 });
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: "< 驻屯兵团 >\n您已获得补给", delay: 245 });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player, delay: 245 });
}

/**
 * 显示文本
 * @param {string} text 
 * @param {CSPlayerPawn} player 
 */
function ShowHud(text, player) {
    if (!vipHud) return;
    Instance.EntFireAtTarget({ target: vipHud, input: "SetMessage", value: text });
    Instance.EntFireAtTarget({ target: vipHud, input: "ShowHudHint", activator: player });
}

/**
 * 显示文本
 * @param {any} text 
 */
function ShowGlobalHud(text) {
    if (!globalHud) return;
    Instance.EntFireAtTarget({ target: globalHud, input: "SetMessage", value: text });
    for (const player of Instance.FindEntitiesByClass("player")) {
        if (!player.IsValid()) continue;
        Instance.EntFireAtTarget({ target: globalHud, input: "ShowHudHint", activator: player });
    }
}

/**
 * 移除常见危险字符防止注入
 * @param {string} str 
 * @returns 
 */
function Sanitize(str) {
    return str.replace(/[";`$\\\n\r]/g, ""); // 
}