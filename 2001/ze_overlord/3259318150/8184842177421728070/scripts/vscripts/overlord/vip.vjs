const preMappers = new Set();
const preVips = new Set();
const vipPlayers = new Map();
let globalHud = Instance.FindEntityByName("vip_global_hud");
let vipHud = Instance.FindEntityByName("vip_hud");
let listenerConnectId = 0;

Instance.OnActivate(() => {
    RegisterListener()
});

Instance.OnRoundStart(() => {
    globalHud = Instance.FindEntityByName("vip_global_hud");
    vipHud = Instance.FindEntityByName("vip_hud");

    Instance.DisconnectOutput(listenerConnectId);
    RegisterListener();

    vipPlayers.forEach((state, player) => {
        if (!player.IsValid()) {
            vipPlayers.delete(player);
            return;
        }
        state.healthTimes = 1;
        ShowVipHud(player);
    });
});

Instance.OnPlayerDisconnect((event) => {
    preMappers.delete(event.playerSlot);
    preVips.delete(event.playerSlot);
});

Instance.OnPlayerReset((event) => {
    const slot = event.player.GetPlayerController()?.GetPlayerSlot();
    if (!slot === undefined) return;
    if (preMappers.has(slot)) {
        MapperReset(event.player);
        preMappers.delete(slot);
    } else if (preVips.has(slot)) {
        VipReset(event.player);
        preVips.delete(slot);
    }
});

Instance.OnPlayerChat((event) => {
    const player = event.player?.GetPlayerPawn();
    if (!player || !player.IsValid()) return;
    if (!vipPlayers.has(player)) return;
    if (event.text === "health" || event.text === "heal" || event.text === "hx") {
        const state = vipPlayers.get(player);
        if (state.healthTimes <= 0 || player.GetTeamNumber() !== 3) return;
        state.healthTimes--;
        const health = Math.min(player.GetHealth() + 100, player.GetMaxHealth());
        player.SetHealth(health);
        ShowHud("< 纳萨力克冒险团 >\n已为您补充状态至 <" + health + "> 血量", player);
    }
});

/**
 * 注册监听事件
 */
function RegisterListener() {
    const listener = Instance.FindEntityByName("player_connect_listener");
    if (!listener || !listener.IsValid()) return;
    const id = Instance.ConnectOutput(listener, "OnEventFired", ({ value }) => {
        // @ts-ignore
        const data = JSON.parse(value);
        if (mapperIdList.has(data.steam_id)) {
            preMappers.add(Number(data.userid));
            MapperConnect(data.name);
        } else if (vipIdList.has(data.steam_id)) {
            preVips.add(Number(data.userid));
            VipConnect(data.name);
        }
    });
    if (id) listenerConnectId = id;
}

/**
 * Mapper载入
 * @param {string} name 
 */
function MapperConnect(name) {
    name = Sanitize(name);
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在连接至服务器.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在加载游戏世界.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在初始化资源.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在初始化游戏资源.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 正在加入纳萨力克冒险团.");
    Instance.ServerCommand("say ★ MAPPER < " + name + " > 进入了服务器.");
}

/**
 * Vip载入
 * @param {string} name 
 */
function VipConnect(name) {
    name = Sanitize(name);
    Instance.ServerCommand("say ★ 纳萨力克冒险团 < " + name + " > 加入了战斗.");
    Instance.ServerCommand("say ★ 纳萨力克冒险团 < " + name + " > 加入了战斗.");
    Instance.ServerCommand("say ★ 纳萨力克冒险团 < " + name + " > 加入了战斗.");
}

/**
 * Mapper重生
 * @param {CSPlayerPawn} player 
 */
function MapperReset(player) {
    ShowVipHud(player);
    Instance.EntFireAtTarget({ target: player, input: "AddContext", value: "mapper:1" });
    vipPlayers.set(player, { healthTimes: 1 });
}

/**
 * Vip重生
 * @param {CSPlayerPawn} player 
 */
function VipReset(player) {
    ShowVipHud(player);
    Instance.EntFireAtTarget({ target: player, input: "AddContext", value: "vip:1" });
    vipPlayers.set(player, { healthTimes: 1 });
}

