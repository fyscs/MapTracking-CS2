// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

// =========================================================
// 日志
// =========================================================
function LogWarn(...args) {
    Instance.Msg("[WARN] " + args.join(" "));
}
function LogError(...args) {
    Instance.Msg("[ERROR] " + args.join(" "));
}

// =========================================================
// 1. ITEM_CONFIG
// =========================================================
const ITEM_CONFIG = {
    "Astrologer": {
        displayName: "占星术士",
        maxEnergy: -1,
        colorClass: "ColorAstrologer",
        bgClass: "BgAstrologer",
        textClass: "TextAstrologer",
        counterName: "Item_Astrologer_Counter",
        counterCallback: OnCounterAstrologer,
    },
    "Dark_Knight": {
        displayName: "暗黑骑士",
        maxEnergy: 100,
        colorClass: "ColorDarkKnight",
        bgClass: "BgDarkKnight",
        textClass: "TextDarkKnight",
        text: ["Item_Dark_Knight_Percent_Text", "Item_Dark_Knight_Energy_Text"],
        counterName: "Item_Dark_Knight_Earth_Counter",
        counterCallback: OnCounterDarkKnight,
    },
    "Ninja": {
        displayName: "忍者",
        maxEnergy: -1,
        colorClass: "ColorNinja",
        bgClass: "BgNinja",
        textClass: "TextNinja",
        counterName: "Item_Ninja_Counter",
        counterCallback: OnCounterNinja,
    },
    "Black_Mage": {
        displayName: "黑魔法师",
        maxEnergy: 5,
        colorClass: "ColorBlackMage",
        bgClass: "BgBlackMage",
        textClass: "TextBlackMage",
        counterName: "Item_Black_Mage_Counter",
        counterCallback: OnCounterBlackMage,
    },
    "Elidibus": {
        displayName: "艾里迪布斯",
        maxEnergy: 200,
        colorClass: "ColorElidibus",
        bgClass: "BgElidibus",
        textClass: "TextElidibus",
        text: ["Item_Elidibus_Percent_Text", "Item_Elidibus_Energy_Text"],
        counterName: "Item_Elidibus_Counter",
        counterCallback: OnCounterElidibus,
    },
    "Red_Mage": {
        displayName: "赤魔法师",
        maxEnergy: 100,
        text: ["Item_Red_White_Text", "Item_Red_Black_Text", "Item_Red_Magia_Text"],
        isSpecial: true,
        whiteCounter: "Item_Red_Mage_White_Counter",
        blackCounter: "Item_Red_Mage_Black_Counter",
        magiaCounter: "Item_Red_Mage_Magia_Counter",
    },
    "Samurai": {
        displayName: "武士",
        maxEnergy: 3,
        colorClass: "ColorSamurai",
        bgClass: "BgSamurai",
        textClass: "TextSamurai",
        counterName: "Item_Samurai_Ulti_Counter",
        counterCallback: OnCounterSamurai,
    },
    "Scholar": {
        displayName: "学者",
        maxEnergy: -1,
        colorClass: "ColorScholar",
        bgClass: "BgScholar",
        textClass: "TextScholar",
        counterName: "Item_Scholar_Counter",
        counterCallback: OnCounterScholar,
    },
};

// =========================================================
// 2. 运行时状态
// =========================================================
let SCRIPT_ENABLED = true;
let SAMURAI_ULTI = false;
const ITEM_OWNER = {};
const LAST_COLOR_CLASS = {};
const LAST_ENERGY1_HEIGHT_CLASS = {};
const LAST_ENERGY2_HEIGHT_CLASS = {};
const CONNECTED_COUNTERS = {};

// RED
const RED_MAGE_STATE = { white: 0, black: 0, magia: 0 };
const RED_MAGE_COUNTERS_CONNECTED = {};
const RED_MAGE_LAST_WHITE_CLASS = {};
const RED_MAGE_LAST_BLACK_CLASS = {};

const hudEntity = Instance.FindEntityByName("Map_Hud_Layout");

// =========================================================
// 3. 工具函数
// =========================================================
function GetHeightClass(percent) {
    const clamped = percent < 0 ? 0 : percent > 100 ? 100 : percent;
    return "Energy-" + clamped;
}

// =========================================================
// 4. HUD 更新
// =========================================================
function OnItemPickupHUD(itemName, playerSlot) {
    if (!ITEM_CONFIG[itemName] || !hudEntity) return;

    const config = ITEM_CONFIG[itemName];

    hudEntity.SetDialogVariableStringForPlayer(
        playerSlot, "ArtifactName", "item_name", config.displayName
    );

    const oldColor = LAST_COLOR_CLASS[playerSlot];
    if (oldColor) {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", oldColor, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", config.colorClass, true);
    LAST_COLOR_CLASS[playerSlot] = config.colorClass;

    hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarContainer", config.bgClass, true);

    hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactValue", config.textClass, true);
    hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactName", config.textClass, true);

    const oldHeight = LAST_ENERGY1_HEIGHT_CLASS[playerSlot];
    if (oldHeight && oldHeight !== "Energy-0") {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", oldHeight, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", "Energy-0", true);
    LAST_ENERGY1_HEIGHT_CLASS[playerSlot] = "Energy-0";

    const oldHeight2 = LAST_ENERGY2_HEIGHT_CLASS[playerSlot];
    if (oldHeight2 && oldHeight2 !== "Energy-0") {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", oldHeight2, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", "Energy-0", true);
    LAST_ENERGY2_HEIGHT_CLASS[playerSlot] = "Energy-0";

    hudEntity.SetHasClassForPlayer(playerSlot, "HudContainer", "HasItem", true);
}

function OnItemDropHUD(playerSlot) {
    if (!hudEntity) return;

    hudEntity.SetHasClassForPlayer(playerSlot, "HudContainer", "HasItem", false);

    const lastColor = LAST_COLOR_CLASS[playerSlot];
    if (lastColor) {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", lastColor, false);
    }
    LAST_COLOR_CLASS[playerSlot] = null;

    for (const itemName in ITEM_CONFIG) {
        const cfg = ITEM_CONFIG[itemName];
        if (!cfg.isSpecial) {
            hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarContainer", cfg.bgClass, false);
            hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactValue", cfg.textClass, false);
            hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactName", cfg.textClass, false);
        }
    }

    const lastHeight = LAST_ENERGY1_HEIGHT_CLASS[playerSlot];
    if (lastHeight && lastHeight !== "Energy-0") {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", lastHeight, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", "Energy-0", true);
    LAST_ENERGY1_HEIGHT_CLASS[playerSlot] = "Energy-0";
}

function OnEnergyChanged(itemName, energy) {
    if (!SCRIPT_ENABLED) return;
    const playerSlot = ITEM_OWNER[itemName];
    const isSamurai = (ITEM_CONFIG[itemName].maxEnergy === 3);
    if (isSamurai && SAMURAI_ULTI) return;

    if (playerSlot < 0 || !hudEntity) return;

    const config = ITEM_CONFIG[itemName];
    const maxEnergy = config.maxEnergy;

    let energy1Percent, energy2Percent;
    if (maxEnergy <= 100) {
        energy1Percent = Math.floor((energy / maxEnergy) * 100);
        energy2Percent = 0;
    } else {
        energy1Percent = Math.floor((Math.min(energy, 100) / 100) * 100);
        energy2Percent = Math.floor((Math.max(energy - 100, 0) / 100) * 100);
    }

    hudEntity.SetDialogVariableStringForPlayer(
        playerSlot, "ArtifactValue", "item_value", energy.toFixed(1)
    );

    const energy1HeightClass = GetHeightClass(energy1Percent);
    if (LAST_ENERGY1_HEIGHT_CLASS[playerSlot] !== energy1HeightClass) {
        if (LAST_ENERGY1_HEIGHT_CLASS[playerSlot]) {
            hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", LAST_ENERGY1_HEIGHT_CLASS[playerSlot], false);
        }
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", energy1HeightClass, true);
        LAST_ENERGY1_HEIGHT_CLASS[playerSlot] = energy1HeightClass;
    }

    const energy2HeightClass = GetHeightClass(energy2Percent);
    if (LAST_ENERGY2_HEIGHT_CLASS[playerSlot] !== energy2HeightClass) {
        if (LAST_ENERGY2_HEIGHT_CLASS[playerSlot]) {
            hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", LAST_ENERGY2_HEIGHT_CLASS[playerSlot], false);
        }
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", energy2HeightClass, true);
        LAST_ENERGY2_HEIGHT_CLASS[playerSlot] = energy2HeightClass;
    }

    const isFull = (energy >= maxEnergy);
    if (isFull) {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", "FullEnergy", true);
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", "FullEnergy", true);
        hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactValue", "FullEnergy", true);
        if (isSamurai) SAMURAI_ULTI = true;
    } else {
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill1", "FullEnergy", false);
        hudEntity.SetHasClassForPlayer(playerSlot, "EnergyBarFill2", "FullEnergy", false);
        hudEntity.SetHasClassForPlayer(playerSlot, "ArtifactValue", "FullEnergy", false);
    }
}

// =========================================================
// 5. 赤魔
// =========================================================
function OnRedMagePickup(playerSlot) {
    if (!hudEntity) return;

    RED_MAGE_STATE.white = 0;
    RED_MAGE_STATE.black = 0;
    RED_MAGE_STATE.magia = 2;
    hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageFill", "Energy-0", true);
    hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageFill", "Energy-0", true);

    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "WhiteMageValue", "white_value", "0.0");
    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "BlackMageValue", "black_value", "0.0");

    RED_MAGE_LAST_WHITE_CLASS[playerSlot] = "Energy-0";
    RED_MAGE_LAST_BLACK_CLASS[playerSlot] = "Energy-0";

    hudEntity.SetHasClassForPlayer(playerSlot, "RedMageContainer", "HasItem", true);
}

function OnRedMageDrop(playerSlot) {
    if (!hudEntity) return;
    hudEntity.SetHasClassForPlayer(playerSlot, "RedMageContainer", "HasItem", false);
}

function UpdateMagiaDisplay(playerSlot, magiaCount) {
    if (!hudEntity) return;
    for (let i = 0; i < 3; i++) {
        const symbol = (i < magiaCount) ? "◆" : "◇";
        const panelId = "Magia" + (i + 1);
        const varName = "magia" + (i + 1);
        hudEntity.SetDialogVariableStringForPlayer(playerSlot, panelId, varName, symbol);
    }
}

function OnRedMageWhiteChanged({ value }) {
    if (!SCRIPT_ENABLED) return;
    const playerSlot = ITEM_OWNER["Red_Mage"];
    if (playerSlot < 0 || !hudEntity) return;
    RED_MAGE_STATE.white = value;
    const percent = Math.floor((value / 100) * 100);
    const newClass = GetHeightClass(percent);

    const oldClass = RED_MAGE_LAST_WHITE_CLASS[playerSlot];
    if (oldClass && oldClass !== newClass) {
        hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageFill", oldClass, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageFill", newClass, true);
    RED_MAGE_LAST_WHITE_CLASS[playerSlot] = newClass;
    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "WhiteMageValue", "white_value", value.toFixed(1));

    const isFull = (value >= 100);
    hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageFill", "FullEnergy", isFull);
    hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageValue", "FullEnergy", isFull);
}

function OnRedMageBlackChanged({ value }) {
    if (!SCRIPT_ENABLED) return;
    const playerSlot = ITEM_OWNER["Red_Mage"];
    if (playerSlot < 0 || !hudEntity) return;
    RED_MAGE_STATE.black = value;
    const percent = Math.floor((value / 100) * 100);
    const newClass = GetHeightClass(percent);

    const oldClass = RED_MAGE_LAST_BLACK_CLASS[playerSlot];
    if (oldClass && oldClass !== newClass) {
        hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageFill", oldClass, false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageFill", newClass, true);
    RED_MAGE_LAST_BLACK_CLASS[playerSlot] = newClass;
    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "BlackMageValue", "black_value", value.toFixed(1));

    const isFull = (value >= 100);
    hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageFill", "FullEnergy", isFull);
    hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageValue", "FullEnergy", isFull);
}

function OnRedMageMagiaChanged({ value }) {
    if (!SCRIPT_ENABLED) return;
    const playerSlot = ITEM_OWNER["Red_Mage"];
    if (playerSlot < 0 || !hudEntity) return;
    RED_MAGE_STATE.magia = value;
    UpdateMagiaDisplay(playerSlot, value);
}

Instance.RegisterCheatCommand("script_enable_toggle", () => {
    SCRIPT_ENABLED = !SCRIPT_ENABLED;
    if (!SCRIPT_ENABLED) {
        DisableAllHUD();
    }
});

function RegisterRedMageCounters(playerSlot) {
    if (RED_MAGE_COUNTERS_CONNECTED.white) {
        return;
    }

    const config = ITEM_CONFIG["Red_Mage"];
    const connections = [
        { name: config.whiteCounter, key: "white", callback: OnRedMageWhiteChanged },
        { name: config.blackCounter, key: "black", callback: OnRedMageBlackChanged },
        { name: config.magiaCounter, key: "magia", callback: OnRedMageMagiaChanged },
    ];

    for (const conn of connections) {
        let entity = null;
        try {
            entity = Instance.FindEntitiesByName(conn.name);
        } catch (e) {
            LogError("查找赤魔 counter 失败:", conn.name, e);
        }
        if (Array.isArray(entity)) entity = entity[0];
        if (!entity) {
            LogWarn("赤魔 counter 未找到:", conn.name);
            continue;
        }
        try {
            Instance.ConnectOutput(entity, "OutValue", conn.callback);
            RED_MAGE_COUNTERS_CONNECTED[conn.key] = true;
        } catch (e) {
            LogError("赤魔 ConnectOutput 失败:", conn.name, e);
        }
    }

    for (const textname of config.text) {
        const point_worldtext = Instance.FindEntityByName(textname);
        point_worldtext?.Remove();
    }

    UpdateMagiaDisplay(playerSlot, 2);
}

// =========================================================
// 6. counter 回调
// =========================================================
function OnCounterAstrologer({ value }) { OnEnergyChanged("Astrologer", value); }
function OnCounterDarkKnight({ value }) { OnEnergyChanged("Dark_Knight", value); }
function OnCounterNinja({ value }) { OnEnergyChanged("Ninja", value); }
function OnCounterBlackMage({ value }) { OnEnergyChanged("Black_Mage", value); }
function OnCounterElidibus({ value }) { OnEnergyChanged("Elidibus", value); }
function OnCounterSamurai({ value }) { OnEnergyChanged("Samurai", value); }
function OnCounterScholar({ value }) { OnEnergyChanged("Scholar", value); }

// =========================================================
// 7. 按需注册 counter
// =========================================================
function RegisterCounterForItem(itemName) {
    if (CONNECTED_COUNTERS[itemName]) {
        return;
    }

    const config = ITEM_CONFIG[itemName];
    if (!config) return;

    let counterEntity = null;
    try {
        counterEntity = Instance.FindEntitiesByName(config.counterName);
    } catch (e) {
        LogError("FindEntitiesByName 异常:", e);
    }

    if (Array.isArray(counterEntity)) {
        counterEntity = counterEntity.length > 0 ? counterEntity[0] : null;
    }

    if (!counterEntity) {
        LogWarn(`拾取 ${itemName}，但 counter "${config.counterName}" 未找到`);
        return;
    }

    try {
        Instance.ConnectOutput(counterEntity, "OutValue", config.counterCallback);
        CONNECTED_COUNTERS[itemName] = config.counterName;
    } catch (e) {
        LogError(`ConnectOutput 失败: ${e}`);
    }

    // 删除当局 hud 文字
    if (!config.text) return;
    for (const textname of config.text) {
        const point_worldtext = Instance.FindEntityByName(textname);
        point_worldtext?.Remove();
    }
}

// =========================================================
// 拾取 / 丢弃
// =========================================================
function OnItemPickup(itemName, playerSlot) {
    if (!SCRIPT_ENABLED) return;
    if (!ITEM_CONFIG[itemName]) {
        LogWarn("OnItemPickup: 未知 item", itemName);
        return;
    }
    ITEM_OWNER[itemName] = playerSlot;

    ClearAllHUDForPlayer(playerSlot);

    if (itemName === "Red_Mage") {
        OnRedMagePickup(playerSlot);
        RegisterRedMageCounters(playerSlot);
    } else if (ITEM_CONFIG[itemName].maxEnergy > 0) {
        OnItemPickupHUD(itemName, playerSlot);
        RegisterCounterForItem(itemName);
    }
}

function OnItemDrop(itemName) {
    if (!SCRIPT_ENABLED) return;
    const playerSlot = ITEM_OWNER[itemName];
    if (playerSlot < 0) return;
    ITEM_OWNER[itemName] = -1;

    if (itemName === "Red_Mage") {
        OnRedMageDrop(playerSlot);
    } else {
        OnItemDropHUD(playerSlot);
    }
}

function GetItemName(name) {
    if (!name) return undefined;
    const parts = name.split('_');
    const ItemName = parts.length === 4 ? `${parts[1]}_${parts[2]}` : parts[1];
    return ItemName;
}

function ClearAllHUDForPlayer(playerSlot) {
    if (!hudEntity) return;

    // 1. 普通神器 HUD
    OnItemDropHUD(playerSlot);

    // 2. 赤魔 HUD
    hudEntity.SetHasClassForPlayer(playerSlot, "RedMageContainer", "HasItem", false);

    for (const panel of ["WhiteMageFill", "BlackMageFill"]) {
        const oldW = RED_MAGE_LAST_WHITE_CLASS[playerSlot];
        const oldB = RED_MAGE_LAST_BLACK_CLASS[playerSlot];
        if (panel === "WhiteMageFill" && oldW) {
            hudEntity.SetHasClassForPlayer(playerSlot, panel, oldW, false);
        }
        if (panel === "BlackMageFill" && oldB) {
            hudEntity.SetHasClassForPlayer(playerSlot, panel, oldB, false);
        }
        hudEntity.SetHasClassForPlayer(playerSlot, panel, "Energy-0", true);
        hudEntity.SetHasClassForPlayer(playerSlot, panel, "FullEnergy", false);
    }
    hudEntity.SetHasClassForPlayer(playerSlot, "WhiteMageValue", "FullEnergy", false);
    hudEntity.SetHasClassForPlayer(playerSlot, "BlackMageValue", "FullEnergy", false);
    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "WhiteMageValue", "white_value", "0.0");
    hudEntity.SetDialogVariableStringForPlayer(playerSlot, "BlackMageValue", "black_value", "0.0");
    delete RED_MAGE_LAST_WHITE_CLASS[playerSlot];
    delete RED_MAGE_LAST_BLACK_CLASS[playerSlot];
}

function DisableAllHUD() {
    if (!hudEntity) return;

    for (const player of Instance.GetAllPlayerControllers()) {
        const playerSlot = player.GetPlayerSlot();
        if (playerSlot >= 0) {
            ClearAllHUDForPlayer(playerSlot);
        }
    }
}

// =========================================================
// 拾取输入
// =========================================================
for (const itemName in ITEM_CONFIG) {
    Instance.OnScriptInput(itemName, (inputData) => {
        const player = inputData.activator;
        if (!player || !player.IsValid()) return;
        const controller = player.GetPlayerController();
        const playerSlot = controller.GetPlayerSlot();
        OnItemPickup(itemName, playerSlot);
        inputData.caller?.SetEntityName("Item_" + itemName + "_Elite");
    });
}

// =========================================================
// 神器丢弃
// =========================================================
Instance.OnWeaponDrop(({ weapon }) => {
    const name = weapon.GetEntityName();
    if (!name) return;
    const ItemName = GetItemName(name);
    OnItemDrop(ItemName);
});

// =========================================================
// 武士 Ulti
// =========================================================
Instance.OnScriptInput("Samurai_Ulti", () => SAMURAI_ULTI = false);


Instance.OnScriptInput("MusicRandom", () => {
    if (RandomInt(0, 1)) return;
    Instance.EntFireAtName({name: "Music_Extreme_2", input: "FireUser2"});
    Instance.EntFireAtName({name: "Door_10_Left", input: "AddOutput", value: "OnFullyClosed>Music_Extreme_2>FireUser3>>6>1"});
});

let ItemOwnerName;
Instance.OnScriptInput("ItemCheck", ({activator}) => {
    if (!activator || !activator.IsValid()) return;
    const name = activator.GetEntityName();
    if (name === "Player_None") return;
    ItemOwnerName = name;
    Instance.EntFireAtName({name: "Map_Hud_Script", input: "RunScriptInput", value: "ResetName", delay: 0.1, activator : activator});
});

Instance.OnScriptInput("ResetName", ({activator}) => {
    if (activator && activator.IsValid()) {
        activator.SetEntityName(ItemOwnerName);
        ItemOwnerName = null;
    }
});

// =========================================================
// 8. 回合开始重置
// =========================================================
Instance.OnRoundStart(() => {
    for (const player of Instance.GetAllPlayerControllers()) {
        const playerSlot = player.GetPlayerSlot();
        if (playerSlot >= 0) {
            ClearAllHUDForPlayer(playerSlot);
        }
    }

    for (const itemName in ITEM_CONFIG) {
        OnItemDrop(itemName);
        const item = Instance.FindEntityByName("Item_" + itemName + "_Elite");
        item?.Remove();
    }

    for (const itemName in CONNECTED_COUNTERS) delete CONNECTED_COUNTERS[itemName];

    for (const itemName in ITEM_CONFIG) {
        ITEM_OWNER[itemName] = -1;
    }

    RED_MAGE_STATE.white = 0;
    RED_MAGE_STATE.black = 0;
    RED_MAGE_STATE.magia = 2;
    for (const key in RED_MAGE_COUNTERS_CONNECTED) delete RED_MAGE_COUNTERS_CONNECTED[key];

    SAMURAI_ULTI = false;
});

// =========================================================
// 9. 初始化
// =========================================================
for (const itemName in ITEM_CONFIG) {
    ITEM_OWNER[itemName] = -1;
}

function RandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}