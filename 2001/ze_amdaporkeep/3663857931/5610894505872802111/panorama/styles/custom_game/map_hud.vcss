/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
    font-family: Stratum2, "Arial Unicode MS";
}
.HudContainer {
    flow-children: down;
    horizontal-align: right;
    vertical-align: bottom;
    margin-bottom: 75px;
    margin-right: 160px;
    width: 100px;
    padding: 6px 10px 8px;
    visibility: collapse;
}
.HudContainer.HasItem {
    visibility: visible;
}
.HudText {
    width: 100%;
    text-align: center;
    font-size: 16px;
    color: #ffffff;
    text-shadow: #000000 1px 1px 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-top: 4px;
}
.EnergyBarWrapper {
    width: 15px;
    height: 200px;
    horizontal-align: center;
    flow-children: none;
}
.EnergyBarContainer {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: clip;
    flow-children: none;
}
.EnergyBarFill1 {
    width: 100%;
    height: 0%;
    background-color: #00e5ff;
    border-radius: 3px;
    transition-property: height, background-color, opacity;
    transition-duration: 0.2s, 0.2s, 1.5s;
    transition-timing-function: ease-out, ease-out, ease-in-out;
    horizontal-align: center;
    vertical-align: bottom;
    opacity: 0.4;
}
.EnergyBarFill2 {
    width: 100%;
    height: 0%;
    background-color: #5AFDFF;
    border-radius: 3px;
    transition-property: height, background-color, opacity;
    transition-duration: 0.2s, 0.2s, 1.5s;
    transition-timing-function: ease-out, ease-out, ease-in-out;
    horizontal-align: center;
    vertical-align: bottom;
    opacity: 0.4;
}
.WhiteMageFill.FullEnergy,.BlackMageFill.FullEnergy,.EnergyBarFill1.FullEnergy,.EnergyBarFill2.FullEnergy {
    animation-name: breathe;
    animation-duration: 1.5s;
    animation-iteration-count: infinite;
    animation-direction: alternate;
    animation-timing-function: ease-in-out;
}
@keyframes 'breathe' {
    0% {
        opacity: 1.0;
    }
50% {
        opacity: 0.4;
    }
100% {
        opacity: 1.0;
    }
}
.HudValue {
    position: 0px 0px 0px;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 6px;
    background-color: transparent;
    border: 0px solid transparent;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    text-shadow: #000000 2px 2px 0px, #000000 -2px -2px 0px, #000000 2px -2px 0px, #000000 -2px 2px 0px;
    animation-name: none;
}
.TextWhite.FullEnergy,.TextBlack.FullEnergy,.HudValue.FullEnergy {
    animation-name: pulse;
    animation-duration: 3s;
    animation-iteration-count: infinite;
    animation-direction: alternate;
    animation-timing-function: ease-in-out;
}
@keyframes 'pulse' {
    0% {
        color: rgb(255, 0, 0);
    }
16% {
        color: rgb(255, 165, 0);
    }
33% {
        color: rgb(255, 255, 0);
    }
50% {
        color: rgb(0, 255, 0);
    }
66% {
        color: rgb(0, 0, 255);
    }
83% {
        color: rgb(75, 0, 130);
    }
100% {
        color: rgb(238, 130, 238);
    }
}
.RedMageContainer {
    flow-children: down;
    horizontal-align: right;
    vertical-align: bottom;
    margin-bottom: 65px;
    margin-right: 160px;
    width: 100px;
    padding: 6px 10px 8px;
    visibility: collapse;
}
.RedMageContainer.HasItem {
    visibility: visible;
}
.DualBarWrapper {
    width: 100%;
    height: 220px;
    flow-children: right;
    horizontal-align: center;
    margin-bottom: 6px;
}
.BarColumn {
    width: 50%;
    height: 100%;
    flow-children: down;
    horizontal-align: center;
    vertical-align: bottom;
}
.BarContainer {
    width: 15px;
    height: 200px;
    horizontal-align: center;
    vertical-align: bottom;
    background-color: #1a1a1a;
    border-radius: 3px;
    overflow: clip;
}
.MageValue {
    width: 100%;
    text-align: center;
    font-size: 14px;
    font-weight: bold;
    text-shadow: #000000 2px 2px 0px, #000000 -2px -2px 0px, #000000 2px -2px 0px, #000000 -2px 2px 0px;
    margin-top: 4px;
}
.TextWhite {
    color: #ffffff;
}
.TextBlack {
    color: #2D50C2;
}
.WhiteMageFill {
    width: 100%;
    height: 0%;
    background-color: #ffffff;
    border-radius: 3px;
    transition-property: height;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    horizontal-align: center;
    vertical-align: bottom;
}
.BlackMageFill {
    width: 100%;
    height: 0%;
    background-color: #2D50C2;
    border-radius: 3px;
    transition-property: height;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    horizontal-align: center;
    vertical-align: bottom;
}
.MagiaPanel {
    width: 60px;
    height: 24px;
    flow-children: right;
    horizontal-align: center;
    margin-top: 6px;
}
.MagiaDiamond {
    width: 20px;
    height: 24px;
    text-align: center;
    vertical-align: center;
    font-size: 18px;
    font-weight: bold;
    color: #FE8D8B;
    text-shadow: #000000 1px 1px 2px;
}
