.Root {
    width: 100%;
    height: 100%;
    flow-children: none;
    overflow: noclip;
    z-index: 999999;
}
.stage_master {
    width: 100%;
    height: 100%;
    flow-children: none;
    visibility: collapse;
}
.stage_master.Visible {
    visibility: visible;
}
.stage_img {
    width: 100%;
    height: 100%;
}
.fire_master {
    width: 100%;
    height: 100%;
    flow-children: none;
    visibility: visible;
}
.fire_step {
    flow-children: down;
    horizontal-align: center;
    margin-top: 210px;
    visibility: collapse;
}
.fire_step.Visible {
    visibility: visible;
}
.fire_text {
    horizontal-align: center;
    font-family: Stratum2, 'Arial Unicode MS';
    font-weight: bold;
    color: #3399ffff;
    text-shadow: 2px 2px 4px #000000c0;
}
.fire_en {
    font-size: 38px;
}
.fire_cn {
    font-size: 28px;
    margin-top: 6px;
