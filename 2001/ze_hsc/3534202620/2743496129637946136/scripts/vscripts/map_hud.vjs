// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

const HUD_ENTITY_NAME = "map_hud";          
const STAGE_IDS = ["1", "2", "3"];          

let hud = null;

function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        Instance.Msg("[MAP_HUD] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

function showStage(id) {
    if (!hud || !hud.IsValid()) return;
    for (const s of STAGE_IDS) {
        hud.SetHasClass("Stage_root_" + s, "Visible", s === id);
    }
}

function hideStages() {
    if (!hud || !hud.IsValid()) return;
    for (const s of STAGE_IDS) {
        hud.SetHasClass("Stage_root_" + s, "Visible", false);
    }
}

Instance.OnScriptInput("stage1", () => { if (!hud || !hud.IsValid()) findHud(); showStage("1"); });
Instance.OnScriptInput("stage2", () => { if (!hud || !hud.IsValid()) findHud(); showStage("2"); });
Instance.OnScriptInput("stage3", () => { if (!hud || !hud.IsValid()) findHud(); showStage("3"); });
Instance.OnScriptInput("stage_hide", () => { hideStages(); });

let testIdx = 0;
Instance.OnScriptInput("test", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    testIdx = (testIdx + 1) % (STAGE_IDS.length + 1);   
    if (testIdx === 0) {
        hideStages();
        Instance.Msg("[MAP_HUD] test：已隐藏");
    } else {
        showStage(STAGE_IDS[testIdx - 1]);
        Instance.Msg("[MAP_HUD] test：显示 stage" + STAGE_IDS[testIdx - 1]);
    }
});

Instance.OnRoundStart(() => { hideStages(); stopFire(); });

const FIRE_STEP = 1.0;                      
let fireSlot = -1;                          
let fireLeft = -1;                          
let fireNextT = 0;                          
let hideFireDelay = -1;                     

function fireSetClass(panelId, has) {
    if (!hud || !hud.IsValid()) return;
    if (fireSlot >= 0) {
        hud.SetHasClassForPlayer(fireSlot, panelId, "Visible", has);
    } else {
        hud.SetHasClass(panelId, "Visible", has);
    }
}

function fireShow(n) {
    for (let i = 0; i <= 5; i++) {
        fireSetClass("Fire_t" + i, i === n);
    }
}

function stopFire() {
    if (fireSlot >= 0 || fireLeft >= 0) {
        for (let i = 0; i <= 5; i++) fireSetClass("Fire_t" + i, false);
    }
    fireSlot = -1;
    fireLeft = -1;
    hideFireDelay = -1;
}

function slotOfActivator(a) {
    if (!a || !a.IsValid || !a.IsValid()) return -1;
    try {
        if (typeof a.GetPlayerSlot === "function") return a.GetPlayerSlot();        
        if (typeof a.GetPlayerController === "function") {                          
            const c = a.GetPlayerController();
            if (c && c.IsValid && c.IsValid() && typeof c.GetPlayerSlot === "function") {
                return c.GetPlayerSlot();
            }
        }
    } catch (e) {}
    return -1;
}

Instance.OnScriptInput("zm_item_fire", (data) => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    stopFire();                                 
    fireSlot = slotOfActivator(data && data.activator);
    fireLeft = 5;
    fireNextT = Instance.GetGameTime();         
    Instance.SetNextThink(fireNextT);           
    const who = (data && data.activator && data.activator.GetDebugName) ? data.activator.GetDebugName() : "?";
    Instance.Msg("[MAP_HUD] zm_item_fire by " + who + "，slot=" + fireSlot + (fireSlot < 0 ? "（无 activator，全场兜底）" : "（仅该玩家可见）"));
});

Instance.OnScriptInput("firetest", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    stopFire();
    fireSlot = -1;
    fireLeft = 5;
    fireNextT = Instance.GetGameTime();
    Instance.SetNextThink(fireNextT);
    Instance.Msg("[MAP_HUD] firetest：全场倒计时测试");
});

function fireTick() {
    if (fireLeft < 0) return;
    fireShow(fireLeft);
    if (fireLeft === 0) {
        fireLeft = -1;                          
        hideFireDelay = Instance.GetGameTime() + 1.0;
        return;
    }
    fireLeft--;
    fireNextT = Instance.GetGameTime() + FIRE_STEP;
}

function onThink() {
    const gt = Instance.GetGameTime();
    let nextT = -1;

if (fireLeft >= 0 && gt >= fireNextT) {
        fireTick();                             
    }
    if (fireLeft >= 0) nextT = fireNextT;

if (hideFireDelay >= 0) {
        if (gt >= hideFireDelay) {
            hideFireDelay = -1;

for (let i = 0; i <= 5; i++) fireSetClass("Fire_t" + i, false);
        } else {
            if (nextT < 0 || hideFireDelay < nextT) nextT = hideFireDelay;
        }
    }

if (nextT > 0) Instance.SetNextThink(nextT);
}

Instance.SetThink(onThink);
