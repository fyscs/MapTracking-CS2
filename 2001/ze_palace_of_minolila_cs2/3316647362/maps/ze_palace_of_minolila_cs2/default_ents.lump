      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### ???: Who are you...... ###",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]ex2_bossmodel",
        "input": "Enable",
        "param": "",
        "delay": 3.5,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### ???: Let me guess who you are ###",
        "delay": 4,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### ???: You must be the team who survived from the ruin of black stone ###",
        "delay": 6,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### ???: I know you want to arrest the mayor ###",
        "delay": 8,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### ???: My name is MINOLILA. the mayor that you want to arrest is my father ###",
        "delay": 10,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: Do not worry, I will not stop you from arresting him ###",
        "delay": 12,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: He did a lot of zombie experiments there ###",
        "delay": 14,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: And he imprisoned his own daughter in this palace so that no one will know what he did ### ",
        "delay": 16,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: So this is my request ###",
        "delay": 18,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: Arrest him now ###",
        "delay": 20,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: However, I do not know how many power you have ###",
        "delay": 22,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ### Minolila: Try to defeat me, and I will lead you to arrest him if you win this test!!! ###",
