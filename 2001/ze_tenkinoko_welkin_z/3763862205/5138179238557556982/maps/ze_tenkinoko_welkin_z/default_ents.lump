      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:Recharge item each have 60 energy,which restore 1 energy per second when not in use \u003E\u003E\u003E",
        "delay": 10,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:When the energy is exhausted or the user uses the upper part, the recharg item\u0027s effect  will be invalid \u003E\u003E\u003E",
        "delay": 14,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:Human item 65 seconds CD, recharge item 5 seconds CD, zombie item 70 seconds CD, weather item 80 seconds CD \u003E\u003E\u003E",
        "delay": 18,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:The effect will disappear 4 seconds after FrozenTomb\u0027s crystal is crushed \u003E\u003E\u003E",
        "delay": 22,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:FrozenTomb will freeze the zombies around for 9 seconds when uses the Top Button part \u003E\u003E\u003E",
        "delay": 26,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
