        "delay": 30,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:Blizzard will form a storm after 5 seconds, freezing the zombies in the range \u003E\u003E\u003E",
        "delay": 34,
        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Server",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Tips:Mist is poisonous, especially in the last 5 seconds \u003E\u003E\u003E",
        "delay": 38,
