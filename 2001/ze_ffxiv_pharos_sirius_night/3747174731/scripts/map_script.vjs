import { Instance } from "cs_script/point_script";

class GlowManager {
    static glowColors = {
        "human_gravity_pistol": { r: 255, g: 0, b: 0 },
        "human_water_pistol": { r: 128, g: 128, b: 255},
        "human_fire_pistol": { r: 255, g: 128, b: 0 },
        "human_rock_pistol": { r: 255, g: 255, b: 64 },
        "human_heal_pistol": { r: 128, g: 255, b: 128 },
        "zombie_parasitic_knife": { r: 255, g: 0, b: 0 },
        "zombie_sword_knife": { r: 128, g: 128, b: 255},
        "zombie_electric_knife": { r: 255, g: 255, b: 255 },
        "zombie_warp_knife": { r: 255, g: 192, b: 255 },
        "zombie_gravity_knife": { r: 255, g: 0, b: 255 },
    };
}

Instance.OnScriptInput("Glow", () => {
    const Gravity = Instance.FindEntityByName("human_gravity_pistol");
    if (Gravity) GlowEntity(Gravity);
    const Water = Instance.FindEntityByName("human_water_pistol");
    if (Water) GlowEntity(Water);
    const Fire = Instance.FindEntityByName("human_fire_pistol");
    if (Fire) GlowEntity(Fire);
    const Rock = Instance.FindEntityByName("human_rock_pistol");
    if (Rock) GlowEntity(Rock);
    const Heal = Instance.FindEntityByName("human_heal_pistol");
    if (Heal) GlowEntity(Heal);
    const Parasitic = Instance.FindEntityByName("zombie_parasitic_knife");
    if (Parasitic) GlowEntity(Parasitic);
    const Sword = Instance.FindEntityByName("zombie_sword_knife");
    if (Sword) GlowEntity(Sword);
    const Electric = Instance.FindEntityByName("zombie_electric_knife");
    if (Electric) GlowEntity(Electric);
    const Warp = Instance.FindEntityByName("zombie_warp_knife");
    if (Warp) GlowEntity(Warp);
    const ZMGravity = Instance.FindEntityByName("zombie_gravity_knife");
    if (ZMGravity) GlowEntity(ZMGravity);
});

Instance.OnScriptInput("Enter", (event) => {
    const player = event.activator;
    if (!player && !player.IsValid()) return;
    const name = player.GetPlayerController().GetPlayerName();
    Instance.ServerCommand(`say ${name} entered the teleporter.Global Tp in 10s.`);
});

function GlowEntity(entity) {
    const entityname = entity.GetEntityName();
    if (entity) {
        entity.Glow(GlowManager.glowColors[entityname]);
    }
}

const HumanItems = new Map();
const CheckInterval = 1;
let Script = undefined;

function CheckHumanItems() {
    for (const [HintName, pickedUp] of HumanItems) {
        const Hint = Instance.FindEntityByName(HintName);
        if (pickedUp && (!Hint || !Hint.GetParent() || !Hint.GetParent().GetParent())) {
            Instance.EntFireAtName({ name: HintName, input: "Start" });
            HumanItems.set(HintName, false);
        }
    }
    Instance.EntFireAtTarget({ target: Script, input: "RunScriptInput", value: "CheckHumanItems", delay: CheckInterval });
}

function ResetHumanItems() {
    HumanItems.clear();
}

function ResetHealthShot() {
    Instance.ServerCommand("healthshot_health 50");
}

Instance.OnScriptInput("PickUpGravity", () => {
    const HintName = "human_gravity_pistol_hint";;
    HumanItems.set(HintName, true);
});

Instance.OnScriptInput("PickUpRock", () => {
    const HintName = "human_rock_pistol_hint";
    HumanItems.set(HintName, true);
});


Instance.OnScriptInput("PickUpWater", () => {
    const HintName = "human_water_pistol_hint";
    HumanItems.set(HintName, true);
});

Instance.OnScriptInput("PickUpFire", () => {
    const HintName = "human_fire_pistol_hint";
    HumanItems.set(HintName, true);
});

Instance.OnScriptInput("PickUpHeal", () => {
    const HintName = "human_heal_pistol_hint";
    HumanItems.set(HintName, true);
});

Instance.OnScriptInput("CheckHumanItems", () => {
    CheckHumanItems();
});

Instance.OnRoundStart(() => {
    Script = Instance.FindEntityByName("global_script2");
    ResetHumanItems();
    Instance.EntFireAtTarget({ target: Script, input: "RunScriptInput", value: "Glow", delay: 2 });
    Instance.EntFireAtTarget({ target: Script, input: "RunScriptInput", value: "CheckHumanItems", delay: 10 });
});

Instance.OnRoundEnd(() => {
    Script = undefined;
    ResetHealthShot();
});