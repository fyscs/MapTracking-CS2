}

function applyEventClass() {

    for (let i = 0; i < 13; i++) {
        const className = EVENT_CLASSES[i];
        if (className) {
            setHasClass("hud", className, false);
        }
    }

    const active = EVENT_CLASSES[eventIndex];
    if (active) {
        setHasClass("hud", active, true);
    }
}

function updateHud() {

    setDialog("stage_label", "stage","< " + eventName + " >");

    applyEventClass();

    showHud();
}

