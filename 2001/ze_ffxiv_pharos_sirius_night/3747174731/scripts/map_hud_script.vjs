function addInitOutputs() {
    const configs = [
        { name: "template_stage_hard", event: "Hard" ,delay: 7},
        { name: "template_stage_savage", event: "Savage" ,delay: 7},
        { name: "template_stage_ultimate", event: "Ultimate" ,delay: 7},
        { name: "global_round_end_fade_fail", event: "Failed" ,delay: 0}
    ];
    
    for (const config of configs) {
        try {
            Instance.EntFireAtName({
                name: config.name,
                input: "AddOutput",
                value: "OnUser1>" + SCRIPT_NAME + ">RunScriptInput>setEvent" + config.event + ">" + config.delay + ">1"
            });
        } catch (e) {}
    }
}

