function showHud() {
    if (isHudVisible) return;
    isHudVisible = true;
    setHasClass("hud", "Hidden", false);
}

function hideHud() {
    if (!isHudVisible) return;
    isHudVisible = false;
    setHasClass("hud", "Hidden", true);
}

function getHudLayout() {
    if (hudLayout) {
        try {
            if (hudLayout.IsValid && hudLayout.IsValid()) {
