Instance.OnScriptInput("findHud", function() {
    const layout = getHudLayout();
    if (layout) {
        try {
            log("  IsValid: " + layout.IsValid());
            log("  SetDialogVariableString: " + typeof layout.SetDialogVariableString);
            log("  SetHasClass: " + typeof layout.SetHasClass);
        } catch (e) {}
    }
});

Instance.OnRoundStart(function() {
    hudLayout = null;
    isAdded = false;

    hideHud();
    
    try {
        isWarmup = Instance.IsWarmupPeriod ? Instance.IsWarmupPeriod() : false;
    } catch (e) {
        isWarmup = false;
    }
    
    if (isWarmup) {
        setEvent(0);
    } else {
        addInitOutputs();
    }

});
