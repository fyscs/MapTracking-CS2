    try {
        const byClass = Instance.FindEntityByClass("custom_hud_layout");
        if (byClass && byClass.SetDialogVariableString) {
            hudLayout = byClass;
            return hudLayout;
        }
    } catch (e) {}

    return null;
}

function setDialog(panelId, key, value) {
    const layout = getHudLayout();
    if (!layout) {
        return false;
    }
    
    try {
        layout.SetDialogVariableString(panelId, key, String(value));
        return true;
    } catch (e) {
        return false;
    }
}

