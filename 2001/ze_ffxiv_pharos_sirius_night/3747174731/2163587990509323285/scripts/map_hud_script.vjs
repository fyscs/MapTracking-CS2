import { Instance } from "cs_script/point_script";

const SCRIPT_NAME = "global_hud_script";
const HUD_ENTITY_NAME = "Map_Hud_Script";
const EVENTS = [
    { name: "Warmup-Round", className: "sirius_StageWarmup", input: "setEventWarm" },
    { name: "Hard", className: "sirius_StageHard", input: "setEventHard" },
    { name: "Savage", className: "sirius_StageSavage", input: "setEventSavage" },
    { name: "Ultimate", className: "sirius_StageUltimate", input: "setEventUltimate" },
    { name: "Congratulations!", className: "sirius_Victory", input: "setEventVictory" },
    { name: "Round Failed", className: "sirius_Defeated", input: "setEventFailed" },
    { name: "ShadowLord", className: "sirius_ShadowLord", input: "setEventShadowLord" },
    { name: "LadyLilith", className: "sirius_LadyLilith", input: "setEventLadyLilith" },
    { name: "Yojimbo", className: "sirius_Yojimbo", input: "setEventYojimbo" },
    { name: "Garland", className: "sirius_Garland", input: "setEventGarland" },
    { name: "Tyrant", className: "sirius_Tyrant", input: "setEventTyrant" },
    { name: "Lilith", className: "sirius_Lilith", input: "setEventLilith" },
    { name: "Bahamut", className: "sirius_Bahamut", input: "setEventBahamut" }
];

// 每条配置依次为：实体名、输出事件、脚本输入、延迟（默认 0 秒）。
const INIT_OUTPUTS = [
    ["template_stage_hard", "OnUser1", "setEventHard", 7],
    ["template_stage_savage", "OnUser1", "setEventSavage", 7],
    ["template_stage_ultimate", "OnUser1", "setEventUltimate", 7],
    ["global_round_end_fade_fail", "OnUser1", "setEventFailed"]
];

const STAGE_OUTPUTS = {
    1: [
        ["stage_victory_hard", "OnStartTouch", "setEventVictory"],
        ["template_boss_shadowlord", "OnEntitySpawned", "setEventShadowLord"],
        ["template_boss_ladylilith", "OnEntitySpawned", "setEventLadyLilith"],
        ["template_boss_yojimbo", "OnEntitySpawned", "setEventYojimbo"]
    ],
    2: [
        ["stage_victory_savage", "OnStartTouch", "setEventVictory"],
        ["template_boss_garland", "OnEntitySpawned", "setEventGarland"],
        ["template_boss_tyrant", "OnEntitySpawned", "setEventTyrant"]
    ],
    3: [
        ["stage_victory_ultimate", "OnStartTouch", "setEventVictory"],
        ["template_boss_lilith", "OnEntitySpawned", "setEventLadyLilith"],
        ["template_stage_ultimate_yojimbo", "OnEntitySpawned", "setEventYojimbo"],
        ["boss_hp_add", "OnUser1", "setEventBahamut"]
    ]
};

const BOSS_OUTPUTS = {
    6: [
        ["shadowlord_model", "OnUser2", "UpdateHud"],
        ["shadowlord_model", "OnUser4", "setEventHard"]
    ],
    7: [
        ["ladylilith_model", "OnAnimationDone", "UpdateHud"],
        ["ladylilith_model", "OnUser4", "setEventHard"],
        ["pharos_fourthfloor_ladylilith_model", "OnAnimationDone", "UpdateHud"],
        ["pharos_fourthfloor_ladylilith_model", "OnUser4", "setEventLilith"]
    ],
    8: [
        ["yojimbo_path_25", "OnPass", "UpdateHud"],
        ["yojimbo_model", "OnUser4", "setEventHard"],
        ["stage_ultimate_yojimbo_model", "OnUser1", "UpdateHud"],
        ["stage_ultimate_yojimbo_model", "OnUser4", "setEventUltimate"]
    ],
    9: [
        ["garland_model", "OnAnimationDone", "UpdateHud"],
        ["garland_model", "OnUser4", "setEventSavage"]
    ],
    10: [
        ["tyrant_model", "OnAnimationDone", "UpdateHud"],
        ["tyrant_model", "OnUser4", "setEventSavage"]
    ],
    11: [
        ["lilith_model", "OnUser1", "UpdateHud"],
        ["lilith_model", "OnUser4", "setEventUltimate"]
    ]
};

let eventIndex = 0;
let hudLayout = null;
let displayedEventIndex = null;
let isHudVisible = null;
let isWarmup = false;
const addedStages = new Set();

function resetHudCache() {
    hudLayout = null;
    displayedEventIndex = null;
    isHudVisible = null;
}

function isHudLayout(layout) {
    return layout && layout.IsValid()
        && typeof layout.SetDialogVariableString === "function"
        && typeof layout.SetHasClass === "function";
}

function getHudLayout() {
    if (hudLayout && hudLayout.IsValid()) {
        return hudLayout;
    }

    // 实体重建后必须重新写入文字、样式和显隐状态。
    resetHudCache();
    let layout = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!isHudLayout(layout)) {
        layout = Instance.FindEntityByClass("custom_hud_layout");
    }
    if (isHudLayout(layout)) {
        hudLayout = layout;
    }
    return hudLayout;
}

function hideHud() {
    const layout = getHudLayout();
    if (!layout || isHudVisible === false) return;

    try {
        layout.SetHasClass("sirius_hud", "sirius_Hidden", true);
        isHudVisible = false;
    } catch (error) {
        resetHudCache();
        Instance.Msg("[Map HUD] 隐藏失败: " + error);
    }
}

function updateHud() {
    const layout = getHudLayout();
    if (!layout) return;

    try {
        if (displayedEventIndex !== eventIndex) {
            const event = EVENTS[eventIndex];
            layout.SetDialogVariableString("sirius_stage_label", "sirius_stage", "< " + event.name + " >");

            if (displayedEventIndex === null) {
                // 首次刷新清理旧样式，后续只切换新旧两个类。
                for (const entry of EVENTS) {
                    layout.SetHasClass("sirius_hud", entry.className, entry === event);
                }
            } else {
                layout.SetHasClass("sirius_hud", EVENTS[displayedEventIndex].className, false);
                layout.SetHasClass("sirius_hud", event.className, true);
            }
            displayedEventIndex = eventIndex;
        }

        if (isHudVisible !== true) {
            layout.SetHasClass("sirius_hud", "sirius_Hidden", false);
            isHudVisible = true;
        }
    } catch (error) {
        resetHudCache();
        Instance.Msg("[Map HUD] 更新失败: " + error);
    }
}

function addOutputs(configs) {
    for (const [name, output, input, delay = 0] of configs) {
        Instance.EntFireAtName({
            name,
            input: "AddOutput",
            value: output + ">" + SCRIPT_NAME + ">RunScriptInput>" + input + ">" + delay + ">1"
        });
    }
}

function setEvent(index) {
    if (!EVENTS[index] || (isWarmup && index !== 0)) return;

    eventIndex = index;
    if (index <= 5 || index === 12) {
        updateHud();
    }

    const stageOutputs = STAGE_OUTPUTS[index];
    if (stageOutputs && !addedStages.has(index)) {
        // 按关卡去重，避免同回合切换关卡后漏绑输出。
        addOutputs(stageOutputs);
        addedStages.add(index);
    }

    const bossOutputs = BOSS_OUTPUTS[index];
    if (bossOutputs) {
        // Boss 仍等原有动画或路径事件显示；重新生成时也需要重新绑定。
        addOutputs(bossOutputs);
    }
}

for (const [index, event] of EVENTS.entries()) {
    Instance.OnScriptInput(event.input, () => setEvent(index));
}
Instance.OnScriptInput("UpdateHud", updateHud);

Instance.OnScriptInput("findHud", function() {
    const layout = getHudLayout();
    if (!layout) {
        Instance.Msg("[Map HUD] 未找到可用的 HUD 实体");
        return;
    }
    Instance.Msg("[Map HUD] IsValid: " + layout.IsValid());
    Instance.Msg("[Map HUD] SetDialogVariableString: " + typeof layout.SetDialogVariableString);
    Instance.Msg("[Map HUD] SetHasClass: " + typeof layout.SetHasClass);
});

Instance.OnRoundStart(function() {
    eventIndex = 0;
    addedStages.clear();
    resetHudCache();
    hideHud();

    isWarmup = Instance.IsWarmupPeriod();
    if (isWarmup) {
        setEvent(0);
    } else {
        addOutputs(INIT_OUTPUTS);
    }
});
