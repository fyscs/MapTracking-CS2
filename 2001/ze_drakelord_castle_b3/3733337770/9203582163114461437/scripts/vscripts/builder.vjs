function ReplaceRoadLights(members, skipSources = false) {
    const replaced = [];
    for (const old of members) {
        if (!EntityValid(old) || old.GetClassName() !== "light_omni2" || old.__drakelordRuntimeLight) continue;
        const name = old.GetEntityName();
        const base = Object.keys(ROAD_LIGHTS).find(key => name === key || name.startsWith(key + "_"));
        if (!base) continue;
        const parent = old.GetParent();
        const parentValid = EntityValid(parent);
        const position = old.GetAbsOrigin(), angles = old.GetAbsAngles();
        const profiles = ROAD_LIGHTS[base].filter(profile => parentValid ? profile.parent && (parent.GetEntityName() === profile.parent || parent.GetEntityName().startsWith(profile.parent + "_")) : !profile.parent);
        if (!profiles.length) continue;
        if (!parentValid && skipSources && profiles.some(profile => Math.hypot(position.x-profile.source[0], position.y-profile.source[1], position.z-profile.source[2]) < 1)) continue;
        const anchor = parentValid ? parent.GetAbsOrigin() : position;
        const yaw = parentValid ? parent.GetAbsAngles().yaw * Math.PI / 180 : 0;
        const dx = position.x - anchor.x, dy = position.y - anchor.y;
        const local = { x: dx * Math.cos(yaw) + dy * Math.sin(yaw), y: -dx * Math.sin(yaw) + dy * Math.cos(yaw), z: position.z - anchor.z };
        const distance = profile => parentValid ? Math.min(...profile.bindings.filter(binding => binding.classname === parent.GetClassName()).map(binding => Math.hypot(local.x - binding.offset[0], local.y - binding.offset[1], local.z - binding.offset[2]))) : 0;
        profiles.sort((a, b) => distance(a) - distance(b));
        const profile = profiles[0];
        if (!profile || (parentValid && distance(profile) > 1)) continue;
        let replacement;
        try {
            [replacement] = Entities.Spawn([{ ...ROAD_LIGHT_DEFAULTS, ...profile.values, classname: "light_omni2", targetname: name, origin: position, angles, precomputedfieldsvalid: 0 }]);
            if (!EntityValid(replacement)) continue;
            if (parentValid) replacement.FireInput({ input: "SetParent", value: "!activator", activator: parent, caller: parent });
            replacement.Teleport({ position, angles });
            replacement.__drakelordRuntimeLight = true;
            old.Remove();
            replaced.push(replacement);
        } catch (error) {
            if (EntityValid(replacement)) replacement.Remove();
            Console.Log("[builder] Could not refresh room light " + name + ": " + error);
        }
    }
    return replaced;
}

function RefreshExistingRoadLights() {
    ReplaceRoadLights(Entities.FindByClass("light_omni2"), true);
}


function SpawnTemplateAt(template, pos, rot) {
    if (!EntityValid(template)) return false;
    template.Teleport({ position: pos, angles: QAng(rot) });
    if (template.GetClassName() === "env_entity_maker") {
        template.FireInput({ input: "ForceSpawn" });
        return true;
    }
    if (template.GetClassName() !== "point_template") return false;
    const created = template.ForceSpawn(pos, QAng(rot));
    if (Array.isArray(created)) ReplaceRoadLights(created);
    return Array.isArray(created) && created.length > 0;
}

function Build(template, pos, rot, mainpath = null) {
    if (!roundActive) return;
    if (routePlanning && !RouteTemplateFits(template, pos, rot)) { routePlanFailed = true; return; }
    buildRequests.push({ template, pos: { ...pos }, rot: { ...rot }, mainpath: mainpath !== null ? mainpath : !main_done });
    ProcessBuildQueue();
}

function ProcessBuildQueue() {
    if (!roundActive || activeBuild || buildRequests.length === 0) return;
    const request = buildRequests.shift();
    activeBuild = { ...request, serial: ++buildSerial, spawned: false };
    ProcessBuild(request.template, request.pos, request.rot, request.mainpath);
}

function FinishQueuedBuild() {
    activeBuild = null;
    waiting_for_build = false;
    if (buildRequests.length > 0) ProcessBuildQueue();
    else ScheduleBuildTick();
}

function PostSpawn() {
    if (!waiting_for_build && !activeBuild) ScheduleBuildTick();
}

function FailBuild(name) {
    StopRuntime();
    Console.Log("[builder] Could not spawn required template: " + name);
}

const STAGE_TITLES = ["", "STAGE 1 - The outer castle", "STAGE 2 - Hold 'em hard", "STAGE 3 - The insane mine maze", "STAGE 4 - Traps everywhere", "STAGE 5 - The endurance"];
let hudGeneration = new Map();

function MapHud() {
    return Entities.FindByName("drakelord_hud").find(EntityValid);
}

function ClearMapHud() {
    hudGeneration.clear();
    const hud = MapHud();
    if (!hud) return;
    for (const id of ["stage", "author"]) {
        hud.SetHasClass(id, "Cleared", true);
        hud.SetHasClass(id, "Visible", false);
        hud.SetHasClass(id, "Fading", false);
        hud.SetDialogVariableString(id, "message", "");
    }
}

function ShowMapText(id, message, fadeIn, hold, fadeOut) {
    if (!roundActive) return;
    const hud = MapHud();
    if (!hud) return;
    const token = {};
    hudGeneration.set(id, token);
    hud.SetHasClass(id, "Cleared", true);
    hud.SetHasClass(id, "Visible", false);
    hud.SetHasClass(id, "Fading", false);
    hud.SetDialogVariableString(id, "message", message);
    RunAfter(0.02, () => {
        if (hudGeneration.get(id) !== token || !EntityValid(hud)) return;
        hud.SetHasClass(id, "Cleared", false);
        hud.SetHasClass(id, "Visible", true);
    });
    RunAfter(fadeIn + hold + 0.02, () => {
        if (hudGeneration.get(id) !== token || !EntityValid(hud)) return;
        hud.SetHasClass(id, "Visible", false);
        hud.SetHasClass(id, "Fading", true);
    });
    RunAfter(fadeIn + hold + fadeOut + 0.02, () => {
        if (hudGeneration.get(id) !== token || !EntityValid(hud)) return;
        hud.SetHasClass(id, "Cleared", true);
        hud.SetDialogVariableString(id, "message", "");
        hudGeneration.delete(id);
    });
}

function ShowStageHud(stage) {
    ShowMapText("stage", STAGE_TITLES[stage] || "", 1.5, 15, 0.5);
}

function ShowAuthorHud() {
    ShowMapText("author", "Map by Luffaren", 1.5, 15, 0.5);
}

RegisterScriptInput("HudAuthor", ShowAuthorHud);
for (let stage = 1; stage <= 5; stage++) RegisterScriptInput("HudStage" + stage, () => ShowStageHud(stage));

const SLOTMACHINE_CHANCE = [20.00, 10.00, 2.00, 8.00]; //(buff / debuff / reward / death / rest=nothing)

let playerPreviousTeams = new Map();

let SPAWNRATIO_rain = 20.00;
let SPAWNRATIO_crushceiling = 30.00;
let SPAWNRATIO_ironmaiden = 50.00;
let SPAWNRATIO_ironmaiden_pizza = 5.00;
let SPAWNRATIO_spiketrap = 50.00;
let SPAWNRATIO_spiketrapinsanity = 10.00;
let SPAWNRATIO_bladetrap = 80.00;
let SPAWNRATIO_slotmachine = 20.00;
let SPAWNRATIO_mine = 4.00;
let SPAWNRATIO_pizza = 3.00;
let SPAWNRATIO_pillar = 10.00;
let SPAWNRATIO_framenotex = 100.00;
let SPAWNRATIO_vinewall = 5.00;
let SPAWNRATIO_box64 = 20.00;
let SPAWNRATIO_pillarfallen = 10.00;
let SPAWNRATIO_rooftower = 15.00;
let SPAWNRATIO_rubble = 40.00;

const SLOTMACHINE_POSITIONS_USED = [];
const SLOTMACHINE_MIN_DISTANCE = 500;

// Custom Vector function 
function Vector(x, y, z) {
    return { x, y, z };
}

function VectorMul(v, scalar) {
    return { x: v.x * scalar, y: v.y * scalar, z: v.z * scalar };
}

function VectorAdd(v1, v2) {
    return { x: v1.x + v2.x, y: v1.y + v2.y, z: v1.z + v2.z };
}

function abs(val) {
    return val < 0 ? -val : val;
}

function IsSlotmachinePositionUsed(pos) {
    for (const usedPos of SLOTMACHINE_POSITIONS_USED) {
        const dist = Math.sqrt(Math.pow(pos.x - usedPos.x, 2) + Math.pow(pos.y - usedPos.y, 2));
        if (dist < SLOTMACHINE_MIN_DISTANCE) {
            return true;
        }
    }
    return false;
}

function AddSlotmachinePosition(pos) {
    SLOTMACHINE_POSITIONS_USED.push(pos);
}

function TryBuildSlotmachineAt(n, pos, rot) {
    if (!IsSlotmachinePositionUsed(pos)) {
        AddSlotmachinePosition(pos);
        const bsEnt = Entities.FindByName("builder_script")[0];
        if (bsEnt) bsEnt.Teleport({ position: pos, angles: QAng(rot) });
        Build(new B_SLOTMACHINE(), pos, rot);
        return true;
    }
    return false;
}

function RandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function RandomFloat(min, max) {
    return Math.random() * (max - min) + min;
}

function Rand(percentage) {
    if (percentage > RandomFloat(0.00, 100.00)) return true;
    return false;
}

class Building {
    constructor(type, fw, lf, up, pos, rot, mainpath, length) {
        this.type = type;
        this.fw = fw;
        this.lf = lf;
        this.up = up;
        this.pos = pos;
        this.rot = rot;
        this.mainpath = mainpath;
        this.length = length;
    }
}

class Exit {
    constructor(type, pos, rot) {
        this.type = type;
        this.pos = pos;
        this.rot = rot;
    }
}

function GetTemplateLength(template) {
    if (!template.exits || template.exits.length === 0) {
        return 0;
    }
    const lastExit = template.exits[template.exits.length - 1];
    return Math.abs(lastExit.pos.x) + Math.abs(lastExit.pos.y) + Math.abs(lastExit.pos.z);
}

const LARGE_BUILDINGS = [
    "s_builder_3waytower",
    "s_builder_lavaroom",
    "s_builder_waterroomr",
    "s_builder_waterrooml",
    "s_builder_clocktower",
    "s_builder_fort",
    "s_builder_outerfort",
    "s_builder_roof",
    "s_builder_outerforttower",
    "s_builder_librarywall"
];

function isLargeBuilding(name) {
    return LARGE_BUILDINGS.includes(name);
}

class B_STRAIGHT {
    constructor() {
        this.turn = false;
        this.wradius = 0;
        this.allowsub = true;
        this.name = "s_builder_straight";
        this.exits = [new Exit("s_builder_straight", Vector(256, 0, 0), Vector(0, 0, 0))];
    }
}

class B_LEFT {
    constructor() {
        this.turn = true;
        this.wradius = 0;
        this.allowsub = true;
        this.name = "s_builder_left";
        this.exits = [new Exit("s_builder_left", Vector(160, 160, 0), Vector(0, 90, 0))];
    }
}

class B_RIGHT {
    constructor() {
        this.turn = true;
        this.wradius = 0;
        this.allowsub = true;
        this.name = "s_builder_right";
        this.exits = [new Exit("s_builder_right", Vector(160, -160, 0), Vector(0, 270, 0))];
    }
}

class B_TJUNC {
    constructor() {
        this.turn = true;
        this.wradius = 0;
        this.allowsub = true;
        this.name = "s_builder_tjunc";
        this.exits = [
            new Exit("s_builder_tjunc", Vector(160, 160, 0), Vector(0, 90, 0)),
            new Exit("s_builder_tjunc", Vector(160, -160, 0), Vector(0, 270, 0))
        ];
    }
}

class B_STAIR {
    constructor() {
