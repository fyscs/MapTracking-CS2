                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: n.pos, angles: QAng(n.rot) });
                BuildDecoration(new B_FRAMENOTEX(), n.pos, n.rot);
            }
            if (Rand(SPAWNRATIO_vinewall)) {
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: n.pos, angles: QAng(n.rot) });
                BuildDecoration(new B_VINEWALL(), n.pos, n.rot);
            }
            const rrr = RandomInt(0, 100);
            const vineDeco = GetDecoPosition(n, 128, 704, 0, 0, 0);
            const bsEnt2 = Entities.FindByName("builder_script")[0];
            if (bsEnt2) bsEnt2.Teleport({ position: vineDeco.pos, angles: QAng(vineDeco.rot) });
            if (rrr >= 0 && rrr < 10) BuildDecoration(new B_VINE1(), vineDeco.pos, vineDeco.rot);
            else if (rrr >= 10 && rrr < 20) BuildDecoration(new B_VINE2(), vineDeco.pos, vineDeco.rot);
            else if (rrr >= 20 && rrr < 30) BuildDecoration(new B_VINE3(), vineDeco.pos, vineDeco.rot);
        } else if (n.type === "s_builder_fort") {
            if (Rand(SPAWNRATIO_slotmachine)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 2184)), VectorMul(n.lf, -48));
                if (!TryBuildSlotmachineAt(n, ssp, n.rot)) {
                    let altSsp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 2184)), VectorMul(n.lf, 48));
                    if (!TryBuildSlotmachineAt(n, altSsp, n.rot)) {
                        let altSsp2 = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 2100)), VectorMul(n.lf, -48));
                        TryBuildSlotmachineAt(n, altSsp2, n.rot);
                    }
                }
            }
        } else if (n.type === "s_builder_librarywall") {
            if (Rand(SPAWNRATIO_slotmachine)) {
                let ssp = VectorAdd(VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 2928)), VectorMul(n.lf, 300)), VectorMul(n.up, 256));
                if (!TryBuildSlotmachineAt(n, ssp, n.rot)) {
                    let altSsp = VectorAdd(VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 2850)), VectorMul(n.lf, 300)), VectorMul(n.up, 256));
                    if (!TryBuildSlotmachineAt(n, altSsp, n.rot)) {
                        let altSsp2 = VectorAdd(VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 3000)), VectorMul(n.lf, 300)), VectorMul(n.up, 256));
                        TryBuildSlotmachineAt(n, altSsp2, n.rot);
                    }
                }
            }
        } else if (n.type === "s_builder_tjunc") {
            if (Rand(SPAWNRATIO_bladetrap)) {
                const bladePos = GetBladeTrapPosition(n);
                if (bladePos.found) {
                    const bsEnt = Entities.FindByName("builder_script")[0];
                    if (bsEnt) bsEnt.Teleport({ position: bladePos.pos, angles: QAng(bladePos.rot) });
                    Build(new B_BLADETRAP(), bladePos.pos, bladePos.rot);
                }
            } else if (Rand(SPAWNRATIO_box64)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 128))), VectorMul(n.lf, RandomInt(-96, 96)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_BOX64(), ssp, ssr);
            } else if (Rand(SPAWNRATIO_pillarfallen)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 128))), VectorMul(n.lf, RandomInt(-96, 96)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_PILLARFALLEN(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_rooftower) && n.mainpath) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, 128)), VectorMul(n.up, 288));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_ROOFTOWER(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_mine)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 128))), VectorMul(n.lf, RandomInt(-96, 96)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                Build(new B_MINE(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_rubble)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 128))), VectorMul(n.lf, RandomInt(-96, 96)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_RUBBLE(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_framenotex)) {
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: n.pos, angles: QAng(n.rot) });
                BuildDecoration(new B_FRAMENOTEX(), n.pos, n.rot);
            }
            if (Rand(SPAWNRATIO_vinewall)) {
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: n.pos, angles: QAng(n.rot) });
                BuildDecoration(new B_VINEWALL(), n.pos, n.rot);
            }
            const rrr = RandomInt(0, 100);
            let vinePos = VectorAdd(n.pos, VectorMul(n.fw, 128));
            let vineRot = Vector(0, RandomInt(0, 360), 0);
            const bsEnt2 = Entities.FindByName("builder_script")[0];
            if (bsEnt2) bsEnt2.Teleport({ position: vinePos, angles: QAng(vineRot) });
            if (rrr >= 0 && rrr < 10) BuildDecoration(new B_VINE1(), vinePos, vineRot);
            else if (rrr >= 10 && rrr < 20) BuildDecoration(new B_VINE2(), vinePos, vineRot);
            else if (rrr >= 20 && rrr < 30) BuildDecoration(new B_VINE3(), vinePos, vineRot);
        } else if (n.type === "s_builder_left" || n.type === "s_builder_right") {
            BuildCornerDecorations(n);
        } else if (n.type === "s_builder_outerplatform") {
            if (Rand(SPAWNRATIO_box64)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-192, 192)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_BOX64(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_pillarfallen)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-192, 192)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_PILLARFALLEN(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_mine)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-192, 192)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                Build(new B_MINE(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_rubble)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-192, 192)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_RUBBLE(), ssp, ssr);
            }
        } else if (n.type === "s_builder_outerplatformsmall") {
            if (Rand(SPAWNRATIO_box64)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-172, 172)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_BOX64(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_pillarfallen)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-172, 172)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_PILLARFALLEN(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_mine)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-172, 172)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                Build(new B_MINE(), ssp, ssr);
            }
            if (Rand(SPAWNRATIO_rubble)) {
                let ssp = VectorAdd(VectorAdd(n.pos, VectorMul(n.fw, RandomInt(64, 960))), VectorMul(n.lf, RandomInt(-172, 172)));
                let ssr = Vector(0, RandomInt(0, 360), 0);
                const bsEnt = Entities.FindByName("builder_script")[0];
                if (bsEnt) bsEnt.Teleport({ position: ssp, angles: QAng(ssr) });
                BuildDecoration(new B_RUBBLE(), ssp, ssr);
            }
        } 

        if (n.type === "s_builder_3waytower") {
            let stairRot0 = Vector(0, n.rot.y + 270, 0);
            let stairRot1 = Vector(0, n.rot.y + 90, 0);
            if (stairRot0.y > 360) stairRot0.y -= 360;
            if (stairRot1.y > 360) stairRot1.y -= 360;
            const stairDownLength = 704;
            function canPlaceStairdown(basePos, rot) {
                const ry = rot.y * Math.PI / 180;
                const forwardX = Math.cos(ry);
                const forwardY = Math.sin(ry);
                const exitPos = {
                    x: basePos.x + forwardX * stairDownLength,
                    y: basePos.y + forwardY * stairDownLength,
                    z: basePos.z - 384
                };
                for (let i = 0; i < buildlist.length - 1; i++) {
                    const b = buildlist[i];
                    if (b.type === "s_builder_3waytower") continue;

                    const dist = Math.sqrt(
                        Math.pow(exitPos.x - b.pos.x, 2) +
                        Math.pow(exitPos.y - b.pos.y, 2)
                    );
                    if (dist < 384) {
                        return false;
                    }
                }

                return true;
            }

            const canPlace0 = canPlaceStairdown(n.pos, stairRot0);
            const canPlace1 = canPlaceStairdown(n.pos, stairRot1);
            if (n.type !== "s_builder_stairdown" && !main_done) {
                if (main_done && !sub_done) {
                    if (canPlace0 && canPlace1) {
                        if (Rand(50.00)) {
                            Build(new B_STAIRDOWN(), n.pos, stairRot0);
                        } else {
                            Build(new B_STAIRDOWN(), n.pos, stairRot1);
                        }
                        tick_lock = false;
                        return;
                    } else if (canPlace0) {
                        Build(new B_STAIRDOWN(), n.pos, stairRot0);
                        tick_lock = false;
                        return;
                    } else if (canPlace1) {
                        Build(new B_STAIRDOWN(), n.pos, stairRot1);
                        tick_lock = false;
                        return;
                    }
                } else {
                    if (canPlace0 && canPlace1) {
                        if (Rand(50.00)) {
                            Build(new B_STAIR(), n.pos, stairRot0);
                        } else {
                            Build(new B_STAIR(), n.pos, stairRot1);
                        }
                        tick_lock = false;
                        return;
                    } else if (canPlace0) {
                        Build(new B_STAIR(), n.pos, stairRot0);
                        tick_lock = false;
                        return;
                    } else if (canPlace1) {
                        Build(new B_STAIR(), n.pos, stairRot1);
                        tick_lock = false;
                        return;
                    }
                }
            }
        }

        if (holdamount <= 0 && n.mainpath) {
            const excludedTypes = [
                "s_builder_outerforttower",
                "s_builder_outerfort",
                "s_builder_finalroom",
                "s_builder_outerplatformsmall",
                "s_builder_outerplatform",
                "s_builder_bridgeupsmall",
                "s_builder_bridgeup",
                "s_builder_bridgesmall",
                "s_builder_bridge",
                "s_builder_bridgelong"
            ];
            const isExcluded = excludedTypes.includes(n.type);

            if (!isExcluded) {
                if (skip_first_hold) {
                    skip_first_hold = false;
                } else {
                    holdamount = AMOUNT_HOLD;
                    Build(new B_HOLD(), n.pos, n.rot);
                    tick_lock = false;
                    return;
                }
            }
        }
        if (buildlist.length === 0 && buildRequests.length === 0 && !activeBuild) {
            building = false;
            Entities.FireInput({ name: "spawndoor", input: "Open", delay: 3.00 });
        } else {
            const selfEntity = Entities.FindByName("builder_script")[0];
            if (selfEntity) {
                ScheduleBuildTick();
            }
            tick_lock = false;
            return;
        }
    }
    const selfEntity = Entities.FindByName("builder_script")[0];
    if (selfEntity) {
        ScheduleBuildTick();
    }
    tick_lock = false;
}

function SeedBuildClass(templateClass, amount) {
    for (let i = 0; i < amount; i++) {
        classlist.push(new templateClass());
    }
}

let lastTPPosition = null;
let tpCooldown = false;

function QueueTP(inputData) {
    const caller = inputData.caller;
    if (!caller) return;
    if (tpCooldown) return;

    const callerOrigin = caller.GetAbsOrigin();
    lastTPPosition = { x: callerOrigin.x, y: callerOrigin.y, z: callerOrigin.z };

    const teslaMaker = Entities.FindByName("tp_tesla")[0];
    if (teslaMaker && teslaMaker.IsValid()) {
        teslaMaker.Teleport({ position: lastTPPosition });
    }
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 0.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 60.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 65.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 66.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 67.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 68.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 69.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 69.50 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 69.75 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 70.00 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 70.25 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 70.50 });
    Entities.FireInput({ name: "tp_tesla", input: "ForceSpawn", delay: 70.75 });
    tpCooldown = true;
    DoExpire(70.75);
    Entities.FireInput({ name: "builder_script", input: "RunScriptInput", value: "SyncTeleportDest", delay: 70.75 });
}

function QueuedTeleportTP(inputData) {
    const caller = inputData.caller;
    if (!caller) return;
    if (tpCooldown) return;

    const teslaMaker = Entities.FindByName("tp_tesla")[0];
    if (!teslaMaker || !teslaMaker.IsValid()) return;

    const teslaPos = teslaMaker.GetAbsOrigin();
    const teleportDest = Entities.FindByName("teleport_destination")[0];
    if (teleportDest && teleportDest.IsValid()) {
        teleportDest.Teleport({ position: { x: teslaPos.x, y: teslaPos.y, z: teslaPos.z } });
    }
}

function DoExpire(delay) {
    Entities.FireInput({ name: "builder_script", input: "RunScriptInput", value: "TPCooldownExpire", delay: delay });
}

function TPCooldownExpire(inputData) {
    tpCooldown = false;
}

function SyncTeleportDest(inputData) {
    const teslaMaker = Entities.FindByName("tp_tesla")[0];
    if (!teslaMaker || !teslaMaker.IsValid()) return;

    const teslaPos = teslaMaker.GetAbsOrigin();
    const teleportDest = Entities.FindByName("teleport_destination")[0];
    if (teleportDest && teleportDest.IsValid()) {
        teleportDest.Teleport({ position: { x: teslaPos.x, y: teslaPos.y, z: teslaPos.z } });
    }
}

function SetVinewallHP(inputData) {
    const caller = inputData.caller;
    if (!caller) return;

    let newhp = 1;
    const players = Entities.FindByClass("player");
    for (const p of players) {
        if (p.IsValid() && p.GetClassName() === "player" && p.GetHealth() > 0 && p.GetTeamNumber() === 3) {
            newhp += AMOUNT_VINEWALL_HP;
        }
    }
    FireEntityInput({ target: caller, input: "SetHealth", value: newhp.toString() });
}

function RestorePlayerMovement(pawn, retryDelay = 0.20) {
    if (!pawn || !pawn.IsValid()) return;
    FireEntityInput({ target: pawn, input: "KeyValue", value: "speed 1.00", delay: 0.00 });
    FireEntityInput({ target: pawn, input: "KeyValue", value: "gravity 1.00", delay: 0.00 });
    if (retryDelay > 0) {
        FireEntityInput({ target: pawn, input: "KeyValue", value: "speed 1.00", delay: retryDelay });
        FireEntityInput({ target: pawn, input: "KeyValue", value: "gravity 1.00", delay: retryDelay });
    }
}

function ResetPlayers() {
    const players = Entities.FindByClass("player");
    for (const p of players) {
        if (p.IsValid() && p.GetClassName() === "player") {
            RestorePlayerMovement(p, 0.20);
        }
    }
}

let winnerZones = new Map();
let winnerCheck = null;

function PawnSlot(pawn) {
    if (!EntityValid(pawn)) return null;
    const controller = pawn.GetPlayerController();
    return EntityValid(controller) ? controller.GetPlayerSlot() : null;
}

function WinnerPawnValid(pawn, team) {
    return EntityValid(pawn) && pawn.GetClassName() === "player" && pawn.IsAlive() && pawn.GetHealth() > 0 && pawn.GetTeamNumber() === team;
}

function WinnerZoneMembers(zone) {
    const members = winnerZones.get(zone) || new Set();
    for (const pawn of members) {
        if (!WinnerPawnValid(pawn, 2) && !WinnerPawnValid(pawn, 3)) members.delete(pawn);
    }
    return [...members];
}

function CheckWinnerBuffer({ caller, activator } = {}) {
    if (!EntityValid(caller) || (!WinnerPawnValid(activator, 2) && !WinnerPawnValid(activator, 3))) return;
    let members = winnerZones.get(caller);
    if (!members) winnerZones.set(caller, members = new Set());
    members.add(activator);
}

function RemoveCheckWinnerBuffer({ caller, activator } = {}) {
    winnerZones.get(caller)?.delete(activator);
}

function FindWinnerZone(caller) {
    if (!EntityValid(caller)) return undefined;
    const name = caller.GetEntityName();
    if (name.startsWith("i_builder_finalroom_checker")) return caller;
    if (!name.startsWith("i_builder_finalroom_door")) return undefined;
    return Entities.FindByName(name.replace("i_builder_finalroom_door", "i_builder_finalroom_checker")).find(EntityValid);
}

function CheckWinner({ caller } = {}) {
    if (!roundActive || winnerCheck) return;
    const zone = FindWinnerZone(caller);
    if (!zone) return;
    winnerCheck = { zone, finished: false, announced: false };
    winnerZones.set(zone, new Set());
    zone.FireInput({ input: "Disable" });
    RunAfter(0.02, () => {
        if (EntityValid(zone)) zone.FireInput({ input: "Enable" });
    }, "winner_enable");
    RunAfter(0.20, CheckWinnerContinue, "winner_check");
}

function SlayForStage(pawn) {
    if (!EntityValid(pawn) || !pawn.IsAlive()) return;
    pawn.TakeDamage({
        damage: Math.max(pawn.GetHealth(), pawn.GetMaxHealth(), 1) + 1,
        damageTypes: CSDamageTypes.GENERIC,
        damageFlags: CSDamageFlags.FORCE_DEATH | CSDamageFlags.IGNORE_ARMOR
    });
}

function StageMessage(text) {
    for (let i = 0; i < 3; i++) Console.ServerCommand("say ***" + text + "***");
}

function CheckWinnerContinue() {
    const check = winnerCheck;
    if (!roundActive || !check || check.finished || !EntityValid(check.zone)) return;
    const members = WinnerZoneMembers(check.zone);
    const humans = new Set(members.filter(pawn => WinnerPawnValid(pawn, 3)));
    const zombies = members.filter(pawn => WinnerPawnValid(pawn, 2));
    if (humans.size === 0) {
        check.finished = true;
        for (const pawn of Entities.FindByClass("player")) if (WinnerPawnValid(pawn, 3)) SlayForStage(pawn);
        StageMessage("NO HUMANS MADE IT TO THE END");
        return;
    }
    if (zombies.length === 0) {
        check.finished = true;
        if (EntityValid(stage_handle)) {
            const next = stage_index >= 5 ? 1 : stage_index + 1;
            stage_handle.SetEntityName("stage_" + next);
        }
        for (const pawn of Entities.FindByClass("player")) {
            if ((WinnerPawnValid(pawn, 2) || WinnerPawnValid(pawn, 3)) && !humans.has(pawn)) SlayForStage(pawn);
        }
        StageMessage("STAGE COMPLETED");
        return;
    }
    for (const pawn of Entities.FindByClass("player")) {
        if (WinnerPawnValid(pawn, 2) && pawn.GetHealth() > 1000) pawn.SetHealth(1000);
    }
    if (!check.announced) {
        Console.ServerCommand("say ***KILL THE REMAINING ZOMBIES***");
        check.announced = true;
    }
    RunAfter(0.20, CheckWinnerContinue, "winner_check");
}

function PruneWinnerSlots(slot) {
    for (const members of winnerZones.values()) {
        for (const pawn of members) if (PawnSlot(pawn) === slot || !EntityValid(pawn)) members.delete(pawn);
    }
}

function ChangeLevel(stage) {
    if (EntityValid(stage_handle) && Number.isInteger(stage) && stage >= 1 && stage <= 5) stage_handle.SetEntityName("stage_" + stage);
}

function CountMainPath() {
    let count = 0;
    for (const bbn of buildlist) {
        if (bbn.mainpath) count++;
    }
    if (count <= AMOUNT_HOLD_FINALEPREVENTION) nomoreholds = true;
}

function SetIronMaidenPush(inputData) {
    const caller = inputData.caller;
    if (!caller) return;

    const modelEntities = Entities.FindByName("i_builder_ironmaiden_model*");
    const pushEntities = Entities.FindByName("i_builder_ironmaiden_push*");
    const push2Entities = Entities.FindByName("i_builder_ironmaiden_push2*");
    const push3Entities = Entities.FindByName("i_builder_ironmaiden_push3*");

    const allPushEntities = [...pushEntities, ...push2Entities, ...push3Entities];

    for (const model of modelEntities) {
        if (!model.IsValid()) continue;

        const modelOrigin = model.GetAbsOrigin();
        const distance = Math.sqrt(
            Math.pow(modelOrigin.x - caller.GetAbsOrigin().x, 2) +
            Math.pow(modelOrigin.y - caller.GetAbsOrigin().y, 2) +
            Math.pow(modelOrigin.z - caller.GetAbsOrigin().z, 2)
        );

        if (distance <= 64) {
            const nearbyPushes = [];
            for (const push of allPushEntities) {
                if (!push.IsValid()) continue;

                const pushOrigin = push.GetAbsOrigin();
                const pushDist = Math.sqrt(
                    Math.pow(pushOrigin.x - modelOrigin.x, 2) +
                    Math.pow(pushOrigin.y - modelOrigin.y, 2) +
                    Math.pow(pushOrigin.z - modelOrigin.z, 2)
                );

                if (pushDist <= 64) {
                    nearbyPushes.push(push);
                }
            }

            FireEntityInput({
                target: model,
                input: "RunScriptInput",
                value: "SetCaller",
                caller: caller,
                activator: caller
            });
        }
    }
}

function pushless(inputData) {
    const caller = inputData.caller;
    if (!caller) return;

    const callers = Entities.FindByName("i_builder_ironmaiden_model*");
    for (const p of callers) {
        if (p.IsValid()) {
            FireEntityInput({ target: p, input: "RunScriptInput", value: "SetCaller" });
        }
    }
}

function SetCaller(inputData) {
    const caller = inputData.caller;
    if (!caller) return;

    const pushEntities = Entities.FindByName("i_builder_ironmaiden_push*");
    const push2Entities = Entities.FindByName("i_builder_ironmaiden_push2*");
    const push3Entities = Entities.FindByName("i_builder_ironmaiden_push3*");
    const allPushEntities = [...pushEntities, ...push2Entities, ...push3Entities];

    const callerOrigin = caller.GetAbsOrigin();
    const callerAngles = caller.GetAbsAngles();

    const nearbyPushes = [];
    for (const p of allPushEntities) {
        if (!p.IsValid()) continue;

        const pushOrigin = p.GetAbsOrigin();
        const distance = Math.sqrt(
            Math.pow(pushOrigin.x - callerOrigin.x, 2) +
            Math.pow(pushOrigin.y - callerOrigin.y, 2) +
            Math.pow(pushOrigin.z - callerOrigin.z, 2)
        );

        if (distance <= 64) {
            nearbyPushes.push(p);
            p.Teleport({
                position: callerOrigin,
                angles: { pitch: 0, yaw: callerAngles.yaw - 90, roll: 0 }
            });
        }
    }

    const scope = EntityState(caller);
    scope.pushes = nearbyPushes;

    for (const p of nearbyPushes) {
        FireEntityInput({ target: p, input: "Enable" });
    }
}

function SetIronMaidenPushState(inputData) {
    const caller = inputData.caller;
    if (!caller) return;

    const value = inputData.value;
    const state = value === "true" || value === "1" || value === "1.0";

    const pushEntities = Entities.FindByName("i_builder_ironmaiden_push*");
    const push2Entities = Entities.FindByName("i_builder_ironmaiden_push2*");
    const push3Entities = Entities.FindByName("i_builder_ironmaiden_push3*");
    const allPushEntities = [...pushEntities, ...push2Entities, ...push3Entities];

    const callerOrigin = caller.GetAbsOrigin();

    if (allPushEntities.length > 0) {
        for (const p of allPushEntities) {
            if (!p.IsValid()) continue;

            const pushOrigin = p.GetAbsOrigin();
            const distance = Math.sqrt(
                Math.pow(pushOrigin.x - callerOrigin.x, 2) +
                Math.pow(pushOrigin.y - callerOrigin.y, 2) +
                Math.pow(pushOrigin.z - callerOrigin.z, 2)
            );

            if (distance <= 64) {
                if (state) {
                    FireEntityInput({ target: p, input: "Enable" });
                } else {
                    FireEntityInput({ target: p, input: "Disable" });
                }
            }
        }
    }
}

function SetIronMaidenPushStatetrue(inputData) {
    SetIronMaidenPushState({ ...inputData, value: "true" });
}

function SetIronMaidenPushStatefalse(inputData) {
    SetIronMaidenPushState({ ...inputData, value: "false" });
}

function SetHan(inputData) {
    han = RootParent(inputData.caller);
}

function hanset(inputData) {
    han = null;
}

function DamageActivator(dmg, inputData) {
    const activator = inputData && inputData.activator;
    if (!activator || !activator.IsValid()) return;
    if (activator.GetClassName() !== "player") return;
    if (activator.GetHealth() <= 0) return;
    activator.TakeDamage({
        damage: dmg,
        damageTypes: CSDamageTypes.GENERIC,
        damageFlags: CSDamageFlags.IGNORE_ARMOR
    });
}

function DamageActivator99(inputData) {
    DamageActivator(99, inputData);
}

function DamageActivator15(inputData) {
    DamageActivator(15, inputData);
}

function DamageActivator60(inputData) {
    DamageActivator(60, inputData);
}

function SlotmachinePressed1(inputData) {
    SlotmachinePressed(1, inputData);
}

function SlotmachinePressed2(inputData) {
    SlotmachinePressed(2, inputData);
}

function SlotmachinePressed3(inputData) {
    SlotmachinePressed(3, inputData);
}

function GetActivatorName(activator) {
    const pawn = activator.GetPlayerController();
    if (pawn && pawn.IsValid()) {
        return pawn.GetPlayerName();
    }
    return "Unknown";
}

function SlotmachinePressed(heart, inputData) {
    const activator = inputData.activator;
    const caller = inputData.caller;
    if (!activator || !caller) return;

    if (activator.IsValid() && activator.GetClassName() === "player" && activator.GetTeamNumber() === 3 && activator.GetHealth() > 0) {
        FireEntityInput({ target: caller, input: "FireUser1" });

        const boundModel = slotmachineBindings.get(caller);
        const playerName = GetActivatorName(activator);

        const r = RandomFloat(0.00, 100.00);
        const chance = [SLOTMACHINE_CHANCE[0], SLOTMACHINE_CHANCE[1], SLOTMACHINE_CHANCE[2], SLOTMACHINE_CHANCE[3]];

        if (heart === 1) {
            chance[0] = chance[0] * 1.0;
            chance[1] = chance[1] * 1.0;
            chance[2] = chance[2] * 1.0;
            chance[3] = chance[3] * 1.0;
        } else if (heart === 2) {
            chance[0] = chance[0] * 2.0;
            chance[1] = chance[1] * 1.5;
            chance[2] = chance[2] * 2.0;
            chance[3] = chance[3] * 1.5;
        } else if (heart === 3) {
            chance[0] = chance[0] * 2.5;
            chance[1] = chance[1] * 2.0;
            chance[2] = chance[2] * 5.0;
            chance[3] = chance[3] * 2.0;
        }

        const res = Rands(chance);

        if (res === 0) {
            if (boundModel) FireEntityInput({ target: boundModel, input: "Skin", value: "1", delay: 1.00 });
            if (boundModel) FireEntityInput({ target: boundModel, input: "SetAnimationNotLooping", value: "buff", delay: 1.00 });
            if (boundModel) FireEntityInput({ target: boundModel, input: "SetIdleAnimationLooping", value: "buff", delay: 1.02 });
        } else if (res === 1) {
            if (boundModel) FireEntityInput({ target: boundModel, input: "FireUser1", delay: 0.90 });
            const act = Rands([50.00, 30.00, 20.00]);
            if (act === 1) {
                FireEntityInput({ target: activator, input: "KeyValue", value: `health ${activator.GetHealth() + 100}`, delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** BUFF --- ${playerName} health +100 **`, delay: 0.90 });
            } else if (act === 2) {
                FireEntityInput({ target: activator, input: "KeyValue", value: "speed 1.50", delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** BUFF --- ${playerName} speed up (1.50) **`, delay: 0.90 });
            } else if (act === 3) {
                FireEntityInput({ target: activator, input: "KeyValue", value: "gravity 0.40", delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** BUFF --- ${playerName} gravity low (0.40) **`, delay: 0.90 });
            }
        } else if (res === 2) {
            if (boundModel) FireEntityInput({ target: boundModel, input: "FireUser2", delay: 1.00 });
            const act = Rands([50.00, 30.00, 20.00]);
            if (act === 1) {
                FireEntityInput({ target: activator, input: "KeyValue", value: "health 1", delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** DEBUFF --- ${playerName} health 1 **`, delay: 1.00 });
            } else if (act === 2) {
                FireEntityInput({ target: activator, input: "KeyValue", value: "speed 0.50", delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** DEBUFF --- ${playerName} speed down (0.50) **`, delay: 1.00 });
            } else if (act === 3) {
                FireEntityInput({ target: activator, input: "KeyValue", value: "gravity 1.50", delay: 1.00 });
                FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** DEBUFF --- ${playerName} gravity high (1.50) **`, delay: 1.00 });
            }
        } else if (res === 3) {
            if (boundModel) FireEntityInput({ target: boundModel, input: "FireUser3", delay: 1.05 });
            FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** REWARD --- ${playerName} health +300, speed 2.00, gravity 0.30 **`, delay: 1.05 });
            FireEntityInput({ target: activator, input: "KeyValue", value: `health ${activator.GetHealth() + 300}`, delay: 1.00 });
            FireEntityInput({ target: activator, input: "KeyValue", value: "speed 2.00", delay: 1.00 });
            FireEntityInput({ target: activator, input: "KeyValue", value: "gravity 0.30", delay: 1.00 });
        } else if (res === 4) {
            if (boundModel) FireEntityInput({ target: boundModel, input: "FireUser4", delay: 1.10 });
            FireEntityInput({ target: Entities.FindByName("server")[0], input: "Command", value: `say ** DEATH --- ${playerName} health ${Math.floor(activator.GetHealth() / 2)}, ignited **`, delay: 1.10 });
            FireEntityInput({ target: activator, input: "KeyValue", value: `health ${Math.floor(activator.GetHealth() / 2)}`, delay: 1.00 });
            FireEntityInput({ target: activator, input: "IgniteLifetime", value: "100", delay: 1.00 });
        }
    }
}

function bindbutton(inputData) {
    const button = inputData.caller;
    if (!button) return;

    const models = Entities.FindByName("i_builder_slotmachine_model*");
    let nearestModel = null;
    let nearestDist = 999999;

    for (const model of models) {
        if (!model.IsValid()) continue;
        const dist = Math.sqrt(
            Math.pow(model.GetAbsOrigin().x - button.GetAbsOrigin().x, 2) +
            Math.pow(model.GetAbsOrigin().y - button.GetAbsOrigin().y, 2) +
            Math.pow(model.GetAbsOrigin().z - button.GetAbsOrigin().z, 2)
        );
        if (dist <= 64 && dist < nearestDist) {
            nearestDist = dist;
            nearestModel = model;
        }
    }

    if (nearestModel) {
        slotmachineBindings.set(button, nearestModel);

        const allButtons = Entities.FindByName("i_builder_slotmachine_button*");
        for (const otherButton of allButtons) {
            if (!otherButton.IsValid() || otherButton === button) continue;
            const dist = Math.sqrt(
                Math.pow(otherButton.GetAbsOrigin().x - button.GetAbsOrigin().x, 2) +
                Math.pow(otherButton.GetAbsOrigin().y - button.GetAbsOrigin().y, 2) +
                Math.pow(otherButton.GetAbsOrigin().z - button.GetAbsOrigin().z, 2)
            );
            if (dist <= 64) {
                slotmachineBindings.set(otherButton, nearestModel);
            }
        }
    }
}

