.Root {
    width:100%;
    height:100%;
}
.MapText {
    horizontal-align:center;
    vertical-align:top;
    text-align:center;
    font-family:Verdana, Stratum2, 'Noto Sans';
    font-weight:bold;
    font-size:36px;
    letter-spacing:0px;
    color:#FFFF00;
    opacity:0;
    transition-property:opacity, color;
    transition-duration:1.5s, 0.2s;
    transition-timing-function:linear, linear;
}
.Author {
    margin-top:20%;
    font-size:28px;
    letter-spacing:0px;
    color:#ffa00f;
}
.Stage {
    margin-top:26%;
}
.MapText.Visible {
    opacity:1;
}
.MapText.Fading {
    opacity:0;
    transition-duration:0.5s, 0s;
}
.MapText.Cleared {
    opacity:0;
    transition-duration:0s;
}
