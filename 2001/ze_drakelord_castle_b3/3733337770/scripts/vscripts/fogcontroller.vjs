import { Instance, Entities } from "cs_script/point_script";

let z = 50000, tz = 50000;
let r = 255, g = 255, b = 255, tr = 255, tg = 255, tb = 255;
let ds = 500, tds = 500, de = 20000, tde = 20000;
let speed = 0.25, speed_dist = 5, speed_z = 5;
let ticking = false, active = true;
let lastSent = new Map();

function ResetScript() {
    z = tz = 50000;
    r = g = b = tr = tg = tb = 255;
    ds = tds = 500;
    de = tde = 20000;
    speed = 0.25;
    speed_dist = speed_z = 5;
    ticking = false;
    lastSent.clear();
}

function Send(input, value, force = false) {
    if (!active || (!force && lastSent.get(input) === value)) return;
    const fog = Entities.FindByName("fog").find(entity => entity.IsValid() && entity.GetClassName() === "env_gradient_fog");
    if (!fog) return;
    fog.FireInput({ input, value });
    lastSent.set(input, value);
}

function ApplyColor(force = false) {
    Send("SetFogColor", `${Math.trunc(r)} ${Math.trunc(g)} ${Math.trunc(b)}`, force);
}

function ApplyDistance(force = false) {
    Send("SetFogStartDistance", Math.trunc(ds), force);
    Send("SetFogEndDistance", Math.trunc(de), force);
}

function SetFogColor(red, green, blue) {
    if (![red, green, blue].every(Number.isFinite)) return;
    r = tr = Math.max(0, Math.min(255, red));
    g = tg = Math.max(0, Math.min(255, green));
    b = tb = Math.max(0, Math.min(255, blue));
    ApplyColor(true);
}

function SetFogColorTarget(red, green, blue) {
    if (![red, green, blue].every(Number.isFinite)) return;
    tr = Math.max(0, Math.min(255, red));
    tg = Math.max(0, Math.min(255, green));
    tb = Math.max(0, Math.min(255, blue));
    StartTick();
}

function SetDistance(start, end) {
    if (![start, end].every(Number.isFinite)) return;
    ds = tds = start;
    de = tde = end;
    ApplyDistance(true);
}

function SetDistanceTarget(start, end) {
    if (![start, end].every(Number.isFinite)) return;
    tds = start;
    tde = end;
    StartTick();
}

function SetFarz(amount) {
    if (!Number.isFinite(amount)) return;
    z = tz = amount;
    Send("SetFarZ", Math.trunc(z), true);
}

function SetFarzTarget(amount) {
    if (!Number.isFinite(amount)) return;
    tz = amount;
    StartTick();
}

function SetSpeedColor(amount) {
    if (!Number.isFinite(amount) || amount < 0) return;
    speed = amount;
    StartTick();
}

function SetSpeedDistance(amount) {
    if (!Number.isFinite(amount) || amount < 0) return;
    speed_dist = amount;
    StartTick();
}

function SetSpeedZ(amount) {
    if (!Number.isFinite(amount) || amount < 0) return;
    speed_z = amount;
    StartTick();
}

function Initialize() {
    ticking = false;
}

function HasProgress() {
    return (speed > 0 && (r !== tr || g !== tg || b !== tb)) ||
        (speed_dist > 0 && (ds !== tds || de !== tde)) || (speed_z > 0 && z !== tz);
}

function Approach(value, target, step) {
    return value < target ? Math.min(value + step, target) : Math.max(value - step, target);
}

function StartTick() {
    if (!active || ticking || !HasProgress()) return;
    ticking = true;
    Tick();
}

function Tick() {
    if (!active || !ticking) return;
    r = Approach(r, tr, speed);
    g = Approach(g, tg, speed);
    b = Approach(b, tb, speed);
    ds = Approach(ds, tds, speed_dist);
    de = Approach(de, tde, speed_dist);
    z = Approach(z, tz, speed_z);
    ApplyColor();
    ApplyDistance();
    Send("SetFarZ", Math.trunc(z));
    ticking = HasProgress();
    if (ticking) Instance.SetNextThink(Instance.GetGameTime() + 0.01);
}

const commands = { SetFogColor, SetFogColorTarget, SetDistance, SetDistanceTarget, SetFarz, SetFarzTarget, SetSpeedColor, SetSpeedDistance, SetSpeedZ };
function ExecuteCommand(text) {
    if (!active || typeof text !== "string") return false;
    const match = /^(?:fogcmd:)?([a-z]+)\(\s*([-+0-9.eE,\s]+)\s*\)\s*;?$/i.exec(text.trim());
    if (!match) return false;
    const name = Object.keys(commands).find(key => key.toLowerCase() === match[1].toLowerCase());
    if (!name) return false;
    const args = match[2].split(",").map(value => value.trim() === "" ? NaN : Number(value));
    if (args.length !== commands[name].length || !args.every(Number.isFinite)) return false;
    commands[name](...args);
    return true;
}

const inputs = new Set();
function Register(name, action) {
    const key = name.toLowerCase();
    if (inputs.has(key)) return;
    inputs.add(key);
    Instance.OnScriptInput(name, action);
}

Register("Initialize", Initialize);
Register("StartTick", StartTick);
Register("Tick", StartTick);
Register("Command", ({ caller }) => {
    if (caller?.IsValid()) ExecuteCommand(caller.GetEntityName());
});

const presets = [
    "SetFogColor(150,200,200)", "SetFogColor(255,255,255)",
    "SetDistance(500,16000)", "SetDistance(200,2000)", "SetDistance(500,20000)",
    "SetFogColorTarget(100,125,150)", "SetFogColorTarget(255,200,100)",
    "SetFogColorTarget(255,255,200)", "SetFogColorTarget(150,200,255)", "SetFogColorTarget(255,255,255)",
    "SetDistanceTarget(500,10000)", "SetDistanceTarget(500,8000)", "SetDistanceTarget(500,5000)",
    "SetDistanceTarget(500,7000)", "SetDistanceTarget(500,6000)", "SetDistanceTarget(100,4000)",
    "SetDistanceTarget(1000,2000)", "SetDistanceTarget(500,15000)",
    "SetFarz(50000)", "SetFarzTarget(50000)", "SetSpeedZ(5)",
    "SetSpeedColor(0.02)", "SetSpeedColor(0.10)", "SetSpeedColor(0.25)",
    "SetSpeedDistance(3.0)", "SetSpeedDistance(5.0)", "SetSpeedDistance(25.0)"
];
for (const expression of presets) Register(expression, () => ExecuteCommand(expression));
for (const [name, value] of [["speed_0.02", 0.02], ["speed_0.10", 0.10], ["speed_0.25", 0.25]]) Register(name, () => SetSpeedColor(value));
for (const [name, value] of [["speed_dist_3.0", 3], ["speed_dist_5.0", 5], ["speed_dist_25.0", 25]]) Register(name, () => SetSpeedDistance(value));

Instance.SetThink(Tick);
Instance.OnRoundStart(() => { active = true; ResetScript(); });
Instance.OnRoundEnd(() => { active = false; ticking = false; });
Instance.OnBeginRoundRestart(() => { active = false; ticking = false; });
Instance.OnScriptReload({
    before: () => ({ z, tz, r, g, b, tr, tg, tb, ds, tds, de, tde, speed, speed_dist, speed_z, active, ticking }),
    after: memory => {
        if (!memory) return;
        ({ z, tz, r, g, b, tr, tg, tb, ds, tds, de, tde, speed, speed_dist, speed_z, active } = memory);
        ticking = false;
        lastSent.clear();
        if (memory.ticking) StartTick();
    }
});
