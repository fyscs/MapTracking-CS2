//Значение правой части "x <- ..." (true / false / число / переменная / переменная ± число)
function EvalValue(expr)
{
	const e = expr.trim();
	if (e === "true")
		return true;
	if (e === "false")
		return false;
	if (/^-?\d+(\.\d+)?$/.test(e))
		return Number(e);
	const m = e.match(/^(\w+)\s*([+-])\s*(-?\d+(?:\.\d+)?)$/);
	if (m && m[1] in S)
		return m[2] === "+" ? S[m[1]] + Number(m[3]) : S[m[1]] - Number(m[3]);
	if (e in S)
		return S[e];
	return undefined;
}

//Разбор строки RunScriptCode в обработчик (один раз при регистрации)
function CompileMapInput(code)
{
	const src = code.trim().replace(/;+\s*$/, "").trim();
	let m = src.match(/^(\w+)\s*\(([^)]*)\)$/);
	if (m)
	{
		const fn = MAP_FUNCS[m[1]];
		if (!fn)
			return undefined;
		const args = m[2].trim() === "" ? [] : m[2].split(",").map((s) => Number(s.trim()));
		// PORT: вызовы функций — через Later(0), присваивания — сразу. Если у одного выхода несколько
		// RunScriptInput с delay 0 (a_tw_button_*: controlDoorsTriggerd() + a_top_triggered<-1), функция
		// всегда видит уже выставленные переменные — независимо от порядка выходов в CS2.
		return (ctx) => Later(0, () => fn(args, ctx));
	}
	m = src.match(/^(\w+)\s*(\+\+|--)$/);
	if (m)
	{
		const name = m[1];
		const step = m[2] === "++" ? 1 : -1;
		return () =>
		{
			if (name in S)
				S[name] += step;
		};
	}
	m = src.match(/^(\w+)\s*<-\s*(.+)$/);
	if (m)
	{
		const name = m[1];
		const rhs = m[2];
		return () =>
		{
			const v = EvalValue(rhs);
			if (v === undefined)
			{
				Instance.Msg(`[endemic] bad value in "${code}"`);
				return;
			}
			S[name] = v;
		};
	}
	return undefined;
}

function RegisterMapInput(code)
{
	const handler = CompileMapInput(code);
	if (!handler)
	{
		Instance.Msg(`[endemic] unknown map input "${code}"`);
		return;
	}
	const run = ({ caller, activator }) =>
	{
		try
		{
			handler({ caller, activator });
		}
		catch (e)
		{
			Instance.Msg(`[endemic] input "${code}" error: ${e}`);
		}
	};
	Instance.OnScriptInput(code, run);
	// тот же вход без пробелов и ';' — на случай, если строку почистили при переносе
	const alt = code.replace(/\s+/g, "").replace(/;+$/, "");
	if (alt !== code)
		Instance.OnScriptInput(alt, run);
}

for (const code of MAP_INPUTS)
	RegisterMapInput(code);

