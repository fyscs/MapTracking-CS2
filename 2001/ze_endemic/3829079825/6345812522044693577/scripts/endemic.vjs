};

//============================================================================================
// Ядро: отложенные вызовы, раунды
//============================================================================================

let ROUND_ID = 0;
let LEVEL = 1;          //map_level_counter: 1 = intro (warmup), 2 = до победы CT, 3 = после победы CT
let SELF_ENT = undefined;
let HUD_ENT = undefined;

function Self()
{
	if (!SELF_ENT?.IsValid())
		SELF_ENT = Instance.FindEntityByName(SCRIPT_NAME);
	return SELF_ENT;
}

function Hud()
{
	if (!HUD_ENT?.IsValid())
		HUD_ENT = Instance.FindEntityByName(HUD_NAME);
	return HUD_ENT;
}

const LATER_QUEUE = [];
let LATER_SEQ = 0;

//EntFireByHandle(self, "RunScriptCode", "...", delay) — через очередь I/O на самого себя
function Later(delay, fn)
{
	const self = Self();
	if (!self)
	{
		Instance.Msg(`[endemic] ${SCRIPT_NAME} not found, delayed call dropped`);
		return;
	}
	const d = Math.max(0, Number(delay) || 0);
	LATER_QUEUE.push({ time: Instance.GetGameTime() + d, seq: LATER_SEQ++, round: ROUND_ID, fn });
	Instance.EntFireAtTarget({ target: self, input: "RunScriptInput", value: "__later", delay: d });
}

function RunLater()
{
	const now = Instance.GetGameTime() + 0.005;
	const due = [];
	for (let i = LATER_QUEUE.length - 1; i >= 0; i--)
	{
		const c = LATER_QUEUE[i];
		if (c.round !== ROUND_ID)
		{
			LATER_QUEUE.splice(i, 1);
			continue;
		}
		if (c.time <= now)
		{
			due.push(c);
			LATER_QUEUE.splice(i, 1);
		}
	}
	due.sort((a, b) => (a.time - b.time) || (a.seq - b.seq));
	for (const c of due)
	{
		try
		{
			c.fn();
		}
		catch (e)
		{
			Instance.Msg(`[endemic] delayed call error: ${e}`);
		}
	}
}

Instance.OnScriptInput("__later", RunLater);

//============================================================================================
// Утилиты
//============================================================================================

// Squirrel RandomInt(a,b) — включительно с обеих сторон
function RandomInt(min, max)
{
	min = Math.ceil(min);
	max = Math.floor(max);
	return Math.floor(Math.random() * (max - min + 1)) + min;
}

function RandomFloat(min, max)
{
	return Math.random() * (max - min) + min;
}

// Squirrel .tointeger() — отбрасывание дробной части
function ToInt(v)
{
	return Math.trunc(v);
}

function V(x, y, z)
{
	return { x: Number(x), y: Number(y), z: Number(z) };
}

function ParseVec(str)
{
	const p = String(str).trim().split(/\s+/).map(Number);
	return V(p[0], p[1], p[2]);
}

function Dist(a, b)
{
	return Math.sqrt((a.x - b.x) ** 2 + (a.y - b.y) ** 2 + (a.z - b.z) ** 2);
}

function Debug(text)
{
	if (DEBUG)
		Instance.Msg(text);
}

// ScriptPrintMessageChatAll
function Say(text)
{
	// PORT: ';' и '"' ломают консольную команду; \r/\n разрезают её на две (\x0d был цветом в CS:GO)
	const s = String(text).replace(/[;"]/g, "").replace(/\r/g, "\x0e").replace(/\n/g, " ");
	Instance.ServerCommand(`say ${s}`);
}

// EntFire(name, input, value, delay, activator)
function Fire(name, input, value = "", delay = 0, activator = undefined, caller = undefined)
{
	Instance.EntFireAtName({ name, input, value: String(value), delay, activator, caller });
}

// EntFireByHandle(target, input, value, delay, activator, caller)
function FireT(target, input, value = "", delay = 0, activator = undefined, caller = undefined)
{
	if (!target?.IsValid())
		return;
	Instance.EntFireAtTarget({ target, input, value: String(value), delay, activator, caller });
}

// EntFire("map_servercommand", "Command", cmd, delay)
function ServerCmd(cmd, delay = 0)
{
	if (delay > 0)
		Later(delay, () => Instance.ServerCommand(cmd));
	else
		Instance.ServerCommand(cmd);
}

// Finds the entity given its name (this purely makes the code bit easier to read for me)
function entityFinder(name)
{
	return Instance.FindEntityByName(name);
}

// Entities.FindByNameNearest
function FindByNameNearest(name, pos, radius)
{
	let best = undefined;
	let bestDist = radius;
	for (const e of Instance.FindEntitiesByName(name))
	{
		if (!e?.IsValid())
			continue;
		const d = Dist(e.GetAbsOrigin(), pos);
		if (d <= bestDist)
		{
			best = e;
			bestDist = d;
		}
	}
	return best;
}

// Entities.FindByClassnameNearest
function FindByClassnameNearest(className, pos, radius)
{
	let best = undefined;
	let bestDist = radius;
	for (const e of Instance.FindEntitiesByClass(className))
	{
		if (!e?.IsValid())
			continue;
		const d = Dist(e.GetAbsOrigin(), pos);
		if (d <= bestDist)
		{
			best = e;
			bestDist = d;
		}
	}
	return best;
}

// point_template ForceSpawn / env_entity_maker SpawnEntityAtLocation
function Spawn(templateName, origin = undefined, angles = undefined)
{
	const t = Instance.FindEntityByName(templateName);
	if (!t?.IsValid())
	{
		Instance.Msg(`[endemic] template ${templateName} not found`);
		return [];
	}
	const ents = origin ? t.ForceSpawn(origin, angles ?? { pitch: 0, yaw: 0, roll: 0 }) : t.ForceSpawn();
	return ents ?? [];
}

function SpawnFromMaker(makerName, origin, angles)
{
	return Spawn(MAKER_TEMPLATE[makerName] ?? makerName, origin, angles);
}

function Pick(ents, name)
{
	return ents.find((e) => e?.IsValid() && e.GetEntityName() === name);
}

function SpawnOne(templateName, entName, origin = undefined, angles = undefined)
{
	return Pick(Spawn(templateName, origin, angles), entName);
}

function SetParent(child, parent)
{
	if (!child?.IsValid())
		return;
	child.SetParent(parent?.IsValid() ? parent : undefined);
}

function Glow(ent, color)
{
	if (ent?.IsValid() && typeof ent.Glow === "function")
		ent.Glow(color);
}

// EntFire(name, "SetGlowEnabled", "", delay)
function GlowByName(name, color, delay = 0)
{
	Later(delay, () =>
	{
		for (const e of Instance.FindEntitiesByName(name))
			Glow(e, color);
	});
}

function SpriteShow(target, delay = 0)
{
	if (typeof target === "string")
		Fire(target, SPRITE_SHOW_INPUT, "", delay);
	else
		FireT(target, SPRITE_SHOW_INPUT, "", delay);
}

function SpriteHide(target, delay = 0)
{
	if (typeof target === "string")
		Fire(target, SPRITE_HIDE_INPUT, "", delay);
	else
		FireT(target, SPRITE_HIDE_INPUT, "", delay);
}

// sprite.__KeyValueFromString("rendercolor", "r g b")
function SpriteColor(target, rgb, delay = 0)
{
	FireT(target, SPRITE_COLOR_INPUT, `${SPRITE_COLOR_CP}: ${rgb}`, delay);
}

function IsPawn(p)
{
	return !!p?.IsValid() && typeof p.GetPlayerController === "function";
}

// while((plyer = Entities.FindByClassname(plyer, "player"))!=null)
function AllPawns()
{
	const out = [];
	for (const c of Instance.GetAllPlayerControllers())
	{
		if (!c?.IsValid() || !c.IsConnected())
			continue;
		const p = c.GetPlayerPawn();
		if (p?.IsValid())
			out.push(p);
	}
	return out;
}

function SlotOf(pawn)
{
	if (!IsPawn(pawn))
		return undefined;
	const c = pawn.GetPlayerController() ?? pawn.GetOriginalPlayerController();
	return c?.GetPlayerSlot();
}

// EntFireByHandle(activator, "SetHealth", "0") — в CS:GO это TakeDamage(health) от самого себя (god mode спасает)
function KillPawn(pawn)
{
	if (!pawn?.IsValid() || pawn.GetHealth() < 1)
		return;
	pawn.TakeDamage({ damage: pawn.GetHealth() + 1, damageTypes: CSDamageTypes.GENERIC, damageFlags: CSDamageFlags.IGNORE_ARMOR });
}

// Chooses non-repeating indices for a round of minigame; used for spawning server rack and colours
// Inputs: minimum_index - minimum index to start from
//       maximum_indices - maximum amount of indices needed
//       maximum_options - maximum amount of options available
function indexChooser(minimum_index, maximum_indices, maximum_options)
{
	const indices = [];
	//PORT: защита от вечного цикла (в оригинале сервер зависал, если опций меньше, чем нужно)
	const available = Math.max(0, maximum_options - minimum_index);
	const needed = Math.min(maximum_indices, available);
	while (indices.length < needed)
	{
		const current_index = RandomInt(minimum_index, maximum_options - 1);
		if (!indices.includes(current_index))
			indices.push(current_index);
	}
	return indices;
}

