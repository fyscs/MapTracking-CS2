// Spawns glowing report model at all possible locations
function adminRP()
{
	Later(0.0, adminRPChat);
	let it = 0;
	for (let i = 0; i < ITEM_RP_COORDX.length; i++)
	{
		const report_index = RandomInt(0, 13);
		Later(it, () =>
		{
			const ents = itemsRPSpawn();
			Later(0.05, () => allocateReport(report_index, i, ents));
		});
		it = it + 0.1;
	}
	Later(it + 0.1, () =>
	{
		for (let r = 0; r <= 13; r++)
			for (const e of Instance.FindEntitiesByName("item_rp_prop" + r))
				Glow(e, GLOW_YELLOW);
	});
	Fire("item_rp_button*", "Kill", "", it + 0.1);
}

