//* General *//

// Prints game_text to let know if a ZM interactable item is destroyed
function itemsText()
{
	S.zm_text_hold = 3;
	Later(0.02, () => ZmText("MsgItem"));
}

//* Powerbox *//

// Chooses locations to spawn powerboxes, and spawns them
function itemsPB()
{
	const indices = S.item_pb_indices;
	// The first spawned box is always the correct one
	const box = SpawnOne("item_pb_template1", "item_pb_box1");
	const breaks = Spawn("item_pb_break_template");
	const break1 = Pick(breaks, "item_pb_break1");
	const break2 = Pick(breaks, "item_pb_break2");
	Later(0.02, () =>
	{
		SetParent(break2, box);
		SetParent(break1, box);
		break1?.SetHealth(ITEM_PB_HEALTH);
		break2?.SetHealth(ITEM_PB_HEALTH);
	});
	Later(0.05, () => spawnPB1(indices[0], box));
	Later(0.08, () => SetParent(break2, undefined));
	for (let it = 1; it < indices.length; it++)
	{
		Later(0.1 * it, () =>
		{
			const extra = spawnDelayPB1();
			Later(0.05, () => spawnPB1(indices[it], extra));
		});
	}
}

// Spawns powerboxes at its original state (stage 1)
function spawnPB1(index, box = FindByNameNearest("item_pb_box1", V(392, -232, -756), 8))
{
	if (!box?.IsValid())
		return;
	box.Teleport({
		position: V(ITEM_PB_COORDX[index], ITEM_PB_COORDY[index], ITEM_PB_COORDZ[index]),
		angles: { pitch: 0, yaw: ITEM_PB_YAW[index], roll: 0 },
	});
}

// Templates stage 1 powerboxes with a delay
function spawnDelayPB1()
{
	return SpawnOne("item_pb_template1", "item_pb_box1");
}

// Spawns powerboxes at its semi-broken state (stage 2)
function spawnPB2()
{
	const i0 = S.item_pb_indices[0];
	const newbox = FindByNameNearest("item_pb_box2", V(392, -200, -756), 8);
	const oldbox = FindByNameNearest("item_pb_box1", V(ITEM_PB_COORDX[i0], ITEM_PB_COORDY[i0], ITEM_PB_COORDZ[i0]), 1);
	if (!newbox || !oldbox)
		return;
	newbox.Teleport({ position: oldbox.GetAbsOrigin(), angles: { pitch: 0, yaw: oldbox.GetAbsAngles().yaw, roll: 0 } });
	FireT(oldbox, "Kill", "", 0.0);
}

// Spawns powerboxes at its destroyed state (stage 3)
function spawnPB3()
{
	const i0 = S.item_pb_indices[0];
	const newbox = FindByNameNearest("item_pb_box3", V(392, -168, -756), 1);
	const oldbox = FindByNameNearest("item_pb_box2", V(ITEM_PB_COORDX[i0], ITEM_PB_COORDY[i0], ITEM_PB_COORDZ[i0]), 1);
	if (!newbox || !oldbox)
		return;
	newbox.Teleport({ position: oldbox.GetAbsOrigin(), angles: { pitch: 0, yaw: oldbox.GetAbsAngles().yaw, roll: 0 } });
	FireT(oldbox, "Kill", "", 0.0);
}

// Fires if the powerbox is broken
function brokePB()
{
	Say("⠀\x10 [ OPR ]\x01 I sense a\x0f sudden power surge\x01. There will be a\x02 blackout\x01 for a\x02 few seconds\x01 soon");
	Fire("b_rotate*", "Stop", "", 5.0);// Stop the generator hints
	// Prepare the blackout (fog)
	const duration = RandomInt(2, 4);
	S.fade.holdtime = duration;
	S.fade.duration = 0.05;
	Later(5.0, MapFade);
	itemsText();
	// Make path bravo minigame longer
	S.b_mg_wait_time = S.b_mg_wait_time + 10;
	Debug("Debug (PB break): setting b_mg_wait_time to " + S.b_mg_wait_time);
}

//* Groundcables *//

// Chooses locations to spawn groundcables, and spawns them
function itemsGC()
{
	const indices = S.item_gc_indices;
	// The first spawned box is always the correct one
	const cable = SpawnOne("item_gc_template1", "item_gc_prop1");
	const breaks = Spawn("item_gc_break_template");
	const gc_break = Pick(breaks, "item_gc_break");
	const gc_multiple = Pick(breaks, "item_gc_multiple");
	SetParent(gc_break, cable);
	SetParent(gc_multiple, cable);
	Later(0.05, () => spawnGC1(indices[0], cable));
	Later(0.08, () => SetParent(gc_break, undefined));
	for (let it = 1; it < indices.length; it++)
	{
		Later(0.1 * it, () =>
		{
			const extra = spawnDelayGC1();
			Later(0.05, () => spawnGC1(indices[it], extra));
		});
	}
}

// Spawns groundcable at its original state (stage 1)
function spawnGC1(index, cable = FindByNameNearest("item_gc_prop1", V(472, -72, -808), 8))
{
	if (!cable?.IsValid())
		return;
	cable.Teleport({
		position: V(ITEM_GC_COORDX[index], ITEM_GC_COORDY[index], ITEM_GC_COORDZ[index]),
		angles: { pitch: 0, yaw: ITEM_GC_YAW[index], roll: 0 },
	});
