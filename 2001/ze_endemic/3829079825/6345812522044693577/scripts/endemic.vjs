// Finale
//============================================================================================

// Determine which ending to play
function chooseEnding()
{
	Fire("finale_end_linear", "Open");
	if (S.finale_good_ending)
		Later(5.0, endingGood);
	else
	{
		Later(5.0, endingBad);
		Fire("map_ending_fade", "Kill", "", 5.0);
	}
	Fire("sprite_end_template", "ForceSpawn", "", 5.0);
	Fire("nf_sprite", "Kill", "", 5.5);
	Fire("finale_tp", "Enable", "", 5.5);
	Later(6.0, endingZMHPRatio);
	Fire("finale_start_linear", "Open", "", 7.0);
	Later(7.0, () => { S.finale_in_progress = true; });
}

// Links related triggers to good ending area
function endingGood()
{
	Fire("finale_human_good_tp", "Enable");
	Fire("finale_tp", "KeyValue", "target dest_f_good");
	Fire("tp_spawn_postmz", "KeyValue", "target dest_f_good");
	ServerCmd("sv_disable_radar 1");
	Later(3.0, endingZMSetGlow);
}

// Teleport players to good ending area
function endingGoodTP(activator)
{
	if (!activator?.IsValid())
		return;
	const current = activator.GetAbsOrigin();
	activator.Teleport({ position: V(current.x - 960, current.y, current.z) });
}

// Teleport players to bad ending area
function endingBad()
{
	Fire("finale_human_bad_tp", "Enable");
	Fire("finale_tp", "KeyValue", "target dest_f_bad");
	Fire("tp_spawn_postmz", "KeyValue", "target dest_f_bad");
	if (S.finale_petty_mode)
		Later(3.0, endingZMSetGlow);
}

function endingBadTP(activator)
{
	if (!activator?.IsValid())
		return;
	const current = activator.GetAbsOrigin();
	activator.Teleport({ position: V(current.x - 960, current.y, current.z - 480) });
}

// Calculates the HP of zombies according to the humans alive and zombies present
function endingZMHPRatio()
{
	if (S.finale_zm_count < 1)
		return;// If for whatever reason no ZM are detected, use the base HP value
	const ratio = S.finale_human_count / S.finale_zm_count;
	if (ratio < 0.5)
		S.finale_zm_hp = S.finale_zm_hp * Math.pow(ratio, 0.75);
	else if (ratio > 2)
		S.finale_zm_hp = S.finale_zm_hp * Math.pow(ratio, 1.25);
	else
		S.finale_zm_hp = S.finale_zm_hp * ratio;
}

// Limits zombie health in finale and activate no HP regen
function endingZMLimitHP(activator)
{
	if (!activator?.IsValid())
		return;
	if (!S.finale_in_progress)
	{// Quick method; zombies less than 2500 HP likely already have no HP regen
		Later(0.0, () => removeFTP(activator));
		if (activator.GetHealth() > PERISHED_HP)
			Later(0.5, () => noZmHpRegen(activator, 0.5));
	}
	else
		Later(0.0, () => noZmHpRegen(activator, 0.5));
	// PORT: SetHealth в Squirrel обрезал float; меньше 1 HP не ставим
	let MAX_HEALTH = Math.max(1, ToInt(S.finale_zm_hp))
	activator.SetHealth(MAX_HEALTH);
	activator.SetMaxHealth(MAX_HEALTH);
}

// Creates a glow around ALL zombies in good ending; goes through each ZM with finale_zm_tick interval
function endingZMSetGlow()
{
	let it = 0;
	for (const plyer of AllPawns())
	{
		if (plyer.GetTeamNumber() === 2)
		{
			Later((FINALE_ZM_TICK * it) + 0.05, () => endingZMGlow(plyer));
			it++;
		}
	}
}

// Creates a glow around the specified player
// PORT: ForceSpawn шаблона перенесён внутрь
function endingZMGlow(activator)
{
	if (S.finale_in_progress)
	{
		// Stop if the zombie is dead
		if (!activator?.IsValid() || activator.GetHealth() < 1)
			return;
		const prop = spawnFtpGlow();
		if (!prop)
			return;
		if (RandomInt(0, 1) === 1)
			FireT(prop, "SetAnimationLooping", "Idle_lower", 0.0);// Toggle between crouch and standing animations
		prop.Teleport({ position: activator.GetAbsOrigin(), angles: activator.GetAbsAngles() });
		Later(FINALE_ZM_TICK, () => Glow(prop, GLOW_RED));
		// PORT: при finale_zm_count == 0 оригинал крутил это каждый кадр — минимум один тик
		const period = Math.max(FINALE_ZM_TICK, S.finale_zm_count * FINALE_ZM_TICK);
		FireT(prop, "Kill", "", period + 0.1);
		Later(period, () => endingZMGlow(activator));
	}
}

// Prints in chat about anti camping
function endingAntiCamp()
{
	if (!S.finale_door_closing)
	{
		Fire("finale_anticamp", "Enable");
		Say("⠀\x02 [ CONSOLE ]\x01 Humans are taking too long to reach the end! Enabling anti-camp measures...");
	}
}

// Detect if there are any zombies in the very end area
function zmDetect()
{
	if (S.finale_end_zm_count > 0)
	{// Repeat until all zombies has died
		Later(1.0, zmDetect);
		return;
	}
	if (S.finale_good_ending)
		Later(0.0, endingApproach);// CT's won good ending!
	else
	{
		if (S.admin_abuse)
		{
			for (let i = 0; i < 5; i++)
				Say("⠀\x02 [ CONSOLE ]\x01 Admin room was triggered");
		}
		Say("⠀\x02 [ CONSOLE ]\x01 You have won\x02 BAD ENDING\x01!");
		Say("⠀\x02 [ CONSOLE ]\x01 Thanks for playing!");
		Fire("map_round", "FireWinCondition", "8", 5.0);// CT's won!
		LEVEL = 3;// map_level_counter SetValueNoFire 3
	}
}

// Print in chat to kill all zombies in the very final area
function zmDetectChat()
{
	if (S.finale_end_zm_count > 0)
		Say("⠀\x02 [ CONSOLE ]\x01 Kill all zombies in the room!");
}

