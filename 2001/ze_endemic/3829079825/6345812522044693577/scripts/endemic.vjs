// Ending cutscene with city skyline
function endingApproach()
{
	// Fading effects
	S.fade.duration = 1;
	S.fade.reverse = 1;
	S.fade.holdtime = 1;
	Later(2.0, () => { S.fade.holdtime = 0; });
	MapFade();
	Later(2.0, MapFadeReverse);
	Later(8.0, MapFade);
	// Camera
	Later(2.0, () => CameraEnable("outro_camera1"));
	Later(9.0, () => CameraDisable("outro_camera1"));
	// sfx
	Fire("outro_ambient1", "StartSound", "", 2.0);
	// Helicopter linear
	Fire("outro_linear1", "Open", "", 2.0);
	// Text
	Later(2.0, () => OutroText("hud_outro_text", 1, 12));
	// Landing sequence
	Later(9.0, endingLand);
}

// Ending cutscene with heli landing
function endingLand()
{
	// Landing details
	Fire("outro_linear2", "Open");
	Fire("outro_linear2", "SetSpeed", "80");
	Fire("outro_linear2", "SetSpeed", "60", 1.0);
	Fire("outro_linear2", "SetSpeed", "45", 2.0);
	Fire("outro_linear2", "SetSpeed", "35", 3.0);
	Fire("outro_linear2", "SetSpeed", "28", 4.0);
	Fire("outro_linear2", "SetSpeed", "22", 5.0);
	Fire("outro_linear2", "SetSpeed", "18", 6.0);
	// Fade
	MapFadeReverse();
	Later(5.0, () => { S.fade.holdtime = 60; });
	Later(6.0, MapFade);
	// Camera
	CameraEnable("outro_camera2");
	Later(7.0, () => CameraDisable("outro_camera2"));
	// Text
	OutroText("hud_outro_text2", 1, 5);
	// sfx
	Fire("outro_ambient2", "StartSound");
	for (let i = 0; i < 5; i++)
		Later(1.5, () => soundPlayManual(16, 0, -14, -280, -1848));
	// Particle
	Fire("outro_particle", "Start");
	// End round
	Later(7.0, goodEndingChat);
	Fire("map_round", "FireWinCondition", "10", 13.0);// CT's won true ending!
	Later(8.0, () => { LEVEL = 3; });
}

function goodEndingChat()
{
	if (S.admin_abuse)
	{
		for (let i = 0; i < 5; i++)
			Say("⠀\x02 [ CONSOLE ]\x01 Admin room was triggered");
	}
	Say("⠀\x02 [ CONSOLE ]\x01 You have won\x04 GOOD ENDING\x01!");
	Say("⠀\x02 [ CONSOLE ]\x01 Thanks for playing!");
}

