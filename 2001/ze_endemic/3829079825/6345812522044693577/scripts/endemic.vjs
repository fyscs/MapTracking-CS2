// Templates stage 1 groundcable with a delay
function spawnDelayGC1()
{
	return SpawnOne("item_gc_template1", "item_gc_prop1");
}

// Detects if a player jumps onto the covers
function gcJump(activator)
{
	if (!activator?.IsValid())
		return;
	if (activator.GetAbsVelocity().z < -200)
		S.item_gc_jumps++;
	if (S.item_gc_jumps === ITEM_GC_MAX_JUMPS)
	{
		Fire("item_gc_template2", "ForceSpawn");
		Later(0.02, spawnGC2);
		const vel = activator.GetAbsVelocity();
		activator.Teleport({ velocity: V(vel.x, vel.y, 0) });
	}
}

// Spawns groundcable at its semi-broken state (stage 2)
function spawnGC2()
{
	const i0 = S.item_gc_indices[0];
	const newcable = FindByNameNearest("item_gc_prop2", V(472, -40, -808), 8);
	const oldcable = FindByNameNearest("item_gc_prop1", V(ITEM_GC_COORDX[i0], ITEM_GC_COORDY[i0], ITEM_GC_COORDZ[i0]), 1);
	if (!newcable || !oldcable)
		return;
	newcable.Teleport({ position: oldcable.GetAbsOrigin(), angles: { pitch: 0, yaw: oldcable.GetAbsAngles().yaw, roll: 0 } });
	FireT(oldcable, "Kill", "", 0.0);
	for (const b of Instance.FindEntitiesByName("item_gc_break"))
		b.SetHealth(ITEM_GC_HEALTH);// change hp of the breakable
}

