import { Instance, CSDamageTypes, CSDamageFlags, CustomCameraMode } from "cs_script/point_script";

/* ze_endemic — порт endemic_script.nut (lameskydiver/chinny, release v1_3, 17.11.2022) на cs_script.
 *
 * Script ported by waffel and claude
 * KOEN WAS HERE :D
 * Last updated: 03.11.2026
 *
 * Логика, тайминги и тексты перенесены 1 в 1. Отличия порта помечены комментарием "PORT:".
 *
 * Как устроено:
 *  - Карта вызывает скрипт через   Map_Script > RunScriptInput > <та же строка, что была в RunScriptCode>
 *    (например "openLinear(10,144)", "zm_spawn_b1 <- 1", "finale_zm_count++"). Все строки из VMF
 *    перечислены в MAP_INPUTS внизу файла и регистрируются через OnScriptInput.
 *  - EntFireByHandle(self, "RunScriptCode", ..., delay) → Later(delay, fn): EntFire RunScriptInput "__later"
 *    на сам Map_Script с тем же delay. Очередь I/O чистится на рестарте раунда, так что на следующий раунд
 *    ничего не переносится.
 *  - В CS:GO logic_script пересоздавался каждый раунд и все "x <- 0" сбрасывались сами. point_script живёт
 *    между раундами, поэтому всё состояние раунда лежит в S и пересоздаётся в NewState() на рестарте.
 *  - map_level_counter (трюк с classname info_target) → глобальная LEVEL, она переживает рестарты.
 *  - game_text / ScriptPrintMessageCenterAll → custom_hud_layout (Map_Hud). env_fade с AddOutput-параметрами → отдельные env_fade.
 *  - point_viewcontrol_multiplayer → CustomPlayerCamera (CONTROLLED).
 *  - ScriptPrintMessageChatAll → say (с цветами).
 */

//============================================================================================
// Настройки
//============================================================================================

const SCRIPT_NAME = "Map_Script";      //point_script
const HUD_NAME = "Map_Hud";            //custom_hud_layout
const DEBUG = false;                   //EntFire("debug", "Command", "echo ...") → Instance.Msg

