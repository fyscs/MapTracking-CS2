	S.trig_add_delay = S.trig_add_delay + RandomInt(1, 3);
	Debug("Debug (TM break): triggers take extra " + S.trig_add_delay + " s now");
	itemsText();
	// Make path alpha minigame harder
	S.a_mg_hackduration = S.a_mg_hackduration - 0.20;
	S.a_mg_totduration = S.a_mg_totduration - 6;
	Debug("Debug (TM break): setting a_mg_hackduration to " + S.a_mg_hackduration);
	Debug("Debug (TM break): setting a_mg_totduration to " + S.a_mg_totduration);
}

//* Reports *//

// Chooses locations to spawn reports, and spawns them
function itemsRP()
{
	for (let it = 0; it < S.item_rp_coords_indices.length; it++)
	{
		const coords_index = S.item_rp_coords_indices[it];
		// Always spawn reports for all three paths; afterwards spawn whatever is needed
		const report_index = it < 3 ? it : S.item_rp_indices[it - 3];
		Later(0.1 * it, () =>
		{
			const ents = itemsRPSpawn();
			Later(0.05, () => allocateReport(report_index, coords_index, ents));
		});
	}
}

// Separate function to spawn in reports with delays
function itemsRPSpawn()
{
	return Spawn("item_rp_template");
}

// Allocates different I/O depending on what report it is
// Inputs: index_report - index to indicate which report it is
//       index_coords - index to indicate which coordinates to spawn at
function allocateReport(index_report, index_coords, ents)
{
	const report = Pick(ents, "item_rp_prop") ?? FindByNameNearest("item_rp_prop", V(392, -296, -816), 8);
	const button = Pick(ents, "item_rp_button") ?? FindByNameNearest("item_rp_button", V(392, -296, -816), 8);
	if (!report)
		return;
	report.SetEntityName("item_rp_prop" + index_report);
	button?.SetEntityName("item_rp_button" + index_report);
	Later(0.02, () =>
	{
		SetParent(button, report);
		FireT(report, "Skin", String(index_report), 0.0);
	});
	const pm = ITEM_RP_COORD_PM[index_coords];
	const pos = V(ITEM_RP_COORDX[index_coords] + RandomInt(-pm, pm), ITEM_RP_COORDY[index_coords] + RandomInt(-pm, pm), ITEM_RP_COORDZ[index_coords]);
	const yaw = ITEM_RP_YAW[index_coords] + RandomInt(-ITEM_RP_YAW_PM, ITEM_RP_YAW_PM);
	Later(0.04, () =>
	{
		if (report.IsValid())
			report.Teleport({ position: pos, angles: { pitch: 0, yaw, roll: 0 } });
	});
}

// When the report has been triggered, fire the corresponding output
function triggerReport(caller)
{
	Say(ITEM_RP_TRIGGER_CHAT[RandomInt(0, 5)]);
	if (!caller?.IsValid())
		return;
	const index = parseInt(caller.GetEntityName().slice(14), 10);
	Fire("item_rp_prop" + index, "Kill");
	Later(4.0, () => triggerReportChat(index));
}

// Displays which report was picked up
function triggerReportChat(index)
{
	Say(ITEM_RP_CHAT[index]);
	switch (index)
	{
		case 0:
		{// Make path alpha minigame easier
			S.a_mg_totduration = S.a_mg_totduration + 5;
			S.a_mg_hackduration = S.a_mg_hackduration + 0.15;
			Debug("Debug (RP trig): setting a_mg_totduration to " + S.a_mg_totduration);
			Debug("Debug (RP trig): setting a_mg_hackduration to " + S.a_mg_hackduration);
			return;
		}
		case 1:
		{// Make path beta minigame shorter
			S.b_mg_wait_time = S.b_mg_wait_time - 7;
			Debug("Debug (RP trig): setting b_mg_wait_time to " + S.b_mg_wait_time);
			return;
		}
		case 2:
		{// Make path charlie minigame easier
			S.c_mg_max_options = S.c_mg_max_options - 2;
			S.c_mg_wait = S.c_mg_wait - 1;
			Debug("Debug (RP trig): setting c_mg_max_options to " + S.c_mg_max_options);
			Debug("Debug (RP trig): setting c_mg_wait to " + S.c_mg_wait);
			return;
		}
		default: return;
	}
}

// Introduce to players the reports in the map
function introduceRP()
{
	if (S.item_rp_explain_in_progress === 1 || S.item_rp_it === 2)
		return;
	S.item_rp_explain_in_progress = 1;
	Say(ITEM_RP_EXPLAIN[S.item_rp_it]);
	S.item_rp_it++;
	Later(3.98, () => { S.item_rp_explain_in_progress = 0; });
	Later(4.0, introduceRP);
}

//* Walkie Talkie *//

// Spawns walkie talkies in the platform
function itemsWT()
{
	for (let it = 0; it < ITEM_WT_MAX; it++)
	{
		Later(0.1 * it, () =>
		{
			const wt = itemsWTSpawn();
			Later(0.05, () => itemsWTMove(wt));
		});
	}
}

// Fires walkie talkie template with delay
function itemsWTSpawn()
{
	return SpawnOne("item_wt_template", "item_wt");
}

// Moves walkie talkie to defined coordinates
function itemsWTMove(wt = FindByNameNearest("item_wt", V(392, -392, -808), 8))
{
	if (!wt?.IsValid())
		return;
	const index = RandomInt(0, ITEM_WT_COORDX.length - 1);
	SetParent(entityFinder("item_wt_button"), wt);
	const pos = V(ITEM_WT_COORDX[index] + RandomInt(-ITEM_WT_X_PM, ITEM_WT_X_PM), ITEM_WT_COORDY[index] + RandomInt(-ITEM_WT_Y_PM, ITEM_WT_Y_PM), ITEM_WT_HEIGHT);
	const yaw = RandomInt(0, 359);
	Later(0.1, () =>
	{
		if (wt.IsValid())
			wt.Teleport({ position: pos });
	});
	Later(0.2, () =>
	{
		if (wt.IsValid())
			wt.Teleport({ angles: { pitch: -90, yaw, roll: 0 } });
	});
	Later(2.0, itemsWTBuzz);
}

// Give audible clue to the location of walkie talkie
function itemsWTBuzz()
{
	if (!S.item_wt_enabled)
	{
		const wt = entityFinder("item_wt");
		const index = RandomInt(16, 17);
		Later(0.0, () => soundPlay(index, 0, wt));
		Later(RandomInt(13, 17), itemsWTBuzz);// Repeat again after some time
	}
}

// When the walkie talkie is picked up
function itemsWTPicked()
{
	ServerCmd("sv_disable_radar 0", 2.0);
	S.item_wt_enabled = true;
	if (!S.sp_end_area)
		S.item_wt_was_first = true;
	Later(2.0, itemsWTPickedChat);
	spIntroEnd();
	// Play sound
	const wt = entityFinder("item_wt");
	if (!wt?.IsValid())
		return;
	const sound = FindByNameNearest("map_sfx", wt.GetAbsOrigin(), 1);// Kill any sound that is currently playing from the walkie talkie
	if (sound)
		FireT(sound, "Kill", "", 0.5);
	Later(0.0, () => soundPlay(18, 0, wt));
}

// Corresponding chatting function to itemsWTPicked()
function itemsWTPickedChat()
{
	if (S.item_wt_chat_it === ITEM_WT_CHAT.length)
		return;
	if (S.item_wt_chat_it === 2)
	{
		if (S.item_wt_chat_it === 2 && S.sp_end_area === true)
		{
			Say(ITEM_WT_CHAT[S.item_wt_chat_it]);
			return;
		}
		else
			S.item_wt_chat_it = 3;
	}
	Say(ITEM_WT_CHAT[S.item_wt_chat_it]);
	S.item_wt_chat_it++;
	Later(4.0, itemsWTPickedChat);
}

//============================================================================================
// Zombie Spawning
//============================================================================================

//* Mother Zombie *//

// Detects if there are MZ in the map
function detectMZ()
{
	S.zm_mz_checking = true;
	if (!S.zm_mz_found)
	{
		for (const plyer of AllPawns())
		{
			if (plyer.GetTeamNumber() === 2)
			{
				if (plyer.GetHealth() < ZM_MZ_HP)
				{// if a terrorist has non zombie-like hp (i.e. mz has not fired yet) then repeat the code again
					Later(0.5, detectMZ);
					return;
				}
				else
				{// Detect terrorist team with zombie-like hp
					Later(1.0, spInitiate);
					Debug("Debug (MZ): MZ has been detected");
					// TP zombies away in case they spawn in with the humans
					Fire("tp_spawn_t", "KeyValue", "target dest_spwait");
					Fire("tp_sp_zm_failsafe", "Enable", "", 0.1);
					Fire("tp_sp_zm_failsafe", "Kill", "", 5.5);
					Fire("spawn_premz_multiple", "Kill", "", 6.0);// Disable context removal trigger in spawn
					Fire("spawn_postmz_multiple", "Enable", "", 6.0);// Enable 'zombified' context trigger in spawn
					Fire("tp_spawn_failsafe", "Enable", "", 12.0);// Enable failsafe teleport in spawn
					SpriteShow("spawn_failsafe_sprite", 12.0);// Enable failsafe sprite in spawn
					Fire("map_perished_timer", "Enable", "", 7.0);// Enable delayed infections for later zombies
					Fire("map_spawn_timer", "Enable", "", 6.0);
					S.zm_mz_checking = false;
					S.zm_mz_found = true;
					return;
				}
			}
		}
		if (!S.zm_mz_found)
		{// if no mz was detected (i.e. all were CT) then repeat the code again
			Later(0.5, detectMZ);
		}
	}
}

// Checks if detectMZ() is running; fail-safe in case detectMZ() fails to detect a valid MZ and quits prematurely
function checkDetectMZ()
{
	if (S.zm_mz_found)
	{
		Debug("Debug (MZ): MZ was found successfully. Ending MZ failsafe");
		return;
	}
	if (S.zm_mz_checking && !S.zm_mz_found)
	{
		Debug("Debug (MZ): Map is still searching for MZ");
		Later(1.0, checkDetectMZ);
		return;
	}
	Debug("Debug (MZ): MZ search has failed. Enabling failsafe mechanism");
	Later(0.0, detectMZ);// Rerun the MZ check
	Later(1.0, checkDetectMZ);// Continue with the failsafe
}

//* Infected *//

// As a player gets infected, put a timeout before they can infect others
function perished(activator)
{
	if (!activator?.IsValid())
		return;
	// Choose sfx to play
	const index = RandomInt(0, 4);
	Later(0.0, () => soundPlay(index, 0, activator));
	const origin = activator.GetAbsOrigin();
	const particle = Pick(SpawnFromMaker("zm_perished_maker", origin, { pitch: 0, yaw: 0, roll: 0 }), "zm_perished_particle")
		?? FindByClassnameNearest("info_particle_system", origin, 1);
	Later(0.02, () =>
	{
		if (activator.IsValid())
			activator.Teleport({ position: PERISHED_TP });
	});
	FireT(activator, "AddContext", "zombified:1", 0.0);
	Later(5.0, () =>
	{
		if (activator.IsValid())
			activator.Teleport({ position: origin });
	});
	// Stupid workaround for zombies killing themselves to get full hp and teleport to the same spot (good job pegi)
	// Disable HP regen + set HP to perished_hp
	Later(5.0, () =>
	{
		if (activator.IsValid())
			activator.SetHealth(PERISHED_HP);
	});
	Later(5.0, () =>
	{
		if (activator.IsValid())
			activator.SetMaxHealth(PERISHED_HP);
	});

	Later(0.05, () => noZmHpRegen(activator, 0.5));
	FireT(particle, "Kill", "", 10.0);
}

// Prints game_text to let know first infection / perished mechanism
function perishedText()
{
	Later(0.02, () => ZmText("MsgPerished"));
}

//* AFK TP *//

// Moves zombie AFK TP to desired postition
// Inputs: area - in which area the spawn is
function enableAFKTP(area)
{
	if (area === 0)
	{
		Fire("tp_zm_spawn_sp", "Enable", "", 1.0);
		SpriteShow("zm_spawn_sp_sprite");
		if (S.zm_spawn_sp1 == 1)
		{
			openZMDoors("zm_sp_spawn1");
			openZMDoors("zm_sp_spawn2");
			Fire("tp_zm_spawn_sp", "KeyValue", "target dest_zm_sp1", 1.0);
		}
		if (S.zm_spawn_sp2 == 1)
		{
			openZMDoors("zm_sp_spawn3");
			openZMDoors("zm_sp_spawn4");
			Fire("tp_zm_spawn_sp", "KeyValue", "target dest_zm_sp2", 1.0);
		}
		if (S.zm_spawn_sp1 == 1 && S.zm_spawn_sp2 == 1)
			Fire("tp_zm_spawn_sp", "KeyValue", "target dest_zm_sp*", 1.0);
		if (S.zm_spawn_sp3 == 1)
		{
			openZMDoors("zm_sp_spawn5");
			openZMDoors("zm_sp_spawn6");
			Fire("tp_zm_spawn_sp", "KeyValue", "target dest_zm_up_sp", 1.0);
		}
		return;
	}
	Fire("tp_zm_spawn_sp", "Kill");
	Fire("zm_spawn_sp_sprite", "Kill");
	if (area === 1)
	{
		Fire("tp_zm_spawn_a", "Enable", "", 1.0);
		SpriteShow("zm_spawn_a_sprite");
		if (S.zm_spawn_a1 == 1)
		{
			openZMDoors("zm_a_spawn1");
			openZMDoors("zm_a_spawn2");
			Fire("tp_zm_spawn_a", "KeyValue", "target dest_zm_a1", 1.0);
		}
		if (S.zm_spawn_a2 == 1)
		{
			openZMDoors("zm_a_spawn3");
			openZMDoors("zm_a_spawn4");
			Fire("tp_zm_spawn_a", "KeyValue", "target dest_zm_a2", 1.0);
		}
		if (S.zm_spawn_a_tw1 == 1)
		{
			openZMDoors("zm_a_spawn5");
			openZMDoors("zm_a_spawn6");
			Fire("tp_zm_spawn_a", "KeyValue", "target dest_zm_a_tw1", 1.0);
		}
		if (S.zm_spawn_a_tw2 == 1)
		{
			openZMDoors("zm_a_spawn7");
			openZMDoors("zm_a_spawn8");
			Fire("tp_zm_spawn_a", "KeyValue", "target dest_zm_a_tw2", 1.0);
		}
		if (S.zm_spawn_a_tw1 == 1 && S.zm_spawn_a_tw2 == 1)
			Fire("tp_zm_spawn_a", "KeyValue", "target dest_zm_a_tw*", 1.0);
		return;
	}
	if (area === 2)
	{
		Fire("tp_zm_spawn_b", "Enable", "", 1.0);
		SpriteShow("zm_spawn_b_sprite");
		if (S.zm_spawn_b1 == 1)
		{
			openZMDoors("zm_b_spawn1");
			openZMDoors("zm_b_spawn2");
			Fire("tp_zm_spawn_b", "KeyValue", "target dest_zm_b1", 1.0);
		}
		if (S.zm_spawn_b_gr1 == 1)
		{
			openZMDoors("zm_b_spawn3");
			Fire("tp_zm_spawn_b", "KeyValue", "target dest_zm_b_gr1", 1.0);
		}
		if (S.zm_spawn_b_gr2 == 1)
		{
			openZMDoors("zm_b_spawn4");
			openZMDoors("zm_b_spawn5");
			Fire("tp_zm_spawn_b", "KeyValue", "target dest_zm_b_gr2", 1.0);
		}
		if (S.zm_spawn_b_gr1 == 1 && S.zm_spawn_b_gr2 == 1)
			Fire("tp_zm_spawn_b", "KeyValue", "target dest_zm_b_gr*", 1.0);
		return;
	}
	if (area === 3)
	{
		Fire("tp_zm_spawn_c", "Enable", "", 1.0);
		SpriteShow("zm_spawn_c_sprite");
		if (S.zm_spawn_c1 == 1)
		{
			openZMDoors("zm_c_spawn1");
			openZMDoors("zm_c_spawn2");
			Fire("tp_zm_spawn_c", "KeyValue", "target dest_zm_c1", 1.0);
		}
		if (S.zm_spawn_c_sv1 == 1)
		{
			openZMDoors("zm_c_spawn3");
			openZMDoors("zm_c_spawn4");
			Fire("tp_zm_spawn_c", "KeyValue", "target dest_zm_c_sv1", 1.0);
		}
		if (S.zm_spawn_c_sv2 == 1)
		{
			openZMDoors("zm_c_spawn5");
			Fire("tp_zm_spawn_c", "KeyValue", "target dest_zm_c_sv2", 1.0);
		}
		if (S.zm_spawn_c_sv1 == 1 && S.zm_spawn_c_sv2 == 1)
			Fire("tp_zm_spawn_c", "KeyValue", "target dest_zm_c_sv*", 1.0);
		return;
	}
	Fire("tp_zm_spawn_a", "Kill");
	Fire("zm_spawn_a_sprite", "Kill");
	Fire("tp_zm_spawn_b", "Kill");
	Fire("zm_spawn_b_sprite", "Kill");
	Fire("tp_zm_spawn_c", "Kill");
	Fire("zm_spawn_c_sprite", "Kill");
	Fire("tp_zm_spawn_nf", "Enable");
	SpriteShow("zm_spawn_nf_sprite");
	Fire("tp_zm_spawn_nf", "KeyValue", "target dest_zm_nf*");
}

// Opens the door for ZM spawning room
// Inputs: name - name of the door in string
function openZMDoors(name)
{
	const rotate = entityFinder(name);
	if (!rotate?.IsValid())
		return;
	if (name === "zm_b_spawn3")
	{
		Fire(name, "Open");
		return;
	}
	else
	{
		Fire(name, "Start");
		Fire(name, "Stop", "", 1.0);
	}
	// Clear the parent on doors and kill the func_rotating
	const door = FindByClassnameNearest("prop_dynamic", rotate.GetAbsOrigin(), 90);
	FireT(door, "ClearParent", "", 1.0);
	Fire(name, "Kill", "", 1.5);
}

//* Forward Spawns *//

// Teleports a zombie at designated forward spawn coords
function forwardTP(activator)
{
	if (!activator?.IsValid())
		return;
	// Creates an array to choose which area to spawn
	const choices = [];
	if (S.zm_fsp_min < S.zm_fsp_max)
		choices.push(0);
	if (S.zm_fa_min < S.zm_fa_max)
		choices.push(1);
	if (S.zm_fb_min < S.zm_fb_max)
		choices.push(2);
	if (S.zm_fc_min < S.zm_fc_max)
		choices.push(3);
	if (S.zm_fnf_min < S.zm_fnf_max)
		choices.push(4);
	if (choices.length === 0)
	{// back-up exit in case the function is called when it shouldn't be
		checkFTP();
		return;
	}
	const index = choices[RandomInt(0, choices.length - 1)];// Choose a random area
	let coords = null;
	switch (index)
	{
		case 0: coords = ZM_FSP_COORDS[S.zm_fsp_min]; S.zm_fsp_min++; break;// Only allow one player per tp coord
		case 1: coords = ZM_FA_COORDS[S.zm_fa_min]; S.zm_fa_min++; break;
		case 2: coords = ZM_FB_COORDS[S.zm_fb_min]; S.zm_fb_min++; break;
		case 3: coords = ZM_FC_COORDS[S.zm_fc_min]; S.zm_fc_min++; break;
		case 4: coords = ZM_FNF_COORDS[S.zm_fnf_min]; S.zm_fnf_min++; break;
	}
	if (coords)
		activator.Teleport({ position: ParseVec(coords) });
	// Enables ZM disadvantages
	activator.SetHealth(750);
	activator.SetMaxHealth(750);
	Later(0.0, () => noZmHpRegen(activator, 0.5));
	// Creates glow around zombie every 1.5s
	Later(0.5, () => alertFTP(activator));
	// PORT: map_ftp_text Display здесь шёл без activator (ни у кого не показывался), map_ftp_text2 не существует.
	//     Текст показывает карта: tp_zm_spawn_ft OnEndTouch → RunScriptInput hudFtp
	// Save the player handle to the list
	S.zm_ftp_list.push(activator);
	checkFTP();// Updates the FTP list and removes the coords
}

// Checks if foward TP should be enabled; i.e. if there are valid coords to tp to
function checkFTP()
{
	if ((S.zm_fsp_min < S.zm_fsp_max) || (S.zm_fa_min < S.zm_fa_max) || (S.zm_fb_min < S.zm_fb_max) || (S.zm_fc_min < S.zm_fc_max) || (S.zm_fnf_min < S.zm_fnf_max))
	{// Enable TP if there are valid coords
		Fire("tp_zm_spawn_ft", "Enable");
		SpriteShow("zm_spawn_ft_sprite");
	}
	else
	{// Don't if there aren't
		Fire("tp_zm_spawn_ft", "Disable");
		SpriteHide("zm_spawn_ft_sprite");
	}
}

// Adds valid forward TP points; essentially gives bigger range of indices to zm_f<area>_coords
function addFTP(min_index, max_index, area)
{
	switch (area)
	{
		case 0: S.zm_fsp_min = min_index; S.zm_fsp_max = max_index; break;
		case 1: S.zm_fa_min = min_index; S.zm_fa_max = max_index; break;
		case 2: S.zm_fb_min = min_index; S.zm_fb_max = max_index; break;
		case 3: S.zm_fc_min = min_index; S.zm_fc_max = max_index; break;
		case 4: S.zm_fnf_min = min_index; S.zm_fnf_max = max_index; break;
	}
	Later(0.1, checkFTP);
}

// Separate addFTP() function for near-finale area; Prevents FTP at the elevators if the gate is triggered by humans
function addFTPNF()
{
	if (!S.trig_humans_at_finale)
		addFTP(0, 2, 4);
}

// zm_ftp_template ForceSpawn → zm_ftp_glow
function spawnFtpGlow()
{
	return SpawnOne("zm_ftp_template", "zm_ftp_glow") ?? FindByNameNearest("zm_ftp_glow", ZM_FTP_GLOW_TEMPLATE_POS, 16);
}

// Creates glow around zombie every 5s
// PORT: ForceSpawn шаблона перенесён внутрь (в оригинале — за 0.02 с до вызова)
function alertFTP(activator)
{
	if (detectFTP(activator))
		return;
	// Stop if the zombie is dead
	if (!activator?.IsValid() || activator.GetHealth() < 1)
	{
		Later(0.0, () => removeFTP(activator));
		return;
	}
	const prop = spawnFtpGlow();
	if (!prop)
		return;
	if (RandomInt(0, 1) === 1)
		FireT(prop, "SetAnimationLooping", "Idle_lower", 0.0);// Toggle between crouch and standing animations
	prop.Teleport({ position: activator.GetAbsOrigin(), angles: activator.GetAbsAngles() });
	Later(0.1, () => Glow(prop, GLOW_RED));
	FireT(prop, "Kill", "", 5.1);
	Later(5.0, () => alertFTP(activator));
}

// Checks if the zombie is still valid for FTP glow, and returns bool to quit the function
function detectFTP(handle)
{
	return !S.zm_ftp_list.includes(handle);
}

// Failsafe; Removes glow around forward spawned zombies when they spawned after they die
function removeFTP(activator)
{
	if (!activator)
		return;
	const it = S.zm_ftp_list.indexOf(activator);
	if (it >= 0)
		S.zm_ftp_list.splice(it, 1);
}

// Prints game_text to let know forward spawn mechanism
function textFTP()
{
	Later(0.02, () => ZmText("MsgFtp"));
}

//* HP Regen *//

// Disables HP Regen by comparing the HP in the previous tick; ensures HP is always decreasing
function noZmHpRegen(activator, prev_hp)
{
	if (!activator?.IsValid())
		return;
	let current_hp = activator.GetHealth();
	if (current_hp < 1 || activator.GetTeamNumber() !== 2)
		return;// quit if the player is dead or not a terrorist anymore
	if (prev_hp === 0.5)
		prev_hp = current_hp;// change prev_hp to current health when initiated
	if (prev_hp < current_hp)
		current_hp = prev_hp;
	activator.SetHealth(current_hp);
	Later(ZM_HP_REGEN_TICK, () => noZmHpRegen(activator, current_hp));
}

//============================================================================================
// Triggering
//============================================================================================

// Opens nearby func_movelinear, with a random variability to the given time (10% of time input)
function openLinear(time, radius, caller)
{
	if (!caller?.IsValid())
		return;
	const origin = caller.GetAbsOrigin();
	const movelinear = FindByClassnameNearest("func_movelinear", origin, radius);
	Later(0.0, () => soundPlay(18, 0, caller));
	const sprite = FindByClassnameNearest("info_particle_system", origin, radius);// env_sprite
	FireT(sprite, "Kill", "", 0.0);
	const delay = ToInt(time + RandomFloat(-time * 0.1, time * 0.1)) + S.trig_add_delay;
	FireT(movelinear, "Open", "", delay);
	// Display random chat message
	if (delay > 10)
	{
		Say(TRIG_CHAT_LONG[RandomInt(0, TRIG_CHAT_LONG.length - 1)]);
		Later(delay - 5, triggerFiveSeconds);
	}
	else
		Say(TRIG_CHAT[RandomInt(0, TRIG_CHAT.length - 1)]);
}

// Opens nearby prop_door_rotating, with a random variability to the given time (10% of time input)
function openDoor(time, radius, caller)
{
	if (!caller?.IsValid())
		return;
	const origin = caller.GetAbsOrigin();
	const door = FindByClassnameNearest("prop_door_rotating", origin, radius);
	Later(0.0, () => soundPlay(18, 0, caller));
	const sprite = FindByClassnameNearest("info_particle_system", origin, radius);// env_sprite
	FireT(sprite, "Kill", "", 0.0);
	const delay = ToInt(time + RandomFloat(-time * 0.1, time * 0.1)) + S.trig_add_delay;
	FireT(door, "Open", "", delay);
	// Display random chat message
	if (delay > 10)
	{
		Say(TRIG_CHAT_LONG[RandomInt(0, TRIG_CHAT_LONG.length - 1)]);
		Later(delay - 5, triggerFiveSeconds);
	}
	else
		Say(TRIG_CHAT[RandomInt(0, TRIG_CHAT.length - 1)]);
}

// Warn the players if a door/linear that took more than 10 seconds is about to trigger in 5 seconds
function triggerFiveSeconds()
{
	Say("⠀\x10 [ OPR ]\x01 About\x02 5 seconds\x01 more...");
}

// Detects if a zombie is interacting with the walkie-talkie, and prevent them from doing so
function detectZMTrigger(activator, caller)
{
	if (!activator?.IsValid() || activator.GetTeamNumber() === 2)
		return;// If zombie is triggering, ignore their commands
	FireT(caller, "FireUser1", "", 0.0);
}

// Detects if a zombie reached the finale area before the humans, and closes off the gates
function detectZMatFinale(activator, caller)
{
	if (S.trig_humans_at_finale || !activator?.IsValid())
		return;
	if (activator.GetTeamNumber() === 2)
		FireT(caller, "FireUser1", "", 0.0);
}

//============================================================================================
// Cinematics — Intro
//============================================================================================

// Starts the intro sequence
function startIntro()
{
	Later(1.0, () => CameraEnable("intro_camera"));
	MapFade();
	Later(2.0, introSequence);
	Later(3.0, () => musicPlay(0, 0));
	const cam_pos = CameraPos("intro_camera");
	Later(1.0, () => soundSpawn(9, 0, cam_pos));
	ServerCmd("sv_disable_radar 1", 1.0);
}

// Commands for each sequence
function introSequence()
{
	if (S.intro_sequence_it === INTRO_SEQUENCES)
	{
		ServerCmd("sv_disable_radar 0");
		CameraDisable("intro_camera");
		S.fade.duration = 0;
		S.fade.holdtime = 60;
		MapFadeReverse();
		S.midfade_killed = true;
		Fire("map_intro_midfade", "Kill");
		Fire("map_intro_midfade_rev", "Kill");
		LEVEL = 2;// map_level_counter SetValueNoFire 2
		Fire("map_round", "FireWinCondition", "10", 7.0);
		return;
	}
	// Starts the intro sequences on screen
	if (S.intro_sequence_it === 5)
	{
		Fire("intro_texture1", "Toggle");
		Fire("intro_texture1", "Toggle", "", 3.0);
	}
	if (S.intro_sequence_it === 10)
	{
		Fire("intro_texture2", "Toggle");
		Fire("intro_texture2", "Toggle", "", 4.0);
	}
	if (S.intro_sequence_it === 14)
	{
		const introLinear = Instance.FindEntityByName("intro_linear");
		for (let i = 0; i < 3; i++)
		{
			const ents = SpawnFromMaker("train_maker_cheap", V(INTRO_TRAIN_SPAWN_COORDS[i], INTRO_RAIL_COORDS, INTRO_RAIL_HEIGHT), { pitch: 0, yaw: 180, roll: 0 });
			SetParent(Pick(ents, "train_prop_cheap"), introLinear);
			// свет только у первого (головного) вагона — едет в сторону -x, первый тот, что на 592
			if (i === 0)
			{
				FireT(Pick(ents, "train_prop_cheap"), "Skin", "1");
				for (const e of ents)
					if (e?.IsValid() && e.GetEntityName().startsWith("train_light_cheap"))
						FireT(e, "Enable");
			}
		}
		Fire("intro_linear", "SetSpeed", "1200", 0.02);
		Fire("intro_linear", "Open", "", 0.04);
	}
	if (S.intro_sequence_it === 16)
	{
		Fire("intro_texture3", "Toggle");
		Fire("intro_texture3", "Toggle", "", 5.0);
	}
	Later(INTRO_SEQUENCE_TIME, moveMovelinear);
	S.intro_sequence_it++;
}

// Moves the func_movelinear; also sets fade between each sequence due to visual glitching
function moveMovelinear()
{
	// In case the movelinear somehow resets its properties
	Fire("intro_cinematics", "SetSpeed", "320");
	entityFinder("intro_cinematics")?.Teleport({ position: V(0, -864, 288) });
	Fire("intro_cinematics", "Open");
	// Fade between each sequence
	Later(0.85, MidFade);
	Later(1.0, MidFadeReverse);
	Fire("intro_texture_black", "Toggle", "", 0.9);
	Fire("intro_texture_black", "Toggle", "", 1.0);
	Later(0.0, introSequence);
}

//============================================================================================
// Subway Platform
//============================================================================================

// [0] - spawn a train at south platform, [1] - north platform, [2/3] - both platforms simultaneously

// Starts sequence of train approaching the platform
function platformApproach(index)
{
	let rail_coords = SP_RAIL_EAST_COORDS;
	let coord_index = 0;
	if (index === 1 || index === 3)
	{// If the train spawns at northern platform instead
		rail_coords = SP_RAIL_WEST_COORDS;
		coord_index = 4;
	}
	// Spawn in the train models
	for (let k = 0; k < 4; k++)
	{
		const x = SP_COORDS[coord_index + k];
		// свет только у головного вагона: он ближе всех к платформе (k = 0) с обеих сторон
		Later(0.0, () =>
		{
			const ents = spawnCheapTrain(x, rail_coords, SP_RAIL_HEIGHT, index);
			if (k === 0)
			{
				trainLightsOn(ents, "train_light_cheap");
				FireT(Pick(ents, "train_prop_cheap"), "Skin", "1");
			}
		});
	}
	// Attach to the existing movelinear
	for (let k = 0; k < 4; k++)
		Later(0.02, () => attachTrainStart(k, index));
	// Simulate train slowing down
	const linear = "sp_linear_" + SP_POSITIONS[index];
	Fire(linear, "SetSpeed", "600");
	Fire(linear, "SetSpeed", "500", 1);
	Fire(linear, "SetSpeed", "300", 3);
	Fire(linear, "SetSpeed", "150", 4.75);
	Fire(linear, "SetSpeed", "100", 6.5);
	Fire(linear, "SetSpeed", "50", 8);
	Fire(linear, "SetPosition", "0.823", 0.04);
	// Open platform doors when it arrives
	Later(9, () => platformDoorsOpen(index));
	if (index === 3)
		return;// Prevent ambient_generic being unkilled
	// Play sounds
	for (const tb of SP_AMBIENCE_TOP_BOTTOM_COORDS)
		for (const x of SP_AMBIENCE_COORDS)
			Later(0.0, () => soundPlayManual(11, 0, x, tb, SP_AMBIENCE_HEIGHT));
}

// Starts sequence of opening doors of the platform; also replaces to more detailed train props
function platformDoorsOpen(index)
{
	// Kill all cheap model trains at the platform
	Fire("train_prop_cheap", "KillHierarchy");
	// Replace with better versioned trains
	let rail_coords = SP_RAIL_EAST_COORDS;
	if (index === 1 || index === 3)
		rail_coords = SP_RAIL_WEST_COORDS;
	const doors_left = [];
	const doors_right = [];
	for (let k = 0; k < 4; k++)
	{
		for (const e of spawnTrain(SP_PARKED_COORDS[k], rail_coords, SP_RAIL_HEIGHT, index))
		{
			if (!e?.IsValid())
				continue;
			if (e.GetEntityName() === "train_prop_door_moveleft")
				doors_left.push(e);
			else if (e.GetEntityName() === "train_prop_door_moveright")
				doors_right.push(e);
		}
	}
	// Choose the doors to open
	const sp_door_index = indexChooser(1, 4, 5);
	if (index > 1)
	{// If the sequence is on both platforms, kill platform doors when trains arrive
		Fire("train_prop_door_moveleft", "Kill");
		Fire("train_prop_door_moveright", "Kill");
		Fire("sp_doors_bottom_left*", "Open", "", 1.0);
		Fire("sp_doors_bottom_right*", "Open", "", 1.0);
		Fire("sp_doors_top_left*", "Open", "", 1.0);
		Fire("sp_doors_top_right*", "Open", "", 1.0);
		// Enable teleports
		//Fire("tp_spawn_postmz", "KeyValue", "target dest_sp_*"); // CS2 doesn't support multi destination
		Fire("tp_spawn_postmz", "KeyValue", "target dest_spwait");
		Fire("tp_sp_bottom", "Disable");
		Fire("tp_sp_top", "Disable");
		//Fire("tp_sp_wait", "KeyValue", "target dest_sp_*"); // CS2 doesn't support multi destination
		Fire("tp_sp_wait", "Enable", "", 0.02);
		S.sp_end_area = true;
		if (index === 3)
			spIntroEnd();
	}
	else
	{// If not, simulate trains leaving the platform
		const pos = SP_POSITIONS[index];
		// Disable teleport at the trains
		//Fire("tp_spawn_postmz", "KeyValue", "target dest_sp_" + pos); // CS2 doesn't support multi destination
		Fire("tp_spawn_postmz", "KeyValue", "target dest_spwait");
		Fire("tp_sp_" + pos, "Disable");
		// Enable teleport at waiting room
		//Fire("tp_sp_wait", "KeyValue", "target dest_sp_" + pos);  // CS2 doesn't support multi destination
		Fire("tp_sp_wait" + pos, "Enable", "", 0.02);
		const linear_left = Instance.FindEntityByName("sp_doors_" + pos + "_left" + sp_door_index[0]);
		const linear_right = Instance.FindEntityByName("sp_doors_" + pos + "_right" + sp_door_index[2]);
		for (const d of doors_left)
			SetParent(d, linear_left);
		for (const d of doors_right)
			SetParent(d, linear_right);
		Fire("sp_doors_" + pos + "_left" + sp_door_index[0], "Open", "", 0.02);
		Fire("sp_doors_" + pos + "_left" + sp_door_index[1], "Open", "", 0.02);
		Fire("sp_doors_" + pos + "_right" + sp_door_index[2], "Open", "", 0.02);
		Fire("sp_doors_" + pos + "_right" + sp_door_index[3], "Open", "", 0.02);
		Later(9, () => platformDoorsClose(index));
		// Move movelinear to desired position
		Fire("sp_linear_" + pos, "SetSpeed", "6000");
		Fire("sp_linear_" + pos, "SetPosition", "0.177", 0.04);
	}
}

// Starts sequence of closing doors of the platform; also replaces trains back to cheap version
function platformDoorsClose(index)
{
	const pos = SP_POSITIONS[index];
	// Play sounds
	for (const tb of SP_AMBIENCE_TOP_BOTTOM_COORDS)
		for (const x of SP_AMBIENCE_COORDS)
			Later(0.0, () => soundPlayManual(12, 0, x, tb, SP_AMBIENCE_HEIGHT));
	Fire("sp_doors_" + pos + "_left*", "Close");
	Fire("sp_doors_" + pos + "_right*", "Close");
	// Teleport people inside the train to waiting room
	Fire("tp_sp_" + pos, "Enable", "", 3.0);
	Fire("tp_spawn_postmz", "KeyValue", "target dest_spwait", 3.0);
	Fire("tp_sp_wait" + pos, "Disable", "", 3.0);
	// Kill all detailed model trains at the platform
	Fire("train_prop_detailed", "KillHierarchy", "", 3.0);
	Fire("train_prop_door_moveleft", "Kill", "", 3.0);
	Fire("train_prop_door_moveright", "Kill", "", 3.0);
	// Replace with cheaper trains
	let rail_coords = SP_RAIL_EAST_COORDS;
	if (index === 1 || index === 3)
		rail_coords = SP_RAIL_WEST_COORDS;
	// головной вагон при отъезде: южная (east rail) едет в +x → 768 (k = 3), северная (west rail) в -x → -768 (k = 0)
	const lead = (index === 1 || index === 3) ? 0 : 3;
	for (let k = 0; k < 4; k++)
	{
		const x = SP_PARKED_COORDS[k];
		Later(3.0, () =>
		{
			const ents = spawnCheapTrain(x, rail_coords, SP_RAIL_HEIGHT, index);
			if (k === lead)
			{
				trainLightsOn(ents, "train_light_cheap");
				FireT(Pick(ents, "train_prop_cheap"), "Skin", "1");
			}
		});
	}
	for (let k = 0; k < 4; k++)
		Later(3.02, () => attachTrainMid(k, index));
	// Reset movelinear back to normal property
	const linear = "sp_linear_" + pos;
	Fire(linear, "SetSpeed", "50", 3.04);
	Fire(linear, "SetSpeed", "100", 4);
	Fire(linear, "SetSpeed", "150", 5);
	Fire(linear, "SetSpeed", "225", 6);
	Fire(linear, "SetSpeed", "350", 7.5);
	Fire(linear, "SetSpeed", "500", 9);
	Fire(linear, "SetSpeed", "600", 10);
	Fire(linear, "Open", "", 3.04);
	if (index === 0)
		Later(12, () => platformApproach(1));// Starts next sequence in opposite platform
	if (index === 1)// Starts next sequence of spawning trains at both platforms
	{
		Later(12, () => platformApproach(2));
		Later(12, () => platformApproach(3));
	}
}

// Attach train to movelinear at the start of sequence
function attachTrainStart(index, index_movelinear)
{
	let rail_coords = SP_RAIL_EAST_COORDS;
	let coord_index = 0;
	if (index_movelinear === 1 || index_movelinear === 3)
	{// If the train spawns at northern platform instead
		rail_coords = SP_RAIL_WEST_COORDS;
		coord_index = 4;
	}
	const train = FindByNameNearest("train_prop_cheap", V(SP_COORDS[coord_index + index], rail_coords, SP_RAIL_HEIGHT), 200);
	SetParent(train, entityFinder("sp_linear_" + SP_POSITIONS[index_movelinear]));
}

// Attach train to movelinear at the platform
function attachTrainMid(index, index_movelinear)
{
	let rail_coords = SP_RAIL_EAST_COORDS;
	if (index_movelinear === 1)
		rail_coords = SP_RAIL_WEST_COORDS;
	const train = FindByNameNearest("train_prop_cheap", V(SP_PARKED_COORDS[index], rail_coords, SP_RAIL_HEIGHT), 200);
	SetParent(train, entityFinder("sp_linear_" + SP_POSITIONS[index_movelinear]));
}

// Spawns trains for onto desired locations (train_maker_detailed)
function spawnTrain(originx, originy, originz, index)
{
	let angle = 0;
	if (index === 1 || index === 3)
		angle = 180;
	return SpawnFromMaker("train_maker_detailed", V(originx, originy, originz), { pitch: 0, yaw: angle, roll: 0 });
}

// Spawns cheap versioned trains for onto desired locations (train_maker_cheap)
function spawnCheapTrain(originx, originy, originz, index)
{
	let angle = 0;
	if (index === 1 || index === 3)
		angle = 180;
	return SpawnFromMaker("train_maker_cheap", V(originx, originy, originz), { pitch: 0, yaw: angle, roll: 0 });
}

// Enable на свет вагона из только что заспавненных энтити (startsWith — на случай суффикса от name fixup)
function trainLightsOn(ents, lightName)
{
	for (const e of ents ?? [])
		if (e?.IsValid() && e.GetEntityName().startsWith(lightName))
		{
			FireT(e, "Enable");
			FireT(e, "CastDynamicShadows", "1");
		}
}

// If a human does not get off the train after door closes
function missedDisembark(activator)
{
	if (activator?.IsValid() && activator.GetTeamNumber() === 3)
		KillPawn(activator);
}

//* Subway Platform Intro *//

// Starts train arrival to station sequence
function spIntro()
{
	MapFade();
	S.fade.holdtime = 0;
	ServerCmd("sv_disable_radar 1", 1.5);
	Later(1.0, MapFadeReverse);
	Fire("tp_spawn_ct", "Enable", "", 1.0);
	Later(1.0, () => platformApproach(0));
	Fire("tp_spawn_t", "Enable", "", 3.0);
	Later(1.0, spIntroChat);
	Fire("sp_mz_trigger", "Enable", "", 6.0);
	Fire("sprite_sp_template", "ForceSpawn", "", 2.0);
}

// Prints out center message (time + location) as the train arrives
function spIntroChat()
{
	if (S.sp_seconds === 19)
		return;
	CenterClock(S.sp_seconds);
	S.sp_seconds++;
	Later(1.0, spIntroChat);
}

// Initiates the map features as the players are teleported into the map
function spInitiate()
{// This is the point where some players are converted to mother zombies
	if (!S.sp_intro_started)
	{// A failsafe mechanism to start the map even if MZ is not found
		Debug("Debug (start): starting the map initiating commands");
		if (S.zm_mz_found === false)
		{// This really should not happen!
			Debug("Debug (start): WARNING! Map did not detect any MZ");
			Fire("spawn_premz_multiple", "Kill");// Disable context removal trigger in spawn
			Fire("spawn_postmz_multiple", "Enable");// Enable 'zombified' context trigger in spawn
			Fire("map_perished_timer", "Enable", "", 1.0);// Enable delayed infections for later zombies
			Fire("map_spawn_timer", "Enable");
			Fire("tp_spawn_failsafe", "Enable", "", 10.0);// Enable failsafe teleport in spawn
			SpriteShow("spawn_failsafe_sprite", 10.0);// Enable failsafe sprite in spawn
		}
		Later(0.0, itemsWT);
		Fire("tp_spawn_ct", "Kill", "", 5.5);
		Fire("tp_spawn_t", "Kill", "", 5.5);
		Fire("tp_spawn_postmz", "Enable", "", 5.5);
		S.sp_intro_started = true;
		return;
	}
	Debug("Debug (start): map has already started, so skipping the failsafe map start");
}

// Ends the subway platform section and move to next area
function spIntroEnd()
{
	if (!S.sp_end_area || !S.item_wt_enabled)
	{
		// If the sequence has not finished OR the walkie talkie is not picked up yet
		if (!S.item_wt_enabled)
			Say("⠀\x02 [ CONSOLE ]\x01 To escape we need some sort of help. Try to find a\x0d walkie talkie\x01!");
		return;
	}
	if (S.item_wt_was_first === true)
		Fire("sp_break*", "Break", "", 2.0);
	else
		Fire("sp_break*", "Break", "", 14.0);
	// Change the spawn tp to the afk/teleport room
	Fire("tp_spawn_postmz", "KeyValue", "target dest_afk_room");
	Fire("afk_room_hurt", "Enable");
}

//* Maintenance Hall *//

// Sets up the three paths
function preSplit()
{
	Later(0.0, preSplitChat);
	Later(0.0, itemsPB);
	Later(1.0, itemsGC);
	Later(2.0, itemsTM);
	Later(3.0, itemsRP);
	Fire("sp_up_wta", "Unlock", "", 22.0);
	Fire("sp_up_wtb", "Unlock", "", 22.0);
	Fire("sp_up_wtc", "Unlock", "", 22.0);
	SpriteShow("sp_up_wta_sprite", 22.0);
	SpriteShow("sp_up_wtb_sprite", 22.0);
	SpriteShow("sp_up_wtc_sprite", 22.0);
	// Kill the trains in the platform + close the doors
	Fire("train_prop_detailed", "KillHierarchy");
	Fire("sp_doors_top_left", "Close");
	Fire("sp_doors_top_right", "Close");
	Fire("sp_doors_bottom_left", "Close");
	Fire("sp_doors_bottom_right", "Close");
	// Enable ZM tp forward + move people AFK in trains to the AFK room
	S.zm_spawn_sp3 = 1;
	Fire("tp_sp_top", "KeyValue", "target dest_afk_room");
	Fire("tp_sp_bottom", "KeyValue", "target dest_afk_room");
	Fire("tp_sp_top", "Enable");
	Fire("tp_sp_bottom", "Enable");
	Later(30.0, () => enableAFKTP(0));
}

// Prints out chat for preSplit()
function preSplitChat()
{
	if (S.presplit_chat_it === PRESPLIT_CHAT.length)
		return;
	Say(PRESPLIT_CHAT[S.presplit_chat_it]);
	Later(4, preSplitChat);
	S.presplit_chat_it++;
}

//============================================================================================
// Path Alpha (Office)
//============================================================================================

// Displays in chat the purpose of path alpha
function alphaExplain()
{
	if (S.a_chat_it === A_EXPLAIN.length)
		return;
	Say(A_EXPLAIN[S.a_chat_it]);
	Later(4.0, alphaExplain);
	S.a_chat_it++;
}

// Checks if both doors are triggerd
function controlDoorsTriggerd()
{
	if (S.a_bottom_triggered == 1 && S.a_top_triggered == 1)
	{// Both are triggered
		Say("⠀\x02 [ A ]\x01 Nice! I will open\x02 both gates\x01 soon");
		Later(4.0, introduceAdminHack);
		Fire("a_tw_linear_top", "Open", "", 5.0);
		Fire("a_tw_linear_bottom", "Open", "", 5.0);
		Fire("sprite_a_mg_template", "ForceSpawn", "", 5.0);
		Fire("a_sprite1", "Kill", "", 5.0);
		Fire("sp_up_sprite", "Kill", "", 5.0);
	}
	else if (S.a_bottom_triggered == 1)
	{// Bottom is triggered
		Say("⠀\x02 [ A ]\x01 The gate will open quicker if you trigger the\x02 top gate\x01 as well");
		Later(A_DOORS_WAIT_TIME, () => controlDoorWait(1));
	}
	else if (S.a_top_triggered == 1)
	{// Top is triggered
		Say("⠀\x02 [ A ]\x01 The gate will open quicker if you trigger the\x02 bottom gate\x01 as well");
		Later(A_DOORS_WAIT_TIME, () => controlDoorWait(0));
	}
}

// If only one is triggered, then ONLY open that one after a long time
// Inputs: index - indicating if it is top(0) or bottom(1) door
function controlDoorWait(index)
{
	if (S.a_bottom_triggered == 1 && S.a_top_triggered == 1)
		return;// function has no usage if both are triggered
	Say("⠀\x02 [ A ]\x01 No response from the other floor... I'll open the gate");
	if (index === 0)
	{
		Fire("a_tw_linear_top", "Open", "", 2.0);
		Fire("a_tw_linear_bottom", "Open", "", 22.0);
		Fire("a_tw_button_bottom", "KillHierarchy");
	}
	if (index === 1)
	{
		Fire("a_tw_linear_bottom", "Open", "", 2.0);
		Fire("a_tw_linear_top", "Open", "", 22.0);
		Fire("a_tw_button_top", "KillHierarchy");
	}
	Later(2.0, introduceAdminHack);
	Fire("sprite_a_mg_template", "ForceSpawn", "", 2.0);
	Fire("a_sprite1", "Kill", "", 2.0);
	Fire("sp_up_sprite", "Kill", "", 2.0);
}

//* Minigame *//

// Introduces and let players know the minigame they are facing
function introduceAdminHack()
{
	let text = A_MG_INTRO_CHAT[S.a_mg_chat_it];
	// Separate to update a_mg_totduration and a_mg_terminals correctly
	if (S.a_mg_chat_it === 1)
	{
		if (!(S.a_top_triggered && S.a_bottom_triggered))
		{
			// Squirrel: целочисленное деление, если a_mg_totduration — integer
			S.a_mg_totduration = Number.isInteger(S.a_mg_totduration) ? Math.trunc(S.a_mg_totduration / 2) : S.a_mg_totduration / 2;
			Debug("Debug (a MG): adjustment for only 1 floor trigger");
		}
		text = "⠀\x02 [ A ]\x01 and you have limited time... about\x02 " + S.a_mg_totduration + " seconds\x01 to tune all\x02 " + S.a_mg_terminals + " terminals";
	}
	Say(text);
	if (S.a_mg_chat_it === 2)
	{
		S.a_mg_chat_it = 0;
		Fire("a_mg_wt", "Unlock", "", 1.0);
		Fire("a_mg_quit_wt", "Unlock", "", 3.0);
		SpriteShow("a_mg_wt_sprite", 1.0);
		SpriteShow("a_mg_quit_wt_sprite", 3.0);
		return;
	}
	Later(4.0, introduceAdminHack);
	S.a_mg_chat_it++;
}

// Skip the minigame and move on to next area
function exitAlpha()
{
	Fire("a_mg_wt", "Lock");
	Fire("a_mg_quit_wt", "Lock");
	SpriteHide("a_mg_wt_sprite");
	SpriteHide("a_mg_quit_wt_sprite");
	if (S.a_mg_warned)
	{// If players want to exit even after the warning
		Say("⠀\x02 [ A ]\x01 Well... let me get the doors for you then");
		killAlphaMG();
		Later(2.0, alphaOpenDoors);
		return;
	}
	Say(A_MG_WARNED_CHAT[S.a_mg_chat_it]);
	if (S.a_mg_chat_it === 1)
	{
		S.a_mg_chat_it = 0;
		S.a_mg_warned = true;
		Fire("a_mg_wt", "Unlock", "", 1.0);
		Fire("a_mg_quit_wt", "Unlock", "", 3.0);// Prevent potential trolling
		SpriteShow("a_mg_wt_sprite", 1.0);
		SpriteShow("a_mg_quit_wt_sprite", 3.0);
		return;
	}
	Later(4.0, exitAlpha);
	S.a_mg_chat_it++;
}

// Starts the minigame sequence
function startAdminHack()
{
	Say(A_MG_CHAT[S.a_mg_chat_it]);
	if (S.a_mg_chat_it === 0)
	{
		Fire("a_mg_quit_wt", "Kill");// Prevent the early quit option
		Fire("a_mg_condition_text", "SetMessage", "LAUNCHING");
		const time = RandomInt(3, 5);
		Later(time, startAdminHack);
		Later(time, initiateHackMinigame);// Start the minigame
		S.a_mg_chat_it++;
		S.a_mg_inprogress = true;
	}
}

// Initiates the hacking minigame
function initiateHackMinigame()
{
	if (S.a_bottom_triggered && !S.a_top_triggered)
	{
		for (let it = 1; it < S.a_mg_terminals + 1; it++)
			Later(0.0, () => checkHack(it));
	}
	else if (S.a_top_triggered && !S.a_bottom_triggered)
	{
		for (let it = 5; it < S.a_mg_terminals + 5; it++)
			Later(0.0, () => checkHack(it));
	}
	else
	{
		for (let it = 1; it < S.a_mg_terminals + 1; it++)
			Later(0.0, () => checkHack(it));
	}
	for (let it = 1; it < 9; it++)
		Fire("a_mg_text" + it, "SetMessage", String(RandomInt(0, 9)));
	Later(S.a_mg_totduration, () => { S.a_mg_finish = 1; });// Bool to stop the minigame
	Later(S.a_mg_totduration, hackFailed);// Checks if minigames is won
	Fire("a_mg_dot_text", "SetMessage", ".");
	Fire("a_mg_mhz_text", "SetMessage", "MHz");
	Fire("a_mg_condition_text", "SetMessage", "TUNING");
}

// Fire a specific terminal to be hackable for the duration stated with a_mg_hackduration
function repeatHack(number)
{
	// Activates visual indications
	Fire("a_mg_sprite" + number, "Skin", "2");
	Fire("a_mg_button" + number, "Unlock");// Unlocks corresponding button
	Fire("a_mg_button" + number, "Lock", "", S.a_mg_hackduration);// Prevents same tick hack / button lock
	Later(S.a_mg_hackduration + 0.05, () => checkHack(number));// Checks if hack was successful
}

// Checks if the hack on specific terminal was succesful; recursive between repeatHack() function
function checkHack(number)
{
	if (S.a_mg_finish === 1)
		return;// Quit function if the timelimit of minigame has reached
	Later(0.02, isHackComplete);// Checks if all hack is complete
	const sprite = entityFinder("a_mg_sprite" + number);
	const next_timing = RandomInt(3, 5);
	// Cosmetic frequency display
	Fire("a_mg_text" + number, "SetMessage", String(RandomInt(0, 9)));
	if (number >= 1 && number <= 8 && S["a_mg_" + number + "_hacked"] == 1)
	{// The hack was successful
		if (sprite?.IsValid())
			sprite.SetColor({ r: 0, g: 255, b: 0 });
		S.a_mg_terminals_hacked++;
		return;
	}
	// Otherwise try again for next time
	FireT(sprite, "Skin", "0");
	Later(next_timing, () => repeatHack(number));// Repeats 3-5 secs later
}

// If a player mis-times the terminal
function missedHack(activator)
{
	if (S.a_mg_inprogress)
	{
		FireT(activator, "AddContext", "a_mg_failed:1", 0.0);
		FireT(activator, "RemoveContext", "a_mg_failed", 0.1);
	}
}

// Checks if all terminals has been hacked
function isHackComplete()
{
	if (S.a_mg_terminals_hacked === S.a_mg_terminals)
	{// Quit function if all terminals are hacked
		if (S.a_mg_terminals_hacked === 8)
		{
			S.a_mg_success = true;// Good ending progress only if both floors are triggered
			hackSuccess();
		}
		else
			hackSuccessOneFloor();
		S.a_mg_inprogress = false;
		finalGateUnlock();
	}
}

// Fires when all terminals have been hacked
function hackSuccess()
{
	S.a_mg_chat_it = 0;
	Fire("a_mg_condition_text", "SetMessage", "SUCCESS");
	Later(0.0, hackSuccessChat);
}

function hackSuccessChat()
{
	Say(A_MG_COMPLETE_CHAT[S.a_mg_chat_it]);
	if (S.a_mg_chat_it === 2)
		alphaOpenDoors();
	if (S.a_mg_chat_it === A_MG_COMPLETE_CHAT.length - 1)
		return;
	Later(4.0, hackSuccessChat);
	S.a_mg_chat_it++;
}

// Fires when all terminals of one floor have been hacked
function hackSuccessOneFloor()
{
	S.a_mg_chat_it = 0;
	Fire("a_mg_condition_text", "SetMessage", "SUCCESS");
	Later(0.0, hackSuccessOneFloorChat);
}

function hackSuccessOneFloorChat()
{
	Say(A_MG_SEMI_COMPLETE_CHAT[S.a_mg_chat_it]);
	if (S.a_mg_chat_it === 2)
		alphaOpenDoors();
	if (S.a_mg_chat_it === A_MG_SEMI_COMPLETE_CHAT.length - 1)
		return;
	Later(4.0, hackSuccessOneFloorChat);
	S.a_mg_chat_it++;
}

// Fires when terminal hacking has failed
function hackFailed()
{
	if (!S.a_mg_success && S.a_mg_inprogress)
	{
		S.a_mg_chat_it = 0;
		Fire("a_mg_button*", "Kill");
		Fire("a_mg_sprite*", "Skin", "2");
		Later(0.5, () =>
		{
			for (let i = 1; i <= 8; i++)
			{
				const sprite = entityFinder("a_mg_sprite" + i);
				if (sprite?.IsValid())
					sprite.SetColor({ r: 255, g: 0, b: 0 });
			}
		});
		Fire("a_mg_failhurt", "Kill");
		Fire("a_mg_condition_text", "SetMessage", "FAILED");
		Fire("a_mg_text*", "Kill");
		Fire("a_mg_dot_text", "Kill");
		Fire("a_mg_mhz_text", "Kill");
		Later(0.0, hackFailedChat);
		S.a_mg_inprogress = false;
		finalGateUnlock();
	}
}

function hackFailedChat()
{
	Say(A_MG_FAILED_CHAT[S.a_mg_chat_it]);
	if (S.a_mg_chat_it === 2)
		alphaOpenDoors();
	if (S.a_mg_chat_it === A_MG_FAILED_CHAT.length - 1)
		return;
	Later(4.0, hackFailedChat);
	S.a_mg_chat_it++;
}

// Opens the doors to the next area, whether or not the hack was completed
function alphaOpenDoors()
{
	if (S.a_bottom_triggered && !S.a_top_triggered)
	{
		Fire("a_nf_door1", "Open");
		Fire("a_nf_door2", "Open");
		Fire("a_nf_door3", "Open", "", 8.0);
		Fire("a_nf_door4", "Open", "", 8.0);
	}
	else if (S.a_top_triggered && !S.a_bottom_triggered)
	{
		Fire("a_nf_door1", "Open", "", 5.0);
		Fire("a_nf_door2", "Open", "", 5.0);
		Fire("a_nf_door3", "Open");
		Fire("a_nf_door4", "Open");
	}
	else
	{
		Fire("a_nf_door1", "Open");
		Fire("a_nf_door2", "Open");
		Fire("a_nf_door3", "Open");
		Fire("a_nf_door4", "Open");
	}
	killAlphaMG(10.0);
}

// a_mg* Kill, кроме моделей a_mg_sprite1-8 — они остаются
function killAlphaMG(delay = 0)
{
	for (const name of ["a_mg_button*", "a_mg_text*", "a_mg_condition_text", "a_mg_dot_text", "a_mg_mhz_text",
					   "a_mg_failhurt", "a_mg_wt*", "a_mg_quit_wt*"])
		Fire(name, "Kill", "", delay);
}

// If zombies overran alpha, then prevent zombies from going into near-finale area
function alphaFinalDoor()
{
	Say(TRIG_CHAT[RandomInt(0, TRIG_CHAT.length - 1)]);
	Fire("a_nf_door7", "Open", "", 10.0);
	Fire("a_nf_door8", "Open", "", 10.0);
	Fire("sprite_nf_template", "ForceSpawn");
	Fire("a_sprite2", "Kill");
}

//============================================================================================
// Path Bravo (Sewer)
//============================================================================================

// Displays in chat the purpose of path bravo
function bravoExplain()
{
	if (S.b_chat_it === B_EXPLAIN.length)
		return;
	Say(B_EXPLAIN[S.b_chat_it]);
	Later(4.0, bravoExplain);
	S.b_chat_it++;
}

//* Minigame *//

// Provides visible hint to which generator is the valid one, and sets up buttons
function setUpGenerator()
{
	FireT(entityFinder("b_rotate" + S.b_mg_valid), "Start", "", 0.0);// Rotate the correct fan
	FireT(entityFinder("b_rotate" + (S.b_mg_valid + 2)), "Start", "", 0.0);
	// Give visual indication to the third (broken) fan
	Later(0.05, () => sparkingStart(90, -2112, 2256, 392, 90, 0));
	Later(0.15, () => sparkingStart(90, -2112, 3520, 392, 90, 0));
}

// Prints chat as players enter the generator room
function generatorChat()
{
	Say(B_MG_CHAT_INTRO[S.b_mg_chat_it]);
	if (S.b_mg_chat_it === 0)
		S.b_mg_inprogress = true;
	if (S.b_mg_chat_it === B_MG_CHAT_INTRO.length - 1)
	{
		Fire("b_mg_button*", "Unlock");
		SpriteShow("b_mg_sprite*");
		const counter = S.b_mg_counter;
		Later(S.b_mg_max_time, () => generatorCheckTime(counter));// give max round time stated by b_mg_max_time
		Later(0.05, () => sparkingStart(30, -980, 4710, 224, 0, 90));
		Later(0.15, () => sparkingStart(30, -1056, 4710, 204, 0, 90));
		Later(0.25, () => sparkingStart(30, -1124, 4710, 218, 0, 90));
		return;
	}
	Later(4.0, generatorChat);
	S.b_mg_chat_it++;
}

// Skip the generator room and move on to next area
function exitBravo()
{
	Fire("b_mg_wt", "Lock");
	Fire("b_mg_quit_wt", "Lock");
	SpriteHide("b_mg_wt_sprite");
	SpriteHide("b_mg_quit_wt_sprite");
	if (S.b_mg_warned)
	{// If players want to exit even after the warning
		Say("⠀\x0b [ B ]\x01 Okay... but this is your loss as well");
		Fire("b_mg*", "Kill");
		Fire("b_gr_linear2", "Open", "", 2.0);
		Fire("b_gr_linear3", "Open", "", 5.0);
		return;
	}
	Say(B_MG_WARNED_CHAT[S.b_mg_chat_it]);
	if (S.b_mg_chat_it === 1)
	{
		S.b_mg_chat_it = 0;
		S.b_mg_warned = true;
		Fire("b_mg_wt", "Unlock", "", 1.0);
		Fire("b_mg_quit_wt", "Unlock", "", 3.0);// Prevent potential trolling
		SpriteShow("b_mg_wt_sprite", 1.0);
		SpriteShow("b_mg_quit_wt_sprite", 3.0);
		return;
	}
	Later(4.0, exitBravo);
	S.b_mg_chat_it++;
}

// Checks whether power is delivered (i.e. if minigame is completed)
function checkPower(number)
{
	if (S.b_mg_success === true)
		generatorSuccess();
	else
	{// minigame is not completed
		Fire("b_mg_button*", "Unlock", "", S.b_mg_wait_time - 5);
		SpriteShow("b_mg_sprite*", S.b_mg_wait_time - 5);
		const counter = S.b_mg_counter;
		Later(S.b_mg_wait_time + S.b_mg_max_time - 5, () => generatorCheckTime(counter));// give max round time stated by b_mg_max_time
		Later(S.b_mg_wait_time - 5, () => soundPlayManual(8, 0, -1056, 4888, 216));
		Later(S.b_mg_wait_time - 5, () => soundPlayManual(8, 0, -1056, 4744, 216));
		Later(4.0, () => checkPowerChat(4));
	}
	checkPowerChat(number);
}

// Prints out on chat for checkPower()
function checkPowerChat(number)
{
	if (number === 3)
	{// If the player chose the obvious broken generator, just try again
		Say(B_MG_CHAT[1]);
		return;
	}
	if (number === 4)
	{// Just to let players know they have to wait a bit
		Say("⠀\x0b [ B ]\x01 The power grid needs to\x0f stabilise\x01. I imagine about\x02 " + (S.b_mg_wait_time - 9) + " seconds\x01 more");
		return;
	}
	if (number === S.b_mg_valid)
		Say(B_MG_CHAT[0]);
	else
		Say(B_MG_CHAT[RandomInt(2, 5)]);
}

// Checks after b_mg_max_time if a generator has not been selected by humans
function generatorCheckTime(input)
{
	if (input === S.b_mg_counter && S.b_mg_inprogress)
		generatorTimeOver();// humans took too long to press a generator
}

// End the minigame if humans have not selected any generator after b_mg_max_time
function generatorTimeOver()
{
	generatorEnd();
	Later(0.0, generatorTimeOverChat);
}

function generatorTimeOverChat()
{
	Say(B_MG_TIMEOVER_CHAT[S.b_mg_chat_it]);
	if (S.b_mg_chat_it === B_MG_TIMEOVER_CHAT.length - 1)
	{
		S.b_mg_inprogress = false;
		finalGateUnlock();
		return;
	}
	Later(4.0, generatorTimeOverChat);
	S.b_mg_chat_it++;
}

// Fires after the correct generator is activated
function generatorSuccess()
{
	generatorEnd();
	Later(4.0, generatorSuccessChat);
}

// Fires to open gates etc. after the minigame is finished by any means
function generatorEnd()
{
	S.b_mg_chat_it = 0;
	Fire("b_mg*", "Kill");
	Fire("tp_b_mr", "Enable");
	Fire("tp_b_mr", "Disable", "", 8.0);
	Fire("b_gr_linear2", "Close");
	Fire("b_gr_linear2", "Open", "", 10.0);
	Fire("b_gr_linear3", "Open", "", 4.0);
}

function generatorSuccessChat()
{
	Say(B_MG_SUCCESS_CHAT[S.b_mg_chat_it]);
	if (S.b_mg_chat_it === B_MG_SUCCESS_CHAT.length - 1)
	{
		S.b_mg_inprogress = false;
		finalGateUnlock();
		return;
	}
	Later(4.0, generatorSuccessChat);
	S.b_mg_chat_it++;
}

// Checks whether a generator is in process of being initiated
function initiateGenerator(number, activator, caller)
{
	if (activator?.IsValid() && activator.GetTeamNumber() === 3)
	{// Only allow CT trigger
		FireT(caller, "FireUser1", "", 0.0);
		Later(0.0, () => soundPlay(5, 0, caller));
		if (S.b_mg_valid === number)
		{// enable finish condition
			S.b_mg_success = true;
			Fire("b_gr_linear2", "Close");
		}
		else
		{
			const coords = caller?.IsValid() ? caller.GetAbsOrigin() : activator.GetAbsOrigin();
			const z = coords.z + RandomInt(20, 50);
			Later(0.05, () => sparkingStart(10, coords.x, coords.y, z, 0, 0));
			KillPawn(activator);// punish(electrocute) the player for choosing the wrong generator
		}
		Fire("b_mg_button*", "Lock");
		SpriteHide("b_mg_sprite*");
		Later(5.0, () => checkPower(number));
		S.b_mg_counter++;
	}
}

//============================================================================================
// Path Charlie (Subway)
//============================================================================================

// Display to players the purpose of path charlie
function charlieExplain()
{
	Say(C_EXPLAIN[S.c_chat_it]);
	if (S.c_chat_it === C_EXPLAIN.length - 1)
	{
		S.c_chat_it = 0;
		return;
	}
	Later(4.0, charlieExplain);
	S.c_chat_it++;
}

// Spawns trains in the subway tunnel
// first — первый вагон в серии: у него включается train_light_hurt
function spawnHurtTrain(first = false)
{
	const ents = Spawn("train_template_hurt");
	if (!first)
		return;
	// у шаблона нет "Don't fixup names" — имена с суффиксом, поэтому startsWith
	for (const e of ents)
	{
		if (!e?.IsValid())
			continue;
		if (e.GetEntityName().startsWith("train_light_hurt"))
			FireT(e, "Enable");
		else if (e.GetEntityName().startsWith("train_prop_hurt"))
			FireT(e, "Skin", "1");
	}
}

// Let players know of deadly trains
function spawnTrainChat()
{
	Say(C_TRAINS_CHAT[S.c_chat_it]);
	if (S.c_chat_it === C_TRAINS_CHAT.length - 1)
	{
		S.c_chat_it = 0;
		return;
	}
	Later(4.0, spawnTrainChat);
	S.c_chat_it++;
}

// Spawns all trains in the subway tunnel
function startHurtTrainSequence()
{
	Later(6.0, spawnTrainChat);
	for (const t of [0.0, 7.0, 14.0])
	{
		Later(t, () => spawnHurtTrain(true));
		Later(t + 0.85, () => spawnHurtTrain());
		Later(t + 1.7, () => spawnHurtTrain());
	}
}

// Let players know to trigger the server room minigame
function serverTriggerChat()
{
	Say(C_TRIGGER_CHAT[S.c_chat_it]);
	if (S.c_chat_it === C_TRIGGER_CHAT.length - 1)
	{
		S.c_chat_it = 0;
		return;
	}
	Later(4.0, serverTriggerChat);
	S.c_chat_it++;
}

//* Minigame *//

// Introduce the server minigame to players
function serverChatIntro()
{
	Say(C_MG_CHAT_INTRO[S.c_mg_chat_it]);
	if (S.c_mg_chat_it === 2)
	{
		Fire("c_mg_wt", "Unlock", "", 2.0);
		Fire("c_mg_quit_wt", "Unlock", "", 4.0);
		SpriteShow("c_mg_wt_sprite", 2.0);
		SpriteShow("c_mg_quit_wt_sprite", 4.0);
		S.c_mg_chat_it = 0;
		return;
	}
	Later(4.0, serverChatIntro);
	S.c_mg_chat_it++;
}

// Skip the server room and move on to next area
function exitCharlie()
{
	Fire("c_mg_wt", "Lock");
	Fire("c_mg_quit_wt", "Lock");
	SpriteHide("c_mg_wt_sprite");
	SpriteHide("c_mg_quit_wt_sprite");
	if (S.c_mg_warned)
	{// If players want to exit even after the warning
		Say("⠀\x04 [ C ]\x01 This is not great but alright");
		killCharlieMG();
		Fire("c_sv_door1", "Open", "", 2.0);
		Fire("c_sv_door2", "Open", "", 2.0);
		return;
	}
	Say(C_MG_WARNED_CHAT[S.c_mg_chat_it]);
	if (S.c_mg_chat_it === C_MG_WARNED_CHAT.length - 1)
	{
		S.c_mg_chat_it = 0;
		S.c_mg_warned = true;
		Fire("c_mg_wt", "Unlock", "", 1.0);
		Fire("c_mg_quit_wt", "Unlock", "", 3.0);// Prevent potential trolling
		SpriteShow("c_mg_wt_sprite", 1.0);
		SpriteShow("c_mg_quit_wt_sprite", 3.0);
		return;
	}
	Later(4.0, exitCharlie);
	S.c_mg_chat_it++;
}

// Chooses locations for the sprite and button
function locationChooser(index)
{
	return V(
		RandomInt(C_MG_MIN_X[index], C_MG_MAX_X[index]),
		RandomInt(C_MG_MIN_Y[index], C_MG_MAX_Y[index]),
		RandomInt(C_MG_MIN_Z, C_MG_MAX_Z));
}

// Starts the server minigame
function startServerMG()
{
	Say("⠀\x04 [ C ]\x01 Okay, I have relayed the request. Best of luck!");
	Later(2.0, serverHackRound);
	S.c_mg_inprogress = true;
}

// Initiates a round of server hacking minigame
function serverHackRound()
{
	const colour_indices = indexChooser(0, S.c_mg_max_options, C_MG_RGB.length);
	const rack_indices = indexChooser(0, S.c_mg_max_options, C_MG_MAX_SERVERS);
	Later(0.0, () => soundPlayManual(8, 0, 1230, 5312, 0));
	const sprite = entityFinder("c_mg_sprite" + (S.c_mg_monitor_it + 1));
	// c_mg_sprite1-6 — мониторы (prop_dynamic): включить Skin 1 и выставить цвет
	FireT(sprite, "Skin", "1");
	const rgb = C_MG_RGB[colour_indices[0]].split(" ").map(Number);
	if (sprite?.IsValid())
		sprite.SetColor({ r: rgb[0], g: rgb[1], b: rgb[2] });
	const count = Math.min(S.c_mg_max_options, colour_indices.length, rack_indices.length);
	for (let it = 0; it < count; it++)
	{
		const coordinates = locationChooser(rack_indices[it]);
		if (it === 0)
		{// first iteration is always correct
			const correct_sprite = Pick(SpawnFromMaker("c_mg_correct_maker", coordinates), "c_mg_correct_sprite")
				?? FindByNameNearest("c_mg_correct_sprite", coordinates, 1);
			SpriteColor(correct_sprite, C_MG_RGB[colour_indices[it]]);
		}
		else
		{// the latter are wrong
			const false_sprite = Pick(SpawnFromMaker("c_mg_false_maker", coordinates), "c_mg_false_sprite")
				?? FindByNameNearest("c_mg_false_sprite", coordinates, 1);
			SpriteColor(false_sprite, C_MG_RGB[colour_indices[it]]);
		}
	}
	const counter = S.c_mg_counter;
	Later(S.c_mg_max_time, () => serverHackCheckTime(counter));// start the time limit check
}

// Prints to players if they chose the correct server
function serverHackChat(index)
{
	if (index === 1)
		Say(C_MG_CHAT[RandomInt(0, 3)]);
	else
		Say(C_MG_CHAT[RandomInt(4, 7)]);
}

// Initiates server hacking minigame round (function essentially adds delay defined by c_mg_wait)
function startHackRound(activator, caller)
{
	if (activator?.IsValid() && activator.GetTeamNumber() === 3)
	{// Only CT trigger
		Later(0.0, () => soundPlay(7, 0, caller));
		if (caller?.IsValid() && caller.GetEntityName() === "c_mg_correct_button")
			S.c_mg_monitor_it++;// If correct server is chosen, progress forward
		// Kill all mg buttons and sprites
		Fire("c_mg_correct_button", "Kill");
		Fire("c_mg_correct_sprite", "Kill");
		Fire("c_mg_false_button", "Kill");
		Fire("c_mg_false_sprite", "Kill");
		// Create an indicative particle at the sprite location
		if (caller?.IsValid())
			SpawnFromMaker("c_mg_particle_maker", caller.GetAbsOrigin());
		// Print to chat end of mg round
		if (S.c_mg_monitor_it === C_MG_ROUNDS)
		{
			serverHackSuccess();
			return;
		}
		else if (S.c_mg_monitor_prev !== S.c_mg_monitor_it)
			Later(S.c_mg_wait - 2, () => serverHackChat(1));// Chose correct server
		else
			Later(S.c_mg_wait - 2, () => serverHackChat(0));// Chose wrong server
		Later(S.c_mg_wait, serverHackRound);// Start next round
		Fire("c_mg_particle", "Kill", "", S.c_mg_wait);
		S.c_mg_monitor_prev = S.c_mg_monitor_it;// Set for next round
		S.c_mg_counter++;// increase the rounds
	}
}

// Check after c_mg_max_time if the minigame round was attempted
function serverHackCheckTime(input)
{
	if (input === S.c_mg_counter && S.c_mg_inprogress)
		serverHackTimeOver();
}

// Fires when the minigame was not completed after c_mg_max_time
function serverHackTimeOver()
{
	killCharlieMG();
	serverHackEnd();
	Later(0.0, serverHackTimeOverChat);
}

function serverHackTimeOverChat()
{
	Say(C_MG_TIMEOVER_CHAT[S.c_mg_chat_it]);
	if (S.c_mg_chat_it === C_MG_TIMEOVER_CHAT.length - 1)
	{
		S.c_mg_inprogress = false;
		finalGateUnlock();
		return;
	}
	Later(4.0, serverHackTimeOverChat);
	S.c_mg_chat_it++;
}

// Fires to end the minigame regardless of the minigame completion
function serverHackEnd()
{
	Fire("c_sv_door1", "Open", "", 9.0);
	Fire("c_sv_door2", "Open", "", 9.0);
}

// Fires when server minigame is completed
function serverHackSuccess()
{
	S.c_mg_success = true;
	S.c_mg_chat_it = 0;
	Later(3.0, serverHackSuccessChat);
	killCharlieMG(15.0);
	serverHackEnd();
	finalGateUnlock();
}

// c_mg* Kill, кроме мониторов c_mg_sprite1-6 — им выключение: цвет 255 255 255 и Skin 0
function killCharlieMG(delay = 0)
{
	for (const name of ["c_mg_correct*", "c_mg_false*", "c_mg_hurt", "c_mg_particle*", "c_mg_wt*", "c_mg_quit_wt*"])
		Fire(name, "Kill", "", delay);
	Fire("c_mg_sprite*", "Color", "255 255 255", delay);
	Fire("c_mg_sprite*", "Skin", "0", delay);
}

function serverHackSuccessChat()
{
	Say(C_MG_SUCCESS_CHAT[S.c_mg_chat_it]);
	if (S.c_mg_chat_it === C_MG_SUCCESS_CHAT.length - 1)
	{
		S.c_mg_inprogress = false;
		finalGateUnlock();
		return;
	}
	Later(4.0, serverHackSuccessChat);
	S.c_mg_chat_it++;
}

//============================================================================================
// Near Finale
//============================================================================================

// Determines if the gate can be opened; checks if the trigger is CT, and if none of the minigames are in progress
function finalGateTrigger(activator, caller)
{
	if (activator?.IsValid() && activator.GetTeamNumber() === 3)
	{// Only allow CT trigger
		Later(0.0, () => soundPlay(18, 0, caller));
		if (S.a_mg_inprogress)
		{// Alpha minigame is still in progress
			Say("⠀\x10 [ OPR ]\x01 I see people are still at the\x02 control room\x01... I will let you know when they are finished");
			finalGateLock();
			return;
		}
		if (S.b_mg_inprogress)
		{// Beta minigame is still in progress
			Say("⠀\x10 [ OPR ]\x01 I see people are still at the\x02 generator room\x01... I will let you know when they are finished");
			finalGateLock();
			return;
		}
		if (S.c_mg_inprogress)
		{// Charlie minigame is still in progress
			Say("⠀\x10 [ OPR ]\x01 I see people are still at the\x02 server room\x01... I will let you know when they are finished");
			finalGateLock();
			return;
		}
		// None are in progress
		Fire("nf_wt", "FireUser1");
	}
}

// Locks the gate + hides walkie talkie sprite at the finale gate
function finalGateLock()
{
	Fire("nf_wt", "Lock");
	SpriteHide("nf_wt_sprite");
}

// Unlocks the gate + shows walkie talkie sprite at the finale gate
function finalGateUnlock()
{
	Fire("nf_wt", "Unlock");
	SpriteShow("nf_wt_sprite");
}

// Checks if good ending objectives are fulfilled
function determineEnding()
{
	if (S.a_mg_success && S.b_mg_success && S.c_mg_success)
		S.finale_good_ending = true;
}

// Starts the ending sequence
function initiateEndingSequence()
{
	S.music_stop_loops = true;
	if (S.finale_good_ending)
		endingInstant();// If all players are present
	else if (S.a_attempted == 1 && S.a_completed == 0)
		endingWait();// If some are still in path alpha
	else if (S.b_attempted == 1 && S.b_completed == 0)
		endingWait();// If some are still in path beta
	else if (S.c_attempted == 1 && S.c_completed == 0)
		endingWait();// If some are still in path charlie
	else
		endingInstant();// In case the team did not attempt the other paths
}

// If everybody is at the final door when the button is triggered
function endingInstant()
{
	Later(4.0, musicStop);
	Later(4.0, () => { S.music_stop_loops = true; });
	Say("⠀\x10 [ OPR ]\x01 I think everybody is here? Okay, let me get the gate opening...");
	Fire("nf_linear_north", "Open", "", 4.0);
	Later(4.0, displayEnding);
	Later(8.0, elevatorChat);
}

// If part of the team is still in one of the paths
function endingWait()
{
	Later(4.0, endingWaitChat);
	Fire("nf_linear_north", "Open", "", 28.0);
	Later(28.0, displayEnding);
	Later(32.0, musicStop);
	Later(32.0, () => { S.music_stop_loops = true; });
	Later(32.0, elevatorChat);
}

function endingWaitChat()
{
	Say(NF_WAIT_CHAT[S.nf_chat_it]);
	if (S.nf_chat_it === NF_WAIT_CHAT.length - 1)
	{
		S.nf_chat_it = 0;
		return;
	}
	Later(4.0, endingWaitChat);
	S.nf_chat_it++;
}

// Display which ending is triggered
function displayEnding()
{
	if (S.finale_good_ending)
		Say("⠀\x02 [ CONSOLE ]\x01 Triggering\x04 GOOD ENDING");
	else
		Say("⠀\x02 [ CONSOLE ]\x01 Triggering\x02 BAD ENDING");
}

// Function for near ending area triggers
function nfEndingSequences()
{
	if (S.finale_good_ending)
		Later(0.0, () => musicPlay(8, 0));
	else
		Later(0.0, () => musicPlay(7, 0));
	Later(15.0, () => elevatorWarnChat(0));
	Fire("nf_lift1", "Open", "", 20.0);
	Later(30.0, () => elevatorWarnChat(1));
	Fire("nf_linear_top", "Open", "", 35.0);
	Fire("nf_lift2", "Open", "", 40.0);
	Later(43.0, endingChat);
	Later(50.0, () => elevatorWarnChat(2));
	Fire("nf_linear_top", "Close", "", 55.0);
	Later(60.0, chooseEnding);
}

// Print on chat about what to do next as the gate opens
function elevatorChat()
{
	Say(NF_ELEVATOR_CHAT[S.nf_chat_it]);
	if (S.nf_chat_it === NF_ELEVATOR_CHAT.length - 1)
	{
		S.nf_chat_it = 0;
		return;
	}
	Later(4.0, elevatorChat);
	S.nf_chat_it++;
}

function elevatorWarnChat(index)
{
	Say(NF_WARN_CHAT[index]);
}

// Explain what to do in the ending
function endingChat()
{
	Say(NF_EXPLAIN_FINALE_CHAT[S.nf_chat_it]);
	if (S.nf_chat_it === NF_EXPLAIN_FINALE_CHAT.length - 1)
		return;
	if (S.nf_chat_it === 3 && S.finale_good_ending)
		S.nf_chat_it++;
	if (S.nf_chat_it === 4 && (!S.a_mg_success || !S.b_mg_success || !S.c_mg_success))
		S.nf_chat_it++;
	Later(4.0, endingChat);
	S.nf_chat_it++;
}

