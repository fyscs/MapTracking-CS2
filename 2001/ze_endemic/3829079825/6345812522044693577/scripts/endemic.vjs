// Chat to let know good ending is triggered
function adminFinaleGoodEndingChat()
{
	Say("⠀\x03 [ ADMIN ]\x01 Good ending has been triggered");
}

// Spawns glowing model at all possible forward spawn locations
function adminFTP()
{
	Later(0.0, adminFTPChat);
	let it = 0;
	const lists = [ZM_FSP_COORDS, ZM_FA_COORDS, ZM_FB_COORDS, ZM_FC_COORDS, ZM_FNF_COORDS];
	for (let index = 0; index < lists.length; index++)
	{
		for (let i = 0; i < lists[index].length; i++)
		{
			Later(it + 0.05, () => adminFTPLoop(index, i));
			it = it + 0.1;
		}
	}
}

// Loop function to iterate through each zm_ftp coord arrays
function adminFTPLoop(index, array_index)
{
	const lists = [ZM_FSP_COORDS, ZM_FA_COORDS, ZM_FB_COORDS, ZM_FC_COORDS, ZM_FNF_COORDS];
	const coords = lists[index]?.[array_index];
	if (!coords)
		return;
	const model = spawnFtpGlow();
	if (!model)
		return;
	model.Teleport({ position: ParseVec(coords) });
	Glow(model, GLOW_RED);
}

function adminFTPChat()
{
