//============================================================================================
// События движка
//============================================================================================

let ROUND_RESET_DONE = false;

function ResetRound()
{
	ROUND_ID++;
	LATER_QUEUE.length = 0;
	S = NewState();
	HUD_ENT = undefined;
	SELF_ENT = undefined;
	CAMERA = null;
	ZM_TEXT_TOK++;
	CLOCK_TOK++;
	PLAYER_TEXT_TOK.clear();
}

Instance.OnActivate(() =>
{
	SELF_ENT = undefined;
	HUD_ENT = undefined;
	Self();
	Hud();
});

Instance.OnRoundEnd(() =>
{
	HudResetAll();
});

Instance.OnBeginRoundRestart(() =>
{
	HudResetAll();
	ResetRound();
	ROUND_RESET_DONE = true;
});

Instance.OnRoundStart(() =>
{
	if (!ROUND_RESET_DONE)
		ResetRound();
	ROUND_RESET_DONE = false;
	Self();
	Hud();
	for (const p of AllPawns())
		CameraApply(p);
	HudResetAll();
});

Instance.OnPlayerReset((event) =>
{
	CameraApply(event.player);
});

Instance.OnPlayerDisconnect((event) =>
{
	Hud()?.ResetForPlayer(event.playerSlot);
	for (const k in PLAYER_TEXTS)
		PLAYER_TEXT_TOK.delete(`${event.playerSlot}:${k}`);
});

Instance.OnScriptInput("SetTrainAng", ({ caller, activator }) =>
{
	if (activator?.IsValid() && caller?.IsValid())
	{
		let ang = caller?.GetAbsAngles();
		let new_ang = {
			pitch: 0,
			yaw: ang.yaw,
			roll: 0
		}
		activator?.Teleport({ angles: new_ang });
	}
});