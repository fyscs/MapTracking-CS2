//============================================================================================
// Состояние раунда (в CS:GO — все "x <- ..." на верхнем уровне, пересоздавались каждый раунд)
//============================================================================================

function NewState()
{
	const S = {
		// Stages
		warmup_it: 0,
		// Music
		music_stop_loops: false,
		// map_fade (env_fade) — keyvalues, которые меняли через AddOutput; entity пересоздаётся каждый раунд
		fade: { duration: 1, holdtime: 1, reverse: 1 },
		midfade_killed: false,
		// map_zm_text holdtime (itemsText меняет его через AddOutput до конца раунда)
		zm_text_hold: 5,
		// Groundcables
		item_gc_jumps: 0,
		// Reports
		item_rp_it: 0,
		item_rp_explain_in_progress: 0,
		// Walkie Talkie
		item_wt_enabled: false,
		item_wt_was_first: false,
		item_wt_chat_it: 0,
		// Mother Zombie
		zm_mz_found: false,
		zm_mz_checking: false,
		// AFK TP
		zm_spawn_sp1: 0, zm_spawn_sp2: 0, zm_spawn_sp3: 0,
		zm_spawn_a1: 0, zm_spawn_a2: 0, zm_spawn_a_tw1: 0, zm_spawn_a_tw2: 0,
		zm_spawn_b1: 0, zm_spawn_b_gr1: 0, zm_spawn_b_gr2: 0,
		zm_spawn_c1: 0, zm_spawn_c_sv1: 0, zm_spawn_c_sv2: 0,
		// Forward Spawns
		zm_fsp_min: 0, zm_fsp_max: 0,
		zm_fa_min: 0, zm_fa_max: 0,
		zm_fb_min: 0, zm_fb_max: 0,
		zm_fc_min: 0, zm_fc_max: 0,
		zm_fnf_min: 0, zm_fnf_max: 0,
		zm_ftp_list: [],
		// Triggering
		trig_add_delay: 0,
		trig_humans_at_finale: false,
		// Intro
		intro_sequence_it: 0,
		// Subway Platform Intro
		sp_end_area: false,
		sp_seconds: 12,
		sp_intro_started: false,
		// Maintenance Hall
		presplit_chat_it: 0,
		// Path Alpha
		a_attempted: 0,
		a_completed: 0,
		a_bottom_triggered: 0,
		a_top_triggered: 0,
		a_chat_it: 0,
		a_mg_terminals: 0,
		a_mg_1_hacked: 0, a_mg_2_hacked: 0, a_mg_3_hacked: 0, a_mg_4_hacked: 0,
		a_mg_5_hacked: 0, a_mg_6_hacked: 0, a_mg_7_hacked: 0, a_mg_8_hacked: 0,
		a_mg_terminals_hacked: 0,
		a_mg_hackduration: 0.50,
		a_mg_totduration: 20,
		a_mg_finish: 0,
		a_mg_success: false,
		a_mg_chat_it: 0,
		a_mg_warned: false,
		a_mg_inprogress: false,
		// Path Bravo
		b_attempted: 0,
		b_completed: 0,
		b_chat_it: 0,
		b_mg_valid: RandomInt(1, 2),
		b_mg_wait_time: 20,
		b_mg_chat_it: 0,
		b_mg_warned: false,
		b_mg_success: false,
		b_mg_counter: 0,
		b_mg_max_time: 20,
		b_mg_inprogress: false,
		// Path Charlie
		c_attempted: 0,
		c_completed: 0,
		c_chat_it: 0,
		c_mg_monitor_it: 0,
		c_mg_monitor_prev: 0,
		c_mg_wait: 5,
		c_mg_max_options: 6,
		c_mg_chat_it: 0,
		c_mg_warned: false,
		c_mg_success: false,
		c_mg_inprogress: false,
		c_mg_max_time: 30,
		c_mg_counter: 0,
		// Near Finale
		nf_chat_it: 0,
		// Finale
		finale_zm_count: 0,
		finale_human_count: 0,
		finale_end_zm_count: 0,
		finale_it: 0,
		finale_good_ending: false,
		finale_zm_hp: 450,
		finale_in_progress: false,
		finale_petty_mode: false,
		finale_door_closing: false,
		// Admin Room
		admin_abuse: false,
		admin_chat_it: 0,
	};
	S.item_pb_indices = indexChooser(0, RandomInt(1, 4), ITEM_PB_COORDX.length);
	S.item_gc_indices = indexChooser(0, RandomInt(1, 4), ITEM_GC_COORDX.length);
	S.item_tm_indices = indexChooser(0, RandomInt(1, 4), ITEM_TM_COORDX.length);
	S.item_rp_amount = RandomFloat(3, 10);// amount of reports to spawn
	S.item_rp_indices = indexChooser(3, S.item_rp_amount - 3, 14);
	S.item_rp_coords_indices = indexChooser(0, S.item_rp_amount, ITEM_RP_COORDX.length - 1);
	S.admin_b_chat = [
		"⠀\x03 [ ADMIN ]\x01 Setting up the generator minigame...",
		"⠀\x03 [ ADMIN ]\x01 Look at the fans above for the correct generator (the correct one is\x02 number " + S.b_mg_valid + "\x01)",
		"⠀\x03 [ ADMIN ]\x01 Remember, choosing the wrong one kills you (use god in console)",
		"⠀\x03 [ ADMIN ]\x01 Good luck!"];
	return S;
}

let S = NewState();

//============================================================================================
// env_fade, HUD (Map_Hud): game_text, центр-текст
// Всё общее — глобальными классами; per-player — только классы текстов канала 1 (perished / ftp / invince),
// снимаются по окончании holdtime.
//============================================================================================

// --- env_fade (map_fade, map_intro_midfade) — только через env_fade, не через HUD (HUD перекрывает чат и войсчат).
//   В CS2 duration/holdtime у env_fade не меняются и нет входа FadeReverse, поэтому на каждую комбинацию
//   из оригинала (AddOutput) стоит своя env_fade (ze_endemic_fades.vmf), всё запускается через Fade.
//   FadeReverse → отдельная env_fade с флагом Fade From (1), duration = ReverseFadeDuration.
//   S.fade — какие значения были бы у map_fade в CS:GO на этот момент.
//   ключ: duration_holdtime
const FADE_ENTS = {
	"1_1": "map_fade",                  // startIntro, spIntro, endingApproach (начало)
	"1_0": "map_fade_h0",               // endingApproach: затемнение через 8 с
	"1_60": "map_fade_h60",             // endingLand: финальное затемнение
	"0.05_2": "map_fade_blackout2",     // brokePB: блэкаут 2-4 с
	"0.05_3": "map_fade_blackout3",
	"0.05_4": "map_fade_blackout4",
};
//   ключ: ReverseFadeDuration_holdtime
const FADE_REV_ENTS = {
	"1_0": "map_fade_rev_h0",           // spIntro, endingApproach, endingLand
	"1_60": "map_fade_rev_h60",         // конец интро
};

function FadeEnt(table, key)
{
	const name = table[key];
	if (name)
		return name;
	Instance.Msg(`[endemic] нет env_fade для ${key}`);
	return undefined;
}

function MapFade()
{
	const name = FadeEnt(FADE_ENTS, `${S.fade.duration}_${S.fade.holdtime}`);
	if (name)
		Fire(name, "Fade");
}

// env_fade FadeReverse
function MapFadeReverse()
{
	const name = FadeEnt(FADE_REV_ENTS, `${S.fade.reverse}_${S.fade.holdtime}`);
	if (name)
		Fire(name, "Fade");
}

// map_intro_midfade: duration 0.1, holdtime 0.05; reverse — map_intro_midfade_rev (Fade From)
function MidFade()
{
	if (!S.midfade_killed)
		Fire("map_intro_midfade", "Fade");
}

function MidFadeReverse()
{
	if (!S.midfade_killed)
		Fire("map_intro_midfade_rev", "Fade");
}

// --- map_zm_text (all players, fadein 1, fadeout 1)
const ZM_TEXT_PANEL = "hud_zm_text";
const ZM_TEXT_MSGS = ["MsgItem", "MsgPerished", "MsgFtp"];
let ZM_TEXT_TOK = 0;

function ZmText(msg)
{
	const h = Hud();
	if (!h)
		return;
	const tok = ++ZM_TEXT_TOK;
	for (const m of ZM_TEXT_MSGS)
		h.SetHasClass(ZM_TEXT_PANEL, m, m === msg);
	h.SetHasClass(ZM_TEXT_PANEL, "Visible", true);
	Later(1 + S.zm_text_hold, () =>
	{
		if (tok === ZM_TEXT_TOK)
			Hud()?.SetHasClass(ZM_TEXT_PANEL, "Visible", false);
	});
}

// --- map_perished_text / map_ftp_text / map_invince_text (activator only, game_text channel 1)
const PLAYER_TEXTS = {
	perished: { panel: "hud_perished_text", fadein: 0.5, hold: 4 },
	ftp: { panel: "hud_ftp_text", fadein: 1, hold: 8 },
	invince: { panel: "hud_invince_text", fadein: 0, hold: 3 },
};
const PLAYER_TEXT_TOK = new Map();

function PlayerText(pawn, key)
{
	const h = Hud();
	const slot = SlotOf(pawn);
	const t = PLAYER_TEXTS[key];
	if (!h || slot === undefined || !t)
		return;
	// один канал — новый текст заменяет остальные
	for (const k in PLAYER_TEXTS)
		if (k !== key)
			h.SetHasClassForPlayer(slot, PLAYER_TEXTS[k].panel, "Visible");
	h.SetHasClassForPlayer(slot, t.panel, "Visible", true);
	const id = `${slot}:${key}`;
	const tok = (PLAYER_TEXT_TOK.get(id) ?? 0) + 1;
	PLAYER_TEXT_TOK.set(id, tok);
	Later(t.fadein + t.hold, () =>
	{
		if (PLAYER_TEXT_TOK.get(id) !== tok)
			return;
		Hud()?.SetHasClassForPlayer(slot, t.panel, "Visible");
	});
}

// --- map_outro_text / map_outro_text2 (all players, fadein 1, fadeout 1)
function OutroText(panel, fadein, hold)
{
	const h = Hud();
	if (!h)
		return;
	h.SetHasClass(panel, "Visible", true);
	Later(fadein + hold, () => Hud()?.SetHasClass(panel, "Visible", false));
}

// --- ScriptPrintMessageCenterAll("City Underground Subway\n 14:27:SS")
let CLOCK_TOK = 0;

function CenterClock(seconds)
{
	const h = Hud();
	if (!h)
		return;
	const tok = ++CLOCK_TOK;
	h.SetDialogVariableString("hud_clock_time", "sec", String(seconds));
	h.SetHasClass("hud_clock", "Visible", true);
	Later(3, () =>
	{
		if (tok === CLOCK_TOK)
			Hud()?.SetHasClass("hud_clock", "Visible", false);
	});
}

// --- полный сброс HUD (конец раунда / новый раунд)
const HUD_PANELS = ["hud_perished_text", "hud_outro_text", "hud_outro_text2", "hud_clock", "hud_ftp_text", "hud_invince_text", "hud_zm_text"];
const HUD_PLAYER_PANELS = ["hud_perished_text", "hud_ftp_text", "hud_invince_text"];

function HudResetAll()
{
	ZM_TEXT_TOK++;
	CLOCK_TOK++;
	PLAYER_TEXT_TOK.clear();
	const h = Hud();
	if (!h)
		return;
	for (const panel of HUD_PANELS)
		h.SetHasClass(panel, "Visible", false);
	for (const m of ZM_TEXT_MSGS)
		h.SetHasClass(ZM_TEXT_PANEL, m, false);
	for (const c of Instance.GetAllPlayerControllers())
	{
		if (!c?.IsValid())
			continue;
		const slot = c.GetPlayerSlot();
		for (const panel of HUD_PLAYER_PANELS)
			h.SetHasClassForPlayer(slot, panel, "Visible");
	}
}

//============================================================================================
// Камеры (point_viewcontrol_multiplayer → CustomPlayerCamera)
//============================================================================================

let CAMERA = null;// { name, pos, ang }

function CameraApply(pawn)
{
	if (!pawn?.IsValid())
		return;
	const cam = pawn.GetCustomCamera();
	if (!cam)
		return;
	if (CAMERA)
	{
		cam.Teleport({ position: CAMERA.pos, angles: CAMERA.ang });
		cam.SetMode(CustomCameraMode.CONTROLLED);
	}
	else
		cam.SetMode(CustomCameraMode.DISABLED);
}

function CameraPos(name)
{
	const e = entityFinder(name);
	if (e?.IsValid())
		return e.GetAbsOrigin();
	return CAMERA_FALLBACK[name]?.pos;
}

// EntFire("<camera>", "Enable")
function CameraEnable(name)
{
	const e = entityFinder(name);
	const fb = CAMERA_FALLBACK[name];
	CAMERA = {
		name,
		pos: e?.IsValid() ? e.GetAbsOrigin() : fb.pos,
		ang: e?.IsValid() ? e.GetAbsAngles() : fb.ang,
	};
	for (const p of AllPawns())
		CameraApply(p);
}

// EntFire("<camera>", "Disable")
function CameraDisable(name)
{
	if (CAMERA && CAMERA.name !== name)
		return;
	CAMERA = null;
	for (const p of AllPawns())
		CameraApply(p);
}

//============================================================================================
// Entity Functions
//============================================================================================

// Creates a sparking effect for a given amount of time
// PORT: map_spark_template ForceSpawn + FindByNameNearest объединены — спавн прямо здесь
function sparkingStart(duration, coordx, coordy, coordz, pitch, yaw)
{
	const spark = SpawnOne("map_spark_template", "map_spark");
	if (!spark)
		return;
	// PORT: AddOutput Magnitude 1 / TrailLength 1 не переносится (нет KeyValue) — остаются 2 / 3 из шаблона
	Later(0.04, () =>
	{
		if (spark.IsValid())
			spark.Teleport({ position: V(coordx, coordy, coordz), angles: { pitch, yaw, roll: 0 } });
	});
	Later(0.1, () => sparking(spark));
	FireT(spark, "Kill", "", duration);
}

// Repeating the function after sparkingStart()
function sparking(spark)
{
	if (spark?.IsValid())
	{
		const duration = RandomFloat(0, 0.25);
		const next_spark = RandomFloat(0, 5);
		FireT(spark, "StartSpark", "", 0.0);
		FireT(spark, "StopSpark", "", duration);
		Later(next_spark, () => sparking(spark));
	}
}

//============================================================================================
// Stages
//============================================================================================

// Fires for every new round
function newRound()
{
	// PORT: map_perished_text / map_ftp_text SetText — тексты статикой в endemic_hud.xml
}

// Fires when the map is just loaded; i.e. warmup round
function stageIntro()
{
	Later(0.0, warmUpPrinter);
	Later(40.0, startIntro);
	Fire("tp_zm*", "Kill");
	Fire("tp_spawn*", "KeyValue", "target dest_afk_room");
	Fire("tp_spawn*", "Enable");
	Fire("afk_room_hurt", "Kill");
	Later(0.0, () => musicPlay(9, 0));
	Fire("intro_dmg_multiple", "Enable");
}

// Prints warmup in console every 5 seconds
function warmUpPrinter()
{
	if (S.warmup_it > 7)
		return;
	Say("⠀\x02 [ CONSOLE ]\x01 WARM UP");
	if (S.warmup_it === 1)
		Say("⠀\x02 [ CONSOLE ]\x01 Want to pratcie the map? There is an admin room below the spawn room");
	Later(5.0, warmUpPrinter);
	S.warmup_it++;
}

// Fires for the main map, before the map is won by CT
function stagePreWin()
{
	Fire("intro*", "Kill");
	Later(10.0, spIntro);
	Later(10.0, detectMZ);
	Later(11.0, checkDetectMZ);
	Later(20.0, spInitiate);
	if (Instance.GetRoundsPlayed() === 1)
		Later(11.0, () => musicIntro(5, 6));
	else
		Later(11.0, musicChoose);
	if (Instance.GetRoundsPlayed() > 5)
	{// If humans lost more than 5 rounds
		S.finale_petty_mode = true;
		Say("⠀\x02 [ CONSOLE ]\x01 Easy mode activated in bad ending (Humans lost more than 5 rounds)");
	}
}

// Fires for the main map, after the map is won by CT
function stagePostWin()
{// Nothing much is changed, except to disable ZM glow if petty mode was activated in bad ending
	Fire("intro*", "Kill");
	Later(10.0, spIntro);
	Later(10.0, detectMZ);
	Later(11.0, checkDetectMZ);
	Later(20.0, spInitiate);
	Later(11.0, musicChoose);
}

// map_level_counter GetValue → map_level_case InValue
function levelGetValue()
{
	if (LEVEL === 1)
		stageIntro();
	else if (LEVEL === 2)
		stagePreWin();
	else if (LEVEL === 3)
		stagePostWin();
}

//============================================================================================
// Music
//============================================================================================

// Plays music with the given pathfile
function musicPlay(pathfile_index, looped)
{
	const sound_emit = entityFinder("map_music");
	FireT(sound_emit, "StopSound", "", 0.0);
	FireT(sound_emit, "SetSoundEventName", MUSIC[pathfile_index], 0.0);
	FireT(sound_emit, "StartSound", "", 0.02);
	if (looped === 1)
		Later(MUSIC_LENGTH[pathfile_index], () => musicLoop(pathfile_index));
}

// Plays music with looping
function musicLoop(pathfile_index)
{
	if (!S.music_stop_loops)
		musicPlay(pathfile_index, 1);
}

// Stops (looping) music
function musicStop()
{
	// PORT: у point_soundevent нет FadeOut 5 — StopSound сразу
	const sound_emit = entityFinder("map_music");
	FireT(sound_emit, "StopSound", "", 0.0);
}

// Give intro to a looping music
function musicIntro(pathfile_index, pathfile_index_looped)
{
	musicPlay(pathfile_index, 0);
	Later(MUSIC_LENGTH[pathfile_index], () => musicLoop(pathfile_index_looped));
}

// Chooses which music to play
function musicChoose()
{
	const index = RandomInt(1, 6);
	if (index === 1 || index === 2)
		musicIntro(1, 2);
	else if (index === 3 || index === 4)
		musicIntro(3, 4);
	else if (index === 5 || index === 6)
		musicIntro(5, 6);
}

//============================================================================================
// Sound
//============================================================================================

// map_sfx_maker → map_sfx (point_soundevent) в точке, SetSoundEventName + StartSound, Kill по длине
function soundSpawn(pathfile_index, total_duration, coordinates)
{
	const name = SFX[pathfile_index];
	if (!name || !coordinates)
		return undefined;
	const sound = Pick(SpawnFromMaker("map_sfx_maker", coordinates, { pitch: 0, yaw: 0, roll: 0 }), "map_sfx");
	if (!sound)
		return undefined;
	FireT(sound, "SetSoundEventName", name, 0.0);
	FireT(sound, "StartSound", "", 0.02);
	if (total_duration === 0)
		FireT(sound, "Kill", "", SFX_LENGTH[pathfile_index] + 0.02);
	if (total_duration > 0)
		FireT(sound, "Kill", "", total_duration);
	return sound;
}

// Plays sound at activator's location
// Inputs: total_duration - 0 for non-looped, >0 kill after, <0 never killed
function soundPlay(pathfile_index, total_duration, activator)
{
	if (!activator?.IsValid())
		return;
	soundSpawn(pathfile_index, total_duration, activator.GetAbsOrigin());
}

// Plays sound at given coordinates
function soundPlayManual(pathfile_index, total_duration, coordx, coordy, coordz)
{
	soundSpawn(pathfile_index, total_duration, V(coordx, coordy, coordz));
}

// Plays sound at activator's location with fade in
function soundPlayFadeIn(pathfile_index, activator)
{
	// PORT: FadeIn 2 у point_soundevent нет
	if (!activator?.IsValid())
		return;
	soundSpawn(pathfile_index, -1, activator.GetAbsOrigin());
}

