// Spawns items on walls for display
function adminSpawnItems()
{
	const box = FindByNameNearest("item_pb_box1", V(392, -232, -756), 8);
	box?.Teleport({ position: V(-40, 128, -960), angles: { pitch: 0, yaw: 180, roll: 0 } });
	const cable = FindByNameNearest("item_gc_prop1", V(472, -72, -808), 8);
	cable?.Teleport({ position: V(40, 128, -976), angles: { pitch: 90, yaw: 0, roll: 90 } });
	const tm = FindByNameNearest("item_tm_prop1", V(392, -136, -718), 8);
	tm?.Teleport({ position: V(120, 128, -960), angles: { pitch: 0, yaw: 180, roll: 0 } });
	const report = FindByNameNearest("item_rp_prop", V(392, -296, -816), 8);
	report?.Teleport({ position: V(-120, 128, -960), angles: { pitch: 0, yaw: 0, roll: 90 } });
}

// Spawns glowing transmitter model at all possible locations
function adminTM()
{
	Later(0.0, adminTMChat);
	let it = 0;
	for (let i = 0; i < ITEM_TM_COORDX.length; i++)
	{
		Later(it, () =>
		{
			const box = spawnDelayTM1();
			Later(0.05, () => spawnTM1(i, box));
		});
		it = it + 0.1;
	}
	GlowByName("item_tm_prop1", GLOW_GREEN, it + 0.1);
}

