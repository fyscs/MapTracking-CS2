.TextBlock {
    horizontal-align: center;
    flow-children: down;
    opacity: 0;
    transition-property: opacity;
    transition-timing-function: linear;
    transition-duration: 1s;
}
.TextBlock.Left {
    horizontal-align: left;
}
.TextBlock.Visible {
    opacity: 1;
}
.TextBlock.Fade0 {
    transition-duration: 0s;
}
.TextBlock.Fade05 {
    transition-duration: 0.5s;
}
.TextBlock.Fade1 {
    transition-duration: 1s;
}
.HudText {
    horizontal-align: center;
    text-align: center;
    font-size: 26px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    text-shadow: 0px 0px 4px 1.0 #000000;
}
.TextBlock.Left .HudText {
    horizontal-align: left;
    text-align: left;
}
.White .HudText {
    color: #ffffff;
}
.Red .HudText {
    color: #c80000;
}
.Yellow .HudText {
    color: #c1bb0e;
}
.ZmMsg {
    horizontal-align: center;
    flow-children: down;
    visibility: collapse;
}
#hud_zm_text.MsgItem .ZmItem {
    visibility: visible;
}
#hud_zm_text.MsgPerished .ZmPerished {
    visibility: visible;
}
#hud_zm_text.MsgFtp .ZmFtp {
