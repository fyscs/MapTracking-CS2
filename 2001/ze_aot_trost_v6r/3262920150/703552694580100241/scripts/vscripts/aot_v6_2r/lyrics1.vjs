/* ================================ 配置 ================================ */
const CONFIG = {
    layoutEntity: "lyrics_hud1",      // custom_hud_layout 实体名
    musicEntity: "lyrics_music1",        // point_soundevent 实体名
    panelId: "lyrics_hud1",                // HUD 根面板 id
    rowCurrent: "lyric_current",            // 第一行（当前句·主）面板 id
    subRow: "lyric_sub",                    // 当前句·副 标签 id
    rowNext: "lyric_next",                  // 下一句·主 标签 id
    subNextRow: "lyric_next_sub",           // 下一句·副 标签 id
    clipId: "karaoke_clip",                 // 进度裁剪面板 id
    curVar: "current",                      // 对应 XML 的 {s:current}（当前句·主）
    subCurVar: "subcurrent",                // 对应 {s:subcurrent}（当前句·副）
    nextVar: "next",                        // 对应 XML 的 {s:next}（下一句·主）
    subNextVar: "subnext",                  // 对应 {s:subnext}（下一句·副）
    hiddenClass: "Hidden",                  // 显隐 class
    syncInterval: 0.05,                     // 同步周期（秒）
    chatTrigger: "play1",        // 聊天触发词
    stopOnRoundRestart: true,  // 回合重启时是否停止
    karaoke: true,                   // 卡拉OK 双色进度开关
    align: "center",                     // 对齐方式：left / center / right
    rowWidth: 1000,                // 必须与 CSS .CurrentRow 宽度一致
    fontSize: 34,                // 必须与 CSS 当前句字号一致
};

/* ================================ 状态 ================================ */
let lines = LYRICS;
let duration = 288.730;
let startTime = 0;
let curIndex = -1;
let curPct = 0;        // 当前进度档位（与 XML 初始 kp0 对应）
let animFlip = false;  // 交替动画类名，强制 CSS 动画重启
let playing = false;
let layout;
let music;

/* ============================== 实体与 HUD ============================== */
function getLayout() {
    if (!(layout instanceof CustomHudLayout) || !layout.IsValid()) {
        layout = Instance.FindEntitiesByName(CONFIG.layoutEntity)[0];
    }
    return layout;
}

function getMusic() {
    if (!(music instanceof Entity) || !music.IsValid()) {
        music = Instance.FindEntitiesByName(CONFIG.musicEntity)[0];
    }
    return music;
}

function setClass(id, cls, has) {
    const l = getLayout();
    if (l && l.IsValid()) l.SetHasClass(id, cls, has);
}

function setVar(name, value) {
    const l = getLayout();
    if (l && l.IsValid()) l.SetDialogVariableString(CONFIG.panelId, name, value);
}

/* ============================== 卡拉OK 进度 ============================== */
/* 按字符粗略估算文本宽度（中日韩按字号，其余按 0.55 倍），把进度映射到文字实际
   占用区间，避免行首尾出现"空转"。 */
function estimateWidth(text) {
    let w = 0;
    for (const ch of text) w += ((ch.codePointAt(0) || 0) > 0x2e80 ? CONFIG.fontSize : CONFIG.fontSize * 0.55) + 2;
    return w;
}

function setClip(pct) {
    if (pct === curPct) return;
    if (curPct >= 0) setClass(CONFIG.clipId, "kp" + curPct, false);
    setClass(CONFIG.clipId, "kp" + pct, true);
    curPct = pct;
}

function updateKaraoke(i, t) {
    if (!CONFIG.karaoke) { setClip(100); return; }
    if (i < 0) { setClip(0); return; }
    const t0 = lines[i].time;
    const t1 = i + 1 < lines.length ? lines[i + 1].time : duration;
    const p = Math.max(0, Math.min(1, (t - t0) / Math.max(0.001, t1 - t0)));

    const est = Math.min(estimateWidth(lines[i].text), CONFIG.rowWidth);
    /* 按对齐方式推算文字左边缘，再把进度映射到文字实际占用区间 */
    const left = CONFIG.align === "left" ? 0
               : CONFIG.align === "right" ? Math.max(0, CONFIG.rowWidth - est)
               : Math.max(0, (CONFIG.rowWidth - est) / 2);
    const pct = Math.round(Math.max(0, Math.min(100, (left + p * est) / CONFIG.rowWidth * 100)));
    setClip(pct);
}

/* ============================== 触发接口 ============================== */
/* Play() / Stop() 是唯一入口。要接入新的触发方式（实体、定时器、其他事件），
   在任意地方调用 Play() 或 Stop() 即可，或在文件末尾追加新的注册。 */

/* 同时开始播放音乐与歌词 */
function Play() {
    if (!lines.length) return;
    const m = getMusic();
    if (m && m.IsValid()) Instance.EntFireAtName({ name: CONFIG.musicEntity, input: "StartSound" });
    startTime = Instance.GetGameTime();
    curIndex = -1;
    playing = true;
    setVar(CONFIG.curVar, "");
    setVar(CONFIG.nextVar, "");
    setClip(0);
    setClass(CONFIG.panelId, CONFIG.hiddenClass, false);
}

/* 停止音乐并隐藏 HUD */
function Stop() {
    const m = getMusic();
    if (m && m.IsValid()) Instance.EntFireAtName({ name: CONFIG.musicEntity, input: "StopSound" });
    playing = false;
    curIndex = -1;
    setClass(CONFIG.panelId, CONFIG.hiddenClass, true);
}

/* ============================== 时间轴同步 ============================== */
/* 二分查找：返回 time <= t 的最后一句下标 */
function indexAt(t) {
    let lo = 0, hi = lines.length - 1, ans = -1;
    while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (lines[mid].time <= t) { ans = mid; lo = mid + 1; }
        else hi = mid - 1;
    }
    return ans;
}

/* 切句：写入主/副两行文本并交替触发动画（交替类名可强制 CSS 动画重启）
   主歌词与副歌词使用**同一组动画类**，保证淡入淡出完全同步。 */
function advance(i) {
    const cur = i >= 0 && i < lines.length ? lines[i] : null;
    const nxt = i + 1 < lines.length ? lines[i + 1] : null;
    setVar(CONFIG.curVar, cur ? cur.text : "");
    setVar(CONFIG.subCurVar, cur && cur.sub ? cur.sub : "");
    setVar(CONFIG.nextVar, nxt ? nxt.text : "");
    setVar(CONFIG.subNextVar, nxt && nxt.sub ? nxt.sub : "");

    animFlip = !animFlip;
    const growNew = animFlip ? "GrowA" : "GrowB";
    const growOld = animFlip ? "GrowB" : "GrowA";
    const fadeNew = animFlip ? "FadeA" : "FadeB";
    const fadeOld = animFlip ? "FadeB" : "FadeA";

    setClass(CONFIG.rowCurrent, growNew, true);
    setClass(CONFIG.rowCurrent, growOld, false);
    setClass(CONFIG.subRow, growNew, true);          // 副歌词与主歌词同一组动画
    setClass(CONFIG.subRow, growOld, false);

    setClass(CONFIG.rowNext, fadeNew, true);
    setClass(CONFIG.rowNext, fadeOld, false);
    setClass(CONFIG.subNextRow, fadeNew, true);      // 下一句副歌词同理
    setClass(CONFIG.subNextRow, fadeOld, false);

    setClip(0);
}

function think() {
    Instance.SetNextThink(Instance.GetGameTime() + CONFIG.syncInterval);
    if (!playing) return;

    const t = Instance.GetGameTime() - startTime;
    const i = indexAt(t);
    if (i !== curIndex) { curIndex = i; advance(i); }
    updateKaraoke(i, t);

    if (duration > 0 && t > duration + 1.5) {   // 超出末尾，收尾
        playing = false;
        setClass(CONFIG.panelId, CONFIG.hiddenClass, true);
    }
}

/* ================================ 初始化 ================================ */
/* 仅两行接线自检，不需要可删 */
if (!getLayout()) Instance.Msg("[lyrics] 未找到布局实体 " + CONFIG.layoutEntity);
if (!getMusic()) Instance.Msg("[lyrics] 未找到音效实体 " + CONFIG.musicEntity);

Instance.SetThink(think);
Instance.SetNextThink(Instance.GetGameTime());

/* 热重载：保留播放进度，重新解析实体 */
Instance.OnScriptReload({
    before: () => ({ playing, startTime, curIndex }),
    after: (mem) => {
        if (mem) { playing = mem.playing; startTime = mem.startTime; curIndex = mem.curIndex; }
        layout = undefined;
        music = undefined;
        if (playing) advance(curIndex);
        else setClass(CONFIG.panelId, CONFIG.hiddenClass, true);
    },
});

/* ------------------------------ 触发方式 ------------------------------ */
/* 聊天触发已关闭（默认）。大多数场景用下面的实体触发即可；
   需要调试时，在生成工具里勾选「启用聊天触发」后重新生成。 */

/* 实体触发（推荐）：对 point_script 实体发 RunScriptInput，value 传 Play / Stop */
Instance.OnScriptInput("Play", Play);
Instance.OnScriptInput("Stop", Stop);

/* 作弊命令（本地测试用） */
Instance.RegisterCheatCommand("lyrics_play", Play);
Instance.RegisterCheatCommand("lyrics_stop", Stop);

/* 回合重启自动停止，等待下一次触发 */
if (CONFIG.stopOnRoundRestart) Instance.OnBeginRoundRestart(Stop);
