.Root {
    width: 100%;
    height: 100%;
}
#lyrics_hud3 {
    width: 100%;
    height: 132px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 42px;
    flow-children: down;
    opacity: 1;
    transition-property: opacity;
    transition-duration: .3s;
}
#lyrics_hud3.Hidden {
    opacity: 0;
}
.CurrentRow {
    width: 960px;
    height: 49px;
    horizontal-align: center;
}
.CurrentRow.GrowA {
    animation-name: growA;
    animation-duration: 0.34s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
}
.CurrentRow.GrowB {
    animation-name: growB;
    animation-duration: 0.34s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
}
@keyframes 'growA' {
    0% {
        transform: translate3d( 0px, 30px, 0px ) scale3d( 0.62, 0.62, 1 );
        opacity: 0.45;
    }
100% {
        transform: translate3d( 0px, 0px, 0px ) scale3d( 1, 1, 1 );
        opacity: 1;
    }
}
@keyframes 'growB' {
    0% {
        transform: translate3d( 0px, 30px, 0px ) scale3d( 0.62, 0.62, 1 );
        opacity: 0.45;
    }
100% {
        transform: translate3d( 0px, 0px, 0px ) scale3d( 1, 1, 1 );
        opacity: 1;
    }
}
.KaraokeBase,.KaraokeFill {
    width: 960px;
    height: 100%;
    vertical-align: center;
    text-align: center;
    horizontal-align: left;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 2px;
    font-family: monospaceFont;
    text-shadow: 2px 0px 0px #000000, -2px 0px 0px #000000, 0px 2px 0px #000000, 0px -2px 0px #000000, 2px 2px 0px #000000, -2px -2px 0px #000000, 2px -2px 0px #000000, -2px 2px 0px #000000, 0px 0px 10px #000000cc;
}
.KaraokeBase {
    color: #ffffff;
}
.KaraokeFill {
    color: #ff0000;
}
.KaraokeClip {
    width: 0%;
    height: 100%;
    horizontal-align: left;
    overflow: clip;
    transition-property: width;
    transition-duration: .12s;
}
.SubRow {
    width: 100%;
    horizontal-align: center;
    text-align: center;
    margin-top: 2px;
    font-size: 26px;
    color: #ffffff;
    font-family: monospaceFont;
    text-shadow: 1px 0px 0px #000000, -1px 0px 0px #000000, 0px 1px 0px #000000, 0px -1px 0px #000000, 1px 1px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000, 0px 0px 5px #000000cc;
}
.SubRow.GrowA {
    animation-name: growA;
    animation-duration: 0.34s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
}
.SubRow.GrowB {
    animation-name: growB;
    animation-duration: 0.34s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
}
@keyframes 'fadeA' {
    0% {
        opacity: 0;
        transform: translate3d( 0px, -12px, 0px );
    }
100% {
        opacity: 1;
        transform: translate3d( 0px, 0px, 0px );
    }
}
@keyframes 'fadeB' {
    0% {
        opacity: 0;
        transform: translate3d( 0px, -12px, 0px );
    }
100% {
        opacity: 1;
        transform: translate3d( 0px, 0px, 0px );
    }
}
