class Vector3 {
    /**
     * 获取向量的模
     * @param {import("cs_script/point_script").Vector} vec 
     * @returns 
     */
    static Length(vec) {
        return Math.hypot(vec.x, vec.y, vec.z);
    }
    /**
     * 向量加法
     * @param {import("cs_script/point_script").Vector} vec 
     * @param {import("cs_script/point_script").Vector} vec2 
     * @returns 
     */
    static Add(vec, vec2) {
        return { x: vec.x + vec2.x, y: vec.y + vec2.y, z: vec.z + vec2.z };
    }
    /**
     * 向量减法
     * @param {import("cs_script/point_script").Vector} vec 
     * @param {import("cs_script/point_script").Vector} vec2 
     * @returns 
     */
    static Subtract(vec, vec2) {
        return { x: vec.x - vec2.x, y: vec.y - vec2.y, z: vec.z - vec2.z };
    }
    /**
     * 向量缩放
     * @param {import("cs_script/point_script").Vector} vec 
     * @param {number} scale 
     * @returns 
     */
    static Scale(vec, scale) {
        return { x: vec.x * scale, y: vec.y * scale, z: vec.z * scale };
    }
    /**
     * 点积
     * @param {import("cs_script/point_script").Vector} a 
     * @param {import("cs_script/point_script").Vector} b 
     * @returns 
     */
    static Dot(a, b) {
        return a.x * b.x + a.y * b.y + a.z * b.z;
    }
    /**
     * 叉积
     * @param {import("cs_script/point_script").Vector} a 
     * @param {import("cs_script/point_script").Vector} b 
     * @returns 
     */
    static Cross(a, b) {
        return {
            x: a.y * b.z - a.z * b.y,
            y: a.z * b.x - a.x * b.z,
            z: a.x * b.y - a.y * b.x
        };
    }
    /**
     * 判断向量是否相等
     * @param {import("cs_script/point_script").Vector} v1 
     * @param {import("cs_script/point_script").Vector} v2 
     */
    static IsVectorEqual(v1, v2) {
        return v1.x === v2.x && v1.y === v2.y && v1.z === v2.z;
    }
    /**
     * 判断欧拉角是否相等
     * @param {import("cs_script/point_script").QAngle} v1 
     * @param {import("cs_script/point_script").QAngle} v2 
     */
    static IsAnglesEqual(v1, v2) {
        return v1.pitch === v2.pitch && v1.yaw === v2.yaw && v1.roll === v2.roll;
    }
    /**
     * 向量归一化
     * @param {import("cs_script/point_script").Vector} vec - 输入向量
     * @returns {import("cs_script/point_script").Vector} 单位向量
     */
    static Normalize(vec) {
        const len = Vector3.Length(vec);
        if (len === 0) return { x: 0, y: 0, z: 0 };
        return {
            x: vec.x / len,
            y: vec.y / len,
            z: vec.z / len
        };
    }
    /**
     * 限制向量的长度（模长），使其不超过 maxLength。
     * @param {import("cs_script/point_script").Vector} vector 原始向量
     * @param {number} maxLength 允许的最大长度（必须 > 0）
     * @returns {import("cs_script/point_script").Vector} 新向量，长度 ≤ maxLength
     */
    static ClampVectorLength(vector, maxLength) {
        if (maxLength <= 0) {
            // 最大长度非正，返回零向量
            return { x: 0, y: 0, z: 0 };
        }

        const { x, y, z } = vector;
        const lenSq = x * x + y * y + z * z;
        const len = Math.sqrt(lenSq);

        // 零向量或长度已经不超过 maxLength 的情况
        if (len === 0 || len <= maxLength) {
            return { x, y, z }; // 返回原向量的浅拷贝
        }

        // 需要缩放
        const factor = maxLength / len;
        return {
            x: x * factor,
            y: y * factor,
            z: z * factor,
        };
    }
    /**
     * 在以给定中心点为球心、指定半径的球体内生成一个随机点（均匀分布）
     * @param {import("cs_script/point_script").Vector} center 球心坐标
     * @param {number} radius 球半径（>0）
     * @returns {import("cs_script/point_script").Vector} 随机点坐标
     */
    static RandomPointInSphere(center, radius) {
        let x, y, z, lenSq;
        do {
            // 在包围盒 [-r, r] 范围内生成随机坐标
            x = (Math.random() * 2 - 1) * radius;
            y = (Math.random() * 2 - 1) * radius;
            z = (Math.random() * 2 - 1) * radius;
            lenSq = x * x + y * y + z * z;
        } while (lenSq > radius * radius); // 只保留球体内的点

        // 平移至以 center 为中心
        return {
            x: center.x + x,
            y: center.y + y,
            z: center.z + z
        };
    }
    /**
     * 判断点是否在指定球体内
     * @param {import("cs_script/point_script").Vector} point 待检测的点
     * @param {import("cs_script/point_script").Vector} center 球心坐标
     * @param {number} radius 球半径
     * @returns {boolean} 点在球内（含边界）返回 true，否则 false
     */
    static IsPointInSphere(point, center, radius) {
        const dx = point.x - center.x;
        const dy = point.y - center.y;
        const dz = point.z - center.z;
        const distSq = dx * dx + dy * dy + dz * dz;
        return distSq <= radius * radius;
    }
    /**
     * 在给定球心、半径的球面上生成随机点（均匀分布）
     * @param {import("cs_script/point_script").Vector} center 球心坐标
     * @param {number} radius 球半径（>0）
     * @returns {import("cs_script/point_script").Vector} 球面上的随机点
     */
    static RandomPointOnSphere(center, radius) {
        let x, y, z, lenSq;
        do {
            // 在 [-1, 1] 立方体内生成随机点
            x = Math.random() * 2 - 1;
            y = Math.random() * 2 - 1;
            z = Math.random() * 2 - 1;
            lenSq = x * x + y * y + z * z;
        } while (lenSq > 1 || lenSq === 0); // 只保留单位球体内的非零向量

        // 归一化得到单位方向，再缩放至目标半径
        const len = Math.sqrt(lenSq);
        const factor = radius / len;

        return {
            x: center.x + x * factor,
            y: center.y + y * factor,
            z: center.z + z * factor
        };
    }
    /**
     * 将三维方向向量转换为欧拉角
     * @param {import("cs_script/point_script").Vector} vec
     * @returns {import("cs_script/point_script").QAngle}
     */
    static VectorToAngles(vec) {
        vec = Vector3.Normalize(vec);

        const pitch = -Math.asin(vec.z) * 180 / Math.PI;
        const yaw = Math.atan2(vec.y, vec.x) * 180 / Math.PI;

        return { pitch, yaw, roll: 0 };
    }
    /**
     * 将欧拉角转换为三维方向向量
     * @param {import("cs_script/point_script").QAngle} angles
     * @returns {import("cs_script/point_script").Vector}
     */
    static AnglesToVector(angles) {
        const pitchRadians = (angles.pitch * Math.PI) / 180;
        const yawRadians = (angles.yaw * Math.PI) / 180;
        const hScale = Math.cos(pitchRadians);
        return {
            x: Math.cos(yawRadians) * hScale,
            y: Math.sin(yawRadians) * hScale,
            z: -Math.sin(pitchRadians),
        };
    }
    /**
     * 判断点是否在圆柱体内（轴线平行于 Z 轴，底面圆心为 bottomCenter，高度向上延伸）
     * @param {import("cs_script/point_script").Vector} point 待检测的点
     * @param {import("cs_script/point_script").Vector} bottomCenter 底面圆心坐标
     * @param {number} height 圆柱体高度（>0）
     * @param {number} radius 圆柱体半径（>0）
     * @returns {boolean} 点在圆柱体内（含边界）返回 true，否则 false
     */
    static IsPointInCylinder(point, bottomCenter, height, radius) {
        // 检查高度范围（底面 z 到顶面 z）
        const bottomZ = bottomCenter.z;
        const topZ = bottomZ + height;
        if (point.z < bottomZ || point.z > topZ) return false;

        // 检查水平距离
        const dx = point.x - bottomCenter.x;
        const dy = point.y - bottomCenter.y;
        const distSq = dx * dx + dy * dy;
        return distSq <= radius * radius;
    }
    /**
     * 将向量按照自定义顺序旋转
     * @param {import("cs_script/point_script").Vector} vec 原始向量
     * @param {import("cs_script/point_script").QAngle} angles 欧拉角 { pitch, yaw, roll }，单位：度
     * @returns {import("cs_script/point_script").Vector} 旋转后的新向量
     */
    static RotateByAngles(vec, angles) {
        const toRad = (/** @type {number} */ deg) => deg * Math.PI / 180;
        const { pitch, yaw, roll } = angles;

        // 第一步：绕 Z 轴旋转 yaw
        const cosYaw = Math.cos(toRad(yaw));
        const sinYaw = Math.sin(toRad(yaw));
        let x1 = vec.x * cosYaw - vec.y * sinYaw;
        let y1 = vec.x * sinYaw + vec.y * cosYaw;
        let z1 = vec.z;

        // 第二步：绕 Y 轴旋转 pitch
        const cosPitch = Math.cos(toRad(pitch));
        const sinPitch = Math.sin(toRad(pitch));
        let x2 = x1 * cosPitch + z1 * sinPitch;
        let z2 = -x1 * sinPitch + z1 * cosPitch;
        let y2 = y1;

        // 第三步：绕 X 轴旋转 roll
        const cosRoll = Math.cos(toRad(roll));
        const sinRoll = Math.sin(toRad(roll));
        let y3 = y2 * cosRoll - z2 * sinRoll;
        let z3 = y2 * sinRoll + z2 * cosRoll;
        let x3 = x2;

        return { x: x3, y: y3, z: z3 };
    }
}

const playerState = new Map();
/** ---------------------------------------------------------------------------------- */




/** ----------------------------------------- 重置与初始化 ----------------------------------------- */
Instance.OnPlayerReset((event) => {
    const pawn = event.player;
    if (pawn && pawn.IsValid()) {

        // 第一次进入注册该玩家
        if (!playerState.has(pawn)) {
            const player = new Player(pawn);
            if (!player.IsValid()) return;
            player.Init();
            player.Reset();
            playerState.set(pawn, player);
        } else {
            const player = playerState.get(pawn);
            player.Reset();
        }
    }
});

Instance.OnRoundStart(() => {
    stageState.isEnding = false;
    stageState.isStart = true;
    Delay(30, () => stageState.isStart = false);
    const players = new Set(Instance.FindEntitiesByClass("player"));
    playerState.forEach((player, pawn) => {
        if (!pawn || !pawn.IsValid()) return;
        if (!players.has(pawn)) playerState.delete(pawn);
    });
});

Instance.OnPlayerKill((event) => {
    const pawn = event.player;
    if (pawn.IsValid() && playerState.has(pawn)) {
        const player = /** @type {Player} */ (playerState.get(pawn));
        if (player.team === 2) {
            if (player.isTitan) {

                // 巨人死后30%概率刷新随机道具
                if (Math.random() < 0.3) SpawnRandomItem(pawn.GetAbsOrigin());
                player.isTitan = false;
            }
            player.isShifter = false;
            Instance.EntFireAtName({ name: "player_hitbox_phy_" + player.slot, input: "Kill" });
            Instance.EntFireAtTarget({ target: player.pawn, input: "RemoveContext", value: "player_titan" });
        } else if (player.team === 3) {
            player.isHero = false;
            if (player.isHooking) player.ReleaseHook();
            if (player.isJetting) player.StopJet();
            if (player.isBladeRotating) player.StopBladeRota();
            for (const hookParticle of player.hookParticles) Instance.EntFireAtTarget({ target: hookParticle, input: "Kill" });
            player.hookParticles.length = 0;
            Instance.EntFireAtName({ name: "player_blade_rota_particle_" + player.slot, input: "Kill" });
            Instance.EntFireAtName({ name: "player_blade_rota_hurt_" + player.slot, input: "Kill" });
            Instance.EntFireAtName({ name: "player_hook_model_particle_" + player.slot, input: "Kill" });
            Instance.EntFireAtName({ name: "player_jet_particle_" + player.slot, input: "Kill" });
        }
        const attackerPawn = event.attacker;
        // @ts-ignore
        if (attackerPawn && attackerPawn.IsValid() && attackerPawn.GetClassName() === "player" && attackerPawn.GetPlayerController()?.GetPlayerName() !== pawn.GetPlayerController()?.GetPlayerName()) {
            Instance.EntFireAtName({ name: "hudhint_kill_player", input: "SetMessage", value: "您击杀了玩家[" + player.name + "]" });
            Instance.EntFireAtName({ name: "hudhint_kill_player", input: "ShowHudHint", activator: attackerPawn });
            if (playerState.has(attackerPawn)) {
                const attacker = playerState.get(attackerPawn);
                if (attacker.team === 3) attacker.AddEXP(CONFIG.expPerKill);
                else if (attacker.team === 2) attacker.AddEXP(CONFIG.expPerInfect);
            }
        }
    }
});

Instance.OnRoundEnd((event) => {
    if (event.winningTeam === 3) {
        playerState.forEach((player, pawn) => {
            if (player.IsValid() && player.team === 3) {
                player.AddLevel();
            }
        });
    }
});
/** ----------------------------------------- 重置与初始化 ----------------------------------------- */




/** ----------------------------------------- 主函数 ----------------------------------------- */
Instance.SetThink(() => {
    const currentTime = Instance.GetGameTime();
    UpdataTimeDelta(currentTime);
    DelayMain();
    playerState.forEach((/** @type {Player} */ player, pawn) => {
        if (!player.IsValid()) {
            playerState.delete(pawn);
            return;
        }
        player.CheckSQ();
        player.AFKDetect();
        player.CheckChangedTeam();
        player.UpdateUI();
        player.CheckLowHP();
        if (player.team === 3) {
            player.GasRevert();
            HookMain(player);
            JetMain(player);
            BladeRotaMain(player);
            ItemMain(player);
        }
    });
    Instance.SetNextThink(currentTime);
});

Instance.SetNextThink(Instance.GetGameTime());

/**
 * 钩锁主函数
 * @param {Player} player 
 */
function HookMain(player) {
    player.CheckHook();
    if (player.isHooking) {
        if (player.hookTarget && player.hookTarget.IsValid()) {
            const hookTargetPosition = player.hookTarget.GetAbsOrigin();
            if (player.isHookShooting) {
                if (Vector3.IsPointInSphere(hookTargetPosition, player.hookCP1Position, HOOK_CONFIG.particleSpeed)) player.isHookShooting = false;
                const particleDirection = Vector3.Normalize(Vector3.Subtract(hookTargetPosition, player.hookCP1Position));
                player.hookCP1Position = Vector3.Add(player.hookCP1Position, Vector3.Scale(particleDirection, HOOK_CONFIG.particleSpeed));
                for (const hookParticle of player.hookParticles) Instance.EntFireAtTarget({ target: hookParticle, input: "SetControlPoint", value: `1:${player.hookCP1Position.x} ${player.hookCP1Position.y} ${player.hookCP1Position.z}` });
            } else {
                for (const hookParticle of player.hookParticles) Instance.EntFireAtTarget({ target: hookParticle, input: "SetControlPoint", value: `1:${hookTargetPosition.x} ${hookTargetPosition.y} ${hookTargetPosition.z}` });
            }
            const playerPosition = player.pawn.GetAbsOrigin();
            const playerDirection = Vector3.AnglesToVector(player.pawn.GetAbsAngles());
            const currentVelocity = player.pawn.GetAbsVelocity();
            const distanceVector = Vector3.Subtract(hookTargetPosition, playerPosition);
            const distance = Vector3.Length(distanceVector);

            // 超过设定距离断开钩锁
            if (distance <= HOOK_CONFIG.maxDistance) {

                // 钩锁方向上的速度增加量
                const hookVelocityDelta = Vector3.Scale(Vector3.Normalize(distanceVector), HOOK_CONFIG.hookAccelerate);

                // 给予一些向上的加速度以抵抗重力
                currentVelocity.z += HOOK_CONFIG.degravityAccelerate;

                let playerAccelerate = HOOK_CONFIG.maxPlayerAccelerate;
                let velocityDamping = 1;

                // 根据距离长度使用分段函数计算当前玩家朝向的加速度
                if (distance < HOOK_CONFIG.maxPlayerAccelerateDistance) {
                    playerAccelerate = HOOK_CONFIG.maxPlayerAccelerate / HOOK_CONFIG.maxPlayerAccelerateDistance * distance;

                    // 当距离小于一定值时开始衰减玩家速度以便操作
                    if (distance < 500) {
                        velocityDamping = 0.99;
                    }
                }

                // 玩家朝向的速度增加量
                const playerVelocityDelta = Vector3.Scale(playerDirection, playerAccelerate);

                const newVelocity = Vector3.ClampVectorLength(Vector3.Add(Vector3.Add(currentVelocity, hookVelocityDelta), playerVelocityDelta), HOOK_CONFIG.maxSpeed);
                player.pawn.Teleport({ velocity: Vector3.Scale(newVelocity, velocityDamping) });
            } else player.ReleaseHook();
        } else player.ReleaseHook();
    }
}

/**
 * 喷气主函数
 * @param {Player} player 
 */
function JetMain(player) {
    player.CheckJet();
    if (player.isJetting) {
        const ground = player.pawn.GetGroundEntity();
        if ((!ground || !ground.IsValid())) {
            if (player.gas >= JET_CONFIG.gasCost) {
                player.gas -= JET_CONFIG.gasCost;
                const currentVelocity = player.pawn.GetAbsVelocity();

                // 给予一些向上的加速度以抵抗重力
                currentVelocity.z += JET_CONFIG.degravityAccelerate;

                const forward = Vector3.AnglesToVector(player.pawn.GetEyeAngles());
                const newVelocity = Vector3.ClampVectorLength(Vector3.Add(currentVelocity, Vector3.Scale(forward, JET_CONFIG.accelerate)), JET_CONFIG.maxSpeed);
                player.pawn.Teleport({ velocity: newVelocity });
            } else {
                player.ShowSpecialHudHint("gas_deficiency");
                player.StopJet();
            }
        } else player.StopJet();
    }
}

/**
 * 旋风斩主函数
 * @param {Player} player 
 */
function BladeRotaMain(player) {
    if (player.isBladeRotating) {
        const speed = Vector3.Length(player.pawn.GetAbsVelocity());
        if (player.pawn.GetActiveWeapon()?.GetClassName() === "weapon_knife") {
            if (player.blade >= BLADE_ROTA_CONFIG.bladeCost) {
                if (speed > BLADE_ROTA_CONFIG.minSpeed) {
                    player.blade -= BLADE_ROTA_CONFIG.bladeCost;
                } else {
                    player.StopBladeRota();
                    player.ShowSpecialHudHint("blade_rota_speed_deficiency");
                }
            } else {
                player.StopBladeRota();
                player.ShowSpecialHudHint("blade_deficiency");
            }
        } else player.StopBladeRota();
    }
}

/**
 * 道具主函数
 * @param {Player} player 
 */
function ItemMain(player) {
    if (player.item !== "") {
        const pistol = player.pawn.FindWeaponBySlot(CSGearSlot.PISTOL);
        if (pistol && pistol.IsValid()) {
            switch (player.item) {
                case "supply_box":
                    CheckPlaceableItem("supply_box", player);
                    break;
            }
        } else {

            // 手枪不存在则自动丢弃道具
            player.item = "";
            if (player.preparativeModel) {
                Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Alpha", value: 0 });
            }
            player.preparativeModel = undefined;
        }
    }
}
/** ----------------------------------------- 主函数 ----------------------------------------- */




/** ----------------------------------------- 伤害系统 ----------------------------------------- */
Instance.OnModifyPlayerDamage((event) => {
    if (event.damageTypes === 1 << 9 || event.damageTypes === 1 << 6) return;
    const pawn = event.player;
    if (!pawn.IsValid()) return;
    const attackerPawn = /** @type {CSPlayerPawn|undefined} */ (event.attacker);
    if (!attackerPawn || !attackerPawn.IsValid()) return;

    if (!playerState.has(attackerPawn)) return;
    const attacker = /** @type {Player} */ (playerState.get(attackerPawn));
    if (!playerState.has(pawn)) return;
    const player = /** @type {Player} */ (playerState.get(pawn));

    if (attackerPawn.GetClassName() === "player") {
        if (attackerPawn.GetTeamNumber() === 3) {
            if (player.isTitan) {
                const damage = GetHumanDamage(attacker, player);
                if (player.afkTime <= CONFIG.afkTime) attacker.AddEXPFromDamage(damage);
                return { damage: damage, damageTypes: 1 << 6 };
            } else {

                // 刷挂机玩家不加经验
                if (player.afkTime <= CONFIG.afkTime) attacker.AddEXPFromDamage(event.damage);
            }
        } else if (attackerPawn.GetTeamNumber() === 2) {
            attacker.AddEXP(CONFIG.expPerInfect);
        }
    }
});

Instance.OnKnifeAttack((event) => {
    const pawn = event.weapon.GetOwner();
    if (!pawn || !pawn.IsValid()) return;
    if (!playerState.has(pawn)) return;
    const player = /** @type {Player} */ (playerState.get(pawn));
    if (player.team === 3) {
        if (stageState.isV6) return;
        if (event.attackType === CSWeaponAttackType.SECONDARY) {
            if (!player.isBladeRotating) player.CheckBladeRota();
        } else if (event.attackType === CSWeaponAttackType.PRIMARY) {
            if (player.isBladeRotating) player.StopBladeRota();
        }
    } else if (player.isTitan) {
        player.TitanAttack(event.attackType);
    }
});

Instance.OnScriptInput("HitZombieBox", (inputData) => {
    const attackerEntity = /** @type {CSPlayerPawn|undefined} */ (inputData.activator);
    if (!attackerEntity || !attackerEntity.IsValid()) return;
    const pawn = /** @type {CSPlayerPawn|undefined} */ (inputData.caller?.GetParent());
    if (!pawn || !pawn.IsValid()) return;

    if (!playerState.has(pawn)) return;
    const player = /** @type {Player} */ (playerState.get(pawn));

    if (attackerEntity.GetClassName() === "player") {
        if (!playerState.has(attackerEntity)) return;
        const attacker = /** @type {Player} */ (playerState.get(attackerEntity));
        const damage = GetHumanDamage(attacker, player);
        if (player.afkTime <= CONFIG.afkTime) attacker.AddEXPFromDamage(damage);
        pawn.TakeDamage({ damage: damage, attacker: attackerEntity, damageTypes: 1 << 6 });
    } else if (attackerEntity.GetEntityName().startsWith("player_blade_rota_hurt")) {
        const attackerPawn = /** @type {CSPlayerPawn|undefined} */ (attackerEntity.GetParent());
        if (!playerState.has(attackerPawn)) return;
        const attacker = /** @type {Player} */ (playerState.get(attackerPawn));
        if (attackerPawn && attackerPawn.IsValid()) {
            const damage = GetHumanDamage(attacker, player);
            if (player.afkTime <= CONFIG.afkTime) attacker.AddEXPFromDamage(damage);
            pawn.TakeDamage({ damage: damage, attacker: attackerEntity, damageTypes: 1 << 6 });
        }
    }
});

/**
 * 获取人类玩家对僵尸造成的伤害并生成伤害数据文本
 * @param {Player} attacker 
 * @param {Player} player 
 * @returns 
 */
function GetHumanDamage(attacker, player) {
    const headPosition = player.pawn.GetEyePosition();
    // Instance.DebugSphere({ center: headPosition, radius: 15 * player.scale, duration: 5, color: { r: 255, g: 0, b: 0 } });

    let damage = 0;
    let isCrit = false;
    if (attacker.pawn.GetTeamNumber() === 3) {
        const weaponData = attacker.pawn.GetActiveWeapon()?.GetData();
        if (weaponData) {
            const attackerPosition = attacker.pawn.GetEyePosition();
            isCrit = attacker.EstimateCrit();

            if (attacker.isBladeRotating) {

                // 只有当玩家眼睛位置处于巨人眼睛位置高为30，半径为320的圆柱体内才算算旋风斩砍中后颈，其余情况削减伤害
                if (Vector3.IsPointInCylinder(attackerPosition, { x: headPosition.x, y: headPosition.y, z: headPosition.z - 15 * player.scale }, 30 * player.scale, 320)) {
                    SpawnAttackParticle({ x: headPosition.x, y: headPosition.y, z: headPosition.z - 5 * player.scale });
                    damage = isCrit ? attacker.bladeRotaDamage * attacker.critMulti : attacker.bladeRotaDamage;
                } else {
                    damage = isCrit ? attacker.bladeRotaDamage * attacker.critMulti * 0.1 : attacker.bladeRotaDamage * 0.1;
                }
            } else {
                if (weaponData.GetName() === "weapon_knife") {
                    if (attacker.blade >= CONFIG.bladeCost) {

                        // 只有当玩家眼睛位置处于巨人眼睛位置15个单位内且处于持刀状态下才算做砍击后颈，其余情况削减伤害
                        if (Vector3.IsPointInSphere(attackerPosition, headPosition, 15 * player.scale)) {
                            SpawnAttackParticle({ x: headPosition.x, y: headPosition.y, z: headPosition.z - 5 * player.scale });
                            damage = isCrit ? attacker.humanAttackDamage * attacker.critMulti : attacker.humanAttackDamage;
                        } else {
                            damage = isCrit ? attacker.humanAttackDamage * attacker.critMulti * 0.1 : attacker.humanAttackDamage * 0.1;
                        }
                        attacker.blade -= CONFIG.bladeCost;

                        // 耐久度耗尽时大幅削减伤害
                    } else {
                        damage = attacker.humanAttackDamage * 0.05;
                        attacker.ShowSpecialHudHint("blade_deficiency");
                    }
                } else {
                    damage = isCrit ? weaponData.GetDamage() * attacker.critMulti : weaponData.GetDamage();
                }
            }
        }
    }
    const randomPosition = Vector3.RandomPointOnSphere(headPosition, 20 * player.scale);
    SpawnDamageText(damage, randomPosition, isCrit);
    return damage;
}

/**
 * 生成攻击反馈特效
 * @param {import("cs_script/point_script").Vector} position 
 */
function SpawnAttackParticle(position) {
    // @ts-ignore
    const particle = Instance.FindEntityByName("attack_particle_temp").ForceSpawn(position)[0];
    Instance.EntFireAtTarget({ target: particle, input: "Kill", delay: 3 });
}

/**
 * 生成伤害数据文本
 * @param {number} damage 
 * @param {import("cs_script/point_script").Vector} position 
 * @param {boolean} isCrit 
 */
function SpawnDamageText(damage, position, isCrit = false) {
    const showDamage = Math.round(damage);
    if (isCrit) {
        // @ts-ignore
        const entities = Instance.FindEntityByName("damage_crit_text_temp").ForceSpawn(position);
        for (const entity of entities) {
            if (entity.GetClassName() === "point_worldtext") {
                Instance.EntFireAtTarget({ target: entity, input: "SetMessage", value: `暴击\n${showDamage}` });
                Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 3 });
            } else {
                Instance.EntFireAtTarget({ target: entity, input: "EnableMotion", delay: 1 });
                Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 3 });
            }
        }
    } else {
        if (damage > 2000) {
            // @ts-ignore
            const entities = Instance.FindEntityByName("damage_strength_text_temp").ForceSpawn(position);
            for (const entity of entities) {
                if (entity.GetClassName() === "point_worldtext") {
                    Instance.EntFireAtTarget({ target: entity, input: "SetIntMessage", value: showDamage });
                    Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 3 });
                } else {
                    Instance.EntFireAtTarget({ target: entity, input: "EnableMotion", delay: 1 });
                    Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 3 });
                }
            }
        } else {
            // @ts-ignore
            const entities = Instance.FindEntityByName("damage_normal_text_temp").ForceSpawn(position);
            for (const entity of entities) {
                if (entity.GetClassName() === "point_worldtext") {
                    Instance.EntFireAtTarget({ target: entity, input: "SetIntMessage", value: showDamage });
                    Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 2 });
                } else {
                    Instance.EntFireAtTarget({ target: entity, input: "EnableMotion", delay: 1 });
                    Instance.EntFireAtTarget({ target: entity, input: "Kill", delay: 2 });
                }
            }
        }
    }
}
