Instance.OnScriptInput("AddLevel", (inputData) => {
    const pawn = inputData.activator;
    if (!pawn || !pawn.IsValid()) return;
    playerState.get(pawn)?.AddLevel();
});

Instance.OnScriptInput("MaxLevel", (inputData) => {
    const pawn = inputData.activator;
    if (!pawn || !pawn.IsValid()) return;
    playerState.get(pawn)?.AddLevel(15);
});

Instance.OnScriptInput("TestMsg", (inputData) => {
    const pawn = inputData.activator;
    if (!pawn || !pawn.IsValid()) return;
    playerState.get(pawn)?.SendMessage("test");
});

Instance.OnPlayerChat((event) => {
    if (event.text === "!显示当前Tick") {
        Delay(0.5, () => Instance.ServerCommand("say [调试功能]：当前脚本Tick为" + (1 / timeDelta)));
    }
});
/** ----------------------------------------- 调试功能 ----------------------------------------- */




/** ----------------------------------------- 延迟函数 ----------------------------------------- */
/** @type {{callback: () => void, remaining: number}[]} */
const thinkQueue = [];

/**
 * 添加一个延迟任务
 * @param {number} delaySeconds - 延迟秒数
 * @param {() => void} callback - 要执行的回调函数
 */
function Delay(delaySeconds, callback) {
    thinkQueue.push({
        callback,
        remaining: delaySeconds,
    });
}

/**
 * 处理延迟任务
 */
function DelayMain() {
    for (let i = thinkQueue.length - 1; i >= 0; i--) {
        const task = thinkQueue[i];
        task.remaining -= timeDelta;
        if (task.remaining <= 0) {
            try {
                task.callback();
            } catch (e) {
                Instance.Msg("延迟函数错误");
            }
            thinkQueue.splice(i, 1);
        }
    }
}
