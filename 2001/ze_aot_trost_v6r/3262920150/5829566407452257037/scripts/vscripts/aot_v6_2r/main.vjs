let timeDelta = 1 / 64;             // Think循环的时间变化量
let lastThinkTime = 0;              // 上次循环的时间

const CONFIG = {
    afkTime: 20,                        // 判定挂机的时间
    maxHumanHealth: 1000,               // 人类基础最大生命值
    maxZombieHealth: 20000,             // 僵尸基础最大生命值
    maxLevel: 15,                       // 最大等级
    maxGas: 75,                         // 基础最大气体量
    maxBlade: 50,                       // 基础最大刀片耐久度
    hookDistance: 1700,                 // 钩锁基础最大距离
    gasRevert: timeDelta * 5.5,         // 气体基础自然恢复量
    critRate: 0.05,                     // 基础暴击率
    critMulti: 2,                       // 基础暴击倍率
    humanAttackDamage: 10000,           // 人类基础攻击力
    titanAttackDamage: 500,             // 巨人基础攻击力
    bladeRotaDamage: 5000,              // 旋风斩基础攻击力
    bladeCost: 1,                       // 使用刀击中后颈时的刀片耐久消耗
    expPerKill: 500,                    // 每个击杀获得的经验点数
    expPerInfect: 300,                  // 每个感染获得的经验点数
};

const HOOK_CONFIG = {
    maxSpeed: 1000,                         // 最大速度
    maxDistance: 5000,                      // 最大距离，超过距离自动断开钩锁
    degravityAccelerate: 600 * timeDelta,   // 抵抗重力的加速度
    hookAccelerate: 2000 * timeDelta,       // 钩锁方向上的加速度
    maxPlayerAccelerate: 2000 * timeDelta,  // 玩家朝向方向的最大加速度
    maxPlayerAccelerateDistance: 1500,      // 玩家朝向方向加速的开始衰减的距离
    particleSpeed: 75,                      // 钩锁终端的移动速度
    gasCost: 50                             // 使用一次钩锁的气体消耗
};

const JET_CONFIG = {
    maxSpeed: 1000,                         // 最大速度
    triggerTime: 0.1,                       // 触发飞行所需要的按键时长
    accelerate: 1000 * timeDelta,           // 加速度
    degravityAccelerate: 600 * timeDelta,   // 抵抗重力的加速度
    gasCost: timeDelta * 100,               // 喷气的气体消耗
    minGas: 10                              // 开始喷气需要的最小气体量
};

const BLADE_ROTA_CONFIG = {
    minSpeed: 600,                      // 旋风斩时需要的最小速度
    bladeCost: timeDelta * 10           // 旋风斩的刀片耐久消耗
};

const stageState = {
    isBattleGrounds: false,         // 非大战场关卡禁用复活对僵尸的体型设置
    // isBattleGrounds: true
    isV6: true,                     // v6模式中禁用旋风斩与血量设置
    isEnding: false,                // 结尾时禁用立体机动
    isStart: true                   // 开局30秒内禁用立体机动
};

const items = ["supply_box"];

class Player {
    #_pawn;
    #_slot;
    #_team;
    #_isFullLevel;
    isSQ;
    #_isHooking;
    #_isJetting;
    #_jetTriggerTime;
    #_isBladeRotating;
    #_level;
    #_exp;
    #_maxEXP;
    #_maxHealth;
    #_gas;
    #_maxGas;
    #_blade;
    #_afkTime;
    #_lastAFKAngles;
    #_maxBlade;
    #_agility;
    #_stength;
    #_wisdom;
    #_critRate;
    #_critMulti;
    #_maxHumanHealth;
    #_maxZombieHealth;
    #_scale;
    /** @param {CSPlayerPawn} playerPawn */
    constructor(playerPawn) {

        // 基础数据
        this.#_pawn = playerPawn;
        this.name = "";
        this.#_slot = -1;

        // 玩家状态数据
        this.#_team = playerPawn.GetTeamNumber();
        this.#_isFullLevel = false;
        this.isSQ = false;        // 检测是否为神器手（V6专属）
        this.isHero = false;
        this.isTitan = false;
        this.isShifter = false;
        this.#_isHooking = false;
        this.#_isJetting = false;
        this.#_jetTriggerTime = 0;
        this.#_isBladeRotating = false;
        this.isHookShooting = false;
        this.hookCP1Position = { x: 0, y: 0, z: 0 };
        this.#_level = 0;
        this.#_exp = 0;
        this.#_maxEXP = 1000;
        this.#_maxHealth = 100;
        this.#_gas = CONFIG.maxGas;
        this.#_blade = CONFIG.maxBlade;
        this.item = "";
        this.itemLerpTime = 0;
        this.#_afkTime = 0;
        this.#_lastAFKAngles = { pitch: 0, yaw: 0, roll: 0 };

        // 特殊状态
        this.disableHook = false;
        this.disableJet = false;

        // 三围属性，敏捷、力量、智慧
        this.#_agility = 0;
        this.#_stength = 0;
        this.#_wisdom = 0;

        // 其他基础属性（受三围属性影响）
        this.#_critRate = CONFIG.critRate;
        this.#_critMulti = CONFIG.critMulti;
        this.#_maxHumanHealth = CONFIG.maxHumanHealth;
        this.#_maxGas = CONFIG.maxGas;
        this.#_maxBlade = CONFIG.maxBlade;
        this.humanAttackDamage = CONFIG.humanAttackDamage;
        this.titanAttackDamage = CONFIG.titanAttackDamage;
        this.bladeRotaDamage = CONFIG.bladeRotaDamage;
        this.hookDistance = CONFIG.hookDistance;
        this.gasRevert = CONFIG.gasRevert;
        this.#_maxZombieHealth = CONFIG.maxZombieHealth;

        // 其他属性
        this.#_scale = 1;

        // 关联实体
        /** @type {Entity|undefined} */
        this.ui = undefined;
        /** @type {Entity|undefined} */
        this.hookTarget = undefined;
        /** @type {Entity[]} */
        this.hookParticles = [];
        /** @type {BaseModelEntity|undefined} */
        this.preparativeModel = undefined;
    }
    get pawn() {
        return this.#_pawn;
    }
    get slot() {
        return this.#_slot;
    }
    get team() {
        return this.#_team;
    }
    get isFullLevel() {
        return this.#_isFullLevel;
    }
    get isHooking() {
        return this.#_isHooking;
    }
    get isJetting() {
        return this.#_isJetting;
    }
    get isBladeRotating() {
        return this.#_isBladeRotating;
    }
    get critRate() {
        return this.#_critRate;
    }
    get critMulti() {
        return this.#_critMulti;
    }
    get level() {
        return this.#_level;
    }
    get exp() {
        return this.#_exp;
    }
    get health() {
        return this.#_pawn.GetHealth();
    }
    get maxHealth() {
        return this.#_maxHealth;
    }
    get maxHumanHealth() {
        return this.#_maxHumanHealth;
    }
    get maxZombieHealth() {
        return this.#_maxZombieHealth;
    }
    get gas() {
        return this.#_gas;
    }
    get blade() {
        return this.#_blade;
    }
    get afkTime() {
        return this.#_afkTime;
    }
    get scale() {
        return this.#_scale;
    }
    set gas(value) {
        if (value < 0) this.#_gas = 0;
        else this.#_gas = Math.min(value, this.#_maxGas);
    }
    set blade(value) {
        if (value < 0) this.#_blade = 0;
        else this.#_blade = Math.min(value, this.#_maxBlade);
    }
    /** ---------------------------------------------------------------------------------- */




    /** ----------------------------------------- 三围属性设置 ----------------------------------------- */
    /**
     * @param {number} value
     */
    set agility(value) {
        this.#_agility = value;
        if (!this.isHero) {
            this.hookDistance = CONFIG.hookDistance + value * 100                   // 每点敏捷加100点最大钩锁距离
            this.gasRevert = CONFIG.gasRevert + value * timeDelta * 0.5             // 每点敏捷加0.5每秒气体回复量
            this.bladeRotaDamage = CONFIG.bladeRotaDamage + value * 2500;           // 每点敏捷加2500点旋风斩基础伤害
            this.#_critRate = 0.05 + value * 0.05;                                  // 每点敏捷加5%暴击率
        }
    }
    /**
     * @param {number} value
     */
    set stength(value) {
        this.#_stength = value;
        if (!this.isHero) {
            this.#_critMulti = 2 + value * 0.02;                                    // 每点力量加2%暴击伤害倍率
            this.humanAttackDamage = CONFIG.humanAttackDamage + value * 5000;       // 每点力量加5000点人类基础攻击伤害
            this.bladeRotaDamage = CONFIG.bladeRotaDamage + value * 2500;           // 每点力量加2500点旋风斩基础伤害
            this.titanAttackDamage = CONFIG.titanAttackDamage + value * 200;        // 每点力量加200点巨人基础攻击伤害
        }
    }
    /**
     * @param {number} value
     */
    set wisdom(value) {
        this.#_wisdom = value;
        if (!this.isHero) {
            this.AddMaxHealthProperty(value);                                       // 每点智慧加200点人类基础血量上限，加5000点僵尸基础血量上限
            this.SetMaxBlade(CONFIG.maxBlade + value * 10);                         // 每点智慧加10点刀片耐久上限
            this.SetMaxGas(CONFIG.maxGas + value * 20);                             // 每点智慧加20点气体上限
        }
    }
    /** ----------------------------------------- 三围属性设置 ----------------------------------------- */




    /** ----------------------------------------- 血量相关设置 ----------------------------------------- */
    set health(value) {
        if (value <= 0) {
            this.#_pawn.Kill();
        } else {
            this.#_pawn.SetHealth(Math.min(value, this.#_maxHealth));
        }
    }
    set maxHealth(value) {
        this.#_maxHealth = value;
        this.#_pawn.SetMaxHealth(value);
    }
    /**
     * 按指定倍率增加基础血量上限属性
     * @param {number} value 
     */
    AddMaxHealthProperty(value) {
        this.#_maxHumanHealth = CONFIG.maxHumanHealth + 200 * value;
        this.#_maxZombieHealth = CONFIG.maxZombieHealth + 5000 * value;
        if (stageState.isV6) return;
        if (this.#_team === 2) {
            this.SetMaxHealthAndHeal(this.#_maxZombieHealth);
        } else if (this.#_team === 3) {
            this.SetMaxHealthAndHeal(this.#_maxHumanHealth);
        }
    }
    /**
     * 增加血量
     * @param {number} value 
     */
    Heal(value) {
        this.#_pawn.SetHealth(Math.min(this.health + value, this.#_maxHealth));
    }
    /**
     * 设置最大血量并根据增加的值恢复当前血量
     * @param {number} value 
     */
    SetMaxHealthAndHeal(value) {
        const healthDelta = value - this.#_maxHealth;
        this.maxHealth = value;
        if (healthDelta > 0) this.Heal(healthDelta);
        else if (this.health > value) this.health = value;
    }
    /**
     * 检查血量状态并设置对应颜色
     */
    CheckLowHP() {
        if (stageState.isV6) return;
        let lowHP = CONFIG.maxZombieHealth * 0.5;
        if (this.#_team === 3) {
            lowHP = CONFIG.maxHumanHealth * 0.5;
        }
        if (this.health < lowHP) {
            const colorGB = Math.floor(this.health / lowHP * 100 + 155);
            Instance.EntFireAtTarget({ target: this.#_pawn, input: "Color", value: `255 ${colorGB} ${colorGB}` });
        } else {
            Instance.EntFireAtTarget({ target: this.#_pawn, input: "Color", value: `255 255 255` });
        }
    }
    /** ----------------------------------------- 血量相关设置 ----------------------------------------- */




    /** ----------------------------------------- 挂机检测 ----------------------------------------- */
    /**
     * 超过30秒判定为挂机
     */
    AFKDetect() {
        const currentAngles = this.#_pawn.GetEyeAngles();
        if (Vector3.IsAnglesEqual(currentAngles, this.#_lastAFKAngles)) {
            if (this.#_afkTime > CONFIG.afkTime) {
                this.SetAndShowMessage("你已被标记为挂机状态\n请移动屏幕以解除");
            } else {
                this.#_afkTime += timeDelta;
            }
        } else {
            if (this.#_afkTime > CONFIG.afkTime) this.HideMessage();
            this.#_afkTime = 0;
            this.#_lastAFKAngles = currentAngles;
        }
    }
    /** ----------------------------------------- 挂机检测 ----------------------------------------- */




    /** ----------------------------------------- 神器手检查（V6专属） ----------------------------------------- */
    /**
     * 检查神器手枪是否存在
     */
    CheckSQ() {
        if (this.isSQ) {
            const pistol = this.#_pawn.FindWeaponBySlot(CSGearSlot.PISTOL);
            if (!pistol || !pistol.IsValid()) {
                this.isSQ = false;
                this.disableHook = false;
            }
        }
    }
    /** ----------------------------------------- 神器手检查（V6专属） ----------------------------------------- */




    /** ----------------------------------------- UI相关设置 ----------------------------------------- */
    /**
     * 更新UI内容
     */
    UpdateUI() {
        if (this.#_pawn.IsInputPressed(CSInputs.WALK)) {
            this.#ShowDetailedUI();
        } else {
            this.#ShowDefaultUI();
        }
    }
    /**
     * 显示默认UI内容
     */
    #ShowDefaultUI() {
        let msg = "";
        if (!this.isFullLevel) {
            msg += `等级：${(this.#_level)}\n经验：${Math.floor(this.#_exp)}/${this.#_maxEXP}\n`;
        } else {
            msg += `等级：${(this.#_level)}\n经验：等级已满\n`;
        }
        if (this.#_team === 3) {
            if (!stageState.isV6) msg += `刀片耐久：${GetProgressBar(this.#_blade, this.#_maxBlade, 20)}\n`;
            if (this.#_level > 2) msg += `剩余气体：${GetProgressBar(this.#_gas, this.#_maxGas, 20)}`;
        }
        this.SetUiMessage(msg);
    }
    /**
     * 显示详细参数
     */
    #ShowDetailedUI() {
        let msg = `敏捷：${this.#_agility.toFixed(2)}\n力量：${this.#_stength.toFixed(2)}\n智慧：${this.#_wisdom.toFixed(2)}\n`;
        if (this.#_team === 3) {
            msg += `基础攻击力：${Math.round(this.humanAttackDamage)}\n耐久值上限：${Math.round(this.#_maxBlade)}\n`;
            if (this.#_level > 2) {
                msg += `气体量上限：${Math.round(this.#_maxGas)}\n气体回复量：${(this.gasRevert * (1 / timeDelta)).toFixed(2)} / s\n`;
                if (this.#_level > 3) {
                    msg += `钩锁距离：${Math.round(this.hookDistance)}\n`;
                    if (this.#_level > 4) {
                        msg += `旋风斩伤害：${Math.round(this.bladeRotaDamage)}`;
                    }
                }
            }
        }
        this.SetUiMessage(msg);
    }
    /**
     * 设置UI显示内容
     * @param {string} msg 
     */
    SetUiMessage(msg) {
        if (this.ui && this.ui.IsValid()) Instance.EntFireAtTarget({ target: this.ui, input: "SetMessage", value: msg });
    }
    /**
     * 对玩家发送一条消息
     * @param {string} msg 
     * @param {number} duration 持续时间
     */
    SendMessage(msg, duration = 3) {
        const entityName = "player_msg_text_" + this.#_slot;
        Instance.EntFireAtName({ name: entityName, input: "SetMessage", value: msg });
        Instance.EntFireAtName({ name: entityName, input: "Enable" });
        Instance.EntFireAtName({ name: entityName, input: "Disable", delay: duration });
    }
    /**
     * 对玩家发送并显示一条消息
     * @param {string} msg 
     */
    SetAndShowMessage(msg) {
        const entityName = "player_msg_text_" + this.#_slot
        Instance.EntFireAtName({ name: entityName, input: "SetMessage", value: msg });
        Instance.EntFireAtName({ name: entityName, input: "Enable" });
    }
    /**
     * 隐藏消息显示
     */
    HideMessage() {
        Instance.EntFireAtName({ name: "player_msg_text_" + this.#_slot, input: "Disable" });
    }
    /**
     * 显示特殊的hudhint内容（无需cs2fix）
     * @param {string} msg 
     */
    ShowSpecialHudHint(msg) {
        Instance.EntFireAtName({ name: "hudhint_" + msg, input: "ShowHudHint", activator: this.pawn });
    }
    /**
     * 显示指定内容的hudhint（需要cs2fix）
     * @param {string} msg 
     */
    ShowHudHint(msg) {
        Instance.EntFireAtName({ name: "hudhint_any", input: "SetMessage", value: msg });
        Instance.EntFireAtName({ name: "hudhint_any", input: "ShowHudHint", activator: this.pawn });
    }
    /** ----------------------------------------- UI相关设置 ----------------------------------------- */




    /** ----------------------------------------- 等级与经验设置 ----------------------------------------- */
    /**
     * 增加经验
     * @param {number} value 
     */
    AddEXP(value) {
        if (this.isFullLevel) return;
        this.#_exp += value;
        while (this.#_exp >= this.#_maxEXP) {
            this.#_exp -= this.#_maxEXP;
            this.AddLevel();
        }
    }
    /**
     * 从攻击伤害获取经验
     * @param {number} damage 
     */
    AddEXPFromDamage(damage) {
        this.AddEXP(Math.log(1 + damage) * 2);
    }
    /**
     * 增加等级
     * @param {number} value 
     */
    AddLevel(value = 1) {
        if (this.isFullLevel) return;
        let trueLevelAdd = value;
        const currentLevel = this.#_level + value;
        if (currentLevel < CONFIG.maxLevel) {
            this.#_level = currentLevel;
        } else if (currentLevel === CONFIG.maxLevel) {
            this.#_level = CONFIG.maxLevel;
            this.#_isFullLevel = true;
            this.#_exp = 0;
        } else {
            trueLevelAdd = CONFIG.maxLevel - this.#_level;
            this.#_level = CONFIG.maxLevel;
            this.#_isFullLevel = true;
            this.#_exp = 0;
        }
        // 每升一级增加总和为1的随机三围数值
        const randomNumbers = GenerateThreeDecimals(trueLevelAdd, 0.2);
        this.agility = this.#_agility + randomNumbers[0];
        this.stength = this.#_stength + randomNumbers[1];
        this.wisdom = this.#_wisdom + randomNumbers[2];
        this.#_maxEXP = this.#_level * 650 + 500;              // 升级需要的经验为固定650点加每级500点
        if (this.#_team === 3) {
            if (this.#_level === 3) this.ShowSpecialHudHint("learn_jet");
            else if (this.#_level === 4) this.ShowSpecialHudHint("get_hook");
            else if (this.#_level === 5) this.ShowSpecialHudHint("learn_blade_rota");
            else this.ShowSpecialHudHint("level_up");
        } else this.ShowSpecialHudHint("level_up");
    }
    /**
     * 增加等级并清空经验
     * @param {number} value 
     */
    AddLevelAndEmptyEXP(value) {
        this.#_exp = 0;
        this.AddLevel(value);
    }
    /** ----------------------------------------- 等级与经验设置 ----------------------------------------- */




    /** ----------------------------------------- 攻击系统 ----------------------------------------- */
    /**
     * 巨人普通攻击
     * @param {CSWeaponAttackType} attackType
     */
    TitanAttack(attackType) {
        let damage = this.titanAttackDamage;
        let distance = 48 * this.#_scale;
        if (attackType === CSWeaponAttackType.SECONDARY) {
            damage *= 3;
            distance = 32 * this.#_scale;
        }
        const start = this.#_pawn.GetEyePosition();
        const forward = Vector3.AnglesToVector(this.#_pawn.GetEyeAngles());
        const end = Vector3.Add(start, Vector3.Scale(forward, distance));
        let zombies = /** @type {Entity[]} */ ([]);
        playerState.forEach((/** @type {Player} */player, pawn) => {
            if (player.#_team === 2) {
                zombies.push(player.pawn);
                if (player.isTitan) {
                    const hitbox = Instance.FindEntityByName("player_hitbox_phy_" + player.slot);
                    if (hitbox && hitbox.IsValid()) zombies.push(hitbox);
                }
            }
        });
        const result = Instance.TraceSphere({
            start,
            end,
            radius: 15 * this.#_scale,
            ignoreEntity: zombies
        });
        // Instance.DebugSphere({ center: result.end, radius: 15 * this.#_scale, duration: 1 });
        if (result.didHit && result.hitEntity && result.hitEntity.IsValid()) {
            if (result.hitEntity.GetClassName() === "player") {
                this.AddEXPFromDamage(damage);
                result.hitEntity.TakeDamage({ damage: damage, attacker: this.#_pawn, damageTypes: 1 << 9 });
                const attackParticlePosition = result.hitEntity.GetAbsOrigin();
                attackParticlePosition.z += 32;
                SpawnAttackParticle(attackParticlePosition);
            } else {
                const lineEnd = Vector3.Add(end, Vector3.Scale(forward, 15));
                const lineResult = Instance.TraceLine({
                    start,
                    end: lineEnd,
                    ignoreEntity: zombies
                });
                if (lineResult.hitEntity?.GetClassName() === "player") {
                    this.AddEXPFromDamage(damage);
                    result.hitEntity.TakeDamage({ damage: damage, attacker: this.#_pawn, damageTypes: 1 << 9 });
                    const attackParticlePosition = result.hitEntity.GetAbsOrigin();
                    attackParticlePosition.z += 32;
                    SpawnAttackParticle(attackParticlePosition);
                }
            }
        }
    }
    /** ----------------------------------------- 攻击系统 ----------------------------------------- */




    /** ----------------------------------------- 钩锁系统 ----------------------------------------- */
    /**
     * 检查玩家是否具备钩锁条件并检查是否发射钩锁
     */
    CheckHook() {
        if (this.#_pawn.WasInputJustPressed(CSInputs.USE) && this.#_level > 3 && !stageState.isEnding && !stageState.isStart) {
            if (!this.#_isHooking) {
                if (this.#_gas >= HOOK_CONFIG.gasCost && !this.disableHook) this.#TryShootHook();
                else this.ShowSpecialHudHint("gas_deficiency");
            } else this.ReleaseHook();
        }
    }
    /**
     * 尝试发射钩锁
     */
    #TryShootHook() {
        const startPosition = this.#_pawn.GetEyePosition();
        const angles = this.#_pawn.GetEyeAngles();
        const forward = Vector3.AnglesToVector(angles);
        const endPosition = Vector3.Add(startPosition, Vector3.Scale(forward, this.hookDistance));
        const ignoreEntities = Instance.FindEntitiesByClass("func_button");
        const result = Instance.TraceLine({
            start: startPosition,
            end: endPosition,
            ignorePlayers: true,
            ignoreEntity: ignoreEntities
        });
        if (result.didHit) {
            if (result.hitEntity && result.hitEntity.IsValid()) {
                // @ts-ignore
                this.hookTarget = /** @type {Entity} */ (Instance.FindEntityByName("hook_target_temp").ForceSpawn(result.end)[0]);
                if (result.hitEntity.GetEntityName() === "worldent") {
                    this.#ShootHook();
                } else {
                    Instance.EntFireAtTarget({ target: this.hookTarget, input: "SetParent", value: "!activator", activator: result.hitEntity });
                    this.#ShootHook();
                }
            }
        } else this.ShowSpecialHudHint("hook_miss");
    }
    /**
     * 发射钩锁
     */
    #ShootHook() {
        this.#_isHooking = true;
        this.isHookShooting = true;
        this.gas -= HOOK_CONFIG.gasCost;
        for (const hookParticle of this.hookParticles) {
            this.hookCP1Position = hookParticle.GetAbsOrigin();
            Instance.EntFireAtTarget({ target: hookParticle, input: "Start" });
        }
        Instance.EntFireAtName({ name: "sound_hook_shoot", input: "SetSourceEntity", value: "player_blade_rota_particle_" + this.#_slot });
        Instance.EntFireAtName({ name: "sound_hook_shoot", input: "StartSound" });
        const currentVelocity = this.#_pawn.GetAbsVelocity();
        if (currentVelocity.z <= 0) currentVelocity.z += 200;
        this.#_pawn.Teleport({ velocity: currentVelocity });
    }
    /**
     * 松开钩锁
     */
    ReleaseHook() {
        this.#_isHooking = false;
        this.isHookShooting = false;
        for (const hookParticle of this.hookParticles) Instance.EntFireAtTarget({ target: hookParticle, input: "DestroyImmediately" });
        if (this.hookTarget && this.hookTarget.IsValid()) Instance.EntFireAtTarget({ target: this.hookTarget, input: "Kill" });
        Instance.EntFireAtName({ name: "sound_hook_release", input: "SetSourceEntity", value: "player_blade_rota_particle_" + this.#_slot });
        Instance.EntFireAtName({ name: "sound_hook_release", input: "StartSound" });
        this.hookTarget = undefined;
    }
    /**
     * 设置最大气体量并补齐差异量
     * @param {number} value
     */
    SetMaxGas(value) {
        if (value > this.#_maxGas) this.#_gas += value - this.#_maxGas;
        else if (this.#_gas > value) this.#_gas = value;
        this.#_maxGas = value;
    }
    /**
     * 自然恢复气体
     */
    GasRevert() {
        this.gas += this.gasRevert;
    }
    /** ----------------------------------------- 钩锁系统 ----------------------------------------- */




    /** ----------------------------------------- 喷气系统 ----------------------------------------- */
    /**
     * 检查玩家是否具备喷气条件并检查是否按下喷气键
     */
    CheckJet() {
        if (this.#_level > 2) {
            if (!this.#_isJetting && this.#_pawn.IsInputPressed(CSInputs.JUMP) && !stageState.isEnding && !stageState.isStart && !this.disableJet) {
                if (this.#_jetTriggerTime >= JET_CONFIG.triggerTime) {
                    this.#_jetTriggerTime = 0;
                    const groundEntity = this.#_pawn.GetGroundEntity();
                    if (!groundEntity || !groundEntity.IsValid()) {
                        if (this.#_gas >= JET_CONFIG.minGas) this.#StartJet();
                        else this.ShowSpecialHudHint("gas_deficiency");
                    }
                } else {
                    this.#_jetTriggerTime += timeDelta;
                }
            }
            if (this.#_pawn.WasInputJustReleased(CSInputs.JUMP)) {
                this.StopJet();
                this.#_jetTriggerTime = 0;
            }
        }
    }
    /**
     * 开始喷气
     */
    #StartJet() {
        this.#_isJetting = true;
        Instance.EntFireAtName({ name: "player_jet_particle_" + this.#_slot, input: "Start" });
        Instance.EntFireAtName({ name: "sound_jet", input: "SetSourceEntity", value: "player_hook_model_particle_" + this.#_slot });
        Instance.EntFireAtName({ name: "sound_jet", input: "StartSound" });
    }
    /**
     * 停止喷气
     */
    StopJet() {
        this.#_isJetting = false;
        Instance.EntFireAtName({ name: "player_jet_particle_" + this.#_slot, input: "Stop" });
    }
    /** ----------------------------------------- 喷气系统 ----------------------------------------- */




    /** ----------------------------------------- 旋风斩系统 ----------------------------------------- */
    /**
     * 检查玩家是否具备旋风斩条件
     */
    CheckBladeRota() {
        if (this.#_level > 4) {
            if (this.#_blade >= BLADE_ROTA_CONFIG.bladeCost) {
                const speed = Vector3.Length(this.#_pawn.GetAbsVelocity());
                if (speed > BLADE_ROTA_CONFIG.minSpeed) this.#StartBladeRota();
                else this.ShowSpecialHudHint("blade_rota_speed_deficiency");
            } else this.ShowSpecialHudHint("blade_deficiency");
        }
    }
    /**
     * 开始旋风斩
     */
    #StartBladeRota() {
        this.#_isBladeRotating = true;
        Instance.EntFireAtName({ name: "player_blade_rota_particle_" + this.#_slot, input: "Start" });
        Instance.EntFireAtName({ name: "player_blade_rota_hurt_" + this.#_slot, input: "Enable" });
    }
    /**
     * 停止旋风斩
     */
    StopBladeRota() {
        this.#_isBladeRotating = false;
        Instance.EntFireAtName({ name: "player_blade_rota_particle_" + this.#_slot, input: "Stop" });
        Instance.EntFireAtName({ name: "player_blade_rota_hurt_" + this.#_slot, input: "Disable" });
    }
    /**
     * 设置最大刀片耐久并补齐差异量
     * @param {number} value
     */
    SetMaxBlade(value) {
        if (value > this.#_maxBlade) this.#_blade += value - this.#_maxBlade;
        else if (this.#_blade > value) this.#_blade = value;
        this.#_maxBlade = value;
    }
    /** ----------------------------------------- 旋风斩系统 ----------------------------------------- */




    /** ----------------------------------------- 道具系统 ----------------------------------------- */
    /**
     * 获取道具
     * @param {string} value 
     * @param {BaseModelEntity} preparativeModel 
     */
    GetItem(value, preparativeModel) {
        this.item = value;
        this.preparativeModel = preparativeModel;
        this.itemLerpTime = 0;
        Instance.EntFireAtTarget({ target: preparativeModel, input: "ClearParent" });
        Instance.EntFireAtTarget({ target: preparativeModel, input: "Alpha", value: 0 });
    }
    /** ----------------------------------------- 道具系统 ----------------------------------------- */




    /** ----------------------------------------- 初始化函数 ----------------------------------------- */
    /**
     * 玩家初始化
     */
    Init() {
        this.#PlayerNameInit();
        this.AddLevel();
    }
    /**
     * 重置参数
     */
    Reset() {
        this.#_team = this.#_pawn.GetTeamNumber();
        this.item = "";
        this.#PropertiesInit();
        if (this.#_team === 2) this.#ZombieReset();
        else if (this.#_team === 3) this.#HumanReset();
    }
    /**
     * 重置僵尸参数
     */
    #ZombieReset() {
        this.isTitan = false;
        this.isShifter = false;
        if (!stageState.isV6) {
            Delay(1, () => {
                this.maxHealth = this.#_maxZombieHealth;
                this.health = this.maxHealth;
            });
        }
        for (const hookParticle of this.hookParticles) Instance.EntFireAtTarget({ target: hookParticle, input: "Kill" });
        this.hookParticles.length = 0;
        Instance.EntFireAtName({ name: "player_blade_rota_particle_" + this.#_slot, input: "Kill" });
        Instance.EntFireAtName({ name: "player_blade_rota_hurt_" + this.#_slot, input: "Kill" });
        Instance.EntFireAtName({ name: "player_hook_model_particle_" + this.#_slot, input: "Kill" });
        Instance.EntFireAtName({ name: "player_jet_particle_" + this.#_slot, input: "Kill" });
        if (stageState.isBattleGrounds) {
            this.#ZombieScaleInit();
        }
        const position = this.#_pawn.GetAbsOrigin();
        const angles = this.#_pawn.GetAbsAngles();
        this.#RespawnUI(position, angles, this.#_scale);
        this.#RespawnMsg(position, angles, this.#_scale);
        if (this.#_isHooking) this.ReleaseHook();
        if (this.#_isJetting) this.StopJet();
        if (this.#_isBladeRotating) this.StopBladeRota();
    }
    /**
     * 重置人类参数
     */
    #HumanReset() {
        this.isSQ = false;
        this.disableHook = false;
        this.disableJet = false;
        this.isHero = false;
        if (!stageState.isV6) {
            Delay(1, () => {
                this.maxHealth = this.#_maxHumanHealth;
                this.health = this.maxHealth;
            });
        }
        this.#_gas = this.#_maxGas;
        this.#_blade = this.#_maxBlade;
        Instance.EntFireAtName({ name: "player_hitbox_phy_" + this.#_slot, input: "Kill" });
        Instance.EntFireAtTarget({ target: this.#_pawn, input: "SetDamageFilter", value: "no_titan_or_titan_attack_filter" });
        if (this.#_scale !== 1) {
            this.#_scale = 1;
            Instance.EntFireAtTarget({ target: this.#_pawn, input: "SetScale", value: this.#_scale });
        }
        const position = this.#_pawn.GetAbsOrigin();
        const angles = this.#_pawn.GetAbsAngles();
        this.#RespawnUI(position, angles);
        this.#RespawnMsg(position, angles);
        this.#SpawnHook(position, angles);
        if (this.#_isHooking) this.ReleaseHook();
        if (this.#_isJetting) this.StopJet();
        if (this.#_isBladeRotating) this.StopBladeRota();
    }
    /**
     * 初始化僵尸体型
     */
    #ZombieScaleInit() {
        this.isTitan = true;
        this.#_scale = Math.random() * 3 + 5;       // 体型大小随机在5 ~ 8之间
        this.#RespawnHitbox();
        Instance.EntFireAtTarget({ target: this.#_pawn, input: "SetScale", value: this.#_scale });
        Instance.EntFireAtTarget({ target: this.#_pawn, input: "AddContext", value: "player_titan:1" });
    }
    /**
     * 属性初始化
     */
    #PropertiesInit() {
        this.hookDistance = CONFIG.hookDistance + this.#_agility * 100                  // 每点敏捷加100点最大钩锁距离
        this.gasRevert = CONFIG.gasRevert + this.#_agility * timeDelta * 0.5            // 每点敏捷加0.5每秒气体回复量
        this.bladeRotaDamage = CONFIG.bladeRotaDamage + this.#_agility * 2500           // 每点敏捷加2500点旋风斩基础伤害
        this.#_critRate = 0.05 + this.#_agility * 0.05;                                 // 每点敏捷加5%暴击率
        this.#_critMulti = 2 + this.#_stength * 0.02;                                   // 每点力量加2%暴击伤害倍率
        this.humanAttackDamage = CONFIG.humanAttackDamage + this.#_stength * 5000;      // 每点力量加5000点人类基础攻击伤害
        this.bladeRotaDamage = CONFIG.bladeRotaDamage + this.#_stength * 2500;          // 每点力量加2500点旋风斩基础伤害
        this.titanAttackDamage = CONFIG.titanAttackDamage + this.#_stength * 200;       // 每点力量加200点巨人基础攻击伤害
        this.AddMaxHealthProperty(this.#_wisdom);                                       // 每点智慧加200点人类血量上限，加5000点僵尸基础血量上限
        this.SetMaxBlade(CONFIG.maxBlade + this.#_wisdom * 10);                         // 每点智慧加10点刀片耐久上限
        this.SetMaxGas(CONFIG.maxGas + this.#_wisdom * 20);                             // 每点智慧加20点气体上限
    }
    /**
     * 初始化玩家用户名与玩家编号
     */
    #PlayerNameInit() {
        const playerController = this.#_pawn.GetPlayerController();
        if (!playerController || !playerController.IsValid()) return;
        this.name = playerController.GetPlayerName();
        this.#_slot = playerController.GetPlayerSlot();
    }
    /**
     * 初始化UI显示
     * @param {import("cs_script/point_script").Vector} position 
     * @param {import("cs_script/point_script").QAngle} angles 
     */
    #RespawnUI(position, angles, scale = 1) {
        const newPosition = { ...position };
        newPosition.z += 64 * scale;
        if (this.ui && this.ui.IsValid()) Instance.EntFireAtTarget({ target: this.ui, input: "Kill" });
        // @ts-ignore
        this.ui = /** @type {Entity} */ (Instance.FindEntityByName("player_ui_temp").ForceSpawn(newPosition, angles)[0]);
        Instance.EntFireAtTarget({ target: this.ui, input: "SetParent", value: "!activator", activator: this.#_pawn });
    }
    /**
     * 初始化UI显示
     * @param {import("cs_script/point_script").Vector} position 
     * @param {import("cs_script/point_script").QAngle} angles 
     */
    #RespawnMsg(position, angles, scale = 1) {
        const newPosition = { ...position };
        newPosition.z += 64 * scale;
        const lastMsg = Instance.FindEntityByName("player_msg_text_" + this.#_slot);
        if (lastMsg && lastMsg.IsValid()) Instance.EntFireAtTarget({ target: lastMsg, input: "Kill" });
        // @ts-ignore
        const msg = Instance.FindEntityByName("player_msg_temp").ForceSpawn(newPosition, angles)[0];
        msg.SetEntityName("player_msg_text_" + this.#_slot);
        Instance.EntFireAtTarget({ target: msg, input: "SetParent", value: "!activator", activator: this.#_pawn });
    }
    /**
     * 初始化钩锁相关实体
     * @param {import("cs_script/point_script").Vector} position 
     * @param {import("cs_script/point_script").QAngle} angles 
     */
    #SpawnHook(position, angles) {
        const newPosition = { ...position };
        newPosition.z += 32;
        // @ts-ignore
        const entities = Instance.FindEntityByName("player_hook_temp").ForceSpawn(newPosition, angles);
        this.hookParticles.length = 0;
        for (const entity of entities) {
            const entityName = entity.GetEntityName();
            if (entityName === "player_hook_particle1" || entityName === "player_hook_particle2") {
                this.hookParticles.push(entity);
                Instance.EntFireAtTarget({ target: entity, input: "SetParent", value: "!activator", activator: this.#_pawn });
            } else if (entityName === "player_blade_rota_particle") {
                entity.SetEntityName("player_blade_rota_particle_" + this.#_slot);
                Instance.EntFireAtTarget({ target: entity, input: "SetParent", value: "!activator", activator: this.#_pawn });
            } else if (entityName === "player_blade_rota_hurt") {
                entity.SetEntityName("player_blade_rota_hurt_" + this.#_slot);
                Instance.EntFireAtTarget({ target: entity, input: "SetParent", value: "!activator", activator: this.#_pawn });
            } else if (entityName === "player_hook_model_particle") {
                entity.SetEntityName("player_hook_model_particle_" + this.#_slot);
                Instance.EntFireAtTarget({ target: entity, input: "SetParent", value: "!activator", activator: this.#_pawn });
            } else if (entityName === "player_jet_particle") {
                entity.SetEntityName("player_jet_particle_" + this.#_slot);
                Instance.EntFireAtTarget({ target: entity, input: "SetParent", value: "!activator", activator: this.#_pawn });
            }
        }
    }
    /**
     * 生成巨人Hitbox
     */
    #RespawnHitbox() {
        const lastHitbox = Instance.FindEntityByName("player_hitbox_phy_" + this.#_slot);
        if (lastHitbox && lastHitbox.IsValid()) Instance.EntFireAtTarget({ target: lastHitbox, input: "Kill" });
        // @ts-ignore
        const hitbox = /** @type {Entity} */ (Instance.FindEntityByName("player_hitbox_temp").ForceSpawn()[0]);
        hitbox.SetEntityName("player_hitbox_phy_" + this.#_slot);
        Instance.EntFireAtTarget({ target: hitbox, input: "FollowEntity", value: "!activator", activator: this.#_pawn });
        Instance.EntFireAtTarget({ target: hitbox, input: "EnableCollisions" });
    }
    /** ----------------------------------------- 初始化函数 ----------------------------------------- */



    /** ---------------------------------------------------------------------------------- */
    /**
     * 检查合法性
     * @returns 
     */
    IsValid() {
        if (!this.#_pawn || !this.#_pawn.IsValid()) return false;
        else return true;
    }
    /**
     * 检测是否发生阵营变化
     * @returns 
     */
    CheckChangedTeam() {
        const currentTeamNumber = this.#_pawn.GetTeamNumber();
        if (this.#_team !== currentTeamNumber) {
            this.Reset();
        }
    }
    /**
     * 进行暴击判定，判断是否暴击
     * @returns 
     */
    EstimateCrit() {
        return Math.random() < this.#_critRate;
    }
    /**
     * 补充气体与刀片
     */
    Supply() {
        this.#_gas = this.#_maxGas;
        this.#_blade = this.#_maxBlade;
    }
}

