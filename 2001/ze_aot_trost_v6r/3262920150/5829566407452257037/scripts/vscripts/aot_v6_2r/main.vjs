Instance.OnScriptInput("CheckEXLevel", (event) => {
    playerState.forEach((/** @type {Player} */ player, pawn) => {
        if (player.level < 3) {
            player.AddLevelAndEmptyEXP(3 - player.level);
        }
    });
});

Instance.OnScriptInput("CheckEXVipLevel", (event) => {
    const pawn = event.activator;
    if (!pawn || !pawn.IsValid() || !playerState.has(pawn)) return;
    const player = playerState.get(pawn);
    if (player.level < 5) {
        player.AddLevelAndEmptyEXP(5 - player.level);
    }
});

/**
 * 更新循环时间差以及相关参数
 * @param {number} currentTime 
 */
function UpdataTimeDelta(currentTime) {
    const currentTimeDelta = currentTime - lastThinkTime;
    if (timeDelta !== currentTimeDelta) {
        timeDelta = currentTimeDelta;
        CONFIG.gasRevert = timeDelta * 5.5;
        HOOK_CONFIG.degravityAccelerate = 600 * timeDelta;
        HOOK_CONFIG.hookAccelerate = 2000 * timeDelta;
        HOOK_CONFIG.maxPlayerAccelerate = 2000 * timeDelta;
        JET_CONFIG.accelerate = 1000 * timeDelta;
        JET_CONFIG.degravityAccelerate = 600 * timeDelta;
        JET_CONFIG.gasCost = 50 * timeDelta;
        BLADE_ROTA_CONFIG.bladeCost = 10 * timeDelta;
    }
    lastThinkTime = currentTime;
}

/**
 * 生成三个总和为 targetSum 的随机两位小数，通过集中度控制离散程度
 * @param {number} targetSum 总和（正数）
 * @param {number} concentration 集中度 >0，越大三个数越接近，越小差异越大（推荐 0.5 ~ 5）
 * @returns {[number, number, number]} 三个随机数，精确到两位小数，总和 = targetSum
 */
function GenerateThreeDecimals(targetSum, concentration = 1) {
    if (targetSum <= 0) return [0, 0, 0];
    /**
     * 使用 Gamma(concentration, 1) 采样，归一化得到 Dirichlet 分布
     * @param {number} shape 
     * @returns {number}
     */
    const gamma = (shape) => {
        // Marsaglia & Tsang 方法（适用于 shape >= 1，对于小 shape 用简单近似）
        if (shape < 1) {
            // 利用 Gamma(shape+1) 再乘以 U^(1/shape) 变换
            const u = Math.random();
            return gamma(shape + 1) * Math.pow(u, 1 / shape);
        }
        const d = shape - 1 / 3;
        const c = 1 / Math.sqrt(9 * d);
        while (true) {
            let x, v;
            do {
                x = (Math.random() - 0.5) * 2;
                v = 1 + c * x;
            } while (v <= 0);
            v = v * v * v;
            const u = Math.random();
            if (u < 1 - 0.0331 * x * x * x * x) return d * v;
            if (Math.log(u) < 0.5 * x * x + d * (1 - v + Math.log(v))) return d * v;
        }
    };

    let g1 = gamma(concentration);
    let g2 = gamma(concentration);
    let g3 = gamma(concentration);
    const total = g1 + g2 + g3;
    let a = (g1 / total) * targetSum;
    let b = (g2 / total) * targetSum;
    let c = targetSum - a - b;

    // 保留两位小数，修正浮点误差
    a = Math.round(a * 100) / 100;
    b = Math.round(b * 100) / 100;
    c = targetSum - a - b;
    c = Math.round(c * 100) / 100;
    // 极少数情况因舍入导致 c 略负或总和偏离，微调
    const sum = a + b + c;
    if (Math.abs(sum - targetSum) > 0.01) {
        c += targetSum - sum;
        c = Math.round(c * 100) / 100;
    }
    return [a, b, c];
}

/**
 * 生成抽象进度条
 * @param {number} value 当前值（0 ≤ value ≤ max）
 * @param {number} max 最大值（> 0）
 * @param {number} totalBars 进度条总格子数（正整数）
 * @returns {string} 进度条字符串，如 "■■■■□□□□"
 */
function GetProgressBar(value, max, totalBars) {

    // 计算填充比例并限制在 [0, totalBars] 之间
    const filled = Math.min(totalBars, Math.max(0, Math.round((value / max) * totalBars)));

    // 生成实心和空心部分
    return '|'.repeat(filled)// + '□'.repeat(totalBars - filled);
}