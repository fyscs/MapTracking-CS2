/** ----------------------------------------- 道具系统 ----------------------------------------- */
Instance.OnScriptInput("GetItem(supply_box)", (event) => {
    const pawn = event.activator;
    if (!pawn || !pawn.IsValid() || !playerState.has(pawn)) return;
    const player = /** @type {Player} */ (playerState.get(pawn));
    const preparativeMeasureModel = /** @type {BaseModelEntity|undefined} */ (event.caller);
    if (!preparativeMeasureModel || !preparativeMeasureModel.IsValid()) return;
    player.GetItem("supply_box", preparativeMeasureModel);
});

/**
 * 刷新随机道具
 * @param {import("cs_script/point_script").Vector} position 
 */
function SpawnRandomItem(position) {
    const item = items[Math.floor(items.length * Math.random())];
    // @ts-ignore
    Instance.FindEntityByName("item_" + item + "_weapon_temp").ForceSpawn(position);
}

/**
 * 检查可放置道具的放置情况
 * @param {string} item 
 * @param {Player} player 
 */
function CheckPlaceableItem(item, player) {
    if (player.preparativeModel && player.preparativeModel.IsValid()) {
        const activeWeapon = player.pawn.GetActiveWeapon();
        if (activeWeapon?.GetData()?.GetGearSlot() === CSGearSlot.PISTOL) {
            if (player.itemLerpTime < 1) {
                if (player.itemLerpTime === 0) {
                    Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Alpha", value: 150 });
                    Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Color", value: "255 255 255" });
                }

                // 播放拿出道具的动画
                player.itemLerpTime = Math.min(player.itemLerpTime + timeDelta * 2, 1);
                SetPreparativeModelHeight(player, player.preparativeModel, player.itemLerpTime * 32);
            } else {
                const start = player.pawn.GetEyePosition();
                const angles = player.pawn.GetEyeAngles();
                const forward = Vector3.AnglesToVector(angles);
                const end = Vector3.Add(start, Vector3.Scale(forward, 120));
                const result = Instance.TraceLine({
                    start,
                    end,
                    ignorePlayers: true
                });
                if (result.didHit && result.hitEntity && result.hitEntity.IsValid()) {
                    if (result.hitEntity.GetClassName() === "worldent" && result.normal.z >= 0.8) {
                        const newAngles = GetPreparativeModelAngles(forward, result.normal);
                        player.preparativeModel.Teleport({ position: result.end, angles: newAngles });
                        Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Color", value: "0 255 0" });
                        if (player.pawn.WasInputJustPressed(CSInputs.LOOK_AT_WEAPON)) {
                            // @ts-ignore
                            Instance.FindEntityByName("item_" + item + "_temp").ForceSpawn(result.end, newAngles);
                            Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Kill" });
                            player.preparativeModel = undefined;
                            // @ts-ignore
                            player.pawn.DestroyWeapon(player.pawn.FindWeaponBySlot(CSGearSlot.PISTOL));
                            // @ts-ignore
                            player.pawn.SwitchToWeapon(player.pawn.FindWeaponBySlot(CSGearSlot.KNIFE));
                        }
                    } else {
                        player.preparativeModel.Teleport({ position: result.end, angles: { pitch: 0, yaw: angles.yaw, roll: 0 } });
                        Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Color", value: "255 0 0" });
                    }
                } else {

                    // 没有瞄准目标时将模型放置在身前
                    SetPreparativeModelHeight(player, player.preparativeModel, 32);
                    Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Color", value: "255 255 255" });
                }
            }
        } else {

            // 未切出手枪时隐藏模型
            if (player.itemLerpTime !== 0) {
                Instance.EntFireAtTarget({ target: player.preparativeModel, input: "Alpha", value: 0 });
            }
            player.itemLerpTime = 0;
        }
    }
}

/**
 * 设置预备模型相对于玩家的高度
 * @param {Player} player 
 * @param {BaseModelEntity} preparativeModel 
 * @param {number} height 
 */
function SetPreparativeModelHeight(player, preparativeModel, height) {
    const position = player.pawn.GetAbsOrigin();
    position.z += height;
    const angles = player.pawn.GetEyeAngles();
    angles.pitch = 0;
    angles.roll = 0;
    const forward = Vector3.AnglesToVector(angles);
    const newPosition = Vector3.Add(position, Vector3.Scale(forward, 30));
    preparativeModel.Teleport({ position: newPosition, angles: angles });
}

/**
 * 获取预览道具的最终angles
 * @param {import("cs_script/point_script").Vector} forward 
 * @param {import("cs_script/point_script").Vector} normal 
 * @returns {import("cs_script/point_script").QAngle}
 */
function GetPreparativeModelAngles(forward, normal) {

    // 将玩家朝向投影到平面上，得到模型应面向的方向（前向）
    let forwardDir = Vector3.Subtract(forward, Vector3.Scale(normal, Vector3.Dot(forward, normal)));
    const len = Vector3.Length(forwardDir);
    if (len < 0.001) {
        // 如果玩家恰好在法线方向上，随便选一个水平方向
        forwardDir = { x: 1, y: 0, z: 0 };
    } else {
        forwardDir = Vector3.Scale(forwardDir, 1 / len);
    }

    // 使 forwardDir 与 normal 正交（理论上已正交，再保险）
    forwardDir = Vector3.Subtract(forwardDir, Vector3.Scale(normal, Vector3.Dot(forwardDir, normal)));
    forwardDir = Vector3.Normalize(forwardDir);

    // 先得到让物体前向指向 forwardDir 的基础欧拉角
    const baseAngles = Vector3.VectorToAngles(forwardDir);

    // 计算基础欧拉角下物体的上方向（世界 Z 轴旋转后的结果）
    const worldUp = { x: 0, y: 0, z: 1 };
    const upBase = Vector3.RotateByAngles(worldUp, baseAngles);

    // 计算需要绕前向轴（forwardDir）旋转的角度，使 upBase 旋转到 normal
    const axis = forwardDir;
    const upBaseNorm = Vector3.Normalize(upBase);
    const normalNorm = Vector3.Normalize(normal);
    const dot = Vector3.Dot(upBaseNorm, normalNorm);
    const cross = Vector3.Cross(upBaseNorm, normalNorm);
    const sinAngle = Vector3.Dot(cross, axis);
    let rollAngle = Math.atan2(sinAngle, dot) * 180 / Math.PI;

    // 最终欧拉角
    return {
        pitch: baseAngles.pitch,
        yaw: baseAngles.yaw,
        roll: rollAngle
    };
}
