function RegisterScriptInput(name, handler) {
    const key = name.toLowerCase();
    if (registeredScriptInputs.has(key)) {
        return;
    }

    registeredScriptInputs.add(key);
    Console.Log(`[manager] RegisterScriptInput: "${name}"`);
    Instance.OnScriptInput(name, handler);
}

function RegisterScriptInputVariant(name, handler) {
    const lastRunTimeBySource = new Map();

    const wrappedHandler = (inputData = {}) => {
        const now = Instance.GetGameTime();
        const controller = GetPlayerController(inputData);
        const sourceKey = EntityValid(controller)
            ? `player:${controller.GetPlayerSlot()}:${name}`
            : inputData.caller || "global";

        if (lastRunTimeBySource.get(sourceKey) === now) {
            return;
        }

        lastRunTimeBySource.set(sourceKey, now);
        if (DEBUG) {
            Console.Log(`[manager] Input fired: "${name}"`);
        }
        handler(inputData);
        ReleaseCallerButton(inputData);
    };

    RegisterScriptInput(name, wrappedHandler);
    RegisterScriptInput(`${name} `, wrappedHandler);
}

function ReleaseCallerButton(inputData) {
    if (!AUTO_RELEASE_BUTTON) {
        return;
    }

    const caller = inputData && inputData.caller;
    if (!EntityValid(caller) || caller.GetClassName() !== "func_button") {
        return;
    }

    caller.FireInput({ input: "PressOut" });
}

function EntityValid(entity) {
    return !!entity && entity.IsValid();
}

function GetStatusHud() {
    if (EntityValid(statusHud)) {
        return statusHud;
    }

    const layouts = Entities.FindByName(HUD_NAME);
    statusHud = layouts.find(EntityValid);
    return statusHud;
}

function GetPlayerControllerFromEntity(entity) {
    if (!EntityValid(entity)) {
        return undefined;
    }

    const className = entity.GetClassName();
    if (className === "cs_player_controller") {
        return entity;
    }

    if (className === "player") {
        return (
            entity.GetPlayerController() ||
            entity.GetOriginalPlayerController()
        );
    }

    const owner = entity.GetOwner();
    if (EntityValid(owner) && owner !== entity) {
        const ownerClassName = owner.GetClassName();
        if (ownerClassName === "cs_player_controller") {
            return owner;
        }
        if (ownerClassName === "player") {
            return (
                owner.GetPlayerController() ||
                owner.GetOriginalPlayerController()
            );
        }
    }

    return undefined;
}

function GetPlayerController(inputData) {
    return (
        GetPlayerControllerFromEntity(inputData && inputData.activator) ||
        GetPlayerControllerFromEntity(inputData && inputData.caller)
    );
}

function GetOrCreatePlayerStats(controller) {
    const slot = controller.GetPlayerSlot();
    let stats = playerStats.get(slot);

    if (!stats) {
        stats = { ...DEFAULT_PLAYER_STATS };
        playerStats.set(slot, stats);
    }

    return stats;
}

function GetPlayerState(inputData) {
    const controller = GetPlayerController(inputData);
    if (!EntityValid(controller)) {
        return undefined;
    }

    return {
        controller,
        slot: controller.GetPlayerSlot(),
        stats: GetOrCreatePlayerStats(controller)
    };
}

function RefreshStatusHudForPlayer(playerState) {
    const hud = GetStatusHud();
    if (!EntityValid(hud) || !playerState) {
        if (DEBUG) {
            Console.Log(
                `[manager] Cannot refresh HUD: hud=${EntityValid(hud)}, playerState=${!!playerState}`
            );
        }
        return;
    }

    const { slot, stats } = playerState;
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "attack",
        String(stats.attack)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "defence",
        String(stats.defence)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "floor",
        String(stats.floor)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "yellowkey",
        String(sharedKeys.yellowkey)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "bluekey",
        String(sharedKeys.bluekey)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "redkey",
        String(sharedKeys.redkey)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "status_panel",
        "coins",
        String(stats.coins)
    );
    hud.SetDialogVariableStringForPlayer(
        slot,
        "shop_hud",
