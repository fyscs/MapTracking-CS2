        "queen_skill_cost",
        String(QUEEN_OF_PAIN_CONFIG.skillCost)
    );
}

function RefreshAllStatusHud() {
    const controllers = Entities.FindByClass("cs_player_controller");

    for (const controller of controllers) {
        if (!EntityValid(controller)) {
            continue;
        }

        RefreshStatusHudForPlayer({
            controller,
            slot: controller.GetPlayerSlot(),
            stats: GetOrCreatePlayerStats(controller)
        });
    }
}

