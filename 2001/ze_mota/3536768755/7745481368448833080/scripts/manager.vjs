function GetAllCharacterFrameIds() {
    const frameIds = [];

    for (const animation of Object.values(CHARACTER_HUD_ANIMATIONS)) {
        frameIds.push(...animation.frameIds);
    }

    return frameIds;
}

function RestoreDefaultHudForPlayer(hud, slot) {
    for (const panelId of DEFAULT_HUD_PANEL_IDS) {
        hud.SetHasClassForPlayer(slot, panelId, "Hidden", false);
    }

    RefreshQueenHudVisibilityForPlayer(hud, slot);
}

function HideAllCharacterFramesForPlayer(hud, slot) {
    for (const frameId of GetAllCharacterFrameIds()) {
        hud.SetHasClassForPlayer(slot, frameId, "Hidden", true);
    }
}

function ClearCharacterHudForPlayer(hud, slot) {
    HideAllCharacterFramesForPlayer(hud, slot);
    hud.SetHasClassForPlayer(slot, CHARACTER_HUD_PANEL_ID, "Hidden", true);
    RestoreDefaultHudForPlayer(hud, slot);
}

function ApplyCharacterFrameForPlayer(hud, slot, frameId) {
    HideAllCharacterFramesForPlayer(hud, slot);
    hud.SetHasClassForPlayer(slot, frameId, "Hidden", false);

    for (const panelId of DEFAULT_HUD_PANEL_IDS) {
        hud.SetHasClassForPlayer(slot, panelId, "Hidden", true);
    }
    hud.SetHasClassForPlayer(slot, QUEEN_HUD_PANEL_ID, "Hidden", true);

    hud.SetHasClassForPlayer(slot, CHARACTER_HUD_PANEL_ID, "Hidden", false);
}

function ApplyGlobalCharacterHudToPlayer(hud, slot) {
    const state = globalCharacterHudState;
    if (!state || !state.running) {
        return false;
    }

    const animation = CHARACTER_HUD_ANIMATIONS[state.animationKey];
    if (!animation) {
        return false;
    }

    ApplyCharacterFrameForPlayer(
        hud,
        slot,
        animation.frameIds[state.frameIndex]
    );
    return true;
}

function ResetCharacterHudForPlayer(hud, slot) {
    const activeState = characterHudStates.get(slot);
    if (activeState) {
        activeState.running = false;
        characterHudStates.delete(slot);
    }

    ClearCharacterHudForPlayer(hud, slot);
}

function SyncCharacterHudForPlayer(hud, slot) {
    const personalState = characterHudStates.get(slot);
    if (personalState && personalState.running) {
        const personalAnimation =
            CHARACTER_HUD_ANIMATIONS[personalState.animationKey];
        if (personalAnimation) {
            ApplyCharacterFrameForPlayer(
                hud,
                slot,
                personalAnimation.frameIds[personalState.frameIndex]
            );
            return;
        }
    }

    if (!ApplyGlobalCharacterHudToPlayer(hud, slot)) {
        ClearCharacterHudForPlayer(hud, slot);
    }
}

async function RunPersonalCharacterHudAnimation(hud, state) {
    const animation = CHARACTER_HUD_ANIMATIONS[state.animationKey];
    if (!animation) {
        return;
    }

    while (
        state.running &&
        characterHudStates.get(state.slot) === state
    ) {
        const frameId = animation.frameIds[state.frameIndex];
        ApplyCharacterFrameForPlayer(hud, state.slot, frameId);

        await Instance.Delay(animation.frameDuration);

        if (!state.running || characterHudStates.get(state.slot) !== state) {
            return;
        }

        state.frameIndex =
            (state.frameIndex + 1) % animation.frameIds.length;
    }
}

async function RunGlobalCharacterHudAnimation(hud, state) {
    const animation = CHARACTER_HUD_ANIMATIONS[state.animationKey];
    if (!animation) {
        return;
    }

    while (state.running && globalCharacterHudState === state) {
        const frameId = animation.frameIds[state.frameIndex];

        for (const controller of Entities.FindByClass(
            "cs_player_controller"
        )) {
            if (!EntityValid(controller)) {
                continue;
            }

            const slot = controller.GetPlayerSlot();
            if (!characterHudStates.has(slot)) {
                ApplyCharacterFrameForPlayer(hud, slot, frameId);
            }
        }

        await Instance.Delay(animation.frameDuration);

        if (!state.running || globalCharacterHudState !== state) {
            return;
        }

        state.frameIndex =
            (state.frameIndex + 1) % animation.frameIds.length;
    }
}

function StartCharacterHud(inputData, animationKey) {
    const playerState = GetPlayerState(inputData);
    const hud = GetStatusHud();
    const animation = CHARACTER_HUD_ANIMATIONS[animationKey];

    if (!playerState || !EntityValid(hud) || !animation) {
        return;
    }

    CloseShopForPlayer(hud, playerState.slot);

    const previousState = characterHudStates.get(playerState.slot);
    if (previousState) {
        previousState.running = false;
    }

    for (const panelId of DEFAULT_HUD_PANEL_IDS) {
        hud.SetHasClassForPlayer(
            playerState.slot,
            panelId,
            "Hidden",
            true
        );
    }

    HideAllCharacterFramesForPlayer(hud, playerState.slot);
    hud.SetHasClassForPlayer(
        playerState.slot,
        CHARACTER_HUD_PANEL_ID,
        "Hidden",
        false
    );

    const state = {
        slot: playerState.slot,
        animationKey,
        frameIndex: 0,
        running: true,
        token: ++characterHudSerial
    };
    characterHudStates.set(playerState.slot, state);
    RunPersonalCharacterHudAnimation(hud, state);
    Console.Log(
        `[manager] personal character hud started: slot=${playerState.slot}, animation=${animationKey}`
    );
}

function StartAllCharacterHud(inputData, animationKey) {
    const hud = GetStatusHud();
    const animation = CHARACTER_HUD_ANIMATIONS[animationKey];

    if (!EntityValid(hud) || !animation) {
        return;
    }

    CloseAllShops(hud);

    if (globalCharacterHudState) {
        globalCharacterHudState.running = false;
    }

    const state = {
        animationKey,
        frameIndex: 0,
        running: true,
        token: ++characterHudSerial
    };
    globalCharacterHudState = state;
    RunGlobalCharacterHudAnimation(hud, state);
    Console.Log(
        `[manager] global character hud started: animation=${animationKey}`
    );
}

function EndCharacterHud(inputData) {
    const playerState = GetPlayerState(inputData);
    const hud = GetStatusHud();
    if (!playerState || !EntityValid(hud)) {
        return;
    }

    const personalState = characterHudStates.get(playerState.slot);
    if (personalState) {
        personalState.running = false;
        characterHudStates.delete(playerState.slot);
    }

    SyncCharacterHudForPlayer(hud, playerState.slot);
    Console.Log(
        `[manager] personal character hud ended: slot=${playerState.slot}`
    );
}

function EndAllCharacterHud() {
    const hud = GetStatusHud();
    if (!EntityValid(hud)) {
        return;
    }

    if (globalCharacterHudState) {
        globalCharacterHudState.running = false;
        globalCharacterHudState = undefined;
    }

    for (const state of characterHudStates.values()) {
        state.running = false;
    }
    characterHudStates.clear();

    for (const controller of Entities.FindByClass("cs_player_controller")) {
        if (!EntityValid(controller)) {
            continue;
        }

        ClearCharacterHudForPlayer(hud, controller.GetPlayerSlot());
    }

    Console.Log("[manager] all character huds ended");
}

function ResetCharacterHudForAllPlayers() {
    EndAllCharacterHud();
}

function GetPlayerPawnForState(playerState) {
    if (!playerState) {
        return undefined;
    }

    const pawn = playerState.controller.GetPlayerPawn();
    return EntityValid(pawn) ? pawn : undefined;
}

function GetPlayerTeam(playerState) {
    const pawn = GetPlayerPawnForState(playerState);
    return pawn ? pawn.GetTeamNumber() : 0;
}

function IsCharacterHudActiveForSlot(slot) {
    return (
        characterHudStates.has(slot) ||
        !!(globalCharacterHudState && globalCharacterHudState.running)
    );
}

function IsQueenOfPainSlot(slot) {
    return (
        EntityValid(queenOfPainController) &&
        queenOfPainController.GetPlayerSlot() === slot
    );
}

function RefreshQueenHudVisibilityForPlayer(hud, slot) {
    const isQueen = IsQueenOfPainSlot(slot);
    const hidden =
        !isQueen ||
        IsCharacterHudActiveForSlot(slot);
    const previewActive =
        Instance.GetGameTime() < qopLoadingPreviewEndTime;
    hud.SetHasClassForPlayer(slot, QUEEN_HUD_PANEL_ID, "Hidden", hidden);
    hud.SetHasClassForPlayer(
        slot,
        QOP_LOADING_HUD_PANEL_ID,
        "Hidden",
        !isQueen && !previewActive
    );
}

function RefreshQueenHudVisibilityForAllPlayers() {
    const hud = GetStatusHud();
    if (!EntityValid(hud)) {
        return;
    }

    for (const controller of Entities.FindByClass("cs_player_controller")) {
        if (!EntityValid(controller)) {
            continue;
        }

        RefreshQueenHudVisibilityForPlayer(
            hud,
            controller.GetPlayerSlot()
        );
    }
}

function ShowQopLoadingPreviewForAllPlayers(hud) {
    if (!EntityValid(hud)) {
        return;
    }

    const token = ++qopLoadingPreviewToken;
    qopLoadingPreviewEndTime =
        Instance.GetGameTime() +
        QUEEN_OF_PAIN_CONFIG.loadingPreviewSeconds;

    for (const controller of Entities.FindByClass("cs_player_controller")) {
        if (!EntityValid(controller)) {
            continue;
        }

        hud.SetHasClassForPlayer(
            controller.GetPlayerSlot(),
            QOP_LOADING_HUD_PANEL_ID,
            "Hidden",
            false
        );
    }

    Instance.Delay(QUEEN_OF_PAIN_CONFIG.loadingPreviewSeconds).then(() => {
        if (token !== qopLoadingPreviewToken) {
            return;
        }

        qopLoadingPreviewEndTime = 0;
        RefreshQueenHudVisibilityForAllPlayers();
    });
}

function ApplyPlayerHealthStats(playerState, refill) {
    const pawn = GetPlayerPawnForState(playerState);
    if (!pawn) {
        return false;
    }

    const maxHealth = Math.max(
        1,
        Math.floor(playerState.stats.maxHealth)
    );
    playerState.stats.maxHealth = maxHealth;
    pawn.SetMaxHealth(maxHealth);

    const health = refill
        ? maxHealth
        : Math.min(pawn.GetHealth(), maxHealth);
    pawn.SetHealth(Math.max(1, health));
    return true;
}

function AdjustPlayerMaxHealth(playerState, amount) {
    const pawn = GetPlayerPawnForState(playerState);
    if (!pawn) {
        return false;
    }

    const currentHealth = pawn.GetHealth();
    const newMaxHealth = Math.max(
        1,
        Math.floor(playerState.stats.maxHealth + amount)
    );

    playerState.stats.maxHealth = newMaxHealth;
    pawn.SetMaxHealth(newMaxHealth);
    pawn.SetHealth(
        Math.min(
            Math.max(1, currentHealth + Math.max(0, amount)),
            newMaxHealth
        )
    );
    return true;
}

function ApplyPersonalHealthPurchase(playerState, amount) {
    const pawn = GetPlayerPawnForState(playerState);
    if (!pawn) {
        return false;
    }

    const oldHealth = pawn.GetHealth();
    const oldMaxHealth = playerState.stats.maxHealth;
    const newMaxHealth = Math.max(1, oldMaxHealth + amount);
    const newHealth = Math.min(oldHealth + amount, newMaxHealth);

    playerState.stats.maxHealth = newMaxHealth;
    pawn.SetMaxHealth(newMaxHealth);
    pawn.SetHealth(newHealth);

    Console.Log(
        `[manager] personal health purchase: slot=${playerState.slot}, health=${oldHealth}->${newHealth}, maxHealth=${oldMaxHealth}->${newMaxHealth}`
    );
    return true;
}

function AdjustPlayerAttack(inputData, amount) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.attack = Math.max(
        1,
        playerState.stats.attack + amount
    );
    RefreshStatusHudForPlayer(playerState);
}

function AdjustPlayerDefence(inputData, amount) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.defence = Math.max(
        1,
        playerState.stats.defence + amount
    );
    RefreshStatusHudForPlayer(playerState);
}

function AdjustPlayerHealth(inputData, amount) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    AdjustPlayerMaxHealth(playerState, amount);
}

function AdjustCoins(playerState, amount) {
    if (!playerState) {
        return;
    }

    playerState.stats.coins = Math.max(
        0,
        Math.floor(playerState.stats.coins + amount)
    );
    RefreshStatusHudForPlayer(playerState);
}

function GetCoinThreshold(kind) {
    return kind === "ct"
        ? Math.max(1, Math.floor(COIN_RULES.ctGunHitsPerCoin))
        : Math.max(1, Math.floor(COIN_RULES.tGunHitsPerCoin));
}

function AddCoinProgress(playerState, kind) {
    if (!playerState) {
        return;
    }

    const progressKey = kind === "ct" ? "ctCoinHits" : "tCoinHits";
    const threshold = GetCoinThreshold(kind);
    playerState.stats[progressKey] += 1;

    if (playerState.stats[progressKey] >= threshold) {
        playerState.stats[progressKey] -= threshold;
        playerState.stats.coins += 1;
        RefreshStatusHudForPlayer(playerState);
        Console.Log(
            `[manager] coin gained: slot=${playerState.slot}, source=${kind}, progress=${playerState.stats[progressKey]}, coins=${playerState.stats.coins}`
        );
    }
}

function ResetCoinProgress(playerState, kind) {
    if (!playerState) {
        return;
    }

    if (kind === "ct") {
        playerState.stats.ctCoinHits = 0;
    } else {
        playerState.stats.tCoinHits = 0;
    }
}

function IsShopOpenForPlayer(slot) {
    return shopStateByPlayer.has(slot);
}

function SetShopMessage(hud, slot, message) {
    const token = (shopMessageTokens.get(slot) || 0) + 1;
    shopMessageTokens.set(slot, token);
    hud.SetDialogVariableStringForPlayer(
        slot,
        "shop_hud",
        "shop_message",
        message
    );

    if (!message) {
        return;
    }

    Instance.Delay(2.0).then(() => {
        if (shopMessageTokens.get(slot) !== token) {
            return;
        }

        if (!EntityValid(hud)) {
            return;
        }

        hud.SetDialogVariableStringForPlayer(
            slot,
            "shop_hud",
            "shop_message",
            ""
        );
        shopMessageTokens.delete(slot);
    });
}

function CloseShopForPlayer(hud, slot) {
    shopStateByPlayer.delete(slot);
    SetShopMessage(hud, slot, "");
    hud.SetHasClassForPlayer(slot, SHOP_HUD_PANEL_ID, "Hidden", true);
    hud.SetInputCaptureEnabled(slot, false);
}

function CloseAllShops(hud) {
    if (!EntityValid(hud)) {
        return;
    }

    for (const controller of Entities.FindByClass("cs_player_controller")) {
        if (!EntityValid(controller)) {
            continue;
        }

        CloseShopForPlayer(hud, controller.GetPlayerSlot());
    }
}

function SetShopPage(hud, slot, page) {
    hud.SetHasClassForPlayer(
        slot,
        SHOP_ATTRIBUTE_PAGE_ID,
        "Hidden",
        page !== "attribute"
    );
    hud.SetHasClassForPlayer(
        slot,
        SHOP_ABILITY_PAGE_ID,
        "Hidden",
        page !== "ability"
    );

    const state = shopStateByPlayer.get(slot);
    if (state) {
        state.page = page;
    }
}

function OpenShopForPlayer(controller) {
    if (!EntityValid(controller)) {
        return;
    }

    const playerState = GetPlayerState({ activator: controller });
    if (!playerState) {
        return;
    }

    const team = GetPlayerTeam(playerState);
    if (team === TEAM_CT && !ctShopEnabled) {
        return;
    }
    if (team === TEAM_T) {
        if (tShopEnabled) {
            Console.Log(
                `[manager] T shop is enabled but has no UI yet: slot=${playerState.slot}`
            );
        }
        return;
    }
    if (team !== TEAM_CT || IsCharacterHudActiveForSlot(playerState.slot)) {
        return;
    }

    const hud = GetStatusHud();
    if (!EntityValid(hud)) {
        return;
    }

    shopStateByPlayer.set(playerState.slot, {
        page: "attribute"
    });
    SetShopMessage(hud, playerState.slot, "");
    hud.SetHasClassForPlayer(
        playerState.slot,
        SHOP_HUD_PANEL_ID,
        "Hidden",
        false
    );
    SetShopPage(hud, playerState.slot, "attribute");
    hud.SetInputCaptureEnabled(playerState.slot, true);
    Console.Log(`[manager] shop opened: slot=${playerState.slot}`);
}

function BuyShopItem(hud, playerState, itemKey) {
    const item = SHOP_ITEMS[itemKey];
    if (!playerState || !item) {
        return;
    }

    if (playerState.stats.coins < item.cost) {
        Console.Log(
            `[manager] shop purchase failed: slot=${playerState.slot}, item=${itemKey}, coins=${playerState.stats.coins}`
        );
        SetShopMessage(hud, playerState.slot, "金币不足");
        return;
    }

    let applied = false;
    if (itemKey === "attack") {
        playerState.stats.attack += item.amount;
        applied = true;
    } else if (itemKey === "defence") {
        playerState.stats.defence += item.amount;
        applied = true;
    } else if (itemKey === "health") {
        applied = ApplyPersonalHealthPurchase(playerState, item.amount);
    }

    if (!applied) {
        return;
    }

    playerState.stats.coins -= item.cost;
    RefreshStatusHudForPlayer(playerState);
    SetShopMessage(hud, playerState.slot, "购买成功");
    Console.Log(
        `[manager] shop purchase: slot=${playerState.slot}, item=${itemKey}, coins=${playerState.stats.coins}`
    );
}

function HandleShopButton(player, buttonId) {
    if (!EntityValid(player)) {
        return;
    }

    const playerState = GetPlayerState({ activator: player });
    if (!playerState || !IsShopOpenForPlayer(playerState.slot)) {
        return;
    }

    const hud = GetStatusHud();
    if (!EntityValid(hud)) {
        return;
    }

    if (buttonId === "shop_close") {
        CloseShopForPlayer(hud, playerState.slot);
    } else if (buttonId === "shop_tab_attribute") {
        SetShopPage(hud, playerState.slot, "attribute");
    } else if (buttonId === "shop_tab_ability") {
        SetShopPage(hud, playerState.slot, "ability");
    } else if (buttonId === "shop_buy_attack") {
        BuyShopItem(hud, playerState, "attack");
    } else if (buttonId === "shop_buy_defence") {
        BuyShopItem(hud, playerState, "defence");
    } else if (buttonId === "shop_buy_health") {
        BuyShopItem(hud, playerState, "health");
    }
}

function HandlePlayerBulletDamage(event) {
    if ((event.damageTypes & CSDamageTypes.BULLET) === 0) {
        return;
    }

    const victim = event.player;
    if (!EntityValid(victim) || victim.GetTeamNumber() !== TEAM_T) {
        return;
    }

    const victimController = GetPlayerControllerFromEntity(victim);
    if (EntityValid(victimController)) {
        AddCoinProgress(
            GetPlayerState({ activator: victimController }),
            "t"
        );
    }

    const attackerController = GetPlayerControllerFromEntity(event.attacker);
    if (!EntityValid(attackerController)) {
        return;
    }

    const attackerPawn = attackerController.GetPlayerPawn();
    if (EntityValid(attackerPawn) && attackerPawn.GetTeamNumber() === TEAM_CT) {
        AddCoinProgress(
            GetPlayerState({ activator: attackerController }),
            "ct"
        );
    }
}

function HandleQueenEnergyGain(event) {
    if (!EntityValid(queenOfPainController)) {
        return;
    }

    const victimController = GetPlayerControllerFromEntity(event.player);
    if (
        !EntityValid(victimController) ||
        victimController.GetPlayerSlot() !==
            queenOfPainController.GetPlayerSlot()
    ) {
        return;
    }

    const playerState = GetPlayerState({ activator: victimController });
    if (
        !playerState ||
        playerState.stats.queenEnergy >= QUEEN_OF_PAIN_CONFIG.maxEnergy
    ) {
        return;
    }

    playerState.stats.queenEnergy = Math.min(
        QUEEN_OF_PAIN_CONFIG.maxEnergy,
        playerState.stats.queenEnergy + QUEEN_OF_PAIN_CONFIG.energyPerHit
    );
    RefreshStatusHudForPlayer(playerState);

    if (
        playerState.stats.queenEnergy ===
        QUEEN_OF_PAIN_CONFIG.maxEnergy
    ) {
        Console.Log(
            `[manager] queen of pain energy full: slot=${playerState.slot}`
        );
    }
}

function HandlePlayerDamage(event) {
    HandleQueenEnergyGain(event);
    HandlePlayerBulletDamage(event);
}

function HandlePlayerChat(event) {
    if (!EntityValid(event.player)) {
        return;
    }

    if (event.text.trim().toLowerCase() !== "sd") {
        return;
    }

    OpenShopForPlayer(event.player);
}

function AdjustCoinsFromInput(inputData, amount) {
    AdjustCoins(GetPlayerState(inputData), amount);
}

function ResetCoinsFromInput(inputData) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.coins = 0;
    RefreshStatusHudForPlayer(playerState);
}

function AddCoinProgressFromInput(inputData, kind) {
    AddCoinProgress(GetPlayerState(inputData), kind);
}

function ResetCoinProgressFromInput(inputData, kind) {
    ResetCoinProgress(GetPlayerState(inputData), kind);
}

function GetQueenOfPainPawn() {
    if (!EntityValid(queenOfPainController)) {
        queenOfPainController = undefined;
        return undefined;
    }

    const pawn = queenOfPainController.GetPlayerPawn();
    return EntityValid(pawn) ? pawn : undefined;
}

function SetQueenOfPain(inputData) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    const hud = GetStatusHud();
    let previousSlot = undefined;
    if (EntityValid(queenOfPainController)) {
        previousSlot = queenOfPainController.GetPlayerSlot();
    }

    UnlockQueenOfPainMovement();
    queenOfPainController = playerState.controller;
    queenOfPainBusy = false;
    sonicWaveKillWindow = undefined;
    playerState.stats.queenEnergy = 0;

    if (EntityValid(hud)) {
        if (
            previousSlot !== undefined &&
            previousSlot !== playerState.slot
        ) {
            RefreshQueenHudVisibilityForPlayer(hud, previousSlot);
        }

        RefreshStatusHudForPlayer(playerState);
        RefreshQueenHudVisibilityForPlayer(hud, playerState.slot);

        if (
            previousSlot === undefined ||
            previousSlot !== playerState.slot
        ) {
            ShowQopLoadingPreviewForAllPlayers(hud);
        }
    }
    Console.Log(`[manager] queen of pain assigned: slot=${playerState.slot}`);
}

function FireQueenOfPainButton() {
    const targets = Entities.FindByName(
        QUEEN_OF_PAIN_CONFIG.buttonEntity
    );
    if (targets.length === 0) {
        Console.Log(
            `[manager] queen of pain button not found: ${QUEEN_OF_PAIN_CONFIG.buttonEntity}`
        );
        return;
    }

    Entities.FireInput({
        name: QUEEN_OF_PAIN_CONFIG.buttonEntity,
        input: "Press",
        activator: queenOfPainController
    });
}

function ClearQueenOfPainVelocity() {
    if (
        QUEEN_OF_PAIN_CONFIG.clearVelocityOnLock &&
        EntityValid(queenOfPainLockedPawn)
    ) {
        queenOfPainLockedPawn.Move({
            velocity: { x: 0, y: 0, z: 0 }
        });
    }
}

function UnlockQueenOfPainMovement() {
    if (EntityValid(queenOfPainLockedCamera)) {
        queenOfPainLockedCamera.SetMode(CustomCameraMode.DISABLED);
    }

    if (EntityValid(queenOfPainLockedPawn)) {
        ClearQueenOfPainVelocity();
        const restoreType =
            queenOfPainOriginalMoveType === CSMoveType.INVALID
                ? QUEEN_OF_PAIN_CONFIG.moveTypeRestored
                : queenOfPainOriginalMoveType;
        queenOfPainLockedPawn.SetMoveType(restoreType);
    }

    queenOfPainLockedPawn = undefined;
    queenOfPainLockedCamera = undefined;
    queenOfPainOriginalMoveType = QUEEN_OF_PAIN_CONFIG.moveTypeRestored;
    queenOfPainUnlockTime = 0;
    queenOfPainBusy = false;
}

function TriggerQueenOfPainAction() {
    if (queenOfPainBusy) {
        return;
    }

    const pawn = GetQueenOfPainPawn();
    if (!pawn || !pawn.IsAlive()) {
        return;
    }

    const playerState = GetPlayerState({
        activator: queenOfPainController
    });
    if (
        !playerState ||
        playerState.stats.queenEnergy < QUEEN_OF_PAIN_CONFIG.skillCost
    ) {
        Console.Log(
            `[manager] queen of pain E blocked: energy=${playerState ? playerState.stats.queenEnergy : "none"}`
        );
        return;
    }

    playerState.stats.queenEnergy -= QUEEN_OF_PAIN_CONFIG.skillCost;
    RefreshStatusHudForPlayer(playerState);

    queenOfPainLockedPawn = pawn;
    queenOfPainOriginalMoveType = pawn.GetMoveType();
    queenOfPainBusy = true;
    queenOfPainUnlockTime =
        Instance.GetGameTime() + QUEEN_OF_PAIN_CONFIG.moveLockDuration;
    pawn.SetMoveType(QUEEN_OF_PAIN_CONFIG.moveTypeLocked);
    ClearQueenOfPainVelocity();
    FireQueenOfPainButton();
    Console.Log("[manager] queen of pain E pressed");

    if (QUEEN_OF_PAIN_CONFIG.lockView) {
        try {
            const camera = pawn.GetCustomCamera();
            if (EntityValid(camera)) {
                camera.Teleport({
                    position: pawn.GetEyePosition(),
                    angles: pawn.GetEyeAngles()
                });
                camera.SetMode(CustomCameraMode.CONTROLLED);
                queenOfPainLockedCamera = camera;
            } else {
                Console.Log("[manager] queen custom camera unavailable");
            }
        } catch (error) {
            queenOfPainLockedCamera = undefined;
            Console.Log(`[manager] queen camera lock failed: ${error}`);
        }
    }
}

function QueenOfPainInputThink() {
    const now = Instance.GetGameTime();

    if (queenOfPainBusy) {
        ClearQueenOfPainVelocity();
        if (now >= queenOfPainUnlockTime) {
            UnlockQueenOfPainMovement();
        }
    } else {
        const pawn = GetQueenOfPainPawn();
        if (pawn && pawn.WasInputJustPressed(CSInputs.USE)) {
            Console.Log("[manager] queen of pain E input detected");
            TriggerQueenOfPainAction();
        }
    }

    Instance.SetNextThink(Instance.GetGameTime() + 0.01);
}

function StartQueenOfPainThink() {
    if (queenOfPainThinkStarted) {
        return;
    }

    queenOfPainThinkStarted = true;
    Instance.SetThink(QueenOfPainInputThink);
    Instance.SetNextThink(Instance.GetGameTime() + 0.01);
}

function GetHorizontalPushDirection(fromPosition, toPosition) {
    const dx = toPosition.x - fromPosition.x;
    const dy = toPosition.y - fromPosition.y;
    const length = Math.sqrt(dx * dx + dy * dy);

    if (length < 0.001) {
        return { x: 1, y: 0 };
    }

    return {
        x: dx / length,
        y: dy / length
    };
}

async function ApplySonicWavePush(targetPawn, queenPawn) {
    if (!EntityValid(targetPawn) || !EntityValid(queenPawn)) {
        return;
    }

    const direction = GetHorizontalPushDirection(
        queenPawn.GetAbsOrigin(),
        targetPawn.GetAbsOrigin()
    );
    const endTime =
        Instance.GetGameTime() + SONIC_WAVE_CONFIG.pushDuration;

    while (
        EntityValid(targetPawn) &&
        targetPawn.IsAlive() &&
        Instance.GetGameTime() < endTime
    ) {
        const velocity = targetPawn.GetAbsVelocity();
        targetPawn.Move({
            velocity: {
                x: direction.x * SONIC_WAVE_CONFIG.pushSpeed,
                y: direction.y * SONIC_WAVE_CONFIG.pushSpeed,
                z: velocity.z
            }
        });

        await Instance.Delay(SONIC_WAVE_CONFIG.pushTickInterval);
    }
}

async function ApplySonicWaveDamageToPlayer(playerState, attacker) {
    if (!playerState) {
        return;
    }

    for (let hit = 0; hit < SONIC_WAVE_CONFIG.hitCount; hit++) {
        const pawn = GetPlayerPawnForState(playerState);
        if (!pawn || !pawn.IsAlive()) {
            return;
        }

        const damage = Math.max(
            0,
            Math.floor(
                SONIC_WAVE_CONFIG.baseDamagePerHit -
                    playerState.stats.defence
            )
        );

        DamagePlayer(pawn, damage, attacker);
        Console.Log(
            `[manager] sonic wave hit: slot=${playerState.slot}, hit=${hit + 1}, damage=${damage}`
        );

        if (hit < SONIC_WAVE_CONFIG.hitCount - 1) {
            await Instance.Delay(SONIC_WAVE_CONFIG.hitInterval);
        }
    }
}

function HandleSonicWave(inputData) {
    const targetState = GetPlayerState(inputData);
    const queenPawn = GetQueenOfPainPawn();
    const targetPawn = GetPlayerPawnForState(targetState);

    if (!targetState || !targetPawn || !queenPawn) {
        return;
    }

    BeginSonicWaveKillWindow();
    ApplySonicWavePush(targetPawn, queenPawn);
    ApplySonicWaveDamageToPlayer(targetState, queenPawn);
}

function HandleSonicWaveDamage(inputData) {
    const queenPawn = GetQueenOfPainPawn();
    BeginSonicWaveKillWindow();
    ApplySonicWaveDamageToPlayer(GetPlayerState(inputData), queenPawn);
}

function AdjustSonicWaveBaseDamage(amount) {
    SONIC_WAVE_CONFIG.baseDamagePerHit = Math.max(
        0,
        SONIC_WAVE_CONFIG.baseDamagePerHit + amount
    );
    Console.Log(
        `[manager] sonic wave base damage=${SONIC_WAVE_CONFIG.baseDamagePerHit}`
    );
}

function FireEntityPickRandom(entityName) {
    const targets = Entities.FindByName(entityName);
    if (targets.length === 0) {
        Console.Log(`[manager] entity not found: ${entityName}`);
        return false;
    }

    Entities.FireInput({
        name: entityName,
        input: "PickRandom"
    });
    return true;
}

function BeginSonicWaveKillWindow() {
    const now = Instance.GetGameTime();
    if (
        !sonicWaveKillWindow ||
        now >= sonicWaveKillWindow.endTime
    ) {
        sonicWaveKillWindow = {
            endTime:
                now + QUEEN_OF_PAIN_CONFIG.killSoundWindowSeconds,
            soundPlayed: false
        };
    }
}

function HandleQueenRoundEnd(event) {
    if (
        event.winningTeam !== TEAM_T ||
        !EntityValid(queenOfPainController) ||
        !queenOfPainController.IsConnected()
    ) {
        return;
    }

    FireEntityPickRandom(QUEEN_OF_PAIN_CONFIG.winSoundEntity);
}

function HandlePlayerKilled(event) {
    const window = sonicWaveKillWindow;
    if (
        !window ||
        window.soundPlayed ||
        Instance.GetGameTime() > window.endTime
    ) {
        return;
    }

    if (!EntityValid(queenOfPainController)) {
        return;
    }

    if (EntityValid(event.weapon)) {
        return;
    }

    const attackerController = GetPlayerControllerFromEntity(event.attacker);
    if (
        !EntityValid(attackerController) ||
        attackerController.GetPlayerSlot() !==
            queenOfPainController.GetPlayerSlot()
    ) {
        return;
    }

    window.soundPlayed = true;
    FireEntityPickRandom(QUEEN_OF_PAIN_CONFIG.killSoundEntity);
    Console.Log(
        `[manager] sonic wave kill sound triggered: slot=${attackerController.GetPlayerSlot()}`
    );
}

function SetCurrentFloor(inputData, floor) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.floor = Math.max(0, Math.floor(floor));
    RefreshStatusHudForPlayer(playerState);
}

function GetAliveCtCount() {
    let count = 0;
    const players = Entities.FindByClass("player");

    for (const player of players) {
        if (
            EntityValid(player) &&
            player.GetTeamNumber() === TEAM_CT &&
            player.GetHealth() > 0
        ) {
            count++;
        }
    }

    return count;
}

function CalculateNpcMaxHp(config, ctCount = GetAliveCtCount()) {
    const rawHp = ctCount * config.hpScale;
    return Math.max(config.minHp, Math.floor(rawHp));
}

function RegisterNpcInstance(configKey, options = {}) {
    const config = NPC_CONFIG[configKey];
    if (!config) {
        Console.Log(`[manager] Unknown NPC config: ${configKey}`);
        return undefined;
    }

    const id = options.id || `${configKey}_${++npcSerial}`;
    const ctCount = options.ctCount ?? GetAliveCtCount();
    const maxHp = options.maxHp ?? CalculateNpcMaxHp(config, ctCount);

    const npc = {
        id,
        type: configKey,
        config,
        maxHp,
        hp: maxHp,
        dead: false,
        healthTextEntity: options.healthTextEntity,
        healthTextName: options.healthTextName || config.healthText,
        deathRelayEntity: options.deathRelayEntity,
        deathRelayName: options.deathRelayName || config.deathRelay,
        damageEntity: options.damageEntity
    };

    activeNpcs.set(id, npc);
    if (EntityValid(options.damageEntity)) {
        callerNpcBindings.set(options.damageEntity, npc);
    }

    UpdateNpcHealthText(npc);
    Console.Log(
        `[manager] NPC created: id=${id}, type=${configKey}, hp=${maxHp}, ct=${ctCount}`
    );
    return npc;
}

function ResetNpcInstances() {
    activeNpcs.clear();
    callerNpcBindings.clear();
    npcSerial = 0;

    for (const [configKey, config] of Object.entries(NPC_CONFIG)) {
        if (config.createDefault) {
            RegisterNpcInstance(configKey, { id: `${configKey}_default` });
        }
    }
}

function FindNpcByHealthEntity(healthTextEntity) {
    for (const npc of activeNpcs.values()) {
        if (npc.healthTextEntity === healthTextEntity) {
            return npc;
        }
    }

    return undefined;
}

function GetEntitySuffix(name) {
    const ampersandIndex = name.lastIndexOf("&");
    if (ampersandIndex >= 0) {
        return name.slice(ampersandIndex);
    }

    const underscoreMatch = name.match(/(_\d+)$/);
    return underscoreMatch ? underscoreMatch[1] : "";
}

function GetNameSuffixFromBase(name, baseName) {
    if (name === baseName) {
        return "";
    }

    if (
        name.startsWith(`${baseName}&`) ||
        name.startsWith(`${baseName}_`)
    ) {
        return name.slice(baseName.length);
    }

    return undefined;
}

function TryBindNpcFromCaller(configKey, caller) {
    if (!EntityValid(caller)) {
        return undefined;
    }

    const config = NPC_CONFIG[configKey];
    const callerName = caller.GetEntityName();
    const suffix =
        GetNameSuffixFromBase(callerName, config.damageEntity) ??
        GetEntitySuffix(callerName);
    const healthTextName = `${config.healthText}${suffix}`;
    const deathRelayName = `${config.deathRelay}${suffix}`;
    const healthTextEntity = FindExactEntityByName(healthTextName);

    if (!healthTextEntity) {
        Console.Log(
            `[manager] Caller suffix bind failed: caller=${callerName}, missing=${healthTextName}`
        );
        return undefined;
    }

    const deathRelayEntity = FindExactEntityByName(deathRelayName);
    let npc = FindNpcByHealthEntity(healthTextEntity);

    if (!npc) {
        npc = RegisterNpcInstance(configKey, {
            id: `${configKey}_suffix_${suffix || "none"}`,
            healthTextEntity,
            deathRelayEntity,
            deathRelayName,
            damageEntity: caller
        });
    } else {
        npc.damageEntity = caller;
        callerNpcBindings.set(caller, npc);
    }

    if (!deathRelayEntity) {
        Console.Log(
            `[manager] Missing death relay for suffix ${suffix}: ${deathRelayName}`
        );
    }

    return npc;
}

function GetNpcForInput(configKey, inputData) {
    const caller = inputData && inputData.caller;
    if (EntityValid(caller)) {
        const boundNpc = callerNpcBindings.get(caller);
        if (boundNpc && boundNpc.type === configKey) {
            return boundNpc;
        }

        const suffixNpc = TryBindNpcFromCaller(configKey, caller);
        if (suffixNpc) {
            return suffixNpc;
        }
    }

    const matches = [];
    for (const npc of activeNpcs.values()) {
        if (npc.type === configKey) {
            matches.push(npc);
        }
    }

    if (matches.length === 1) {
        return matches[0];
    }

    if (matches.length === 0) {
        Console.Log(`[manager] No active NPC instance for ${configKey}`);
        return undefined;
    }

    Console.Log(
        `[manager] ${configKey} has ${matches.length} active instances; bind the damage entity to select one`
    );
    return undefined;
}

function HandleNpcAttack(configKey, inputData) {
    const npc = GetNpcForInput(configKey, inputData);
    const playerState = GetPlayerState(inputData);
    if (!npc || npc.dead || !playerState) {
        return;
    }

    const player = playerState.controller.GetPlayerPawn();
    if (!EntityValid(player)) {
        return;
    }

    const playerDamage = Math.max(
        0,
        npc.config.attack - playerState.stats.defence
    );
    const npcDamage = Math.max(
        0,
        playerState.stats.attack - npc.config.defence
    );

    if (DEBUG) {
        Console.Log(
            `[manager] ${npc.config.name}: slot=${playerState.slot}, playerDamage=${playerDamage}, npcDamage=${npcDamage}, hp=${npc.hp}`
        );
    }

    if (playerDamage > 0) {
        DamagePlayer(player, playerDamage);
    }

    if (npcDamage > 0) {
        DamageNpc(npc, npcDamage);
    }
}

function DamageNpc(npc, damage) {
    if (npc.dead) {
        return;
    }

    const amount = Math.max(0, Math.floor(damage));
    if (amount <= 0) {
        return;
    }

    npc.hp = Math.max(0, npc.hp - amount);
    UpdateNpcHealthText(npc);

    if (npc.hp === 0) {
        npc.dead = true;
        FireNpcDeathRelay(npc);
    }
}

function UpdateNpcHealthText(npc) {
    const message = `${npc.config.healthTextPrefix}${npc.hp}`;

    if (EntityValid(npc.healthTextEntity)) {
        npc.healthTextEntity.FireInput({
            input: "SetMessage",
            value: message
        });
        npc.healthTextEntity.FireInput({ input: "Enable" });
        if (DEBUG) {
            Console.Log(
                `[manager] NPC text: id=${npc.id}, target=bound entity, message="${message}"`
            );
        }
    } else {
        const textEntities = Entities.FindByName(npc.healthTextName);
        if (textEntities.length === 0) {
            Console.Log(
                `[manager] NPC text entity not found: ${npc.healthTextName}`
            );
            return;
        }

        for (const textEntity of textEntities) {
            if (!EntityValid(textEntity)) {
                continue;
            }

            textEntity.FireInput({
                input: "SetMessage",
                value: message
            });
            textEntity.FireInput({ input: "Enable" });
        }

        if (DEBUG) {
            Console.Log(
                `[manager] NPC text: id=${npc.id}, target=${npc.healthTextName}, count=${textEntities.length}, message="${message}"`
            );
        }
    }
}

function RefreshAllNpcTexts() {
    for (const npc of activeNpcs.values()) {
        UpdateNpcHealthText(npc);
    }
}

async function RefreshAllNpcTextsDelayed() {
    await Instance.Delay(0.10);
    RefreshAllNpcTexts();
    await Instance.Delay(0.40);
    RefreshAllNpcTexts();
}

function FireNpcDeathRelay(npc) {
    if (EntityValid(npc.deathRelayEntity)) {
        npc.deathRelayEntity.FireInput({ input: "Trigger" });
    } else {
        Entities.FireInput({
            name: npc.deathRelayName,
            input: "Trigger"
        });
    }

    if (EntityValid(npc.damageEntity)) {
        npc.damageEntity.FireInput({
            input: npc.config.killInput || "Kill"
        });
    } else {
        Console.Log(
            `[manager] NPC damage entity is not bound: ${npc.config.damageEntity}`
        );
    }

    Console.Log(
        `[manager] NPC dead: id=${npc.id}, relay=${npc.deathRelayName}`
    );
}

function FindSpawnedEntity(entities, baseName) {
    for (const entity of entities) {
        if (!EntityValid(entity)) {
            continue;
        }

        const name = entity.GetEntityName();
        if (
            name === baseName ||
            name.startsWith(`${baseName}&`) ||
            name.startsWith(`${baseName}_`)
        ) {
            return entity;
        }
    }

    return undefined;
}

function GetEntitiesByBaseName(baseName) {
    const result = [];
    const seen = new Set();
    const matches = [
        ...Entities.FindByName(baseName),
        ...Entities.FindByName(`${baseName}*`)
    ];

    for (const entity of matches) {
        if (!EntityValid(entity) || seen.has(entity)) {
            continue;
        }

        seen.add(entity);
        result.push(entity);
    }

    return result;
}

function GetNameSuffix(name, baseName) {
    return GetNameSuffixFromBase(name, baseName);
}

function IsNpcEntityBound(entity) {
    for (const npc of activeNpcs.values()) {
        if (
            npc.healthTextEntity === entity ||
            npc.deathRelayEntity === entity ||
            npc.damageEntity === entity
        ) {
            return true;
        }
    }

    return false;
}

function FindExactEntityByName(name) {
    return Entities.FindByName(name).find(EntityValid);
}

function BindMakerSpawnedNpc(configKey) {
    const config = NPC_CONFIG[configKey];
    if (!config) {
        return undefined;
    }

    const healthEntities = GetEntitiesByBaseName(config.healthText);
    for (const healthEntity of healthEntities) {
        if (
            !EntityValid(healthEntity) ||
            healthEntity.GetClassName() !== "point_worldtext"
        ) {
            continue;
        }

        if (IsNpcEntityBound(healthEntity)) {
            continue;
        }

        const healthName = healthEntity.GetEntityName();
        const suffix = GetNameSuffix(healthName, config.healthText);
        if (suffix === undefined) {
            continue;
        }

        const deathRelayName = `${config.deathRelay}${suffix}`;
        const damageEntityName = `${config.damageEntity}${suffix}`;
        const deathRelayEntity = FindExactEntityByName(deathRelayName);
        const damageEntity = FindExactEntityByName(damageEntityName);

        if (!deathRelayEntity || !damageEntity) {
            Console.Log(
                `[manager] Maker partial bind: health=${healthName}, death=${deathRelayName}, damage=${damageEntityName}`
            );
        }

        return RegisterNpcInstance(configKey, {
            id: `${configKey}_maker_${npcSerial + 1}`,
            healthTextEntity: healthEntity,
            deathRelayEntity,
            deathRelayName,
            damageEntity
        });
    }

    Console.Log(
        `[manager] No unbound maker instance found for ${configKey}`
    );
    return undefined;
}

function HandleMakerSpawned(configKey) {
    const attemptBind = (remainingAttempts) => {
        if (BindMakerSpawnedNpc(configKey)) {
            return;
        }

        if (remainingAttempts <= 0) {
            return;
        }

        Instance.Delay(0.10)
            .then(() => attemptBind(remainingAttempts - 1))
            .catch((error) => {
                Console.Log(`[manager] Maker bind retry failed: ${error}`);
            });
    };

    Instance.QueueAfterThinks(() => {
        attemptBind(4);
    });
}

function BindSpawnedNpc(configKey, spawnedEntities, options = {}) {
    const config = NPC_CONFIG[configKey];
    if (!config || !spawnedEntities) {
        return undefined;
    }

    return RegisterNpcInstance(configKey, {
        ...options,
        healthTextEntity:
            options.healthTextEntity ||
            FindSpawnedEntity(spawnedEntities, config.healthText),
        deathRelayEntity:
            options.deathRelayEntity ||
            FindSpawnedEntity(spawnedEntities, config.deathRelay),
        damageEntity:
            options.damageEntity ||
            (options.damageEntityName
                ? FindSpawnedEntity(spawnedEntities, options.damageEntityName)
                : undefined)
    });
}

function SpawnNpcTemplate(templateEntity, configKey, origin, options = {}) {
    if (!EntityValid(templateEntity)) {
        return undefined;
    }

    const spawnedEntities = templateEntity.ForceSpawn(origin);
    if (!spawnedEntities) {
        return undefined;
    }

    return BindSpawnedNpc(configKey, spawnedEntities, options);
}

function DamagePlayer(player, damage, attacker) {
    if (!EntityValid(player) || !player.IsAlive() || player.GetHealth() <= 0) {
        return;
    }

    const amount = Math.max(0, Math.floor(damage));
    if (amount <= 0) {
        return;
    }

    player.TakeDamage({
        damage: amount,
        damageTypes: CSDamageTypes.GENERIC,
        damageFlags: CSDamageFlags.IGNORE_ARMOR,
        attacker,
        inflictor: attacker
    });

    if (DEBUG) {
        Console.Log(`[manager] Player damaged: ${amount}, health=${player.GetHealth()}`);
    }
}

function CanApplyBoss1Damage(playerState, skillName) {
    const now = Instance.GetGameTime();
    const cooldownKey = `${skillName}:${playerState.slot}`;
    const lastDamageTime = boss1DamageCooldownBySource.get(cooldownKey);

    if (
        lastDamageTime !== undefined &&
        now - lastDamageTime < BOSS1_SKILL_CONFIG.cooldownSeconds
    ) {
        return false;
    }

    boss1DamageCooldownBySource.set(cooldownKey, now);
    return true;
}

function ApplyBoss1SkillDamage(inputData, skillName) {
    const config = BOSS1_SKILL_CONFIG[skillName];
    const playerState = GetPlayerState(inputData);
    if (!playerState || !config) {
        return;
    }

    if (!CanApplyBoss1Damage(playerState, skillName)) {
        Console.Log(
            `[manager] boss1_${skillName} ignored by cooldown: slot=${playerState.slot}`
        );
        return;
    }

    const pawn = GetPlayerPawnForState(playerState);
    if (!pawn) {
        return;
    }

    const actualDamage = Math.max(
        config.minimumDamage,
        config.baseDamage - playerState.stats.defence
    );

    DamagePlayer(pawn, actualDamage);
    Console.Log(
        `[manager] boss1_${skillName}: slot=${playerState.slot}, defence=${playerState.stats.defence}, damage=${actualDamage}`
    );
}

function AddHealthToPlayer(player, amount) {
    if (!EntityValid(player) || !player.IsAlive()) {
        return false;
    }

    const currentHealth = player.GetHealth();
    const newMaxHealth = player.GetMaxHealth() + amount;

    // Raise the cap first, then add the requested current health.
    player.SetMaxHealth(newMaxHealth);
    player.SetHealth(Math.min(currentHealth + amount, newMaxHealth));

    const controller =
        player.GetPlayerController() ||
        player.GetOriginalPlayerController();
    if (EntityValid(controller)) {
        const stats =
            playerStats.get(controller.GetPlayerSlot()) ||
            GetOrCreatePlayerStats(controller);
        stats.maxHealth = newMaxHealth;
    }
    return true;
}

function AddHealthToAllCt() {
    const players = Entities.FindByClass("player");
    let affectedCount = 0;

    for (const player of players) {
        if (
            !EntityValid(player) ||
            player.GetTeamNumber() !== TEAM_CT ||
            !AddHealthToPlayer(player, ADD_HP_AMOUNT)
        ) {
            continue;
        }

        affectedCount += 1;
    }

    Console.Log(`[manager] addhp: affected ${affectedCount} CT players`);
}

function AddKey(inputData, keyName) {
    if (!(keyName in sharedKeys)) {
        return;
    }

    const playerState = GetPlayerState(inputData);
    if (!playerState || GetPlayerTeam(playerState) !== TEAM_CT) {
        Console.Log(`[manager] key add ignored: CT required, key=${keyName}`);
        return;
    }

    sharedKeys[keyName] += 1;
    RefreshAllStatusHud();
    RefreshKeyDoorAccess();

    Console.Log(
        `[manager] key added: slot=${playerState.slot}, ${keyName}=${sharedKeys[keyName]}`
    );
}

function UseKey(inputData, keyName) {
    if (!(keyName in sharedKeys)) {
        return false;
    }

    if (sharedKeys[keyName] <= 0) {
        const playerState = GetPlayerState(inputData);
        Console.Log(
            `[manager] key missing: slot=${playerState ? playerState.slot : "none"}, ${keyName}=0`
        );
        return false;
    }

    const playerState = GetPlayerState(inputData);
    sharedKeys[keyName] -= 1;
    RefreshAllStatusHud();
    RefreshKeyDoorAccess();
    Console.Log(
        `[manager] key used: slot=${playerState ? playerState.slot : "none"}, ${keyName}=${sharedKeys[keyName]}`
    );
    return true;
}

function GetTotalKeyCount(keyName) {
    return Math.max(0, Math.floor(sharedKeys[keyName] || 0));
}

function SetDoorGroupEnabled(entityPrefix, enabled) {
    const entities = GetEntitiesByBaseName(entityPrefix);

    for (const entity of entities) {
        if (!EntityValid(entity)) {
            continue;
        }

        entity.FireInput({
            input: enabled ? "Enable" : "Disable"
        });
    }

    return entities.length;
}

function RefreshKeyDoorAccess() {
    for (const group of KEY_DOOR_GROUPS) {
        const total = GetTotalKeyCount(group.keyName);
        const enabled = total >= 1;
        const entityCount = SetDoorGroupEnabled(
            group.entityPrefix,
            enabled
        );

        if (DEBUG) {
            Console.Log(
                `[manager] key door group: ${group.entityPrefix}, total=${total}, entities=${entityCount}, enabled=${enabled}`
            );
        }
    }
}

function MatchesStatCondition(value, condition) {
    if (!condition) {
        return true;
    }

    if (condition.min !== undefined && value < condition.min) {
        return false;
    }
    if (condition.max !== undefined && value > condition.max) {
        return false;
    }
    if (condition.exact !== undefined && value !== condition.exact) {
        return false;
    }

    return true;
}

function FireNamedRelay(relayName, inputData) {
    if (!relayName) {
        Console.Log("[manager] stat check relay name is empty");
        return false;
    }

    const relays = Entities.FindByName(relayName);
    if (relays.length === 0) {
        Console.Log(`[manager] stat check relay not found: ${relayName}`);
        return false;
    }

    Entities.FireInput({
        name: relayName,
        input: "Trigger",
        caller: inputData.caller,
        activator: inputData.activator
    });
    return true;
}

function ApplyStatCheckRule(inputData, ruleName, rule) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        Console.Log(`[manager] stat check has no activator player: ${ruleName}`);
        return;
    }

    const now = Instance.GetGameTime();
    const sourceKey = `${ruleName}:${playerState.slot}`;
    if (statCheckLastRunBySource.get(sourceKey) === now) {
        return;
    }
    statCheckLastRunBySource.set(sourceKey, now);

    const attack = playerState.stats.attack;
    const defence = playerState.stats.defence;
    const passed =
        MatchesStatCondition(attack, rule.attack) &&
        MatchesStatCondition(defence, rule.defence);
    const relayName = passed ? rule.successRelay : rule.failRelay;

    FireNamedRelay(relayName, inputData);
    Console.Log(
        `[manager] stat check: rule=${ruleName}, slot=${playerState.slot}, attack=${attack}, defence=${defence}, passed=${passed}, relay=${relayName}`
    );
}

function IsGemEntityName(name, prefix) {
    return (
        typeof name === "string" &&
        name.startsWith(prefix) &&
        /^\d+$/.test(name.slice(prefix.length))
    );
}

function TryClaimGem(inputData, gemId) {
    const playerState = GetPlayerState(inputData);
    if (!playerState || !gemId) {
        return undefined;
    }

    if (GetPlayerTeam(playerState) !== TEAM_CT) {
        Console.Log(
            `[manager] gem ignored: CT required, slot=${playerState.slot}, gem=${gemId}`
        );
        return undefined;
    }

    let claimedGems = claimedGemsByPlayer.get(playerState.slot);
    if (!claimedGems) {
        claimedGems = new Set();
        claimedGemsByPlayer.set(playerState.slot, claimedGems);
    }

    if (claimedGems.has(gemId)) {
        Console.Log(
            `[manager] gem already claimed: slot=${playerState.slot}, player=${playerState.controller.GetPlayerName()}, gem=${gemId}`
        );
        return undefined;
    }

    claimedGems.add(gemId);
    if (DEBUG) {
        Console.Log(
            `[manager] gem claimed by slot=${playerState.slot}, player=${playerState.controller.GetPlayerName()}, gem=${gemId}`
        );
    }
    return playerState;
}

function HandleGem(inputData, gemId, statName) {
    const playerState = TryClaimGem(inputData, gemId);
    if (!playerState) {
        const activator = inputData && inputData.activator;
        const caller = inputData && inputData.caller;
        Console.Log(
            `[manager] gem ignored: ${gemId}, activator=${EntityValid(activator) ? activator.GetEntityName() || activator.GetClassName() : "none"}, caller=${EntityValid(caller) ? caller.GetEntityName() || caller.GetClassName() : "none"}`
        );
        return;
    }

    if (statName === "attack") {
        playerState.stats.attack += 1;
    } else if (statName === "defence") {
        playerState.stats.defence += 1;
    } else {
        return;
    }

    RefreshStatusHudForPlayer(playerState);
    LogCombatState(inputData);
    Console.Log(`[manager] gem claimed: ${gemId}`);
}

function HandleAddAttack(inputData) {
    const caller = inputData && inputData.caller;
    const callerName = EntityValid(caller) ? caller.GetEntityName() : "";

    if (IsGemEntityName(callerName, "tg_attack")) {
        HandleGem(inputData, callerName, "attack");
        return;
    }

    AddAttack(inputData);
}

function HandleAddDefence(inputData) {
    const caller = inputData && inputData.caller;
    const callerName = EntityValid(caller) ? caller.GetEntityName() : "";

    if (IsGemEntityName(callerName, "tg_defense")) {
        HandleGem(inputData, callerName, "defence");
        return;
    }

    AddDefence(inputData);
}

function RegisterGemInputs() {
    const gemTypes = [
        { prefix: "tg_attack", statName: "attack" },
        { prefix: "tg_defense", statName: "defence" }
    ];
    let registeredCount = 0;

    for (const { prefix, statName } of gemTypes) {
        const entities = GetEntitiesByBaseName(prefix);

        for (const entity of entities) {
            if (!EntityValid(entity)) {
                continue;
            }

            const gemId = entity.GetEntityName();
            if (!IsGemEntityName(gemId, prefix)) {
                continue;
            }

            RegisterScriptInputVariant(gemId, (inputData) => { // 注册单个攻击/防御宝石接口，每个玩家对同一宝石只能生效一次
                HandleGem(inputData, gemId, statName);
            });
            registeredCount += 1;
        }
    }

    Console.Log(`[manager] Gem inputs registered: ${registeredCount}`);
}

function AddAttack(inputData) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.attack += 1;
    RefreshStatusHudForPlayer(playerState);
    LogCombatState(inputData);
}

function AddDefence(inputData) {
    const playerState = GetPlayerState(inputData);
    if (!playerState) {
        return;
    }

    playerState.stats.defence += 1;
    RefreshStatusHudForPlayer(playerState);
    LogCombatState(inputData);
}

function LogCombatState(inputData) {
    if (!DEBUG) {
        return;
    }

    const playerState = GetPlayerState(inputData);
    Console.Log(
        `[manager] slot=${playerState ? playerState.slot : "none"}, attack=${playerState ? playerState.stats.attack : "none"}, defence=${playerState ? playerState.stats.defence : "none"}, floor=${playerState ? playerState.stats.floor : "none"}`
    );
}

RegisterScriptInputVariant("addattack", HandleAddAttack); // 个人攻击 +1；宝石触发时按玩家和宝石去重
RegisterScriptInputVariant("adddefence", HandleAddDefence); // 个人防御 +1；宝石触发时按玩家和宝石去重
RegisterScriptInputVariant("addhp", AddHealthToAllCt); // 所有存活 CT 当前生命和最大生命各 +20
// Boss1 技能
RegisterScriptInputVariant("boss1_hurt", (inputData) => {
    ApplyBoss1SkillDamage(inputData, "hurt");
}); // 单次伤害：max(最低伤害, hurt基础伤害 - 防御)
RegisterScriptInputVariant("boss1_laser", (inputData) => {
    ApplyBoss1SkillDamage(inputData, "laser");
}); // 单次伤害：max(最低伤害, laser基础伤害 - 防御)
RegisterScriptInputVariant("addyellowkey", (inputData) => { // 全队黄色钥匙 +1
    AddKey(inputData, "yellowkey");
});
RegisterScriptInputVariant("addbluekey", (inputData) => { // 全队蓝色钥匙 +1
    AddKey(inputData, "bluekey");
});
RegisterScriptInputVariant("addredkey", (inputData) => { // 全队红色钥匙 +1
    AddKey(inputData, "redkey");
});
RegisterScriptInputVariant("useyellowkey", (inputData) => { // 全队黄色钥匙 -1，最低为 0
    UseKey(inputData, "yellowkey");
});
RegisterScriptInputVariant("usebluekey", (inputData) => { // 全队蓝色钥匙 -1，最低为 0
    UseKey(inputData, "bluekey");
});
RegisterScriptInputVariant("useredkey", (inputData) => { // 全队红色钥匙 -1，最低为 0
    UseKey(inputData, "redkey");
});

RegisterScriptInputVariant("enablectshop", () => { // 开启 CT 商店，之后 CT 可聊天输入 sd
    ctShopEnabled = true;
    Console.Log("[manager] CT shop enabled");
});
RegisterScriptInputVariant("enabletshop", () => { // 开启 T 商店标记，目前没有 T 商店界面
    tShopEnabled = true;
    Console.Log("[manager] T shop enabled");
});

RegisterScriptInputVariant("addcoin", (inputData) => { // 触发者个人金币 +1
    AdjustCoinsFromInput(inputData, 1);
});
RegisterScriptInputVariant("removecoin", (inputData) => { // 触发者个人金币 -1，最低为 0
    AdjustCoinsFromInput(inputData, -1);
});
RegisterScriptInputVariant("resetcoins", ResetCoinsFromInput); // 清空触发者个人金币

RegisterScriptInputVariant("addcoin10", (inputData) => { // 测试接口：触发者个人金币 +10
    AdjustCoinsFromInput(inputData, 10);
});

RegisterScriptInputVariant("addctcoinprogress", (inputData) => { // 触发者 CT 枪械伤害计数 +1，满阈值自动获得金币
    AddCoinProgressFromInput(inputData, "ct");
});
RegisterScriptInputVariant("resetctcoinprogress", (inputData) => { // 清空触发者 CT 枪械伤害计数
    ResetCoinProgressFromInput(inputData, "ct");
});
RegisterScriptInputVariant("addtcoinprogress", (inputData) => { // 触发者 T 承伤计数 +1，满阈值自动获得金币
    AddCoinProgressFromInput(inputData, "t");
});
RegisterScriptInputVariant("resettcoinprogress", (inputData) => { // 清空触发者 T 承伤计数
    ResetCoinProgressFromInput(inputData, "t");
});

RegisterScriptInputVariant("addplayerattack", (inputData) => { // 触发者个人攻击 +1，最低为 1
    AdjustPlayerAttack(inputData, 1);
});
RegisterScriptInputVariant("addplayerattack10", (inputData) => { // 触发者个人攻击 +10
    AdjustPlayerAttack(inputData, 10);
});
RegisterScriptInputVariant("removeplayerattack", (inputData) => { // 触发者个人攻击 -1，最低为 1
    AdjustPlayerAttack(inputData, -1);
});
RegisterScriptInputVariant("addplayerdefence", (inputData) => { // 触发者个人防御 +1，最低为 1
    AdjustPlayerDefence(inputData, 1);
});
RegisterScriptInputVariant("removeplayerdefence", (inputData) => { // 触发者个人防御 -1，最低为 1
    AdjustPlayerDefence(inputData, -1);
});
RegisterScriptInputVariant("addplayerhp", (inputData) => { // 触发者个人最大生命和当前生命 +20
    AdjustPlayerHealth(inputData, SHOP_ITEMS.health.amount);
});
RegisterScriptInputVariant("removeplayerhp", (inputData) => { // 触发者个人最大生命和当前生命 -20，最低为 1
    AdjustPlayerHealth(inputData, -SHOP_ITEMS.health.amount);
});
for (let amount = 1; amount <= MAX_PARAMETERIZED_STAT_AMOUNT; amount++) {
    RegisterScriptInputVariant(`addattack${amount}`, (inputData) => { // 触发者个人攻击 +指定后缀数值
        AdjustPlayerAttack(inputData, amount);
    });
    RegisterScriptInputVariant(`adddefence${amount}`, (inputData) => { // 触发者个人防御 +指定后缀数值
        AdjustPlayerDefence(inputData, amount);
    });
}
for (const [ruleName, rule] of Object.entries(STAT_CHECK_RULES)) {
    RegisterScriptInputVariant(ruleName, (inputData) => { // 按 evnet_choice_N 输入名选择规则，按 activator 玩家属性判定
        ApplyStatCheckRule(inputData, ruleName, rule);
    });
}
RegisterScriptInputVariant("add_queen_of_pain", SetQueenOfPain); // 指定触发者为女王；之后该玩家按 E 会锁定移动并触发女王按钮
RegisterScriptInputVariant("sonic_wave", HandleSonicWave); // 以女王位置为起点水平推开触发者，并造成 5 段防御减伤
RegisterScriptInputVariant("sonic_wave_damage", HandleSonicWaveDamage); // 单独对触发者执行 5 段 sonic wave 防御减伤
RegisterScriptInputVariant("sonic_wave_damage_up", () => { // 提高 sonic wave 每段基础伤害 1 点
    AdjustSonicWaveBaseDamage(1);
});
RegisterScriptInputVariant("sonic_wave_damage_down", () => { // 降低 sonic wave 每段基础伤害 1 点，最低为 0
    AdjustSonicWaveBaseDamage(-1);
});
for (const [animationKey, animation] of Object.entries(
    CHARACTER_HUD_ANIMATIONS
)) {
    RegisterScriptInputVariant(animation.startInput, (inputData) => { // 只给触发玩家播放对应角色动画
        StartCharacterHud(inputData, animationKey);
    });
    RegisterScriptInputVariant(animation.allStartInput, (inputData) => { // 给所有玩家播放对应角色动画
        StartAllCharacterHud(inputData, animationKey);
    });
}
RegisterScriptInputVariant("endcharacter", EndCharacterHud); // 结束触发玩家的个人角色动画并恢复默认 HUD
RegisterScriptInputVariant("endcharacterall", EndAllCharacterHud); // 结束全局和全部个人角色动画并恢复所有玩家默认 HUD
RegisterScriptInputVariant("npchurt_gslime", (inputData) => { // 玩家攻击绿色史莱姆
    HandleNpcAttack("gslime", inputData);
});
RegisterScriptInputVariant("npchurt_rslime", (inputData) => { // 玩家攻击红色史莱姆
    HandleNpcAttack("rslime", inputData);
});

for (const [configKey, config] of Object.entries(NPC_CONFIG)) {
    RegisterScriptInput(config.makerInput, () => { // NPC 生成后自动绑定血量文本和死亡 relay
        HandleMakerSpawned(configKey);
    });
}

RegisterScriptInput("test_npc_text", RefreshAllNpcTexts); // 测试接口：刷新所有 NPC 血量文本

for (let floor = 0; floor <= 50; floor++) {
    const setFloor = (inputData) => SetCurrentFloor(inputData, floor);
    RegisterScriptInputVariant(`floor${floor}`, setFloor); // 设置触发玩家楼层，例如 floor7
    RegisterScriptInputVariant(`floor_${floor}`, setFloor); // 设置触发玩家楼层，例如 floor_7
    RegisterScriptInputVariant(`setfloor${floor}`, setFloor); // 设置触发玩家楼层，例如 setfloor7
}

Instance.OnPlayerDamage(HandlePlayerDamage);
Instance.OnPlayerKill(HandlePlayerKilled); // 女王技能窗口内发生击杀时播放一次击杀音效
Instance.OnRoundEnd(HandleQueenRoundEnd); // T 获胜且女王存在时触发女王胜利音效
Instance.OnPlayerChat(HandlePlayerChat); // 玩家聊天输入 sd 时尝试打开商店
Instance.OnCustomHudClicked(({ player, buttonId }) => {
    HandleShopButton(player, buttonId);
}); // 处理商店标签切换、购买和关闭按钮

Instance.OnActivate(() => {
    Console.Log("[manager] Script activated");
    RegisterGemInputs();
    ResetNpcInstances();
    RefreshAllNpcTextsDelayed();
    SetStatusHudDefaultValues();
    RefreshAllStatusHud();
    RefreshKeyDoorAccess();
    ResetCharacterHudForAllPlayers();
    CloseAllShops(GetStatusHud());
    StartQueenOfPainThink();
    RefreshQueenHudVisibilityForAllPlayers();

    Instance.Delay(0.10).then(() => {
        SetStatusHudDefaultValues();
        RefreshAllStatusHud();
    });
    Instance.Delay(0.50).then(() => {
        RefreshAllStatusHud();
    });
});

Instance.OnRoundStart(() => {
    for (const stats of playerStats.values()) {
        stats.attack = DEFAULT_PLAYER_STATS.attack;
        stats.defence = DEFAULT_PLAYER_STATS.defence;
        stats.floor = DEFAULT_PLAYER_STATS.floor;
        stats.coins = DEFAULT_PLAYER_STATS.coins;
        stats.maxHealth = DEFAULT_PLAYER_STATS.maxHealth;
        stats.ctCoinHits = DEFAULT_PLAYER_STATS.ctCoinHits;
        stats.tCoinHits = DEFAULT_PLAYER_STATS.tCoinHits;
        stats.queenEnergy = DEFAULT_PLAYER_STATS.queenEnergy;
    }
    boss1DamageCooldownBySource.clear();
    claimedGemsByPlayer.clear();
    sharedKeys.yellowkey = 0;
    sharedKeys.bluekey = 0;
    sharedKeys.redkey = 0;
    ctShopEnabled = false;
    tShopEnabled = false;
    UnlockQueenOfPainMovement();
    queenOfPainController = undefined;
    sonicWaveKillWindow = undefined;
    qopLoadingPreviewToken += 1;
    qopLoadingPreviewEndTime = 0;

    ResetNpcInstances();
    RefreshAllNpcTextsDelayed();
    RefreshAllStatusHud();
    RefreshKeyDoorAccess();
    ResetCharacterHudForAllPlayers();
    CloseAllShops(GetStatusHud());
    RefreshQueenHudVisibilityForAllPlayers();
    Console.Log("[manager] Round reset");
});

Instance.OnPlayerActivate(({ player }) => {
    if (!EntityValid(player)) {
        return;
    }

    const stats = GetOrCreatePlayerStats(player);
    ApplyPlayerHealthStats(
        {
            controller: player,
            slot: player.GetPlayerSlot(),
            stats
        },
        true
    );
    RefreshStatusHudForPlayer({
        controller: player,
        slot: player.GetPlayerSlot(),
        stats
    });

    const hud = GetStatusHud();
    if (EntityValid(hud)) {
        SyncCharacterHudForPlayer(hud, player.GetPlayerSlot());
        RefreshQueenHudVisibilityForPlayer(
            hud,
            player.GetPlayerSlot()
        );
    }
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    const hud = GetStatusHud();
    if (EntityValid(hud)) {
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "attack"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "defence"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "floor"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "yellowkey"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "bluekey"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "redkey"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "status_panel",
            "coins"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "shop_hud",
            "coins"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "queen_hud",
            "queen_energy"
        );
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "queen_hud",
            "queen_skill_cost"
        );
    }

    playerStats.delete(playerSlot);
    claimedGemsByPlayer.delete(playerSlot);
    for (const cooldownKey of boss1DamageCooldownBySource.keys()) {
        if (cooldownKey.endsWith(`:${playerSlot}`)) {
            boss1DamageCooldownBySource.delete(cooldownKey);
        }
    }
    RefreshKeyDoorAccess();
    if (
        EntityValid(queenOfPainController) &&
        queenOfPainController.GetPlayerSlot() === playerSlot
    ) {
        UnlockQueenOfPainMovement();
        queenOfPainController = undefined;
        sonicWaveKillWindow = undefined;
    }
    if (EntityValid(hud)) {
        CloseShopForPlayer(hud, playerSlot);
        ResetCharacterHudForPlayer(hud, playerSlot);
        RefreshQueenHudVisibilityForPlayer(hud, playerSlot);
    }
});

Instance.OnPlayerReset(({ player }) => {
    if (!EntityValid(player)) {
        return;
    }

    const controller =
        player.GetPlayerController() ||
        player.GetOriginalPlayerController();
    if (!EntityValid(controller)) {
        return;
    }

    if (
        EntityValid(queenOfPainController) &&
        queenOfPainController.GetPlayerSlot() ===
            controller.GetPlayerSlot()
    ) {
        UnlockQueenOfPainMovement();
    }

    const stats = GetOrCreatePlayerStats(controller);
    ApplyPlayerHealthStats(
        {
            controller,
            slot: controller.GetPlayerSlot(),
            stats
        },
        true
    );

    const hud = GetStatusHud();
    if (EntityValid(hud)) {
        CloseShopForPlayer(hud, controller.GetPlayerSlot());
    }
});

RegisterScriptInput("killallt", () => { // 测试接口：杀死所有 T 玩家
    const players = Entities.FindByClass("player");

    for (const player of players) {
        if (player.GetTeamNumber() === TEAM_T) {
            player.SetHealth(1);
            player.TakeDamage({ damage: 999999 });
        }
    }
});

RegisterScriptInput("test_health", () => { // 测试接口：CT 少于 20 人时把所有 CT 生命设为 200
    let ctCount = 0;
    const players = Entities.FindByClass("player");

    for (const player of players) {
        if (player.GetTeamNumber() === TEAM_CT) {
            ctCount++;
        }
    }

    if (ctCount >= 20) {
        return;
    }

    for (const player of players) {
        if (player.GetTeamNumber() === TEAM_CT) {
            player.SetHealth(200);
        }
    }
});

RegisterScriptInput("floor6_addhp", () => { // 第 6 层接口：按 CT 人数设置两个推人血条的 SetHitMax
    let ctCount = 0;
    const players = Entities.FindByClass("player");

    for (const player of players) {
        if (player.GetTeamNumber() === TEAM_CT) {
            ctCount++;
        }
    }

    const maxValue = ctCount * 10;
    Entities.FireInput({
        name: "pushhp_floor6_1",
        input: "SetHitMax",
        value: maxValue
    });
    Entities.FireInput({
        name: "pushhp_floor6_2",
        input: "SetHitMax",
        value: maxValue
    });
});

RegisterScriptInput("zspeed1", () => { // 测试接口：把所有 T 设为 1 血后击杀
    const players = Entities.FindByClass("player");

    for (const player of players) {
        if (player.GetTeamNumber() === TEAM_T) {
            player.SetHealth(1);
            player.TakeDamage({ damage: 999999 });
        }
    }
});
