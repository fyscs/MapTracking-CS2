// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

// Hammer 实体配置：
// custom_hud_layout Name: red_text_hud_layout
// point_script      Name: red_text_hud_script
// point_script      Script: scripts/vscripts/red_text_hud.js
//
// 自定义文字：修改下面 TEXT_PRESETS 的字符串，然后重新编译脚本。
// 纯 RunScriptInput 输入目前按命令名触发，因此使用预设命令来设置文字。
const DEFAULT_TEXT = "提示文字";
const TEXT_PRESETS = {
    1: "- Fire Ball -",
    2: "- Psycho cut -",
    3: "- Earth Quake -",
    4: "- Ominous Wind -",
    5: "- Fire Power -",
    6: "- Summon Zombie -",
    7: "- Slow Down Module -",
    8: "- Acid Spray -",
    9: "- Ultimate Fire -",
    10: "- Data Analysis -",
};

function GetLayout() {
    const layouts = Instance.FindEntitiesByName("red_text_hud_layout");
    if (!layouts || layouts.length === 0) return null;

    const layout = layouts[0];
    return layout && layout.IsValid() ? layout : null;
}

function SetText(value) {
    const layout = GetLayout();
    if (!layout) return;
    layout.SetDialogVariableString("red_text_label", "content", String(value));
}

function Show() {
    const layout = GetLayout();
    if (!layout) return;
    layout.SetHasClass("red_text_panel", "Hidden", false);
}

function Hide() {
    const layout = GetLayout();
    if (!layout) return;
    layout.SetHasClass("red_text_panel", "Hidden", true);
}

function SetPreset(index, showAfterSetting = false) {
    const value = TEXT_PRESETS[index];
    if (typeof value !== "string") return;
    SetText(value);
    if (showAfterSetting) Show();
}

// 初始化：准备默认文案，但开局不显示 HUD。
SetText(DEFAULT_TEXT);
Hide();

Instance.OnScriptInput("ShowRedTextHud", () => Show());
Instance.OnScriptInput("HideRedTextHud", () => Hide());
Instance.OnScriptInput("ClearRedTextHud", () => SetText(""));
Instance.OnScriptInput("ResetRedTextHud", () => {
    SetText(DEFAULT_TEXT);
    Hide();
});

// SetRedText1..10：只改文字，不自动显示。
// ShowText1..10：改成对应文字并立即显示。
for (const key of Object.keys(TEXT_PRESETS)) {
    const index = Number(key);
    Instance.OnScriptInput(`SetRedText${index}`, () => SetPreset(index, false));
    Instance.OnScriptInput(`ShowText${index}`, () => SetPreset(index, true));
}
