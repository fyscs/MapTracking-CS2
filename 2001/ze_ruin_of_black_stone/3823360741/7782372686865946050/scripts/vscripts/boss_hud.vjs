import { Instance } from "cs_script/point_script";

// custom_hud_layout Name: boss_hud_layout
// point_script Script: scripts/vscripts/boss_hud.js
// 默认血量为 100/100；血量上限最多支持 20000 HP。血条为单条连续填充，HUD 默认隐藏。
const DEFAULT_MAX_HEALTH = 100;
const DEFAULT_TEXT = "BOSS · 第二阶段";

let maxHealth = DEFAULT_MAX_HEALTH;
let currentHealth = DEFAULT_MAX_HEALTH;
let hudVisible = false; // 默认隐藏，收到 ShowBossHud 后才显示

function GetLayout() {
    const found = Instance.FindEntitiesByName("boss_hud_layout");
    return found && found.length ? found[0] : null;
}
function SetClass(id, cls, value) {
    const layout = GetLayout();
    if (layout) layout.SetHasClass(id, cls, value);
}
function SetText(value) {
    const layout = GetLayout();
    if (layout) layout.SetDialogVariableString("boss_custom_text", "boss_text", String(value));
}
function SetHealthNumbers() {
    const layout = GetLayout();
    if (layout) layout.SetDialogVariableString("boss_health_numbers", "health_text", `${currentHealth}/${maxHealth}`);
}
function SetWidthClass(id, percent) {
    const layout = GetLayout();
    if (!layout) return;
    const snapped = Math.max(0, Math.min(100, Math.round(percent)));
    for (let p = 0; p <= 100; p++)
        layout.SetHasClass(id, `Width${p}`, p === snapped);
}
function UpdateBarDisplay() {
    const layout = GetLayout();
    if (!layout) return;

    // 单条连续血条，不分格；左侧固定，扣血时右边缘向左收缩。
    const percent = maxHealth > 0 ? (currentHealth / maxHealth) * 100 : 0;
    SetWidthClass("boss_fill", percent);

    SetHealthNumbers();
    SetClass("boss_health_hud", "Hidden", !hudVisible);
    SetClass("boss_custom_text_hud", "Hidden", !hudVisible);
}
// 受伤时只更新单条血条宽度，由 CSS 按参考 HUD 进行 1 秒线性过渡，不播放额外动画。
function ApplyDamage(amount) {
    const parsed = Number(amount);
    const damage = Number.isFinite(parsed) ? Math.max(0, Math.round(parsed)) : 0;
    if (damage <= 0 || currentHealth <= 0) return;
    currentHealth = Math.max(0, currentHealth - damage);
    UpdateBarDisplay();
}
function Reset() {
    maxHealth = DEFAULT_MAX_HEALTH;
    currentHealth = maxHealth;
    SetText(DEFAULT_TEXT);
    UpdateBarDisplay();
}
function SetMaxHealth(value) {
    const parsed = Number(value);
    if (!Number.isFinite(parsed)) return;
    maxHealth = Math.max(1, Math.min(20000, Math.round(parsed)));
    currentHealth = Math.min(currentHealth, maxHealth);
    UpdateBarDisplay();
}
function AddMaxHealth(amount) {
    const parsed = Number(amount);
    if (!Number.isFinite(parsed) || parsed <= 0) return;

    const oldMaxHealth = maxHealth;
    maxHealth = Math.max(1, Math.min(20000, maxHealth + Math.round(parsed)));
    // 上限实际增加多少，当前血量就同步增加多少；受 20000 HP 上限限制。
    const actualIncrease = maxHealth - oldMaxHealth;
    currentHealth = Math.min(maxHealth, currentHealth + actualIncrease);
    UpdateBarDisplay();
}
function SetHealth(value) {
    const parsed = Number(value);
    if (!Number.isFinite(parsed)) return;
    currentHealth = Math.max(0, Math.min(maxHealth, Math.round(parsed)));
    UpdateBarDisplay();
}
function Heal(amount) {
    if (currentHealth <= 0) return;
    const parsed = Number(amount);
    if (!Number.isFinite(parsed)) return;
    currentHealth = Math.min(maxHealth, currentHealth + Math.max(0, Math.round(parsed)));
    UpdateBarDisplay();
}

// 初始化
SetText(DEFAULT_TEXT);
UpdateBarDisplay();

Instance.OnScriptInput("ShowBossHud", () => { hudVisible = true; UpdateBarDisplay(); });
Instance.OnScriptInput("HideBossHud", () => { hudVisible = false; UpdateBarDisplay(); });
Instance.OnScriptInput("ResetBossHud", () => Reset());
Instance.OnScriptInput("HealthMinus1", () => ApplyDamage(1));
Instance.OnScriptInput("AddMaxHealth", () => AddMaxHealth(100)); // 默认增加 100；也可用 AddMaxHealth1..AddMaxHealth4000 自定义

for (let n = 1; n <= 4000; n++) {
    Instance.OnScriptInput(`AddMaxHealth${n}`, () => AddMaxHealth(n));
    Instance.OnScriptInput(`SetMaxHealth${n}`, () => SetMaxHealth(n));
}
for (let n = 0; n <= 4000; n++)
    Instance.OnScriptInput(`SetHealth${n}`, () => SetHealth(n));
for (let n = 1; n <= 4000; n++) {
    Instance.OnScriptInput(`Damage${n}`, () => ApplyDamage(n));
    Instance.OnScriptInput(`Heal${n}`, () => Heal(n));
}

// 常用的更高数值输入；内部上限可达 20000，避免注册数万个额外输入。
for (const n of [5000, 6000, 8000, 10000, 12000, 15000, 20000]) {
    Instance.OnScriptInput(`AddMaxHealth${n}`, () => AddMaxHealth(n));
    Instance.OnScriptInput(`SetMaxHealth${n}`, () => SetMaxHealth(n));
    Instance.OnScriptInput(`SetHealth${n}`, () => SetHealth(n));
    Instance.OnScriptInput(`Damage${n}`, () => ApplyDamage(n));
    Instance.OnScriptInput(`Heal${n}`, () => Heal(n));
}

// 文字预设；可继续复制注册行来添加自己的文案
Instance.OnScriptInput("SetTextBoss", () => SetText("BOSS"));
Instance.OnScriptInput("SetTextStage1", () => SetText("*** BOSS - Tesla ***"));
Instance.OnScriptInput("SetTextStage2", () => SetText("*** BOSS - Tesla EX ***"));
Instance.OnScriptInput("SetTextex1", () => SetText("*** BOSS - Tesla EX ***"));
Instance.OnScriptInput("SetTextex2", () => SetText("*** Boss - Dr.X ***"));
Instance.OnScriptInput("ClearBossText", () => SetText(""));
