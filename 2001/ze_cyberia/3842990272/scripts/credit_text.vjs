// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Console, Entities } from "cs_script/point_script";

// ==================== 配置 ====================
const HUD_NAME = "credit_hud";
const MAX_CHARS = 64;
const CHAR_INTERVAL = 0.1;   // 每个字出现间隔
const HOLD_DURATION = 3.0;    // 全部出现后停留时间
const FADE_DURATION = 0.35;   // 整句淡出时长（与 CSS 一致）
const TICK = 0.05;

// ==================== 文本内容 ====================
// position: "center" = 屏幕中间；"bottom" = 屏幕下方
const TEXTS = {
    mapper: { text: "map by m4dara", position: "center" },
    port:   { text: "Port by @Seth      Special thanks to Ayano♥", position: "bottom" }
};

// ==================== 状态 ====================
let layout = null;
const state = {
    active: false,
    phase: 0,          // 0=idle 1=typing 2=holding 3=fading
    charIndex: 0,
    text: "",
    holdEnd: 0,
    fadeEnd: 0
};

// ==================== 工具 ====================
function getLayout() {
    if (layout && layout.IsValid()) return layout;
    layout = null;
    const found = Entities.FindByName(HUD_NAME);
    if (found && found.length > 0 && found[0].IsValid()) layout = found[0];
    return layout;
}

function setCharText(i, text) {
    const l = getLayout();
    if (!l) return;
    l.SetDialogVariableString(`char_${i}`, `c${i}`, text);
}

function setCharVisible(i, visible) {
    const l = getLayout();
    if (!l) return;
    l.SetHasClass(`char_${i}`, "Visible", visible);
}

// 切换容器位置
function setPosition(position) {
    const l = getLayout();
    if (!l) return;
    l.SetHasClass("credit_container", "Center", position === "center");
    l.SetHasClass("credit_container", "Bottom", position === "bottom");
}

// 立即隐藏所有字符（打断旧动画时用）
function instantHideAll() {
    const l = getLayout();
    if (!l) return;
    for (let i = 0; i < MAX_CHARS; i++) {
        l.SetHasClass(`char_${i}`, "Visible", false);
        l.SetHasClass(`char_${i}`, "InstantHide", true);
    }
}

function clearInstantHide() {
    const l = getLayout();
    if (!l) return;
    for (let i = 0; i < MAX_CHARS; i++) {
        l.SetHasClass(`char_${i}`, "InstantHide", false);
    }
}

function clearAllText() {
    for (let i = 0; i < MAX_CHARS; i++) {
        setCharText(i, "");
    }
}

// ==================== 开始显示 ====================
function startCredit(text, position) {
    const l = getLayout();
    if (!l) {
        Console.Log("[Credit] HUD 未找到");
        return;
    }

    // 1. 打断旧动画：瞬间隐藏所有字符
    instantHideAll();

    // 2. 切换位置
    setPosition(position);

    // 3. 设置新文本（多余位置清空）
    for (let i = 0; i < MAX_CHARS; i++) {
        setCharText(i, i < text.length ? text[i] : "");
    }

    // 4. 恢复过渡，准备淡入
    clearInstantHide();

    // 5. 重置状态
    state.active = true;
    state.phase = 1;
    state.charIndex = 0;
    state.text = text;
    state.holdEnd = 0;
    state.fadeEnd = 0;

    Instance.SetNextThink(Instance.GetGameTime());
    Console.Log(`[Credit] 开始显示 [${position}]: "${text}"`);
}

// ==================== Think 循环 ====================
function think() {
    if (!state.active) return;

    const now = Instance.GetGameTime();
    const l = getLayout();
    if (!l) {
        state.active = false;
        return;
    }

    if (state.phase === 1) {
        // 逐字淡入
        if (state.charIndex < state.text.length) {
            setCharVisible(state.charIndex, true);
            state.charIndex++;
            Instance.SetNextThink(now + CHAR_INTERVAL);
        } else {
            state.phase = 2;
            state.holdEnd = now + HOLD_DURATION;
            Instance.SetNextThink(now + TICK);
        }
    } else if (state.phase === 2) {
        // 停留
        if (now >= state.holdEnd) {
            state.phase = 3;
            for (let i = 0; i < MAX_CHARS; i++) {
                setCharVisible(i, false);
            }
            state.fadeEnd = now + FADE_DURATION;
            Instance.SetNextThink(now + TICK);
        } else {
            Instance.SetNextThink(now + TICK);
        }
    } else if (state.phase === 3) {
        // 等待淡出完成
        if (now >= state.fadeEnd) {
            clearAllText();
            state.phase = 0;
            state.active = false;
            Console.Log("[Credit] 显示结束");
            return;
        } else {
            Instance.SetNextThink(now + TICK);
        }
    }
}

// ==================== 事件 ====================
Instance.OnActivate(() => {
    Instance.SetThink(think);
    Console.Log("[Credit] 逐字字幕模块已加载");
});

// RunScriptInput "mapper" → 屏幕中间显示
Instance.OnScriptInput("mapper", () => {
    startCredit(TEXTS.mapper.text, TEXTS.mapper.position);
});

// RunScriptInput "port" → 屏幕下方显示
Instance.OnScriptInput("port", () => {
    startCredit(TEXTS.port.text, TEXTS.port.position);
});

// 热重载
Instance.OnScriptReload({
    before: () => {
        state.active = false;
        state.phase = 0;
        instantHideAll();
        clearInstantHide();
        clearAllText();
        return null;
    },
    after: () => {
        Console.Log("[Credit] 重载完成");
    },
});

Console.Log("[Credit] 模块初始化完成。");