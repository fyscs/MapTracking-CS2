.Root {
    width: 100%;
    height: 100%;
}
.CreditContainer {
    horizontal-align: center;
    vertical-align: center;
    flow-children: right;
}
.CreditContainer.Center {
    vertical-align: center;
    margin-bottom: 0px;
}
.CreditContainer.Bottom {
    vertical-align: bottom;
    margin-bottom: 120px;
}
.CreditChar {
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    text-shadow: 2px 2px 4px #000000, 2px 2px 6px #000000;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    margin: 0px;
}
.CreditChar.Visible {
    opacity: 1;
}
.CreditChar.InstantHide {
    opacity: 0;
    transition-duration: 0s;
}
