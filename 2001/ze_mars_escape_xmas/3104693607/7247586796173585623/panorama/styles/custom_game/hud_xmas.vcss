.Xmas.ShowLenny .Lenny,.Xmas.ShowLevel .Level,.Xmas.ShowModifier .Modifier,.Xmas.ShowBomb .Bomb,.Xmas.ShowRebirth .Rebirth,.Xmas.ShowCowbell .Cowbell,.Xmas.ShowSnowball .Snowball,.Xmas.ShowArtorias .Artorias,.Xmas.ShowTruthSeek .TruthSeek,.Xmas.ShowPrimary .Primary,.Xmas.ShowSecondary .Secondary {
