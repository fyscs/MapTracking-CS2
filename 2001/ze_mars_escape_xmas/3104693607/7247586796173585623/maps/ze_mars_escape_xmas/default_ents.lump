    "connections": [
      {
        "output": "OnCase04",
        "target": "!self",
        "input": "RunScriptCode",
        "param": "foreach(players in WinnerArray)EntFire(_.Score1000,_.ApplyScore,__,0.00,players);",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnCase04",
        "target": "!self",
        "input": "RunScriptCode",
        "param": "foreach(players in WinnerArray){players.ValidateScriptScope();foreach(userid in EX2Winners){if(players.GetScriptScope().myUserID==userid\u0026\u0026EX2Winners.len()!=0)return;}EX2Winners.push(players.GetScriptScope().myUserID);};",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnCase04",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ** YOU ARE THE MASTERS OF MAKO REACTOR! **",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnCase03",
        "target": "!self",
        "input": "RunScriptCode",
        "param": "foreach(players in WinnerArray)EntFire(_.Score100,_.ApplyScore,__,0.00,players);",
        "delay": 1,
        "limit": 1
      },
