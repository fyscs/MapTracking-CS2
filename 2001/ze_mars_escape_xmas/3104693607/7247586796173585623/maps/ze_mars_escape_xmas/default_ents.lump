        "output": "OnCase02",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say ** You did it ! You won at the HARDEST difficult ** Time to EXTREME mode ** Good luck ! **",
        "delay": 0,
        "limit": 1
      },
