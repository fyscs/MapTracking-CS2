let radio_bag = []; // indexes into RADIO_SONGS not yet played this cycle
let radio_timer; // pending "next song" timeout
let radio_stopped = false; // set by input_stop_all_xmas_music, cleared on round start
function radio_play_event(event) {
    // stop whatever is playing, swap the soundevent, start it
    ent_fire_name({ name: RADIO_ENT, input: "StopSound" });
    ent_fire_name({ name: RADIO_ENT, input: "SetSoundEventName", value: event, delay: 0.05 });
    ent_fire_name({ name: RADIO_ENT, input: "StartSound", delay: 0.1 });
}
// current music pitch (snd_modify_pitch). Truth plays everything at 0.5, so songs take 1/pitch as long.
let MUSIC_PITCH = 1.0;
/** Set the music pitch and remember it so the radio queue knows how long songs really last. */
function set_music_pitch(pitch) {
    MUSIC_PITCH = pitch;
    ent_fire_name({ name: "snd_modify_pitch", input: "SetFloatValue", value: pitch.toFixed(1) });
}
/** Play a song now and queue the next one for when it ends (replaces any pending queue). */
function radio_play(event, length) {
    if (radio_timer !== undefined) {
        clearTimeout(radio_timer);
        radio_timer = undefined;
    }
    radio_play_event(event);
    // lower pitch = slower playback = longer song (0.5 pitch -> twice as long)
    const real_length = length / (MUSIC_PITCH > 0 ? MUSIC_PITCH : 1);
    radio_timer = setTimeout(() => { radio_timer = undefined; radio_new_song(); }, (real_length + RADIO_GAP) * 1000);
}
/** Next song from a shuffle bag: every song plays once before any repeats. */
function radio_new_song() {
    if (radio_stopped)
        return;
    if (radio_bag.length == 0) {
        radio_bag = RADIO_SONGS.map((_, i) => i);
        for (let i = radio_bag.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [radio_bag[i], radio_bag[j]] = [radio_bag[j], radio_bag[i]];
        }
    }
    const [event, length] = RADIO_SONGS[radio_bag.pop()];
    radio_play(event, length);
}
function radio_stop_all() {
    radio_stopped = true;
    if (radio_timer !== undefined) {
        clearTimeout(radio_timer);
        radio_timer = undefined;
    }
    ent_fire_name({ name: RADIO_ENT, input: "StopSound" });
}
/**
 * Mapper cheat: play a song right now. Pass a number (plays xmas.music.song_N) or a string
 * (exact, else partial, case-insensitive match on the soundevent name, e.g. "fountain" or "song_4").
 * Stops the current song, plays the new one and queues the next song after it, like normal.
 * Does nothing after input_stop_all_xmas_music. Chat (mapper only): !song <number|text>
 */
function radio_override(song) {
    if (radio_stopped)
        return false;
    const all = [...RADIO_SONGS, ...RADIO_EXTRA_SONGS];
    let match;
    if (typeof song === "number" || /^\d+$/.test(song)) {
        match = all.find(s => s[0] == "xmas.music.song_" + song);
    }
    else {
        const q = song.toLowerCase();
        match = all.find(s => s[0].toLowerCase() == q) ?? all.find(s => s[0].toLowerCase().includes(q));
    }
    if (!match) {
        Console.Log("radio_override: no match for " + song);
        return false;
    }
    Console.Log("radio_override: " + match[0]);
    radio_play(match[0], match[1]);
    return true;
}
/**
 * Skip the current song: advances the shuffle queue and plays the next song (replacing the pending timer).
 * Does nothing after input_stop_all_xmas_music. Chat (mapper only): !skip
 */
function radio_skip() {
    if (radio_stopped)
        return false;
    radio_new_song();
    return true;
}
Instance.OnScriptInput("input_radio_new_song", () => {
    radio_new_song();
});
Instance.OnScriptInput("input_stop_all_xmas_music", () => {
    radio_stop_all();
});
// Truth loop: restarts the "truth" point_soundevent every time the song ends until input_music_truth_stop.
const TRUTH_MUSIC_ENT = "truth";
// soundevents the truth ent loops (SetSoundEventName): fake before the santassination ending, new after it. lengths in seconds
const TRUTH_MUSIC_FAKE = ["xmas.music.truth_fake", 131.736 - 2]; // sounds/music/truth_fake.mp3
const TRUTH_MUSIC_NEW = ["xmas.music.truth_new", 231.528 - 6]; // sounds/music/truth_new.mp3
let truth_loop_timer;
/** Swap the truth ent to `track`, start it, and restart it every time it ends (until truth_music_stop). */
function truth_music_play(track = TRUTH_MUSIC_FAKE) {
    if (truth_loop_timer !== undefined) {
        clearTimeout(truth_loop_timer);
        truth_loop_timer = undefined;
    }
    radio_stop_all();
    ent_fire_name({ name: TRUTH_MUSIC_ENT, input: "StopSound" });
    ent_fire_name({ name: TRUTH_MUSIC_ENT, input: "SetSoundEventName", value: track[0], delay: 0.02 });
    ent_fire_name({ name: TRUTH_MUSIC_ENT, input: "StartSound", delay: 0.05 });
    truth_loop_timer = setTimeout(() => { truth_music_play(track); }, track[1] * 1000);
}
// truth ringer: global "truth" ring every 20-40s, starts when the santassination ending finishes, stops with the truth music
const TRUTH_RINGER_SFX = "xmas.sfx.truth.ringer.global.truth";
const TRUTH_RINGER_MIN = 20;
const TRUTH_RINGER_MAX = 40;
let truth_ringer_timer;
function truth_ringer_start() {
    truth_ringer_stop();
    const schedule = () => {
        const wait = TRUTH_RINGER_MIN + Math.random() * (TRUTH_RINGER_MAX - TRUTH_RINGER_MIN);
        truth_ringer_timer = setTimeout(() => {
            new AnySFX(TRUTH_RINGER_SFX);
            schedule();
        }, wait * 1000);
    };
    schedule();
}
function truth_ringer_stop() {
    if (truth_ringer_timer !== undefined) {
        clearTimeout(truth_ringer_timer);
        truth_ringer_timer = undefined;
    }
}
function truth_music_stop() {
    if (truth_loop_timer !== undefined) {
        clearTimeout(truth_loop_timer);
        truth_loop_timer = undefined;
    }
    truth_ringer_stop();
    ent_fire_name({ name: TRUTH_MUSIC_ENT, input: "StopSound" });
}
Instance.OnScriptInput("input_music_truth", () => {
    truth_music_play(TRUTH_MUSIC_FAKE);
});
Instance.OnScriptInput("input_music_truth_stop", () => {
    truth_music_stop();
});
