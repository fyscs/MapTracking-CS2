// ---- limited ammo hud: per player (primary_ammo / secondary_ammo), hidden at round end ----
function update_ammo_hud(player) {
    const hud = xmas_hud();
    const controller = player?.GetPlayerController();
    if (!hud || !controller?.IsValid()) {
        return;
    }
    const slot = controller.GetPlayerSlot();
    hud.SetDialogVariableStringForPlayer(slot, XMAS_HUD_PANEL, "primary_ammo", player.primary_ammo.toString());
    hud.SetDialogVariableStringForPlayer(slot, XMAS_HUD_PANEL, "secondary_ammo", player.secondary_ammo.toString());
    hud.SetHasClassForPlayer(slot, XMAS_HUD_PANEL, "ShowPrimary", true);
    hud.SetHasClassForPlayer(slot, XMAS_HUD_PANEL, "ShowSecondary", true);
}
function hide_ammo_hud() {
    const hud = xmas_hud();
    if (!hud) {
        return;
    }
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowPrimary", false);
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowSecondary", false);
    // per-player overrides beat the all-player value, so clear them too (omitting hasClass defers to the all-player value)
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (controller?.IsValid()) {
            hud.SetHasClassForPlayer(controller.GetPlayerSlot(), XMAS_HUD_PANEL, "ShowPrimary");
            hud.SetHasClassForPlayer(controller.GetPlayerSlot(), XMAS_HUD_PANEL, "ShowSecondary");
        }
    }
}
