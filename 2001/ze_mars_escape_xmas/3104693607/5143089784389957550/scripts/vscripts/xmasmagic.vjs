const BRIDGE_BAHAMUT_HITBOX_HP_MAX = 100000;
const BRIDGE_BAHAMUT_HITBOX_HP_PLAYER = 333; //css 300
let BRIDGE_BAHAMUT_HITBOX_HP = 25; //css 20
let BRIDGE_BAHAMUT_HITBOX_DAMAGE = 0;
const EX2_LASER_HITBOX_HP_MAX = 100000;
const EX2_LASER_HITBOX_HP_PLAYER = 250; //css 200
const EX2_LASER_HITBOX_HP_DIE = 150;
let EX2_LASER_HITBOX_HP = 25; //css 20
let EX2_LASER_HITBOX_DAMAGE = 0;
let LIMIT_BREAK_BAHAMUT = 0;
let LIMIT_BREAK_SEPHIROTH = 0;
Instance.OnScriptInput("input_ex2_bridge_stuff", () => {
    const temp_hitbox = find_ent("EX2BahamutAndLaserHitboxTemplate");
    if (!temp_hitbox?.IsValid()) {
        Console.Log("input_ex2_bridge_stuff: EX2BahamutAndLaserHitboxTemplate not found");
        return;
    }
    const ents = (temp_hitbox.ForceSpawn() ?? []);
    for (const ent of ents) {
        if (ent.GetEntityName() == "BridgeBahamutHitbox") {
            BRIDGE_BAHAMUT_HITBOX_HP = 20;
            BRIDGE_BAHAMUT_HITBOX_DAMAGE = 0;
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    BRIDGE_BAHAMUT_HITBOX_HP += BRIDGE_BAHAMUT_HITBOX_HP_PLAYER;
                }
            }
            LIMIT_BREAK_BAHAMUT = BRIDGE_BAHAMUT_HITBOX_HP * 0.3;
            ent_fire_target({ target: ent, input: "SetDamageFilter", value: "filter_ct", delay: 1 });
            const id_dead_tracker = connect_output(ent, "OnBreak", () => {
                sephiroth_time();
                disconnect_output(id_dead_tracker);
                disconnect_output(id_hp_tracker);
            });
            const id_hp_tracker = connect_output(ent, "OnHealthChanged", (stuff) => {
                const player = stuff.activator;
                const health_raw = stuff.value;
                if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    BRIDGE_BAHAMUT_HITBOX_DAMAGE = Math.floor((1 - health_raw) * BRIDGE_BAHAMUT_HITBOX_HP_MAX);
                    if (BRIDGE_BAHAMUT_HITBOX_DAMAGE > LIMIT_BREAK_BAHAMUT) {
                        ent_fire_name({ name: "Cloud_Limit_Break_Bahamut", input: "Trigger" });
                    }
                    if (BRIDGE_BAHAMUT_HITBOX_DAMAGE > BRIDGE_BAHAMUT_HITBOX_HP) {
                        ent_fire_target({ target: ent, input: "Break" });
                    }
                }
            });
        }
        if (ent.GetEntityName() == "EX2LaserHitbox") {
            connect_output(ent, "OnHealthChanged", (stuff) => {
                const player = stuff.activator;
                const health_raw = stuff.value;
                if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    EX2_LASER_HITBOX_DAMAGE = Math.floor((1 - health_raw) * EX2_LASER_HITBOX_HP_MAX);
                    if (EX2_LASER_HITBOX_DAMAGE > LIMIT_BREAK_SEPHIROTH) {
                        ent_fire_name({ name: "Cloud_Limit_Break_Sephiroth", input: "Trigger" });
                    }
                    if (EX2_LASER_HITBOX_DAMAGE > EX2_LASER_HITBOX_HP) {
                        ent_fire_target({ target: ent, input: "Break" });
                    }
                }
            });
        }
    }
});
function sephiroth_time() {
    EX2_LASER_HITBOX_HP = 20;
    EX2_LASER_HITBOX_DAMAGE = 0;
    const players = find_ents_by_class("player");
    for (const player of players) {
        if (player?.IsValid() && player.GetTeamNumber() == 3) {
            EX2_LASER_HITBOX_HP += EX2_LASER_HITBOX_HP_PLAYER;
        }
    }
    LIMIT_BREAK_SEPHIROTH = EX2_LASER_HITBOX_HP * 0.5;
    ent_fire_name({ name: "EX2LaserHitbox", input: "SetDamageFilter", value: "filter_ct", delay: 1 });
}
Instance.OnScriptInput("input_ex2_laser_die", (stuff) => {
    if (LEVEL != 2) {
        return;
    }
    const player = stuff.activator;
    player.SetOwner(undefined);
    if (player?.IsValid() && player.GetTeamNumber() == 3) {
        EX2_LASER_HITBOX_HP -= EX2_LASER_HITBOX_HP_DIE;
    }
});
Instance.OnScriptInput("input_ex2_laser_die_backup", (stuff) => {
    if (LEVEL != 2) {
        return;
    }
    const player = stuff.activator;
    const caller = stuff.caller;
    player.SetOwner(undefined);
    if (player?.GetTeamNumber() == 3 && player.IsAlive() && caller?.GetEntityName().includes("EX2LaserHurt")) {
        ent_fire_target({ target: player, input: "SetHealth", value: 0 });
        EX2_LASER_HITBOX_HP -= EX2_LASER_HITBOX_HP_DIE;
    }
});
/** ForceSpawn a point_template by name (optionally at a position/angle). Returns the spawned ents, or [] if it's missing. */
function force_spawn_template(name, origin, angles) {
    const temp = find_ent(name);
    if (!temp?.IsValid()) {
        Console.Log("force_spawn_template: " + name + " not found");
        return [];
    }
    return temp.ForceSpawn(origin, angles) ?? [];
}
// EX2LaserTemp spawn spots (one picked at random each time)
const EX2_LASER_SPOTS = [
    { origin: { x: 5736, y: 2201, z: 664 }, angles: { pitch: 0, yaw: 180, roll: 0 } },
    { origin: { x: 5736, y: 2201, z: 686 }, angles: { pitch: 0, yaw: 180, roll: 15 } },
    { origin: { x: 5736, y: 2201, z: 703 }, angles: { pitch: 0, yaw: 180, roll: 0 } },
    { origin: { x: 5736, y: 2201, z: 686 }, angles: { pitch: 0, yaw: 180, roll: -15 } },
];
const EX2_LASER_FLASH_TICK = 0.25; // seconds between color swaps
const EX2_LASER_FLASH_COLORS = ["255 0 0", "0 255 0"]; // alternates between these
/**
 * Find the func_door and light_omni2 in a spawned laser template and flash them between
 * EX2_LASER_FLASH_COLORS every EX2_LASER_FLASH_TICK seconds until the door is gone.
 */
function flash_laser(ents, template_name) {
    let door;
    let light;
    for (const ent of ents) {
        if (!ent?.IsValid())
            continue;
        if (ent.GetClassName() == "func_door" || ent.GetClassName() == "func_movelinear") {
            door = ent;
        }
        else if (ent.GetClassName() == "light_omni2") {
            light = ent;
        }
    }
    if (!door) {
        Console.Log("flash_laser: no func_door in " + template_name);
        return;
    }
    let index = 0;
    // apply the current color and advance to the next one
    const apply_color = () => {
        const color = EX2_LASER_FLASH_COLORS[index];
        const [r, g, b] = color.split(" ").map(Number);
        // direct call on the door so it changes this tick (an input would only land on the next I/O pass)
        door.SetColor({ r, g, b });
        if (light?.IsValid()) {
            ent_fire_target({ target: light, input: "SetColor", value: color });
        }
        index = (index + 1) % EX2_LASER_FLASH_COLORS.length;
    };
    // color it right away so it never shows white on spawn, then keep alternating
    apply_color();
    const interval = setInterval(() => {
        if (!door?.IsValid()) {
            clearInterval(interval);
            return;
        }
        apply_color();
    }, EX2_LASER_FLASH_TICK * 1000);
}
const BLOOD_FX_TEMPLATE = "temp_npc_particle";
const BLOOD_FX_HEIGHT = 0; // spawn at the chest, not the feet
/** Blood splat on a player (spawns temp_npc_particle at their chest). */
function BloodFX(player) {
    if (!player?.IsValid()) {
        return;
    }
    const o = player.GetAbsOrigin();
    force_spawn_template(BLOOD_FX_TEMPLATE, { x: o.x, y: o.y, z: o.z + BLOOD_FX_HEIGHT }, { pitch: 0, yaw: 0, roll: 0 });
}
Instance.OnScriptInput("input_ex2_after_boss_seph_laser", () => {
    const temp = find_ent("EX2AfterBossSephLaserTemp");
    flash_laser(force_spawn_template("EX2AfterBossSephLaserTemp", temp.GetAbsOrigin(), temp.GetAbsAngles()), "EX2AfterBossSephLaserTemp");
    ent_fire_name({ name: "SfxLaser", input: "StartSound" });
});
Instance.OnScriptInput("input_ex2_laser", () => {
    const spot = EX2_LASER_SPOTS[randomIntArray(0, EX2_LASER_SPOTS.length)];
    flash_laser(force_spawn_template("EX2LaserTemp", spot.origin, spot.angles), "EX2LaserTemp");
    ent_fire_name({ name: "SfxLaser", input: "StartSound" });
});
