// ---- snowball fight: zombies parry snowballs with the knife (hud_xmas label "{s:snowball_text}", zombies only) ----
const SNOWBALL_MODEL = "models/props_holidays/snowball/snowball.vmdl";
const SNOWBALL_SCALE = 2;
const PARRY_RANGE = 128; // max distance from the zombie's eyes to a snowball it can parry
const PARRY_CONE = 0.5; // snowball must be in front of the zombie (dot of aim vs direction, 0.5 = ~60 deg)
const PARRY_SPEED = 2000; // returned snowball speed (same as the thrown ones)
const PARRY_LIFETIME = 1.95; // returned snowball is removed after this many seconds (same as the thrown ones)
const PARRY_HIT_RADIUS = 40; // how close the returned snowball has to get to a human to count as a hit
const PARRY_SLOW_TIME = 3;
const PARRY_SLOW_SPEED = 0.5;
const PARRY_TICK = 0.05;
const PARRY_HUD_TICK = 0.1;
const PARRY_SFX_ATTEMPT = "xmas.sfx.sheath";
const PARRY_SFX_SUCCESS = "xmas.sfx.parry";
const PARRY_LOOKAHEAD = 0.15; // also parry snowballs that will pass within range in the next 0.15s
// "eye" = the returned snowball flies where the zombie is looking, "reverse" = straight back the way it came.
// Mapper chat: !parrymode toggles it.
let PARRY_RETURN_MODE = "eye";
let reflected_snowballs = [];
function reflected_snowball_for(ent) {
    if (!ent)
        return undefined;
    return reflected_snowballs.find(b => b.prop == ent);
}
Instance.OnKnifeAttack((stuff) => {
    if (!SNOWBALL_NADES)
        return;
    const zombie = stuff.weapon?.GetOwner();
    if (!zombie?.IsValid() || !zombie.IsAlive() || zombie.GetTeamNumber() != 2)
        return;
    const slot = player_slot(zombie);
    if (slot === undefined)
        return;
    const eye = zombie.GetEyePosition();
    const aim = getForwardVector(zombie.GetEyeAngles());
    let parried = 0;
    const nades = find_ents_by_class("hegrenade_projectile");
    for (const nade of nades) {
        if (!nade?.IsValid())
            continue;
        // snowballs move ~31u per tick, so check the closest point along where it will be over the next
        // PARRY_LOOKAHEAD seconds, not just where it is right now (otherwise the window is only ~60ms)
        const pos = nade.GetAbsOrigin();
        const path = Vector3Utils.scale(nade.GetAbsVelocity(), PARRY_LOOKAHEAD);
        const path_len_sq = Vector3Utils.dot(path, path);
        const t = path_len_sq > 0 ? Math.max(0, Math.min(1, Vector3Utils.dot(Vector3Utils.subtract(eye, pos), path) / path_len_sq)) : 0;
        const closest = Vector3Utils.add(pos, Vector3Utils.scale(path, t));
        const dist = Vector3Utils.distance(eye, closest);
        const facing = Vector3Utils.dot(aim, Vector3Utils.directionTowards(eye, closest));
        if (dist > PARRY_RANGE)
            continue;
        if (facing < PARRY_CONE)
            continue;
        reflect_snowball(nade, zombie, aim);
        parried++;
    }
    // every swing gets the sheath sound, a successful parry also gets the parry sound
    new AnySFX(PARRY_SFX_ATTEMPT, zombie.GetAbsOrigin(), zombie);
    if (parried > 0) {
        new AnySFX(PARRY_SFX_SUCCESS, zombie.GetAbsOrigin(), zombie);
        // one per snowball sent back (a single swing can catch more than one)
        parry_counts.set(slot, (parry_counts.get(slot) ?? 0) + parried);
        update_snowball_hud(zombie);
    }
});
/** Kill the thrown snowball and send a physics snowball back from where it was parried. */
function reflect_snowball(nade, parrier, aim) {
    const origin = nade.GetAbsOrigin();
    const incoming = nade.GetAbsVelocity();
    let dir = aim;
    if (PARRY_RETURN_MODE == "reverse" && !Vector3Utils.equals(incoming, { x: 0, y: 0, z: 0 })) {
        dir = Vector3Utils.inverse(Vector3Utils.normalize(incoming));
    }
    nade.Remove();
    const prop = Entities.Spawn([{ classname: "prop_physics", origin, angles: { pitch: 0, yaw: 0, roll: 0 }, model: SNOWBALL_MODEL }])?.[0];
    if (!prop?.IsValid()) {
        Console.Log("reflect_snowball: could not spawn the snowball prop");
        return;
    }
    prop.SetModelScale(SNOWBALL_SCALE);
    const velocity = Vector3Utils.scale(dir, PARRY_SPEED);
    prop.Teleport({ velocity });
    ent_fire_target({ target: prop, input: "Kill", delay: PARRY_LIFETIME });
    const ball = { prop, velocity, parrier, hit: false };
    reflected_snowballs = reflected_snowballs.filter(b => b.prop.IsValid() && !b.hit);
    reflected_snowballs.push(ball);
    const interval = setInterval(() => {
        if (!prop.IsValid() || ball.hit || CLEAR_ALL_INTERVAL) {
            clearInterval(interval);
            return;
        }
        const pos = prop.GetAbsOrigin();
        // close enough to a human: deal the damage through OnModifyPlayerDamage (which does the hit effects)
        for (const player of find_ents_by_class("player")) {
            if (!player?.IsValid() || !player.IsAlive() || player.GetTeamNumber() != 3)
                continue;
            const center = Vector3Utils.add(player.GetAbsOrigin(), { x: 0, y: 0, z: 36 });
            if (Vector3Utils.distance(center, pos) < PARRY_HIT_RADIUS) {
                player.TakeDamage({
                    damage: SNOWBALL_DMG,
                    inflictor: prop,
                    attacker: undefined,
                });
                // the hook didn't take it (e.g. damage filter): still pop the snowball
                if (!ball.hit) {
                    pop_reflected_snowball(ball);
                }
                clearInterval(interval);
                return;
            }
        }
        // hit the world: it got knocked off its line, so pop it like the thrown ones
        const vel = prop.GetAbsVelocity();
        const speed = Vector3Utils.distance(vel, { x: 0, y: 0, z: 0 });
        if (speed < PARRY_SPEED * 0.5 || Vector3Utils.dot(Vector3Utils.normalize(vel), Vector3Utils.normalize(ball.velocity)) < 0.7) {
            pop_reflected_snowball(ball);
            clearInterval(interval);
            return;
        }
        // keep it flying straight (no drop, no slowdown)
        prop.Teleport({ velocity: ball.velocity });
    }, PARRY_TICK * 1000);
}
/** Snowball impact effect + remove the prop (deferred, it may be mid-damage). */
function pop_reflected_snowball(ball) {
    ball.hit = true;
    if (!ball.prop.IsValid())
        return;
    temp_fx_snowball_impact?.ForceSpawn(ball.prop.GetAbsOrigin());
    ent_fire_target({ target: ball.prop, input: "Kill" });
}
/** A returned snowball hit a human: effect, remove it, slow them. Damage is returned by the hook. */
function reflected_snowball_hit(ball, player) {
    pop_reflected_snowball(ball);
    const until = Instance.GetGameTime() + PARRY_SLOW_TIME;
    player.parry_slow_until = until;
    ent_fire_target({ target: player, input: "KeyValues", value: "speed " + PARRY_SLOW_SPEED });
    setTimeout(() => {
        // only undo our own slow (a newer hit extends it)
        if (player?.IsValid() && player.parry_slow_until == until) {
            ent_fire_target({ target: player, input: "KeyValues", value: "speed 1" });
        }
    }, PARRY_SLOW_TIME * 1000);
}
// Parry state is keyed by player slot (the knife hook gets the pawn from weapon.GetOwner(), the hud loop from
// find_ents_by_class; a slot is the same either way). Reset every round.
const parry_counts = new Map(); // slot -> snowballs parried this round
const snowball_hud_sent = new Map(); // slot -> what the hud currently shows
function player_slot(player) {
    const controller = player?.GetPlayerController();
    return controller?.IsValid() ? controller.GetPlayerSlot() : undefined;
}
/** Per player: zombies see the parry status, everyone else has it hidden. Only sends changes. */
function update_snowball_hud(player) {
    const hud = xmas_hud();
    const slot = player_slot(player);
    if (!hud || slot === undefined)
        return;
    const show = SNOWBALL_NADES && player.IsAlive() && player.GetTeamNumber() == 2;
    let text = "";
    if (show) {
        text = "Parry (+Attack)\nParries: " + (parry_counts.get(slot) ?? 0);
    }
    const sent = snowball_hud_sent.get(slot);
    if (text !== sent?.text) {
        hud.SetDialogVariableStringForPlayer(slot, XMAS_HUD_PANEL, "snowball_text", text);
    }
    if (show !== sent?.shown) {
        hud.SetHasClassForPlayer(slot, XMAS_HUD_PANEL, "ShowSnowball", show);
    }
    snowball_hud_sent.set(slot, { text, shown: show });
}
function hide_snowball_hud() {
    const hud = xmas_hud();
    if (!hud)
        return;
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowSnowball", false);
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (controller?.IsValid()) {
            hud.SetHasClassForPlayer(controller.GetPlayerSlot(), XMAS_HUD_PANEL, "ShowSnowball");
        }
    }
    parry_counts.clear();
    snowball_hud_sent.clear();
    reflected_snowballs = [];
}
function snowball_hud_loop() {
    const interval = setInterval(() => {
        if (CLEAR_ALL_INTERVAL || !SNOWBALL_NADES) {
            clearInterval(interval);
            return;
        }
        for (const player of find_ents_by_class("player")) {
            if (player?.IsValid()) {
                update_snowball_hud(player);
            }
        }
    }, PARRY_HUD_TICK * 1000);
}
function snowball_fight() {
    snowball_hud_loop();
    const taxmen = find_ents_by_name("taxman");
    const interval = setInterval(() => {
        if (CLEAR_ALL_INTERVAL) {
            clearInterval(interval);
            return;
        }
        else {
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    for (const taxman of taxmen) {
                        ent_fire_target({ target: taxman, input: "SpendMoneyFromPlayer", activator: player });
                    }
                    const grenade = player.FindWeaponBySlot(3);
                    if (grenade?.IsValid()) {
                        player.SwitchToWeapon(grenade);
                        //Console.Log(grenade.GetData().GetName())
                        // if(!grenade.is_snowball){
                        //     const snowballs = temp_snowball_dummy.ForceSpawn(grenade.GetAbsOrigin()) as Entity[];
                        //     const nade_ent = grenade as Entity;
                        //     for(const snowball of snowballs){
                        //         if(snowball?.IsValid()){
                        //             snowball.SetParent(grenade);
                        //             ent_fire_target({target:snowball,input:"SetParentAttachment",value:"emit_spoon",delay:0.01});
                        //         }
                        //     }   
                        //     grenade.is_snowball = true;    
                        // }                       
                        //player.SwitchToWeapon(grenade);
                    }
                    else {
                        player.GiveNamedItem("weapon_hegrenade");
                        const newnade = player.FindWeaponBySlot(5);
                        if (newnade?.IsValid()) {
                            player.SwitchToWeapon(newnade);
                        }
                    }
                    for (let i = 0; i < 5; i++) {
                        const wep = player.FindWeaponBySlot(i);
                        if (i != 2 && i != 3 && wep != undefined && !wep.rebirth_wep) {
                            player.DestroyWeapon(wep);
                        }
                        if (i == 1 && wep != undefined && wep.rebirth_wep) {
                            wep.SetReserveAmmo(0);
                            wep.SetClipAmmo(0);
                        }
                    }
                }
                else if (player?.GetTeamNumber() == 2) {
                    if (player.GetHealth() > 100) {
                        player.SetHealth(100);
                    }
                    if (player.GetMaxHealth() > 100) {
                        player.SetMaxHealth(100);
                    }
                }
            }
        }
    }, MM_TICK * 1000);
}
function last_martian_standing() {
    const interval = setInterval(() => {
        if (CLEAR_ALL_INTERVAL) {
            clearInterval(interval);
            return;
        }
        else {
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 2) {
                    if (player.GetHealth() > 900) {
                        player.SetMaxHealth(900);
                        player.SetHealth(900);
                    }
                }
            }
        }
    }, MM_TICK * 1000);
}
// Like logic_case PickRandomShuffle: every value is used once (random order) before any repeats.
function make_shuffle_bag(values) {
    let bag = [];
    return () => {
        if (bag.length === 0) {
            bag = [...values];
            for (let i = bag.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [bag[i], bag[j]] = [bag[j], bag[i]];
            }
        }
        return bag.pop();
    };
}
const XMAS_TREE_NAME = "xmas_tree*";
const XMAS_TREE_SKINS = [0, 1, 2, 3];
const XMAS_TREE_ANIMS = ["windeez_1", "windeez_2"];
/** Give every xmas tree a random skin (0-3) and a random looping wind animation, shuffle-bag style. */
function randomize_xmas_trees() {
    const next_skin = make_shuffle_bag(XMAS_TREE_SKINS);
    const next_anim = make_shuffle_bag(XMAS_TREE_ANIMS);
    for (const tree of find_ents_by_name(XMAS_TREE_NAME)) {
        ent_fire_target({ target: tree, input: "Skin", value: next_skin() });
        ent_fire_target({ target: tree, input: "SetAnimationLooping", value: next_anim() });
    }
}
