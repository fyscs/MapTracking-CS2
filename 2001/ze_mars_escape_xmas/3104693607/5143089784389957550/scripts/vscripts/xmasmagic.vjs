        }
    }
    /** Humans only: aim with the eyes (!aim on) or point straight ahead from where they stand. */
    apply_aim(player) {
        if (!this.aim || !this.align?.IsValid() || player.GetTeamNumber() != 3) {
            return;
        }
        if (player.materia_aim) {
            ent_fire_target({ target: this.aim, input: "SetMeasureTarget", value: player.GetEntityName() });
            return;
        }
        const angles = player.GetAbsAngles();
        angles.pitch = 0;
        angles.roll = 0;
        const origin = player.GetAbsOrigin();
        origin.z += 64;
        this.align.Teleport({ position: Vector3Utils.add(origin, Vector3Utils.scale(getForwardVector(angles), 24)), angles });
