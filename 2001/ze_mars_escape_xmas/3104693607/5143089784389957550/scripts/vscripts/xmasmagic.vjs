const SURPRISE_MATERIAS_CT = [
    "Item_Wind_Template",
    "Item_Earth_Template",
    "Item_Ice_Template",
    "Item_Fire_Template",
    "Item_Elec_Template",
    "Item_Grav_Template",
    "Item_Ultima_Template",
    "Item_Heal_Template"
];
const SURPRISE_MATERIAS_ZM = [
    "Item_Wind_ZM_Template",
    "Item_Earth_ZM_Template",
    "Item_Ice_ZM_Template",
    "Item_Fire_ZM_Template",
    "Item_Elec_ZM_Template",
    "Item_Grav_ZM_Template",
    "Item_Ultima_ZM_Template",
    "Item_Heal_ZM_Template"
];
let TEMP_SURPRISE_MATERIAS = [];
const SURPRISE_FUMOS = [
    "temp_fumo_remilia",
    "temp_fumo_sanae",
    "temp_fumo_nitori",
    "temp_fumo_mokou",
    "temp_fumo_yuuka"
];
const SURPRISE_DEADCORE = [
    "enemy1_temp1",
    "enemy2_temp1",
    "enemy3_temp1"
];
let temp_elf;
let temp_bender;
let temp_surpise;
let temp_present;
let temp_beaver;
let TEMP_SURPRISE_FUMOS = [];
// ---- fumos: a human can carry one of each; they ride on a grenade attachment until the human dies / gets infected ----
const FUMO_ATTACHMENTS = {
    mokou: "grenade1",
    nitori: "grenade3",
    yuuka: "grenade0",
    sanae: "grenade2",
    remilia: "grenade4",
};
const FUMO_PICKUP_SFX = "xmas.sfx.fumo_pickup";
const FUMO_FADE_TIME = 1; // seconds to fade a carried fumo out when its human is lost
/** The fumos this player carries (name -> prop). Entries whose prop is gone (round restart, killed) are dropped. */
function held_fumos(player) {
    if (!player.fumos) {
        player.fumos = new Map();
    }
    for (const [name, prop] of player.fumos) {
        if (!prop?.IsValid()) {
            player.fumos.delete(name);
        }
    }
    return player.fumos;
}
/** Spawn a random fumo at origin. The first living human that touches it and doesn't already carry that fumo picks it up. */
const FUMO_SCALE = 0.375;
function spawn_fumo(origin) {
    const index = randomIntArray(0, TEMP_SURPRISE_FUMOS.length);
    const temp = TEMP_SURPRISE_FUMOS[index];
    if (!temp?.IsValid()) {
        Console.Log("spawn_fumo: missing " + SURPRISE_FUMOS[index]);
        return;
    }
    const name = SURPRISE_FUMOS[index].replace("temp_fumo_", "");
    const ents = (temp.ForceSpawn(origin) ?? []);
    const trigger = ents.find(e => e.GetEntityName().includes("fumo_" + name + "_trigger"));
    const prop = ents.find(e => e.GetClassName() == "prop_dynamic");
    if (!trigger || !prop) {
        Console.Log("spawn_fumo: " + name + " is missing its trigger or prop");
        return;
    }
    const id = connect_output(trigger, "OnStartTouch", (stuff) => {
        const player = stuff.activator;
        if (!player?.IsValid() || !player.IsAlive() || player.GetTeamNumber() != 3 || !prop.IsValid()) {
            return;
        }
        const held = held_fumos(player);
        if (held.has(name)) {
            return;
        }
        held.set(name, prop);
        disconnect_output(id);
        ent_fire_target({ target: trigger, input: "Kill" });
        prop.SetParent(player);
        ent_fire_target({ target: prop, input: "SetParentAttachment", value: FUMO_ATTACHMENTS[name], delay: ONE_TICK });
        const prop_bme = prop;
        FunctionDelay(() => {
            prop_bme.SetModelScale(FUMO_SCALE);
        }, ONE_TICK * 2);
        new AnySFX(FUMO_PICKUP_SFX, player_head(player));
    });
}
/** Fade an entity's alpha to 0 over `seconds`, then kill it. */
function fade_kill(ent, seconds) {
    const steps = 25;
    for (let i = 1; i <= steps; i++) {
        ent_fire_target({ target: ent, input: "Alpha", value: Math.round(255 * (1 - i / steps)), delay: seconds * i / steps });
    }
    ent_fire_target({ target: ent, input: "Kill", delay: seconds + ONE_TICK });
}
/** Human lost (infected / died): fade out and kill every fumo they carry. */
function drop_fumos(player) {
    if (!player?.fumos) {
        return;
    }
    for (const prop of player.fumos.values()) {
        if (prop?.IsValid()) {
            fade_kill(prop, FUMO_FADE_TIME);
        }
    }
    player.fumos.clear();
}
let TEMP_SURPRISE_DEADCORES = [];
function find_templates() {
    TEMP_SURPRISE_MATERIAS = [];
    TEMP_SURPRISE_FUMOS = [];
    TEMP_SURPRISE_DEADCORES = [];
    for (const fumo of SURPRISE_FUMOS) {
        TEMP_SURPRISE_FUMOS.push(find_ent(fumo));
    }
    temp_elf = find_ent("temp_npc_elf");
    temp_present = find_ent("temp_npc_present");
    temp_beaver = find_ent("temp_npc_beaver");
    npcs = [temp_elf, temp_present, temp_beaver];
    temp_bender = find_ent("temp_npc_bender");
    temp_surpise = find_ent("temp_xmas_present_particle");
    for (const materia of SURPRISE_MATERIAS_CT) {
        TEMP_SURPRISE_MATERIAS.push(find_ent(materia));
    }
    for (const materia of SURPRISE_MATERIAS_ZM) {
        TEMP_SURPRISE_MATERIAS.push(find_ent(materia));
    }
    for (const deadcore of SURPRISE_DEADCORE) {
        TEMP_SURPRISE_DEADCORES.push(find_ent(deadcore));
    }
}
const PRESENT_HEALTH = 67;
const PRESENT_HEALTH_MAX = 1000;
function xmas_presents_default() {
    const presents = find_ents_by_name("xmas_present");
    for (const present of presents) {
        if (present?.IsValid()) {
            present.health = PRESENT_HEALTH;
            const id = connect_output(present, "OnHealthChanged", (stuff) => {
                const health = stuff.value;
                const health_fixup = (1 - health) * PRESENT_HEALTH_MAX;
                if (MODE == "Knife Party" || MODE == "Snowball Fight" || health_fixup > PRESENT_HEALTH) {
                    const caller = stuff.caller;
                    const origin = caller.GetAbsOrigin();
                    const rng = getRandomInt(0, 100);
                    if (rng < 50) {
                        spawn_fumo(origin);
                        temp_surpise.ForceSpawn(origin);
                    }
                    else if (rng > 97 && MODE != "Knife Party" && MODE != "Snowball Fight") {
                        spawn_npc(origin);
                    }
                    disconnect_output(id);
                    ent_fire_target({ target: caller, input: "Break" });
                }
            });
        }
    }
}
// santa item templates truth presents can drop, with a per-round cap on each
const TRUTH_PRESENT_ITEMS = [
    { template: "s_item_rocketlauncher", max: 1 },
    { template: "s_item_laser", max: 2 },
    { template: "s_item_minigun", max: 2 },
    { template: "s_item_healthkit", max: 8 },
    { template: "s_item_speeder", max: 16 },
];
const TRUTH_PRESENT_NPC_CHANCE = 25; // % (1/4)
const TRUTH_PRESENT_ITEM_CHANCE = 33; // % (1/3), rolled after the npc chance so the two never overlap
function xmas_presents_truth() {
    const presents = find_ents_by_name("xmas_present");
    // fresh counts every round (this runs once per round from map_modifier)
    const item_counts = TRUTH_PRESENT_ITEMS.map(() => 0);
    /** Random item that hasn't hit its cap yet; nothing once they're all used up. */
    const spawn_truth_item = (origin) => {
        const open = TRUTH_PRESENT_ITEMS.map((_, i) => i).filter(i => item_counts[i] < TRUTH_PRESENT_ITEMS[i].max);
        if (open.length == 0) {
            return;
        }
        const i = open[Math.floor(Math.random() * open.length)];
        const temp = find_ent(TRUTH_PRESENT_ITEMS[i].template);
        if (!temp?.IsValid()) {
            Console.Log("xmas_presents_truth: no template " + TRUTH_PRESENT_ITEMS[i].template);
            return;
        }
        item_counts[i]++;
        temp.ForceSpawn(origin);
        temp_surpise?.ForceSpawn(origin);
    };
    for (const present of presents) {
        if (present?.IsValid()) {
            const id = connect_output(present, "OnHealthChanged", (stuff) => {
                const health = stuff.value;
                const health_fixup = (1 - health) * PRESENT_HEALTH_MAX;
                if (MODE == "Knife Party" || health_fixup > PRESENT_HEALTH) {
                    const caller = stuff.caller;
                    const origin = caller.GetAbsOrigin();
                    const rng = getRandomInt(0, 100);
                    if (rng < TRUTH_PRESENT_NPC_CHANCE) {
                        spawn_npc(origin);
                    }
                    else if (rng < TRUTH_PRESENT_NPC_CHANCE + TRUTH_PRESENT_ITEM_CHANCE) {
                        spawn_truth_item(origin);
                    }
                    disconnect_output(id);
                    ent_fire_target({ target: caller, input: "Break" });
                }
            });
        }
    }
}
const ZERO_EULER = new Euler(0, 0, 0);
const DEADCORE_CANNON_TEMPLATE = "cannon_item_temp";
const DEADCORE_CANNON_MAX = 3; // per round
const DEADCORE_CANNON_CHANCE = 33; // %, rolled when the enemy roll misses
const DEADCORE_NPC_Z_EXTRA = 8; // deadcore npcs spawn this much higher than the present's +64
function xmas_presents_deadcore() {
    const presents = find_ents_by_name("xmas_present");
    let cannons_spawned = 0; // fresh every round (this runs once per round)
    for (const present of presents) {
        if (present?.IsValid()) {
            const id = connect_output(present, "OnHealthChanged", (stuff) => {
                const health = stuff.value;
                const health_fixup = (1 - health) * PRESENT_HEALTH_MAX;
                if (MODE == "Knife Party" || health_fixup > PRESENT_HEALTH) {
                    const caller = stuff.caller;
                    let origin = caller.GetAbsOrigin();
                    origin.z += 64;
                    const rng = getRandomInt(0, 100);
                    if (rng < 25) {
                        const rng = randomIntArray(0, TEMP_SURPRISE_DEADCORES.length);
                        print(TEMP_SURPRISE_DEADCORES[rng]);
                        const npc_origin = { x: origin.x, y: origin.y, z: origin.z + DEADCORE_NPC_Z_EXTRA };
                        TEMP_SURPRISE_DEADCORES[rng].ForceSpawn(npc_origin, ZERO_EULER);
                    }
                    else if (rng < 25 + DEADCORE_CANNON_CHANCE && cannons_spawned < DEADCORE_CANNON_MAX) {
                        const temp = find_ent(DEADCORE_CANNON_TEMPLATE);
                        if (temp?.IsValid()) {
                            cannons_spawned++;
                            temp.ForceSpawn(origin, ZERO_EULER);
                            temp_surpise?.ForceSpawn(origin);
                        }
                        else {
                            Console.Log("xmas_presents_deadcore: no template " + DEADCORE_CANNON_TEMPLATE);
                        }
                    }
                    disconnect_output(id);
                    ent_fire_target({ target: caller, input: "Break" });
                }
            });
        }
    }
}
const DEADCORE_ENEMY_HP_PER = 20;
