/** Kill every living player on `team` (2 = T/zombies, 3 = CT/humans), or everyone if no team is given. */
function kill_all(team) {
    for (const player of find_ents_by_class("player")) {
        if (player?.IsValid() && player.IsAlive() && (team === undefined || player.GetTeamNumber() == team)) {
            ent_fire_target({ target: player, input: "SetHealth", value: 0 });
        }
    }
}
Instance.OnScriptInput("input_explosion_insane", (stuff) => {
    const caller = stuff.caller;
    if (caller?.IsValid()) {
        const temp = find_ent("temp_explosion_insane");
        temp.ForceSpawn(caller.GetAbsOrigin(), caller.GetAbsAngles());
    }
});
const EXPLOSION_INSANE_TEMPLATE = "temp_explosion_insane";
const EXPLOSION_INSANE_SPREAD = 512; // +- this many units on every axis around the picked player
/** Pick a random living human and ForceSpawn temp_explosion_insane somewhere within EXPLOSION_INSANE_SPREAD of them. */
function explosion_insane_random() {
    const humans = find_ents_by_class("player")
        .filter(p => p?.IsValid() && p.IsAlive() && p.GetTeamNumber() == 3);
    if (humans.length == 0) {
        return;
    }
    const pos = humans[randomIntArray(0, humans.length)].GetAbsOrigin();
    const jitter = () => (Math.random() * 2 - 1) * EXPLOSION_INSANE_SPREAD;
    force_spawn_template(EXPLOSION_INSANE_TEMPLATE, { x: pos.x + jitter(), y: pos.y + jitter(), z: pos.z + jitter() }, ZERO_EULER);
}
Instance.OnScriptInput("input_explosion_insane_random", () => {
    explosion_insane_random();
});
const SANTA_ITEM_INDEX = { rocket: 1, beam: 2, minigun: 3, herder: 4, heal: 5, speeder: 6 };
// per type height fix for the knife-out spot (paranoid's chainsaw needed -24); tune per item if one sits wrong
const SANTA_ITEM_Z_OFFSET = {};
const ITEM_ATTACH_TICK = 0.1;
const ATTACHMENT_GUN_OUT = "weapon";
const ATTACHMENT_KNIFE_OUT = "weapon_center";
const ATTACHMENT_KNIFE_OUT_OFFSET_FWD = 16;
const ATTACHMENT_KNIFE_OUT_OFFSET_UP = 48;
const SANTA_ITEM_REPICKUP_DELAY = 0.69;
let santa_items = []; // every connected santa item this round
class SantaItem {
    type;
    wep;
    button;
    relay;
    visual;
    helper;
    gun_out = true;
    interval;
    // where the visual sits on the holder in hammer, so it goes back to the same spot when dropped
    rest_origin;
    rest_angles;
    constructor(type, relay_name, connector, wep) {
        const n = SANTA_ITEM_INDEX[type];
        const rel = (part) => find_ent(relay_name.replace(connector, part + "_" + n));
        this.type = type;
        this.wep = wep;
        this.button = rel("item_button");
        this.relay = rel("item_relay");
        this.visual = rel("item_visual");
        this.helper = rel("item_helper");
        if (this.helper?.GetParent()?.GetEntityName() == wep.GetEntityName()) {
            this.rest_origin = this.helper.GetLocalOrigin();
            this.rest_angles = this.helper.GetLocalAngles();
        }
        this.connect();
    }
    /** Wire up from a connect relay (input_connect_<type>). */
    static from_relay(type, caller) {
        const relay_name = caller?.GetEntityName();
        if (!relay_name) {
            return;
        }
        const connector = "connect_" + type; // relay names are connect_<type>; only the input has "luffaren" in it
        const wep = find_ent(relay_name.replace(connector, "item_holder_" + SANTA_ITEM_INDEX[type]));
        if (!wep?.IsValid()) {
            Console.Log("SantaItem: no holder for " + type + " (" + relay_name + ")");
            return;
        }
        santa_items.push(new SantaItem(type, relay_name, connector, wep));
    }
    owner() {
        const owner = this.wep.IsValid() ? this.wep.GetOwner() : undefined;
        return owner?.IsValid() ? owner : undefined;
    }
    connect() {
        if (this.button) {
            connect_output(this.button, "OnPressed", (stuff) => {
                const owner = this.owner();
                if (owner && stuff.activator == owner && this.relay) {
                    ent_fire_target({ target: this.relay, input: "Trigger", activator: owner });
                    if (this.type == "speeder") {
                        new AnySFX("xmas.sfx.sxy", ZERO_VEC, this.wep?.GetOwner());
                    }
                }
            });
        }
        if (this.type == "heal" || this.type == "speeder") {
            this.helper?.Teleport({ position: this.wep.GetAbsOrigin(), angles: this.wep.GetAbsAngles() });
        }
        else {
            connect_output(this.wep, "OnPlayerPickup", () => { this.on_pickup(); });
        }
    }
    on_pickup() {
        const owner = this.owner();
        if (!owner || !this.helper?.IsValid()) {
            return;
        }
        if (this.interval !== undefined) {
            clearInterval(this.interval);
        }
        this.gun_out = true;
        this.helper.SetParent(owner);
        ent_fire_target({ target: this.helper, input: "SetParentAttachment", value: ATTACHMENT_GUN_OUT, delay: 0.01 });
        this.interval = setInterval(() => { this.attach_tick(); }, ITEM_ATTACH_TICK * 1000);
    }
    attach_tick() {
        const player = this.owner();
        if (!player || CLEAR_ALL_INTERVAL || !this.helper?.IsValid()) {
            this.on_drop();
            return;
        }
        const knife_out = !!player.GetActiveWeapon()?.GetClassName().includes("knife");
        if (knife_out && this.gun_out) {
            this.gun_out = false;
            const ang = player.GetAbsAngles();
            const pos = Vector3Utils.add(Vector3Utils.scale(getForwardVector(ang), ATTACHMENT_KNIFE_OUT_OFFSET_FWD), player.GetAbsOrigin());
            pos.z += ATTACHMENT_KNIFE_OUT_OFFSET_UP + (SANTA_ITEM_Z_OFFSET[this.type] ?? 0);
            this.helper.Teleport({ position: pos, angles: ang });
            ent_fire_target({ target: this.helper, input: "SetParentAttachmentMaintainOffset", value: ATTACHMENT_KNIFE_OUT });
        }
        else if (!knife_out && !this.gun_out) {
            this.gun_out = true;
            ent_fire_target({ target: this.helper, input: "SetParentAttachment", value: ATTACHMENT_GUN_OUT });
        }
    }
    /** Dropped (or owner gone / round over): put the visual back on the holder and block instant re-pickup. */
    on_drop() {
        if (this.interval !== undefined) {
            clearInterval(this.interval);
            this.interval = undefined;
        }
        this.gun_out = true;
        if (!this.wep.IsValid()) {
            return;
        }
        if (this.helper?.IsValid()) {
            this.helper.SetParent(this.wep);
            this.helper.Teleport(this.rest_pose());
        }
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp", delay: SANTA_ITEM_REPICKUP_DELAY });
    }
    /** World pose for the visual's hammer offset on the holder (falls back to the holder's own origin). */
    rest_pose() {
        const origin = this.wep.GetAbsOrigin();
        const angles = this.wep.GetAbsAngles();
        if (!this.rest_origin || !this.rest_angles) {
            return { position: origin };
        }
        const ax = angle_axes(angles);
        const lo = this.rest_origin;
        return {
            position: {
                x: origin.x + ax.forward.x * lo.x + ax.left.x * lo.y + ax.up.x * lo.z,
                y: origin.y + ax.forward.y * lo.x + ax.left.y * lo.y + ax.up.y * lo.z,
                z: origin.z + ax.forward.z * lo.x + ax.left.z * lo.y + ax.up.z * lo.z,
            },
            // fine for yaw-only holders (dropped weapons can tumble, but the visual follows the parent from here anyway)
            angles: { pitch: angles.pitch + this.rest_angles.pitch, yaw: angles.yaw + this.rest_angles.yaw, roll: angles.roll + this.rest_angles.roll },
        };
    }
}
for (const type of Object.keys(SANTA_ITEM_INDEX)) {
    Instance.OnScriptInput("input_connect_luffaren_" + type, (stuff) => { SantaItem.from_relay(type, stuff.caller); });
}
// ---- deadcore cannon (ze_cannon_item.vmap: point_template cannon_item_temp + cannon_temp1 / cannon2-5_temp1 projectiles) ----
// The holder charges a shot over time (one level every 12s, max 4). +USE on cannon_button fires the projectile for the
// current level, resets the charge and locks the button for 3s. Projectiles slow zombies they touch; bigger level =
// faster, longer-range projectile and a harder, longer slow. Same numbers as ze_deadcore's I/O.
const CANNON_CHARGE_TIME = 12;
const CANNON_MAX_LEVEL = 4;
const CANNON_COOLDOWN = 3;
const CANNON_SPAWN_HEIGHT = 48; // used when the button is gone and we fire from the player
// per level 0..4: projectile template, slow speed, slow time, travel time (path length / train speed, + a little)
const CANNON_SHOTS = [
    { template: "cannon_temp1", slow: 0.4, slow_time: 1, life: 500 / 150 + 1 },
    { template: "cannon2_temp1", slow: 0.3, slow_time: 2, life: 900 / 320 + 1 },
    { template: "cannon3_temp1", slow: 0.2, slow_time: 4, life: 1300 / 400 + 1 },
    { template: "cannon4_temp1", slow: 0.1, slow_time: 6, life: 1700 / 500 + 1 },
    { template: "cannon5_temp1", slow: 0.0, slow_time: 8, life: 2100 / 650 + 1 },
];
const cannon_slow_until = new Map(); // player slot -> game time the newest cannon slow ends
function cannon_slow(player, speed, time) {
    const slot = player_slot(player);
    if (slot === undefined) {
        return;
    }
    const until = Instance.GetGameTime() + time;
    if ((cannon_slow_until.get(slot) ?? 0) > until) {
        return;
    } // a stronger/longer slow is already running
    cannon_slow_until.set(slot, until);
    ent_fire_target({ target: player, input: "KeyValues", value: "speed " + speed });
    setTimeout(() => {
        if (cannon_slow_until.get(slot) == until && player?.IsValid()) {
            cannon_slow_until.delete(slot);
            ent_fire_target({ target: player, input: "KeyValues", value: "speed 1" });
        }
    }, time * 1000);
}
class CannonItem {
    wep;
    button;
    charge;
    ready;
    level_parts; // index 1..4 = level particle, 0 unused
    level = 0;
    removed = false;
    charge_interval;
    cooldown_until = 0;
    output_ids = [];
    constructor(relay_name, wep) {
        const rel = (part) => find_ent(relay_name.replace("cannon_connect", part));
        this.wep = wep;
        this.button = rel("cannon_button");
        this.charge = rel("cannon_charge");
        this.ready = rel("cannon_part_ready");
        this.level_parts = [undefined, rel("cannon_part_lv1"), rel("cannon_part_lv2"), rel("cannon_part_lv3"), rel("cannon_part_lv4")];
        this.output_ids.push(connect_output(wep, "OnPlayerPickup", () => { this.on_pickup(); }));
        if (this.button) {
            this.output_ids.push(connect_output(this.button, "OnPressed", (stuff) => { this.on_use(stuff.activator); }));
        }
    }
    /** Strip the cannon down to a plain pistol: stop charging, unhook it, kill the button + particles (the elites stay). */
    remove() {
        if (this.removed) {
            return;
        }
        this.removed = true;
        if (this.charge_interval !== undefined) {
            clearInterval(this.charge_interval);
            this.charge_interval = undefined;
        }
        for (const id of this.output_ids) {
            disconnect_output(id);
        }
        this.output_ids = [];
        for (const ent of [this.button, this.charge, this.ready, ...this.level_parts]) {
            if (ent?.IsValid()) {
                ent_fire_target({ target: ent, input: "Kill" });
            }
        }
        cannon_items = cannon_items.filter(c => c !== this);
    }
    owner() {
        const owner = this.wep.IsValid() ? this.wep.GetOwner() : undefined;
        return owner?.IsValid() ? owner : undefined;
    }
    on_pickup() {
        if (this.charge) {
            ent_fire_target({ target: this.charge, input: this.level < CANNON_MAX_LEVEL ? "Start" : "Stop" });
        }
        if (this.ready && Instance.GetGameTime() >= this.cooldown_until) {
            ent_fire_target({ target: this.ready, input: "Start" });
        }
        if (this.charge_interval === undefined) {
            this.restart_charge();
        } // keeps charging after a drop, like the original timer
    }
    restart_charge() {
        if (this.charge_interval !== undefined) {
            clearInterval(this.charge_interval);
        }
        this.charge_interval = setInterval(() => {
            if (this.removed || !this.wep.IsValid()) {
                if (this.charge_interval !== undefined) {
                    clearInterval(this.charge_interval);
                }
                this.charge_interval = undefined;
                return;
            }
            if (this.level >= CANNON_MAX_LEVEL) {
                return;
            }
            this.level++;
            const prev = this.level_parts[this.level - 1];
            if (prev) {
                ent_fire_target({ target: prev, input: "Stop" });
            }
            const part = this.level_parts[this.level];
            if (part) {
                ent_fire_target({ target: part, input: "Start" });
            }
            if (this.level >= CANNON_MAX_LEVEL && this.charge) {
                ent_fire_target({ target: this.charge, input: "Stop" });
            }
        }, CANNON_CHARGE_TIME * 1000);
    }
    on_use(user) {
        if (this.removed) {
            return;
        }
        const owner = this.owner();
        if (!owner || user != owner || !owner.IsAlive() || owner.GetTeamNumber() != 3) {
            return;
        }
        const now = Instance.GetGameTime();
        if (now < this.cooldown_until) {
            return;
        }
        this.cooldown_until = now + CANNON_COOLDOWN;
        this.fire(owner, CANNON_SHOTS[this.level]);
        // back to level 0: stop the level glow, flash the ready glow off for the cooldown, restart the charge
        this.level = 0;
        for (const part of this.level_parts) {
            if (part) {
                ent_fire_target({ target: part, input: "Stop" });
            }
        }
        if (this.ready) {
            ent_fire_target({ target: this.ready, input: "Stop" });
            ent_fire_target({ target: this.ready, input: "Start", delay: CANNON_COOLDOWN });
        }
        if (this.charge) {
            ent_fire_target({ target: this.charge, input: "Start" });
        }
        this.restart_charge();
    }
    fire(owner, shot) {
        const temp = find_ent(shot.template);
        if (!temp?.IsValid()) {
            Console.Log("CannonItem: no projectile template " + shot.template);
            return;
        }
        let origin = this.button?.IsValid() ? this.button.GetAbsOrigin() : undefined;
        if (!origin) {
            origin = owner.GetAbsOrigin();
            origin.z += CANNON_SPAWN_HEIGHT;
        }
        // flat along where the player is looking (the original used the button's angles, which spin with the gun model)
        // const angles = new Euler(0, owner.GetEyeAngles().yaw, 0);
        const angles = owner.GetEyeAngles();
        const ents = temp.ForceSpawn(origin, angles) ?? [];
        const kill_all = () => { for (const ent of ents) {
            if (ent?.IsValid()) {
                ent_fire_target({ target: ent, input: "Kill" });
            }
        } };
        for (const ent of ents) {
            if (!ent?.IsValid()) {
                continue;
            }
            const cls = ent.GetClassName();
            if (cls == "trigger_multiple") {
                // trigger already filters to zombies (filtername "zombie"); team check is a backup
                connect_output(ent, "OnStartTouch", (stuff) => {
                    const zm = stuff.activator;
                    if (zm?.IsValid() && zm.IsAlive() && zm.GetTeamNumber() == 2) {
                        cannon_slow(zm, shot.slow, shot.slow_time);
                    }
                });
            }
            else if (cls == "path_track" && ent.GetEntityName().includes("path2")) {
                connect_output(ent, "OnPass", () => { kill_all(); });
            }
        }
        setTimeout(kill_all, shot.life * 1000); // backup cleanup if the train never reaches the end
    }
}
let cannon_items = [];
/** Cannon currently held by this player, if any. */
function cannon_held_by(player) {
    const slot = player_slot(player);
    if (slot === undefined) {
        return undefined;
    }
    return cannon_items.find(c => player_slot(c.owner()) === slot);
}
Instance.OnScriptInput("input_connect_cannon", (stuff) => {
    const relay_name = stuff.caller?.GetEntityName();
    if (!relay_name) {
        return;
    }
    const wep = find_ent(relay_name.replace("cannon_connect", "cannon_elites"));
    if (!wep?.IsValid()) {
        Console.Log("input_connect_cannon: no cannon_elites for " + relay_name);
        return;
    }
    cannon_items.push(new CannonItem(relay_name, wep));
});
// ---- santassination bosses ported over: socrates + moon monster (classes, no Entity interface fields) ----
const BOSS_TICK = 0.02;
// this map only has the santassination extreme ending, so socrates uses the extreme thrust
const SOCRATES_EXTREME = true;
// moon monster: same direct physics drive as socrates (its thrusters stay in the map, unused)
const MOON_MONSTER_RANGE = 2048; // further than this = not a target (and the current target drops)
const MOON_MONSTER_DRIVE = {
    max_speed: 2000,
    accel: 4000,
    turn_step: 70, // per think (NPC_TICK 0.04 = up to 1750 deg/s, so he basically snaps on)
    forward_cone: NPC_FORWARD_ANGLE_THRESHOLD,
    turn_deadband: 2,
    tick: NPC_TICK,
};
const SOCRATES_ANGLES = { forward_threshold: 30, side_threshold: 5};
function alive_humans() {
    const humans = [];
    for (const player of find_ents_by_class("player")) {
        if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
            humans.push(player);
        }
    }
    return humans;
}
/**
 * Shared brain for thruster-driven NPCs: owns the hitbox + thrusters, picks targets and runs the think interval.
 * Targeting: every human the NPC has chased goes into `targeted_slots`; new targets come from humans not in it.
 * When every candidate has had a turn the list resets. When no human is alive at all, the NPC stops thinking.
 */
class ChaseNpc {
    hitbox;
    forward;
    side;
    target;
    target_time = 0;
    dead = false;
    targeted_slots = [];
    interval;
    constructor(hitbox, forward, side) {
        this.hitbox = hitbox;
        this.forward = forward;
        this.side = side;
        connect_output(hitbox, "OnBreak", () => { this.stop(); });
    }
    /** Start thinking every `tick` seconds. */
    start(tick) {
        if (this.interval !== undefined) {
            clearInterval(this.interval);
        }
        this.interval = setInterval(() => {
            if (this.dead || CLEAR_ALL_INTERVAL || !this.hitbox?.IsValid()) {
                this.stop();
                return;
            }
            try {
                this.think();
            }
            catch (err) {
                // name the culprit instead of the scheduler's generic message, and drop the target so the next tick re-picks
                Console.Log(this.constructor.name + " think error: " + (err instanceof Error ? err.message + "\n" + err.stack : String(err)));
                this.target = undefined;
            }
        }, tick * 1000);
    }
    stop() {
        this.dead = true;
        this.target = undefined;
        if (this.interval !== undefined) {
            clearInterval(this.interval);
            this.interval = undefined;
        }
    }
    /** Current target is still a live human and the chase timer hasn't run out. */
    target_ok() {
        const t = this.target;
        return !!t && t.IsValid() && t.IsAlive() && t.GetTeamNumber() == 3 && this.target_time > Instance.GetGameTime();
    }
    /** Extra filter for who can be picked (moon monster limits it to range). */
    can_target(_player) { return true; }
    /** Pick the next target. Returns false (and stops the NPC) when no human is alive at all. */
    pick_target() {
        this.target = undefined;
        const humans = alive_humans();
        if (humans.length == 0) {
            this.stop();
            return false;
        } // everyone's dead, nothing left to chase
        const candidates = humans.filter(p => this.can_target(p));
        if (candidates.length == 0) {
            return true;
        } // humans alive but none in reach: idle and keep looking
        let fresh = candidates.filter(p => !this.targeted_slots.includes(player_slot(p) ?? -1));
        if (fresh.length == 0) { // everyone in reach has had a turn: start over
            this.targeted_slots = [];
            fresh = candidates;
        }
        const pick = this.choose(fresh);
        const slot = player_slot(pick);
        if (slot !== undefined) {
            this.targeted_slots.push(slot);
        }
        this.target = pick;
        this.target_time = Instance.GetGameTime() + NPC_TARGET_TIME;
        return true;
    }
    /** Who to chase out of the humans that haven't had a turn yet. */
    choose(fresh) { return fresh[Math.floor(Math.random() * fresh.length)]; }
}
const NPC_TURN_SIGN = 1; // + angle = yaw goes up; flip to -1 if NPCs turn away from people
/**
 * Thruster replacement: push `body` along `forward` while the target is in the cone, clamp its horizontal speed, and
 * spin its yaw toward the target (never more than turn_step a think, and never past the target).
 * `angle` is GetDirectionToTarget's result (+ = target on the left). Returns whether it's spinning now.
 */
function drive_phys(body, forward, angle, cfg, was_spinning) {
    const v = body.GetAbsVelocity();
    let vx = v.x, vy = v.y;
    if (inRange(angle, -cfg.forward_cone, cfg.forward_cone)) {
        vx += forward.x * cfg.accel * cfg.tick;
        vy += forward.y * cfg.accel * cfg.tick;
    }
    const speed = Math.hypot(vx, vy);
    if (speed > cfg.max_speed) {
        vx *= cfg.max_speed / speed;
        vy *= cfg.max_speed / speed;
    }
    let spin = 0;
    if (Math.abs(angle) > cfg.turn_deadband) {
        spin = NPC_TURN_SIGN * Math.sign(angle) * Math.min(Math.abs(angle), cfg.turn_step) / cfg.tick;
    }
    if (vx != v.x || vy != v.y || spin != 0 || was_spinning) {
        body.Teleport({ velocity: { x: vx, y: vy, z: v.z }, angularVelocity: { x: 0, y: 0, z: spin } });
    }
    return spin != 0;
}
const NPC_HOMING = {
    // overshoot = distance covered while it spins round (180 / turn_step thinks of coasting) + braking (max_speed^2 / (2*accel))
    // turn_step is degrees per think (NPC_TICK 0.04): 20 = 500 deg/s, 180 deg turnaround in ~0.36s
    bender: { max_speed: 670, accel: 900, forward_cone: 35, grip: 0.8, turn_step: 30 }, // ~160u coast + ~250u brake
    beaver: { max_speed: 620, accel: 900, forward_cone: 20, grip: 0.8, turn_step: 20 }, // ~220u coast + ~215u brake
    elf: { max_speed: 295, accel: 450, forward_cone: 20, grip: 0.8, turn_step: 20 }, // ~105u coast + ~95u brake
    present: { max_speed: 200, accel: 300, forward_cone: 20, grip: 0.8, turn_step: 20 }, // ~70u coast + ~65u brake
};
const NPC_HOMING_DRAG = 0.5; // 1/s: how fast our remembered forward speed fades when not thrusting (the body's linear damping)
/**
 * One think of the missile drive (see above). `angle` handling matches drive_phys: + = target on the left.
 * Vertical velocity is left to gravity. Returns whether it's spinning now.
 */
function drive_homing(body, target_pos, cfg, tick, state) {
    const o = body.GetAbsOrigin();
    const v = body.GetAbsVelocity();
    const a = body.GetAbsAngles();
    const yaw = state.yaw ?? a.yaw;
    const forward = getForwardVector({ pitch: 0, yaw});
    const fx = forward.x, fy = forward.y; // flattened facing
    const rx = fy, ry = -fx; // its sideways axis
    const angle = GetDirectionToTarget({ x: o.x, y: o.y, z: target_pos.z }, target_pos, forward);
    // turn: same formula as drive_phys (asks for the whole remaining turn each think, capped at turn_step)
    const step = Math.abs(angle) < 1 ? 0 : NPC_TURN_SIGN * Math.sign(angle) * Math.min(Math.abs(angle), cfg.turn_step);
    const spin = step / tick;
    // velocity in the npc's own frame, from what WE had last think (friction can't eat the momentum)
    let vf = state.vx * fx + state.vy * fy;
    let vs = state.vx * rx + state.vy * ry;
    if (Math.abs(angle) <= cfg.forward_cone) {
        vf += cfg.accel * tick;
    } // thrust along its nose only
    else {
        vf *= Math.max(0, 1 - NPC_HOMING_DRAG * tick);
    } // coasting while it turns
    vs *= Math.max(0, 1 - cfg.grip * tick); // sideways slides off slowly
    const speed = Math.hypot(vf, vs);
    if (speed > cfg.max_speed) {
        vf *= cfg.max_speed / speed;
        vs *= cfg.max_speed / speed;
    }
    state.vx = fx * vf + rx * vs;
    state.vy = fy * vf + ry * vs;
    state.yaw = yaw + step;
    body.Teleport({
        angles: { pitch: 0, yaw: state.yaw, roll: 0 }, // always upright: copying its own pitch/roll kept it flipped once it tipped
        velocity: { x: state.vx, y: state.vy, z: v.z },
        angularVelocity: { x: 0, y: 0, z: spin },
    });
    return spin != 0;
}
/** Line of sight from `from` to the player's head within `range`, ignoring `ignore` (the npc's own ents). */
function npc_sees(from, player, range, ignore) {
    const head = player_head(player);
    if (Vector3Utils.distance(from, head) >= range) {
        return false;
    }
    const skip = ignore;
    const trace = Instance.TraceLine({ start: from, end: head, ignoreEntity: skip });
    return trace.didHit && Vector3Utils.distance(trace.end, head) < NPC_TRACE_APPROX;
}
class HomingNpc extends ChaseNpc {
    body; // npc_phys2g*: the physics prop the thrusters used to push (hitbox follows it)
    model_ents; // npc_model*: FireUser2 = start running
    ent_ents; // npc_ents*: FireUser1 = new target sound
    drive;
    own_ents; // hitbox, body and models: sight traces pass through these
    awake = false;
    spinning = false;
    motion = { yaw: undefined, vx: 0, vy: 0 }; // the drive's own heading + velocity
    constructor(hitbox, body, forward, side, model_ents, ent_ents, drive) {
        super(hitbox, forward, side);
        this.body = body;
        this.model_ents = model_ents;
        this.ent_ents = ent_ents;
        this.drive = drive;
        this.own_ents = [hitbox, body, ...find_ents_by_name(model_ents)]
            .filter((e) => !!e?.IsValid());
        // the map's thrusters stay in the map but must never push on top of us
        for (const thruster of [forward, side]) {
            if (thruster) {
                ent_fire_target({ target: thruster, input: "Deactivate" });
            }
        }
        if (!body?.IsValid()) {
            Console.Log("HomingNpc: no body for " + hitbox.GetEntityName() + ", it won't move");
        }
    }
    stop() {
        super.stop();
        if (this.body?.IsValid() && this.spinning) {
            this.body.Teleport({ angularVelocity: { x: 0, y: 0, z: 0 } });
        }
        this.spinning = false;
    }
    eye() { return (this.body?.IsValid() ? this.body : this.hitbox).GetAbsOrigin(); }
    /** Only humans it can see within NPC_TARGET_RANGE. */
    can_target(player) { return npc_sees(this.eye(), player, NPC_TARGET_RANGE, this.own_ents); }
    pick_target() {
        const ok = super.pick_target();
        if (this.target) {
            ent_fire_name({ name: this.ent_ents, input: "FireUser1" });
        }
        return ok;
    }
    think() {
        // asleep until a human is in sight within NPC_AGGRO_RANGE
        if (!this.awake) {
            if (alive_humans().some(p => npc_sees(this.eye(), p, NPC_AGGRO_RANGE, this.own_ents))) {
                this.awake = true;
                ent_fire_name({ name: this.model_ents, input: "FireUser2" });
            }
            return;
        }
        if (!this.target_ok()) {
            if (this.spinning && this.body?.IsValid()) {
                this.body.Teleport({ angularVelocity: { x: 0, y: 0, z: 0 } });
            }
            this.spinning = false;
            this.motion = { yaw: undefined, vx: 0, vy: 0 }; // it stops on the floor while idle; start the next chase fresh
            this.pick_target();
            return;
        }
        const body = this.body;
        if (!body?.IsValid()) {
            return;
        }
        body.GetAbsAngles().yaw;
        this.spinning = drive_homing(body, player_head(this.target), this.drive, NPC_TICK, this.motion);
    }
    // ---- NPC_HOMING_DEBUG: twice a second, what the drive asked for vs what the body is actually doing ----
    debug_next = 0;
    debug_log(yaw_before) {
        const now = Instance.GetGameTime();
        if (now < this.debug_next) {
            return;
        }
        this.debug_next = now + 0.5;
        const body = this.body;
        const target = this.target;
        const o = body.GetAbsOrigin(), t = player_head(target);
        const forward = getForwardVector({ pitch: 0, yaw: yaw_before});
        const angle = GetDirectionToTarget({ x: o.x, y: o.y, z: t.z }, t, forward);
        const asked = Math.abs(angle) < 1 ? 0 : NPC_TURN_SIGN * Math.sign(angle) * Math.min(Math.abs(angle), this.drive.turn_step) / NPC_TICK;
        const v = body.GetAbsVelocity();
        Console.Log("homing " + body.GetEntityName()
            + " | target " + (target.GetPlayerController()?.GetPlayerName() ?? "?")
            + " | yaw " + yaw_before.toFixed(1) + " angle " + angle.toFixed(1)
            + " | spin asked " + asked.toFixed(0) + " now " + body.GetAbsAngularVelocity().z.toFixed(0)
            + " | speed " + Math.hypot(v.x, v.y).toFixed(0));
    }
}
// input_connect_<npc> comes from the npc's relay; every other part shares its template name suffix
const HOMING_NPC_PARTS = [
    // [connector, drive, phys suffix (npc_phys2gg<n> hitbox / npc_phys2g<n> body), part number (thrusters, model, ents)]
    ["connect_bender", "bender", "3", "5"],
    ["connect_beaver", "beaver", "", "2"],
    ["connect_elv", "elf", "1", "3"],
    ["connect_present", "present", "2", "4"],
];
for (const [connector, kind, phys, part] of HOMING_NPC_PARTS) {
    Instance.OnScriptInput("input_" + connector, (stuff) => {
        const relay = stuff.caller;
        if (!relay?.IsValid()) {
            return;
        }
        const name = (p) => relay.GetEntityName().replace(connector, p);
        const hitbox = find_ent(name("npc_phys2gg" + phys));
        if (!hitbox?.IsValid()) {
            Console.Log(connector + ": no npc_phys2gg" + phys);
            return;
        }
        const npc = new HomingNpc(hitbox, find_ent(name("npc_phys2g" + phys)), find_ent(name("npc_t_f" + part)), find_ent(name("npc_t_s" + part)), name("npc_model" + part), name("npc_ents" + part), NPC_HOMING[kind]);
        npc.start(NPC_TICK);
    });
}
// Socrates drives his physics body directly (no thrusters): every think he gets a forward push along the way he's
// facing (only while the target is inside the forward cone, like the forward thruster) and a yaw spin toward the
// target (like the side thruster), with his horizontal speed clamped to what he topped out at in csgo.
// The body (models/luffaren/npc_phys_socrates) is 5000 mass, linear damping 0.5, angular damping 40, so the engine
// still slows him down between pushes and kills spin we stop asking for.
const SOCRATES_EX_MAX_SPEED = 1000; // u/s, measured in csgo
const SOCRATES_EX_ACCEL = 2000; // u/s^2 while the target is in the forward cone (0 -> max in ~0.5s)
const SOCRATES_EX_TURN_STEP = 7; // max degrees turned per think (BOSS_TICK), i.e. 7 / 0.02 = 350 deg/s
const SOCRATES_MAX_SPEED = SOCRATES_EX_MAX_SPEED / 2;
const SOCRATES_ACCEL = SOCRATES_EX_ACCEL / 2;
const SOCRATES_TURN_STEP = SOCRATES_EX_TURN_STEP / 2;
class Socrates extends ChaseNpc {
    helper;
    body; // bosss_phys2, the physics prop we move
    drive;
    spinning = false;
    constructor(hitbox, forward, side, helper, body, extreme) {
        super(hitbox, forward, side);
        this.helper = helper;
        this.body = body;
        this.drive = {
            max_speed: extreme ? SOCRATES_EX_MAX_SPEED : SOCRATES_MAX_SPEED,
            accel: extreme ? SOCRATES_EX_ACCEL : SOCRATES_ACCEL,
            turn_step: extreme ? SOCRATES_EX_TURN_STEP : SOCRATES_TURN_STEP,
            forward_cone: SOCRATES_ANGLES.forward_threshold,
            turn_deadband: SOCRATES_ANGLES.side_threshold, // same deadband the side thruster had
            tick: BOSS_TICK,
        };
        // the map's thrusters stay in the map but must never push on top of us
        for (const thruster of [forward, side]) {
            if (thruster) {
                ent_fire_target({ target: thruster, input: "Deactivate" });
            }
        }
        if (!body?.IsValid()) {
            Console.Log("socrates: no bosss_phys2, he won't move");
        }
    }
    stop() {
        super.stop();
        if (this.body?.IsValid() && this.spinning) {
            this.body.Teleport({ angularVelocity: { x: 0, y: 0, z: 0 } });
        }
        this.spinning = false;
    }
    think() {
        if (!this.target_ok()) {
            this.pick_target();
            return;
        }
        const body = this.body;
        if (!body?.IsValid()) {
            return;
        }
        const target = this.target;
        const facing = this.helper?.IsValid() ? this.helper : body;
        const yaw = facing.GetAbsAngles().yaw;
        const forward = getForwardVector({ pitch: 0, yaw});
        // aim from the body's pivot (hp2 sits ~256u out in front, which made him circle anyone standing close)
        const pivot = body.GetAbsOrigin();
        const target_pos = player_head(target);
        const angle = GetDirectionToTarget({ x: pivot.x, y: pivot.y, z: target_pos.z }, target_pos, forward);
        this.spinning = drive_phys(body, forward, angle, this.drive, this.spinning);
    }
}
class MoonMonster extends ChaseNpc {
    side_fix;
    // looked up once instead of 5-6 FindEntityByName calls every tick
    model;
    steptimer;
    moods;
    init; // i_mm_init relay: OnUser4 = stop thinking, we FireUser1 it on each new target
    spaz;
    growl;
    pissed;
    friendly;
    running; // undefined = no state applied yet
    spinning = false;
    init_output;
    constructor(hitbox, forward, side, side_fix) {
        super(hitbox, forward, side);
        this.side_fix = side_fix;
        const rel = (part) => find_ent(hitbox.GetEntityName().replace("i_mm_phys", part));
        this.model = rel("i_mm_model");
        this.steptimer = rel("i_mm_steptimer");
        this.moods = rel("i_mm_s_moods");
        this.init = rel("i_mm_init");
        this.spaz = rel("i_mm_s_spaz");
        this.growl = rel("i_mm_s_moods_growl");
        this.pissed = rel("i_mm_s_pissed");
        this.friendly = rel("i_mm_s_friendly");
        if (this.init) {
            this.init_output = connect_output(this.init, "OnUser4", () => { this.stop(); });
        }
        else {
            Console.Log("moon monster: no i_mm_init for " + hitbox.GetEntityName());
        }
        // the map's thrusters must never push on top of the script
        for (const thruster of [forward, side, side_fix]) {
            if (thruster) {
                ent_fire_target({ target: thruster, input: "Deactivate" });
            }
        }
    }
    stop() {
        if (this.friendly) {
            ent_fire_target({ target: this.friendly, input: "StartSound" });
        }
        super.stop();
        disconnect_output(this.init_output);
        this.init_output = undefined;
        if (this.hitbox?.IsValid() && this.spinning) {
            this.hitbox.Teleport({ angularVelocity: { x: 0, y: 0, z: 0 } });
        }
        this.spinning = false;
    }
    distance_to(player) {
        return Vector3Utils.distance(this.hitbox.GetAbsOrigin(), player_head(player));
    }
    can_target(player) {
        return this.distance_to(player) < MOON_MONSTER_RANGE;
    }
    /** Ran off past MOON_MONSTER_RANGE = no longer the target (think() then retargets the closest one, or idles). */
    target_ok() {
        return super.target_ok() && this.distance_to(this.target) < MOON_MONSTER_RANGE;
    }
    /** Closest in-range human that hasn't had a turn yet. */
    choose(fresh) {
        return fresh.reduce((best, p) => this.distance_to(p) < this.distance_to(best) ? p : best);
    }
    /** Idle (no one in range) or run (chasing). Only fires when the state actually changes. */
    set_running(run) {
        if (this.running === run) {
            return;
        }
        this.running = run;
        const anim = run ? "run" : "idle";
        if (this.model) {
            ent_fire_target({ target: this.model, input: "SetAnimationLooping", value: anim });
            ent_fire_target({ target: this.model, input: "SetIdleAnimationLooping", value: anim });
            ent_fire_target({ target: this.model, input: "Skin", value: run ? "2" : "1" });
        }
        if (this.steptimer) {
            ent_fire_target({ target: this.steptimer, input: run ? "Enable" : "Disable" });
        }
        const mood = run ? this.pissed : this.growl;
        if (mood) {
            ent_fire_target({ target: mood, input: "StartSound" });
        }
    }
    think() {
        if (!this.target_ok()) {
            // lost the target: stop the turn we were asking for (he coasts to a stop on his own damping)
            if (this.spinning && this.hitbox.IsValid()) {
                this.hitbox.Teleport({ angularVelocity: { x: 0, y: 0, z: 0 } });
            }
            this.spinning = false;
            if (!this.pick_target()) {
                if (this.friendly) {
                    ent_fire_target({ target: this.friendly, input: "StartSound" });
                }
                return; // stopped: nobody alive
            }
            this.set_running(!!this.target);
            if (this.target && this.spaz?.IsValid()) {
                ent_fire_target({ target: this.spaz, input: "StartSound", activator: this.target });
            }
            return;
        }
        const target = this.target;
        const forward = getForwardVector({ pitch: 0, yaw: this.hitbox.GetAbsAngles().yaw});
        const pivot = this.hitbox.GetAbsOrigin();
        const target_pos = player_head(target);
        const angle = GetDirectionToTarget({ x: pivot.x, y: pivot.y, z: target_pos.z }, target_pos, forward);
        this.spinning = drive_phys(this.hitbox, forward, angle, MOON_MONSTER_DRIVE, this.spinning);
    }
}
let SOCRATES_FIGHT = false;
Instance.OnScriptInput("input_connect_socrates", () => {
    SOCRATES_FIGHT = true;
    const hitbox = find_ent("bosss_hp2");
    if (!hitbox?.IsValid()) {
        Console.Log("input_connect_socrates: no bosss_hp2");
        return;
    }
    new Socrates(hitbox, find_ent("bosss_t_f2"), find_ent("bosss_t_s2"), find_ent("bosss_helper2"), find_ent("bosss_phys2"), SOCRATES_EXTREME).start(BOSS_TICK);
});
Instance.OnScriptInput("input_connect_moon_monster", (stuff) => {
    const relay_name = stuff.caller?.GetEntityName();
    if (!relay_name) {
        return;
    }
    const rel = (part) => find_ent(relay_name.replace("connect_moon_monster", part));
    const hitbox = rel("i_mm_phys");
    if (!hitbox?.IsValid()) {
        Console.Log("input_connect_moon_monster: no i_mm_phys for " + relay_name);
        return;
    }
    new MoonMonster(hitbox, rel("i_mm_t_f"), rel("i_mm_t_s"), rel("i_mm_t_s_fix")).start(NPC_TICK);
});
function the_truth() {
    if (TRUTH_MATH == 3) {
        santassination_ending();
        ent_fire_name({ name: "ct_win_fakeout", input: "StartSound" });
        ent_fire_name({ name: "skybox_swapper_t_timer", input: "FireUser1" });
        ent_fire_name({ name: "truth_hugeface_mover1", input: "Open" });
        ent_fire_name({ name: "truth_hugeface_mover2", input: "Open" });
        ent_fire_name({ name: "truth_hugeface2", input: "Enable" });
        ent_fire_name({ name: "truth_hugeface3", input: "Enable" });
        ent_fire_name({ name: "truth_hugeface4", input: "Enable" });
        randomize_abyssal_steps();
        ent_fire_name({ name: "nuke_hurt", input: "Enable" });
        ent_fire_name({ name: "nuke_hurt", input: "Disable", delay: ONE_TICK });
        ent_fire_name({ name: "LevelLayer_Truth", input: "ShowWorldLayer" });
        ent_fire_name({ name: "etruth_benderspawn_a3t", input: "Forcespawn" });
        const ct_dest = find_ent("truth_ct_tp_dest");
        FunctionDelay(() => {
            if (ARTORISAS) {
                ent_fire_name({ name: "truth_no_bitches", input: "Kill" });
                ent_fire_name({ name: "fog_truth", input: "SetFogEndDistance", value: 4096 });
                ent_fire_name({ name: "fog_truth", input: "SetFarZ", value: 4096, delay: 10 });
            }
            else {
                const ent = find_ent("truth_no_bitches");
                if (!ent?.IsValid()) {
                    return;
                }
                connect_output(ent, "OnStartTouch", (stuff) => {
                    const player = stuff.activator;
                    if (player?.GetTeamNumber() == 3 && player.IsAlive()) {
                        ent_fire_target({ target: player, input: "SetHealth", value: 0 });
                    }
                });
            }
            for (const player of find_ents_by_class("player")) {
                if (player?.GetTeamNumber() == 3) {
                    if (ct_dest?.IsValid()) {
                        player.Teleport({ position: ct_dest.GetAbsOrigin(), angles: ct_dest.GetAbsAngles() });
                    }
                }
            }
        }, ENDING_TOTAL);
    }
    else {
        ent_fire_name({ name: "input_zr_toggle_respawn", input: "FireUser2" });
        ent_fire_name({ name: "nuke_hurt", input: "Enable" });
    }
}
Instance.OnScriptInput("input_hide_truth_huds", () => {
    hide_truth_huds();
    ent_fire_name({ name: "command", input: "Command", value: "say ***YOU HAVE SUCCESSFULLY TRAVERSED YE OLE ABYSS...***" });
    ent_fire_name({ name: "fog_truth", input: "SetFogEndDistance", value: 1024 });
    ent_fire_name({ name: "fog_truth", input: "SetFarZ", value: 1024, delay: 10 });
});
let TRUTH_MATH = 0;
Instance.OnScriptInput("input_truth_math_add", () => {
    TRUTH_MATH++;
    new AnySFX("xmas.sfx.stinger_gow_long");
    update_truth_huds();
});
let ARTORIAS_ONCE = false;
let ARTORISAS = false;
Instance.OnScriptInput("input_artorias_ring", (stuff) => {
    if (!ARTORIAS_ONCE) {
        ent_fire_name({ name: "command", input: "Command", value: "say This ring symbolizes Knight Artorias's covenant with the beasts of the Abyss.", delay: 0 });
        ent_fire_name({ name: "command", input: "Command", value: "say It's wearer, like Artorias himself, can traverse the Abyss.", delay: 2 });
        new AnySFX("xmas.sfx.stinger_gow_long");
        ARTORIAS_ONCE = true;
    }
    const wep = stuff.caller;
    if (!wep?.IsValid()) {
        return;
    }
    const player = wep.GetOwner();
    ARTORISAS = true;
    update_truth_huds();
    // one watcher at a time: a re-pickup replaces the old one instead of stacking intervals
    if (artorias_interval !== undefined) {
        clearInterval(artorias_interval);
    }
    artorias_interval = setInterval(() => {
        // the ring can be deleted out from under us (owner dies / gets infected and the weapon is stripped),
        // so check IsValid before touching it: calling GetOwner on a dead entity is what threw every tick
        const wep_ok = wep.IsValid();
        const owner = wep_ok ? wep.GetOwner() : undefined;
        const held = !!owner?.IsValid() && owner.IsAlive() && owner.GetTeamNumber() == 3;
        if (held && !CLEAR_ALL_INTERVAL) {
            return;
        }
        if (artorias_interval !== undefined) {
            clearInterval(artorias_interval);
            artorias_interval = undefined;
        }
        if (player?.IsValid()) {
            ent_fire_target({ target: player, input: "SetDamageFilter", value: "" });
        }
        if (wep_ok && !CLEAR_ALL_INTERVAL) {
            ent_fire_target({ target: wep, input: "ToggleCanBePickedUp" });
            ent_fire_target({ target: wep, input: "ToggleCanBePickedUp", delay: 1 });
        }
        ARTORISAS = false;
        update_truth_huds();
    }, REBIRTH_TICK);
});
let artorias_interval;
Instance.OnScriptInput("input_check_truth", (stuff) => {
    the_truth();
});
Instance.OnScriptInput("input_rocket_explosion", (stuff) => {
    for (const player of find_ents_by_class("player")) {
        if (player?.GetTeamNumber() == 2 && player.IsAlive()) {
            ent_fire_target({ target: player, input: "IgniteLifetime", value: 3 });
            ent_fire_target({ target: player, input: "KeyValues", value: "speed 0.5" });
            ent_fire_target({ target: player, input: "KeyValues", value: "speed 1", delay: 3 });
            ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.125", delay: 3 });
        }
    }
});
Instance.OnScriptInput("input_ragdoll_death", (stuff) => {
    const ent = stuff.activator;
    if (ent?.IsValid() && ent.GetEntityName().includes("raggy_mako_pit")) {
        const temp = find_ent("temp_death_sfx");
        if (temp?.IsValid()) {
            temp.ForceSpawn(ent.GetAbsOrigin());
        }
    }
});
Instance.OnScriptInput("input_reset_ex2_rewards", (stuff) => {
    const player = stuff.activator;
    if (player?.GetTeamNumber() != 3) {
        return;
    }
    ex2_rewards(player);
});
const EX2_REWARDS_HP = 30000;
function ex2_rewards(player) {
    if (player?.GetMaxHealth() < EX2_REWARDS_HP) {
        player.SetMaxHealth(EX2_REWARDS_HP);
        player.SetHealth(EX2_REWARDS_HP);
    }
    ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.3" });
}
Instance.OnScriptInput("input_give_kelvar", (stuff) => {
    const player = stuff.activator;
    if (player?.GetTeamNumber() == 3) {
        player.GiveNamedItem("item_kevlar");
    }
});
// ================================================================ DDR map modifier
// Everyone alive plays PARANOiA Revolution on hud_ddr (custom_hud_layout -> panorama/layout/custom_game/hud_ddr.xml).
// Life hits 0 = killed. Music: point_soundevent "ddr_music". Driven every tick from the map think (WasInputJustPressed
// only sees the current tick). Ported from ddr.js (chat commands / join list / offsets dropped).
const DDR_HUD_NAME = "hud_ddr";
const DDR_HUD_PANEL = "DDR"; // panel that takes Show / banner classes and holds the dialog variables
const DDR_MUSIC_ENT = "ddr_music";
const DDR_SONG_TITLE = "PARANOiA Revolution";
const DDR_START_DELAY = 15; // seconds after the modifier rolls before the song starts
// No mother zombies on DDR: cs2fixes won't pick any while there are fewer players than this (reset at round end).
// (mz_ratio 0 doesn't do it: zr_infect_spawn_mz_min_count still forces one)
const DDR_NO_MZ_MIN_COUNT = 999;
const DDR_MZ_MIN_COUNT_DEFAULT = 2; // zr_infect_min_count_req from cs2fixes.cfg
// Seconds from spawn until a note reaches the receptor. MUST match hud_ddr.css (.Note.Fly).
const DDR_NOTE_REACH_TIME = 0.65;
const DDR_NOTE_FLY_TIME = 0.7651; // full .Note.Fly transition (keeps scrolling past the receptor)
const DDR_POOL = 12; // note panels per lane in the layout
const DDR_AUDIO_LEAD = 0.0; // + = every note later vs. the music
const DDR_JUDGE_LATENCY = 0.06; // server sees a press ~ping+interp after it happened
const DDR_FAIL_HUD_TIME = 3; // FAILED banner stays this long before the hud hides
const DDR_WIN = { perfect: 0.045, great: 0.090, good: 0.135, boo: 0.180 };
const DDR_LIFE = { start: 60, perfect: 2, great: 1, good: 0, boo: -2, miss: -5, ng: -4 };
const DDR_SCORE = { perfect: 1000, great: 500, good: 100, boo: 0, miss: 0 };
const DDR_HOLD_GRACE = 0.20; // how long you may let go of a freeze before it counts as NG
