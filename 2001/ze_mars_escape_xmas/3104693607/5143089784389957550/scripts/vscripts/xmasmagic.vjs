const REBIRTH_TICK = 100;
Instance.OnScriptInput("input_rebirth_check", (stuff) => {
    REBIRTH_COUNTER++;
    if (!REBIRTH_STOP_INTERVAL) {
        update_rebirth_items_hud();
    }
    if (REBIRTH_COUNTER == 4) {
        if (MODE == "Truth") {
            ent_fire_name({ name: "mako_relay", input: "Disable" });
            ent_fire_name({ name: "ending_gris_truth", input: "Enable" });
            ent_fire_name({ name: "ending_gris", input: "Disable" });
            ent_fire_name({ name: "ending_classic", input: "Disable" });
        }
        else {
            ent_fire_name({ name: "ending_classic", input: "Disable" });
            ent_fire_name({ name: "ending_gris", input: "Enable" });
        }
    }
    const wep = stuff.caller;
    const player = wep.GetOwner();
    if (player?.IsValid() && !REBIRTH_STOP_INTERVAL) {
        ent_fire_target({ target: player, input: "SetDamageFilter", value: "FilterNoPlayerAllowed" });
    }
    const interval = setInterval(() => {
        if (REBIRTH_STOP_INTERVAL) {
            ent_fire_target({ target: player, input: "SetDamageFilter", value: "" });
            clearInterval(interval);
            return;
        }
        if (wep.GetOwner() == undefined) {
            ent_fire_target({ target: wep, input: "ToggleCanBePickedUp" });
            ent_fire_target({ target: player, input: "SetDamageFilter", value: "" });
            ent_fire_target({ target: wep, input: "ToggleCanBePickedUp", delay: 1 });
            REBIRTH_COUNTER--;
            update_rebirth_items_hud();
            if (REBIRTH_COUNTER != 4) {
                if (MODE == "Truth") {
                    ent_fire_name({ name: "mako_relay", input: "Enable" });
                    ent_fire_name({ name: "ending_gris_truth", input: "Disable" });
                    ent_fire_name({ name: "ending_gris", input: "Disable" });
                    ent_fire_name({ name: "ending_classic", input: "Disable" });
                }
                else {
                    ent_fire_name({ name: "ending_classic", input: "Enable" });
                    ent_fire_name({ name: "ending_gris", input: "Disable" });
                }
            }
            clearInterval(interval);
        }
    }, REBIRTH_TICK);
});
function spawn_rebirth_triggers() {
    const crimson_ceremony = find_ents_by_name("spawn_crimson_ceremony");
    const lost_memories = find_ents_by_name("spawn_lost_memories");
    const obsidian_goblet = find_ents_by_name("spawn_obsidian_goblet");
    const white_chrism = find_ents_by_name("spawn_white_chrism");
    const temp_crimson_ceremony = find_ent("temp_crimson_ceremony");
    const temp_lost_memories = find_ent("temp_lost_memories");
    const temp_obsidian_goblet = find_ent("temp_obsidian_goblet");
    const temp_white_chrism = find_ent("temp_white_chrism");
    const epsteins = find_ents_by_name("maker_epstein");
    EPSTEIN_COUNTER = epsteins.length;
    const cc_ents = temp_crimson_ceremony.ForceSpawn(crimson_ceremony[randomIntArray(0, crimson_ceremony.length)].GetAbsOrigin());
    const lm_ents = temp_lost_memories.ForceSpawn(lost_memories[randomIntArray(0, lost_memories.length)].GetAbsOrigin());
    const og_ents = temp_obsidian_goblet.ForceSpawn(obsidian_goblet[randomIntArray(0, obsidian_goblet.length)].GetAbsOrigin());
    const wc_ents = temp_white_chrism.ForceSpawn(white_chrism[randomIntArray(0, white_chrism.length)].GetAbsOrigin());
    rebirth_ents(cc_ents);
    rebirth_ents(lm_ents);
    rebirth_ents(og_ents);
    rebirth_ents(wc_ents);
    setTimeout(() => {
        const weapons = find_ents_by_class("weapon_glock");
        for (const wep of weapons) {
            if (wep.GetEntityName().includes("crimson_ceremony")) {
                wep.rebirth_wep = true;
            }
            else if (wep.GetEntityName().includes("lost_memories")) {
                wep.rebirth_wep = true;
            }
            else if (wep.GetEntityName().includes("obsidian_goblet")) {
                wep.rebirth_wep = true;
            }
            else if (wep.GetEntityName().includes("white_chrism")) {
                wep.rebirth_wep = true;
            }
        }
    }, 1000);
}
function rebirth_ents(ents) {
    let wep;
    let prop;
    let measure;
    for (const ent of ents) {
        if (ent.GetClassName() == "weapon_glock") {
            wep = ent;
        }
        else if (ent.GetClassName().includes("prop")) {
            prop = ent;
        }
    }
    if (prop?.IsValid() && wep?.IsValid()) {
        prop.rebirth_wep_ent = wep;
        prop.rebirth_measure_ent = measure;
    }
}
