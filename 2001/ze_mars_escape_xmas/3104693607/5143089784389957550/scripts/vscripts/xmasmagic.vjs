            this.apply_aim(player);
        }
        if (!this.wep?.IsValid()) {
            return;
        }
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
        if (this.drop_interval !== undefined) {
            clearInterval(this.drop_interval);
        }
        this.drop_interval = setInterval(() => {
            if (this.holder() && this.wep?.IsValid() && !CLEAR_ALL_INTERVAL) {
                return;
            }
            if (this.drop_interval !== undefined) {
                clearInterval(this.drop_interval);
                this.drop_interval = undefined;
            }
            if (this.aim && this.align?.IsValid()) {
                ent_fire_target({ target: this.aim, input: "SetMeasureTarget", value: this.align.GetEntityName() });
            }
