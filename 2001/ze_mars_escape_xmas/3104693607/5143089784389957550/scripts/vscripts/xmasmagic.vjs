});
let EX2_EARTH_TROLLING = false;
let KNIFE_PARTY = false;
// ---- credited kills (from trick_or_treat): real damage dealt by the zombie, so the kill feed/scoreboard show who killed the human ----
const ONE_TICK = 1 / 64;
const PENDING_CREDITED_KILLS = new Set();
/** Kill the human with damage credited to the zombie (no infection). */
function kill_credited(victim, attacker) {
    if (!victim?.IsValid() || !victim.IsAlive() || victim.GetTeamNumber() != 3)
        return;
    const slot = victim.GetPlayerController()?.GetPlayerSlot();
    if (slot === undefined)
        return;
    PENDING_CREDITED_KILLS.add(slot);
    victim.TakeDamage({
        damage: victim.GetHealth() + 100,
        attacker: attacker?.IsValid() ? attacker : undefined,
        inflictor: attacker?.IsValid() ? attacker : undefined,
        damageTypes: CSDamageTypes.BLAST,
    });
}
const BOOMSTICK_DMG_BUFF = 20;
Instance.OnModifyPlayerDamage((stuff) => {
    // our own credited kill: let it through untouched
    const pending_slot = stuff.player?.GetPlayerController()?.GetPlayerSlot();
    if (pending_slot !== undefined && PENDING_CREDITED_KILLS.delete(pending_slot))
        return;
    let player = stuff.player;
    let attacker = stuff.attacker;
    let inflictor = stuff.inflictor;
    // snowball fight: a snowball a zombie parried back hits a human
    const reflected = SNOWBALL_NADES ? reflected_snowball_for(inflictor) : undefined;
    if (reflected) {
        if (reflected.hit || !player?.IsValid() || !player.IsAlive() || player.GetTeamNumber() != 3) {
            return { damage: 0, abort: true };
        }
        reflected_snowball_hit(reflected, player);
        return { damage: SNOWBALL_DMG };
    }
    if (inflictor?.GetClassName() == "prop_physics" || inflictor?.GetClassName() == "prop_physics_override") {
        let damage = 0;
        return { damage };
    }
    if (attacker?.IsValid() && player?.IsValid() && attacker.GetTeamNumber() == 2 && player.GetTeamNumber() == 3 && player.vip) {
        ent_fire_target({ target: player, input: "sethealth", value: 0 });
    }
    if (attacker?.IsValid() && player?.IsValid() && attacker.GetTeamNumber() == 2 && player.GetTeamNumber() == 3) {
        setTimeout(() => {
            if (player?.IsValid() && player.GetTeamNumber() == 2 && ENABLE_MODELS) {
                set_player_model(player, zm_model_for(player));
            }
        }, 100);
    }
    if (attacker?.IsValid() && player?.IsValid() && player.effect_immortal) ;
    // knife party + snowball fight: zombie hits human = no infection, the human just dies and the kill feed credits the zombie
    if (KNIFE_PARTY || SNOWBALL_NADES) {
        if (attacker?.IsValid() && player?.IsValid() && attacker.GetTeamNumber() == 2 && player.GetTeamNumber() == 3) {
            if (player.IsAlive()) {
                setTimeout(() => { kill_credited(player, attacker); }, ONE_TICK * 1000);
            }
            return { damage: 0, abort: true };
        }
    }
    if (KNIFE_PARTY) {
        if (attacker?.IsValid() && player?.IsValid() && attacker.GetTeamNumber() == 3 && player.GetTeamNumber() == 2) {
            return { damage: 99999999 };
        }
    }
    // humans take damage (and get infected) as normal; zombies only take ssg08 headshots
    if (WET_ANUS && player?.IsValid() && player.GetTeamNumber() == 2) {
        if (attacker?.IsValid() && attacker.GetTeamNumber() == 3 && stuff.weapon?.GetData().GetName() == "weapon_ssg08" && stuff.hitGroup == CSHitGroup.HEAD) {
            return { damage: WET_ANUS_HP };
        }
        else {
            return { damage: 0, abort: true };
        }
    }
    if (BOOMSTICKS) {
        if (attacker?.IsValid() && attacker.GetTeamNumber() == 3 && stuff.weapon?.GetData().GetName() == "weapon_sawedoff") {
            return { damage: stuff.damage * BOOMSTICK_DMG_BUFF };
        }
    }
    if (SNOWBALL_NADES) {
        if (attacker?.IsValid() && attacker.GetTeamNumber() == 3 && stuff.inflictor?.GetClassName() == "hegrenade_projectile") {
            return { damage: SNOWBALL_DMG * 2 };
        }
    }
});
const SNOWBALL_DMG = 25;
const MM_TICK = .5;
function knife_party() {
    const taxmen = find_ents_by_name("taxman");
    const interval = setInterval(() => {
        if (CLEAR_ALL_INTERVAL) {
            clearInterval(interval);
            return;
        }
        else {
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 2) {
                    const c4 = player.FindWeaponBySlot(4);
                    const knife = player.FindWeaponBySlot(2);
                    if (knife != undefined) {
                        player.SwitchToWeapon(knife);
                    }
                    if (c4 != undefined) {
                        player.DestroyWeapon(c4);
                    }
                }
                else if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    for (const taxman of taxmen) {
                        ent_fire_target({ target: taxman, input: "SpendMoneyFromPlayer", activator: player });
                    }
                    const knife = player.FindWeaponBySlot(2);
                    if (knife != undefined) {
                        player.SwitchToWeapon(knife);
                    }
                    for (let i = 0; i < 5; i++) {
                        const wep = player.FindWeaponBySlot(i);
                        if (i != 2 && wep != undefined && !wep.rebirth_wep) {
                            player.DestroyWeapon(wep);
                        }
                        if (i == 1 && wep != undefined && wep.rebirth_wep) {
                            wep.SetReserveAmmo(0);
                            wep.SetClipAmmo(0);
                        }
                    }
                }
            }
        }
    }, MM_TICK * 1000);
}
function boomsticks() {
    const taxmen = find_ents_by_name("taxman");
    const interval = setInterval(() => {
        if (CLEAR_ALL_INTERVAL) {
            clearInterval(interval);
            return;
        }
        else {
            const weapons = find_ents_by_class("weapon_sawedoff");
            for (const weapon of weapons) {
                if (weapon.GetOwner() == undefined) {
                    weapon.Remove();
                }
            }
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 2) {
                    const c4 = player.FindWeaponBySlot(4);
                    const knife = player.FindWeaponBySlot(2);
                    if (knife != undefined) {
                        player.SwitchToWeapon(knife);
                    }
                    if (c4 != undefined) {
                        player.DestroyWeapon(c4);
                    }
                }
                else if (player?.IsValid() && player.GetTeamNumber() == 3) {
                    for (const taxman of taxmen) {
                        ent_fire_target({ target: taxman, input: "SpendMoneyFromPlayer", activator: player });
                    }
                    for (let i = 0; i < 5; i++) {
                        const wep = player.FindWeaponBySlot(i);
                        if (wep?.IsValid()) {
                            const wep_data = wep.GetData();
                            if (i == 0 && wep_data.GetName() != "weapon_sawedoff") {
                                player.DestroyWeapon(wep);
                                player.GiveNamedItem("weapon_sawedoff");
                            }
                            else if (i != 2 && wep_data.GetName() != "weapon_sawedoff" && !wep.rebirth_wep) {
                                player.DestroyWeapon(wep);
                            }
                            if (i == 1 && wep != undefined && wep.rebirth_wep) {
                                wep.SetReserveAmmo(0);
                                wep.SetClipAmmo(0);
                            }
                        }
                        else if (i == 0 && wep == undefined) {
                            player.GiveNamedItem("weapon_sawedoff");
                        }
                    }
                }
            }
        }
    }, MM_TICK * 1000);
}
