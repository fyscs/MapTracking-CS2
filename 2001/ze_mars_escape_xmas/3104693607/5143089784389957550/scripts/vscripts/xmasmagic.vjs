// ---- ultima drop: replaces the hmm_ultima logic_case (1 in 6 PickRandomShuffle) ----
const ULTIMA_TEMPLATE = "Item_Ultima_Template";
const ULTIMA_SPAWNS = ["Item_SpawnOrigin_Ultima1", "Item_SpawnOrigin_Ultima2"];
const ULTIMA_CHANCE = 6; // 1 in N; truth mode always spawns it
function spawn_ultima(origin, angles) {
    const temp = find_ent(ULTIMA_TEMPLATE);
    if (!temp?.IsValid()) {
        Console.Log("spawn_ultima: no " + ULTIMA_TEMPLATE);
        return false;
    }
    temp.ForceSpawn(origin, angles);
    return true;
}
function HmmUltima() {
    if (MODE != "Truth" && randomIntArray(0, ULTIMA_CHANCE) != 0) {
        return;
    }
    const spot = find_ent(ULTIMA_SPAWNS[randomIntArray(0, ULTIMA_SPAWNS.length)]);
    if (!spot?.IsValid()) {
        Console.Log("HmmUltima: missing ultima spawn origin");
        return;
    }
    spawn_ultima(spot.GetAbsOrigin(), spot.GetAbsAngles());
}
// modifiers a level can never roll (they stay in the bag for the next level that can)
const LEVEL_BANNED_MODES = {
    4: ["Truth"], // rebirth
};
// first round after the map loads is always mars + Classic (debug overrides still win)
let FIRST_ROUND = true; // cleared by the first level pick
let FIRST_ROUND_CLASSIC = false; // set by the level pick for this round only
const FIRST_ROUND_MODE = "Classic";
function map_modifier() {
    if (FIRST_ROUND_CLASSIC && MODES.includes(FIRST_ROUND_MODE)) {
        MODES.splice(MODES.indexOf(FIRST_ROUND_MODE), 1);
        MODE = FIRST_ROUND_MODE;
        map_modifier_apply();
        return;
    }
    const banned = LEVEL_BANNED_MODES[LEVEL] ?? [];
    const allowed = () => MODES.map((_, i) => i).filter(i => !banned.includes(MODES[i]));
    let choices = allowed();
    if (choices.length == 0) {
        MODES = MODES_RESET.slice();
        choices = allowed();
    }
    const index = choices[randomIntArray(0, choices.length)];
    MODE = MODES[index];
    MODES.splice(index, 1);
    map_modifier_apply();
}
/** Set up whatever MODE is (debug override first). */
function map_modifier_apply() {
    set_modifier_hud(MODE);
    ent_fire_name({ name: "command", input: "Command", value: "say Merry Xmas! This is mars escape, jolly, but also on meth. Map modifier: " + MODE, delay: 12 });
    if (MODE == "Classic") {
        xmas_presents_default();
        ent_fire_name({ name: "fade", input: "fade" });
        ent_fire_name({ name: "ending_classic", input: "Enable" });
        HmmUltima();
    }
    else if (MODE == "Materia Madness") {
        xmas_presents_materia_madness();
        MATERIA_LEVEL = 3;
        ent_fire_name({ name: "fade", input: "Fade" });
        ent_fire_name({ name: "ending_classic", input: "Enable" });
        ent_fire_name({ name: "command", input: "Command", value: "say *** MATERIAS AT LVL 3 ***", delay: 10 });
        ent_fire_name({ name: "command", input: "Command", value: "say *** Toggle item aiming with !aim (default is disabled) ***", delay: 13 });
    }
    else if (MODE == "Knife Party") {
        Console.ServerCommand("cs2f_infinite_reserve_ammo 0");
        xmas_presents_default();
        KNIFE_PARTY = true;
        ent_fire_name({ name: "fade", input: "Fade" });
        ent_fire_name({ name: "ending_classic", input: "Enable" });
        HmmUltima();
        ent_fire_name({ name: "xmas_surprise_npc_disable", input: "Trigger" });
        ent_fire_name({ name: "vent_1hp", input: "Trigger" });
        ent_fire_name({ name: "command", input: "Command", value: "say HO HO HO - naughty boys can only defend themselves with their knives..." });
        knife_party();
    }
    else if (MODE == "Truth") {
        xmas_presents_truth();
        show_truth_huds();
        ent_fire_name({ name: "fade_ex", input: "fade" });
        ent_fire_name({ name: "santa_spawn_maker", input: "ForceSpawn" });
        ent_fire_name({ name: "ending_truth", input: "Enable" });
        ent_fire_name({ name: "truth_music_relay", input: "Enable" });
        HmmUltima();
        ent_fire_name({ name: "truth_heal", input: "Trigger" });
        ent_fire_name({ name: "sfx_extreme", input: "StartSound", delay: 0.05 });
        ent_fire_name({ name: "sfx_extreme_alt", input: "StartSound", delay: 1.00 });
        ent_fire_name({ name: "sky_black", input: "FireUser1", delay: 1.40 });
        ent_fire_name({ name: "fog_truth", input: "FireUser1", delay: 1.40 });
        set_music_pitch(0.5);
        ent_fire_name({ name: "command", input: "Command", value: "say You are starting to feel uneasy about Christmas this year...", delay: 10 });
        ent_fire_name({ name: "command", input: "Command", value: "say Maybe you shouldn't open your presents...", delay: 13 });
        ent_fire_name({ name: "truth_trigs", input: "ForceSpawn" });
        const temp = find_ent("temp_artorias_ring");
        const dest = find_ent("spawn_artorias_ring");
        if (temp?.IsValid() && dest?.IsValid()) {
            temp.ForceSpawn(dest.GetAbsOrigin());
        }
    }
    else if (MODE == "Laser Slop") {
        xmas_presents_default();
        ent_fire_name({ name: "ending_classic", input: "Enable" });
        const interval = setInterval(() => {
            if (CLEAR_ALL_INTERVAL) {
                clearInterval(interval);
                return;
            }
            const players = find_ents_by_class("player");
            let hmm = [];
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    hmm.push(player);
                }
            }
            const fuck_you_lol = hmm[randomIntArray(0, hmm.length)];
            if (fuck_you_lol?.IsValid()) {
                ent_fire_name({ name: "SfxLaser", input: "StartSound" });
                const laser_origin = randomPointOnSphere(fuck_you_lol.GetAbsOrigin(), LASERSLOP_DIST);
                const angles = Vector3Utils.directionTowards(laser_origin, fuck_you_lol.GetAbsOrigin());
                const angles_fix = Vector3Utils.vectorAngles(angles);
                const ents = force_spawn_template("EX2LaserTemp", laser_origin, angles_fix);
                flash_laser(ents, "EX2LaserTemp"); // same red/green flashing as the mako lasers
                for (const ent of ents) {
                    if (ent?.IsValid() && ent.GetClassName() == "trigger_hurt") {
                        ent_fire_target({ target: ent, input: "SetDamage", value: 49 });
