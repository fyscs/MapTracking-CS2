    post;
    wep;
    button;
    aim;
    align;
    relays; // [Lv1, Lv2, Lv3], or [Relay] for single-level materias
    drop_interval;
    constructor(spec, connect_name) {
        this.spec = spec;
        const connector = spec.item + "Connect";
        const at = connect_name.indexOf(connector);
        this.pre = at >= 0 ? connect_name.slice(0, at) : "";
        this.post = at >= 0 ? connect_name.slice(at + connector.length) : "";
        this.wep = this.part("Gun");
        this.button = this.part("Button");
        this.aim = this.part("EyePositionMeasure");
        this.align = this.part("EyePositionAlign");
        const levels = [this.part("Lv1Relay"), this.part("Lv2Relay"), this.part("Lv3Relay")];
        const single = this.part("Relay");
