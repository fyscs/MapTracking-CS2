        const base = this.spec.item + "RelayFx";
        const at = name.indexOf(base);
        this.fx_pre = at >= 0 ? name.slice(0, at) : "";
        this.fx_post = at >= 0 ? name.slice(at + base.length) : undefined;
        this.fx_particle = find_ent(this.fx_pre + this.spec.item + "GravParticle" + (this.fx_post ?? ""));
        if (this.fx_particle?.IsValid()) {
            materia_randomize_gravity_color(this.fx_particle);
        }
        this.begin_effect(GRAVITY_DURATION, relay_fx.GetAbsOrigin());
    }
    owns_fx(name) {
        return !!this.fx_post && name.startsWith(this.fx_pre + this.spec.item) && name.endsWith(this.fx_post);
    }
    origin() { return this.fx_particle?.IsValid() ? this.fx_particle.GetAbsOrigin() : super.origin(); }
    apply(player) {
        ent_fire_target({ target: player, input: "KeyValues", value: "speed 0.35" });
    }
    release(player) {
        if (this.victims == 3) {
            ent_fire_target({ target: player, input: "KeyValues", value: "movetype 2" });
        }
        ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.15" });
        ent_fire_target({ target: player, input: "KeyValues", value: "speed 1" });
        player.Teleport({ velocity: Vector3Utils.scale(player.GetAbsVelocity(), GRAVITY_ANTI_BOOST) });
    }
}
/** Heal materia (the only heal this touches - the other heal items are not materias). Heals its own team around the gun. */
const HEAL_LEVELS = [
    { radius: HEAL_LV1_RADIUS, rate: HEAL_LV1_RATE, max: HEAL_LV1_MAX, duration: HEAL_LV1_DURATION, immortal: false },
    { radius: HEAL_LV2_RADIUS, rate: HEAL_LV2_RATE, max: HEAL_LV2_MAX, duration: HEAL_LV2_DURATION, immortal: false },
    { radius: HEAL_LV3_RADIUS, rate: HEAL_LV3_RATE, max: HEAL_LV3_MAX, duration: HEAL_LV3_DURATION, immortal: true },
];
const HEAL_ZM_SCALE = 6767;
class HealMateria extends Materia {
    on_cast(level) {
        const lv = HEAL_LEVELS[level - 1];
        const center = this.part("GunParticle");
        if (!lv || !center) {
            return;
        }
        const scale = this.spec.team == 2 ? HEAL_ZM_SCALE : 1;
        const end = Instance.GetGameTime() + lv.duration;
        const made_immortal = [];
        const interval = setInterval(() => {
            if (end < Instance.GetGameTime() || CLEAR_ALL_INTERVAL || !center.IsValid()) {
                clearInterval(interval);
                for (const p of made_immortal) {
                    if (p?.IsValid() && p.effect_immortal) {
                        p.effect_immortal = false;
                        ent_fire_target({ target: p, input: "SetDamageFilter", value: "" });
                    }
                }
                return;
            }
            const at = center.GetAbsOrigin();
            for (const player of find_ents_by_class("player")) {
                if (!player?.IsValid() || !player.IsAlive() || player.GetTeamNumber() != this.spec.team
                    || Vector3Utils.distance(player_head(player), at) >= lv.radius) {
                    continue;
                }
                player.SetHealth(Math.min(player.GetHealth() + Math.ceil(lv.rate * scale * HEAL_TICK), lv.max * scale));
                if (lv.immortal) {
                    ent_fire_name({ name: "Item_Heal_ImmortalMsg", input: "ShowHudHint", activator: player });
                    if (!player.effect_immortal) {
                        player.effect_immortal = true;
                        made_immortal.push(player);
                        ent_fire_target({ target: player, input: "SetDamageFilter", value: "FilterNoPlayerAllowed" });
                    }
                }
            }
        }, HEAL_TICK * 1000);
    }
}
/** Ultima / trolltima: one use, then everyone on the other team near the gun dies 20s later. */
const TROLLTIMA_DIST = 1024 / 2;
const ULTIMA_DIST = 2118 / 2;
const ULTIMA_DELAY = 20;
class UltimaMateria extends Materia {
    used = false;
    press_output;
    connect() {
        if (!this.wep || !this.button) {
            Console.Log("materia " + this.spec.item + ": missing gun/button for" + this.post);
            return;
        }
        if (this.spec.item == "Item_Ultima_") {
            this.wep.rebirth_wep = true;
        }
        this.press_output = connect_output(this.button, "OnPressed", (stuff) => { this.on_press(stuff.activator); });
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
    }
    on_press(player) {
        if (this.used || !player?.IsValid() || !same_player(player, this.holder())) {
            return;
        }
        this.used = true; // only the holder's press uses it up
        disconnect_output(this.press_output);
        if (this.relays[0]) {
            ent_fire_target({ target: this.relays[0], input: "Trigger", activator: player });
        }
        const dist = this.kind == "trolltima" ? TROLLTIMA_DIST : ULTIMA_DIST;
        const victims = other_team(this.spec.team);
        setTimeout(() => {
            if (!this.wep?.IsValid()) {
                return;
            }
            const at = this.wep.GetAbsOrigin();
            for (const target of find_ents_by_class("player")) {
                if (target?.IsValid() && target.GetTeamNumber() == victims && Vector3Utils.distance(at, target.GetAbsOrigin()) < dist) {
                    ent_fire_target({ target, input: "sethealth", value: 0 });
                }
            }
        }, ULTIMA_DELAY * 1000);
    }
}
function make_materia(spec, connect_name) {
    switch (spec.kind) {
        case "elec": return new ElecMateria(spec, connect_name);
        case "ice": return new IceMateria(spec, connect_name);
        case "fire": return new FireMateria(spec, connect_name);
        case "grav": return new GravMateria(spec, connect_name);
        case "heal": return new HealMateria(spec, connect_name);
        case "ultima":
        case "trolltima": return new UltimaMateria(spec, connect_name);
        default: return new Materia(spec, connect_name);
    }
}
for (const spec of MATERIA_SPECS) {
    Instance.OnScriptInput(spec.input, (stuff) => {
        const name = stuff.caller?.GetEntityName();
        if (!name) {
            return;
        }
        make_materia(spec, name).connect();
    });
}
/** The copy of `cls` whose template part `caller` is (falls back to the closest active one of the right team). */
function materia_from_caller(cls, caller, team) {
    const name = caller?.IsValid() ? caller.GetEntityName() : "";
    const mine = materia_items.filter(m => m instanceof cls && m.spec.team == team);
    return mine.find(m => m.post != "" && m.owns(name)) ?? mine.find(m => m.owns(name)) ?? mine[mine.length - 1];
}
/** Which active effect copy a touch/hurt from `caller` on `player` belongs to. */
function effect_from_caller(cls, caller, player) {
    const active = materia_items.filter(m => m instanceof cls && m.victims == player.GetTeamNumber() && m.active());
    if (active.length <= 1) {
        return active[0];
    }
    const name = caller?.IsValid() ? caller.GetEntityName() : "";
    const named = active.find(m => (m.post != "" && m.owns(name)) || (m instanceof GravMateria && m.owns_fx(name)));
    if (named || !caller?.IsValid()) {
        return named ?? active[0];
    }
    const at = caller.GetAbsOrigin();
    let best = active[0];
    let best_d = Infinity;
    for (const m of active) {
        const o = m.origin();
        const d = o ? Vector3Utils.distance(o, at) : Infinity;
        if (d < best_d) {
            best = m;
            best_d = d;
        }
    }
    return best;
}
function toggle_materia_aim(player) {
    if (!player?.IsValid() || player.GetTeamNumber() != 3) {
        return;
    }
    materia_items.find(m => m.aim && same_player(m.holder(), player))?.apply_aim(player);
}
const EARTH_TICK = 50;
const EARTH_DURATION = 7.00;
// Earth collision box as measured at angles 0 0 0: 120 X, 384 Y, 272 Z.
// The origin is at the bottom of the box (Z 0..272), centered on Y, and the box sits 27 units back on X.
// The prop sits at 0 90 0 in its point_template, so the box is turned EARTH_BOX_YAW around the prop's up axis.
// Mapper chat (with !earthdebug on): !earthrot turns the box another 90, !earthflip flips the X bias. Copy the values it prints back here.
const EARTH_BOX_SIZE = { x: 120, y: 384, z: 272 };
let EARTH_BOX_X_OFFSET = -27;
let EARTH_BOX_YAW = 90;
const EARTH_BOX_BUFFER = 36; // extra room on every side, so players are released well clear of it
const PLAYER_CHECK_HEIGHTS = [0, 36, 72]; // feet, middle, head: the player counts if any of these is in the box
/** Source-style forward/left/up vectors for an angle (the earth can be thrown at any rotation). */
function angle_axes(ang) {
    const rad = Math.PI / 180;
    const sp = Math.sin(ang.pitch * rad), cp = Math.cos(ang.pitch * rad);
    const sy = Math.sin(ang.yaw * rad), cy = Math.cos(ang.yaw * rad);
    const sr = Math.sin(ang.roll * rad), cr = Math.cos(ang.roll * rad);
    return {
        forward: { x: cp * cy, y: cp * sy, z: -sp },
        left: { x: sr * sp * cy - cr * sy, y: sr * sp * sy + cr * cy, z: sr * cp },
        up: { x: cr * sp * cy + sr * sy, y: cr * sp * sy - sr * cy, z: cr * cp },
    };
}
/** World directions of the box's X / Y / Z for this earth: the prop's own axes turned EARTH_BOX_YAW around its up axis. */
function earth_box_axes(earth) {
    const model = angle_axes(earth.GetAbsAngles());
    const t = EARTH_BOX_YAW * Math.PI / 180;
    const c = Math.cos(t), s = Math.sin(t);
    return {
        forward: Vector3Utils.add(Vector3Utils.scale(model.forward, c), Vector3Utils.scale(model.left, s)),
        left: Vector3Utils.add(Vector3Utils.scale(model.forward, -s), Vector3Utils.scale(model.left, c)),
        up: model.up,
    };
}
/** Is any part of the player (feet/middle/head) inside the earth's collision box plus the buffer? */
function player_near_earth(player, earth) {
    const origin = earth.GetAbsOrigin();
    const axes = earth_box_axes(earth);
    const half_x = EARTH_BOX_SIZE.x / 2 + EARTH_BOX_BUFFER;
    const half_y = EARTH_BOX_SIZE.y / 2 + EARTH_BOX_BUFFER;
    const feet = player.GetAbsOrigin();
    for (const height of PLAYER_CHECK_HEIGHTS) {
        const delta = Vector3Utils.subtract({ x: feet.x, y: feet.y, z: feet.z + height }, origin);
        // world -> earth local space
        const lx = Vector3Utils.dot(delta, axes.forward) - EARTH_BOX_X_OFFSET;
        const ly = Vector3Utils.dot(delta, axes.left);
        const lz = Vector3Utils.dot(delta, axes.up);
        if (Math.abs(lx) <= half_x && Math.abs(ly) <= half_y && lz >= -EARTH_BOX_BUFFER && lz <= EARTH_BOX_SIZE.z + EARTH_BOX_BUFFER) {
            return true;
        }
    }
    return false;
}
// draws the earth box every tick while the earth is out (mapper chat: !earthdebug toggles it). Debug lines only show in dev/listen servers.
let EARTH_DEBUG_DRAW = false;
/**
 * Draw the earth's collision box (green) and the box with the buffer (yellow) as debug lines,
 * rotated with the earth. `duration` in seconds.
 */
function draw_earth_box(earth, duration = 5) {
    if (!earth?.IsValid())
        return;
    const origin = earth.GetAbsOrigin();
    const axes = earth_box_axes(earth);
    // local box corner -> world position
    const to_world = (x, y, z) => Vector3Utils.add(origin, Vector3Utils.add(Vector3Utils.scale(axes.forward, x), Vector3Utils.add(Vector3Utils.scale(axes.left, y), Vector3Utils.scale(axes.up, z))));
    const draw = (pad, color) => {
        const x0 = EARTH_BOX_X_OFFSET - EARTH_BOX_SIZE.x / 2 - pad, x1 = EARTH_BOX_X_OFFSET + EARTH_BOX_SIZE.x / 2 + pad;
        const y0 = -384 / 2 - pad, y1 = EARTH_BOX_SIZE.y / 2 + pad;
        const z0 = -pad, z1 = EARTH_BOX_SIZE.z + pad;
        const c = [
            to_world(x0, y0, z0), to_world(x1, y0, z0), to_world(x1, y1, z0), to_world(x0, y1, z0), // bottom
            to_world(x0, y0, z1), to_world(x1, y0, z1), to_world(x1, y1, z1), to_world(x0, y1, z1), // top
        ];
        const edges = [[0, 1], [1, 2], [2, 3], [3, 0], [4, 5], [5, 6], [6, 7], [7, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
        for (const [a, b] of edges) {
            Instance.DebugLine({ start: c[a], end: c[b], duration, color });
        }
    };
    draw(0, { r: 0, g: 255, b: 0 });
    draw(EARTH_BOX_BUFFER, { r: 255, g: 255, b: 0 });
    // origin marker
    Instance.DebugSphere({ center: origin, radius: 4, duration, color: { r: 255, g: 0, b: 255 } });
}
// every earth that's up right now (extreme 2: humans near one pass through it). One shared loop so two earths
// don't fight over a player's owner every tick.
let active_earths = [];
let earth_interval;
const earth_owned_slots = new Set();
/** The Item_Earth_Prop spawned alongside this Item_Earth_Prop_Relay (same nested template, same name fixup). */
function earth_prop_for(relay) {
    const name = relay?.IsValid() ? relay.GetEntityName() : "";
    if (name.includes("Item_Earth_Prop_Relay")) {
        const prop = find_ent(name.replace("Item_Earth_Prop_Relay", "Item_Earth_Prop"));
        if (prop?.IsValid()) {
            return prop;
        }
    }
    return find_ent("Item_Earth_Prop");
}
/** Any earth to draw for the mapper debug commands. */
function any_earth_prop() {
    return active_earths.find(e => e.prop.IsValid())?.prop ?? find_ent("Item_Earth_Prop");
}
function earth_tick() {
    const now = Instance.GetGameTime();
    active_earths = active_earths.filter(e => e.prop.IsValid() && e.until > now);
    const players = find_ents_by_class("player");
    if (active_earths.length == 0 || CLEAR_ALL_INTERVAL) {
        if (earth_interval !== undefined) {
            clearInterval(earth_interval);
            earth_interval = undefined;
        }
        // hand collision back to everyone we took it from
        for (const player of players) {
            const slot = player_slot(player);
            if (player?.IsValid() && slot !== undefined && earth_owned_slots.has(slot)) {
                player.SetOwner(undefined);
            }
        }
        earth_owned_slots.clear();
        active_earths = [];
        return;
    }
    for (const player of players) {
        if (!player?.IsValid()) {
            continue;
        }
        // only humans inside (or right next to) an earth pass through it; everyone else collides normally
        const near = player.GetTeamNumber() == 3 && player.IsAlive()
            ? active_earths.find(e => player_near_earth(player, e.prop)) : undefined;
        const slot = player_slot(player);
        player.SetOwner(near?.prop);
        if (slot !== undefined) {
            if (near) {
                earth_owned_slots.add(slot);
            }
            else {
                earth_owned_slots.delete(slot);
            }
        }
    }
    if (EARTH_DEBUG_DRAW) {
        for (const e of active_earths) {
            draw_earth_box(e.prop, EARTH_TICK / 1000 + 0.02);
        }
    }
}
Instance.OnScriptInput("input_spawn_earth", (stuff) => {
    const earth = earth_prop_for(stuff.caller);
    if (EARTH_DEBUG_DRAW) {
        Console.Log("earth debug: input_spawn_earth fired, level " + LEVEL + ", earth prop " + (earth?.IsValid() ? earth.GetEntityName() + " found at " + JSON.stringify(earth.GetAbsOrigin()) + " angles " + JSON.stringify(earth.GetAbsAngles()) : "NOT found"));
        // the no-collide logic below is extreme 2 only; still draw the box on other levels so placement can be checked
        if (LEVEL != 2 && earth?.IsValid()) {
            draw_earth_box(earth, EARTH_DURATION);
        }
    }
    // humans near the earth pass through it (extreme 2 only)
    if (LEVEL != 2 || !earth?.IsValid()) {
        return;
    }
    active_earths = active_earths.filter(e => e.prop !== earth);
    active_earths.push({ prop: earth, until: Instance.GetGameTime() + EARTH_DURATION });
    if (earth_interval === undefined) {
        earth_interval = setInterval(earth_tick, EARTH_TICK);
    }
});
Instance.OnScriptInput("input_debug_setowner", () => {
    for (const player of find_ents_by_class("player")) {
        player.SetOwner(find_ents_by_name("xmas_present")[0]);
    }
});
Instance.OnScriptInput("input_spawn_zm_earth", () => {
    const players = find_ents_by_class("player");
    const temp = find_ent("Item_Earth_ZM_PropTemp");
    let cts = [];
    for (const player of players) {
        if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
            cts.push(player);
        }
    }
    if (cts.length > 0) {
        const lolz = cts.length;
        for (let lol = 1; lol <= lolz; lol++) {
            const index = randomIntArray(0, cts.length);
            const random_angle = { pitch: 0, yaw: getRandomInt(0, 360), roll: 0 };
            temp.ForceSpawn(cts[index].GetAbsOrigin(), random_angle);
            cts.splice(index, 1);
        }
    }
});
Instance.OnScriptInput("input_ice_lvl_1_fader", (stuff) => {
