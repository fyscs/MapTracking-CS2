// ---- santassination extreme ending (hud_xmas EndingFG / EndingAct panels, everyone sees it) ----
// timeline (seconds from start), ~15s total:
//   0.0  family guy fades in, "HUMANZ WIN!!! :D" gets more and more corrupted
//   5.5  family guy fades out (0.75s css fade)
//   6.5  act title card fades in, every line fully randomized each tick
//  13.5  act card fades out
//  15.0  cleanup
const ENDING_TICK = 0.08;
const ENDING_FG_TEXT = "HUMANZ WIN!!! :D";
const ENDING_FG_GLITCH_TIME = 5.0;
const ENDING_FG_HIDE = 5.5;
const ENDING_ACT_SHOW = 6.5;
const ENDING_ACT_HIDE = 13.5;
const ENDING_TOTAL = 15.0;
const ENDING_GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789?%/&#@!$*<>=+~^[]{}|\\";
// same shapes as the act screenshot so the layout keeps its look while the characters go nuts
const ENDING_ACT_TITLE = "Act 0X1F";
const ENDING_ACT_SUB = "Unknown - ?????";
const ENDING_ACT_LINE = "?nOt%??20%rEaL/&";
let ending_interval;
function random_glyph() {
    return ENDING_GLYPHS[Math.floor(Math.random() * ENDING_GLYPHS.length)];
}
/** Corrupt `text`: each non-space character is replaced with chance `amount` (0..1), case flips randomly too. */
function glitch_text(text, amount) {
    let out = "";
    for (const ch of text) {
        if (ch == " ") {
            out += Math.random() < amount * 0.3 ? random_glyph() : " ";
            continue;
        }
        if (Math.random() < amount) {
            out += random_glyph();
            continue;
        }
        out += Math.random() < amount * 0.5 ? (ch == ch.toUpperCase() ? ch.toLowerCase() : ch.toUpperCase()) : ch;
    }
    return out;
}
/** Completely random string around the length of `shape` (spaces kept now and then so it still reads as "words"). */
function random_text_like(shape) {
    const len = Math.max(1, shape.length + Math.floor(Math.random() * 5) - 2);
    let out = "";
    for (let i = 0; i < len; i++) {
        out += Math.random() < 0.1 ? " " : random_glyph();
    }
    return out;
}
function set_ending_glitch_classes(hud, chance) {
    const r = Math.random();
    hud.SetHasClass(XMAS_HUD_PANEL, "EndingGlitchA", r < chance * 0.5);
    hud.SetHasClass(XMAS_HUD_PANEL, "EndingGlitchB", r >= chance * 0.5 && r < chance);
}
function hide_ending_hud() {
    if (ending_interval !== undefined) {
        clearInterval(ending_interval);
        ending_interval = undefined;
    }
    const hud = xmas_hud();
    if (!hud) {
        return;
    }
    for (const cls of ["ShowEndingFG", "ShowEndingAct", "EndingGlitchA", "EndingGlitchB"]) {
        hud.SetHasClass(XMAS_HUD_PANEL, cls, false);
    }
}
/** Play the santassination extreme ending on every player's screen (~15s). Map input: input_santassination_ending */
function santassination_ending() {
    const hud = xmas_hud();
    if (!hud) {
        Console.Log("santassination_ending: no hud entity named " + XMAS_HUD_NAME);
        return;
    }
    Console.Log("santassination_ending: start");
    truth_music_stop(); // music cuts out for the overlays, comes back as truth_new at the end
    new AnySFX("xmas.sfx.truth.ringer.global.fake_win");
    FunctionDelay(() => {
        new AnySFX("xmas.sfx.truth.ringer.global.truth_start");
    }, ENDING_ACT_SHOW);
    hide_ending_hud();
    hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_fg_text", ENDING_FG_TEXT);
    hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_title", ENDING_ACT_TITLE);
    hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_sub", ENDING_ACT_SUB);
    hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_line", ENDING_ACT_LINE);
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowEndingFG", true);
    let t = 0;
    let act_shown = false;
    ending_interval = setInterval(() => {
        const hud = xmas_hud();
        if (!hud) {
            hide_ending_hud();
            return;
        }
        t += ENDING_TICK;
        if (t >= ENDING_TOTAL) {
            hide_ending_hud();
            truth_music_play(TRUTH_MUSIC_NEW);
            truth_ringer_start();
            return;
        }
        if (t < ENDING_ACT_SHOW) {
            // part 1: starts clean, ramps up to almost fully schizo by the end of the glitch window
            const p = Math.min(1, t / ENDING_FG_GLITCH_TIME);
            const spike = p > 0.4 && Math.random() < p * 0.25; // occasional full scramble frames
            hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_fg_text", glitch_text(ENDING_FG_TEXT, spike ? 1 : p * p * 0.85));
            set_ending_glitch_classes(hud, p * 0.6);
            if (t >= ENDING_FG_HIDE) {
                hud.SetHasClass(XMAS_HUD_PANEL, "ShowEndingFG", false);
            }
            return;
        }
        // part 2: act card, everything random every tick
        if (!act_shown) {
            act_shown = true;
            hud.SetHasClass(XMAS_HUD_PANEL, "ShowEndingFG", false);
            hud.SetHasClass(XMAS_HUD_PANEL, "ShowEndingAct", true);
        }
        hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_title", random_text_like(ENDING_ACT_TITLE));
        hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_sub", random_text_like(ENDING_ACT_SUB));
        hud.SetDialogVariableString(XMAS_HUD_PANEL, "ending_act_line", random_text_like(ENDING_ACT_LINE));
        set_ending_glitch_classes(hud, 0.5);
        if (t >= ENDING_ACT_HIDE) {
            hud.SetHasClass(XMAS_HUD_PANEL, "ShowEndingAct", false);
        }
    }, ENDING_TICK * 1000);
}
