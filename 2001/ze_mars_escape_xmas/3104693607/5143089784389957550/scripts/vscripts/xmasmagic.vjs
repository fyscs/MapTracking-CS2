function shufflePlayerArray(array) {
    let currentIndex = array.length;
    let randomIndex;
    // While there remain elements to shuffle.
    while (currentIndex !== 0) {
        // Pick a remaining element.
        randomIndex = Math.floor(Math.random() * currentIndex);
        currentIndex--;
        // And swap it with the current element.
        [array[currentIndex], array[randomIndex]] = [
            array[randomIndex],
            array[currentIndex],
        ];
    }
    return array;
}
const BUDDY_TICK = 0.02;
let buddy_primes = [];
let buddy_primes_backup = [];
let init_boolean = false;
function buddy_system() {
    // determine  starting states for buddies
    buddy_primes = [];
    buddy_primes_backup = [];
    const players_init = find_ents_by_class("player");
    if (players_init.length < 2) {
        Console.ServerCommand("say Error! Not enough players for buddy system, falling back to Classic Mode.");
        return;
    }
    reset_buddies();
    const interval = setInterval(() => {
        let humans = 0;
        const players = find_ents_by_class("player");
        for (const player of players) {
            if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                humans++;
            }
        }
        if (CLEAR_ALL_INTERVAL || humans < 3) {
            clearInterval(interval);
            return;
        }
        else {
            for (const player of players) {
                if (player?.IsValid() && player.GetTeamNumber() == 2) {
                    player.buddy_prime = false;
                    player.buddy = undefined;
                }
                if (player?.IsValid() && player.IsAlive() && !player.buddy_prime) {
                    if (player.buddy?.IsValid() && player.buddy.GetTeamNumber() == player.GetTeamNumber()) {
                        player.Teleport({ position: player_buddy_position(player.buddy) });
                    }
                    else if (!player.buddy?.IsValid() || player.buddy.GetTeamNumber() != player.GetTeamNumber()) {
                        player.buddy = undefined;
                        set_new_buddy(player);
                    }
                }
            }
        }
    }, BUDDY_TICK * 1000);
}
function reset_buddies() {
    Console.ServerCommand("say The Boy Scout Leader is assigning buddies!");
    init_boolean = false;
    const players = shufflePlayerArray(find_ents_by_class("player"));
    for (const player of players) {
        if (player?.IsValid() && player?.IsAlive() && player.GetTeamNumber() == 3) {
            player.buddy_prime = init_boolean;
            if (init_boolean) {
                buddy_primes_backup.push(player);
                init_boolean = false;
                player.buddy = undefined;
                ent_fire_target({ target: player, input: "KeyValues", value: "movetype 2" });
            }
            else {
                init_boolean = true;
            }
        }
    }
    // assign buddies to primes
    buddy_primes = buddy_primes_backup.slice();
    for (const player of players) {
        if (player?.IsValid() && !player.buddy_prime) {
            if (buddy_primes.length == 0) {
                buddy_primes = buddy_primes_backup.slice();
            }
            const index = randomIntArray(0, buddy_primes.length);
            const buddy = buddy_primes[index];
            buddy_primes.splice(index, 1);
            if (buddy?.IsValid() && player.GetTeamNumber() == buddy.GetTeamNumber()) {
                player.buddy = buddy;
                ent_fire_target({ target: player, input: "KeyValues", value: "movetype 1" });
            }
        }
    }
}
function update_buddy_primes() {
    for (let i = 0; i <= buddy_primes_backup.length; i++) {
        const buddy = buddy_primes_backup[i];
        if (!buddy?.IsValid() || buddy.GetTeamNumber() == 2) {
            buddy_primes_backup.splice(i, 1);
        }
    }
    if (buddy_primes_backup.length == 0) {
        reset_buddies();
    }
    else {
        buddy_primes = buddy_primes_backup.slice();
    }
}
function set_new_buddy(player) {
    update_buddy_primes();
    const index = randomIntArray(0, buddy_primes.length);
    const buddy = buddy_primes[index];
    buddy_primes.splice(index, 1);
    if (buddy?.IsValid() && player.GetTeamNumber() == buddy.GetTeamNumber()) {
        player.buddy = buddy;
        ent_fire_target({ target: player, input: "KeyValues", value: "movetype 1" });
    }
}
Instance.OnScriptInput("input_toggle_limited_ammo", () => {
    const players = find_ents_by_class("player");
    for (const player of players) {
        if (player?.IsValid() && player.GetTeamNumber() == 3) {
            player.primary_ammo = LIMITED_AMMO_START;
            player.secondary_ammo = LIMITED_AMMO_START;
            update_ammo_hud(player);
        }
    }
    LIMITED_AMMO = true;
});
let LIMITED_AMMO = false;
const LIMITED_AMMO_START = 900;
/** Players who spawned after limited ammo was turned on have no counts yet: give them the starting amount. */
function init_limited_ammo(player) {
    if (typeof player.primary_ammo !== "number" || isNaN(player.primary_ammo)) {
        player.primary_ammo = LIMITED_AMMO_START;
    }
    if (typeof player.secondary_ammo !== "number" || isNaN(player.secondary_ammo)) {
        player.secondary_ammo = LIMITED_AMMO_START;
    }
}
Instance.OnGunFire((stuff) => {
    if (LIMITED_AMMO) {
        const wep = stuff.weapon;
        const owner = wep?.GetOwner();
        if (wep?.IsValid() && owner?.IsValid() && owner.GetTeamNumber() == 3) {
            init_limited_ammo(owner);
            const slot = wep.GetData().GetGearSlot();
            if (slot == 0) {
                owner.primary_ammo = Math.max(0, owner.primary_ammo - 1);
                if (owner.primary_ammo == 0) {
                    wep.SetReserveAmmo(0);
                }
                update_ammo_hud(owner);
            }
            else if (slot == 1) {
                owner.secondary_ammo = Math.max(0, owner.secondary_ammo - 1);
                if (owner.secondary_ammo == 0) {
                    wep.SetReserveAmmo(0);
                }
                update_ammo_hud(owner);
            }
        }
    }
    else if (BOOMSTICKS) {
        const player = stuff.weapon.GetOwner();
        if (player?.IsValid() && stuff.weapon?.GetData().GetName() == "weapon_sawedoff") {
            const angles = Vector3Utils.inverse(getForwardVector(player.GetEyeAngles()));
            let velocity = Vector3Utils.scale(angles, BOOMSTICKS_PUSH_SHOOT_MAX);
            player.Teleport({ velocity: velocity });
            stuff.weapon.SetClipAmmo(stuff.weapon.GetClipAmmo() + 1);
        }
    }
    else if (WET_ANUS) {
        const player = stuff.weapon.GetOwner();
        if (player?.IsValid() && stuff.weapon?.GetData().GetName() == "weapon_ssg08") {
            stuff.weapon.SetClipAmmo(stuff.weapon.GetClipAmmo() + 1);
        }
    }
});
const BOOMSTICKS_PUSH_SHOOT_MAX = 1024;
const BOOMSTICKS_PUSH_MAX = 1024;
const BOOMSTICKS_DIST_MAX = 2048;
const BOOMSTICKS_EXTRA_PUSH = false;
Instance.OnPlayerDamage((stuff) => {
    const player = stuff.player;
    const attacker = stuff.attacker;
    if (attacker?.IsValid() && attacker.GetTeamNumber() == 3 && player?.IsValid() && player.GetTeamNumber() == 2) {
        attacker.top_def_dmg += stuff.damage;
    }
    if (BOOMSTICKS && BOOMSTICKS_EXTRA_PUSH) {
        if (attacker?.IsValid() && player?.IsValid() && attacker.GetTeamNumber() == 3 && stuff.weapon?.GetData().GetName() == "weapon_sawedoff") {
            Vector3Utils.directionTowards(attacker.GetAbsOrigin(), player.GetAbsOrigin());
            const angles_attacker = getForwardVector(attacker.GetEyeAngles());
            const distance = Vector3Utils.distance(attacker.GetAbsOrigin(), player.GetAbsOrigin());
            let velocity = Vector3Utils.scale(angles_attacker, BOOMSTICKS_PUSH_MAX);
            if (distance > 1) {
                velocity = Vector3Utils.scale(angles_attacker, scaleValue(distance, 1, BOOMSTICKS_DIST_MAX, BOOMSTICKS_PUSH_MAX, 1));
            }
            player.Teleport({ velocity: velocity });
        }
    }
});
function scaleValue(value, min, max, baseMin, baseMax) {
    // normalize where 'value' is between min and max (0–1)
    const t = Math.max(0, Math.min(1, (value - min) / (max - min)));
    // interpolate between baseMin and baseMax
    return baseMin + (baseMax - baseMin) * t;
}
Instance.OnGunReload((stuff) => {
    if (!LIMITED_AMMO) {
        return;
    }
    const wep = stuff.weapon;
    const owner = wep?.GetOwner();
    if (wep?.IsValid() && owner?.IsValid() && owner.GetTeamNumber() == 3) {
        init_limited_ammo(owner);
        // the hud shows the counts; the reload only gets what's left (0 when empty)
        const slot = wep.GetData().GetGearSlot();
        if (slot == 0) {
            wep.SetReserveAmmo(owner.primary_ammo);
        }
        else if (slot == 1) {
            wep.SetReserveAmmo(owner.secondary_ammo);
        }
        update_ammo_hud(owner);
    }
});
function randomPointOnSphere(origin, radius) {
    // Random spherical angles
    const u = Math.random();
    const v = Math.random();
    const theta = 2 * Math.PI * u; // azimuth
    const phi = Math.acos(2 * v - 1); // inclination
    // Convert spherical → Cartesian
    const x = origin.x + radius * Math.sin(phi) * Math.cos(theta);
    const y = origin.y + radius * Math.sin(phi) * Math.sin(theta);
    const z = origin.z + radius * Math.cos(phi);
    return { x, y, z };
}
// ---- extreme 2 cowbell counter (hud_xmas custom_hud_layout, label "COWBELLS: {s:cowbell_count}") ----
const XMAS_HUD_NAME = "hud_xmas";
const XMAS_HUD_PANEL = "Xmas"; // panel id that takes the Show* classes / holds the dialog variables
const COWBELL_TOTAL = 15;
let cowbell_break_ids = [];
let cowbells_broken = 0;
let cowbell_dead_hook;
function xmas_hud() {
    const hud = find_ent(XMAS_HUD_NAME);
    return hud?.IsValid() ? hud : undefined;
}
function set_cowbell_count(count) {
    xmas_hud()?.SetDialogVariableString(XMAS_HUD_PANEL, "cowbell_count", count + "/" + COWBELL_TOTAL);
}
/** Round start: back to 0/15 (still hidden until extreme 2 shows it). */
function reset_cowbell_hud() {
    cowbells_broken = 0;
    set_cowbell_count(0);
    xmas_hud()?.SetHasClass(XMAS_HUD_PANEL, "ShowCowbell", false);
}
/** Spawn CowbellTemplate_Enabled and count every cowbell that breaks (replaces the CowbellCase logic_case + CowbellCounter math_counter). */
function spawn_cowbells() {
    for (const id of cowbell_break_ids) {
        disconnect_output(id);
    }
    cowbell_break_ids = [];
    cowbells_broken = 0;
    const template = find_ent("CowbellTemplate_Enabled");
    if (!template?.IsValid()) {
        Console.Log("spawn_cowbells: CowbellTemplate_Enabled not found");
        return;
    }
    const spawned = template.ForceSpawn() ?? [];
    Console.Log("spawn_cowbells: spawned " + spawned.map(e => e.GetClassName() + " " + e.GetEntityName()).join(", "));
    // the cowbells are the breakable ones (or named cowbell)
    const cowbells = spawned.filter(e => e?.IsValid() && (e.GetClassName().includes("break") || e.GetEntityName().toLowerCase().includes("cowbell")));
    Console.Log("spawn_cowbells: counting " + cowbells.length + " cowbell(s) (expected " + COWBELL_TOTAL + ")");
    for (const cowbell of cowbells) {
        let counted = false;
        const id = connect_output(cowbell, "OnBreak", () => {
            if (counted) {
                return;
            }
            counted = true;
            cowbell_broken();
        });
        if (id === undefined) {
            Console.Log("spawn_cowbells: could not connect OnBreak on " + cowbell.GetEntityName());
        }
        else {
            cowbell_break_ids.push(id);
        }
    }
}
/** One cowbell broke: update the hud, announce the last 3, run the max actions when they're all gone. */
function cowbell_broken() {
    cowbells_broken++;
    set_cowbell_count(cowbells_broken);
    const left = COWBELL_TOTAL - cowbells_broken;
    if (left == 3) {
        ent_fire_name({ name: "command", input: "Command", value: "say ** 3 COWBELLS LEFT! **" });
    }
    else if (left == 2) {
        ent_fire_name({ name: "command", input: "Command", value: "say ** 2 COWBELLS LEFT! **" });
    }
    else if (left == 1) {
        ent_fire_name({ name: "command", input: "Command", value: "say ** 1 COWBELL LEFT!!! **" });
    }
    else if (left == 0) {
        cowbells_all_broken();
    }
}
/** What CowbellCounter's OnHitMax used to do. */
function cowbells_all_broken() {
    ent_fire_name({ name: "command", input: "Command", value: "say ** ALL COWBELLS HAVE BEEN BROKEN **" });
    ent_fire_name({ name: "BahamutCastin*", input: "Kill" });
    ent_fire_name({ name: "ToggleCowbell*", input: "SetValueTest", value: 1 });
    ent_fire_name({ name: "command", input: "Command", value: "say ** BAHAMUT WILL NOT USE MATERIALS **", delay: 1 });
}
/** Extreme 2: show the counter to everyone and hide it when the BahamutDead relay triggers. */
function setup_cowbell_hud() {
    const hud = xmas_hud();
    if (!hud) {
        Console.Log("setup_cowbell_hud: no hud entity named " + XMAS_HUD_NAME);
        return;
    }
    set_cowbell_count(cowbells_broken);
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowCowbell", true);
    // Bahamut dies: hide the counter (fires whether the map or this script triggers the relay)
    if (cowbell_dead_hook !== undefined) {
        disconnect_output(cowbell_dead_hook);
        cowbell_dead_hook = undefined;
    }
    const bahamut_dead = find_ent("BahamutDead");
    if (bahamut_dead?.IsValid()) {
        cowbell_dead_hook = connect_output(bahamut_dead, "OnTrigger", () => { hide_cowbell_hud(); });
    }
}
/** Round end: hide it. */
function hide_cowbell_hud() {
    xmas_hud()?.SetHasClass(XMAS_HUD_PANEL, "ShowCowbell", false);
}
// ---- extreme 2 bomb timer (hud_xmas label "BOMB TIMER: {s:bomb_timer}") ----
const BOMB_TIMER_SECONDS = 130;
let bomb_timer_interval;
let bomb_timer_hook;
function set_bomb_timer(seconds) {
    const m = Math.floor(seconds / 60);
    const sec = (seconds % 60).toString().padStart(2, "0");
    xmas_hud()?.SetDialogVariableString(XMAS_HUD_PANEL, "bomb_timer", m + ":" + sec);
}
function hide_bomb_timer_hud() {
    if (bomb_timer_interval !== undefined) {
        clearInterval(bomb_timer_interval);
        bomb_timer_interval = undefined;
    }
    xmas_hud()?.SetHasClass(XMAS_HUD_PANEL, "ShowBomb", false);
}
/** BombTimer_RelayExtreme triggered: show the timer to everyone and count down to 0:00, then stay at zero. */
function start_bomb_timer() {
    const hud = xmas_hud();
    if (!hud) {
        return;
    }
    if (bomb_timer_interval !== undefined) {
        clearInterval(bomb_timer_interval);
    }
    let remaining = BOMB_TIMER_SECONDS;
    set_bomb_timer(remaining);
    hud.SetHasClass(XMAS_HUD_PANEL, "ShowBomb", true);
    bomb_timer_interval = setInterval(() => {
        remaining = Math.max(0, remaining - 1);
        set_bomb_timer(remaining);
        if (remaining == 0 && bomb_timer_interval !== undefined) {
            clearInterval(bomb_timer_interval);
            bomb_timer_interval = undefined;
        }
    }, 1000);
}
/** Extreme 2: hook the relay that starts the bomb timer. */
function setup_bomb_timer_hud() {
    if (bomb_timer_hook !== undefined) {
        disconnect_output(bomb_timer_hook);
        bomb_timer_hook = undefined;
    }
    const relay = find_ent("BombTimer_RelayExtreme");
    if (relay?.IsValid()) {
        bomb_timer_hook = connect_output(relay, "OnTrigger", () => { start_bomb_timer(); });
    }
}
// ---- rebirth counter (hud_xmas label "{s:rebirth_counter}", shown on the Rebirth level) ----
