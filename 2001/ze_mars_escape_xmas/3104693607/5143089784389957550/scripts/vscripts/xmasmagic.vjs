/** Elec: the higher level gun particles only exist for the level we're on. */
class ElecMateria extends Materia {
    connect() {
        if (MATERIA_LEVEL <= 2) {
            this.part("GunParticle3")?.Remove();
        }
        if (MATERIA_LEVEL <= 1) {
            this.part("GunParticle2")?.Remove();
        }
        super.connect();
    }
}
/**
 * Materias that slow/freeze the other team for a while (ice, fire, gravity).
 * The effect window, the players it caught and their release all belong to this copy, so two of the same
 * materia never cut each other's effect short. A player caught by two copies is released by the last one to end.
 */
class EffectMateria extends Materia {
    effect_until = 0;
    effect_origin;
    effect_timer;
    affected = new Map();
    get victims() { return other_team(this.spec.team); }
    active() { return this.effect_until > Instance.GetGameTime(); }
    holds(slot) { return this.active() && this.affected.has(slot); }
    /** Where the effect is happening right now (used to tell copies apart when names are preserved). */
    origin() { return this.effect_origin ?? this.wep?.GetAbsOrigin(); }
    begin_effect(duration, origin) {
        this.effect_until = Instance.GetGameTime() + duration;
        this.effect_origin = origin;
        if (this.effect_timer !== undefined) {
            clearTimeout(this.effect_timer);
        }
        this.effect_timer = setTimeout(() => { this.end_effect(); }, duration * 1000);
    }
    try_affect(player) {
        if (!this.active() || !player.IsAlive() || player.GetTeamNumber() != this.victims) {
            return;
        }
        const slot = player_slot(player);
        if (slot === undefined || this.affected.has(slot)) {
            return;
        }
        const already = this.others().some(m => m.holds(slot));
        this.affected.set(slot, player);
        if (!already) {
            this.apply(player);
        }
    }
    end_effect() {
        this.effect_timer = undefined;
        const caught = [...this.affected.entries()];
        this.affected.clear();
        for (const [slot, player] of caught) {
            if (!player?.IsValid() || this.others().some(m => m.holds(slot))) {
                continue;
            }
            this.release(player);
        }
    }
    /** Other live copies of the same materia hitting the same team. */
    others() {
        return materia_items.filter(m => m !== this && m instanceof EffectMateria && m.kind == this.kind && m.victims == this.victims);
    }
}
const ICE_LVL_DURATIONS = [3.5, 4.5, 6];
const FIRE_LVL_DURATIONS = [1, 4, 7];
const GRAVITY_DURATION = 7;
const GRAVITY_ANTI_BOOST = 0.01;
class IceMateria extends EffectMateria {
    // the ice zone is spawned by this copy's Item_Ice_Maker, so remember where it was when it went off
    cast(level) { this.begin_effect(ICE_LVL_DURATIONS[level - 1] ?? ICE_LVL_DURATIONS[0], this.part("Maker")?.GetAbsOrigin()); }
    apply(player) {
        ent_fire_target({ target: player, input: "KeyValues", value: "movetype 1" });
    }
    release(player) {
        ent_fire_target({ target: player, input: "KeyValues", value: "movetype 2" });
        ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.13" });
    }
}
class FireMateria extends EffectMateria {
    cast(level) { this.begin_effect(FIRE_LVL_DURATIONS[level - 1] ?? FIRE_LVL_DURATIONS[0]); }
    // the hurts ride on the gun/eye align, so the live position is the gun
    origin() { return this.wep?.IsValid() ? this.wep.GetAbsOrigin() : undefined; }
    apply(player) {
        ent_fire_target({ target: player, input: "KeyValues", value: "speed .65" });
        ent_fire_target({ target: player, input: "IgniteLifetime", value: 20 });
    }
    release(player) {
        ent_fire_target({ target: player, input: "KeyValues", value: "speed 1" });
        ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.13" });
        ent_fire_target({ target: player, input: "IgniteLifetime", value: 2 });
    }
}
class GravMateria extends EffectMateria {
    last_cast = 0;
    // the gravity ball comes from a nested template (Item_Grav_Maker), with its own name fixup
    fx_pre = "";
    fx_post;
    fx_particle;
    on_cast() { this.last_cast = Instance.GetGameTime(); }
    /** Item_Grav_RelayFx spawned: hook up its particle + freeze trigger to this copy and start the window. */
    fx_spawned(relay_fx) {
