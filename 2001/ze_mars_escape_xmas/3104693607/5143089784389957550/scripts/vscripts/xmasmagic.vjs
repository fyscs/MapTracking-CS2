        ent_fire_name({ name: "command", input: "Command", value: "say *** Toggle item aiming with !aim (default is disabled) ***", delay: 15 });
        ent_fire_name({ name: "command", input: "Command", value: "say Level: Extreme 2", delay: 13 });
        set_level_hud("Extreme 2");
        CheckCowbell();
        setup_cowbell_hud();
        setup_bomb_timer_hud();
    }
    else if (LEVEL == 3) {
