function set_vip(player) {
    if (!player?.IsValid() || player.GetTeamNumber() != 3) {
        // vip() only hands us humans; if there are none there's nobody to pick (don't recurse)
        return;
    }
    else {
        let temp_vip_trail = find_ent("temp_vip_trail");
        let vip_controller = player.GetPlayerController();
        let vip_name = vip_controller.GetPlayerName();
        Console.ServerCommand(`say ${vip_name} is the VIP! Protect him at all costs! If he dies, you all die!`);
        player.SetHealth(100);
        ent_fire_target({ target: player, input: "KeyValues", value: "runspeed 1.10" });
        let vip_trail = temp_vip_trail.ForceSpawn(player.GetAbsOrigin());
        let le_trail_haha = vip_trail[0];
        le_trail_haha.SetParent(player);
        ent_fire_target({ target: le_trail_haha, input: "Start" });
        player.vip = true;
        vip_slot = vip_controller.GetPlayerSlot();
        //player.Teleport({position:vip_destination});
    }
}
let vip_slot = null;
Instance.OnPlayerDisconnect((stuff) => {
    if (stuff.playerSlot == null || MODE != "VIP") {
        return;
    }
    if (stuff.playerSlot == vip_slot) {
        Console.ServerCommand("say The VIP has disconnected! Selecting a new VIP!");
        setTimeout(() => {
            let potential_vips = [];
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    potential_vips.push(player);
                }
            }
            if (potential_vips.length > 1) {
                set_vip(potential_vips[randomIntArray(0, potential_vips.length)]);
            }
            else if (potential_vips.length == 1) {
                set_vip(potential_vips[0]);
            }
            return;
        }, 2000);
    }
});
function vip() {
    let hmm_vips = [];
    const players = find_ents_by_class("player");
    for (const player of players) {
        if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
            hmm_vips.push(player);
        }
    }
    if (hmm_vips.length == 0) {
        return;
    }
    set_vip(hmm_vips[randomIntArray(0, hmm_vips.length)]);
}
Instance.OnPlayerKill((stuff) => {
    let player = stuff.player;
    if (MODE == "VIP" && player?.IsValid() && player.vip && !player.IsAlive()) {
        vip_died();
    }
    // any human death, from anything (zombie knife, parried snowball, trigger_hurt, fall, sethealth 0, ...)
    if (player?.IsValid() && player.GetTeamNumber() == 3) {
        spawn_dark_souls_death(player);
    }
    if (player?.IsValid()) {
        drop_fumos(player);
    }
});
const ZERO_VEC = new Vec3(0, 0, 0);
class AnySFX {
    temp = find_ent("temp_sfx_any");
    ents = [];
    sfx;
    constructor(sound, pos = ZERO_VEC, ent = undefined) {
        // never throw: a missing template / failed spawn would otherwise abort whatever called this
        if (!this.temp?.IsValid()) {
            Console.Log("AnySFX: temp_sfx_any not found (" + sound + ")");
            return;
        }
        this.ents = this.temp.ForceSpawn(pos) ?? [];
        if (this.ents.length == 0) {
            Console.Log("AnySFX: temp_sfx_any spawned nothing (" + sound + ")");
            return;
        }
        for (const ent of this.ents) {
            if (ent.GetEntityName().includes("sfx_any")) {
                this.sfx = ent;
            }
        }
        if (ent != undefined) {
            ent_fire_target({ target: this.sfx, input: "SetSourceEntity", value: ent.GetEntityName() });
        }
        ent_fire_target({ target: this.sfx, input: "SetSoundEventName", value: sound });
        ent_fire_target({ target: this.sfx, input: "StartSound", delay: ONE_TICK });
        ent_fire_target({ target: this.sfx, input: "Kill", delay: 60 });
    }
}
/** "YOU DIED" (temp_dark_souls_death) spawned where the human died. */
function spawn_dark_souls_death(player) {
    const temp = find_ent("temp_dark_souls_death");
    if (!temp?.IsValid()) {
        Console.Log("spawn_dark_souls_death: temp_dark_souls_death not found");
        return;
    }
    temp.ForceSpawn(player.GetAbsOrigin(), { pitch: 0, yaw: player.GetAbsAngles().yaw, roll: 0 });
}
