class Meteor {
    mode;
    escapeY;
    escapeZ;
    targeted = [];
    timer;
    temp = find_ent("radiation_meteor_temp1");
    /**
     * @param template  targetname of the point_template
     * @param mode      undefined = anywhere, trace to ground; "escape" = only humans with y < escapeY, spawn at escapeZ
     * @param escapeY   y threshold for escape mode
     * @param escapeZ   fixed z to spawn at in escape mode
     * @param interval  seconds between meteors
     */
    constructor(mode = undefined, escapeY = 0, escapeZ = 0, interval = 4) {
        this.mode = mode;
        this.escapeY = escapeY;
        this.escapeZ = escapeZ;
        this.timer = setInterval(() => this.Fire(), interval * 1000);
    }
    Stop() {
        clearInterval(this.timer);
        this.targeted = [];
    }
    candidates() {
        const pawns = find_ents_by_class("player");
        return pawns.filter(p => p?.IsValid() && p.IsAlive() && p.GetTeamNumber() === 3 &&
            (this.mode !== "escape" || p.GetAbsOrigin().y < this.escapeY));
    }
    Fire() {
        const humans = this.candidates();
        if (humans.length === 0)
            return;
        // drop anyone dead/invalid, then reset once everyone has been hit
        this.targeted = this.targeted.filter(p => humans.includes(p));
        let pool = humans.filter(p => !this.targeted.includes(p));
        if (pool.length === 0) {
            this.targeted = [];
            pool = humans;
        }
        const target = pool[Math.floor(Math.random() * pool.length)];
        this.targeted.push(target);
        const pos = target.GetAbsOrigin();
        let spawn = { x: pos.x, y: pos.y, z: pos.z };
        if (this.mode === "escape") {
            spawn.z = this.escapeZ;
        }
        else {
            // trace straight down to find the ground (handles jumping players)
            const tr = Instance.TraceLine({
                start: { x: pos.x, y: pos.y, z: pos.z + 8 },
                end: { x: pos.x, y: pos.y, z: pos.z - 4096 },
                ignorePlayers: true,
            });
            if (tr.didHit)
                spawn.z = tr.end.z;
        }
        this.temp?.ForceSpawn(spawn, { pitch: 0, yaw: 0, roll: 0 });
    }
}
