        const owner = this.wep?.IsValid() ? this.wep.GetOwner() : undefined;
        return owner?.IsValid() ? owner : undefined;
    }
    /** Standard materia: pickup (aim + pickup lock until dropped), holder-only press, level relay picked by MATERIA_LEVEL. */
    connect() {
        if (!this.wep || !this.button) {
