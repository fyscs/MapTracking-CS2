function randomIntArray(min, max) {
    max -= 1;
    return Math.floor(Math.random() * (max - min + 1) + min);
}
const LEVEL_2_MAX = 3;
let LEVEL_2_WINS = 0;
const LEVEL_3_MAX = 1;
let LEVEL_3_WINS = 0;
const LEVEL_4_MAX = 2;
let LEVEL_4_WINS = 0;
const LEVEL_5_MAX = 3;
let LEVEL_5_WINS = 0;
let FORCE_NEW_LEVEL = false;
/** Level 1 (mars) never maxes out; the others stop once humans have beaten them LEVEL_N_MAX times. */
function level_open(level) {
    switch (level) {
        case 2: return LEVEL_2_WINS < LEVEL_2_MAX;
        case 3: return LEVEL_3_WINS < LEVEL_3_MAX;
        case 4: return LEVEL_4_WINS < LEVEL_4_MAX;
        case 5: return LEVEL_5_WINS < LEVEL_5_MAX;
        default: return true;
    }
}
// after a human win: random open one of these
const FORCED_LEVELS = [2, 3, 5];
// bag draw hit a maxed level: try these in order (gris -> rebirth -> ex2 -> deadcore), mars if none are open
const LEVEL_FALLBACKS = {
    3: [4, 2, 5],
    4: [2, 5],
};
// ---- human win score: every win bumps you to the next "67" tier (67, 6767, 676767, ...) ----
// score is an int32, so the last tier that fits is 67676767
const SIX_SEVEN_MAX_REPEATS = 4;
const SIX_SEVEN_ROUND_POINTS = 1; // the game's own point for the round, which lands on top of ours
const SIX_SEVEN_TIERS = Array.from({ length: SIX_SEVEN_MAX_REPEATS }, (_, i) => Number("67".repeat(i + 1)));
/** Points that take `score` to just under the next tier above it (the round point finishes the job). */
function six_seven_points(score) {
    const tier = SIX_SEVEN_TIERS.find(t => t - SIX_SEVEN_ROUND_POINTS > score);
    return tier === undefined ? 0 : tier - SIX_SEVEN_ROUND_POINTS - score;
}
function award_six_seven_scores() {
    for (const player of find_ents_by_class("player")) {
        if (!player?.IsValid() || !player.IsAlive() || player.GetTeamNumber() != 3) {
            continue;
        }
        const controller = player.GetPlayerController();
        if (!controller?.IsValid()) {
            continue;
        }
        const points = six_seven_points(controller.GetScore());
        if (points > 0) {
            controller.AddScore(points);
        }
    }
}
Instance.OnRoundEnd((stuff) => {
    close_model_menu_all();
    hide_round_huds();
    KNIFE_PARTY = false;
    CLEAR_ALL_INTERVAL = true;
    BOOMSTICKS = false;
    WET_ANUS = false;
    HEAL = false;
    SNOWBALL_NADES = false;
    LENNY = false;
    Console.ServerCommand("zr_infect_spawn_mz_ratio 7");
    Console.ServerCommand("zr_infect_min_count_req " + DDR_MZ_MIN_COUNT_DEFAULT);
    Console.ServerCommand("sv_friction 5.2");
    ent_fire_name({ name: "music", input: "StopSound" });
    radio_stop_all();
    ent_fire_name({ name: "reset_misc", input: "Trigger" });
    if (stuff.winningTeam == 2) {
        ent_fire_name({ name: "sfx_seinfeld", input: "StartSound" });
        FORCE_NEW_LEVEL = false;
    }
    else if (stuff.winningTeam == 3) {
        award_six_seven_scores();
        if (LEVEL == 1) {
            FORCE_NEW_LEVEL = true;
        }
        else if (LEVEL == 2) {
            LEVEL_2_WINS++;
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    player.ex2_winner = true;
                }
            }
            EX2_EARTH_TROLLING = true;
            FORCE_NEW_LEVEL = false;
        }
        else if (LEVEL == 3) {
            LEVEL_3_WINS++;
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    player.gris_winner = true;
                }
            }
            FORCE_NEW_LEVEL = true;
        }
        else if (LEVEL == 4) {
            LEVEL_4_WINS++;
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    player.gris_winner = true;
                }
            }
            FORCE_NEW_LEVEL = true;
        }
        else if (LEVEL == 5) {
            LEVEL_5_WINS++;
            const players = find_ents_by_class("player");
            for (const player of players) {
                if (player?.IsValid() && player.IsAlive() && player.GetTeamNumber() == 3) {
                    player.deadcore_winner = true;
                }
            }
            FORCE_NEW_LEVEL = true;
        }
    }
    const players = find_ents_by_class("player");
    let top_defender = undefined;
    let top_defender_dmg = 0;
    for (const player of players) {
        if (!player?.IsValid()) {
            continue;
        }
        player.text_ent = undefined;
        player.sfx_ent = undefined;
        player.top_def = false;
        if ((player.top_def_dmg ?? 0) > top_defender_dmg) {
            top_defender = player;
            top_defender_dmg = player.top_def_dmg;
        }
        // heal lv3 immunity that was still running when the round ended
        if (player.effect_immortal) {
            player.effect_immortal = false;
            ent_fire_target({ target: player, input: "SetDamageFilter", value: "" });
        }
    }
    if (top_defender != undefined) {
        top_defender.top_def = true;
    }
});
