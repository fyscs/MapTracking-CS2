/** Item_Grav_RelayFx spawned (nested template): belongs to the grav of that team that was cast most recently. */
function grav_fx_spawned(caller, team) {
    if (!caller?.IsValid()) {
        return;
    }
    const gravs = materia_items.filter(m => m instanceof GravMateria && m.spec.team == team);
    const grav = gravs.reduce((best, m) => (!best || m.last_cast > best.last_cast) ? m : best, undefined);
    if (grav) {
        grav.fx_spawned(caller);
    }
    else {
        const particle = find_ent(caller.GetEntityName().replace("RelayFx", "GravParticle"));
        if (particle?.IsValid()) {
            materia_randomize_gravity_color(particle);
        }
    }
}
Instance.OnScriptInput("input_gravity", (stuff) => { grav_fx_spawned(stuff.caller, 3); });
Instance.OnScriptInput("input_gravity_zm", (stuff) => { grav_fx_spawned(stuff.caller, 2); });
Instance.OnScriptInput("input_gravity_effect", (stuff) => {
