// ---- model select hud (custom_hud_layout "hud_model_select", panorama/layout/custom_game/hud_model_select.xml) ----
const MODEL_HUD_NAME = "hud_model_select";
const MODEL_HUD_PANEL = "ModelSelect"; // the panel id that gets the Open / ShowZombie classes
// card button id -> card. ids match the <Button id="pick_..."> in the layout.
const MODEL_CARDS = {
    pick_militiasanta_t: { model: MODEL_MILITIASANTA, zombie: false, access: "anyone" },
    pick_militiaepstein: { model: MODEL_MILITIAEPSTEIN, zombie: false, access: "anyone" },
    pick_natalie_santagirl: { model: MODEL_NATALIE, zombie: false, access: "anyone" },
    pick_santa: { model: MODEL_SANTA, zombie: false, access: "anyone" },
    pick_guts: { model: MODEL_GUTS, zombie: false, access: "anyone" },
    pick_leona_heidern: { model: MODEL_LEONA, zombie: false, access: "friend" },
    pick_angel: { model: MODEL_ANGEL, zombie: false, access: "friend" },
    pick_yukari_takeba: { model: MODEL_YUKARI, zombie: false, access: "anyone" },
    pick_york: { model: MODEL_YORK, zombie: false, access: "anyone" },
    pick_james_sunderland: { model: MODEL_JAMES, zombie: false, access: "anyone" },
    pick_dante: { model: MODEL_DANTE, zombie: false, access: "anyone" },
    pick_eve_christmas: { model: MODEL_EVE, zombie: false, access: "mapper" },
    pick_yukino_noel_aux_fraises: { model: MODEL_YUKINO, zombie: false, access: "anyone" },
    pick_meg_soiree_doree: { model: MODEL_MEG, zombie: false, access: "anyone" },
    pick_nagisa_santa_xvv: { model: MODEL_NAGISA, zombie: false, access: "anyone" },
    pick_patty_reindeer_gift: { model: MODEL_PATTY, zombie: false, access: "anyone" },
    pick_reika_sweet_merry_night: { model: MODEL_REIKA, zombie: false, access: "anyone" },
    pick_shandy_merry_christmas_starlight: { model: MODEL_SHANDY, zombie: false, access: "anyone" },
    pick_tamaki_luminous_bell: { model: MODEL_TAMAKI, zombie: false, access: "anyone" },
    pick_shizuku_noel_charmant: { model: MODEL_SHIZUKU, zombie: false, access: "anyone" },
    pick_pyramid_head: { model: MODEL_PYRAMID_HEAD, zombie: true, access: "friend" },
    pick_xmas_gorefiend: { model: MODEL_GOREFIEND, zombie: true, access: "anyone" },
    pick_xmas_gorefast: { model: MODEL_GOREFAST, zombie: true, access: "anyone" },
};
// max players with the same human model saved as their pick (the default militia santa is never capped; mappers / friends ignore it)
const MODEL_MAX_PER_MODEL = 4;
function model_hud() {
    const hud = find_ent(MODEL_HUD_NAME);
    return hud?.IsValid() ? hud : undefined;
}
function card_for_model(model) {
    return Object.keys(MODEL_CARDS).find(id => MODEL_CARDS[id].model == model);
}
function card_allowed(player, card) {
    return card.access == "anyone" || player.mapper || (card.access == "friend" && player.friend);
}
/** How many connected players have each human model saved as their pick. Checked live, so leaving/switching frees a slot right away. */
function human_model_counts() {
    const counts = new Map();
    for (const controller of Instance.GetAllPlayerControllers()) {
        const pawn = controller?.IsValid() ? controller.GetPlayerPawn() : undefined;
        const pref = pawn?.IsValid() ? pawn.model_pref : undefined;
        if (pref) {
            counts.set(pref, (counts.get(pref) ?? 0) + 1);
        }
    }
    return counts;
}
/** Is this card full for `player`? Their own saved pick doesn't count against them. */
function card_full(player, card, counts = human_model_counts()) {
    if (card.zombie || card.model == MODEL_MILITIASANTA || player.mapper || player.friend) {
        return false;
    }
    const others = (counts.get(card.model) ?? 0) - (player.model_pref == card.model ? 1 : 0);
    return others >= MODEL_MAX_PER_MODEL;
}
/** Locked = not allowed for this player, Unavailable = allowed but full. Also puts SELECTED back on their saved picks. */
function refresh_model_cards(hud, slot, player) {
    const counts = human_model_counts();
    const selected = player.model_menu_pick
        ? [player.model_menu_pick]
        : [card_for_model(player.model_pref), card_for_model(player.zm_model_pref)];
    for (const id of Object.keys(MODEL_CARDS)) {
        const card = MODEL_CARDS[id];
        const locked = !card_allowed(player, card);
        hud.SetHasClassForPlayer(slot, id, "Locked", locked);
        hud.SetHasClassForPlayer(slot, id, "Unavailable", !locked && card_full(player, card, counts));
        hud.SetHasClassForPlayer(slot, id, "Selected", selected.includes(id));
    }
}
/** Someone's pick changed: update the cards for everyone who has the menu open. */
function refresh_open_model_menus() {
    const hud = model_hud();
    if (!hud) {
        return;
    }
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (!controller?.IsValid()) {
            continue;
        }
        const slot = controller.GetPlayerSlot();
        const pawn = controller.GetPlayerPawn();
        if (pawn?.IsValid() && hud.IsInputCaptureEnabled(slot)) {
            refresh_model_cards(hud, slot, pawn);
        }
    }
}
/** !modelmenu: show the hud for this player. Their current prefs are highlighted as SELECTED. */
function open_model_menu(controller) {
    const hud = model_hud();
    const player = controller.GetPlayerPawn();
    if (!hud || !player?.IsValid())
        return;
    const slot = controller.GetPlayerSlot();
    // typing it again while open closes it (escape hatch if the player is stuck in cursor mode)
    if (hud.IsInputCaptureEnabled(slot)) {
        close_model_menu(slot);
        return;
    }
    player.model_menu_pick = undefined;
    hud.ResetForPlayer(slot);
    refresh_model_cards(hud, slot, player);
    // open on the tab for the player's team
    hud.SetHasClassForPlayer(slot, MODEL_HUD_PANEL, "ShowZombie", player.GetTeamNumber() == 2);
    hud.SetHasClassForPlayer(slot, MODEL_HUD_PANEL, "Open", true);
    hud.SetInputCaptureEnabled(slot, true);
}
function close_model_menu(slot) {
    const hud = model_hud();
    if (hud) {
        // explicitly turn the classes off (a reset may leave the per-player Open override in place); open_model_menu resets the rest
        hud.SetHasClassForPlayer(slot, MODEL_HUD_PANEL, "Open", false);
        hud.SetHasClassForPlayer(slot, MODEL_HUD_PANEL, "ShowZombie", false);
    }
    // release the mouse on EVERY custom_hud_layout: movement only comes back once all of them have released input capture
    for (const layout of find_ents_by_class("custom_hud_layout")) {
        if (layout?.IsValid() && layout.IsInputCaptureEnabled(slot)) {
            layout.SetInputCaptureEnabled(slot, false);
            Console.Log("close_model_menu: released input capture on " + layout.GetEntityName() + " for slot " + slot);
        }
    }
}
/** Failsafe: close the model menu for every player (round end). */
function close_model_menu_all() {
    for (const controller of Instance.GetAllPlayerControllers()) {
        if (controller?.IsValid()) {
            close_model_menu(controller.GetPlayerSlot());
        }
    }
}
Instance.OnCustomHudClicked((event) => {
    const hud = model_hud();
    if (!hud || event.layout.GetEntityName() != MODEL_HUD_NAME)
        return;
    const controller = event.player;
    const player = controller?.GetPlayerPawn();
    if (!controller?.IsValid() || !player?.IsValid())
        return;
    const slot = controller.GetPlayerSlot();
    const id = event.buttonId;
    if (id == "tab_human" || id == "tab_zombie") {
        hud.SetHasClassForPlayer(slot, MODEL_HUD_PANEL, "ShowZombie", id == "tab_zombie");
    }
    else if (MODEL_CARDS[id]) {
        const card = MODEL_CARDS[id];
        // locked / full card: ignore the click (the button still fires server side), just make sure it shows why
        if (!card_allowed(player, card) || card_full(player, card)) {
            refresh_model_cards(hud, slot, player);
            return;
        }
        // move the SELECTED badge to the clicked card (the player's saved prefs stay until confirm)
        player.model_menu_pick = id;
        refresh_model_cards(hud, slot, player);
    }
    else if (id == "confirm") {
        const card = player.model_menu_pick ? MODEL_CARDS[player.model_menu_pick] : undefined;
        if (card && (!card_allowed(player, card) || card_full(player, card))) {
            // someone else took the last slot while this menu was open: keep it open showing the saved picks
            player.model_menu_pick = undefined;
            refresh_model_cards(hud, slot, player);
            return;
        }
        if (card) {
            if (card.zombie)
                player.zm_model_pref = card.model;
            else
                player.model_pref = card.model;
            // apply right away if it's the player's current side
            if (player.IsAlive() && ENABLE_MODELS && (player.GetTeamNumber() == 2) == card.zombie) {
                set_player_model(player, card.model);
            }
        }
        player.model_menu_pick = undefined;
        close_model_menu(slot);
        if (card) {
            refresh_open_model_menus();
        }
    }
});
// test: fill the DOA cards with bots, one bot every TEST_MAX_MODELS_STEP seconds, MODEL_MAX_PER_MODEL per card, then
// the next card. Same as a bot picking it on the hud + confirm, so open menus should flip cards to UNAVAILABLE live.
const TEST_MAX_MODELS_CARDS = [
    "pick_yukino_noel_aux_fraises", "pick_meg_soiree_doree", "pick_nagisa_santa_xvv", "pick_patty_reindeer_gift",
    "pick_reika_sweet_merry_night", "pick_shandy_merry_christmas_starlight", "pick_tamaki_luminous_bell", "pick_shizuku_noel_charmant",
];
const TEST_MAX_MODELS_STEP = 0.5;
Instance.OnScriptInput("input_test_max_models", () => {
    const bots = Instance.GetAllPlayerControllers()
        .filter(c => c?.IsValid() && c.IsBot())
        .map(c => c.GetPlayerPawn())
        .filter((p) => !!p?.IsValid());
    let card_i = 0;
    bots.forEach((bot, i) => {
        setTimeout(() => {
            if (!bot.IsValid()) {
                return;
            }
            // skip cards that are already full (counting everyone, not just bots)
            while (card_i < TEST_MAX_MODELS_CARDS.length && card_full(bot, MODEL_CARDS[TEST_MAX_MODELS_CARDS[card_i]])) {
                card_i++;
            }
            if (card_i >= TEST_MAX_MODELS_CARDS.length) {
                Console.Log("test_max_models: every DOA card is full");
                return;
            }
            const card = MODEL_CARDS[TEST_MAX_MODELS_CARDS[card_i]];
            bot.model_pref = card.model;
            if (bot.IsAlive() && ENABLE_MODELS && bot.GetTeamNumber() == 3) {
                set_player_model(bot, card.model);
            }
            Console.Log("test_max_models: " + bot.name + " -> " + TEST_MAX_MODELS_CARDS[card_i]);
            refresh_open_model_menus();
        }, i * TEST_MAX_MODELS_STEP * 1000);
    });
    Console.Log("test_max_models: " + bots.length + " bots");
});
// test: flip the activator's mapper + friend (vip) status together, so you can see the menu as a normal player.
// vip_filter re-tests on every spawn, so if the filter grants it you'll get it back next round.
Instance.OnScriptInput("input_toggle_vip", (stuff) => {
    const player = stuff.activator;
    if (!player?.IsValid()) {
        return;
    }
    const on = !(player.mapper || player.friend);
    player.mapper = on;
    player.friend = on;
    Console.Log("toggle_vip: " + player.name + " mapper/friend " + (on ? "ON" : "OFF"));
    refresh_open_model_menus();
});
Instance.OnPlayerReset((stuff) => {
    print("RESET");
    const player = stuff.player;
    if (!player?.IsValid()) {
        return;
    }
    // set name/slot/sfx_cd even for dead pawns so !text and !xmas never see undefined
    init_player_fields(player);
    if (!player.IsAlive()) {
        return;
    }
    ent_fire_name({ name: "vip_filter", input: "TestActivator", activator: player });
    {
        if (player.GetTeamNumber() == 3) {
            // humans wear whatever they picked (default militia santa until they pick one)
            set_player_model(player, human_model_for(player));
        }
        else if (player.GetTeamNumber() == 2) {
            set_player_model(player, zm_model_for(player));
        }
    }
    player.top_def_dmg = 0;
    player.vip = false;
    player.effect_immortal = false;
    player.buddy_prime = false;
    player.buddy = undefined;
    player.sfx_cd = 0;
    ent_fire_target({ target: player, input: "SetDamageFilter", value: "" });
    const controller = player.GetPlayerController();
    if (controller != undefined && controller.IsValid()) {
        player.SetEntityName("player_" + controller.GetPlayerSlot());
    }
    ensure_player_ents(player);
});
/** Fill in per-player fields that other code assumes exist (they start undefined on a fresh pawn). */
function init_player_fields(player) {
    if (player.sfx_cd == undefined) {
        player.sfx_cd = 0;
    }
    const controller = player.GetPlayerController();
    if (controller?.IsValid()) {
        player.name = controller.GetPlayerName().toLowerCase();
        player.slot = controller.GetPlayerSlot();
    }
}
/** (Re)spawn the player's text/sound entities if either is missing or was deleted (e.g. by a round restart). */
function ensure_player_ents(player) {
    if (player.sfx_ent?.IsValid() && player.text_ent?.IsValid()) {
        return;
    }
    // one survived but the other didn't: remove the survivor so we don't leave a duplicate behind
    if (player.sfx_ent?.IsValid()) {
        player.sfx_ent.Remove();
    }
    if (player.text_ent?.IsValid()) {
        player.text_ent.Remove();
    }
    player.sfx_ent = undefined;
    player.text_ent = undefined;
    const autsim_temp = find_ent("temp_player_text");
    if (!autsim_temp?.IsValid()) {
        return;
    }
    const ents = autsim_temp.ForceSpawn(player.GetAbsOrigin());
    for (const ent of ents ?? []) {
        if (ent?.IsValid() && ent.GetClassName() == "point_worldtext") {
            player.text_ent = ent;
        }
        if (ent?.IsValid() && ent.GetClassName() == "point_soundevent") {
            player.sfx_ent = ent;
        }
        if (ent?.IsValid() && ent.GetClassName() == "info_particle_system") {
            ent.SetParent(player);
        }
    }
}
function player_text_spam_fix() {
    const players = find_ents_by_class("player");
    for (const player of players) {
        if (!player?.IsValid()) {
            continue;
        }
        init_player_fields(player);
        ensure_player_ents(player);
    }
}
