Instance.OnScriptInput("input_vip", (stuff) => {
    const player = stuff.activator;
    if (player?.IsValid()) {
        player.friend = true;
    }
});
Instance.OnScriptInput("input_mapper", (stuff) => {
    const player = stuff.activator;
    if (player?.IsValid()) {
        player.mapper = true;
    }
});
Instance.OnScriptInput("input_mapper_remove", (stuff) => {
