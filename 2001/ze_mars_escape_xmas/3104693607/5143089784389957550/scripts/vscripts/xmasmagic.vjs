    { kind: "heal", item: "Item_Heal_", team: 3, input: "input_connect_heal" },
    { kind: "heal", item: "Item_Heal_ZM_", team: 2, input: "input_connect_heal_zm" },
    { kind: "ultima", item: "Item_Ultima_", team: 3, input: "input_connect_ultima" },
    { kind: "ultima", item: "Item_Ultima_ZM_", team: 2, input: "input_connect_ultima_zm" },
    { kind: "trolltima", item: "Item_Trolltima_CT_", team: 3, input: "input_connect_trolltima_ct" },
    { kind: "trolltima", item: "Item_Trolltima_ZM_", team: 2, input: "input_connect_trolltima_zm" },
