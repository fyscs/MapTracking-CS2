        ent_fire_name({ name: "Item_Random_Case", input: "PickRandom" });
        ent_fire_name({ name: "fade", input: "Fade" });
        ent_fire_name({ name: "ending_mako", input: "Enable" });
        ent_fire_name({ name: "CloudModel", input: "Enable" });
