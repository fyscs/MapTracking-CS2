let RAD_TP_INDEX = 0;
function RadiationTpHuman(player) {
    const dests = find_ents_by_name("radiation_des*");
    if (!player?.IsValid() || dests.length === 0)
        return;
    const dest = dests[RAD_TP_INDEX++ % dests.length]; // cycle = even spread
    ent_fire_target({ target: dest, input: "Teleport", activator: player });
    player.SetHealth(100);
}
function RadiationTpZombie(player) {
    const dests = find_ents_by_name("deadcore_zm_tp_0_dest");
    if (!player?.IsValid() || dests.length === 0)
        return;
    const dest = dests[Math.floor(Math.random() * dests.length)];
    player.Teleport({
        position: dest.GetAbsOrigin(),
        angles: dest.GetAbsAngles(),
        velocity: { x: 0, y: 0, z: 0 },
    });
}
