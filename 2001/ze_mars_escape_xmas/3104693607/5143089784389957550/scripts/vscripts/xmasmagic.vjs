const DDR_JUDGE_CLASS = { perfect: "Perfect", great: "Great", good: "Good", boo: "Boo", miss: "Miss" };
let ddr_song;
function ddr_hud() {
    const h = find_ent(DDR_HUD_NAME);
    return h?.IsValid() ? h : undefined;
}
function ddr_note_id(lane, slot) { return "n" + lane + "_" + slot; }
function ddr_set_all(id, cls, on) { ddr_hud()?.SetHasClass(id, cls, on); }
function ddr_set_for(slot, id, cls, on) { ddr_hud()?.SetHasClassForPlayer(slot, id, cls, on); }
function ddr_var_for(slot, name, value) { ddr_hud()?.SetDialogVariableStringForPlayer(slot, DDR_HUD_PANEL, name, value); }
function ddr_controller(slot) {
    for (const c of Instance.GetAllPlayerControllers()) {
        if (c?.IsValid() && c.GetPlayerSlot() == slot) {
            return c;
        }
    }
    return undefined;
}
const DDR_TP = "ddr_tp"; // trigger: humans -> ddr_dest_ct, zombies -> ddr_dest_zm
const DDR_DEST_CT = "ddr_dest_ct";
const DDR_DEST_ZM = "ddr_dest_zm";
const DDR_RESPAWN_TOGGLE = "input_zr_toggle_respawn"; // FireUser2 when the song ends
let ddr_tp_output;
/** ddr_tp touch: send the player to their team's destination (position + facing, no leftover speed). */
function ddr_teleport(player) {
    if (!player?.IsValid() || player.GetClassName() != "player" || !player.IsAlive()) {
        return;
    }
    const team = player.GetTeamNumber();
    const dest = team == 3 ? find_ent(DDR_DEST_CT) : team == 2 ? find_ent(DDR_DEST_ZM) : undefined;
    if (!dest?.IsValid()) {
        Console.Log("ddr: missing teleport destination for team " + team);
        return;
    }
    player.Teleport({ position: dest.GetAbsOrigin(), angles: dest.GetAbsAngles(), velocity: { x: 0, y: 0, z: 0 } });
}
/** DDR modifier: no mother zombies this round, hook + enable ddr_tp, song starts after DDR_START_DELAY. */
function ddr_mode_start() {
    Console.ServerCommand("zr_infect_min_count_req " + DDR_NO_MZ_MIN_COUNT);
    disconnect_output(ddr_tp_output);
    ddr_tp_output = undefined;
    const tp = find_ent(DDR_TP);
    if (tp?.IsValid()) {
        ddr_tp_output = connect_output(tp, "OnStartTouch", (stuff) => { ddr_teleport(stuff.activator); });
        ent_fire_target({ target: tp, input: "Enable", delay: ONE_TICK });
    }
    else {
        Console.Log("ddr: no " + DDR_TP);
    }
    setTimeout(() => { if (MODE == "DDR") {
        ddr_start_song();
    } }, DDR_START_DELAY * 1000);
}
/** Start the song for every living player. */
function ddr_start_song() {
    if (ddr_song) {
        ddr_stop_song();
    }
    const h = ddr_hud();
    if (!h) {
        Console.Log("ddr: no custom_hud_layout named " + DDR_HUD_NAME);
        return;
    }
    const notes = DDR_CHART.map(([t, lane, q, end]) => ({ t, lane, q, end: end ?? -1, slot: -1 }));
    const laneNotes = [[], [], [], []];
    for (const n of notes) {
        laneNotes[n.lane].push(n);
    }
    let last = 0;
    for (const n of notes) {
        last = Math.max(last, n.t, n.end);
    }
    const song = {
        start: Instance.GetGameTime(), notes, laneNotes, last, next: 0,
        ring: [0, 0, 0, 0],
        busy: [...Array(DDR_LANES)].map(() => Array(DDR_POOL).fill(-99)),
        owner: [...Array(DDR_LANES)].map(() => Array(DDR_POOL).fill(undefined)),
        slotQ: [...Array(DDR_LANES)].map(() => Array(DDR_POOL).fill(0)),
        releases: [],
        players: new Map(),
        stage: "",
        ended: false,
    };
    ddr_song = song;
    for (const c of Instance.GetAllPlayerControllers()) {
        const pawn = c?.IsValid() ? c.GetPlayerPawn() : undefined;
        if (pawn?.IsValid() && pawn.IsAlive()) {
            song.players.set(c.GetPlayerSlot(), ddr_new_player(c.GetPlayerSlot()));
        }
    }
    h.SetDialogVariableString(DDR_HUD_PANEL, "ddr_title", DDR_SONG_TITLE);
    for (const p of song.players.values()) {
        h.ResetForPlayer(p.slot);
        ddr_set_for(p.slot, DDR_HUD_PANEL, "Show", true);
        ddr_var_for(p.slot, "ddr_score", "0");
        ddr_set_life_class(p, true);
    }
    ent_fire_name({ name: DDR_MUSIC_ENT, input: "StartSound" });
    Console.Log("ddr: started with " + notes.length + " notes for " + song.players.size + " player(s)");
}
function ddr_new_player(slot) {
    return {
        slot, life: DDR_LIFE.start, combo: 0, maxCombo: 0, score: 0, failed: false,
        counts: { perfect: 0, great: 0, good: 0, boo: 0, miss: 0, ok: 0, ng: 0 },
        next: [0, 0, 0, 0], pressed: [false, false, false, false], flashOff: [0, 0, 0, 0],
        holds: [], gone: new Set(),
        digits: [-1, -1, -1], comboOn: false,
        judge: "", flip: false, judgeHideAt: 0,
        lifeStep: -1, danger: false,
    };
}
/** Hide one player's DDR hud (failed / died / left). */
function ddr_hide_for(slot) {
    ddr_set_for(slot, DDR_HUD_PANEL, "Show", false);
    ddr_hud()?.ResetForPlayer(slot);
}
/** Stop the music and hide the hud for everyone (round start / end, song over). Safe to call any time. */
function ddr_stop_song() {
    ent_fire_name({ name: DDR_MUSIC_ENT, input: "StopSound" });
    const song = ddr_song;
    ddr_song = undefined;
    if (!song) {
        return;
    }
    for (let l = 0; l < DDR_LANES; l++) {
        for (let k = 0; k < DDR_POOL; k++) {
            ddr_set_all(ddr_note_id(l, k), "Fly", false);
        }
    }
    for (const b of ["ShowReady", "ShowHerewego"]) {
        ddr_set_all(DDR_HUD_PANEL, b, false);
    }
    for (const p of song.players.values()) {
        ddr_hide_for(p.slot);
    }
}
function ddr_spawn(song, n) {
    const lane = n.lane;
    const k = song.ring[lane];
    const songT = n.t - DDR_NOTE_REACH_TIME;
    if (song.busy[lane][k] > songT) {
        n.slot = -1;
        return;
    } // pool exhausted: still judged, just not drawn
    song.ring[lane] = (k + 1) % DDR_POOL;
    n.slot = k;
    song.owner[lane][k] = n;
    // flies up, then after release slides back down (invisible) before the panel can be reused
    song.busy[lane][k] = songT + DDR_NOTE_FLY_TIME * 2 + 0.1;
    const id = ddr_note_id(lane, k);
    if (song.slotQ[lane][k] != n.q) {
        for (const q of [4, 8, 16]) {
            ddr_set_all(id, "Q" + q, q == n.q);
        }
        song.slotQ[lane][k] = n.q;
    }
    for (const p of song.players.values()) {
        if (p.gone.has(id)) {
            ddr_set_for(p.slot, id, "Gone", false);
            p.gone.delete(id);
        }
    }
    ddr_set_all(id, "Fly", true);
    song.releases.push({ lane, k, at: songT + DDR_NOTE_FLY_TIME + 0.02, note: n });
}
function ddr_hide_note_for(song, p, n) {
    if (n.slot < 0 || song.owner[n.lane][n.slot] !== n) {
        return;
    }
    const id = ddr_note_id(n.lane, n.slot);
    ddr_set_for(p.slot, id, "Gone", true);
    p.gone.add(id);
}
function ddr_set_life_class(p, force) {
    const step = Math.max(0, Math.min(20, Math.round(p.life / 5)));
    if (force || step != p.lifeStep) {
        if (p.lifeStep >= 0) {
            ddr_set_for(p.slot, "Life", "Life" + p.lifeStep, false);
        }
        ddr_set_for(p.slot, "Life", "Life10", step == 10);
        ddr_set_for(p.slot, "Life", "Life" + step, true);
        p.lifeStep = step;
    }
    const danger = p.life <= 20 && !p.failed;
    if (force || danger != p.danger) {
        ddr_set_for(p.slot, "Life", "Danger", danger);
        ddr_set_for(p.slot, DDR_HUD_PANEL, "ShowDanger", danger);
        p.danger = danger;
    }
}
function ddr_show_combo(p) {
    const on = p.combo >= 4;
    if (on != p.comboOn) {
        ddr_set_for(p.slot, "Combo", "On", on);
        p.comboOn = on;
    }
    if (!on) {
        return;
    }
    const c = Math.min(p.combo, 999);
    const ds = [Math.floor(c / 100), Math.floor(c / 10) % 10, c % 10];
    for (let i = 0; i < 3; i++) {
        const blank = (i == 0 && c < 100) || (i == 1 && c < 10);
        const d = blank ? -1 : ds[i];
        if (d == p.digits[i]) {
            continue;
        }
        if (p.digits[i] >= 0) {
            ddr_set_for(p.slot, "c" + i, "D" + p.digits[i], false);
        }
        if (d >= 0) {
            ddr_set_for(p.slot, "c" + i, "D" + d, true);
        }
        p.digits[i] = d;
    }
}
function ddr_judge(song, p, j, n, t) {
    p.counts[j]++;
    p.score += DDR_SCORE[j];
    p.life = Math.max(0, Math.min(100, p.life + DDR_LIFE[j]));
    if (j == "perfect" || j == "great") {
        p.combo++;
    }
    else {
        p.combo = 0;
    }
    p.maxCombo = Math.max(p.maxCombo, p.combo);
    // judgement image: one class at a time + alternate PopA/PopB so the pop animation restarts
    if (p.judge != j) {
        if (p.judge) {
            ddr_set_for(p.slot, "Judge", DDR_JUDGE_CLASS[p.judge], false);
        }
        ddr_set_for(p.slot, "Judge", DDR_JUDGE_CLASS[j], true);
        p.judge = j;
    }
    p.flip = !p.flip;
    ddr_set_for(p.slot, "Judge", "PopA", p.flip);
    ddr_set_for(p.slot, "Judge", "PopB", !p.flip);
    ddr_set_for(p.slot, "Judge", "Hide", false);
    p.judgeHideAt = t + 0.8;
    ddr_show_combo(p);
    ddr_set_life_class(p, false);
    ddr_var_for(p.slot, "ddr_score", String(p.score));
    if (j != "miss" && n) {
        ddr_hide_note_for(song, p, n);
        ddr_set_for(p.slot, "r" + n.lane, "Flash", true);
        p.flashOff[n.lane] = t + 0.07;
        if (n.end > 0) {
            p.holds.push({ note: n, lastHeld: t });
        }
    }
    if (p.life <= 0 && !p.failed) {
        ddr_fail(p);
    }
}
/** Life ran out: FAILED banner, kill them, hide their hud a moment later. */
function ddr_fail(p) {
    p.failed = true;
    p.holds = [];
    ddr_set_for(p.slot, DDR_HUD_PANEL, "ShowFailed", true);
    ddr_set_for(p.slot, DDR_HUD_PANEL, "ShowDanger", false);
    const pawn = ddr_controller(p.slot)?.GetPlayerPawn();
    if (pawn?.IsValid() && pawn.IsAlive()) {
        ent_fire_target({ target: pawn, input: "SetHealth", value: 0 });
    }
    const song = ddr_song;
    setTimeout(() => {
        if (!song || ddr_song !== song) {
            return;
        } // song already stopped = hud already hidden
        song.players.delete(p.slot);
        ddr_hide_for(p.slot);
    }, DDR_FAIL_HUD_TIME * 1000);
}
function ddr_grade(diff) {
    const a = Math.abs(diff);
    if (a <= DDR_WIN.perfect) {
        return "perfect";
    }
    if (a <= DDR_WIN.great) {
        return "great";
    }
    if (a <= DDR_WIN.good) {
        return "good";
    }
    return "boo";
}
function ddr_tick_player(song, p, pawn, songT) {
    const jt = songT - DDR_JUDGE_LATENCY; // when the player actually hit the key, in song time
    for (let lane = 0; lane < DDR_LANES; lane++) {
        if (p.flashOff[lane] && songT >= p.flashOff[lane]) {
            ddr_set_for(p.slot, "r" + lane, "Flash", false);
            p.flashOff[lane] = 0;
        }
        if (p.failed) {
            continue;
        }
        const held = pawn.IsInputPressed(DDR_LANE_INPUT[lane]);
        if (held != p.pressed[lane]) {
            ddr_set_for(p.slot, "r" + lane, "Pressed", held);
            p.pressed[lane] = held;
        }
        const list = song.laneNotes[lane];
        // misses: notes whose window has fully passed
        while (p.next[lane] < list.length && jt > list[p.next[lane]].t + DDR_WIN.boo) {
            ddr_judge(song, p, "miss", list[p.next[lane]], songT);
            p.next[lane]++;
            if (p.failed) {
                break;
            }
        }
        if (p.failed) {
            continue;
        }
        if (pawn.WasInputJustPressed(DDR_LANE_INPUT[lane]) && p.next[lane] < list.length) {
            const n = list[p.next[lane]];
            const diff = jt - n.t;
            if (diff >= -0.18) { // too early: ignore the press, the note is still coming
                ddr_judge(song, p, ddr_grade(diff), n, songT);
                p.next[lane]++;
            }
        }
    }
    // freezes: keep the key down until the end
    if (!p.failed) {
        p.holds = p.holds.filter(h => {
            if (pawn.IsInputPressed(DDR_LANE_INPUT[h.note.lane])) {
                h.lastHeld = jt;
            }
            if (jt >= h.note.end) {
                p.counts.ok++;
                return false;
            }
            if (jt - h.lastHeld > DDR_HOLD_GRACE) {
                p.counts.ng++;
                p.life = Math.max(0, p.life + DDR_LIFE.ng);
                ddr_set_life_class(p, false);
                if (p.life <= 0 && !p.failed) {
                    ddr_fail(p);
                }
                return false;
            }
            return true;
        });
    }
    if (p.judge && p.judgeHideAt && songT >= p.judgeHideAt) {
        ddr_set_for(p.slot, "Judge", "Hide", true);
        p.judgeHideAt = 0;
    }
}
function ddr_set_stage(song, stage) {
    if (song.stage == stage) {
        return;
    }
    const banner = { ready: "ShowReady", go: "ShowHerewego" };
    if (banner[song.stage]) {
        ddr_set_all(DDR_HUD_PANEL, banner[song.stage], false);
    }
    if (banner[stage]) {
        ddr_set_all(DDR_HUD_PANEL, banner[stage], true);
    }
    song.stage = stage;
}
/** Every tick from the map think. */
function ddr_tick() {
    const song = ddr_song;
    if (!song) {
        return;
    }
    const songT = Instance.GetGameTime() - song.start - DDR_AUDIO_LEAD;
    if (songT < 2.2) {
        ddr_set_stage(song, "ready");
    }
    else if (songT < 4.4) {
        ddr_set_stage(song, "go");
    }
    else {
        ddr_set_stage(song, "");
    }
    // spawn notes that need to start scrolling
    while (song.next < song.notes.length && song.notes[song.next].t - DDR_NOTE_REACH_TIME <= songT) {
        ddr_spawn(song, song.notes[song.next]);
        song.next++;
    }
    // recycle panels that have scrolled off the top
    if (song.releases.length && song.releases[0].at <= songT) {
        song.releases = song.releases.filter(r => {
            if (r.at > songT) {
                return true;
            }
            if (song.owner[r.lane][r.k] === r.note) {
                ddr_set_all(ddr_note_id(r.lane, r.k), "Fly", false);
                song.owner[r.lane][r.k] = undefined;
            }
            return false;
        });
    }
    // players: anyone who left or died some other way drops out
    for (const p of [...song.players.values()]) {
        const pawn = ddr_controller(p.slot)?.GetPlayerPawn();
        if (!pawn?.IsValid() || (!pawn.IsAlive() && !p.failed)) {
            song.players.delete(p.slot);
            ddr_hide_for(p.slot);
            continue;
        }
        ddr_tick_player(song, p, pawn, songT);
    }
    // end of song: one summary line instead of one per player
    if (!song.ended && songT > song.last + 1.0) {
        song.ended = true;
        ent_fire_name({ name: DDR_RESPAWN_TOGGLE, input: "FireUser2" });
        FunctionDelay(kill_all, 1, 2);
        let cleared = 0;
        let best;
        for (const p of song.players.values()) {
            if (p.failed) {
                continue;
            }
            cleared++;
            ddr_set_for(p.slot, DDR_HUD_PANEL, "ShowCleared", true);
            if (!best || p.score > best.score) {
                best = p;
            }
        }
        const best_name = best ? (ddr_controller(best.slot)?.GetPlayerName() ?? "?") : "";
        ent_fire_name({ name: "command", input: "Command", value: "say [DDR] " + cleared + " cleared" +
                (best ? " - top score: " + best_name + " " + best.score + " (max combo " + best.maxCombo + ")" : "") });
    }
    if (song.ended && songT > song.last + 6.0) {
        ddr_stop_song();
    }
}
// ---------------------------------------------------------------- Gris ZM items
// knife_itemN = the c4, ui_itemN = game_ui, connect_itemN fires input_connect_itemN.
// Same pickup lock as materia: the map spawns the c4 locked, connect unlocks it, pickup locks it (nobody can swap it
// off the holder), and the drop check unlocks it again once nobody owns it.
const GRIS_ZM_ITEM_TICK = 0.5;
class GrisZMItem {
    n; // item number: 1, 2 or 3
    player; // current holder, undefined when on the ground
    wep; // knife_itemN (the c4)
    ui; // ui_itemN (game_ui)
    pickup_output;
    drop_interval;
    constructor(n) {
        this.n = n;
    }
    /** input_connect_itemN (every round the level spawns them): grab the ents, hook the pickup, unlock the c4. */
    connect() {
        // last round's state is stale (clearTasks already killed the old interval)
        disconnect_output(this.pickup_output);
        this.pickup_output = undefined;
        this.drop_interval = undefined;
        this.player = undefined;
        this.wep = find_ent("knife_item" + this.n);
        this.ui = find_ent("ui_item" + this.n);
        if (!this.wep?.IsValid() || !this.ui?.IsValid()) {
            Console.Log("GrisZMItem " + this.n + ": missing knife_item" + this.n + " or ui_item" + this.n);
            return;
        }
        this.pickup_output = connect_output(this.wep, "OnPlayerPickup", (stuff) => { this.on_pickup(stuff.activator); });
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
    }
    held() {
        if (!this.wep?.IsValid() || !this.player?.IsValid()) {
            return false;
        }
        const owner = this.wep.GetOwner();
        return !!owner?.IsValid() && same_player(owner, this.player);
    }
    on_pickup(player) {
        if (!player?.IsValid() || !this.wep?.IsValid()) {
            return;
        }
        this.player = player;
        ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
        if (this.ui?.IsValid()) {
            ent_fire_target({ target: this.ui, input: "Activate", activator: player });
        }
        this.stop_interval();
        this.drop_interval = setInterval(() => {
            if (this.held() && !CLEAR_ALL_INTERVAL) {
                return;
            }
            this.on_drop();
        }, GRIS_ZM_ITEM_TICK * 1000);
    }
    on_drop() {
        this.stop_interval();
        if (this.ui?.IsValid() && this.player?.IsValid()) {
            ent_fire_target({ target: this.ui, input: "Deactivate", activator: this.player });
        }
        this.player = undefined;
        if (this.wep?.IsValid()) {
            ent_fire_target({ target: this.wep, input: "ToggleCanBePickedUp" });
        }
    }
    stop_interval() {
        if (this.drop_interval !== undefined) {
            clearInterval(this.drop_interval);
            this.drop_interval = undefined;
        }
    }
}
const GRIS_ZM_ITEMS = [1, 2, 3].map(n => new GrisZMItem(n));
for (const item of GRIS_ZM_ITEMS) {
    Instance.OnScriptInput("input_connect_item" + item.n, () => { item.connect(); });
}
