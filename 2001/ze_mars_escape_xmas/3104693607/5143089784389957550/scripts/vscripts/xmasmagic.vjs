            return;
        }
        connect_output(this.wep, "OnPlayerPickup", (stuff) => { this.on_pickup(stuff.activator); });
        connect_output(this.button, "OnPressed", (stuff) => { this.on_press(stuff.activator); });
        this.relays.forEach((relay, i) => {
            connect_output(relay, "OnTrigger", (stuff) => { this.on_cast(i + 1, stuff.activator); });
        });
        if (this.relays.length == 3) {
            const relay = this.relays[Math.min(Math.max(MATERIA_LEVEL, 1), 3) - 1];
            ent_fire_target({ target: relay, input: "Enable" });
        }
