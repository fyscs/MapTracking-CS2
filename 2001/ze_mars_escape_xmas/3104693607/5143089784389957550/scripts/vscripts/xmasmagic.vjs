// DOA models (used by !genderswapall and the precache list)
const DOA_MODELS = [
    ["meg", MODEL_MEG], ["nagisa", MODEL_NAGISA], ["patty", MODEL_PATTY], ["reika", MODEL_REIKA],
    ["shandy", MODEL_SHANDY], ["shizuku", MODEL_SHIZUKU], ["tamaki", MODEL_TAMAKI], ["yukino", MODEL_YUKINO],
];
// SetModel on a model that isn't precached/loaded can crash the server, so load them all up front.
const ALL_PLAYER_MODELS = [
    MODEL_SANTA, MODEL_NATALIE, MODEL_MILITIASANTA, MODEL_MILITIAEPSTEIN, MODEL_GUTS, MODEL_LEONA, MODEL_GOREFAST,
    ...DOA_MODELS.map(m => m[1]),
    MODEL_GOREFIEND,
    MODEL_ANGEL, MODEL_YUKARI, MODEL_YORK, MODEL_JAMES, MODEL_DANTE, MODEL_EVE, MODEL_PYRAMID_HEAD,
];
const MODEL_PRECACHE = Instance.Precache({ resources: ALL_PLAYER_MODELS });
/** Set a player's model (twice, like before), but only once the models have finished loading. */
function set_player_model(player, model) {
    print("SETTING A MODEL");
    if (MODEL_PRECACHE && !MODEL_PRECACHE.IsServerLoaded()) {
        Console.Log("set_player_model: models still loading, skipped " + model);
        return;
    }
    FunctionDelay(() => {
        if (!player?.IsAlive()) {
            return;
        }
        player.SetModel(model);
    }, 0.1);
}
function FunctionDelay(func, delay, ...args) {
    const id_round = GameRules.GetRoundsPlayed();
    const id_time = GameRules.GetRoundRemainingTime();
    Instance.Delay(delay).then(() => {
        if (id_round != GameRules.GetRoundsPlayed() || id_time < GameRules.GetRoundRemainingTime()) {
            print(`CANCELLED: ${func}`);
            return;
        }
        else {
            print(`RAN: ${func}`);
            func(...args);
        }
    });
}
// zombies without a pick get one of these at random (pyramid head is menu-only, friends/mapper)
const zm_models = [
    MODEL_GOREFIEND,
    MODEL_GOREFAST
];
/** The player's saved pick, as long as they're still allowed to use it. */
function allowed_pref(player, pref) {
    const card = card_for_model(pref);
    return card && card_allowed(player, MODEL_CARDS[card]) ? pref : undefined;
}
/** Human model: the player's saved pick (model menu), otherwise militia santa. */
function human_model_for(player) {
    return allowed_pref(player, player.model_pref) ?? MODEL_MILITIASANTA;
}
/** Zombie model: the player's saved pick (model menu), otherwise one of the two zombie models at random. */
function zm_model_for(player) {
    drop_fumos(player); // zombies don't get to keep fumos
    return allowed_pref(player, player.zm_model_pref) ?? zm_models[randomIntArray(0, zm_models.length)];
}
Instance.OnScriptInput("input_test_zm_gorefast", (stuff) => {
