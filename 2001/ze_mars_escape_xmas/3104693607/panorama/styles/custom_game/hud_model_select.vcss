/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.Menu {
    width: 100%;
    height: 100%;
    background-color: #000000b0;
    visibility: collapse;
}
.Menu.Open {
    visibility: visible;
}
.Window {
    width: 1820px;
    height: 960px;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 45px;
    flow-children: down;
    background-color: #120a0aee;
    border: 3px solid #c8202a;
    border-radius: 16px;
    box-shadow: #c8202a80 0px 0px 30px 0px;
    padding: 20px;
}
.Tabs {
    z-index: 1;
    horizontal-align: center;
    flow-children: right;
    margin-bottom: 18px;
}
.Tab {
    width: 300px;
    height: 56px;
    margin: 0px 10px;
    border-radius: 8px;
    border: 2px solid #ffffff30;
    background-color: #2a1c1c;
    transition-property: background-color, border, pre-transform-scale2d;
    transition-duration: 0.12s;
}
.Tab Label {
    horizontal-align: center;
    vertical-align: center;
    font-size: 26px;
    font-weight: bold;
    color: #bbbbbb;
}
.Tab:hover {
    pre-transform-scale2d: 1.05;
    border: 2px solid #ffd700;
}
.Menu .TabHuman,.Menu.ShowZombie .TabZombie {
    background-color: #c8202a;
    border: 2px solid #ffffff;
}
.Menu .TabHuman Label,.Menu.ShowZombie .TabZombie Label {
    color: #ffffff;
}
.Menu.ShowZombie .TabHuman {
    background-color: #2a1c1c;
    border: 2px solid #ffffff30;
}
.Menu.ShowZombie .TabHuman Label {
    color: #bbbbbb;
}
.Menu.ShowZombie .TabZombie {
    background-color: #1f7a2e;
}
.Grid {
    overflow: noclip;
    height: fit-children;
    z-index: 5;
    width: 1780px;
    horizontal-align: center;
    flow-children: right-wrap;
}
.ZombieGrid {
    visibility: collapse;
    flow-children: right;
    width: fit-children;
}
.Menu.ShowZombie .HumanGrid {
    visibility: collapse;
}
.Menu.ShowZombie .ZombieGrid {
    visibility: visible;
}
.CardRow {
    overflow: noclip;
    width: fit-children;
    horizontal-align: center;
    flow-children: right;
    z-index: 1;
}
.CardRow:hover {
    z-index: 10;
}
.HumanGrid {
    flow-children: down;
}
.Card {
    width: 224px;
    height: 366px;
    margin: 8px;
    border-radius: 10px;
    border: 3px solid #ffffff25;
    background-color: #1e1414;
    flow-children: down;
    overflow: clip;
    z-index: 1;
    transition-property: pre-transform-scale2d, border, background-color, box-shadow;
    transition-duration: 0.12s;
}
.Card.Big {
    width: 340px;
    height: 530px;
    margin: 20px 30px;
}
.CardImg {
    width: 232px;
    height: 308px;
    horizontal-align: center;
    border-radius: 8px 8px 0px 0px;
    transition-property: wash-color;
    transition-duration: 0.12s;
}
.Big .CardImg {
    width: 100%;
    height: 440px;
}
.CardName {
    horizontal-align: center;
    text-align: center;
    width: 100%;
    height: 26px;
    margin-top: 4px;
    font-size: 18px;
    text-overflow: shrink;
    font-weight: bold;
    color: #ffffff;
}
.CardBadge {
    horizontal-align: center;
    margin-top: 2px;
    padding: 2px 10px;
    border-radius: 6px;
    background-color: #2bd157;
    color: #08200f;
    font-size: 16px;
    font-weight: bold;
    visibility: collapse;
}
.CardAvail {
    horizontal-align: center;
    margin-top: 2px;
    padding: 2px 10px;
    border-radius: 6px;
    background-color: #3a2c2c;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    visibility: collapse;
}
.Card.Capped .CardAvail {
    visibility: visible;
}
.Card.Selected .CardAvail,.Card.Locked .CardAvail,.Card.Unavailable .CardAvail {
    visibility: collapse;
}
.Card:hover {
    pre-transform-scale2d: 1.1;
    border: 3px solid #ffd700;
    box-shadow: #ffd70090 0px 0px 18px 0px;
    z-index: 10;
}
.Card:active,.Card.Clicked {
    pre-transform-scale2d: 0.94;
    background-color: #ffffff;
}
.Card.Clicked .CardImg {
    wash-color: #ffffffa0;
}
.Card.Selected {
    border: 3px solid #2bd157;
    box-shadow: #2bd157a0 0px 0px 22px 0px;
}
.Card.Selected .CardBadge {
    visibility: visible;
}
.Confirm {
    width: 320px;
    height: 64px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-top: 10px;
    border-radius: 10px;
    background-color: #1f7a2e;
    border: 2px solid #ffffff;
    transition-property: pre-transform-scale2d, background-color;
    transition-duration: 0.12s;
}
.Confirm Label {
    horizontal-align: center;
    vertical-align: center;
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 3px;
}
.Confirm:hover {
    pre-transform-scale2d: 1.08;
    background-color: #2bd157;
}
.Confirm:active {
    pre-transform-scale2d: 0.95;
}
.CardLock,.CardFull {
    horizontal-align: center;
    margin-top: 2px;
    padding: 3px 8px;
    border-radius: 6px;
    background-color: #000000d0;
    border: 2px solid #c8202a;
    color: #ff4a4a;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
    visibility: collapse;
}
.Card.Locked .CardLock,.Card.Unavailable .CardFull {
    visibility: visible;
}
.Card.Locked .CardImg,.Card.Unavailable .CardImg {
    wash-color: #000000c0;
}
.Card.Locked .CardName,.Card.Unavailable .CardName {
    color: #777777;
}
.Card.Locked,.Card.Locked:hover,.Card.Locked:active,.Card.Unavailable,.Card.Unavailable:hover,.Card.Unavailable:active {
    pre-transform-scale2d: 1;
    border: 3px solid #ffffff15;
    box-shadow: none;
    background-color: #1e1414;
}
.Card.Locked .CardBadge,.Card.Unavailable .CardBadge {
    visibility: collapse;
}
.Tab:hover Label,.Card:hover .CardName,.Confirm:hover Label {
    sound: "xmas.sfx.modelmenu.hover";
}
.Tab:active Label,.Card:active .CardName {
    sound: "xmas.sfx.modelmenu.select";
}
.Confirm:active Label {
    sound: "xmas.sfx.modelmenu.confirm";
}
