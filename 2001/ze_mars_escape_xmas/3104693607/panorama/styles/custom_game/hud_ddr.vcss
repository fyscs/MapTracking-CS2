    width: 277px;
}
.Life14 .LifeFill {
    width: 298px;
}
.Life15 .LifeFill {
    width: 320px;
}
.Life16 .LifeFill {
    width: 341px;
}
.Life17 .LifeFill {
    width: 362px;
}
.Life18 .LifeFill {
    width: 383px;
}
.Life19 .LifeFill {
