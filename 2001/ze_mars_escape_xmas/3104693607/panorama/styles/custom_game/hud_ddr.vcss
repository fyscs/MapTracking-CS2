@keyframes 'DdrBlink' {
    0% {
        opacity: 1;
    }
50% {
        opacity: 0.15;
    }
100% {
        opacity: 1;
    }
}
.DDR.ShowDanger .B_danger {
    y: 600px;
    animation-name: DdrBlink;
    animation-duration: 0.5s;
    animation-iteration-count: infinite;
}
.Info {
    width: 100%;
    height: 90px;
    vertical-align: bottom;
    margin-bottom: 120px;
    flow-children: down;
}
.SongTitle {
