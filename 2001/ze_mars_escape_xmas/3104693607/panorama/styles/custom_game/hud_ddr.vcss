.Root {
    width: 100%;
    height: 100%;
}
.DDR {
    width: 100%;
    height: 100%;
    opacity: 0;
}
.DDR.Show {
    opacity: 1;
}
.Field {
    width: 448px;
    height: 100%;
    horizontal-align: center;
}
.FieldBg {
    width: 100%;
    height: 100%;
    background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b0 ), to( #00000070 ) );
}
.LifeBar {
    width: 440px;
    height: 52px;
    y: 14px;
    horizontal-align: center;
}
.LifeFill {
    x: 7px;
    y: 7px;
    height: 31px;
    width: 0px;
    background-color: gradient( linear, 0% 0%, 0% 100%, from( #fff27a ), to( #ff9b1a ) );
}
.LifeFrame {
    width: 440px;
    height: 52px;
}
.LifeBar.Danger .LifeFill {
    background-color: gradient( linear, 0% 0%, 0% 100%, from( #ff6060 ), to( #b00000 ) );
}
.Life0 .LifeFill {
    width: 0px;
}
.Life1 .LifeFill {
    width: 21px;
}
.Life2 .LifeFill {
    width: 43px;
}
.Life3 .LifeFill {
    width: 64px;
}
