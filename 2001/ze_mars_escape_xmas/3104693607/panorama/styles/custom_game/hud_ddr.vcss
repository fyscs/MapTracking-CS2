}
.Lane {
    width: 112px;
    height: 100%;
}
.Lane0 {
    x: 0px;
}
.Lane1 {
    x: 112px;
}
.Lane2 {
    x: 224px;
}
.Lane3 {
    x: 336px;
}
.Receptor {
    width: 96px;
    height: 102px;
    x: 8px;
    y: 100px;
}
.Receptor Image {
    width: 96px;
    height: 102px;
}
.RecPressed,.RecFlash {
    opacity: 0;
}
.Receptor.Pressed .RecPressed {
    opacity: 1;
}
.Receptor.Flash .RecFlash {
    opacity: 1;
}
.RecFlash {
    transition-property: opacity;
    transition-duration: 0.12s;
}
.Receptor.Flash .RecFlash {
    transition-duration: 0s;
}
.Note {
    width: 96px;
    height: 102px;
    x: 8px;
    y: 100px;
    opacity: 0;
    transform: translateY( 960px );
    transition-property: transform;
    transition-duration: 1.1477s;
    transition-timing-function: linear;
}
.Note.Fly {
    opacity: 1;
    transform: translateY( -170px );
    transition-property: transform;
    transition-duration: 1.1477s;
    transition-timing-function: linear;
}
.Note.Gone {
    opacity: 0;
}
.NoteImg {
    width: 96px;
    height: 102px;
    opacity: 0;
}
.Note.Q4 .N4 {
    opacity: 1;
}
.Note.Q8 .N8 {
    opacity: 1;
}
.Note.Q16 .N16 {
    opacity: 1;
}
.Judge {
    width: 100%;
    height: 60px;
    y: 420px;
}
.JImg {
    horizontal-align: center;
    vertical-align: center;
    opacity: 0;
}
.J_perfect {
    width: 270px;
    height: 48px;
}
.Judge.Perfect .J_perfect {
    opacity: 1;
}
.J_great {
    width: 192px;
    height: 48px;
}
.Judge.Great .J_great {
    opacity: 1;
}
.J_good {
    width: 150px;
    height: 48px;
}
.Judge.Good .J_good {
    opacity: 1;
}
.J_boo {
    width: 120px;
    height: 42px;
}
.Judge.Boo .J_boo {
    opacity: 1;
}
.J_miss {
    width: 120px;
    height: 36px;
}
.Judge.Miss .J_miss {
    opacity: 1;
}
@keyframes 'DdrPopA' {
    0% {
        pre-transform-scale2d: 1.25;
    }
100% {
        pre-transform-scale2d: 1;
    }
}
@keyframes 'DdrPopB' {
    0% {
        pre-transform-scale2d: 1.25;
    }
100% {
        pre-transform-scale2d: 1;
    }
}
.Judge.PopA {
    animation-name: DdrPopA;
    animation-duration: 0.08s;
    animation-timing-function: ease-out;
}
.Judge.PopB {
    animation-name: DdrPopB;
    animation-duration: 0.08s;
    animation-timing-function: ease-out;
}
.Judge.Hide .JImg {
    opacity: 0;
}
