function GlobalColorRgb() { return GlobalColorVal; }

function SetGlobalColor(key) {
	const k = String(key === undefined || key === null ? "" : key).toUpperCase();

	if (!COLOR[k]) {
		return false;
	}

	const val = ParseColor(COLOR[k]);
	const next = RgbClass(val);
	if (next === GlobalColorClass)
		return true;

	const old = GlobalColorClass;
	GlobalColorKey = k;
	GlobalColorVal = val;
	GlobalColorClass = next;

	const l = GetLayout(true);

	if (l) {

		for (const slot of slots) {
			if (slot.state !== "busy" || !slot.env || !slot.env.color)
				continue;
			SwapClass(l, slot.label, slot.env.color, next);
			slot.env.color = next;
		}

		for (let i = 0; i < MAX_CELLS; i++) {
			const e = cellEnv[i];
			if (!e || !e.lit || e.color !== old)
				continue;
			SwapClass(l, CellId(i), old, next);
			e.color = next;
		}

		if (lyricEnv.busy && lyricEnv.color) {
			SwapClass(l, LYRIC_BOX_ID, lyricEnv.color, next);
			lyricEnv.color = next;
		}
		if (lyricEnv.busy && lyricEnv.translationColor) {
			SwapClass(l, LYRIC_TRANSLATION_ID, lyricEnv.translationColor, next);
			lyricEnv.translationColor = next;
		}
	}

	return true;
}

