			{ t: "The blood red moon floating up high", d: 54.3 },
			{ t: "Hey, can you keep your eyes on me", d: 59.6 },
			{ t: "And make it everything you see", d: 65.1 },
			{ t: "Behind these bars behind this world of iron", d: 71.0 },
			{ t: "My soul was born and now at last it's my turn", d: 73.6 },
			{ t: "So in exchange for my complete revenge", d: 76.2 },
			{ t: "I'll grant you any wish spoken from your lips", d: 78.8 },
			{ t: "We'll bring forth the mercy and the justice", d: 81.7 },
			{ t: "Destroy them all before they even touch us", d: 84.3 },
			{ t: "We'll pay the price a karma paradise", d: 86.9 },
			{ t: "And walk ahead as one becoming, We've done", d: 89.5 },
			{ t: "Let the rain continue falling on this", d: 92.3 },
			{ t: "Unwanted soul in case you haven't noticed", d: 95.0 },
			{ t: "The guilty sin of my neurotic mind", d: 97.9 },
			{ t: "I share it with the strangers passing me by", d: 100.0 },
			{ t: "So bring forth the mercy and the justice", d: 103.3 },
			{ t: "Embrace these scars I know will never vanish", d: 105.8 },
			{ t: "My whole body accepting all of me", d: 108.4 },
			{ t: "We'll walk ahead as one becoming a monster", d: 110.9 },
		],
	},
};

const lyricEnv = {
	busy: false,
	gen: 0,
	x: null, y: null,
	color: null, translationColor: null, bright: null, font: null,
	translationBright: null, translationFont: null, translationSize: null,
	rowFont: null, topFont: null,
	topSize: null, rowSize: null,
	inCls: null, outCls: null,
	cells: [],
};
for (let i = 0; i < MAX_LYRIC_CELLS; i++) lyricEnv.cells.push({ c: "", r: "", font: null, scale: null, gap: null, w: null, gone: null });

let lyricPlayGen = 0;

function MergeObj() {
	const out = {};
	for (let i = 0; i < arguments.length; i++) {
		const src = arguments[i];
		if (!src)
			continue;
		for (const k in src) out[k] = src[k];
	}
	return out;
}

function SetClassRec(l, panelId, env, key, next) {
	if (env[key] === next)
		return;
	SwapClass(l, panelId, env[key], next);
	env[key] = next;
}

function IsKanji(ch) {
	const c = ch.charCodeAt(0);
	return (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0x3400 && c <= 0x4DBF) || c === 0x3005;
}

function ReadKana(s, idx) {
	const open = s.charAt(idx);
	if (open !== "(" && open !== "（")
		return null;

	for (let j = idx + 1; j < s.length; j++) {
		const ch = s.charAt(j);

		if (ch === ")" || ch === "）") {
			const read = s.substring(idx + 1, j);
			return read.length ? { read: read, next: j + 1 } : null;
		}

		if (IsKanji(ch) || ch === "(" || ch === "（" || ch === "\n")
			return null;
	}

	return null;
}

function SplitReading(read, n) {
	const out = [];
	let prev = 0;

	for (let k = 1; k <= n; k++) {
		const cut = Math.ceil((read.length * k) / n);
		out.push(read.substring(prev, cut));
		prev = cut;
	}

	return out;
}

function ParseLyric(text) {
	const all = String(text === undefined || text === null ? "" : text).split("\n");
	const top = all.length ? all[0] : "";
	const body = all.length > 1 ? all[1] : "";

	const cells = [];
	let i = 0;

	while (i < body.length) {
		const ch = body.charAt(i);

		if (IsKanji(ch)) {
			let end = i;
			while (end < body.length && IsKanji(body.charAt(end))) end++;

			const run = body.substring(i, end);
			const kana = ReadKana(body, end);

			if (kana) {
				const split = SplitReading(kana.read, run.length);
				for (let k = 0; k < run.length; k++) cells.push({ c: run.charAt(k), r: split[k] });
				i = kana.next;
				continue;
			}

			for (let k = 0; k < run.length; k++) cells.push({ c: run.charAt(k), r: "" });
			i = end;
			continue;
		}

		cells.push({ c: ch === " " ? "\u3000" : ch, r: "" });
		i++;
	}

	return { top: top, body: body, cells: cells };
}

function RubyScalePct(size, capPx, len) {
	if (len <= 0 || capPx <= 0)
		return 100;

	const pct = Math.floor((size * 100) / (len * capPx));
	if (pct > 100)
		return 100;
	return pct < 1 ? 1 : pct;
}

function RubyGapPx(size, gap) {
	if (typeof gap === "number" && gap > 0) return Math.min(RUBY_GAP_MAX_PX, Math.round(gap));

	const auto = Math.round(size * 0.09);
	if (auto < 0)
		return 0;
	return auto > RUBY_GAP_MAX_PX ? RUBY_GAP_MAX_PX : auto;
}

function MakeLyricConfig(src) {
	src = src || {};

	let subRaw = src.sub === undefined ? LYRIC_DEFAULTS.sub : src.sub;
	if (typeof subRaw !== "number" || subRaw <= 0) subRaw = 0;

	const lyricColor = src.color !== undefined
		? ParseColor(src.color)
		: GlobalColorRgb();

	return {
		top: src.top === undefined ? "" : String(src.top),
		cells: src.cells || [],
		colorClass: RgbClass(lyricColor),
		x: SnapInt("x", src.x === undefined ? LYRIC_DEFAULTS.x : src.x, X_MIN, X_MAX),
		y: SnapInt("y", src.y === undefined ? LYRIC_DEFAULTS.y : src.y, Y_MIN, Y_MAX),
		size: SnapInt("size", src.size === undefined ? LYRIC_DEFAULTS.size : src.size, SIZE_MIN, SIZE_MAX),
		sub: subRaw > 0 ? SnapInt("sub", subRaw, SIZE_MIN, SIZE_MAX) : 0,
		brightClass: BrightClass(SnapBrightness(src.brightness === undefined ? LYRIC_DEFAULTS.brightness : src.brightness)),
		font: src.font || LYRIC_DEFAULTS.font,
		hold: typeof src.hold === "number" && src.hold > 0 ? src.hold : (LYRIC_DEFAULTS.hold > 0 ? LYRIC_DEFAULTS.hold : 3.0),
		fadeInMs: SnapFadeMs("fadeIn", src.fadeIn === undefined ? LYRIC_DEFAULTS.fadeIn : src.fadeIn),
		fadeOutMs: SnapFadeMs("fadeOut", src.fadeOut === undefined ? LYRIC_DEFAULTS.fadeOut : src.fadeOut),
		ruby: SnapInt("ruby", src.ruby === undefined ? LYRIC_DEFAULTS.ruby : src.ruby, 10, 100),
		gap: src.gap === undefined
			? LYRIC_DEFAULTS.gap
			: Math.max(0, Math.min(RUBY_GAP_MAX_PX, Math.round(Number(src.gap) || 0))),
	};
}

function SetPlayerLyricTranslation(playerSlot, language) {
	if (!activeLyricLine)
		return;

	const l = GetLayout(true);
	if (!l)
		return;

	const translations = activeLyricLine.tr || {};
	let translation = "";

	if (language !== "ja") {
		translation = translations[language];

		if (typeof translation !== "string" || !translation.length)
			translation = translations.en || "";
	}

	l.SetDialogVariableStringForPlayer(
		playerSlot,
		LYRIC_TRANSLATION_ID,
		VAR_TRANSLATION,
		translation
	);

	if (lyricPlayerOverrides.indexOf(playerSlot) === -1)
		lyricPlayerOverrides.push(playerSlot);
}

function RefreshPlayerLyricTranslation(playerSlot, language) {
	SetPlayerLyricTranslation(playerSlot, language || "en");
}

function RefreshAllPlayerLyricTranslations() {
	if (!activeLyricLine)
		return;

	for (const player of Instance.GetAllPlayerControllers()) {
		if (!player || !player.IsConnected())
			continue;

		const playerSlot = player.GetPlayerSlot();
		RefreshPlayerLyricTranslation(
			playerSlot,
			playerLanguages[playerSlot] || "en"
		);
	}
}

function ClearPlayerLyricTranslation(playerSlot) {
	const index = lyricPlayerOverrides.indexOf(playerSlot);
	if (index === -1)
		return;

	const l = GetLayout(true);
	if (l) {
		l.SetDialogVariableStringForPlayer(
			playerSlot,
			LYRIC_TRANSLATION_ID,
			VAR_TRANSLATION,
			undefined
		);
	}

	lyricPlayerOverrides.splice(index, 1);
}

function ClearAllPlayerLyricTranslations() {
	while (lyricPlayerOverrides.length)
		ClearPlayerLyricTranslation(lyricPlayerOverrides[0]);
}

function ShowLyric(src) {
	const l = GetLayout(true);
	if (!l) return null;

	src = src || {};
	activeLyricLine = src;

	const parsed = ParseLyric(src.text === undefined ? "" : src.text);
	const cells = src.cells && src.cells.length ? src.cells : parsed.cells;
	const top = src.top === undefined ? parsed.top : String(src.top);

	const cfg = MakeLyricConfig(src);

	lyricEnv.gen++;
	lyricEnv.busy = true;

	SetClassRec(l, LYRIC_WRAP_ID, lyricEnv, "x", XClass(cfg.x));
	SetClassRec(l, LYRIC_WRAP_ID, lyricEnv, "y", YClass(cfg.y));
	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "color", cfg.colorClass);
	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "bright", cfg.brightClass);
	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "font", cfg.font);
	SetClassRec(l, LYRIC_ROW_ID, lyricEnv, "rowFont", cfg.font);
	SetClassRec(l, LYRIC_TOP_ID, lyricEnv, "topFont", cfg.font);

	SetClassRec(l, LYRIC_TRANSLATION_ID, lyricEnv, "translationColor", cfg.colorClass);
	SetClassRec(l, LYRIC_TRANSLATION_ID, lyricEnv, "translationBright", cfg.brightClass);
	SetClassRec(l, LYRIC_TRANSLATION_ID, lyricEnv, "translationFont", cfg.font);
	SetClassRec(l, LYRIC_TRANSLATION_ID, lyricEnv, "translationSize", SizeClass(cfg.size));

	const topSize = cells.length && cfg.sub > 0 ? cfg.sub : cfg.size;

	SetClassRec(l, LYRIC_TOP_ID, lyricEnv, "topSize", SizeClass(topSize));
	SetClassRec(l, LYRIC_ROW_ID, lyricEnv, "rowSize", SizeClass(cfg.size));

	const capPx = Math.max(RUBY_MIN_PX, Math.min(RUBY_MAX_PX, Math.floor((cfg.size * cfg.ruby) / 100)));
	const gapCls = RubyGapClass(RubyGapPx(cfg.size, cfg.gap));
	const cellWCls = RubyCellWidthClass(cfg.size);

	l.SetDialogVariableString(LYRIC_TOP_ID, VAR_TEXT, top);

	for (let i = 0; i < MAX_LYRIC_CELLS; i++) {
		const e = lyricEnv.cells[i];
		const cell = i < cells.length ? cells[i] : null;
		const ch = cell ? cell.c : "";
		const read = cell ? cell.r : "";

		l.SetDialogVariableString(LyricBaseId(i), VAR_CHAR, ch);
		l.SetDialogVariableString(LyricRubyId(i), VAR_RUBY, read);

		const pct = read ? RubyScalePct(cfg.size, capPx, read.length) : 100;

		SetClassRec(l, LyricRubyId(i), e, "font", read ? RubyFontClass(capPx) : null);
		SetClassRec(l, LyricRubyId(i), e, "scale", read && pct < 100 ? RubyScaleClass(pct) : null);
		SetClassRec(l, LyricRubyId(i), e, "gap", read ? gapCls : null);
		SetClassRec(l, LyricCellId(i), e, "w", ch ? cellWCls : null);
		SetClassRec(l, LyricCellId(i), e, "gone", ch ? null : LYRIC_GONE_CLASS);

		e.c = ch;
		e.r = read;
	}

	RefreshAllPlayerLyricTranslations();

	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "outCls", null);
	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "inCls", InClass(cfg.fadeInMs));

	const gen = lyricEnv.gen;
	const fadeOutSec = cfg.fadeOutMs / 1000;

	Instance.Delay(cfg.fadeInMs / 1000 + cfg.hold).then(() => {
		if (!lyricEnv.busy || lyricEnv.gen !== gen)
			return;

		const l2 = GetLayout(true);
		if (!l2) return;

		SetClassRec(l2, LYRIC_BOX_ID, lyricEnv, "inCls", null);
		SetClassRec(l2, LYRIC_BOX_ID, lyricEnv, "outCls", OutClass(cfg.fadeOutMs));

		Instance.Delay(fadeOutSec + 0.1).then(() => {
			if (!lyricEnv.busy || lyricEnv.gen !== gen)
				return;

			const l3 = GetLayout(true);
			if (l3) SetClassRec(l3, LYRIC_BOX_ID, lyricEnv, "outCls", null);

			lyricEnv.busy = false;
		});
	});

	return cfg;
}

function ClearLyric(instant) {
	activeLyricLine = null;
	ClearAllPlayerLyricTranslations();

	const l = GetLayout(true);
	if (!l) return;

	lyricEnv.gen++;
	lyricEnv.busy = false;

	if (!instant) {
		SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "inCls", null);
		SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "outCls", OutClass(200));
		return;
	}

	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "inCls", null);
	SetClassRec(l, LYRIC_BOX_ID, lyricEnv, "outCls", null);

	for (let i = 0; i < MAX_LYRIC_CELLS; i++) {
		const e = lyricEnv.cells[i];

		SetClassRec(l, LyricCellId(i), e, "gone", LYRIC_GONE_CLASS);
		SetClassRec(l, LyricCellId(i), e, "w", null);
		SetClassRec(l, LyricRubyId(i), e, "font", null);
		SetClassRec(l, LyricRubyId(i), e, "scale", null);
		SetClassRec(l, LyricRubyId(i), e, "gap", null);

		e.c = "";
		e.r = "";
	}
}

function StopLyrics(instant) {
	lyricPlayGen++;
	ClearLyric(instant === true);
}

function PlayLyrics(name) {
	const key = String(name === undefined || name === null ? "" : name).toUpperCase();
	const set = LYRICS[key];

	if (!set) {
		return false;
	}

	StopLyrics(false);

	const gen = lyricPlayGen;
	const lines = set.lines || [];
	const style = set.style || {};

	for (let i = 0; i < lines.length; i++) {
		const line = lines[i];
		const at = typeof line.d === "number" ? line.d : 0;
		const next = i + 1 < lines.length && typeof lines[i + 1].d === "number"
			? lines[i + 1].d
			: at + 6.0;

		Instance.Delay(Math.max(0, at)).then(() => {
			if (gen !== lyricPlayGen)
				return;

			const fadeIn = typeof style.fadeIn === "number" ? style.fadeIn : 1.0;
			const fadeOut = typeof style.fadeOut === "number" ? style.fadeOut : 1.0;

			const hold = Math.max(0, next - at - fadeIn - fadeOut);

			ShowLyric(MergeObj(style, line, {
				fadeIn: fadeIn,
				fadeOut: fadeOut,
				hold: hold,
				text: line.t
			}));
		});
	}

	return true;
}

const GameText = {};

const playerLanguages = {};

function ClearPlayerLanguageOverride(playerSlot) {
	const l = GetLayout(true);
	if (!l) return;

	for (const slot of slots) {
		l.SetDialogVariableStringForPlayer(playerSlot, slot.label, VAR_TEXT, undefined);

		const index = slot.playerOverrides.indexOf(playerSlot);
		if (index !== -1) slot.playerOverrides.splice(index, 1);
	}
}

function ApplyLocalizedTextForPlayer(l, slot, playerSlot, def, language) {
	let localizedText = def[language];

	if (typeof localizedText !== "string" || !localizedText.length)
		localizedText = def.en;

	if (typeof localizedText !== "string" || !localizedText.length)
		localizedText = def.text;

	if (typeof localizedText !== "string")
		localizedText = "";

	l.SetDialogVariableStringForPlayer(playerSlot, slot.label, VAR_TEXT, localizedText);
	if (slot.playerOverrides.indexOf(playerSlot) === -1)
		slot.playerOverrides.push(playerSlot);
}

function RefreshPlayerLocalizedMessages(playerSlot, language) {
	const l = GetLayout(true);
	if (!l) return;

	for (const slot of slots) {
		if (slot.state !== "busy" || !slot.messageKey)
			continue;

		const def = MESSAGES[slot.messageKey];
		if (!def) continue;

		ApplyLocalizedTextForPlayer(l, slot, playerSlot, def, language);
	}
}

function ShowLocalizedMessage(key) {
	const def = MESSAGES[key];
	if (!def) return null;

	const slot = ShowGameText({
		...def,
		text: typeof def.en === "string" ? def.en : (def.text || ""),
		font: FONT.STRATUM_MONO_BOLD
	});
	if (!slot) return null;
	slot.messageKey = key;

	const l = GetLayout(true);
	if (!l) return slot;

	for (const player of Instance.GetAllPlayerControllers()) {
		if (!player || !player.IsConnected())
			continue;

		const playerSlot = player.GetPlayerSlot();
		const language = playerLanguages[playerSlot] || "en";
		ApplyLocalizedTextForPlayer(l, slot, playerSlot, def, language);
	}

	return slot;
}

Instance.OnPlayerConnect((event) => {
	const playerSlot = event.player.GetPlayerSlot();
	delete playerLanguages[playerSlot];
	ClearPlayerLanguageOverride(playerSlot);
	ClearPlayerLyricTranslation(playerSlot);

	if (activeLyricLine)
		RefreshPlayerLyricTranslation(playerSlot, "en");
});

Instance.OnPlayerDisconnect((event) => {
	const playerSlot = event.playerSlot;
	delete playerLanguages[playerSlot];
	ClearPlayerLanguageOverride(playerSlot);
	ClearPlayerLyricTranslation(playerSlot);
});

Instance.OnPlayerChat((event) => {
	if (!event.player)
		return;

	const command = String(event.text).trim().toLowerCase();
	const languageCommands = {
		"!english": "en",
        "!en": "en",
		"!中文": "zh",
        "!ch": "zh",
        "!zh": "zh",
		"!한국어": "ko",
        "!kr": "ko",
        "!ko": "ko",
		"!日本語": "ja",
        "!jp": "ja",
        "!ja": "ja",
		"!русский": "ru",
        "!ru": "ru",
        "!tiếng việt": "vi",
        "!vn": "vi",
        "!vi": "vi",
        "!ภาษาไทย": "th",
        "!th": "th",
	};
	const language = languageCommands[command];
	if (!language)
		return;

	const playerSlot = event.player.GetPlayerSlot();
	const currentLanguage = playerLanguages[playerSlot] || "en";
	if (currentLanguage === language)
		return;

	playerLanguages[playerSlot] = language;
	RefreshPlayerLocalizedMessages(playerSlot, language);
	RefreshPlayerLyricTranslation(playerSlot, language);
});

for (const key in MESSAGES) {
	GameText[key] = () => ShowLocalizedMessage(key);
	Instance.OnScriptInput(key, () => ShowLocalizedMessage(key));
}

GameText.gt_clear = () => ClearAll(0.2);
Instance.OnScriptInput("gt_clear", () => ClearAll(0.2));

GameText.gt_clear_fast = () => ClearAll(0.05);
Instance.OnScriptInput("gt_clear_fast", () => ClearAll(0.05));

GameText.gt_clear_instant = () => ClearAllInstant();
Instance.OnScriptInput("gt_clear_instant", () => ClearAllInstant());

const CHANNELS = {};
for (const key in MESSAGES) {
	const ch = MESSAGES[key].channel;
	if (ch) CHANNELS[ch] = true;
}

for (const ch in CHANNELS) {
	const name = "gt_clear_channel_" + ch;
	GameText[name] = () => ClearChannel(ch, 0.2);
	Instance.OnScriptInput(name, () => ClearChannel(ch, 0.2));
}

for (const key in COUNTDOWNS) {
	const def = COUNTDOWNS[key];
	GameText[key] = () => StartCountdown(def);
	Instance.OnScriptInput(key, () => StartCountdown(def));
}

GameText.cd_stop = () => StopCountdown();
Instance.OnScriptInput("cd_stop", () => StopCountdown());

Instance.OnScriptInput("lyric_JP", () => PlayLyrics("JP"));
Instance.OnScriptInput("lyric_EN", () => PlayLyrics("EN"));
Instance.OnScriptInput("lyric_stop", () => StopLyrics(true));

for (const cname in COLOR) {
	const key = cname;
	const input = "hud_color_" + cname.toLowerCase();

	GameText[input] = () => SetGlobalColor(key);
	Instance.OnScriptInput(input, () => SetGlobalColor(key));
}

GameText.hud_reset = () => ResetHud();
Instance.OnRoundStart(() => {
    ResetHud();
});

Instance.OnScriptReload({
	before: () => {
		const l = GetLayout(true);
		if (!l) return;
		
		for (const slot of slots) ResetSlot(l, slot);
		ResetCountdown(l);
		StopLyrics(true);
	},
	after: () => {
		TryStartup(0);
	},
});