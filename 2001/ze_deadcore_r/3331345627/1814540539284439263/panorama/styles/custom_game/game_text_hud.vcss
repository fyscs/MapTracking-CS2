.gt-ly-box {
    width: fit-children;
    height: fit-children;
    max-width: 100%;
    flow-children: down;
    horizontal-align: center;
    overflow: noclip;
    opacity: 0;
}
.gt-ly-top {
    width: fit-children;
    max-width: 100%;
    horizontal-align: center;
    text-align: center;
    white-space: nowrap;
    text-overflow: shrink;
}
.gt-ly-row {
    width: fit-children;
    height: fit-children;
    flow-children: right;
    horizontal-align: center;
    overflow: noclip;
}
.gt-lyr-cell {
    width: fit-children;
    height: fit-children;
    flow-children: down;
    vertical-align: bottom;
    overflow: noclip;
}
.gt-lyr-rbox {
    width: fit-children;
    height: fit-children;
    overflow: noclip;
    horizontal-align: center;
}
.gt-lyr-rb {
    horizontal-align: center;
    text-align: center;
    white-space: nowrap;
    transform-origin: 50% 50%;
    text-overflow: noclip;
    overflow: noclip;
    font-size: 12px;
}
.gt-lyr-bs {
    horizontal-align: center;
    text-align: center;
    white-space: nowrap;
}
.gt-lyr-gone {
    visibility: collapse;
}
