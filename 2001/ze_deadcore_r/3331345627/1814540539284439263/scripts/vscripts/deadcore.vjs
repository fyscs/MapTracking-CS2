import { Instance } from "cs_script/point_script";

// ============================================================
// Skip State
// ============================================================

let skipA = false;
let skipB = false;
let skipC = false;
let skipD = false;

let currentStage = "";

// ============================================================
// Random
// ============================================================

function RandomInt(min, max)
{
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

// ============================================================
// Stage Trigger
// ============================================================

function TriggerStage(stage)
{
    currentStage = stage;

    switch (stage)
    {
        case "A":
            Instance.EntFireAtName({
                name: "stage_a",
                input: "Trigger",
                delay: 0.0
            });
            break;

        case "B":
            Instance.EntFireAtName({
                name: "stage_b",
                input: "Trigger",
                delay: 0.0
            });
            break;

        case "C":
            Instance.EntFireAtName({
                name: "stage_c",
                input: "Trigger",
                delay: 0.0
            });
            break;

        case "D":
            Instance.EntFireAtName({
                name: "stage_d_relay",
                input: "Trigger",
                delay: 0.0
            });
            break;

        case "RED_D":
            Instance.EntFireAtName({
                name: "stage_d_red_relay",
                input: "Trigger",
                delay: 0.0
            });
            break;
    }
}

// ============================================================
// Stage Select
// ============================================================

function SelectStage()
{
    // Skip A + B + C + D → RED D
    if (skipA && skipB && skipC && skipD)
    {
        TriggerStage("RED_D");
        return;
    }

    // Skip A + B + C → D
    if (skipA && skipB && skipC)
    {
        TriggerStage("D");
        return;
    }

    // Skip A + B → C
    if (skipA && skipB)
    {
        TriggerStage("C");
        return;
    }

    // Skip A + C → B
    if (skipA && skipC)
    {
        TriggerStage("B");
        return;
    }

    // Skip B + C → A
    if (skipB && skipC)
    {
        TriggerStage("A");
        return;
    }

    // Skip A → B or C
    if (skipA)
    {
        if (RandomInt(0, 1) == 0)
            TriggerStage("B");
        else
            TriggerStage("C");

        return;
    }

    // Skip B → A or C
    if (skipB)
    {
        if (RandomInt(0, 1) == 0)
            TriggerStage("A");
        else
            TriggerStage("C");

        return;
    }

    // Skip C → A or B
    if (skipC)
    {
        if (RandomInt(0, 1) == 0)
            TriggerStage("A");
        else
            TriggerStage("B");

        return;
    }

    // Non Skip → A or B or C
    let random = RandomInt(0, 2);

    if (random == 0)
    {
        TriggerStage("A");
    }
    else if (random == 1)
    {
        TriggerStage("B");
    }
    else
    {
        TriggerStage("C");
    }
}

// ============================================================
// MapStart
// ============================================================

function MapStart()
{
    currentStage = "";

    SelectStage();
}

// ============================================================
// Skip A
// ============================================================

function SkipA()
{
    skipA = true;
}

// ============================================================
// Skip B
// ============================================================

function SkipB()
{
    skipB = true;
}

// ============================================================
// Skip C
// ============================================================

function SkipC()
{
    skipC = true;
}

// ============================================================
// Skip D
// ============================================================

function SkipD()
{
    skipD = true;
}

// ============================================================
// Reset
// ============================================================

function Reset()
{
    skipA = false;
    skipB = false;
    skipC = false;
    skipD = false;

    currentStage = "";
}

// ============================================================
// Script Input
// ============================================================

Instance.OnScriptInput("MapStart", () =>
{
    MapStart();
});

Instance.OnScriptInput("Skip_A", () =>
{
    SkipA();
});

Instance.OnScriptInput("Skip_B", () =>
{
    SkipB();
});

Instance.OnScriptInput("Skip_C", () =>
{
    SkipC();
});

Instance.OnScriptInput("Skip_D", () =>
{
    SkipD();
});

Instance.OnScriptInput("Reset", () =>
{
    Reset();
});