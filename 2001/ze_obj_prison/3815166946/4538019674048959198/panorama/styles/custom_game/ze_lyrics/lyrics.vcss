/* https://github.com/Kxnrl */

.root {
    width: 100%;
    height: 100%;
}
.visibility-collapse {
    visibility: collapse;
}
.lyricbox {
    horizontal-align: center;
    y: 72%;
    width: 960px;
    padding: 10px 18px;
    background-color: #00000059;
    border-radius: 4px;
    transition-property: opacity, transform;
    transition-timing-function: ease-out, ease-out;
}
.lyricbox.state-in {
    opacity: 1.0;
    transform: translatey( 0px );
    transition-duration: 0.35s, 0.35s;
}
.lyricbox.state-out {
    opacity: 0.0;
    transform: translatey( 10px );
    transition-duration: 0.30s, 0.30s;
}
.lyric_inner {
    width: 100%;
    flow-children: down;
    transition-property: opacity, transform;
    transition-duration: 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out;
}
.lyric_inner.dim {
    opacity: 0.0;
    transform: translatey( -4px );
}
.lyric_en {
    width: 100%;
    text-align: center;
    font-family: 'Microsoft YaHei UI';
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #ffffffff;
    text-overflow: shrink;
    text-shadow: 1px 1px 1px 2.5 #000000e0;
}
.lyric_zh {
    width: 100%;
    margin-top: 4px;
    text-align: center;
    font-family: 'Microsoft YaHei UI';
    font-size: 16px;
    color: #cfe0eeea;
    text-overflow: shrink;
    text-shadow: 1px 1px 1px 2.0 #000000c0;
}
