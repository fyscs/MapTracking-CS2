/* Generated by StarDance */
/* https://github.com/Kxnrl */

.root {
    width: 100%;
    height: 100%;
}
.collapse {
    visibility: collapse;
}
#cinema {
    width: 100%;
    height: 100%;
    opacity: 0.0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
#cinema.state-in {
    opacity: 1.0;
}
#cinema.flicker {
    opacity: 0.55;
}
#cinema.state-out {
    opacity: 0.0;
    transition-duration: 1.40s;
}
.bar {
    width: 100%;
    height: 11%;
    background-color: #000000ff;
    transition-property: transform;
    transition-duration: 0.55s;
    transition-timing-function: cubic-bezier( 0.20, 1.20, 0.40, 1.00 );
}
.bar.top {
    vertical-align: top;
    border-bottom: 1px solid #d8b46a40;
    transform: translatey( -100% );
}
.bar.bottom {
    vertical-align: bottom;
    border-top: 1px solid #d8b46a40;
    transform: translatey( 100% );
}
#cinema.state-in .bar.top {
    transform: translatey( 0px );
}
#cinema.state-in .bar.bottom {
    transform: translatey( 0px );
}
#frame {
    width: 760px;
    height: 320px;
    horizontal-align: center;
    vertical-align: center;
    background-color: #050607e8;
    border: 1px solid #d8b46a5c;
    box-shadow: #000000d9 0px 14px 50px 10px;
    opacity: 1.0;
    transform: scale3d( 0.97, 0.97, 1.0 );
    transition-property: opacity, transform, box-shadow, border-color;
    transition-duration: 0.90s, 0.90s, 0.90s, 0.90s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}
#cinema.state-in #frame {
    transform: scale3d( 1.0, 1.0, 1.0 );
}
#cinema.dissolve #frame {
    transform: scale3d( 1.04, 1.04, 1.0 );
    border-color: #ffffff00;
    box-shadow: #00000000 0px 0px 0px 0px;
    transition-duration: 1.50s, 1.50s, 1.50s, 1.50s;
}
.frame_inner {
    width: 100%;
    height: 100%;
    padding: 26px 30px;
    flow-children: down;
    border: 1px solid #ffffff12;
}
#logo_main {
    width: 100%;
    text-align: center;
    font-family: 'Georgia';
    font-size: 84px;
    font-weight: bold;
    color: #f3ead8ff;
    letter-spacing: 24px;
    text-shadow: 0px 2px 4px 2 #000000e0;
    opacity: 0.0;
    transform: scale3d( 0.92, 0.92, 1.0 );
    clip: radial( 50% 50%, -90deg, 360deg );
    transition-property: opacity, transform, letter-spacing, clip;
    transition-duration: 0.90s, 0.90s, 0.90s, 0.90s;
    transition-timing-function: cubic-bezier( 0.20, 1.20, 0.40, 1.00 ), ease-out, ease-out, ease-out;
}
#cinema.state-in #logo_main {
    opacity: 1.0;
    transform: scale3d( 1.0, 1.0, 1.0 );
    letter-spacing: 14px;
}
#cinema.dissolve #logo_main {
    opacity: 0.0;
    transform: scale3d( 1.14, 1.14, 1.0 );
    letter-spacing: 30px;
    clip: radial( 50% 50%, -90deg, -90deg );
    transition-duration: 1.50s, 1.50s, 1.50s, 1.50s;
}
#logo_rule {
    width: 0px;
    height: 1px;
    horizontal-align: center;
    margin-top: 8px;
    background-color: #d8b46aff;
    transition-property: width, opacity, background-color;
    transition-duration: 0.80s, 0.80s, 0.80s;
    transition-timing-function: ease-out, ease-out, ease-out;
}
#cinema.state-in #logo_rule {
    width: 430px;
}
#cinema.dissolve #logo_rule {
    width: 0px;
    opacity: 0.0;
    background-color: #ffffff00;
    transition-duration: 1.00s, 1.00s, 1.00s;
}
#logo_credits {
    width: 100%;
    margin-top: 14px;
    text-align: center;
    font-family: 'Consolas';
    font-size: 18px;
    letter-spacing: 5px;
    color: #d8b46aff;
    opacity: 0.0;
    transform: translatey( 8px );
    transition-property: opacity, transform;
    transition-duration: 0.70s, 0.70s;
    transition-timing-function: ease-out, ease-out;
}
#cinema.state-in #logo_credits {
    opacity: 0.95;
    transform: translatey( 0px );
}
#cinema.dissolve #logo_credits {
    opacity: 0.0;
    transform: translatey( -6px );
    transition-duration: 1.00s, 1.00s;
}
#credit_number {
    width: 100%;
    margin-top: 8px;
    text-align: center;
    font-family: 'Consolas';
    font-size: 22px;
    letter-spacing: 6px;
    color: #f3ead8ff;
    opacity: 0.0;
    transform: translatey( 8px );
    transition-property: opacity, transform;
    transition-duration: 0.70s, 0.70s;
    transition-timing-function: ease-out, ease-out;
}
#cinema.state-in #credit_number {
    opacity: 0.95;
    transform: translatey( 0px );
}
#cinema.dissolve #credit_number {
    opacity: 0.0;
    transform: translatey( -6px );
    transition-duration: 1.00s, 1.00s;
}
