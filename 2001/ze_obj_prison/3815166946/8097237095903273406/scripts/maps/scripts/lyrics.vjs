let currentKey = "";
let lines = [];
let idx = 0;
let songStart = 0;
let running = false;
let token = 0;

function getLayout() {
	const L = Instance.FindEntitiesByName(LAYOUT_NAME)[0];
	return (L && L.IsValid()) ? L : undefined;
}

// 歌词是全服同一份，但用 ForPlayer 写：中途加入的玩家也能立刻拿到当前这句
function forEachPlayer(fn) {
	const players = Instance.GetAllPlayerControllers();
	for (const p of players) {
		if (p && p.IsConnected()) fn(p);
	}
}

function setClassAll(L, panelId, cls, on) {
	forEachPlayer((p) => {
		L.SetHasClassForPlayer(p.GetPlayerSlot(), panelId, cls, !!on);
	});
}

function setVarAll(L, panelId, name, value) {
	forEachPlayer((p) => {
		L.SetDialogVariableStringForPlayer(p.GetPlayerSlot(), panelId, name, String(value));
	});
}

// 控制台：lyrics_diag
function diag() {
	Instance.Msg("==== [lyrics] diag ====");
	Instance.Msg("version = " + VERSION);
	for (const key in SONGS) {
		Instance.Msg("song " + key + " lines=" + SONGS[key].lines.length);
	}
	const all = Instance.FindEntitiesByClass("custom_hud_layout");
	Instance.Msg("custom_hud_layout count = " + all.length);
	for (const e of all) {
		Instance.Msg("   hud: name='" + e.GetEntityName() + "'");
	}
	Instance.Msg("layout '" + LAYOUT_NAME + "' = " + (getLayout() ? "found" : "MISSING"));
	Instance.Msg("current = " + (currentKey || "(none)") + " running=" + running);
	Instance.Msg("========================");
}

function startSong(key) {
	const song = SONGS[key];
	if (!song) {
		Instance.Msg("[lyrics] unknown song: " + key);
		return;
	}

	const L = getLayout();
	if (!L) {
		Instance.Msg("[lyrics] 找不到 targetname 为 " + LAYOUT_NAME + " 的 custom_hud_layout");
		diag();
		return;
	}

	// 同一首正在播：不重开
	if (running && currentKey === key) return;

	// 切歌：让旧时间轴/旧换字回调失效，但不隐藏 HUD
	token++;
	running = false;

	currentKey = key;
	lines = song.lines;
	idx = 0;
	songStart = Instance.GetGameTime() + (song.offset || 0) + OFFSET;
	token++;
	running = true;

	setClassAll(L, "lyricbox", "visibility-collapse", false);
	setClassAll(L, "lyricbox", "state-out", false);
	setClassAll(L, "lyricbox", "state-in", true);

	Instance.SetThink(tick);
	Instance.SetNextThink(Instance.GetGameTime());
	Instance.Msg("[lyrics] start " + key + " (" + lines.length + " lines)");
}

function tick() {
	if (!running) return;
	const L = getLayout();
	if (!L) { running = false; return; }

	const now = Instance.GetGameTime() - songStart;

	while (idx < lines.length && lines[idx].t - LEAD <= now) {
		if (idx < 3) Instance.Msg("[lyrics] show line " + idx + " @ " + now.toFixed(2) + "s");
		paint(L, lines[idx]);
		idx++;
	}

	if (idx >= lines.length) {
		running = false;
		Instance.Delay(TAIL).then(hide);
		return;
	}

	const wait = Math.max(0.02, lines[idx].t - LEAD - now);
	Instance.SetNextThink(Instance.GetGameTime() + wait);
}

function paint(L, line) {
	const my = ++token;
	setClassAll(L, "lyric_inner", "dim", true);
	Instance.Delay(FADE).then(() => {
		if (my !== token) return;
		const L2 = getLayout(); if (!L2) return;
		setVarAll(L2, "lyric_en", "en", line.en);
		setVarAll(L2, "lyric_zh", "zh", line.zh);
		setClassAll(L2, "lyric_inner", "dim", false);
	});
}

// 中途加入的玩家：立刻补上当前这句
Instance.OnPlayerActivate(({ player }) => {
	if (!running || !player) return;
	const L = getLayout(); if (!L) return;

	const slot = player.GetPlayerSlot();
	L.SetHasClassForPlayer(slot, "lyricbox", "visibility-collapse", false);
	L.SetHasClassForPlayer(slot, "lyricbox", "state-out", false);
	L.SetHasClassForPlayer(slot, "lyricbox", "state-in", true);

	if (lines.length > 0) {
		const i = Math.max(0, Math.min(idx - 1, lines.length - 1));
		const line = lines[i];
		if (line) {
			L.SetDialogVariableStringForPlayer(slot, "lyric_en", "en", String(line.en));
			L.SetDialogVariableStringForPlayer(slot, "lyric_zh", "zh", String(line.zh));
		}
	}
});

function hide() {
	if (running) return;   // 已经切到别的歌/重新开始，不要把新一轮藏掉
	const L = getLayout(); if (!L) return;
	setClassAll(L, "lyricbox", "state-in", false);
	setClassAll(L, "lyricbox", "state-out", true);
	Instance.Delay(0.32).then(() => {
		const L2 = getLayout();
		if (L2 && !running) setClassAll(L2, "lyricbox", "visibility-collapse", true);
	});
}

function stop() {
	running = false;
	token++;
	hide();
}

/* ===================== 入口 ===================== */

// Breath：你原来的 jdl_end 不用改，仍然发 start
Instance.OnScriptInput("start", () => { startSong("breath"); });

// What I've Done：把对应按钮/中继的 RunScriptInput 参数填 start_whativedone
Instance.OnScriptInput("start_whativedone", () => { startSong("wid"); });

// Novocaine：把对应按钮/中继的 RunScriptInput 参数填 start_novocaine
Instance.OnScriptInput("start_novocaine", () => { startSong("nov"); });

// 需要提前收掉 HUD 时用；不接也不影响三首歌启动
Instance.OnScriptInput("stop", () => { stop(); });

Instance.RegisterCheatCommand("lyrics_diag", () => diag());
Instance.RegisterCheatCommand("lyrics_stop", () => stop());

Instance.OnScriptReload({
	before: () => 0,
	after: () => {
		running = false;
		token++;
		const L = getLayout(); if (!L) return;
		setClassAll(L, "lyricbox", "state-in", false);
		setClassAll(L, "lyricbox", "state-out", true);
		setClassAll(L, "lyricbox", "visibility-collapse", true);
		Instance.Msg("[lyrics] reloaded");
	}
});

Instance.Msg("[lyrics] script loaded " + VERSION + " / songs=" + Object.keys(SONGS).length);
