// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

/* ============================================================================
 * PRISON 电影标题卡 HUD
 * - 触发后显示 5 秒：黑边落下 → PRISON 标题浮现 → 停留 → 湮灭消散
 * - 没有开局自检、没有自动播放；只有收到 RunScriptInput "show" 才生效
 * - 与歌词 HUD 完全分开：独立 layout / css / script / 实体
 *
 * Hammer：
 *   point_script      targetname = prison_logo_script
 *                     cs_script  = maps/scripts/prison_logo.vjs
 *   custom_hud_layout targetname = prison_logo_hud
 *                     layout     = panorama/layout/custom_game/prison_logo/logo.vxml
 * 触发：
 *   prison_logo_script  RunScriptInput  show
 * ========================================================================== */

const VERSION = "v1";
const LAYOUT_NAME = "prison_logo_hud";
const DURATION = 8.0;

let runId = 0;
let running = false;
let stage = "idle";   // idle / in / dissolve / out

function getLayout() {
	const L = Instance.FindEntitiesByName(LAYOUT_NAME)[0];
	return (L && L.IsValid()) ? L : undefined;
}

function forEachPlayer(fn) {
	const players = Instance.GetAllPlayerControllers();
	for (const p of players) {
		if (p && p.IsConnected()) fn(p);
	}
}

function setClassAll(L, panelId, cls, on) {
	forEachPlayer((p) => {
		L.SetHasClassForPlayer(p.GetPlayerSlot(), panelId, cls, !!on);
	});
}

function resetAll(L) {
	setClassAll(L, "cinema", "state-in", false);
	setClassAll(L, "cinema", "state-out", false);
	setClassAll(L, "cinema", "collapse", false);
	setClassAll(L, "cinema", "flicker", false);
	setClassAll(L, "cinema", "dissolve", false);
}

function diag() {
	Instance.Msg("==== [prison_logo] diag ====");
	Instance.Msg("version = " + VERSION + " / duration = " + DURATION + "s");
	Instance.Msg("running = " + running + " / stage = " + stage);
	const L = getLayout();
	Instance.Msg("layout '" + LAYOUT_NAME + "' = " + (L ? "found" : "MISSING"));
	Instance.Msg("============================");
}

function show() {
	const L = getLayout();
	if (!L) {
		Instance.Msg("[prison_logo] 找不到 targetname 为 " + LAYOUT_NAME + " 的 custom_hud_layout");
		return;
	}

	runId++;
	const my = runId;
	running = true;
	stage = "in";

	resetAll(L);
	setClassAll(L, "cinema", "collapse", false);
	setClassAll(L, "cinema", "state-out", false);
	setClassAll(L, "cinema", "state-in", true);
	setClassAll(L, "cinema", "flicker", true);

	Instance.Delay(0.12).then(() => {
		if (my !== runId) return;
		const L2 = getLayout(); if (!L2) return;
		setClassAll(L2, "cinema", "flicker", false);
	});

	// 4.80s 开始湮灭：径向擦除 + 放大 + 字距拉开
	Instance.Delay(4.80).then(() => {
		if (my !== runId) return;
		const L2 = getLayout(); if (!L2) return;
		stage = "dissolve";
		setClassAll(L2, "cinema", "dissolve", true);
	});

	// 6.30s 整块渐出
	Instance.Delay(6.30).then(() => {
		if (my !== runId) return;
		const L2 = getLayout(); if (!L2) return;
		stage = "out";
		setClassAll(L2, "cinema", "state-in", false);
		setClassAll(L2, "cinema", "state-out", true);
	});

	// 8.00s 收起，恢复初始状态，方便下次触发
	Instance.Delay(DURATION).then(() => {
		if (my !== runId) return;
		const L2 = getLayout(); if (!L2) return;
		stage = "idle";
		running = false;
		setClassAll(L2, "cinema", "collapse", true);
		setClassAll(L2, "cinema", "state-out", false);
		setClassAll(L2, "cinema", "dissolve", false);
	});

	Instance.Msg("[prison_logo] show");
}

function hide() {
	runId++;
	const my = runId;
	running = false;
	stage = "idle";

	const L = getLayout(); if (!L) return;
	setClassAll(L, "cinema", "state-in", false);
	setClassAll(L, "cinema", "state-out", true);
	setClassAll(L, "cinema", "flicker", false);
	setClassAll(L, "cinema", "dissolve", false);

	Instance.Delay(1.45).then(() => {
		if (my !== runId) return;
		const L2 = getLayout(); if (!L2) return;
		setClassAll(L2, "cinema", "collapse", true);
		setClassAll(L2, "cinema", "state-out", false);
	});
}

// 中途加入：正在播时把当前阶段补给他
Instance.OnPlayerActivate(({ player }) => {
	if (!running || !player) return;
	const L = getLayout(); if (!L) return;

	const slot = player.GetPlayerSlot();
	L.SetHasClassForPlayer(slot, "cinema", "collapse", false);
	L.SetHasClassForPlayer(slot, "cinema", "state-out", false);
	L.SetHasClassForPlayer(slot, "cinema", "state-in", true);

	if (stage === "dissolve") {
		L.SetHasClassForPlayer(slot, "cinema", "dissolve", true);
	} else if (stage === "out") {
		L.SetHasClassForPlayer(slot, "cinema", "state-out", true);
	}
});

/* ===================== 入口 ===================== */

Instance.OnScriptInput("show", () => { show(); });
Instance.OnScriptInput("hide", () => { hide(); });

Instance.RegisterCheatCommand("logo_show", () => show());
Instance.RegisterCheatCommand("logo_hide", () => hide());
Instance.RegisterCheatCommand("logo_diag", () => diag());

Instance.OnScriptReload({
	before: () => 0,
	after: () => {
		running = false;
		stage = "idle";
		runId++;
		const L = getLayout(); if (!L) return;
		resetAll(L);
		setClassAll(L, "cinema", "collapse", true);
		Instance.Msg("[prison_logo] reloaded");
	}
});

Instance.Msg("[prison_logo] script loaded " + VERSION);
