// 本文件由 tools/make-title-huds.py 从 title_hud.js 生成 —— 不要直接编辑，
// 要改行为请改模板 title_hud.js 后重新生成。这一份是 ACT 1 独立 HUD（title1_hud）。
// ============================================================================
//  title_hud.js —— 开场报幕的脚本（best 项目）
//
//  接线（Hammer）：
//    · custom_hud_layout：Name = title_hud
//        Layout = panorama/layout/custom_game/title_hud.vxml
//        Observable 不勾
//    · point_script：Name = title_hud_1
//        cs_script = maps/scripts/title_hud.vjs
//
//  可用参数（RunScriptInput 的参数栏直接填）：
//    title_1        显示第 1 张报幕卡（ACT 1）—— 淡入 → 停留 → 自动淡出
//    title_show     显示当前这张卡（不换内容）
//    title_hide     立刻收起
//
//  控制台测试指令（需 sv_cheats 1）：
//    title_test            显示 TEST_CARD 那张（目前第 1 张）
//    title_test_1 / _2 / _3   分别显示第 1 / 2 / 3 张
//    title_test_hide       收起
//
//  加内容：在下面 CARDS 里改第 1 张卡，或再加第 2、3 张（键名对应 title_2、title_3）。
// ============================================================================

import { Instance } from "cs_script/point_script";

// ------------------------------- 名字与常量 -------------------------------

/** Hammer 里 custom_hud_layout 实体的 Name */
const HUD_NAME = "title1_hud";

const BOX_PANEL = "title_box";
const LINE1_PANEL = "title_line1";
const LINE2_PANEL = "title_line2";
const LINE3_PANEL = "title_line3";
const LINE1_VAR = "line1";
const LINE2_VAR = "line2";
const LINE3_VAR = "line3";
const HIDDEN_CLASS = "Hidden";

/** 淡入时长（秒）—— 必须与 title_hud.css 里 .TitleBox 的 transition-duration 一致 */
const FADE_SEC = 1.0;

/** 一张报幕卡的在场总时长（秒），含开头淡入与结尾淡出 */
const SHOW_SEC = 11.0;

/** 全亮停留时长 = 总时长 - 两次淡入淡出 */
const HOLD_SEC = SHOW_SEC - FADE_SEC * 2;

/**
 * 报幕卡。键名 N 对应 RunScriptInput 参数 title_N（目前 title_1 / title_2 / title_3）。
 * 三行分别是：幕名 / 阵营-地域 / 地点名。
 */
const CARDS = {
	1: {
		line1: "ACT 1",
		line2: "SUN KINGDOM - NEVER SUNSET VALLEY",
		line3: "THE WONDER LAND",
	},
};

/** 控制台测试用哪张卡 */
const TEST_CARD = 1;

/**
 * 控制台命令前缀。命令是全局的（不像 RunScriptInput 参数是每个实体各自的），
 * 所以三套独立的报幕 HUD 必须用不同前缀：
 *    title_hud  -> "title"   （title_test / title_test_1 …）
 *    title1_hud -> "title1"  （title1_test / title1_test_1）
 *    title2_hud -> "title2"
 *    title3_hud -> "title3"
 */
const CHEAT_PREFIX = "title1";

// ============================================================================
//  一、以下一般不用改
// ============================================================================

let cachedLayout;
let currentCard = TEST_CARD;
let visible = false;

/** 每次显示/收起都自增，用来作废上一次的自动淡出定时 */
let showSeq = 0;

function Log(msg) {
	Instance.Msg(`[title_hud] ${msg}`);
}

/** 取到 HUD 布局（缓存句柄，但引擎可能重建面板，所以先 IsValid 再复用） */
function GetLayout() {
	if (cachedLayout && cachedLayout.IsValid()) {
		return cachedLayout;
	}
	const found = Instance.FindEntitiesByName(HUD_NAME);
	cachedLayout = found.length > 0 ? found[0] : undefined;
	return cachedLayout;
}

function WithLayout(action) {
	const layout = GetLayout();
	if (!layout) {
		Log(`找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
		return;
	}
	action(layout);
}

/** 把某张卡的文字刷进三个面板 */
function ApplyCard(layout) {
	const card = CARDS[currentCard] || { line1: "", line2: "", line3: "" };
	layout.SetDialogVariableString(LINE1_PANEL, LINE1_VAR, card.line1);
	layout.SetDialogVariableString(LINE2_PANEL, LINE2_VAR, card.line2);
	layout.SetDialogVariableString(LINE3_PANEL, LINE3_VAR, card.line3);
}

function ApplyVisibility(layout) {
	layout.SetHasClass(BOX_PANEL, HIDDEN_CLASS, !visible);
}

function Hide() {
	showSeq++;
	visible = false;
	WithLayout((layout) => ApplyVisibility(layout));
}

/** 显示当前卡：淡入 → 停留 HOLD_SEC → 自动淡出 */
async function Show() {
	const seq = ++showSeq;
	visible = true;
	WithLayout((layout) => {
		ApplyCard(layout);
		ApplyVisibility(layout);
	});

	// 等淡入完成 + 停留，再一次收起；期间被 hide / 换卡 / 重播都会让 seq 变化，本次定时作废
	await Instance.Delay(FADE_SEC + HOLD_SEC);
	if (seq !== showSeq) {
		return;
	}
	Hide();
}

/** 切到第 N 张卡并显示 */
function ShowCard(n) {
	if (!CARDS[n]) {
		Log(`没有第 ${n} 张报幕卡（CARDS 里没定义）`);
		return;
	}
	currentCard = n;
	Show();
}

// ------------------------------- 输入注册 -------------------------------

Instance.OnActivate(() => {
	visible = false;
	currentCard = TEST_CARD;
	WithLayout((layout) => ApplyVisibility(layout));
});

Instance.OnScriptInput("title_show", () => {
	Show();
});

Instance.OnScriptInput("title_hide", () => {
	Hide();
});

for (const key of Object.keys(CARDS)) {
	Instance.OnScriptInput(`title_${key}`, () => {
		ShowCard(Number(key));
	});
}

Instance.OnBeginRoundRestart(() => {
	Hide();
});

Instance.OnScriptReload({
	before: () => {
		WithLayout((layout) => layout.SetHasClass(BOX_PANEL, HIDDEN_CLASS, true));
	},
	after: () => {
		visible = false;
		WithLayout((layout) => ApplyVisibility(layout));
	},
});

// ------------------------------- 控制台测试 -------------------------------

Instance.RegisterCheatCommand(`${CHEAT_PREFIX}_test`, () => {
	ShowCard(TEST_CARD);
	Log(`测试：显示第 ${TEST_CARD} 张报幕（${CARDS[TEST_CARD] ? CARDS[TEST_CARD].line1 : "-"}）`);
});

// 每张卡各有自己的测试指令：title_test_1 / title_test_2 / title_test_3
for (const key of Object.keys(CARDS)) {
	Instance.RegisterCheatCommand(`${CHEAT_PREFIX}_test_${key}`, () => {
		ShowCard(Number(key));
		Log(`测试：显示第 ${key} 张报幕（${CARDS[key] ? CARDS[key].line1 : "-"}）`);
	});
}

Instance.RegisterCheatCommand(`${CHEAT_PREFIX}_test_hide`, () => {
	Hide();
	Log("测试：收起报幕");
});
