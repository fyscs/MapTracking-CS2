// mydemons_lyrics.js
// STARSET - My Demons 底部双语歌词 HUD（剪辑版 67.755s）
//
// ┌──────────────────────────────────────────────────────────────────────────┐
// │ 这是 CS2 的 cs_script 模块（ES module），只能由游戏加载。                    │
// │ 双击用系统 JScript 打开会报编译错误，那是正常的，用记事本/VS Code 看。       │
// └──────────────────────────────────────────────────────────────────────────┘
//
// 独立脚本：不挂到已有的 backrooms_hud 上。
// 【不自动播放】——只等你用 IO 触发下列 script input：
//     md_play      从头开始播放歌词
//     md_restart   同 md_play
//     md_stop      停止并淡出
//     md_toggle    播放 / 停止
//
// Hammer 里用法：放一个 point_script 实体，
//     cs_script = maps/scripts/mydemons_lyrics.vjs
// 然后用你的 IO（trigger 的 OnStartTouch、逻辑门的 Out 等）触发它的 md_play。
// 音乐由地图里已有的 objmusic 实体负责；本脚本只显示歌词，不碰音乐。
//
// 时间轴：全部按用户实听的【结尾戳】换算（本行开始 = 上一行结束）；第 4 句未标取中点 18.5。

import { Instance, Entities } from "cs_script/point_script";

const LAYOUT_NAME = "md_lyrics_hud";
const LAYOUT_FILE = "panorama/layout/custom_game/mydemons_lyrics.vxml";

const SONG_LENGTH = 67.0;
const TICK = 0.03;
// 歌词整体比音乐早 0.5s，统一延后：从播放起算时减去该偏移。
const LYRICS_DELAY = 0.5;

// [开始显示时间(秒), 英文原词, 中文翻译]
// 用户给的是【结尾戳】——该句显示到该时间结束。这里已换算成开始时间：
//   本行开始 = 上一行结束。第一行从 0 开始。
// 用户结尾戳: 5 / 10 / 16 / (18.5) / 21 / 23 / 32 / 35 / 43 / 47 / 49 / 52 / 59 / 63.5(末句+0.5) / 67
// 第4句 "I know you're watching" 用户未标，取 16 与 21 的中点 18.5。
const LINES = [
    { t:  0.00, en: "I cannot stop this sickness taking over",       zh: "我无法阻止疾病肆虐" },
    { t:  5.00, en: "It takes control and drags me into nowhere",    zh: "它支配了我，带我沉入荒无人烟之境" },
    { t: 10.00, en: "I need your help, I can't fight this forever",  zh: "我需要你伸出援手，我无法永远孤身奋战" },
    { t: 16.00, en: "I know you're watching,",                       zh: "我知道你在注视着我" },
    { t: 18.50, en: "I can feel you out there",                      zh: "我能感觉到你就在那里" },
    { t: 21.00, en: "Take me high and I'll sing",                    zh: "带我高飞远翔，我将引吭高歌" },
    { t: 23.00, en: "Oh you make everything okay (okay, okay)",      zh: "你让一切安好" },
    { t: 32.00, en: "We are one in the same",                        zh: "我们同声相应，同气相求" },
    { t: 35.00, en: "Oh you take all of the pain away (away, away)", zh: "你抹去了我所有的伤痛" },
    { t: 43.00, en: "Save me if I become",                           zh: "若我沦为——救我" },
    { t: 47.00, en: "My demons",                                     zh: "我自己的恶魔" },
    { t: 49.00, en: "Take me high and I'll sing",                    zh: "带我高飞远翔，我将引吭高歌" },
    { t: 52.00, en: "Oh you make everything okay (okay, okay)",      zh: "你让一切安好" },
    { t: 59.00, en: "Save me if I become",                           zh: "若我沦为——救我" },
    // 最后一句：Save me 唱完后额外等 0.5s 再进 My demons（用户要求）
    { t: 63.50, en: "My demons...",                                  zh: "我自己的恶魔" },
];

let layoutEntity = null;
let lastSpawnTry = -99.0;
let playing = false;
let generation = 0;
let startT = 0;
let activeLine = -1;

function GetLayout() {
    if (layoutEntity && layoutEntity.IsValid && layoutEntity.IsValid()) {
        return layoutEntity;
    }
    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0] && found[0].IsValid()) {
        layoutEntity = found[0];
        return layoutEntity;
    }
    const now = Instance.GetGameTime();
    if (now - lastSpawnTry < 2.0) {
        return null;
    }
    lastSpawnTry = now;
    const spawned = (() => {
        try {
            return Entities.Spawn([{
                classname: "custom_hud_layout",
                targetname: LAYOUT_NAME,
                layout: LAYOUT_FILE,
            }]);
        } catch (err) {
            return null;   // Spawn is experimental: never let it kill the script
        }
    })();
    if (spawned && spawned.length > 0 && spawned[0]) {
        layoutEntity = spawned[0];
        return layoutEntity;
    }
    return null;
}

function ShowLine(layout, index) {
    if (index === activeLine) {
        return;
    }
    // All 15 lines are fixed in the layout; just light up the current one.
    // This uses SetHasClass only -- the same mechanism the working
    // backrooms HUD uses -- so no dialog variables are involved.
    if (activeLine >= 0) {
        layout.SetHasClass("md_line_" + activeLine, "On", false);
    }
    layout.SetHasClass("md_line_" + index, "On", true);
    activeLine = index;

    layout.SetHasClass("md_wrap", "Show", true);
}

function HideAll() {
    const l = GetLayout();
    if (!l) {
        return;
    }
    if (activeLine >= 0) {
        l.SetHasClass("md_line_" + activeLine, "On", false);
    }
    l.SetHasClass("md_wrap", "Show", false);
    activeLine = -1;
}

function Think(token) {
    if (token !== generation || !playing) {
        return;
    }
    const t = Instance.GetGameTime() - startT - LYRICS_DELAY;
    if (t >= SONG_LENGTH) {
        Stop();
        return;
    }

    const layout = GetLayout();
    if (layout) {
        let idx = -1;
        for (let i = 0; i < LINES.length; i++) {
            if (t >= LINES[i].t) {
                idx = i;
            } else {
                break;
            }
        }
        if (idx < 0) {
            if (activeLine !== -1) {
                HideAll();
            }
        } else {
            ShowLine(layout, idx);
        }
    }
    // re-arm every tick so the timeline keeps advancing
    Instance.Delay(TICK).then(() => Think(token));
}

function Play() {
    generation++;
    const token = generation;
    if (GetLayout()) {
        HideAll();
    }
    playing = true;
    startT = Instance.GetGameTime();
    activeLine = -1;
    Instance.Delay(TICK).then(() => Think(token));
}

function Stop() {
    generation++;
    playing = false;
    HideAll();
}

// ---- IO inputs: wire these from your Hammer logic ----
Instance.OnScriptInput("md_play", () => { Play(); });
Instance.OnScriptInput("md_restart", () => { Play(); });
Instance.OnScriptInput("md_stop", () => { Stop(); });
Instance.OnScriptInput("md_toggle", () => { playing ? Stop() : Play(); });

Instance.OnActivate(() => {
    GetLayout();   // pre-spawn so the first IO trigger has no delay
});
