// https://github.com/Kxnrl

// level4_intro.js
// Standalone opening title card for ze_backroom_level4_v1.
//
// This is a SEPARATE cs_script module - it does not touch backrooms_hud.js.
// Map setup: one point_script entity, cs_script = maps/scripts/level4_intro.vjs
// The HUD layout is spawned by this script at runtime, so no custom_hud_layout
// entity and no IO wiring are needed. It auto-plays once on activate.
//
// Timeline (five seconds, only fade in / fade out + zoom OUT, no fx):
//   0.0s  full black screen, title hidden
//   0.06s black starts fading out (map revealed)
//   0.40s title starts fading in
//   0.0-5.0s title zooms OUT (scale 1.25 -> 0.80), stepped across 25 classes
//   4.00s title starts fading out
//   5.0s  everything settled, black stays cleared
//
// Inputs:
//   intro_play    replay the opening sequence
//
// Note: this is a cs_script ES module; opening it with double-click / JScript
// shows a compile error - that is the Windows script host, not a real bug.

import { Instance, Entities } from "cs_script/point_script";

// The layout entity in the map is named level4_intro_HUD (capital HUD).
// Try that first, then the lowercase spelling as a fallback.
const LAYOUT_NAMES = ["level4_intro_HUD", "level4_intro_hud"];
const LAYOUT_FILE = "panorama/layout/custom_game/level4_intro.vxml";

const AUTO_PLAY = true;
const AUTO_DELAY = 0.35;

const INTRO_TOTAL = 5.0;
const INTRO_STEPS = 25;                                   // Z00..Z24
const INTRO_STEP_SECONDS = (INTRO_TOTAL - 0.06) / (INTRO_STEPS - 1);
const FADE_BLACK_AT = 0.06;
const TITLE_IN_AT = 0.40;
const TITLE_OUT_AT = 4.00;

let layoutEntity = null;
let lastTry = -99.0;
let token = 0;

function GetLayout() {
    if (layoutEntity && layoutEntity.IsValid && layoutEntity.IsValid()) {
        return layoutEntity;
    }
    for (const name of LAYOUT_NAMES) {
        const found = Entities.FindByName(name);
        if (found && found.length > 0 && found[0] && found[0].IsValid()) {
            layoutEntity = found[0];
            return layoutEntity;
        }
    }
    const now = Instance.GetGameTime();
    if (now - lastTry < 2.0) {
        return null;
    }
    lastTry = now;
    const spawned = (() => {
        try {
            return Entities.Spawn([
                {
                    classname: "custom_hud_layout",
                    targetname: LAYOUT_NAMES[0],
                    layout: LAYOUT_FILE,
                },
            ]);
        } catch (err) {
            return null;    // Spawn is experimental: never let it kill the script
        }
    })();
    if (spawned && spawned.length > 0 && spawned[0]) {
        layoutEntity = spawned[0];
        return layoutEntity;
    }
    return null;
}

function ZoomName(i) {
    return "Z" + (i < 10 ? "0" : "") + i;
}

function ClearZoom(layout) {
    for (let i = 0; i < INTRO_STEPS; i++) {
        layout.SetHasClass("intro_title", ZoomName(i), false);
    }
}

function PlayFrame(layout, myToken) {
    // reset: black opaque, title hidden, zoom at the largest step
    ClearZoom(layout);
    layout.SetHasClass("intro_black", "Fade", false);
    layout.SetHasClass("intro_title", "Show", false);
    layout.SetHasClass("intro_title", ZoomName(0), true);

    // 1) black fades out -> map revealed
    Instance.Delay(FADE_BLACK_AT).then(() => {
        if (myToken !== token) return;
        const l = GetLayout();
        if (l) l.SetHasClass("intro_black", "Fade", true);
    });

    // 2) title fades in
    Instance.Delay(TITLE_IN_AT).then(() => {
        if (myToken !== token) return;
        const l = GetLayout();
        if (l) l.SetHasClass("intro_title", "Show", true);
    });

    // 3) title fades out
    Instance.Delay(TITLE_OUT_AT).then(() => {
        if (myToken !== token) return;
        const l = GetLayout();
        if (l) l.SetHasClass("intro_title", "Show", false);
    });

    // 4) zoom OUT, stepped across the whole five seconds
    let i = 0;
    const step = () => {
        if (myToken !== token) return;
        if (i + 1 >= INTRO_STEPS) return;
        const l = GetLayout();
        if (l) {
            l.SetHasClass("intro_title", ZoomName(i), false);
            i++;
            l.SetHasClass("intro_title", ZoomName(i), true);
        } else {
            i++;
        }
        Instance.Delay(INTRO_STEP_SECONDS).then(step);
    };
    Instance.Delay(FADE_BLACK_AT).then(step);

    // 5) clean up at the end so a replay starts fresh
    Instance.Delay(INTRO_TOTAL + 0.1).then(() => {
        if (myToken !== token) return;
        const l = GetLayout();
        if (l) {
            ClearZoom(l);
            l.SetHasClass("intro_title", "Show", false);
            l.SetHasClass("intro_black", "Fade", true);   // keep the map visible
        }
    });
}

function Play() {
    const myToken = ++token;
    const layout = GetLayout();
    if (!layout) {
        Instance.Delay(0.25).then(() => {
            if (myToken === token) {
                const l = GetLayout();
                if (l) PlayFrame(l, myToken);
            }
        });
        return;
    }
    PlayFrame(layout, myToken);
}

// Map IO fires br_play -> RunScriptInput, so accept both names.
Instance.OnScriptInput("intro_play", () => { Play(); });
Instance.OnScriptInput("br_play", () => { Play(); });

Instance.OnActivate(() => {
    if (!AUTO_PLAY) return;
    Instance.Delay(AUTO_DELAY).then(() => {
        Play();
    });
});
