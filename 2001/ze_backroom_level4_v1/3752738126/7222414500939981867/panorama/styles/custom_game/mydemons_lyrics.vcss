.MDRoot {
    width: 100%;
    height: 100%;
}
.MDWrap {
    width: 1600px;
    height: 100px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 130px;
    opacity: 0.0;
    transition-property: opacity;
    transition-duration: 0.55s;
    transition-timing-function: ease-in-out;
}
.MDWrap.Show {
    opacity: 1.0;
}
.MDLine {
    width: 100%;
    height: 100px;
    opacity: 0.0;
    transition-property: opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-in-out;
}
.MDLine.On {
    opacity: 1.0;
}
@keyframes 'md-flame' {
    0% {
        color: #ff5a00;
    }
50% {
        color: #ffd24a;
    }
100% {
        color: #ff5a00;
    }
}
@keyframes 'md-flame-soft' {
    0% {
        color: #ff5a00;
    }
50% {
        color: #ffd24a;
    }
100% {
        color: #ff5a00;
    }
}
.MDEn {
    width: 100%;
    height: 42px;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 6px;
    text-align: center;
    font-family: Stratum2, "Arial Unicode MS";
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #ff8a1a;
    text-shadow: 0px 0px 8px #ff6a00;
    animation-name: md-flame;
    animation-duration: 1.6s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    white-space: nowrap;
}
.MDZh {
    width: 100%;
    height: 30px;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 45px;
    text-align: center;
    font-family: "Noto Sans SC", Stratum2, "Arial Unicode MS";
    font-size: 19px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #ffc27a;
    text-shadow: 0px 0px 5px #ff6a00;
    animation-name: md-flame;
    animation-duration: 1.6s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    white-space: nowrap;
}
