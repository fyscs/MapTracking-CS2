// Generated by StarDance
// https://github.com/Kxnrl

// backrooms_hud.js
// Screen-centre BACKROOMS / Level 4 title for ze_backroom_level4_v1.
//
// ┌──────────────────────────────────────────────────────────────────────────┐
// │ 这是 CS2 的 cs_script 模块（ES module），只能由游戏加载，                    │
// │ 双击运行会弹出 "Windows Script Host / Microsoft JScript 编译错误"，         │
// │ 那不是脚本有 bug —— 系统自带的 JScript 不认识 import 语法。                │
// │ 想看代码请右键 → 打开方式 → 记事本 / VS Code。                             │
// └──────────────────────────────────────────────────────────────────────────┘
//
// Runs on a single `point_script` entity. The HUD layout entity is created by this
// script at runtime, so the map needs no custom_hud_layout entity and no wiring.
//
// Map setup: one point_script entity, cs_script = maps/scripts/backrooms_hud.vjs
//
// Names:
//     br_play        one shot: six seconds, then it is gone
//     br_show        same reveal, but it stays up until br_hide
//     br_ignite      br_show with the flash burst
//     br_hide        fade the title out
//     br_toggle      show / hide
//     br_reset       clear every override, back to hidden
//
//   independent spark layer (works with or without the title):
//     br_spark_on / br_spark_off / br_spark_toggle
//
// The zoom is stepped by this script (31 classes on the dolly, one every 0.194s)
// rather than by one long CSS transition, so it always advances.

import { Instance, Entities } from "cs_script/point_script";

const LAYOUT_NAME = "br_logo_hud";
const LAYOUT_FILE = "panorama/layout/custom_game/backrooms_logo.vxml";

const AUTO_PLAY_ON_START = false;
const AUTO_PLAY_DELAY = 2.5;

// keep these in sync with panorama/styles/custom_game/backrooms_logo.css
const TOTAL_SECONDS = 6.0;
const OUT_SECONDS = 1.5;
const HOLD_SECONDS = TOTAL_SECONDS - OUT_SECONDS;
const REVEAL_START = 0.10;
const REVEAL_STEP = 0.075;
const HANDOFF_SECONDS = REVEAL_START + REVEAL_STEP * 6 + 0.05;
const SWEEP_SECONDS = 1.60;
const FLASH_SECONDS = 0.10;

// 31 zoom steps across the full six seconds
const ZOOM_STEPS = 31;
const ZOOM_STEP_SECONDS = TOTAL_SECONDS / (ZOOM_STEPS - 1);

const LIVE_PANELS = [
    "br_stage",
    "br_backing",
    "br_glow",
    "br_sweep",
    "br_vignette",
];

const REVEAL = [
    "br_reveal_1", "br_reveal_2", "br_reveal_3",
    "br_reveal_4", "br_reveal_5", "br_reveal_6",
];

const SLICES = [
    "br_slice_1", "br_slice_2", "br_slice_3",
    "br_slice_4", "br_slice_5", "br_slice_6",
];

const JITTER = ["JitA", "JitB", "JitC", "JitD"];      // left / right / up / down
const DIRS = ["Dir1", "Dir2", "Dir3", "Dir4", "Dir5", "Dir6"];   // random offset per piece

let visible = false;
let generation = 0;
let fxToken = 0;
let zoomToken = 0;
let zoomIndex = 0;
let sparkPinned = false;      // true when the spark layer was switched on by itself
let layoutEntity = null;
let lastSpawnTry = -99.0;

function GetLayout() {
    if (layoutEntity && layoutEntity.IsValid && layoutEntity.IsValid()) {
        return layoutEntity;
    }

    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0] && found[0].IsValid()) {
        layoutEntity = found[0];
        return layoutEntity;
    }

    const now = Instance.GetGameTime();
    if (now - lastSpawnTry < 2.0) {
        return null;
    }
    lastSpawnTry = now;

    const spawned = (() => {
        try {
            return Entities.Spawn([
                {
                    classname: "custom_hud_layout",
                    targetname: LAYOUT_NAME,
                    layout: LAYOUT_FILE,
                },
            ]);
        } catch (err) {
            return null;    // Spawn is experimental: never let it kill the script
        }
    })();
    if (spawned && spawned.length > 0 && spawned[0]) {
        layoutEntity = spawned[0];
        return layoutEntity;
    }
    return null;
}

function StepName(i) {
    return "S" + (i < 10 ? "0" : "") + i;
}

// ---------------------------------------------------------------- zoom
function ClearZoom(layout) {
    for (let i = 0; i < ZOOM_STEPS; i++) {
        layout.SetHasClass("br_dolly", StepName(i), false);
    }
}

// Runs for the full six seconds even after the fade starts, so the title keeps
// growing while it disappears.
function RunZoom(layout, token) {
    zoomIndex = 0;
    layout.SetHasClass("br_dolly", StepName(0), true);

    const step = () => {
        if (token !== zoomToken) {
            return;
        }
        if (zoomIndex + 1 >= ZOOM_STEPS) {
            return;
        }
        layout.SetHasClass("br_dolly", StepName(zoomIndex), false);
        zoomIndex++;
        layout.SetHasClass("br_dolly", StepName(zoomIndex), true);
        Instance.Delay(ZOOM_STEP_SECONDS).then(step);
    };
    Instance.Delay(ZOOM_STEP_SECONDS).then(step);
}

// ---------------------------------------------------------------- sparks
function SparksOn(layout) {
    layout.SetHasClass("br_spark_wrap", "Live", true);
}

function SparksOff(layout) {
    layout.SetHasClass("br_spark_wrap", "Live", false);
}

// ---------------------------------------------------------------- glitch
function ClearGlitch(layout) {
    for (const id of SLICES) {
        layout.SetHasClass(id, "On", false);
        for (const dir of DIRS) {
            layout.SetHasClass(id, dir, false);
        }
    }
    for (const cls of JITTER) {
        layout.SetHasClass("br_stage", cls, false);
    }
    layout.SetHasClass("br_glow", "Spike", false);
    layout.SetHasClass("br_vignette", "Dip", false);
}

function FireGlitch(layout, pieces) {
    for (let i = 0; i < pieces; i++) {
        const id = SLICES[Math.floor(Math.random() * SLICES.length)];
        // every piece jumps a different way, so the break never looks linear
        const dir = DIRS[Math.floor(Math.random() * DIRS.length)];
        layout.SetHasClass(id, dir, true);
        layout.SetHasClass(id, "On", true);
    }
    if (Math.random() < 0.50) {
        layout.SetHasClass("br_stage", JITTER[Math.floor(Math.random() * 2)], true);
    }
    if (Math.random() < 0.34) {
        layout.SetHasClass("br_glow", "Spike", true);
    }
    if (Math.random() < 0.22) {
        layout.SetHasClass("br_vignette", "Dip", true);
    }
}

function GlitchLoop(token) {
    if (token !== fxToken || !visible) {
        return;
    }
    const layout = GetLayout();
    if (!layout) {
        Instance.Delay(0.2).then(() => GlitchLoop(token));
        return;
    }

    const pieces = 1 + Math.floor(Math.random() * 3);
    FireGlitch(layout, pieces);

    const dwell = 0.05 + Math.random() * 0.11;
    Instance.Delay(dwell).then(() => {
        if (token !== fxToken) {
            return;
        }
        const l = GetLayout();
        if (l) {
            ClearGlitch(l);
        }
        const gap = 0.20 + Math.random() * 0.55;
        Instance.Delay(gap).then(() => GlitchLoop(token));
    });
}

// ---------------------------------------------------------------- reveal
function RunReveal(layout, token) {
    let i = 0;
    const step = () => {
        if (token !== fxToken) {
            return;
        }
        if (i >= REVEAL.length) {
            return;
        }
        layout.SetHasClass(REVEAL[i], "On", true);
        i++;
        Instance.Delay(REVEAL_STEP).then(step);
    };
    step();
}

function ClearReveal(layout) {
    for (const id of REVEAL) {
        layout.SetHasClass(id, "On", false);
    }
}

// ---------------------------------------------------------------- show / hide
function Show(flash) {
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    generation++;
    fxToken++;
    zoomToken++;
    const token = fxToken;
    const ztoken = zoomToken;

    ClearGlitch(layout);
    ClearReveal(layout);
    ClearZoom(layout);
    layout.SetHasClass("br_card", "Shown", false);

    if (flash) {
        layout.SetHasClass("br_flash", "On", true);
        Instance.Delay(FLASH_SECONDS).then(() => {
            const l = GetLayout();
            if (l) {
                l.SetHasClass("br_flash", "On", false);
            }
        });
    }

    for (const panel of LIVE_PANELS) {
        layout.SetHasClass(panel, "Leaving", false);
    }
    for (const panel of LIVE_PANELS) {
        layout.SetHasClass(panel, "Live", true);
    }
    if (!sparkPinned) {
        SparksOn(layout);
    }

    RunZoom(layout, ztoken);

    Instance.Delay(REVEAL_START).then(() => {
        if (token !== fxToken) {
            return;
        }
        const l = GetLayout();
        if (l) {
            RunReveal(l, token);
        }
    });
    Instance.Delay(HANDOFF_SECONDS).then(() => {
        if (token !== fxToken) {
            return;
        }
        const l = GetLayout();
        if (!l) {
            return;
        }
        l.SetHasClass("br_card", "Shown", true);
        ClearReveal(l);
    });

    Instance.Delay(SWEEP_SECONDS + 0.1).then(() => {
        const l = GetLayout();
        if (l && visible) {
            l.SetHasClass("br_sweep", "Live", false);
        }
    });

    visible = true;
    GlitchLoop(token);
}

function Hide() {
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    const myGeneration = ++generation;
    fxToken++;
    layout.SetHasClass("br_stage", "Leaving", true);

    Instance.Delay(OUT_SECONDS).then(() => {
        if (myGeneration !== generation) {
            return;
        }
        const l = GetLayout();
        if (!l) {
            return;
        }
        for (const panel of LIVE_PANELS) {
            l.SetHasClass(panel, "Live", false);
        }
        ClearGlitch(l);
        ClearReveal(l);
        ClearZoom(l);
        l.SetHasClass("br_card", "Shown", false);
        l.SetHasClass("br_stage", "Leaving", false);
        if (!sparkPinned) {
            SparksOff(l);
        }
        visible = false;
    });
}

function Play() {
    Show(true);
    const myGeneration = generation;
    Instance.Delay(HOLD_SECONDS).then(() => {
        if (myGeneration !== generation) {
            return;
        }
        Hide();
    });
}

function Reset() {
    generation++;
    fxToken++;
    zoomToken++;
    sparkPinned = false;
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    for (const panel of LIVE_PANELS) {
        layout.SetHasClass(panel, "Live", false);
    }
    ClearGlitch(layout);
    ClearReveal(layout);
    ClearZoom(layout);
    SparksOff(layout);
    layout.SetHasClass("br_card", "Shown", false);
    layout.SetHasClass("br_stage", "Leaving", false);
    visible = false;
}

Instance.OnScriptInput("br_play", () => {
    Play();
});

Instance.OnScriptInput("br_show", () => {
    Show(false);
});

Instance.OnScriptInput("br_ignite", () => {
    Show(true);
});

Instance.OnScriptInput("br_hide", () => {
    Hide();
});

Instance.OnScriptInput("br_toggle", () => {
    if (visible) {
        Hide();
    } else {
        Show(false);
    }
});

Instance.OnScriptInput("br_reset", () => {
    Reset();
});

// ---- independent spark layer ----
Instance.OnScriptInput("br_spark_on", () => {
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    sparkPinned = true;
    SparksOn(layout);
});

Instance.OnScriptInput("br_spark_off", () => {
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    sparkPinned = false;
    SparksOff(layout);
});

Instance.OnScriptInput("br_spark_toggle", () => {
    const layout = GetLayout();
    if (!layout) {
        return;
    }
    if (sparkPinned) {
        sparkPinned = false;
        SparksOff(layout);
    } else {
        sparkPinned = true;
        SparksOn(layout);
    }
});

Instance.OnActivate(() => {
    GetLayout();
    if (!AUTO_PLAY_ON_START) {
        return;
    }
    Instance.Delay(AUTO_PLAY_DELAY).then(() => {
        Play();
    });
});

Instance.OnRoundStart(() => {
    if (!visible) {
        return;
    }
    Reset();
});
