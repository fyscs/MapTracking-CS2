    "fullbright": "1",
    "enabled": "1",
    "message": "\u5DF4\u6258\u8389/Bathory\n\u6280\u80FD1\uFF1A\u5DE6\u952E\u91CA\u653E\u51CF\u901F\u7403\n\u6280\u80FD2\uFF1A\u53CC\u51FB\u53F3\u952E\u91CA\u653E\u4E00\u4E2A\u53EA\u5DE6\u53F3\u65B9\u5411\u7684\u5F15\u529B\u573A\uFF0C\u805A\u62E2\u50F5\u5C38\u540E\u7528\u6781\u51B0\u96F7\u67AA\u5C06\u5176\u63A8\u51FA\uFF0C\u51B7\u5374 60 \u79D2\n\u6280\u80FD3\uFF1A\u5934\u9876E\u91CA\u653E\uFF0C\u5728\u9020\u6210\u5927\u8303\u56F4\u7684\u51CF\u901F\u540E\uFF0C\u5BF9\u50F5\u5C38\u8FDB\u884C\u6BC1\u706D\u6253\u51FB\uFF0C\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21\n",
    "lightmapstatic": "0",
    "rendertocubemaps": "0",
    "object_culling": "0",
