        "limit": 1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]command",
        "input": "Command",
        "param": "say \u003C\u003C\u003C Time waits for no one. We need to get out of here as soon as possible \u003E\u003E\u003E",
