// 沉默中的羔羊
import { Instance } from "cs_script/point_script";

let baseHealth = 0;          // 触发时确定的T血量
let activated = false;       // 是否已触发

Instance.OnRoundStart(() => {
     baseHealth = 0;          
     activated = false; 
});

// 根据当前CT人数设置所有T玩家的血量
function applyTHPByCT() {
    let players = Instance.FindEntitiesByClass("player");
    let ctCount = 0;
    let tPlayers = [];

    for (let i = 0; i < players.length; i++) {
        let p = players[i];
        if (!p || !p.IsValid()) continue;
        if (p.GetTeamNumber() === 3) { // CT
            ctCount++;
        } else if (p.GetTeamNumber() === 2) { // T
            tPlayers.push(p);
        }
    }

   
    let newHealth = 50 * ctCount;
    baseHealth = newHealth;
    activated = true;

    for (let i = 0; i < tPlayers.length; i++) {
        let t = tPlayers[i];
        t.SetMaxHealth(1);
        t.SetHealth(newHealth);
    }
}

Instance.OnScriptInput("addhealth",() => {
        applyTHPByCT();
});

// 监听玩家复活/换队/回合重置（OnPlayerReset）
Instance.OnPlayerReset((event) => {
    let player = event.player;
    if (!activated) return;
    if (!player || !player.IsValid()) return;
    if (player.GetTeamNumber() !== 2) return; // 不是T

    player.SetMaxHealth(1);
    player.SetHealth(baseHealth);
});

