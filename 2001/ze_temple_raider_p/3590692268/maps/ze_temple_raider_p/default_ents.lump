      },
      {
        "output": "OnUser1",
        "target": "!self",
        "input": "RunScriptCode",
        "param": "function DoModifySpeed(Speed,Delay){EntFire(self.GetName(),Mfy,Speed,Delay,activator);};",
        "delay": 0,
        "limit": 1
      },
