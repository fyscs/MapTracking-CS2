// Generated by StarDance
// https://github.com/Kxnrl

import { Instance as I } from "cs_script/point_script";

const BEAM_DURATION = 3.0;

const BEAMS = [
    { beam: "guard_beam11", slow: "guard_slow_11" },
    { beam: "guard_beam12", slow: "guard_slow_12" },
    { beam: "guard_beam21", slow: "guard_slow_21" },
    { beam: "guard_beam22", slow: "guard_slow_22" },
    { beam: "guard_beam31", slow: "guard_slow_31" },
    { beam: "guard_beam32", slow: "guard_slow_32" },
    { beam: "guard_beam41", slow: "guard_slow_41" },
    { beam: "guard_beam42", slow: "guard_slow_42" }
];

let running = false;
let activeBeams = [];
let previousPair = "";


function FireInput(name, input) {
    I.EntFireAtName({
        name: name,
        input: input
    });
}

function StopAllBeams() {
    for (const item of BEAMS) {
        FireInput(item.beam, "Stop");
        FireInput(item.slow, "Disable");
    }

    activeBeams = [];
}

function GetRandomPair() {
    const pool = [...BEAMS];

    for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));

        [pool[i], pool[j]] = [pool[j], pool[i]];
    }

    const pair = [pool[0], pool[1]];

    const pairKey = pair
        .map(item => item.beam)
        .sort()
        .join("|");

    if (pairKey === previousPair) {
        pair[1] = pool[2];
    }

    previousPair = pair
        .map(item => item.beam)
        .sort()
        .join("|");

    return pair;
}

function StartBeamCycle() {
    if (!running) return;  
    activeBeams = GetRandomPair();
    for (const item of activeBeams) {
        FireInput(item.slow, "Enable");
        FireInput(item.beam, "Start");
    }

    I.SetNextThink(I.GetGameTime() + BEAM_DURATION);
}

function UpdateBeams() {
    if (!running) return;

    for (const item of activeBeams) {
        FireInput(item.beam, "Stop");
        FireInput(item.slow, "Disable");
    }

    activeBeams = [];

    StartBeamCycle();
}


I.OnScriptInput("StartSequence", () => {
    StopAllBeams();

    running = true;
    previousPair = "";

    StartBeamCycle();
});


I.OnScriptInput("StopSequence", () => {
    running = false;
    StopAllBeams();
});


I.OnRoundStart(() => {
    running = false;
    StopAllBeams();
    previousPair = "";
});


I.SetThink(UpdateBeams);
