import {
    Instance as I,
    CustomCameraMode,
    CSMoveType
} from "cs_script/point_script";

const BOSS_NAME = "Famfrit_Appear_Model";

const SCENE = {
    updateRate: 0.016,

    initialTime: 1.5,
    orbitTime: 9.0,
    zoomTime: 3.5,
    pullBackTime: 0.7,

    orbitRadius: 100,
    orbitHeight: 80,
    orbitAngle: 360,

    faceYaw: 90,

    faceDistance: 45,
    faceHeight: 80,

    focusHeight: 80,

    finalDistance: 750,
    finalHeight: 80,
    holdTime: 3.5
};

let sceneActive = false;
let sceneStartTime = 0;
let boss = undefined;
let thinkRegistered = false;

const playerCameras = new Map();


function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
}

function smoothStep(t) {
    t = clamp(t, 0, 1);
    return t * t * (3 - 2 * t);
}

function lerp(a, b, t) {
    return a + (b - a) * t;
}

function getBossPosition() {
    return boss.GetAbsOrigin();
}


function getForwardPosition(distance, height) {
    const origin = getBossPosition();

    const yaw = SCENE.faceYaw * Math.PI / 180;

    return {
        x: origin.x + Math.cos(yaw) * distance,
        y: origin.y + Math.sin(yaw) * distance,
        z: origin.z + height
    };
}

function getOrbitPosition(angle) {
    const origin = getBossPosition();

    const yaw = (
        SCENE.faceYaw + angle
    ) * Math.PI / 180;

    return {
        x: origin.x + Math.cos(yaw) * SCENE.orbitRadius,
        y: origin.y + Math.sin(yaw) * SCENE.orbitRadius,
        z: origin.z + SCENE.orbitHeight
    };
}

function getLookAngles(position) {
    const origin = getBossPosition();

    const target = {
        x: origin.x,
        y: origin.y,
        z: origin.z + SCENE.focusHeight
    };

    const dx = target.x - position.x;
    const dy = target.y - position.y;
    const dz = target.z - position.z;

    const horizontal = Math.sqrt(dx * dx + dy * dy);

    return {
        pitch: -Math.atan2(dz, horizontal) * 180 / Math.PI,
        yaw: Math.atan2(dy, dx) * 180 / Math.PI,
        roll: 0
    };
}

function getSceneDuration() {
    return SCENE.initialTime +
           SCENE.orbitTime +
           SCENE.zoomTime +
           SCENE.pullBackTime +
           SCENE.holdTime;
}


function getCameraPosition(elapsed) {
    const initialEnd = SCENE.initialTime;
    const orbitEnd = initialEnd + SCENE.orbitTime;
    const zoomEnd = orbitEnd + SCENE.zoomTime;

    if (elapsed < initialEnd) {
        return getForwardPosition(
            SCENE.orbitRadius,
            SCENE.orbitHeight
        );
    }

    if (elapsed < orbitEnd) {
        const t = (elapsed - initialEnd) / SCENE.orbitTime;

        const angle = SCENE.orbitAngle * t;

        return getOrbitPosition(angle);
    }

    if (elapsed < zoomEnd) {
        const t = (elapsed - orbitEnd) / SCENE.zoomTime;
        const progress = smoothStep(t);

        // Точка окончания облёта
        const startPosition = getOrbitPosition(
            SCENE.orbitAngle
        );

        // Точка перед лицом босса
        const endPosition = getForwardPosition(
            SCENE.faceDistance,
            SCENE.faceHeight
        );

        // Плавное движение от окончания облёта
        return {
            x: lerp(
                startPosition.x,
                endPosition.x,
                progress
            ),

            y: lerp(
                startPosition.y,
                endPosition.y,
                progress
            ),

            z: lerp(
                startPosition.z,
                endPosition.z,
                progress
            )
        };
    }

    const t = clamp(
        (elapsed - zoomEnd) / SCENE.pullBackTime,
        0,
        1
    );

    const distance = lerp(
        SCENE.faceDistance,
        SCENE.finalDistance,
        t
    );

    return getForwardPosition(
        distance,
        SCENE.finalHeight
    );
}

function setupPlayer(controller) {
    if (!controller?.IsConnected()) return undefined;

    const pawn = controller.GetPlayerPawn();

    if (!pawn?.IsValid() || !pawn.IsAlive()) {
        return undefined;
    }

    const camera = pawn.GetCustomCamera();

    if (!camera?.IsValid()) {
        return undefined;
    }

    const data = {
        controller: controller,
        pawn: pawn,
        camera: camera,
        originalMoveType: pawn.GetMoveType()
    };

    pawn.SetMoveType(CSMoveType.NONE);

    camera.SetMode(CustomCameraMode.CONTROLLED);

    return data;
}

function restorePlayer(data) {
    if (!data) return;

    if (data.camera?.IsValid()) {
        data.camera.SetMode(CustomCameraMode.DISABLED);
    }

    if (data.pawn?.IsValid()) {
        data.pawn.SetMoveType(data.originalMoveType);
    }
}

function syncPlayers() {
    const controllers = I.GetAllPlayerControllers();

    for (const controller of controllers) {
        if (!controller.IsConnected()) continue;

        const slot = controller.GetPlayerSlot();
        const pawn = controller.GetPlayerPawn();

        if (!pawn?.IsValid() || !pawn.IsAlive()) {
            const oldData = playerCameras.get(slot);

            if (oldData) {
                restorePlayer(oldData);

                oldData.pawn = undefined;
                oldData.camera = undefined;
                oldData.originalMoveType = undefined;
            }

            continue;
        }

        const oldData = playerCameras.get(slot);

        if (oldData && oldData.pawn === pawn) {
            continue;
        }

        if (oldData) {
            restorePlayer(oldData);
            playerCameras.delete(slot);
        }

        const newData = setupPlayer(controller);

        if (newData) {
            playerCameras.set(slot, newData);
        }
    }

    for (const [slot, data] of playerCameras) {
        if (!data.controller.IsConnected()) {
            restorePlayer(data);
            playerCameras.delete(slot);
        }
    }
}

function startBossScene() {
    if (sceneActive) return;

    boss = I.FindEntityByName(BOSS_NAME);

    if (!boss?.IsValid()) {
        I.Msg("Boss model not found!");
        return;
    }

    playerCameras.clear();

    syncPlayers();

    if (playerCameras.size === 0) {
        I.Msg("No players with valid cameras!");
        return;
    }

    sceneActive = true;
    sceneStartTime = I.GetGameTime();

    if (!thinkRegistered) {
        thinkRegistered = true;
        I.SetThink(updateAll);
    }

    I.SetNextThink(
        I.GetGameTime() + SCENE.updateRate
    );

    I.Msg("Boss scene started");
    I.Msg("Players with cameras: " + playerCameras.size);
}

function stopBossScene() {
    if (!sceneActive && playerCameras.size === 0) {
        return;
    }

    sceneActive = false;

    for (const data of playerCameras.values()) {
        restorePlayer(data);
    }

    playerCameras.clear();

    I.Msg("Boss scene finished");
}

function updateAll() {
    if (!sceneActive) return;

    if (!boss?.IsValid()) {
        I.Msg("Boss became invalid!");
        stopBossScene();
        return;
    }

    const elapsed = I.GetGameTime() - sceneStartTime;

    if (elapsed >= getSceneDuration()) {
        stopBossScene();
        return;
    }

    syncPlayers();

    const position = getCameraPosition(elapsed);

    const angles = getLookAngles(position);

    for (const data of playerCameras.values()) {
        if (!data.camera?.IsValid()) continue;

        data.camera.Move({
            position: position,
            angles: angles
        });
    }

    I.SetNextThink(
        I.GetGameTime() + SCENE.updateRate
    );
}

function resetSceneState() {
    stopBossScene();

    sceneActive = false;
    sceneStartTime = 0;
    boss = undefined;

    playerCameras.clear();
}

I.OnScriptInput("StartBossScene", () => {
    startBossScene();
});

I.OnScriptInput("StopBossScene", () => {
    stopBossScene();
});

I.OnRoundStart(() => {
    resetSceneState();
});

I.Msg("Boss camera loaded");
