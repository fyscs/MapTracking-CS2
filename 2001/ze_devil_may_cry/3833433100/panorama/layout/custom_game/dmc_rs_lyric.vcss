/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.LyricContainer {
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 120px;
    width: 85%;
    flow-children: down;
    visibility: visible;
    transition-property: opacity, visibility;
    transition-duration: 0.35s;
    transition-timing-function: ease;
}
.LyricContainer.Hidden {
    opacity: 0;
    visibility: collapse;
}
.LyricEn {
    horizontal-align: center;
    text-align: center;
    font-size: 37px;
    font-weight: bold;
    color: #ffffff;
    text-shadow: 0px 0px 8px #000000;
    margin-bottom: 4px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}
.LyricZh {
    horizontal-align: center;
    text-align: center;
    font-size: 30px;
    color: #ffffff;
    text-shadow: 0px 0px 6px #000000;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}
.LyricEn.FadedOut,.LyricZh.FadedOut {
    opacity: 0;
}
