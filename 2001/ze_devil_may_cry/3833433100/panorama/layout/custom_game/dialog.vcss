.Root {
    width: 100%;
    height: 100%;
}
.DialogBox {
    horizontal-align: center;
    vertical-align: center;
    flow-children: down;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}
.DialogBox.Visible {
    opacity: 1;
}
