.Root {
    width: 100%;
    height: 100%;
}
.CinemaBar {
    width: 100%;
    background-color: #000000;
    height: 0;
    transition-property: height;
    transition-duration: 0.6s;
}
.CinemaTop {
    horizontal-align: center;
    vertical-align: top;
}
.CinemaBottom {
    horizontal-align: center;
    vertical-align: bottom;
}
.CinemaBar.Open {
    height: 9%;
}
