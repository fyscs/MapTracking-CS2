/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.TipContainer {
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 100px;
    width: 90%;
    max-width: 1500px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}
.TipContainer.Visible {
    opacity: 1;
}
.TipBackground {
    width: 100%;
    height: 100%;
    background-color: #000000ee;
    border: 1px solid #333333;
}
.TipContent {
    width: 100%;
    flow-children: down;
    padding: 18px 24px;
}
.TipBox {
    width: 100%;
    flow-children: down;
}
.TipBox.Hidden {
    visibility: collapse;
}
.TipTitle {
    font-size: 26px;
    font-weight: bold;
    color: #FFffff;
    text-shadow: 1px 1px 3px #000000;
    margin-bottom: 8px;
    horizontal-align: left;
    text-align: left;
}
.TipLine {
    width: 100%;
    flow-children: right;
    margin-bottom: 6px;
}
.TipSeg {
    font-size: 20px;
    text-shadow: 1px 1px 2px #000000;
    text-align: left;
    text-overflow: clip;
    max-width: 100%;
}
.TipSeg.Normal {
    color: #ffffff;
}
.TipSeg.Red {
    color: #f37272;
    font-weight: bold;
}
.TipSeg.Gold {
    color: #FFD700;
    font-weight: bold;
}
.TipSeg.Blue {
    color: #72b0f3;
    font-weight: bold;
}
.TipSeg.Green {
    color: #44FF44;
    font-weight: bold;
}
