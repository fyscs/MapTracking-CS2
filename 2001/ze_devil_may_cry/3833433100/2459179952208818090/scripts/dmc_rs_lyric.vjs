    { t: 248.0, dur: 12,   en: "Does your dim heart heal or destroy?",    zh: "这颗黯淡的心，将会被救赎或是毁灭？" },
];

const LYRIC_HUD_NAME = "lyric_hud";
const THINK_INTERVAL = 0.1;
const FADE_DURATION = 0.3;
const FADE_OUT_LEAD_TIME = 0.5;

let lyricLayout = null;
let active = false;
let startTime = 0;
let currentIndex = -1;
let lineState = 0;
let fadeOutEndTime = 0;
let paused = false;
let pausedElapsed = 0;
let pausedFadeRemaining = 0;

function getLyricLayout() {
    if (lyricLayout && lyricLayout.IsValid()) return lyricLayout;
    lyricLayout = null;
    const found = Entities.FindByName(LYRIC_HUD_NAME);
    if (found && found.length > 0 && found[0].IsValid()) lyricLayout = found[0];
    return lyricLayout;
}

function setLyricText(en, zh) {
    const l = getLyricLayout();
    if (!l) return;
    l.SetDialogVariableString("lyric_en", "en", en);
    l.SetDialogVariableString("lyric_zh", "zh", zh);
}

function setContainerVisible(v) {
    const l = getLyricLayout();
    if (!l) return;
    l.SetHasClass("lyric_container", "Hidden", !v);
}

function setLineFaded(f) {
    const l = getLyricLayout();
    if (!l) return;
    l.SetHasClass("lyric_en", "FadedOut", f);
    l.SetHasClass("lyric_zh", "FadedOut", f);
}

function startLyrics() {
    const wasActive = active;
    active = true;
    paused = false;
    pausedElapsed = 0;
    pausedFadeRemaining = 0;
    startTime = Instance.GetGameTime();
    currentIndex = -1;
    lineState = 0;
    fadeOutEndTime = 0;
    setLineFaded(true);
    setLyricText("", "");
    if (!wasActive) setContainerVisible(true);
    Instance.SetNextThink(startTime + THINK_INTERVAL);
}

function stopLyrics() {
    if (!active) return;
    active = false;
    paused = false;
    pausedElapsed = 0;
    pausedFadeRemaining = 0;
    lineState = 0;
    currentIndex = -1;
    setLineFaded(true);
    setLyricText("", "");
    setContainerVisible(false);
    Instance.SetNextThink(Instance.GetGameTime() + 999999);
}

function pauseLyrics() {
    if (!active || paused) return;
    const now = Instance.GetGameTime();
    paused = true;
    pausedElapsed = now - startTime;
    pausedFadeRemaining = lineState === 2 ? Math.max(0, fadeOutEndTime - now) : 0;
    Instance.SetNextThink(now + 999999);
}

function unpauseLyrics() {
    if (!active || !paused) return;
    const now = Instance.GetGameTime();
    paused = false;
    startTime = now - pausedElapsed;
    if (lineState === 2) fadeOutEndTime = now + pausedFadeRemaining;
    Instance.SetNextThink(now + THINK_INTERVAL);
}

function lyricThink() {
    if (!active || paused) return;
    const now = Instance.GetGameTime();
    const elapsed = now - startTime;

    if (lineState === 2) {
        if (now < fadeOutEndTime) { Instance.SetNextThink(now + THINK_INTERVAL); return; }
        lineState = 0;
    }

    let idx = currentIndex < 0 ? 0 : currentIndex;
    while (idx + 1 < LYRICS.length && elapsed >= LYRICS[idx + 1].t) idx++;

    let target = -1;
    if (idx >= 0 && idx < LYRICS.length) {
        const line = LYRICS[idx];
        if (elapsed >= line.t && elapsed < line.t + line.dur) target = idx;
    }

    if (lineState === 0) {
        if (target >= 0 && target > currentIndex) {
            currentIndex = target;
            const line = LYRICS[target];
            setLyricText(line.en, line.zh);
            setLineFaded(false);
            lineState = 1;
        }
    } else if (lineState === 1) {
        const line = LYRICS[currentIndex];
        const lineEnd = line.t + line.dur;
        const lead = Math.min(FADE_OUT_LEAD_TIME, line.dur * 0.5);
        if (elapsed >= lineEnd - lead) {
            setLineFaded(true);
            lineState = 2;
            fadeOutEndTime = now + FADE_DURATION;
            Instance.SetNextThink(now + THINK_INTERVAL);
            return;
        }
    }

    if (currentIndex >= LYRICS.length - 1 && lineState !== 1) {
        const last = LYRICS[LYRICS.length - 1];
        if (elapsed > last.t + last.dur + 1.0) { stopLyrics(); return; }
    }
    Instance.SetNextThink(now + THINK_INTERVAL);
}

Instance.SetThink(lyricThink);

Instance.OnScriptInput("bury_start", startLyrics);
Instance.OnScriptInput("bury_stop", stopLyrics);
Instance.OnScriptInput("bury_pause", pauseLyrics);
Instance.OnScriptInput("bury_unpause", unpauseLyrics);
Instance.OnRoundStart(() => stopLyrics());

Console.Log("[Lyric] Bury the Light (M20 Ver.) 已加载（API迁移完成）。");