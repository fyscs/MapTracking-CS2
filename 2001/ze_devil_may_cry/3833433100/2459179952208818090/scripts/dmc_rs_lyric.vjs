import { Instance, Console, Entities } from "cs_script/point_script";

const LYRICS = [
    { t: 0.5,   dur: 5.5,  en: "Bury the light deep within",              zh: "将光明深埋心底" },
    { t: 7.2,   dur: 4.8,  en: "Cast aside, there's no coming home",      zh: "抛弃一切，已无归途" },
