const LAYOUT_NAME = "dialog_layout";
const ALL_STYLE_CLASSES = ["style_default", "style_title", "style_gold", "style_red", "boss_text"];

let layoutEntity = null;

function getLayout() {
    if (layoutEntity && layoutEntity.IsValid()) return layoutEntity;
    layoutEntity = null;
    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0].IsValid()) layoutEntity = found[0];
    return layoutEntity;
}

async function showDialog(dialogId, playerSlot = null) {
    const dialog = DIALOGS[dialogId];
    if (!dialog) { Console.Log("未知对话框: " + dialogId); return; }

    const layout = getLayout();
    if (!layout) { Console.Log("未找到对话框布局: " + LAYOUT_NAME); return; }

    const parts = (dialog.text || "").split("\n");
    const line1 = (parts[0] || "").trim();
    const line2 = (parts[1] || "").trim();

    // 全局显示：一次调用影响所有玩家
    if (playerSlot === null) {
        layout.SetDialogVariableString("dialog_line1", "line1", line1);
        layout.SetDialogVariableString("dialog_line2", "line2", line2);
        layout.SetHasClass("dialog_line2", "Empty", line2 === "");

        for (const cls of ALL_STYLE_CLASSES) {
            layout.SetHasClass("dialog_box", cls, false);
            layout.SetHasClass("dialog_line1", cls, false);
            layout.SetHasClass("dialog_line2", cls, false);
        }
        if (dialog.styleClass) {
            layout.SetHasClass("dialog_box", dialog.styleClass, true);
            layout.SetHasClass("dialog_line1", dialog.styleClass, true);
            layout.SetHasClass("dialog_line2", dialog.styleClass, true);
        }
        layout.SetHasClass("dialog_box", "Visible", true);

        await Instance.Delay(dialog.duration);
        if (getLayout()) layout.SetHasClass("dialog_box", "Visible", false);
        return;
    }

    // per-player
    const slot = playerSlot;
    layout.SetDialogVariableStringForPlayer(slot, "dialog_line1", "line1", line1);
    layout.SetDialogVariableStringForPlayer(slot, "dialog_line2", "line2", line2);
    layout.SetHasClassForPlayer(slot, "dialog_line2", "Empty", line2 === "");
    for (const cls of ALL_STYLE_CLASSES) {
        layout.SetHasClassForPlayer(slot, "dialog_box", cls, false);
        layout.SetHasClassForPlayer(slot, "dialog_line1", cls, false);
        layout.SetHasClassForPlayer(slot, "dialog_line2", cls, false);
    }
    if (dialog.styleClass) {
        layout.SetHasClassForPlayer(slot, "dialog_box", dialog.styleClass, true);
        layout.SetHasClassForPlayer(slot, "dialog_line1", dialog.styleClass, true);
        layout.SetHasClassForPlayer(slot, "dialog_line2", dialog.styleClass, true);
    }
    layout.SetHasClassForPlayer(slot, "dialog_box", "Visible", true);

    await Instance.Delay(dialog.duration);
    if (getLayout()) layout.SetHasClassForPlayer(slot, "dialog_box", "Visible", false);
}

Instance.OnActivate(() => {
    Console.Log("对话框脚本已加载");
    for (const id of Object.keys(DIALOGS)) {
        Instance.OnScriptInput(id, () => showDialog(id));
    }
    Console.Log(`已注册 ${Object.keys(DIALOGS).length} 个对话框`);
});

Instance.OnScriptReload({
    before: () => {
        const layout = getLayout();
        if (layout) {
            try { layout.SetHasClass("dialog_box", "Visible", false); } catch (e) { layoutEntity = null; }
        }
        return null;
    },
    after: () => Console.Log("对话框重载完成"),
});

Console.Log("对话框模块初始化完成");