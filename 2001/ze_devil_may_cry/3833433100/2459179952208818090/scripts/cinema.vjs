import { Instance, Console, Entities } from "cs_script/point_script";

const LAYOUT_NAME = "cinema_layout";
let layoutEntity = null;

function getLayout() {
    if (layoutEntity && layoutEntity.IsValid()) return layoutEntity;
    layoutEntity = null;
    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0].IsValid()) layoutEntity = found[0];
    return layoutEntity;
}

function openCinema() {
    const layout = getLayout();
    if (!layout) { Console.Log("未找到黑幕布局: " + LAYOUT_NAME); return; }
    // 全局一次设置即可影响所有玩家
    layout.SetHasClass("cinema_top", "Open", true);
    layout.SetHasClass("cinema_bottom", "Open", true);
    Console.Log("黑幕已展开");
}

function closeCinema() {
    const layout = getLayout();
    if (!layout) return;
    layout.SetHasClass("cinema_top", "Open", false);
    layout.SetHasClass("cinema_bottom", "Open", false);
    Console.Log("黑幕已收起");
}

Instance.OnActivate(() => {
    Console.Log("电影黑幕脚本已加载");
    Instance.OnScriptInput("cinema_open", openCinema);
    Instance.OnScriptInput("cinema_close", closeCinema);
});

Instance.OnScriptReload({
    before: () => { closeCinema(); return null; },
    after: () => Console.Log("电影黑幕重载完成"),
});

Console.Log("电影黑幕模块初始化完成");