    "reorient_mode": "0",
    "justify_vertical": "0",
    "justify_horizontal": "1",
    "font_name": "Arial Black",
    "font_size": "35.000000",
    "world_units_per_pixel": "0.100000",
    "color": "255 255 255",
    "fullbright": "1",
    "enabled": "1",
    "message": "\u00B7\u5DE6\u952E\uFF1A\u8FDE\u7EED\u6309\u5411\u524D\u8FDE\u7EED\u65A9\u51FB,\u6839\u636E\u65A9\u51FB\n\u505C\u6B62\u95F4\u9694\u8854\u63A5\u4EE5\u4F7F\u51FA\u6D3E\u751F\u8FDE\u51FB.\n\u003E\u6D3E\u751FA L\u002BL\u002BL\u002BL\n\u003E\u6D3E\u751FB L\u002BL\u002B\u505C\u987F\u002BL..\n\u003E\u6D3E\u751FC L\u002BL\u002BL\u002B\u505C\u987F\u002BL..\n\n\u00B7\u53F3\u952E\uFF1A\u5411\u51C6\u661F\u65B9\u5411\u4F7F\u7528\u5DE6\u8F6E\u5C04\u51FB,\u80FD\u51FB\u843D\u98DE\u884C\n\u548C\u90E8\u5206\u6B63\u5728\u4F7F\u7528\u6280\u80FD\u7684\u9B54\u7269,3\u53D1\u5F39\u5BB9\u540E\u9700\u8981\n\u6362\u5F39.\n\n\u00B7E\u952E\uFF1A\u7EA2\u5200,\u4E3A\u7EA2\u7687\u540E\u5145\u80FD,\u9700\u8981\u5728\u5DE6\u952E\u65A9\n\u51FB\u7ED3\u675F\u77AC\u95F4\u6309E\u80FD\u4E3A\u5200\u5145\u80FD,\u518D\u6B21\u65A9\u51FB\u91CA\u653E,\n\u7EA2\u5200\u65A9\u51FB\u76F8\u6BD4\u6B63\u5E38\u65A9\u51FB\u51FB\u9000\u548C\u8303\u56F4\u66F4\u5F3A.\n\n\u00B7S\u002BS\uFF1A\u5411\u540E\u95EA\u907F,1\u79D2\u65E0\u654C\u5E27.",
    "lightmapstatic": "0",
    "rendertocubemaps": "0",
