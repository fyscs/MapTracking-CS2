    "connections": [
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EDante: Round two!",
        "delay": 0.05000000074505806,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "!self",
        "input": "PlaySound",
        "param": "",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EDante: V,Get Nero out of here!This was a bad move!",
        "delay": 8,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003ENero: I can still fight!",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EDante: Nero,go!You\u0027re just dead weight.",
        "delay": 12.300000190734863,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003ENero: Back off!",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003ENero: That bastard called me dead weight!",
        "delay": 17.100000381469727,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003ENero: I didn\u0027t come all this way for nothing!",
        "delay": 19.149999618530273,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: Stop hitting yourself.",
        "delay": 22,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: And think of ways to get stronger and actually help.",
        "delay": 23.149999618530273,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: If dante loses...you are all that can defeat Urizen.",
        "delay": 26.25,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003ENero: Is that what you called him?",
        "delay": 32.06999969482422,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: Yes,Urizen,The demon king...",
        "delay": 33.099998474121094,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: That\u0027s the name of the demon that took your arm.",
        "delay": 37.06999969482422,
        "limit": 1
      }
    ]
  },
