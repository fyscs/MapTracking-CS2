        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: You should not underestimate this demon.",
        "delay": 5.269999980926514,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: After all,It was he who took your right arm...",
        "delay": 9.069999694824219,
        "limit": 1
      },
      {
        "output": "OnUser1",
        "target": "[PR#]Console",
        "input": "Command",
        "param": "say \u003EV: ...and gained a great deal of power from it.",
