/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.ShopPanel {
    horizontal-align: center;
    vertical-align: center;
    width: 500px;
    background-color: #000000dd;
    border: 2px solid #ffaa00;
    border-radius: 10px;
    padding: 20px;
    flow-children: down;
    opacity: 1;
    visibility: visible;
    transition-property: opacity, visibility;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}
.ShopPanel.Hidden {
    opacity: 0;
    visibility: collapse;
}
.TitleRow {
    flow-children: right;
    width: 100%;
    margin-bottom: 8px;
}
.Title {
    width: fill-parent-flow(1);
    font-size: 32px;
    color: #ffcc44;
    text-align: left;
    vertical-align: center;
}
.LangButton {
    width: 80px;
    height: 36px;
    background-color: #333333;
    border: 1px solid #888888;
    border-radius: 4px;
    vertical-align: center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.LangButton:hover {
    background-color: #555555;
    border-color: #ffaa44;
}
.LangButton Label {
    color: white;
    font-size: 16px;
    text-align: center;
    vertical-align: center;
    horizontal-align: center;
}
.WarningText {
    text-align: left;
    font-size: 15px;
    color: #ffffff;
    margin-bottom: 5px;
}
.WarningTextA {
    text-align: left;
    font-size: 14px;
    color: #f98585;
    margin-bottom: 5px;
}
.SoulsLabel {
    font-size: 20px;
    color: #ff4444;
    text-align: center;
    margin-bottom: 20px;
}
.ItemContainer {
    flow-children: right;
    width: 100%;
    background-color: #22222288;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 12px;
}
.ItemInfo {
    flow-children: down;
    width: fill-parent-flow(1);
}
.ItemName {
    font-size: 22px;
    color: #ffffff;
    font-weight: bold;
}
.ItemDesc {
    font-size: 14px;
    color: #aaaaaa;
}
.ItemPrice {
    font-size: 16px;
    color: #ffaa44;
    margin-top: 4px;
}
.BuyButton {
    width: 80px;
    height: 40px;
    background-color: #333333;
    border: 1px solid #888888;
    border-radius: 4px;
    margin-left: 10px;
    vertical-align: center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.BuyButton:hover {
    background-color: #555555;
    border-color: #ffaa44;
}
.BuyButton Label {
    color: white;
    font-size: 18px;
    text-align: center;
    vertical-align: center;
    horizontal-align: center;
}
.StatusLight {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin-left: 12px;
    vertical-align: center;
}
.StatusLight.Gray {
    background-color: #666666;
}
.StatusLight.Green {
    background-color: #33ff33;
}
.CloseButton {
    horizontal-align: center;
    margin-top: 20px;
    background-color: #aa3333;
    border: 1px solid #ff6666;
    border-radius: 6px;
    padding: 8px 30px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.CloseButton:hover {
    background-color: #cc4444;
    border-color: #ffaa44;
}
.CloseButton Label {
    color: white;
    font-size: 20px;
}
