.Root {
    width: 100%;
    height: 100%;
}
.HealthPanel {
    width: 200px;
    horizontal-align: left;
    margin-top: 350px;
    flow-children: down;
    padding: 10px 30px 20px 30px;
    background-color: #000000dd;
    border: 2px solid #888888;
    border-radius: 8px;
    transition-property: opacity, transform;
    transition-duration: 0.2s;
    opacity: 1;
    transform: scale3d(1, 1, 1);
}
.HealthPanel.Hidden {
    opacity: 0;
}
#health_text {
    color: #ffffff;
    font-size: 24px;
    font-weight: bold;
    text-align: left;
    white-space: nowrap;
}
