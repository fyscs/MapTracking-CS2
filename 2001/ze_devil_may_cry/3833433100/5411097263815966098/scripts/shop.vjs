// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Entity, CSMoveType } from "cs_script/point_script";

let shopLayout = null;

function GetShopLayout() {
    if (!(shopLayout instanceof Entity) || !shopLayout.IsValid()) {
        shopLayout = Instance.FindEntitiesByName("shop_layout")[0];
    }
    return shopLayout;
}

// ---------- 面板显示/隐藏（带移动锁定） ----------
function ShowShop(playerSlot) {
    const layout = GetShopLayout();
    if (!layout) {
        Instance.Msg("错误: 未找到 shop_layout 实体");
        return;
    }
    // 显示主面板，隐藏所有子面板
    layout.SetHasClassForPlayer(playerSlot, "shop_panel", "Hidden", false);
    layout.SetHasClassForPlayer(playerSlot, "panel_1", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_2", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_3", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_4", "Hidden", true);
    layout.SetInputCaptureEnabled(playerSlot, true);

    const player = Instance.GetPlayerController(playerSlot);
    if (player) {
        const pawn = player.GetPlayerPawn();
        if (pawn && pawn.IsValid()) {
            pawn.SetMoveType(CSMoveType.NONE);
        }
    }
}

function HideShop(playerSlot) {
    const layout = GetShopLayout();
    if (!layout) return;
    // 隐藏所有面板
    layout.SetHasClassForPlayer(playerSlot, "shop_panel", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_1", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_2", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_3", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_4", "Hidden", true);
    layout.SetInputCaptureEnabled(playerSlot, false);

    const player = Instance.GetPlayerController(playerSlot);
    if (player) {
        const pawn = player.GetPlayerPawn();
        if (pawn && pawn.IsValid()) {
            pawn.SetMoveType(CSMoveType.WALK);
        }
    }
}

function CloseShopForAllPlayers() {
    const layout = GetShopLayout();
    if (!layout) return;

    const players = Instance.GetAllPlayerControllers();
    for (const player of players) {
        if (player.IsConnected()) {
            const slot = player.GetPlayerSlot();
            layout.SetHasClassForPlayer(slot, "shop_panel", "Hidden", true);
            layout.SetHasClassForPlayer(slot, "panel_1", "Hidden", true);
            layout.SetHasClassForPlayer(slot, "panel_2", "Hidden", true);
            layout.SetHasClassForPlayer(slot, "panel_3", "Hidden", true);
            layout.SetHasClassForPlayer(slot, "panel_4", "Hidden", true);
            layout.SetInputCaptureEnabled(slot, false);

            const pawn = player.GetPlayerPawn();
            if (pawn && pawn.IsValid()) {
                pawn.SetMoveType(CSMoveType.WALK);
            }
        }
    }
    Instance.Msg("商店面板已为所有玩家关闭并恢复移动");
}

// ---------- 面板切换（通用） ----------
function SwitchToPanel(playerSlot, panelId) {
    const layout = GetShopLayout();
    if (!layout) return;
    // 先隐藏所有面板（除了主面板）
    layout.SetHasClassForPlayer(playerSlot, "shop_panel", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_1", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_2", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_3", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_4", "Hidden", true);
    // 再显示目标面板
    layout.SetHasClassForPlayer(playerSlot, panelId, "Hidden", false);
}

function SwitchToShopPanel(playerSlot) {
    const layout = GetShopLayout();
    if (!layout) return;
    // 显示主面板，隐藏所有子面板
    layout.SetHasClassForPlayer(playerSlot, "shop_panel", "Hidden", false);
    layout.SetHasClassForPlayer(playerSlot, "panel_1", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_2", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_3", "Hidden", true);
    layout.SetHasClassForPlayer(playerSlot, "panel_4", "Hidden", true);
}

// ---------- 购买处理（仅用于按钮5~8） ----------
function HandleItemPurchase(playerSlot, itemId) {
    const player = Instance.GetPlayerController(playerSlot);
    if (!player || !player.IsConnected()) return;
    HideShop(playerSlot); // 购买后关闭整个商店

    const targetMap = {
        "item_5": "item_relay5",
        "item_6": "item_relay6",
        "item_7": "item_relay7",
        "item_8": "item_relay8"
    };

    const targetName = targetMap[itemId];
    if (!targetName) {
        Instance.Msg(`未知商品: ${itemId}`);
        return;
    }

    Instance.EntFireAtName({
        name: targetName,
        input: "trigger",
        activator: player.GetPlayerPawn()
    });
    Instance.Msg(`玩家 ${player.GetPlayerName()} 购买了 ${itemId}，触发了 ${targetName}`);
}

// ---------- 事件监听 ----------

Instance.OnScriptInput("shop_button_pressed", ({ activator }) => {
    if (!activator) return;
    let playerController = null;
    if (typeof activator.GetPlayerController === 'function') {
        playerController = activator.GetPlayerController();
    } else if (typeof activator.GetPlayerSlot === 'function') {
        playerController = activator;
    }
    if (playerController && playerController.IsConnected()) {
        ShowShop(playerController.GetPlayerSlot());
    }
});

Instance.OnCustomHudClicked((event) => {
    if (event.layout !== GetShopLayout()) return;
    const playerSlot = event.player.GetPlayerSlot();
    const buttonId = event.buttonId;

    // 关闭按钮（所有面板共用）
    if (buttonId === "close_button") {
        HideShop(playerSlot);
        return;
    }

    // 返回主页按钮（子面板中的返回按钮）
    if (buttonId === "back_button") {
        SwitchToShopPanel(playerSlot);
        return;
    }

    // 切换面板：按钮1~4
    if (buttonId === "item_flashlight") {
        SwitchToPanel(playerSlot, "panel_1");
        return;
    }
    if (buttonId === "item_2") {
        SwitchToPanel(playerSlot, "panel_2");
        return;
    }
    if (buttonId === "item_3") {
        SwitchToPanel(playerSlot, "panel_3");
        return;
    }
    if (buttonId === "item_4") {
        SwitchToPanel(playerSlot, "panel_4");
        return;
    }

    // 购买：按钮5~8
    if (buttonId === "item_5" || buttonId === "item_6" || buttonId === "item_7" || buttonId === "item_8") {
        HandleItemPurchase(playerSlot, buttonId);
        return;
    }

    // 其他未识别按钮
    Instance.Msg(`未知按钮点击: ${buttonId}`);
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    const layout = GetShopLayout();
    if (layout) layout.SetInputCaptureEnabled(playerSlot, false);
});

Instance.OnRoundEnd(() => {
    CloseShopForAllPlayers();
});

Instance.OnRoundStart(() => {
    CloseShopForAllPlayers();
});

Instance.OnPlayerReset(({ player }) => {
    if (player && player.IsValid()) {
        player.SetMoveType(CSMoveType.WALK);
    }
});

Instance.Msg("UI已加载");