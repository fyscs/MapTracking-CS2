/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
}
.PlayersContainer {
    horizontal-align: left;
    vertical-align: top;
    margin-left: 20px;
    margin-top: 100px;
    flow-children: down;
    width: 250px;
}
.PlayerPanel {
    background-color: #00000088;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px 12px;
    flow-children: down;
    width: 282px;
    height: 132px;
    margin-bottom: 8px;
    transition-property: opacity, transform, height, padding;
    transition-duration: 0.2s;
    opacity: 1;
}
.PlayerPanel.Hidden {
    opacity: 0;
    transform: translateX(-20px);
    height: 0px;
    padding: 0px 12px;
    border: 0px solid transparent;
}
.PlayerName {
    font-size: 18px;
    color: #cccccc;
    font-weight: bold;
    width: 100%;
    text-overflow: ellipsis;
    overflow: clip;
}
.SoulsCount {
    font-size: 18px;
    color: #ff4444;
    font-weight: bold;
    text-align: right;
    width: 100%;
}
.PlayerPerks {
    font-size: 15px;
    color: #88dd88;
    text-align: left;
    width: 100%;
    margin-top: 2px;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.PlayerPerks.Hidden {
    opacity: 0;
    visibility: collapse;
}
.ExoCooldown {
    font-size: 15px;
    color: #ffffff;
    text-align: left;
    width: 100%;
    margin-top: 2px;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.ExoCooldown.Hidden {
    opacity: 0;
    visibility: collapse;
}
