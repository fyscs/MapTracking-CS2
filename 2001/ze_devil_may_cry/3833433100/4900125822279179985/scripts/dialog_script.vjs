const LAYOUT_NAME = "dialog_layout";

// 注意：这里补充了 boss_text
const ALL_STYLE_CLASSES = ["style_default", "style_title", "style_gold", "style_red", "boss_text"];

// ==================== 内部逻辑 ====================
let layoutEntity = null;

function getLayout() {
    if (!layoutEntity || !layoutEntity.IsValid()) {
        layoutEntity = Instance.FindEntitiesByName(LAYOUT_NAME)[0];
    }
    return layoutEntity;
}

/**
 * 显示对话框
 * @param {string} dialogId  DIALOGS 中的键名
 * @param {number} playerSlot  仅对指定玩家显示（可选，不传则对所有玩家显示）
 */
async function showDialog(dialogId, playerSlot = null) {
    const dialog = DIALOGS[dialogId];
    if (!dialog) {
        Instance.Msg("未知的对话框 ID: " + dialogId);
        return;
    }

    const layout = getLayout();
    if (!layout || !layout.IsValid()) {
        Instance.Msg("未找到对话框布局实体: " + LAYOUT_NAME);
        return;
    }

    // ---- 按 \n 拆分两行 ----
    const rawText = dialog.text || "";
    const parts = rawText.split("\n");
    const line1 = (parts[0] || "").trim();
    const line2 = (parts[1] || "").trim();  // 若没有第二行，则为空字符串

    // 决定对哪些玩家显示
    let slotsToShow = [];
    if (playerSlot !== null) {
        slotsToShow = [playerSlot];
    } else {
        for (const controller of Instance.GetAllPlayerControllers()) {
            if (controller && controller.IsValid() && controller.IsConnected()) {
                slotsToShow.push(controller.GetPlayerSlot());
            }
        }
    }

    // ---- 显示：设置文本 + 样式 + 淡入 ----
    for (const slot of slotsToShow) {
        // 1. 设置两行文本
        layout.SetDialogVariableStringForPlayer(slot, "dialog_line1", "line1", line1);
        layout.SetDialogVariableStringForPlayer(slot, "dialog_line2", "line2", line2);

        // 2. 第二行为空时折叠，避免占空间
        layout.SetHasClassForPlayer(slot, "dialog_line2", "Empty", line2 === "");

        // 3. 清除旧样式类（容器和两行都要清）
        for (const cls of ALL_STYLE_CLASSES) {
            layout.SetHasClassForPlayer(slot, "dialog_box", cls, false);
            layout.SetHasClassForPlayer(slot, "dialog_line1", cls, false);
            layout.SetHasClassForPlayer(slot, "dialog_line2", cls, false);
        }

        // 4. 应用新样式类
        if (dialog.styleClass) {
            layout.SetHasClassForPlayer(slot, "dialog_box", dialog.styleClass, true);
            layout.SetHasClassForPlayer(slot, "dialog_line1", dialog.styleClass, true);
            layout.SetHasClassForPlayer(slot, "dialog_line2", dialog.styleClass, true);
        }

        // 5. 添加 Visible 类 → CSS 触发淡入
        layout.SetHasClassForPlayer(slot, "dialog_box", "Visible", true);
    }

    // ---- 等待持续时间 ----
    await Instance.Delay(dialog.duration);

    // ---- 隐藏：移除 Visible 类 → CSS 触发淡出 ----
    for (const slot of slotsToShow) {
        layout.SetHasClassForPlayer(slot, "dialog_box", "Visible", false);
    }
}

// ==================== 触发方式：RunScriptInput ====================
Instance.OnActivate(() => {
    Instance.Msg("对话框脚本已加载（双行模式）");

    const ids = Object.keys(DIALOGS);
    for (const id of ids) {
        Instance.OnScriptInput(id, (inputData) => {
            showDialog(id);
        });
    }

    Instance.Msg("已注册 " + ids.length + " 个对话框输入: " + ids.join(", "));
});

// ==================== 重载支持 ====================
Instance.OnScriptReload({
    before: () => {
        const layout = getLayout();
        if (layout && layout.IsValid()) {
            for (const controller of Instance.GetAllPlayerControllers()) {
                if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;
                const slot = controller.GetPlayerSlot();
                layout.SetHasClassForPlayer(slot, "dialog_box", "Visible", false);
            }
        }
        return null;
    },
    after: () => {
        Instance.Msg("对话框脚本重载完成");
    },
});

Instance.Msg("对话框模块初始化完成");