import { Instance, Console, Entities, CSPlayerPawn, CSMoveType, CSInputs, CSGearSlot, CSWeaponType } from "cs_script/point_script";

// ==================== 配置 ====================
const HIT_COUNT_TO_REWARD = 5;
const CT_HIT_COUNT_TO_REWARD = 13;
const SOULS_HUD_NAME = "souls_hud";
const SHOP_HUD_NAME = "shop_hud";
const EXO_DASH_SPEED = 800;
const EXO_COOLDOWN = 10.0;
const BACKPACK_REFILL_INTERVAL = 1.0;
const EXO_CHECK_INTERVAL = 0.1;
const DASH_IMMUNITY_DURATION = 0.5;
const GLOBAL_THINK_INTERVAL = 0.1;
const CELL_HEAL_AMOUNT = 1;

const PRICE_ARMOR = 100;
const PRICE_EXO = 90;
const PRICE_BACKPACK = 130;
const PRICE_CELL = 120;

const COOLDOWN_UI_INTERVAL = 0.5;
const CLEANUP_INTERVAL = 5.0;
const HUD_FLUSH_INTERVAL = 0.25;

// ==================== 性能优化常量 ====================
const GUN_TYPES = new Set([
    CSWeaponType.PISTOL,
    CSWeaponType.RIFLE,
    CSWeaponType.SUBMACHINEGUN,
    CSWeaponType.SHOTGUN,
    CSWeaponType.SNIPER_RIFLE,
    CSWeaponType.MACHINEGUN
]);

const PERK_STRINGS = [
    "",
    "鳞甲",
    "外骨骼",
    "鳞甲·外骨骼",
    "背包",
    "鳞甲·背包",
    "外骨骼·背包",
    "鳞甲·外骨骼·背包",
    "细胞",
    "鳞甲·细胞",
    "外骨骼·细胞",
    "鳞甲·外骨骼·细胞",
    "背包·细胞",
    "鳞甲·背包·细胞",
    "外骨骼·背包·细胞",
    "鳞甲·外骨骼·背包·细胞"
];

let cachedGameTime = 0;
const DASH_VEL = { x: 0, y: 0, z: 0 };
const DASH_TELEPORT = { velocity: DASH_VEL };

// ==================== 商店文本 ====================
const SHOP_TEXT = {
    zh: {
        title: "红魂石商店(测试阶段)",
        warn1: "妮可：你这副肉身可没法硬纲那些魔物,算你好运,我们有不少魔物余料给你们做点小裙子,拿红魂石做交换吧!\n(·通过用枪械射击僵尸/作为僵尸感染人类有概率获得红魂石.)",
        warn2: "注意：当你拾取人类皮肤/变成僵尸后,这些增益会在该回合失效.\n当前关卡通关会消耗当前你购买的所有增益.",
        souls_prefix: "当前魂石：",
        armor_name: "鳞片装甲",
        armor_desc: "你受到来自BOSS等部分类型伤害减少20%.",
        armor_price: `价格：${PRICE_ARMOR} 魂石`,
        exo_name: "外骨骼辅助",
        exo_desc: "右键向准星方向冲刺,期间短暂免疫任何伤害.（冷却 10 秒）\n注意：由于防止占用服务器资源,对右键的检测间隔会很长,需要反复按才能触发.",
        exo_price: `价格：${PRICE_EXO} 魂石`,
        backpack_name: "补给背包",
        backpack_desc: "每秒会自动补充你枪械的主弹药,等同于无限子弹.",
        backpack_price: `价格：${PRICE_BACKPACK} 魂石`,
        cell_name: "自适应细胞",
        cell_desc: "每秒自动恢复 1 点生命值.",
        cell_price: `价格：${PRICE_CELL} 魂石`,
        buy: "购买",
        close: "关闭商店",
        lang_btn: "English",
    },
    en: {
        title: "Red Soulstone Shop (Beta)",
        warn1: "Nico: Your thin body can't handle those monsters. Lucky you, we have plenty of monster part to make you some toys.Trade them with Red Soulstones!\n(·Shooting zombies/infect humans as zombie has chance to gain Red Soulstones.)",
        warn2: "Note: If you are Human Character/become zombies will disable these perks for the current round.\nComplete current level will clear all purchased perks.",
        souls_prefix: "Current Red Soulstone: ",
        armor_name: "Scale Armor",
        armor_desc: "Reduces damage from all form of damage by 20%.",
        armor_price: `Price: ${PRICE_ARMOR} souls`,
        exo_name: "Exoskeleton Boost",
        exo_desc: "Right-click to dash toward the crosshair,gain 1 sec immune to all damage. (Cooldown: 10s)\nNote: To save server resources, the right-click check interval is long; you may need to press multiple times.",
        exo_price: `Price: ${PRICE_EXO} souls`,
        backpack_name: "Supply Backpack",
        backpack_desc: "Automatically refills your gun's ammo every second,just like infinite ammo.",
        backpack_price: `Price: ${PRICE_BACKPACK} souls`,
        cell_name: "Adaptive Cells",
        cell_desc: "Regenerates 1 HP per second.",
        cell_price: `Price: ${PRICE_CELL} souls`,
        buy: "Buy",
        close: "Close Shop",
        lang_btn: "中文",
    }
};

// ==================== 数据结构 ====================
const playerData = new Map();
const controllerToData = new WeakMap();
const dirtyHudPlayers = new Set();
const exoPlayers = new Set();
const backpackPlayers = new Set();
const cellPlayers = new Set();

let lastExoCheckTime = 0;
let lastBackpackRefillTime = 0;
let lastCooldownUpdateTime = 0;
let lastCleanupTime = 0;
let lastHudFlushTime = 0;

// ==================== HUD 缓存 ====================
let soulsLayout = null;
let shopLayout = null;

function resetAllHudCaches() {
    for (const [, data] of playerData) {
        data.lastName = "";
        data.lastSoulCountValue = -1;
        data.lastPerkMask = -1;
        data.lastCooldownDisplay = "";
        data.lastCooldownVisible = null;
    }
}

function getSoulsLayout() {
    if (soulsLayout && soulsLayout.IsValid()) return soulsLayout;
    soulsLayout = null;
    const found = Entities.FindByName(SOULS_HUD_NAME);
    if (found && found.length > 0 && found[0].IsValid()) {
        soulsLayout = found[0];
        // 新引用 → 重置所有玩家 HUD 缓存，确保下次 update 全量刷新
        resetAllHudCaches();
    }
    return soulsLayout;
}

function getShopLayout() {
    if (shopLayout && shopLayout.IsValid()) return shopLayout;
    shopLayout = null;
    const found = Entities.FindByName(SHOP_HUD_NAME);
    if (found && found.length > 0 && found[0].IsValid()) {
        shopLayout = found[0];
    }
    return shopLayout;
}

// ==================== 语言应用 ====================
function applyShopLanguage(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    const layout = getShopLayout();
    if (!layout) return;

    const text = SHOP_TEXT[data.shopLang || "zh"] || SHOP_TEXT.zh;
    for (const key in text) {
        layout.SetDialogVariableStringForPlayer(slot, "shop_panel", key, text[key]);
    }
}

// ==================== UI 更新 ====================
function updatePlayerHUD(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;

    const layout = getSoulsLayout();
    if (!layout) return;

    const panelId = data.panelId;

    // ★ 去掉 lastPanelVisible 缓存，每次都设置 → 保证重连后一定显示
    layout.SetHasClassForPlayer(slot, panelId, "Hidden", false);

    if (data.lastName !== data.playerName) {
        data.lastName = data.playerName;
        layout.SetDialogVariableStringForPlayer(slot, panelId, "name", data.playerName);
    }

    if (data.lastSoulCountValue !== data.soulCount) {
        data.lastSoulCountValue = data.soulCount;
        layout.SetDialogVariableStringForPlayer(slot, panelId, "count", data.soulCount.toString());
    }

    const mask = (data.armorPurchased ? 1 : 0) | (data.exoPurchased ? 2 : 0) |
                 (data.backpackPurchased ? 4 : 0) | (data.cellPurchased ? 8 : 0);
    if (data.lastPerkMask !== mask) {
        data.lastPerkMask = mask;
        const perkString = PERK_STRINGS[mask];
        layout.SetDialogVariableStringForPlayer(slot, panelId, "perks", perkString);
        layout.SetHasClassForPlayer(slot, data.perksLabelId, "Hidden", perkString === "");
    }
}

function updateExoCooldown(playerPawn, layout, now, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    if (!layout) {
        layout = getSoulsLayout();
        if (!layout) return;
    }
    if (now === undefined) now = Instance.GetGameTime();

    const panelId = data.panelId;
    const exoLabelId = data.exoLabelId;

    let hasExo = data.exoPurchased && data.gainsEnabled && data.exoEnabled;
    if (hasExo && data.teamNumber === 3) {
        hasExo = data.ctGainsEnabled;
    }

    if (hasExo) {
        const remaining = data.exoCooldownEnd - now;
        const display = remaining > 0 ? remaining.toFixed(1) : "就绪";
        if (data.lastCooldownDisplay !== display) {
            data.lastCooldownDisplay = display;
            layout.SetDialogVariableStringForPlayer(slot, panelId, "cooldown", display);
        }
        if (data.lastCooldownVisible !== true) {
            data.lastCooldownVisible = true;
            layout.SetHasClassForPlayer(slot, exoLabelId, "Hidden", false);
        }
    } else {
        if (data.lastCooldownVisible !== false) {
            data.lastCooldownVisible = false;
            layout.SetHasClassForPlayer(slot, exoLabelId, "Hidden", true);
            layout.SetDialogVariableStringForPlayer(slot, panelId, "cooldown", "");
            data.lastCooldownDisplay = "";
        }
    }
}

function updateShopUI(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    const layout = getShopLayout();
    if (!layout) return;

    layout.SetDialogVariableStringForPlayer(slot, "shop_panel", "souls", data.soulCount.toString());
    layout.SetHasClassForPlayer(slot, "armor_light", "Green", data.armorPurchased);
    layout.SetHasClassForPlayer(slot, "armor_light", "Gray", !data.armorPurchased);
    layout.SetHasClassForPlayer(slot, "exo_light", "Green", data.exoPurchased);
    layout.SetHasClassForPlayer(slot, "exo_light", "Gray", !data.exoPurchased);
    layout.SetHasClassForPlayer(slot, "backpack_light", "Green", data.backpackPurchased);
    layout.SetHasClassForPlayer(slot, "backpack_light", "Gray", !data.backpackPurchased);
    layout.SetHasClassForPlayer(slot, "cell_light", "Green", data.cellPurchased);
    layout.SetHasClassForPlayer(slot, "cell_light", "Gray", !data.cellPurchased);
}

// ==================== 补给背包 ====================
function refillMainWeapon(playerPawn, controller, slot) {
    if (!playerPawn || !playerPawn.IsAlive()) return;
    if (!controller) {
        controller = playerPawn.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data || !data.backpackPurchased) return;

    let perkEnabled = data.gainsEnabled;
    if (perkEnabled && data.teamNumber === 3) perkEnabled = data.ctGainsEnabled;
    perkEnabled = perkEnabled && data.backpackEnabled;
    if (!perkEnabled) return;

    const weapon = playerPawn.GetActiveWeapon();
    if (!weapon || !weapon.IsValid()) return;
    const maxClip = weapon.GetData().GetMaxClipAmmo();
    if (!maxClip) return;
    if (weapon.GetClipAmmo() < maxClip) weapon.SetClipAmmo(maxClip);
}

function applyBackpackImmediate(playerPawn, controller, slot) {
    refillMainWeapon(playerPawn, controller, slot);
}

// ==================== 自适应细胞 ====================
function healCellPlayer(playerPawn, controller, slot) {
    if (!playerPawn || !playerPawn.IsAlive()) return;
    if (!controller) {
        controller = playerPawn.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data || !data.cellPurchased) return;

    let perkEnabled = data.gainsEnabled;
    if (perkEnabled && data.teamNumber === 3) perkEnabled = data.ctGainsEnabled;
    perkEnabled = perkEnabled && data.cellEnabled;
    if (!perkEnabled) return;

    const maxHealth = playerPawn.GetMaxHealth();
    const currentHealth = playerPawn.GetHealth();
    if (currentHealth < maxHealth) {
        playerPawn.SetHealth(Math.min(currentHealth + CELL_HEAL_AMOUNT, maxHealth));
    }
}

// ==================== 商店开关 ====================
function openShop(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    const layout = getShopLayout();
    if (!layout) return;

    applyShopLanguage(playerPawn, controller, slot);
    layout.SetHasClassForPlayer(slot, "shop_panel", "Hidden", false);
    updateShopUI(playerPawn, controller, slot);
    playerPawn.SetMoveType(CSMoveType.NONE);
    data.shopOpen = true;
    layout.SetInputCaptureEnabled(slot, true);
}

function closeShop(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    const layout = getShopLayout();
    if (!layout) return;

    layout.SetHasClassForPlayer(slot, "shop_panel", "Hidden", true);
    data.shopOpen = false;
    if (playerPawn.IsAlive()) playerPawn.SetMoveType(CSMoveType.WALK);
    layout.SetInputCaptureEnabled(slot, false);
}

// ==================== 初始化玩家 ====================
function initPlayer(playerPawn, controller, slot) {
    if (!controller) {
        controller = playerPawn?.GetPlayerController();
        if (!controller) return;
    }
    if (slot === undefined) slot = controller.GetPlayerSlot();

    const name = controller.GetPlayerName() || `玩家${slot}`;
    const teamNumber = controller.GetTeamNumber();

    if (!playerData.has(slot)) {
        const data = {
            controller: controller,
            slot: slot,
            teamNumber: teamNumber,
            playerName: name,
            panelId: `player_panel_${slot}`,
            perksLabelId: `perks_label_${slot}`,
            exoLabelId: `exo_label_${slot}`,
            hitCount: 0,
            soulCount: 0,
            armorPurchased: false,
            exoPurchased: false,
            backpackPurchased: false,
            cellPurchased: false,
            gainsEnabled: true,
            backpackEnabled: true,
            ctGainsEnabled: true,
            exoEnabled: true,
            cellEnabled: true,
            exoCooldownEnd: 0,
            dashImmunityEnd: 0,
            shopOpen: false,
            shopLang: "zh",
            lastSoulCountValue: -1,
            lastPerkMask: -1,
            lastCooldownDisplay: "",
            lastCooldownVisible: null,
            lastName: "",
        };
        playerData.set(slot, data);
        controllerToData.set(controller, data);
    } else {
        const data = playerData.get(slot);
        data.controller = controller;
        data.teamNumber = teamNumber;
        data.playerName = name;
        data.hitCount = 0;
        // ★ 重连时重置所有 HUD 缓存 → 强制全量刷新，解决"重进看不见"问题
        data.lastName = "";
        data.lastSoulCountValue = -1;
        data.lastPerkMask = -1;
        data.lastCooldownDisplay = "";
        data.lastCooldownVisible = null;
        controllerToData.set(controller, data);
        if (data.shopOpen) closeShop(playerPawn, controller, slot);
    }

    const data = playerData.get(slot);
    if (data && data.backpackPurchased) {
        Instance.QueueAfterThinks(() => {
            if (playerPawn.IsAlive()) applyBackpackImmediate(playerPawn, controller, slot);
        });
    }
    dirtyHudPlayers.delete(slot);
    updatePlayerHUD(playerPawn, controller, slot);

    const layout = getSoulsLayout();
    if (layout) updateExoCooldown(playerPawn, layout, cachedGameTime || Instance.GetGameTime(), controller, slot);
}

// ==================== 外骨骼冲刺 ====================
function performDash(playerPawn, now) {
    const controller = playerPawn.GetPlayerController();
    if (!controller) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    if (now < data.exoCooldownEnd) return;

    const angles = playerPawn.GetEyeAngles();
    const yaw = angles.yaw * Math.PI / 180;
    const pitch = angles.pitch * Math.PI / 180;
    const cosPitch = Math.cos(pitch);

    DASH_VEL.x = Math.cos(yaw) * cosPitch * EXO_DASH_SPEED;
    DASH_VEL.y = Math.sin(yaw) * cosPitch * EXO_DASH_SPEED;
    DASH_VEL.z = -Math.sin(pitch) * EXO_DASH_SPEED;

    playerPawn.Teleport(DASH_TELEPORT);

    data.exoCooldownEnd = now + EXO_COOLDOWN;
    data.dashImmunityEnd = now + DASH_IMMUNITY_DURATION;

    const layout = getSoulsLayout();
    if (layout) updateExoCooldown(playerPawn, layout, now, controller, slot);
}

// ==================== 全局 Think ====================
let thinkEnabled = false;

function globalThink() {
    if (!thinkEnabled) return;
    const now = Instance.GetGameTime();
    cachedGameTime = now;

    // 0. 批量刷新 dirty HUD
    if (now - lastHudFlushTime >= HUD_FLUSH_INTERVAL) {
        if (dirtyHudPlayers.size > 0) {
            const layout = getSoulsLayout();
            if (layout) {
                for (const slot of dirtyHudPlayers) {
                    const data = playerData.get(slot);
                    if (!data) continue;
                    const controller = data.controller;
                    if (!controller || !controller.IsValid()) continue;
                    updatePlayerHUD(null, controller, slot);
                }
            }
            dirtyHudPlayers.clear();
        }
        lastHudFlushTime = now;
    }

    // 1. 外骨骼检测
    if (now - lastExoCheckTime >= EXO_CHECK_INTERVAL) {
        for (const slot of exoPlayers) {
            const data = playerData.get(slot);
            if (!data) { exoPlayers.delete(slot); continue; }
            const controller = data.controller;
            if (!controller || !controller.IsValid()) { exoPlayers.delete(slot); continue; }
            const pawn = controller.GetPlayerPawn();
            if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;

            let perkEnabled = data.gainsEnabled && data.exoEnabled;
            if (perkEnabled && data.teamNumber === 3) perkEnabled = data.ctGainsEnabled;
            if (!perkEnabled) continue;

            if (pawn.WasInputJustPressed(CSInputs.ATTACK2)) performDash(pawn, now);
        }
        lastExoCheckTime = now;
    }

    // 2. 冷却 UI
    if (now - lastCooldownUpdateTime >= COOLDOWN_UI_INTERVAL) {
        const layout = getSoulsLayout();
        if (layout) {
            for (const slot of exoPlayers) {
                const data = playerData.get(slot);
                if (!data) continue;
                const controller = data.controller;
                if (!controller || !controller.IsValid()) continue;
                const pawn = controller.GetPlayerPawn();
                if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
                updateExoCooldown(pawn, layout, now, controller, slot);
            }
        }
        lastCooldownUpdateTime = now;
    }

    // 3. 补给/细胞
    if (now - lastBackpackRefillTime >= BACKPACK_REFILL_INTERVAL) {
        for (const slot of backpackPlayers) {
            const data = playerData.get(slot);
            if (!data) { backpackPlayers.delete(slot); continue; }
            const controller = data.controller;
            if (!controller || !controller.IsValid()) { backpackPlayers.delete(slot); continue; }
            const pawn = controller.GetPlayerPawn();
            if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
            if (data.backpackPurchased && data.gainsEnabled) refillMainWeapon(pawn, controller, slot);
        }
        for (const slot of cellPlayers) {
            const data = playerData.get(slot);
            if (!data) { cellPlayers.delete(slot); continue; }
            const controller = data.controller;
            if (!controller || !controller.IsValid()) { cellPlayers.delete(slot); continue; }
            const pawn = controller.GetPlayerPawn();
            if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
            if (data.cellPurchased && data.gainsEnabled) healCellPlayer(pawn, controller, slot);
        }
        lastBackpackRefillTime = now;
    }

    // 4. 清理
    if (now - lastCleanupTime >= CLEANUP_INTERVAL) {
        if (soulsLayout && !soulsLayout.IsValid()) {
            soulsLayout = null;
            resetAllHudCaches();  // 布局失效 → 清空所有 HUD 缓存
        }
        if (shopLayout && !shopLayout.IsValid()) shopLayout = null;

        for (const set of [exoPlayers, backpackPlayers, cellPlayers]) {
            for (const slot of set) {
                const data = playerData.get(slot);
                if (!data) { set.delete(slot); continue; }
                const c = data.controller;
                if (!c || !c.IsValid() || !c.IsConnected()) set.delete(slot);
            }
        }
        for (const slot of dirtyHudPlayers) {
            if (!playerData.has(slot)) dirtyHudPlayers.delete(slot);
        }
        lastCleanupTime = now;
    }

    // 空闲时停 Think
    if (exoPlayers.size === 0 && backpackPlayers.size === 0 && cellPlayers.size === 0 && dirtyHudPlayers.size === 0) {
        disableGlobalThink();
        return;
    }

    Instance.SetNextThink(now + GLOBAL_THINK_INTERVAL);
}

function enableGlobalThink() {
    if (!thinkEnabled && (exoPlayers.size > 0 || backpackPlayers.size > 0 || cellPlayers.size > 0 || dirtyHudPlayers.size > 0)) {
        thinkEnabled = true;
        const now = Instance.GetGameTime();
        lastExoCheckTime = now;
        lastBackpackRefillTime = now;
        lastCooldownUpdateTime = now;
        lastCleanupTime = now;
        lastHudFlushTime = now;
        cachedGameTime = now;
        Instance.SetThink(globalThink);
        Instance.SetNextThink(now + GLOBAL_THINK_INTERVAL);
    }
}

function disableGlobalThink() {
    if (thinkEnabled && exoPlayers.size === 0 && backpackPlayers.size === 0 && cellPlayers.size === 0 && dirtyHudPlayers.size === 0) {
        thinkEnabled = false;
        Instance.SetThink(() => {});
    }
}

// ==================== 增益开关 ====================
function disableAllGains() {
    for (const [, data] of playerData) {
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.gainsEnabled = false;
            data.lastCooldownVisible = null;
        }
    }
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const slot of exoPlayers) {
        const data = playerData.get(slot);
        if (!data) continue;
        const controller = data.controller;
        if (!controller || !controller.IsValid()) continue;
        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
        if (layout) updateExoCooldown(pawn, layout, now, controller, slot);
        updatePlayerHUD(pawn, controller, slot);
    }
    Console.Log("[Souls] 已禁用所有玩家的增益效果（总开关）");
}

function enableAllGains() {
    for (const [, data] of playerData) {
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.gainsEnabled = true;
            data.ctGainsEnabled = true;
            data.exoEnabled = true;
            data.cellEnabled = true;
            if (data.backpackPurchased) data.backpackEnabled = true;
            data.lastCooldownVisible = null;
        }
    }
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const slot of backpackPlayers) {
        const data = playerData.get(slot);
        if (!data) continue;
        const controller = data.controller;
        if (!controller || !controller.IsValid()) continue;
        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
        applyBackpackImmediate(pawn, controller, slot);
        if (layout) updateExoCooldown(pawn, layout, now, controller, slot);
        updatePlayerHUD(pawn, controller, slot);
    }
    for (const slot of cellPlayers) {
        const data = playerData.get(slot);
        if (!data) continue;
        const controller = data.controller;
        if (!controller || !controller.IsValid()) continue;
        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
        healCellPlayer(pawn, controller, slot);
        updatePlayerHUD(pawn, controller, slot);
    }
    Console.Log("[Souls] 已恢复所有玩家的增益效果（总开关）");
}

function disableTargetGains(playerPawn) {
    const controller = playerPawn?.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
        data.gainsEnabled = false;
        data.lastCooldownVisible = null;
        const layout = getSoulsLayout();
        if (layout) updateExoCooldown(playerPawn, layout, cachedGameTime || Instance.GetGameTime(), controller, slot);
        updatePlayerHUD(playerPawn, controller, slot);
        Console.Log(`[Souls] 已禁用玩家 ${controller.GetPlayerName()} 的增益效果（目标禁用）`);
    }
}

function enableTargetGains(playerPawn) {
    const controller = playerPawn?.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;
    if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
        data.gainsEnabled = true;
        if (data.teamNumber === 3) data.ctGainsEnabled = true;
        data.exoEnabled = true;
        data.cellEnabled = true;
        data.lastCooldownVisible = null;
        if (data.backpackPurchased && playerPawn.IsAlive()) applyBackpackImmediate(playerPawn, controller, slot);
        if (data.cellPurchased && playerPawn.IsAlive()) healCellPlayer(playerPawn, controller, slot);
        const layout = getSoulsLayout();
        if (layout) updateExoCooldown(playerPawn, layout, cachedGameTime || Instance.GetGameTime(), controller, slot);
        updatePlayerHUD(playerPawn, controller, slot);
        Console.Log(`[Souls] 已启用玩家 ${controller.GetPlayerName()} 的增益效果（目标启用）`);
    }
}

// ==================== 清空增益 ====================
function clearPlayerPerks(playerPawn) {
    const controller = playerPawn?.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;

    data.armorPurchased = false;
    data.exoPurchased = false;
    data.backpackPurchased = false;
    data.cellPurchased = false;
    data.gainsEnabled = true;
    data.backpackEnabled = true;
    data.ctGainsEnabled = true;
    data.exoEnabled = true;
    data.cellEnabled = true;
    data.exoCooldownEnd = 0;
    data.dashImmunityEnd = 0;
    data.lastCooldownVisible = null;
    data.lastPerkMask = -1;

    exoPlayers.delete(slot);
    backpackPlayers.delete(slot);
    cellPlayers.delete(slot);

    updatePlayerHUD(playerPawn, controller, slot);
    updateShopUI(playerPawn, controller, slot);
    const layout = getSoulsLayout();
    if (layout) updateExoCooldown(playerPawn, layout, cachedGameTime || Instance.GetGameTime(), controller, slot);

    if (exoPlayers.size === 0 && backpackPlayers.size === 0 && cellPlayers.size === 0 && dirtyHudPlayers.size === 0) {
        disableGlobalThink();
    }
    Console.Log(`[Souls] 已清空玩家 ${controller.GetPlayerName()} 的所有增益效果`);
}

// ==================== 输入监听 ====================
Instance.OnScriptInput("peak_disable_all", () => disableAllGains());
Instance.OnScriptInput("peak_enable_all", () => enableAllGains());
Instance.OnScriptInput("peak_disable_target", (inputData) => {
    const a = inputData.activator;
    if (!a) return;
    let pawn = a instanceof CSPlayerPawn ? a : (a.GetPlayerPawn?.());
    if (pawn && pawn.IsValid()) disableTargetGains(pawn);
});
Instance.OnScriptInput("peak_enable_target", (inputData) => {
    const a = inputData.activator;
    if (!a) return;
    let pawn = a instanceof CSPlayerPawn ? a : (a.GetPlayerPawn?.());
    if (pawn && pawn.IsValid()) enableTargetGains(pawn);
});
Instance.OnScriptInput("rs_clearperk_it", (inputData) => {
    const a = inputData.activator;
    if (!a) { Console.Log("[Souls] rs_clearperk_it 无激活者"); return; }
    let pawn = a instanceof CSPlayerPawn ? a : (a.GetPlayerPawn?.());
    if (pawn && pawn.IsValid()) clearPlayerPerks(pawn);
});

Instance.OnScriptInput("rs_disable_exo_it", () => {
    for (const [, data] of playerData) {
        if (data.exoPurchased) { data.exoEnabled = false; data.lastCooldownVisible = null; }
    }
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const slot of exoPlayers) {
        const data = playerData.get(slot);
        if (!data) continue;
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
        if (layout) updateExoCooldown(pawn, layout, now, c, slot);
        updatePlayerHUD(pawn, c, slot);
    }
    Console.Log("[Souls] 已禁用外骨骼（独立开关）");
});

Instance.OnScriptInput("rs_enable_exo_it", () => {
    for (const [, data] of playerData) {
        if (data.exoPurchased) { data.exoEnabled = true; data.lastCooldownVisible = null; }
    }
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const slot of exoPlayers) {
        const data = playerData.get(slot);
        if (!data) continue;
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;
        if (layout) updateExoCooldown(pawn, layout, now, c, slot);
        updatePlayerHUD(pawn, c, slot);
    }
    Console.Log("[Souls] 已恢复外骨骼（独立开关）");
});

Instance.OnScriptInput("rs_disable_inf", () => {
    for (const [, data] of playerData) if (data.backpackPurchased) data.backpackEnabled = false;
    Console.Log("[Souls] 已禁用补给背包（独立开关）");
});

Instance.OnScriptInput("rs_enable_inf", () => {
    for (const [slot, data] of playerData) {
        if (!data.backpackPurchased) continue;
        data.backpackEnabled = true;
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (pawn && pawn.IsValid() && pawn.IsAlive()) {
            applyBackpackImmediate(pawn, c, slot);
            updatePlayerHUD(pawn, c, slot);
        }
    }
    Console.Log("[Souls] 已恢复补给背包（独立开关）");
});

Instance.OnScriptInput("rs_enable_perk_human", () => {
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const [slot, data] of playerData) {
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive() || data.teamNumber !== 3) continue;
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.ctGainsEnabled = true;
            data.lastCooldownVisible = null;
            if (data.exoPurchased && layout) updateExoCooldown(pawn, layout, now, c, slot);
            updatePlayerHUD(pawn, c, slot);
        }
    }
    Console.Log("[Souls] 已启用 CT 增益（CT独立开关）");
});

Instance.OnScriptInput("rs_disable_perk_human", () => {
    const now = cachedGameTime || Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const [slot, data] of playerData) {
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive() || data.teamNumber !== 3) continue;
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.ctGainsEnabled = false;
            data.lastCooldownVisible = null;
            if (data.exoPurchased && layout) updateExoCooldown(pawn, layout, now, c, slot);
            updatePlayerHUD(pawn, c, slot);
        }
    }
    Console.Log("[Souls] 已禁用 CT 增益（CT独立开关）");
});

Instance.OnScriptInput("rs_closepanel", () => {
    let closedCount = 0;
    for (const [slot, data] of playerData) {
        if (!data.shopOpen) continue;
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (pawn && pawn.IsValid()) { closeShop(pawn, c, slot); closedCount++; }
    }
    Console.Log(`[Souls] 已关闭 ${closedCount} 个商店`);
});

Instance.OnScriptInput("rs_shop_open", (inputData) => {
    const a = inputData.activator;
    if (!a) return;
    let pawn = a instanceof CSPlayerPawn ? a : (a.GetPlayerPawn?.());
    if (!pawn || !pawn.IsValid()) return;
    const c = pawn.GetPlayerController();
    if (!c || !c.IsValid()) return;
    const slot = c.GetPlayerSlot();
    if (!playerData.has(slot)) initPlayer(pawn, c, slot);
    const data = playerData.get(slot);
    if (!data) return;
    if (data.shopOpen) { updateShopUI(pawn, c, slot); return; }
    openShop(pawn, c, slot);
});

function addSoulsMe(amount, inputData) {
    const a = inputData.activator;
    if (!a) return;
    let pawn = a instanceof CSPlayerPawn ? a : (a.GetPlayerPawn?.());
    if (!pawn || !pawn.IsValid()) return;
    const c = pawn.GetPlayerController();
    if (!c || !c.IsValid()) return;
    const slot = c.GetPlayerSlot();
    if (!playerData.has(slot)) initPlayer(pawn, c, slot);
    const data = playerData.get(slot);
    if (!data) return;
    data.soulCount += amount;
    dirtyHudPlayers.delete(slot);
    updatePlayerHUD(pawn, c, slot);
    if (data.shopOpen) updateShopUI(pawn, c, slot);
    Console.Log(`[Souls] 给 ${c.GetPlayerName()} 添加 ${amount} 魂石`);
}

function addSoulsAll(amount) {
    let count = 0;
    for (const c of Instance.GetAllPlayerControllers()) {
        if (!c || !c.IsValid() || !c.IsConnected()) continue;
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid()) continue;
        const slot = c.GetPlayerSlot();
        if (!playerData.has(slot)) initPlayer(pawn, c, slot);
        const data = playerData.get(slot);
        if (!data) continue;
        data.soulCount += amount;
        dirtyHudPlayers.delete(slot);
        updatePlayerHUD(pawn, c, slot);
        if (data.shopOpen) updateShopUI(pawn, c, slot);
        count++;
    }
    Console.Log(`[Souls] 给 ${count} 名玩家各添加 ${amount} 魂石`);
}

Instance.OnScriptInput("rs_add_me", (d) => addSoulsMe(100, d));
Instance.OnScriptInput("rs_add_all", () => addSoulsAll(100));
Instance.OnScriptInput("rs_add_me_10", (d) => addSoulsMe(10, d));
Instance.OnScriptInput("rs_add_all_10", () => addSoulsAll(10));

// ==================== 玩家事件 ====================
Instance.OnPlayerActivate(({ player }) => {
    const pawn = player.GetPlayerPawn();
    if (pawn) initPlayer(pawn, player, undefined);
});

Instance.OnPlayerReset(({ player }) => {
    const c = player.GetPlayerController();
    if (!c || !c.IsValid()) return;
    const slot = c.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) { initPlayer(player, c, slot); return; }
    data.controller = c;
    data.teamNumber = c.GetTeamNumber();
    data.hitCount = 0;
    controllerToData.set(c, data);
    if (data.shopOpen) closeShop(player, c, slot);
    if (data.backpackPurchased) {
        Instance.QueueAfterThinks(() => {
            if (player.IsAlive()) applyBackpackImmediate(player, c, slot);
        });
    }
    dirtyHudPlayers.delete(slot);
    updatePlayerHUD(player, c, slot);
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    // 先清理集合与数据，保证即使后面 UI 报错也不影响
    exoPlayers.delete(playerSlot);
    backpackPlayers.delete(playerSlot);
    cellPlayers.delete(playerSlot);
    dirtyHudPlayers.delete(playerSlot);
    const data = playerData.get(playerSlot);
    playerData.delete(playerSlot);

    // UI 清理包 try，防止 layout 失效时报错中断 disableGlobalThink
    try {
        const layout = getSoulsLayout();
        if (layout) {
            const panelId = `player_panel_${playerSlot}`;
            const perksLabelId = `perks_label_${playerSlot}`;
            const exoLabelId = `exo_label_${playerSlot}`;
            layout.SetHasClassForPlayer(playerSlot, panelId, "Hidden", true);
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "name", "");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "count", "0");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "perks", "");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "cooldown", "");
            layout.SetHasClassForPlayer(playerSlot, perksLabelId, "Hidden", true);
            layout.SetHasClassForPlayer(playerSlot, exoLabelId, "Hidden", true);
        }
    } catch (e) {
        soulsLayout = null;
    }

    if (exoPlayers.size === 0 && backpackPlayers.size === 0 && cellPlayers.size === 0 && dirtyHudPlayers.size === 0) {
        disableGlobalThink();
    }
    Console.Log(`[Souls] 玩家 ${playerSlot} 断开，已清理`);
});

// ==================== 伤害修改（WeakMap 快速查） ====================
Instance.OnModifyPlayerDamage((event) => {
    const victim = event.player;
    if (!(victim instanceof CSPlayerPawn)) return;
    const controller = victim.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const data = controllerToData.get(controller);
    if (!data) return;

    const hasExo = data.exoPurchased;
    const hasArmor = data.armorPurchased;
    if (!hasExo && !hasArmor) return;
    if (!data.gainsEnabled) return;
    if (data.teamNumber === 3 && !data.ctGainsEnabled) return;

    if (hasExo && data.exoEnabled) {
        const now = cachedGameTime || Instance.GetGameTime();
        if (now < data.dashImmunityEnd) return { abort: true };
    }
    if (hasArmor) return { damage: event.damage * 0.5 };
});

// ==================== 魂石获取（脏标记） ====================
Instance.OnPlayerDamage((event) => {
    const attacker = event.attacker;
    const victim = event.player;
    if (!(attacker instanceof CSPlayerPawn) || !(victim instanceof CSPlayerPawn)) return;
    if (attacker === victim) return;

    const controller = attacker.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    let data = controllerToData.get(controller);
    if (!data) {
        initPlayer(attacker, controller, controller.GetPlayerSlot());
        data = controllerToData.get(controller);
        if (!data) return;
    }

    const victimTeam = victim.GetTeamNumber();
    const attackerTeam = data.teamNumber;
    if (attackerTeam === victimTeam) return;

    if (attackerTeam === 2 && victimTeam === 3) {
        data.soulCount += 5;
        data.hitCount = 0;
        dirtyHudPlayers.add(data.slot);
        enableGlobalThink();
        return;
    }

    if (attackerTeam === 3 && victimTeam === 2) {
        const weapon = event.weapon;
        if (!weapon || !weapon.IsValid()) return;
        const wd = weapon.GetData();
        if (!wd || !GUN_TYPES.has(wd.GetType())) return;
        data.hitCount += 1;
        if (data.hitCount >= CT_HIT_COUNT_TO_REWARD) {
            data.soulCount += 1;
            data.hitCount = 0;
            dirtyHudPlayers.add(data.slot);
            enableGlobalThink();
        }
        return;
    }

    data.hitCount += 1;
    if (data.hitCount >= HIT_COUNT_TO_REWARD) {
        data.soulCount += 1;
        data.hitCount = 0;
        dirtyHudPlayers.add(data.slot);
        enableGlobalThink();
    }
});

// ==================== 商店点击 ====================
Instance.OnCustomHudClicked((event) => {
    const layout = getShopLayout();
    if (!layout || event.layout !== layout) return;
    const player = event.player;
    const pawn = player.GetPlayerPawn();
    if (!pawn) return;
    const slot = player.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;

    const id = event.buttonId;
    if (id === "lang_toggle") {
        data.shopLang = data.shopLang === "en" ? "zh" : "en";
        applyShopLanguage(pawn, player, slot);
        return;
    }

    const tryBuy = (purchased, price, label) => {
        if (purchased) { Console.Log("已购买"); return false; }
        if (data.soulCount < price) { Console.Log(`魂石不足！需要 ${price} 魂石`); return false; }
        return true;
    };

    if (id === "buy_armor") {
        if (!tryBuy(data.armorPurchased, PRICE_ARMOR, "armor")) return;
        data.soulCount -= PRICE_ARMOR;
        data.armorPurchased = true;
        data.gainsEnabled = true;
        data.ctGainsEnabled = true;
        dirtyHudPlayers.delete(slot);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Console.Log(`${player.GetPlayerName()} 购买了鳞片装甲`);
    } else if (id === "buy_exo") {
        if (!tryBuy(data.exoPurchased, PRICE_EXO, "exo")) return;
        data.soulCount -= PRICE_EXO;
        data.exoPurchased = true;
        data.gainsEnabled = true;
        data.ctGainsEnabled = true;
        data.exoEnabled = true;
        data.lastCooldownVisible = null;
        exoPlayers.add(slot);
        enableGlobalThink();
        dirtyHudPlayers.delete(slot);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        const l = getSoulsLayout();
        if (l) updateExoCooldown(pawn, l, cachedGameTime || Instance.GetGameTime(), player, slot);
        Console.Log(`${player.GetPlayerName()} 购买了外骨骼`);
    } else if (id === "buy_backpack") {
        if (!tryBuy(data.backpackPurchased, PRICE_BACKPACK, "backpack")) return;
        data.soulCount -= PRICE_BACKPACK;
        data.backpackPurchased = true;
        data.gainsEnabled = true;
        data.backpackEnabled = true;
        data.ctGainsEnabled = true;
        backpackPlayers.add(slot);
        enableGlobalThink();
        if (pawn.IsAlive()) applyBackpackImmediate(pawn, player, slot);
        dirtyHudPlayers.delete(slot);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Console.Log(`${player.GetPlayerName()} 购买了补给背包`);
    } else if (id === "buy_cell") {
        if (!tryBuy(data.cellPurchased, PRICE_CELL, "cell")) return;
        data.soulCount -= PRICE_CELL;
        data.cellPurchased = true;
        data.gainsEnabled = true;
        data.cellEnabled = true;
        data.ctGainsEnabled = true;
        cellPlayers.add(slot);
        enableGlobalThink();
        if (pawn.IsAlive()) healCellPlayer(pawn, player, slot);
        dirtyHudPlayers.delete(slot);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Console.Log(`${player.GetPlayerName()} 购买了自适应细胞`);
    } else if (id === "close_shop") {
        closeShop(pawn, player, slot);
    }
});

// ==================== 回合事件 ====================
Instance.OnRoundEnd(() => {
    for (const [slot, data] of playerData) {
        if (!data.shopOpen) continue;
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        const pawn = c.GetPlayerPawn();
        if (pawn && pawn.IsValid()) closeShop(pawn, c, slot);
    }
});

Instance.OnRoundStart(() => {
    const now = Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const [slot, data] of playerData) {
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.gainsEnabled = true;
            data.ctGainsEnabled = true;
            data.exoEnabled = true;
            data.cellEnabled = true;
            if (data.backpackPurchased) data.backpackEnabled = true;
            data.lastCooldownVisible = null;
        }
        const c = data.controller;
        if (!c || !c.IsValid()) continue;
        data.teamNumber = c.GetTeamNumber();
        const pawn = c.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;

        if (data.backpackPurchased) {
            Instance.QueueAfterThinks(() => {
                if (pawn.IsAlive()) applyBackpackImmediate(pawn, c, slot);
            });
        }
        if (data.cellPurchased) healCellPlayer(pawn, c, slot);
        if (data.exoPurchased) {
            if (layout) updateExoCooldown(pawn, layout, now, c, slot);
            updatePlayerHUD(pawn, c, slot);
        }
    }
    Console.Log("[Souls] 新回合，所有增益已恢复");
});

Instance.OnPlayerChat((event) => {
    if (event.text !== "/shop" && event.text !== "！shop") return;
    const player = event.player;
    if (!player) return;
    const pawn = player.GetPlayerPawn();
    if (!pawn) return;
    const slot = player.GetPlayerSlot();
    if (!playerData.has(slot)) initPlayer(pawn, player, slot);
    const data = playerData.get(slot);
    if (!data) return;
    if (data.shopOpen) { Console.Log("商店已打开"); return; }
    openShop(pawn, player, slot);
});

Console.RegisterCheatCommand("souls_add", (args) => {
    const parts = args.trim().split(/\s+/);
    if (parts.length < 2) { Console.Log("用法: souls_add <槽位> <数量>"); return; }
    const slot = parseInt(parts[0]);
    const amount = parseInt(parts[1]);
    if (isNaN(slot) || isNaN(amount)) { Console.Log("参数错误"); return; }
    const c = Instance.GetPlayerController(slot);
    if (!c || !c.IsValid()) { Console.Log(`未找到槽位 ${slot}`); return; }
    const pawn = c.GetPlayerPawn();
    if (!pawn || !pawn.IsValid()) { Console.Log("没有 Pawn"); return; }
    if (!playerData.has(slot)) initPlayer(pawn, c, slot);
    const data = playerData.get(slot);
    if (!data) return;
    data.soulCount += amount;
    dirtyHudPlayers.delete(slot);
    updatePlayerHUD(pawn, c, slot);
    if (data.shopOpen) updateShopUI(pawn, c, slot);
    Console.Log(`给 ${c.GetPlayerName()} 添加 ${amount} 魂石`);
});

Console.Log("[Souls] 玩家魂石系统（API迁移 + 性能修复 + UI修复）已加载。");