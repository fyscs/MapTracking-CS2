    if (data.shopOpen) updateShopUI(pawn, controller, slot);
    Instance.Msg(`[Souls] 给 ${controller.GetPlayerName()} 添加了 10 魂石`);
});

Instance.OnScriptInput("rs_add_all_10", () => {
    const allControllers = Instance.GetAllPlayerControllers();
    let count = 0;
    for (const controller of allControllers) {
        if (!controller.IsConnected()) continue;
        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid()) continue;
        const slot = controller.GetPlayerSlot();
        if (!playerData.has(slot)) initPlayer(pawn, controller, slot);
        const data = playerData.get(slot);
        if (!data) continue;
        data.soulCount += 10;
        updatePlayerHUD(pawn, controller, slot);
        if (data.shopOpen) updateShopUI(pawn, controller, slot);
        count++;
    }
    Instance.Msg(`[Souls] 给 ${count} 名玩家各添加了 10 魂石`);
});

// 玩家事件
Instance.OnPlayerActivate(({ player }) => {
    const pawn = player.GetPlayerPawn();
    if (pawn) initPlayer(pawn, player, undefined);
});

Instance.OnPlayerReset(({ player }) => {
    const controller = player.GetPlayerController();
    if (!controller) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) {
        initPlayer(player, controller, slot);
        return;
    }
    data.hitCount = 0;
    if (data.shopOpen) closeShop(player, controller, slot);
    if (data.backpackPurchased) {
        Instance.QueueAfterThinks(() => {
            if (player.IsAlive()) applyBackpackImmediate(player);
        });
    }
    updatePlayerHUD(player, controller, slot);
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    exoPlayers.delete(playerSlot);
    backpackPlayers.delete(playerSlot);
    cellPlayers.delete(playerSlot);
    const deleted = playerData.delete(playerSlot);
    if (deleted) {
        const layout = getSoulsLayout();
        if (layout) {
            const panelId = `player_panel_${playerSlot}`;
            const perksLabelId = `perks_label_${playerSlot}`;
            const exoLabelId = `exo_label_${playerSlot}`;
            layout.SetHasClassForPlayer(playerSlot, panelId, "Hidden", true);
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "name", "");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "count", "0");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "perks", "");
            layout.SetDialogVariableStringForPlayer(playerSlot, panelId, "cooldown", "");
            layout.SetHasClassForPlayer(playerSlot, perksLabelId, "Hidden", true);
            layout.SetHasClassForPlayer(playerSlot, exoLabelId, "Hidden", true);
        }
        if (exoPlayers.size === 0 && backpackPlayers.size === 0 && cellPlayers.size === 0) {
            disableGlobalThink();
        }
        Instance.Msg(`[Souls] 玩家槽位 ${playerSlot} 断开，数据已清理，面板已重置。`);
    }
});

// ==================== 伤害修改（关键优化：前置退出） ====================
Instance.OnModifyPlayerDamage((event) => {
    const victim = event.player;
    if (!(victim instanceof CSPlayerPawn)) return;
    const controller = victim.GetPlayerController();
    if (!controller) return;
    const slot = controller.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;

    // ★★★ 前置退出：没买任何减伤/免疫增益的玩家直接返回（最常见情况） ★★★
    const hasExo = data.exoPurchased;
    const hasArmor = data.armorPurchased;
    if (!hasExo && !hasArmor) return;
    if (!data.gainsEnabled) return;

    // CT 独立开关：只有真的有增益时才检查队伍
    let ctOk = true;
    if (victim.GetTeamNumber() === 3) {
        ctOk = data.ctGainsEnabled;
        if (!ctOk) return;
    }

    // 外骨骼免疫：只有买了外骨骼才需要时间
    if (hasExo && data.exoEnabled) {
        const now = cachedGameTime || Instance.GetGameTime();
        if (now < data.dashImmunityEnd) {
            return { abort: true };
        }
    }

    // 鳞片装甲减伤
    if (hasArmor) {
        return { damage: event.damage * 0.5 };
    }
});

// ==================== 魂石获取（关键优化：Set 查表 + 提前退出） ====================
Instance.OnPlayerDamage((event) => {
    const attacker = event.attacker;
    const victim = event.player;
    if (!(attacker instanceof CSPlayerPawn) || !(victim instanceof CSPlayerPawn)) return;
    if (attacker === victim) return;

    const attackerTeam = attacker.GetTeamNumber();
    const victimTeam = victim.GetTeamNumber();
    if (attackerTeam === victimTeam) return;

    const controller = attacker.GetPlayerController();
    if (!controller) return;
    const slot = controller.GetPlayerSlot();
    let data = playerData.get(slot);
    if (!data) {
        initPlayer(attacker, controller, slot);
        data = playerData.get(slot);
        if (!data) return;
    }

    // T 打 CT：每次 +5
    if (attackerTeam === 2 && victimTeam === 3) {
        data.soulCount += 5;
        data.hitCount = 0;
        updatePlayerHUD(attacker, controller, slot);
        return;
    }

    // CT 打 T：只统计枪械，用模块级 Set 查表
    if (attackerTeam === 3 && victimTeam === 2) {
        const weapon = event.weapon;
        if (!weapon || !weapon.IsValid()) return;
        const weaponData = weapon.GetData();
        if (!weaponData) return;
        if (!GUN_TYPES.has(weaponData.GetType())) return;

        data.hitCount += 1;
        if (data.hitCount >= CT_HIT_COUNT_TO_REWARD) {
            data.soulCount += 1;
            data.hitCount = 0;
            updatePlayerHUD(attacker, controller, slot);
        }
        return;
    }

    data.hitCount += 1;
    if (data.hitCount >= HIT_COUNT_TO_REWARD) {
        data.soulCount += 1;
        data.hitCount = 0;
        updatePlayerHUD(attacker, controller, slot);
    }
});

// ==================== 商店 UI 点击 ====================
Instance.OnCustomHudClicked((event) => {
    const layout = getShopLayout();
    if (!layout || event.layout !== layout) return;
    const player = event.player;
    const pawn = player.GetPlayerPawn();
    if (!pawn) return;
    const slot = player.GetPlayerSlot();
    const data = playerData.get(slot);
    if (!data) return;

    const buttonId = event.buttonId;

    // 语言切换（只影响当前玩家）
    if (buttonId === "lang_toggle") {
        data.shopLang = (data.shopLang === "en") ? "zh" : "en";
        applyShopLanguage(pawn, player, slot);
        return;
    }

    if (buttonId === "buy_armor") {
        if (data.armorPurchased) { Instance.Msg("已购买"); return; }
        if (data.soulCount < PRICE_ARMOR) { Instance.Msg(`魂石不足！需要 ${PRICE_ARMOR} 魂石`); return; }
        data.soulCount -= PRICE_ARMOR;
        data.armorPurchased = true;
        data.gainsEnabled = true;
        data.ctGainsEnabled = true;
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Instance.Msg(`${player.GetPlayerName()} 购买了鳞片装甲`);
    } else if (buttonId === "buy_exo") {
        if (data.exoPurchased) { Instance.Msg("已购买"); return; }
        if (data.soulCount < PRICE_EXO) { Instance.Msg(`魂石不足！需要 ${PRICE_EXO} 魂石`); return; }
        data.soulCount -= PRICE_EXO;
        data.exoPurchased = true;
        data.gainsEnabled = true;
        data.ctGainsEnabled = true;
        data.exoEnabled = true;
        data.lastCooldownVisible = null;
        exoPlayers.add(slot);
        enableGlobalThink();
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        const soulsL = getSoulsLayout();
        if (soulsL) updateExoCooldown(pawn, soulsL, cachedGameTime || Instance.GetGameTime(), player, slot);
        Instance.Msg(`${player.GetPlayerName()} 购买了外骨骼辅助`);
    } else if (buttonId === "buy_backpack") {
        if (data.backpackPurchased) { Instance.Msg("已购买"); return; }
        if (data.soulCount < PRICE_BACKPACK) { Instance.Msg(`魂石不足！需要 ${PRICE_BACKPACK} 魂石`); return; }
        data.soulCount -= PRICE_BACKPACK;
        data.backpackPurchased = true;
        data.gainsEnabled = true;
        data.backpackEnabled = true;
        data.ctGainsEnabled = true;
        backpackPlayers.add(slot);
        enableGlobalThink();
        if (pawn.IsAlive()) applyBackpackImmediate(pawn);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Instance.Msg(`${player.GetPlayerName()} 购买了补给背包`);
    } else if (buttonId === "buy_cell") {
        if (data.cellPurchased) { Instance.Msg("已购买"); return; }
        if (data.soulCount < PRICE_CELL) { Instance.Msg(`魂石不足！需要 ${PRICE_CELL} 魂石`); return; }
        data.soulCount -= PRICE_CELL;
        data.cellPurchased = true;
        data.gainsEnabled = true;
        data.cellEnabled = true;
        data.ctGainsEnabled = true;
        cellPlayers.add(slot);
        enableGlobalThink();
        if (pawn.IsAlive()) healCellPlayer(pawn);
        updateShopUI(pawn, player, slot);
        updatePlayerHUD(pawn, player, slot);
        Instance.Msg(`${player.GetPlayerName()} 购买了自适应细胞`);
    } else if (buttonId === "close_shop") {
        closeShop(pawn, player, slot);
    }
});

Instance.OnRoundEnd(() => {
    for (const [slot, data] of playerData) {
        if (data.shopOpen) {
            const controller = data.controller;
            if (controller) {
                const pawn = controller.GetPlayerPawn();
                if (pawn) closeShop(pawn, controller, slot);
            }
        }
    }
});

Instance.OnRoundStart(() => {
    const now = Instance.GetGameTime();
    const layout = getSoulsLayout();
    for (const [slot, data] of playerData) {
        if (data.armorPurchased || data.exoPurchased || data.backpackPurchased || data.cellPurchased) {
            data.gainsEnabled = true;
            data.ctGainsEnabled = true;
            data.exoEnabled = true;
            data.cellEnabled = true;
            if (data.backpackPurchased) {
                data.backpackEnabled = true;
            }
            data.lastCooldownVisible = null;
        }
        const controller = data.controller;
        if (!controller) continue;
        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsAlive()) continue;

        if (data.backpackPurchased) {
            Instance.QueueAfterThinks(() => {
                if (pawn.IsAlive()) applyBackpackImmediate(pawn);
            });
        }
        if (data.cellPurchased) {
            healCellPlayer(pawn);
        }
        if (data.exoPurchased) {
            if (layout) updateExoCooldown(pawn, layout, now, controller, slot);
            updatePlayerHUD(pawn, controller, slot);
        }
    }
    Instance.Msg("[Souls] 新回合开始，所有增益已恢复。");
});

// 聊天命令打开商店
Instance.OnPlayerChat((event) => {
    if (event.text === "/shop" || event.text === "！shop") {
        const player = event.player;
        if (!player) return;
        const pawn = player.GetPlayerPawn();
        if (!pawn) return;
        const slot = player.GetPlayerSlot();
        if (!playerData.has(slot)) initPlayer(pawn, player, slot);
        const data = playerData.get(slot);
        if (!data) return;
        if (data.shopOpen) { Instance.Msg("商店已打开"); return; }
        openShop(pawn, player, slot);
    }
});

// 作弊命令
Instance.RegisterCheatCommand("souls_add", (args) => {
    const parts = args.trim().split(/\s+/);
    if (parts.length < 2) { Instance.Msg("用法: souls_add <槽位> <数量>"); return; }
    const slot = parseInt(parts[0]);
    const amount = parseInt(parts[1]);
    if (isNaN(slot) || isNaN(amount)) { Instance.Msg("参数错误"); return; }
    const controller = Instance.GetPlayerController(slot);
    if (!controller) { Instance.Msg(`未找到槽位 ${slot}`); return; }
    const pawn = controller.GetPlayerPawn();
    if (!pawn) { Instance.Msg(`玩家 ${controller.GetPlayerName()} 没有 Pawn`); return; }
    if (!playerData.has(slot)) initPlayer(pawn, controller, slot);
    const data = playerData.get(slot);
    if (!data) return;
    data.soulCount += amount;
    updatePlayerHUD(pawn, controller, slot);
    if (data.shopOpen) updateShopUI(pawn, controller, slot);
    Instance.Msg(`给 ${controller.GetPlayerName()} 添加了 ${amount} 魂石`);
});

Instance.Msg("[Souls] 玩家魂石系统（性能优化版）已加载。");