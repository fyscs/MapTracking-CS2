// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Console, Entities } from "cs_script/point_script";

const LAYOUT_NAME = "tip_panel_layout";
const playerActiveTips = new WeakMap();

let layoutEntity = null;

function getLayout() {
    if (layoutEntity && layoutEntity.IsValid()) return layoutEntity;
    layoutEntity = null;
    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0].IsValid()) layoutEntity = found[0];
    return layoutEntity;
}

function getPlayerState(player) {
    if (!playerActiveTips.has(player)) playerActiveTips.set(player, { activeId: null });
    return playerActiveTips.get(player);
}

function showTipForPlayer(player, tipId) {
    const layout = getLayout();
    if (!layout) return;
    const controller = player.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    const state = getPlayerState(player);
    if (state.activeId === tipId) return;
    if (state.activeId) layout.SetHasClassForPlayer(slot, state.activeId, "Hidden", true);
    layout.SetHasClassForPlayer(slot, tipId, "Hidden", false);
    layout.SetHasClassForPlayer(slot, "tip_container", "Visible", true);
    state.activeId = tipId;
}

function hideTipForPlayer(player, tipId) {
    const layout = getLayout();
    if (!layout) return;
    const controller = player.GetPlayerController();
    if (!controller || !controller.IsValid()) return;
    const slot = controller.GetPlayerSlot();
    const state = getPlayerState(player);
    if (state.activeId !== tipId) return;
    layout.SetHasClassForPlayer(slot, tipId, "Hidden", true);
    layout.SetHasClassForPlayer(slot, "tip_container", "Visible", false);
    state.activeId = null;
}

function clearAllTips() {
    const layout = getLayout();
    if (!layout) return;
    try {
        for (const controller of Instance.GetAllPlayerControllers()) {
            if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;
            const slot = controller.GetPlayerSlot();
            layout.SetHasClassForPlayer(slot, "tip_container", "Visible", false);
            const player = controller.GetPlayerPawn();
            if (player && player.IsValid()) {
                const state = getPlayerState(player);
                if (state.activeId) {
                    layout.SetHasClassForPlayer(slot, state.activeId, "Hidden", true);
                    state.activeId = null;
                }
            }
        }
    } catch (e) { layoutEntity = null; }
}

function getActivatorPlayer(inputData) {
    const a = inputData.activator;
    if (!a || !a.IsValid()) return null;
    if (typeof a.GetPlayerController === "function") {
        const c = a.GetPlayerController();
        if (c && c.IsValid()) return a;
    }
    if (typeof a.GetPlayerPawn === "function") {
        const p = a.GetPlayerPawn();
        if (p && p.IsValid()) return p;
    }
    return null;
}

Instance.OnActivate(() => {
    Console.Log("静态提示系统已加载");
    const registeredTips = [
        "tip_caina", "tip_empusa", "tip_gempusa", "tip_ante", "tip_queen",
        "tip_judd", "tip_bat", "tip_fury", "tip_vergil", "tip_punchline",
        "tip_gerbera", "tip_overture", "tip_sweet", "tip_rawhide", "tip_ragtime",
        "tip_helter", "tip_mega", "tip_buster", "tip_dante", "tip_nero"
    ];
    for (const id of registeredTips) {
        Instance.OnScriptInput("show_" + id, (inputData) => {
            const p = getActivatorPlayer(inputData);
            if (p) showTipForPlayer(p, id);
        });
        Instance.OnScriptInput("hide_" + id, (inputData) => {
            const p = getActivatorPlayer(inputData);
            if (p) hideTipForPlayer(p, id);
        });
    }
});

Instance.OnBeginRoundRestart(() => clearAllTips());
Instance.OnRoundStart(() => clearAllTips());

Instance.OnScriptReload({
    before: () => { clearAllTips(); return null; },
    after: () => Console.Log("提示系统重载完成"),
});