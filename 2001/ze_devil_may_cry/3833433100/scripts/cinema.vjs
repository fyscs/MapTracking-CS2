// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Entity } from "cs_script/point_script";

// ==================== 配置 ====================
const LAYOUT_NAME = "cinema_layout";

// ==================== 内部状态 ====================
let layoutEntity = null;

function getLayout() {
    if (!layoutEntity || !layoutEntity.IsValid()) {
        layoutEntity = Instance.FindEntitiesByName(LAYOUT_NAME)[0];
    }
    return layoutEntity;
}

// ==================== 黑幕控制 ====================
function openCinema() {
    const layout = getLayout();
    if (!layout || !layout.IsValid()) {
        Instance.Msg("未找到黑幕布局实体: " + LAYOUT_NAME);
        return;
    }

    const players = Instance.GetAllPlayerControllers();
    for (const controller of players) {
        if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;
        const slot = controller.GetPlayerSlot();
        layout.SetHasClassForPlayer(slot, "cinema_top", "Open", true);
        layout.SetHasClassForPlayer(slot, "cinema_bottom", "Open", true);
    }

    Instance.Msg("黑幕已展开");
}

// 关闭黑幕：移除 Open 类
function closeCinema() {
    const layout = getLayout();
    if (!layout || !layout.IsValid()) return;

    const players = Instance.GetAllPlayerControllers();
    for (const controller of players) {
        if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;
        const slot = controller.GetPlayerSlot();
        layout.SetHasClassForPlayer(slot, "cinema_top", "Open", false);
        layout.SetHasClassForPlayer(slot, "cinema_bottom", "Open", false);
    }

    Instance.Msg("黑幕已收起");
}

// ==================== 触发方式 ====================
// 使用 RunScriptInput，参数填 "cinema_open" 或 "cinema_close"
Instance.OnActivate(() => {
    Instance.Msg("电影黑幕脚本已加载");
    Instance.Msg("使用 RunScriptInput 'cinema_open' 展开，'cinema_close' 收起");

    Instance.OnScriptInput("cinema_open", () => {
        openCinema();
    });

    Instance.OnScriptInput("cinema_close", () => {
        closeCinema();
    });
});

// ==================== 重载支持 ====================
Instance.OnScriptReload({
    before: () => {
        // 重载时关闭黑幕，避免残留
        closeCinema();
        return null;
    },
    after: () => {
        Instance.Msg("电影黑幕脚本重载完成");
    },
});

Instance.Msg("电影黑幕模块初始化完成");