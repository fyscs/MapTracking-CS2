    supporter3: { text: "test", duration: 2.0, styleClass: "style_red" },
};

const LAYOUT_NAME = "supporter_layout";
const MAX_SLOTS = 5;
const ALL_STYLE_CLASSES = ["style_default", "style_gold", "style_red", "sper_nor", "sper_dante", "sper_vergil", "sper_nero"];
const FADE_TIME = 0.5;

let layoutEntity = null;
const slotStates = [];
for (let i = 0; i < MAX_SLOTS; i++) slotStates.push({ owner: null, token: 0 });

function getLayout() {
    if (layoutEntity && layoutEntity.IsValid()) return layoutEntity;
    layoutEntity = null;
    const found = Entities.FindByName(LAYOUT_NAME);
    if (found && found.length > 0 && found[0].IsValid()) layoutEntity = found[0];
    return layoutEntity;
}

function acquireSlot(owner) {
    for (let i = 0; i < MAX_SLOTS; i++) {
        if (slotStates[i].owner === null) {
            slotStates[i].owner = owner;
            slotStates[i].token++;
            return i;
        }
    }
    return -1;
}

function releaseSlot(i) { slotStates[i].owner = null; }

async function showSupporter(supporterId, playerSlot = null) {
    const item = SUPPORTERS[supporterId];
    if (!item) { Console.Log("未知 supporter: " + supporterId); return; }

    const layout = getLayout();
    if (!layout) { Console.Log("未找到布局: " + LAYOUT_NAME); return; }

    const owner = playerSlot === null ? "global" : playerSlot;
    const slotIndex = acquireSlot(owner);
    if (slotIndex < 0) { Console.Log("槽位已满: " + supporterId); return; }
    const myToken = slotStates[slotIndex].token;
    const slotId = "supporter_slot_" + slotIndex;
    const varName = "text" + slotIndex;

    // 全局显示
    if (playerSlot === null) {
        layout.SetDialogVariableString(slotId, varName, item.text);
        for (const cls of ALL_STYLE_CLASSES) layout.SetHasClass(slotId, cls, false);
        if (item.styleClass) layout.SetHasClass(slotId, item.styleClass, true);
        layout.SetHasClass(slotId, "Visible", true);

        await Instance.Delay(item.duration);
        if (slotStates[slotIndex].token !== myToken) return;
        const l = getLayout();
        if (l) l.SetHasClass(slotId, "Visible", false);
        await Instance.Delay(FADE_TIME);
        if (slotStates[slotIndex].token === myToken) releaseSlot(slotIndex);
        return;
    }

    // per-player
    layout.SetDialogVariableStringForPlayer(playerSlot, slotId, varName, item.text);
    for (const cls of ALL_STYLE_CLASSES) layout.SetHasClassForPlayer(playerSlot, slotId, cls, false);
    if (item.styleClass) layout.SetHasClassForPlayer(playerSlot, slotId, item.styleClass, true);
    layout.SetHasClassForPlayer(playerSlot, slotId, "Visible", true);

    await Instance.Delay(item.duration);
    if (slotStates[slotIndex].token !== myToken) return;
    const l = getLayout();
    if (l) l.SetHasClassForPlayer(playerSlot, slotId, "Visible", false);
    await Instance.Delay(FADE_TIME);
    if (slotStates[slotIndex].token === myToken) releaseSlot(slotIndex);
}

Instance.OnActivate(() => {
    Console.Log(`Supporter 脚本已加载（${MAX_SLOTS} 槽位）`);
    for (const id of Object.keys(SUPPORTERS)) {
        Instance.OnScriptInput(id, () => showSupporter(id));
    }
    Console.Log(`已注册 ${Object.keys(SUPPORTERS).length} 个 supporter`);
});

Instance.OnScriptReload({
    before: () => {
        const layout = getLayout();
        if (layout) {
            try {
                for (const c of Instance.GetAllPlayerControllers()) {
                    if (!c || !c.IsValid() || !c.IsConnected()) continue;
                    const slot = c.GetPlayerSlot();
                    for (let i = 0; i < MAX_SLOTS; i++) {
                        layout.SetHasClassForPlayer(slot, "supporter_slot_" + i, "Visible", false);
                    }
                }
            } catch (e) { layoutEntity = null; }
        }
        for (let i = 0; i < MAX_SLOTS; i++) { slotStates[i].owner = null; slotStates[i].token++; }
        return null;
    },
    after: () => Console.Log("Supporter 重载完成"),
});

Console.Log("Supporter 模块初始化完成");