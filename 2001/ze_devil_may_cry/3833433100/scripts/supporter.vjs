const LAYOUT_NAME = "supporter_layout";

//槽位数量（supporter_slot_0 ~ supporter_slot_N-1）
const MAX_SLOTS = 5;

// 所有会用到的样式类
const ALL_STYLE_CLASSES = ["style_default", "style_gold", "style_red", "sper_nor", "sper_dante", "sper_vergil", "sper_nero"];

// 淡入淡出时间（秒），与 CSS 中的 transition-duration 保持一致
const FADE_TIME = 0.5;

// ==================== 内部状态 ====================
let layoutEntity = null;

// 每个槽位的状态：occupied 是否被占用，token 用于避免旧计时器误操作
const slotStates = [];
for (let i = 0; i < MAX_SLOTS; i++) {
    slotStates.push({ occupied: false, token: 0 });
}

function getLayout() {
    if (!layoutEntity || !layoutEntity.IsValid()) {
        layoutEntity = Instance.FindEntitiesByName(LAYOUT_NAME)[0];
    }
    return layoutEntity;
}

// 找一个空闲槽位
function acquireSlot() {
    for (let i = 0; i < MAX_SLOTS; i++) {
        if (!slotStates[i].occupied) {
            slotStates[i].occupied = true;
            slotStates[i].token++;
            return i;
        }
    }
    return -1; // 全忙
}

function releaseSlot(i) {
    slotStates[i].occupied = false;
}

// ==================== 显示文本 ====================
async function showSupporter(supporterId, playerSlot = null) {
    const item = SUPPORTERS[supporterId];
    if (!item) {
        Instance.Msg("未知的 supporter ID: " + supporterId);
        return;
    }

    const layout = getLayout();
    if (!layout || !layout.IsValid()) {
        Instance.Msg("未找到布局实体: " + LAYOUT_NAME);
        return;
    }

    // 决定目标玩家
    let slotsToShow = [];
    if (playerSlot !== null) {
        slotsToShow = [playerSlot];
    } else {
        for (const controller of Instance.GetAllPlayerControllers()) {
            if (controller && controller.IsValid() && controller.IsConnected()) {
                slotsToShow.push(controller.GetPlayerSlot());
            }
        }
    }
    if (slotsToShow.length === 0) return;

    // 申请槽位
    const slotIndex = acquireSlot();
    if (slotIndex < 0) {
        Instance.Msg("所有 supporter 槽位已占用，忽略: " + supporterId);
        return;
    }
    const myToken = slotStates[slotIndex].token;
    const slotId = "supporter_slot_" + slotIndex;
    const varName = "text" + slotIndex;

    // ---- 显示：设置文本 + 样式 + 淡入 ----
    for (const slot of slotsToShow) {
        layout.SetDialogVariableStringForPlayer(slot, slotId, varName, item.text);

        // 清除旧样式类
        for (const cls of ALL_STYLE_CLASSES) {
            layout.SetHasClassForPlayer(slot, slotId, cls, false);
        }
        // 应用新样式类
        if (item.styleClass) {
            layout.SetHasClassForPlayer(slot, slotId, item.styleClass, true);
        }

        // 添加 Visible 类 → 淡入
        layout.SetHasClassForPlayer(slot, slotId, "Visible", true);
    }

    // ---- 等待持续时间 ----
    await Instance.Delay(item.duration);

    // 检查 token：如果槽位已被新显示占用，不执行隐藏
    if (slotStates[slotIndex].token !== myToken) {
        return;
    }

    // ---- 隐藏：移除 Visible 类 → 淡出 ----
    for (const slot of slotsToShow) {
        layout.SetHasClassForPlayer(slot, slotId, "Visible", false);
    }

    // ---- 等待淡出完成，再释放槽位 ----
    await Instance.Delay(FADE_TIME);

    if (slotStates[slotIndex].token === myToken) {
        releaseSlot(slotIndex);
    }
}

// ==================== 触发方式：RunScriptInput ====================
Instance.OnActivate(() => {
    Instance.Msg("Supporter 文本脚本已加载（多槽位防顶掉，共 " + MAX_SLOTS + " 个槽位）");

    const ids = Object.keys(SUPPORTERS);
    for (const id of ids) {
        Instance.OnScriptInput(id, () => {
            showSupporter(id);
        });
    }

    Instance.Msg("已注册 " + ids.length + " 个输入: " + ids.join(", "));
});

// ==================== 重载支持 ====================
Instance.OnScriptReload({
    before: () => {
        const layout = getLayout();
        if (layout && layout.IsValid()) {
            for (const controller of Instance.GetAllPlayerControllers()) {
                if (!controller || !controller.IsValid() || !controller.IsConnected()) continue;
                const slot = controller.GetPlayerSlot();
                for (let i = 0; i < MAX_SLOTS; i++) {
                    layout.SetHasClassForPlayer(slot, "supporter_slot_" + i, "Visible", false);
                }
            }
        }
        // 重置槽位状态
        for (let i = 0; i < MAX_SLOTS; i++) {
            slotStates[i].occupied = false;
            slotStates[i].token++;
        }
        return null;
    },
    after: () => {
        Instance.Msg("Supporter 脚本重载完成");
    },
});

Instance.Msg("Supporter 模块初始化完成");