import { Instance } from "cs_script/point_script";


/* =========================================================
   基本設定
   ========================================================= */

// HUDのEntity名
const HUD_NAME = "hmn_dialogue_hud";

// 会話スロットのアニメーション時間
const ANIMATION_TIME = 0.55;

// 次のセリフを表示するまでの待機時間
const DIALOGUE_DISPLAY_DELAY = 2.5;

// 最後のセリフ表示後、自動非表示を開始するまでの時間
const AUTO_HIDE_DELAY = 2.0;

// 自動非表示のフェードアウト時間
const AUTO_HIDE_FADE_TIME = 0.8;


/* =========================================================
   HUD・会話状態管理
   ========================================================= */

// HUDのキャッシュ
let dialogueHud = null;

// 現在のスロット配置
let topSlot = 0;
let bottomSlot = 0;
let stagingSlot = 1;

// 会話が開始されているか
let hasDialogue = false;

// 会話セッション番号
// クリア時に更新し、古い非同期処理を無効化する
let dialogueSession = 0;

// 会話キュー
const dialogueQueue = [];

// キュー処理中フラグ
let processingQueue = false;


/* =========================================================
   キャラクター定義
   ========================================================= */

const CHARACTERS =
{
    A:
    {
        name: "アルビオン博士",
        portrait: "A"
    },

    B:
    {
        name: "アルビオンだったもの",
        portrait: "B"
