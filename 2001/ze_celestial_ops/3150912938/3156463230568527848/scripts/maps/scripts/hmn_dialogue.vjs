    Scenario04:
    [
        {
            character: "A",
            message: ""
        },

        {
            character: "A",
            message: ""
        },

        {
            character: "A",
            message: ""
        }
    ],


    // -----------------------------------------------------
    // Scenario05：
    // -----------------------------------------------------
    Scenario05:
    [
        {
            character: "A",
            message: ""
        },

        {
            character: "A",
