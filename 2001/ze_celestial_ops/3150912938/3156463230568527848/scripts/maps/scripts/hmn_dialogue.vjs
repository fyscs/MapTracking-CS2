    {
        PlayScenario(
            "Scenario03"
        );
    }
);


// Scenario04
Instance.OnScriptInput(
    "Scenario04",
    () =>
    {
        PlayScenario(
            "Scenario04"
        );
    }
);


// Scenario05
Instance.OnScriptInput(
    "Scenario05",
    () =>
    {
        PlayScenario(
            "Scenario05"
        );
    }
);


// 会話クリア
Instance.OnScriptInput(
    "ClearDialogue",
    () =>
    {
        ClearDialogue();
    }
);


// ラウンド切り替え時のリセット
Instance.OnScriptInput(
    "ResetDialogue",
    () =>
    {
        ClearDialogue();
    }
);
