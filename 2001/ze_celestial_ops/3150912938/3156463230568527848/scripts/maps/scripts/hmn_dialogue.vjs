        name: "ここに名前",
        portrait: "C"
    },

    D:
    {
        name: "ここに名前",
        portrait: "D"
    },

    E:
    {
        name: "ここに名前",
        portrait: "E"
    },

    F:
    {
        name: "ここに名前",
        portrait: "F"
    }
};


/* =========================================================
   シナリオ定義
   ========================================================= */

const SCENARIOS =
{
    // -----------------------------------------------------
    // Scenario01：
    // -----------------------------------------------------
    Scenario01:
    [
        {
            character: "A",
            message: "(意識補強材もあと僅か...)"
        },

        {
