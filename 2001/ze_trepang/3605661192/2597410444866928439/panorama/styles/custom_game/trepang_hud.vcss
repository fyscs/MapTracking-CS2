.Root {
    width: 100%;
    height: 100%;
    font-family: Stratum2, 'Arial Unicode MS';
}
#dialog {
    width: 70%;
    height: 85%;
    horizontal-align: center;
    vertical-align: center;
    padding: 20px;
    background-color: #000000ee;
    border: 5px solid red;
    font-size: 16px;
    color: white;
    transition-property: opacity;
    transition-duration: .1s;
    opacity: 1;
}
#dialog.Dismissed {
    opacity: 0;
}
#dismiss_button {
    border-radius: 4px;
    padding: 18px 48px;
    font-size: 24px;
    margin-top: 90%;
    margin-left: 74%;
    border: 1px solid rgb(255, 0, 0);
    transition-property: background-color;
    transition-duration: .1s;
    background-color: #000000bb;
}
#dismiss_button:hover {
    background-color: #777777bb;
    color: red;
    sound: "UIPanorama.buymenu_mouseover";
}
#random_button {
    border-radius: 4px;
    padding: 18px 48px;
    font-size: 24px;
    margin-top: 90%;
    margin-left: 50%;
    border: 1px solid rgb(255, 0, 0);
    transition-property: background-color;
    transition-duration: .1s;
    background-color: #000000bb;
}
#random_button:hover {
    background-color: #777777bb;
    color: red;
    sound: "UIPanorama.buymenu_mouseover";
}
