import { Instance, CSPlayerPawn, CSInputs } from "cs_script/point_script";

// 不要修改这些常量
const TEAM_CT = 3; // 3 代表 CT
const TEAM_T = 2; // 2 代表 T
const ALIVE = true;
const DEAD = false;

const DEBUG = false;
const password = "112234346565";
let res = "";
let lastPress = 0;
let times = 0;

// Mine function
Instance.OnScriptInput("pressUp", pressUp);
Instance.OnScriptInput("pressDown", pressDown);
Instance.OnScriptInput("pressLeft", pressLeft);
Instance.OnScriptInput("pressRight", pressRight);
Instance.OnScriptInput("pressA", pressA);
Instance.OnScriptInput("pressB", pressB);
Instance.OnScriptInput("resetScript", resetScript);
Instance.OnScriptInput("giveHP", giveHP);

function pressUp() {SetPassWord("1");}
function pressDown() {SetPassWord("2");}
function pressLeft() {SetPassWord("3");}
function pressRight() {SetPassWord("4");}
function pressA() {SetPassWord("5");}
function pressB() {SetPassWord("6");}

function SetPassWord(num = "") {
	if (num === "") return;
	let msec = Instance.GetGameTime();
	// print("lastPress: "+ typeof lastPress);
	// return;
	let r_sec =  lastPress === 0 ? 0 : msec - lastPress;
	if (r_sec > 3) resetScript();//3s不按自动重置
	lastPress = msec;
	res += num;
	times++;
	if (DEBUG) {
		print("Msec: " + msec);
		print("delay: " + r_sec);
		print("Button: " + num);
		print("Res: " + res);
		print("Times: " + times);
	}
	if (times >= 12) {
		if (res === password) {
			if (DEBUG) {
				print("Res: " + res);
				print("PASS");
			}
			EntFire("secret@sound", "StartSound");
			EntFire("secret@door", "SetNonsolid");
			EntFire("fc_a", "Lock");
			EntFire("fc_b", "Lock");
			EntFire("fc_up", "Lock");
			EntFire("fc_down", "Lock");
			EntFire("fc_left", "Lock");
			EntFire("fc_right", "Lock");
		}
		resetScript();
	}
}

function resetScript() {
	res = "";
	lastPress = 0;
	times = 0;
}

function print(text="") {Instance.Msg(text);}

function EntFire(targetname, key, value = "", delay = 0) { 
	Instance.EntFireAtName({
		name: targetname,
		input: key,
		value: value,
		delay: delay
	});
}

function giveHP(inputData) {
	let targetPlayer = inputData.activator;
	if (!(targetPlayer instanceof CSPlayerPawn)) return;
	if (targetPlayer.GetTeamNumber() !== TEAM_CT) return;
	targetPlayer.SetMaxHealth(150);
	targetPlayer.SetHealth(150);
}

Instance.OnRoundStart(()=>{
	if (DEBUG) print("重置脚本");
	resetScript();
	// EntFire("secret@door", "SetSolid");
});

Instance.OnRoundEnd(()=>{
	if (DEBUG) print("重置脚本");
	resetScript();
});

