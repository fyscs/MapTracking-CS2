import { Instance, Entities, Console, CSInputs, CSPlayerPawn } from "cs_script/point_script";

let SCRIPT = undefined;
let HUD = undefined;

let WARMUP = true;

let ADMIN = false;
let ADMIN_STAGE = 1;

let WON_STAGE1 = false;
let WON_STAGE2 = false;
let WON_STAGE3 = false;

let DISABLE_ZM_ITEM = false;

const REGISTERED_ITEMS = [];

// logic_relay: OnSpawn > (weapon_*) > FireUser1
// weapon_*: OnUser1 > Map_Script > RunScriptInput > RegisterItem
// Script registers the activator (logic_relay) and caller (weapon_*) for further activation
Instance.OnScriptInput("RegisterItem", ({ caller, activator }) => {
	if (!caller?.IsValid() || !activator?.IsValid())
		return;

	if (!caller.GetClassName().startsWith("weapon_") || activator.GetClassName() !== "logic_relay") {
		Console.Log("[Lifeforms] RegisterItem expects the weapon as caller and its relay as activator");
		return;
	}

	if (REGISTERED_ITEMS.some((item) => item.weapon === caller && item.relay === activator))
		return;

	REGISTERED_ITEMS.push({ weapon: caller, relay: activator });
});

Instance.OnScriptInput("EnableZombieItems", () => {
	DISABLE_ZM_ITEM = false;
});

Instance.OnScriptInput("DisableZombieItems", () => {
	DISABLE_ZM_ITEM = true;
})

Instance.SetThink(() => {
	Instance.SetNextThink(Instance.GetGameTime() + 0.01);

	for (let index = REGISTERED_ITEMS.length - 1; index >= 0; index--) {
		const item = REGISTERED_ITEMS[index];
		if (!item.weapon.IsValid() || !item.relay.IsValid()) {
			REGISTERED_ITEMS.splice(index, 1);
		}
	}

	for (const item of REGISTERED_ITEMS) {
		const owner = item.weapon.GetOwner();
		if (!(owner instanceof CSPlayerPawn) || !owner.IsValid() || !owner.IsAlive())
			continue;

		if (!owner.WasInputJustPressed(CSInputs.USE))
			continue;

		// Check if zombie item is disabled
		if (DISABLE_ZM_ITEM && item.weapon.GetClassName() === "weapon_knife")
			continue;

		item.relay.FireInput({ input: "Trigger", caller: item.weapon, activator: owner });
	}
});

Instance.SetNextThink(Instance.GetGameTime() + 0.01);

Instance.OnScriptInput("WARMUP = false", () => {
	WARMUP = false;
});

Instance.OnScriptInput("WonStage1", () => {
	WON_STAGE1 = true;
});

Instance.OnScriptInput("WonStage2", () => {
	WON_STAGE2 = true;
});

Instance.OnScriptInput("WonStage3", () => {
	WON_STAGE3 = true;
});

Instance.OnScriptInput("SetStage1", () => {
	ADMIN = true;
	ADMIN_STAGE = 1;
});

Instance.OnScriptInput("SetStage2", () => {
	ADMIN = true;
	ADMIN_STAGE = 2;
});

Instance.OnScriptInput("SetStage3", () => {
	ADMIN = true;
	ADMIN_STAGE = 3;
});

Instance.OnScriptInput("SetStage4", () => {
	ADMIN = true;
	ADMIN_STAGE = 4;
});

Instance.OnScriptInput("SetPractice", () => {
	ADMIN = true;
	ADMIN_STAGE = 5;
});

Instance.OnScriptInput("ResetStage", () => {
	ADMIN = false;
});

Instance.OnScriptInput("ApplyScore200", ({ caller, activator }) => {
	if (activator?.IsValid() && activator.GetTeamNumber() === 3) {
		const player_controller = activator.GetPlayerController();
		player_controller.AddScore(200);
	}
});

Instance.OnScriptInput("ApplyScore1000", ({ caller, activator }) => {
	if (activator?.IsValid() && activator.GetTeamNumber() === 3) {
		const player_controller = activator.GetPlayerController();
		player_controller.AddScore(1000);
	}
});

const mapCreditsText = {
	channel: 1,
	size: 32,
	posX: 0.5,
	posY: 0.52,
	duration: 2,
	fadeInTime: 0.1,
	fadeOutTime: 1,
};

function displayMapCredits() {
	if (!getHudLayout()) {
		Console.Log("[Lifeforms] Missing custom_hud_layout: Map_Hud");
		return;
	}
	setText("Map by m4dara", mapCreditsText);
}

Instance.OnScriptInput("HudShowIntro", displayMapCredits);

const stageNameText = {
	channel: 2,
	size: 32,
	posX: 0.5,
	posY: 0.08,
	duration: 20,
	color: 'white',
	fadeInTime: 0.1,
	fadeOutTime: 1,
};

Instance.OnScriptInput("HudShowStageOrigin", () => {
	if (!getHudLayout()) {
		Console.Log("[Lifeforms] Missing custom_hud_layout: Map_Hud");
		return;
	}
	setText(" T H E      O R I G I N ", stageNameText);
});

Instance.OnScriptInput("HudShowStageFlood", () => {
	if (!getHudLayout()) {
		Console.Log("[Lifeforms] Missing custom_hud_layout: Map_Hud");
		return;
	}
	setText(" T H E      F L O O D ", stageNameText);
});

Instance.OnScriptInput("HudShowStagePresence", () => {
	if (!getHudLayout()) {
		Console.Log("[Lifeforms] Missing custom_hud_layout: Map_Hud");
		return;
	}
	setText(" T H E      P R E S E N C E ", stageNameText);
});

Instance.OnScriptInput("HudShowStageAscent", () => {
	if (!getHudLayout()) {
		Console.Log("[Lifeforms] Missing custom_hud_layout: Map_Hud");
		return;
	}
	setText(" T H E      A S C E N T ", stageNameText);
});

Instance.OnRoundStart(() => {
	SCRIPT = undefined;
	HUD = undefined;
	resetTextHud();
	ResetScript();

	if (WARMUP) {
		Entities.FireInput({ name: "Map_Warmup_Relay", input: "Trigger", delay: 0.02 });
		SCRIPT.FireInput({ input: "RunScriptInput", value: "WARMUP = false", delay: 30.00 });
		return;
	}

	StartStage(PickStage());
});

function PickStage() {
	if (ADMIN)
		return ADMIN_STAGE;

	const stages = [];
	if (!WON_STAGE1)
		stages.push(1);

	if (!WON_STAGE2)
		stages.push(2);

	if (!WON_STAGE3)
		stages.push(3);

	if (stages.length === 0)
		return 4;

	return stages[Math.floor(Math.random() * stages.length)];
}

function StartStage(stage) {
	Console.Log("[Lifeforms] Stage " + stage);

	if (stage === 1)
		Entities.FireInput({ name: "Relay_Start_Stage1", input: "Trigger", delay: 1.20 });

	if (stage === 2)
		Entities.FireInput({ name: "Relay_Start_Stage2", input: "Trigger", delay: 1.20 });

	if (stage === 3)
		Entities.FireInput({ name: "Relay_Start_Stage3", input: "Trigger", delay: 1.20 });

	if (stage === 4) {
		Entities.FireInput({ name: "Relay_Pick_Final_Stage", input: "Enable", delay: 1.19 });
		Entities.FireInput({ name: "Relay_Pick_Final_Stage", input: "Trigger", delay: 1.20 });
	}

	if (stage === 5) {
		Entities.FireInput({ name: "Relay_Pick_Practice", input: "Enable", delay: 1.19 });
		Entities.FireInput({ name: "Relay_Pick_Practice", input: "Trigger", delay: 1.20 });
	}
}

function ResetScript() {
	SCRIPT = Entities.FindByName("Map_Script")[0];
	DISABLE_ZM_ITEM = false;
}

/*
 * GAME TEXT HUD USAGE
 *
 * Implemented by Pengu (S2ZE).
 *
 * Add a custom_hud_layout entity in Hammer and set its targetname to the
 * value of HUD_ENTITY_NAME ('Map_Hud'). Set its layout to
 * 'panorama/layout/custom_game/game_text_lifeforms.vxml'.
 * The layout source uses panorama/styles/custom_game/game_text_lifeforms.css.
 *
 * Global text (prefer channels 1-4):
 * setText(text, { channel, size, posX, posY, duration, color?, fadeInTime?, fadeOutTime? });
 * Example: setText('Round starting', { channel: 1, size: 48, posX: 0.5, posY: 0.1, duration: 5, color: 'red' });
 *
 * Per-player text (channels 5-6 only):
 * setTextPlayer(text, player, { channel, size, posX, posY, duration, color?, fadeInTime?, fadeOutTime? });
 * Example: setTextPlayer('Item ready', controller, { channel: 5, size: 40, posX: 0.05, posY: 0.5, duration: 5 });
 *
 * posX and posY are clamped to 0.00-1.00.
 * Size is rounded and clamped to 20-72.
 * duration <= 0 keeps the text visible until it is cleared or replaced.
 * color defaults to 'white'; fade times default to 0.25 seconds.
 *
 * clearText(channel);                 // Clear one global channel.
 * clearTextPlayer(player, channel);   // Clear channel 5 or 6 for one player.
 * clearAllText();                     // Clear every global and player channel.
 */
const HUD_ENTITY_NAME = 'Map_Hud';
const TEXT_VARIABLE_NAME = 'text';
const FADED_OUT_CLASS = 'FadedOut';
const TEXT_CHANNELS = [1, 2, 3, 4, 5, 6, 7];
const PLAYER_TEXT_CHANNELS = [5, 6];
const DEFAULT_X_POSITION = 0;
const DEFAULT_Y_POSITION = 0;
const MIN_FONT_SIZE = 20;
const MAX_FONT_SIZE = 72;
const DEFAULT_FONT_SIZE = 32;
const MIN_FADE_DURATION = 0;
const MAX_FADE_DURATION = 1;
const DEFAULT_FADE_DURATION = 0;
const FADE_START_DELAY = 0.03;
const COLOR_CLASSES = {
	white: 'ColorWhite',
	red: 'ColorRed',
	orange: 'ColorOrange',
	yellow: 'ColorYellow',
	green: 'ColorGreen',
	blue: 'ColorBlue',
	purple: 'ColorPurple',
	ff0000: 'ColorFF0000',
	'00ff00': 'Color00FF00',
	'0000ff': 'Color0000FF',
	'f28211': 'ColorF28211',
	'f1b601': 'ColorF1B601',
	'fff46a': 'ColorFFF46A',
};

function setText(text, options) {
	const { channel, size, posX, posY, duration, color = 'white', fadeInTime = 0.25, fadeOutTime = 0.25, } = options;
	if (!Number.isFinite(duration)) {
		throw new TypeError('Text display duration must be a finite number.');
	}
	const normalizedFadeInTime = normalizeFadeDuration(fadeInTime);
	const normalizedFadeOutTime = normalizeFadeDuration(fadeOutTime);
	const state = channelStates[channel];
	const panelId = getChannelPanelIds(channel).text;
	const requestId = ++state.textRequestId;
	// Cancel an in-progress standalone fade and make repeated calls fade in too.
	++state.fadeRequestId;
	setHudTextFadeDuration(0, channel);
	getHudLayout().SetHasClass(panelId, FADED_OUT_CLASS, true);
	setHudText(text, channel);
	setHudTextSize(size, channel);
	setHudTextColor(color, channel);
	setHudTextPosition(posX, posY, channel);
	void runTextSequence(channel, requestId, duration, normalizedFadeInTime, normalizedFadeOutTime);
}

function setTextPlayer(text, player, options) {
	const { channel, size, posX, posY, duration, color = 'white', fadeInTime = 0.25, fadeOutTime = 0.25, } = options;
	if (!isPlayerTextChannel(channel)) {
		throw new RangeError('Player HUD text channel must be 5 or 6.');
	}
	if (!Number.isFinite(duration)) {
		throw new TypeError('Text display duration must be a finite number.');
	}
	const normalizedFadeInTime = normalizeFadeDuration(fadeInTime);
	const normalizedFadeOutTime = normalizeFadeDuration(fadeOutTime);
	const playerSlot = player.GetPlayerSlot();
	const state = getPlayerChannelState(playerSlot, channel);
	const panelId = getChannelPanelIds(channel).text;
	state.hasPlayerOverride = true;
	const requestId = ++state.textRequestId;
	// Cancel an in-progress standalone fade and make repeated calls fade in too.
	++state.fadeRequestId;
	setHudTextFadeDurationForPlayer(0, playerSlot, channel);
	setPlayerClassOverride(getHudLayout(), playerSlot, panelId, FADED_OUT_CLASS, true);
	setHudTextForPlayer(text, playerSlot, channel);
	setHudTextSizeForPlayer(size, playerSlot, channel);
	setHudTextColorForPlayer(color, playerSlot, channel);
	setHudTextPositionForPlayer(posX, posY, playerSlot, channel);
