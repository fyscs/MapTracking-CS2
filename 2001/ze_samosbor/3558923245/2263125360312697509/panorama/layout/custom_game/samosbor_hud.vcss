.radar_container {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    overflow: noclip;
    z-index: 150;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    flow-children: none;
}
.radar_container.Visible {
    opacity: 1;
}
.radar_overlay {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    horizontal-align: center;
    vertical-align: center;
}
.radar_frame {
    width: 750px;
    height: 750px;
    horizontal-align: center;
    vertical-align: center;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#141414ff), color-stop(0.5, #0a0a0aff), to(#050505ff));
    border: 3px solid #6e6e6eff;
    flow-children: none;
    overflow: noclip;
}
.radar_grid {
    width: 750px;
    height: 750px;
    horizontal-align: left;
    vertical-align: top;
    flow-children: none;
    margin-left: -2px;
    margin-top: -3px;
}
.radar_grid_v {
    width: 1px;
    height: 750px;
    horizontal-align: left;
    vertical-align: top;
    background-color: rgba(120, 120, 120, 0.22);
    margin-left: -2px;
    margin-top: -3px;
