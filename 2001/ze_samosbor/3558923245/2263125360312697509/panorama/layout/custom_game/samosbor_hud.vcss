}
.ki_core {
    transform: translate3d(0px, 0px, 0px) rotateZ(-20deg) scale3d(2.2, 2.2, 1);
}
.ki_ring {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(0.9, 0.9, 1);
}
.ki_shards {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(1, 1, 1);
}
.ki_glow {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(0.8, 0.8, 1);
}
.kill_icon.Go .ki_core {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(1, 1, 1);
    opacity: 1;
    transition-duration: 0.32s, 0.18s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.kill_icon.Go .ki_ring {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(1.5, 1.5, 1);
    opacity: 1;
    transition-duration: 0.2s, 0.06s;
    transition-timing-function: ease-out;
}
.kill_icon.Go .ki_shards {
    transform: translate3d(0px, 0px, 0px) rotateZ(12deg) scale3d(1.35, 1.35, 1);
    opacity: 1;
    transition-duration: 0.2s, 0.06s;
    transition-timing-function: ease-out;
}
.kill_icon.Go .ki_glow {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(1.3, 1.3, 1);
    opacity: 0.95;
    transition-duration: 0.16s, 0.06s;
    transition-timing-function: ease-out;
}
.kill_icon.Fade .ki_ring {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(2.4, 2.4, 1);
    opacity: 0;
    transition-duration: 0.35s, 0.3s;
    transition-timing-function: ease-out;
}
.kill_icon.Fade .ki_shards {
    transform: translate3d(0px, 0px, 0px) rotateZ(28deg) scale3d(1.85, 1.85, 1);
    opacity: 0;
    transition-duration: 0.4s, 0.35s;
    transition-timing-function: ease-out;
}
.kill_icon.Fade .ki_glow {
    transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale3d(1.6, 1.6, 1);
    opacity: 0;
    transition-duration: 0.35s, 0.3s;
    transition-timing-function: ease-out;
}
.kill_icon.Out .ki_core {
    transform: translate3d(0px, 14px, 0px) rotateZ(0deg) scale3d(0.9, 0.9, 1);
    opacity: 0;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-in;
}
.score_overlay {
    width: 100%;
    height: 100%;
    flow-children: none;
    overflow: noclip;
    z-index: 180;
    opacity: 0;
    visibility: collapse;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.score_overlay.Visible {
    opacity: 1;
    visibility: visible;
}
.gm_open_btn {
    width: 250px;
