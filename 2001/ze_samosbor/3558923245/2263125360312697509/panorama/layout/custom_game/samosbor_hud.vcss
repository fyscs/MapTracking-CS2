.slot_reel_strip.SpinTo-0,.slot_reel_strip.SpinTo-1,.slot_reel_strip.SpinTo-2,.slot_reel_strip.SpinTo-3,.slot_reel_strip.SpinTo-4 {
    animation-duration: 1.8s;
    animation-timing-function: cubic-bezier(0.12, 0.85, 0.25, 1);
    animation-iteration-count: 1;
}
.slot_icon {
    width: 88px;
    height: 88px;
    horizontal-align: center;
    vertical-align: center;
    visibility: collapse;
}
.slot_icon.Visible {
    visibility: visible;
}
.slot_result_text {
    width: 612px;
    text-align: center;
    font-size: 21px;
    font-weight: bold;
    color: rgb(230, 190, 110);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 2px;
    text-transform: uppercase;
    text-shadow: 0px 3px 0px rgba(0, 0, 0, 1), 0px 2px 2px rgba(0, 0, 0, 0.9);
    margin-top: 38px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.slot_result_text.Visible {
    opacity: 1;
}
.slot_reel_frame.WinFlash {
    animation-name: slotWinFlash;
    animation-duration: 0.3s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: 4;
}
@keyframes 'slotWinFlash' {
    from {
        border-color: #8a6a2a;
        box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.6);
    }
to {
        border-color: #e8c15a;
        box-shadow: 0px 0px 14px rgba(255, 215, 0, 0.5);
    }
}
.slot_strip {
    width: 100%;
    height: 392px;
    flow-children: down;
    transform: translateY(0px);
    transition-property: transform;
    transition-duration: 0.15s;
    transition-timing-function: linear;
}
.slot_strip.Shifted {
    transform: translateY(-98px);
}
.slot_strip.NoTransition {
    transition-duration: 0s;
}
#slot_reel_left_strip.SpinTo-0 {
    animation-name: slotSpinLeftTo0;
}
#slot_reel_left_strip.SpinTo-1 {
    animation-name: slotSpinLeftTo1;
}
#slot_reel_left_strip.SpinTo-2 {
    animation-name: slotSpinLeftTo2;
}
#slot_reel_left_strip.SpinTo-3 {
    animation-name: slotSpinLeftTo3;
}
#slot_reel_left_strip.SpinTo-4 {
    animation-name: slotSpinLeftTo4;
}
#slot_reel_center_strip.SpinTo-0 {
    animation-name: slotSpinCenterTo0;
}
#slot_reel_center_strip.SpinTo-1 {
    animation-name: slotSpinCenterTo1;
}
#slot_reel_center_strip.SpinTo-2 {
    animation-name: slotSpinCenterTo2;
}
#slot_reel_center_strip.SpinTo-3 {
    animation-name: slotSpinCenterTo3;
}
#slot_reel_center_strip.SpinTo-4 {
    animation-name: slotSpinCenterTo4;
}
#slot_reel_right_strip.SpinTo-0 {
    animation-name: slotSpinRightTo0;
}
#slot_reel_right_strip.SpinTo-1 {
    animation-name: slotSpinRightTo1;
}
#slot_reel_right_strip.SpinTo-2 {
    animation-name: slotSpinRightTo2;
}
#slot_reel_right_strip.SpinTo-3 {
    animation-name: slotSpinRightTo3;
}
#slot_reel_right_strip.SpinTo-4 {
    animation-name: slotSpinRightTo4;
}
#slot_reel_center_strip.slot_reel_strip {
    animation-delay: 0.2s;
}
#slot_reel_right_strip.slot_reel_strip {
    animation-delay: 0.4s;
}
@keyframes 'slotSpinLeftTo0' {
    from {
        transform: translateY(0px);
    }
to {
        transform: translateY(-4680px);
    }
}
@keyframes 'slotSpinLeftTo1' {
    from {
        transform: translateY(0px);
    }
to {
        transform: translateY(-3900px);
    }
}
