}
.gm_sw_off.StateActive {
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#a84a4aff), to(#4a1616ff));
}
.gm_sw.StateActive .gm_sw_text {
    color: rgb(255, 250, 240);
