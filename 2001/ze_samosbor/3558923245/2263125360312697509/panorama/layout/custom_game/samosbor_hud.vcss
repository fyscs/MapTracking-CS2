.skin_card {
    width: 280px;
    height: 300px;
    margin-right: 16px;
    flow-children: down;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#0d090bff), to(#000000ff));
    border: 1px solid #2a2226ff;
    border-radius: 2px;
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.6);
    transition-property: border-color, transform, box-shadow;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
.skin_card:hover {
    border-color: #d0708fff;
    transform: translate3d(0px, -6px, 0px);
    box-shadow: 0px 12px 26px rgba(180, 80, 115, 0.28);
    sound: 'UIPanorama.sidemenu_rollover';
}
.skin_card.Selected {
    border-color: #d0708fff;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#2a1620ff), to(#000000ff));
    sound: "UIPanorama.tab_mainmenu_shop";
}
.skin_card.Locked {
    opacity: 0.28;
}
.skin_card.Locked:hover {
    border-color: #2a2226ff;
    transform: translate3d(0px, 0px, 0px);
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.6);
}
