}
.gm_reset {
    width: 570px;
    height: 48px;
    margin-top: 18px;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#2a2014ff), to(#0a0806ff));
    border: 1px solid #8a6a2aff;
    transition-property: border-color, box-shadow;
    transition-duration: 0.18s;
}
.gm_reset:hover {
    border-color: #f3d68aff;
    box-shadow: 0px 0px 20px 0px #d9b25f40;
    sound: 'UIPanorama.sidemenu_rollover';
}
.gm_reset_text {
    horizontal-align: center;
    vertical-align: center;
    font-size: 15px;
    font-weight: bold;
    color: rgb(243, 214, 138);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 0px;
}
.gm_noaccess {
    width: 100%;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 18px;
    text-align: center;
    font-size: 16px;
    font-weight: bold;
    color: rgb(150, 124, 74);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 0px;
    visibility: collapse;
}
.gm_noaccess.Visible {
    visibility: visible;
}
.buff_vote_container {
    width: 100%;
    height: 100%;
    flow-children: none;
    overflow: noclip;
    z-index: 195;
    opacity: 0;
    visibility: collapse;
    transition-property: opacity;
    transition-duration: 0.3s;
}
.buff_vote_container.Visible {
    opacity: 1;
    visibility: visible;
}
.buff_vote_overlay {
    width: 100%;
    height: 100%;
    background-color: gradient(radial, 50% 55%, 0% 0%, 75% 75%, from(#000000b0), to(#000000f2));
}
.buff_vote_head {
    width: 100%;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 170px;
    flow-children: down;
}
.buff_vote_title {
    width: 100%;
    text-align: center;
    font-size: 34px;
    font-weight: bold;
    color: rgb(232, 218, 190);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 8px;
    text-shadow: 0px 4px 8px rgba(0, 0, 0, 1);
}
.buff_vote_sub {
    width: 100%;
    text-align: center;
    margin-top: 6px;
    font-size: 14px;
    font-weight: bold;
    color: rgb(140, 128, 104);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 5px;
}
.buff_timer_box {
    width: 84px;
    height: 84px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 150px;
    border-radius: 42px;
    border: 2px solid #4a3f28ff;
    background-color: #0b0906f0;
    box-shadow: 0px 0px 22px 0px #000000ff;
}
.buff_vote_timer {
    horizontal-align: center;
    vertical-align: center;
    font-size: 38px;
    font-weight: bold;
    color: rgb(232, 196, 110);
    font-family: Stratum2, 'Arial Unicode MS';
}
.buff_row {
    width: 1000px;
    height: 430px;
    horizontal-align: center;
    vertical-align: center;
    flow-children: right;
    overflow: noclip;
    perspective: 1100;
}
.buff_card {
    width: 280px;
    height: 400px;
    margin: 15px 25px 0px 25px;
    flow-children: none;
    overflow: noclip;
    background-color: #0c0a07ff;
    border: 1px solid #2c2519ff;
    box-shadow: 0px 18px 34px 0px #000000e6;
    transform: translate3d(1500px, -160px, 0px) rotateZ(38deg) scale3d(1, 1, 1);
    opacity: 0;
    transition-property: transform, box-shadow, border-color;
    transition-duration: 0.22s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}
#buff_card_1.FlyIn {
    transform: translate3d(0px, 0px, 0px) rotateZ(-3deg) scale3d(1, 1, 1);
    opacity: 1;
    animation-name: buffThrow1;
    animation-duration: 0.85s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
    sound: "Giga.CardDeal1";
}
#buff_card_2.FlyIn {
    transform: translate3d(0px, 0px, 0px) rotateZ(1.5deg) scale3d(1, 1, 1);
    opacity: 1;
    animation-name: buffThrow2;
    animation-duration: 0.85s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
    sound: "Giga.CardDeal2";
}
#buff_card_3.FlyIn {
    transform: translate3d(0px, 0px, 0px) rotateZ(-1deg) scale3d(1, 1, 1);
    opacity: 1;
    animation-name: buffThrow3;
    animation-duration: 0.85s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
    sound: "Giga.CardDeal3";
}
@keyframes 'buffThrow1' {
    0% {
        transform: translate3d(1500px, -160px, 0px) rotateZ(38deg) scale3d(1.08, 1.08, 1);
        opacity: 0;
    }
12% {
        opacity: 1;
    }
58% {
        transform: translate3d(-46px, 14px, 0px) rotateZ(-11deg) scale3d(1, 1, 1);
    }
76% {
        transform: translate3d(12px, -5px, 0px) rotateZ(1deg) scale3d(1, 1, 1);
    }
90% {
        transform: translate3d(-4px, 1px, 0px) rotateZ(-4deg) scale3d(1, 1, 1);
    }
100% {
        transform: translate3d(0px, 0px, 0px) rotateZ(-3deg) scale3d(1, 1, 1);
        opacity: 1;
    }
}
@keyframes 'buffThrow2' {
    0% {
        transform: translate3d(1500px, -200px, 0px) rotateZ(44deg) scale3d(1.08, 1.08, 1);
        opacity: 0;
    }
12% {
        opacity: 1;
    }
58% {
        transform: translate3d(-38px, 18px, 0px) rotateZ(-7deg) scale3d(1, 1, 1);
    }
76% {
        transform: translate3d(10px, -6px, 0px) rotateZ(4deg) scale3d(1, 1, 1);
    }
90% {
        transform: translate3d(-3px, 1px, 0px) rotateZ(0.5deg) scale3d(1, 1, 1);
    }
100% {
        transform: translate3d(0px, 0px, 0px) rotateZ(1.5deg) scale3d(1, 1, 1);
        opacity: 1;
    }
}
@keyframes 'buffThrow3' {
    0% {
        transform: translate3d(1500px, -120px, 0px) rotateZ(31deg) scale3d(1.08, 1.08, 1);
        opacity: 0;
    }
12% {
        opacity: 1;
    }
58% {
        transform: translate3d(-30px, 10px, 0px) rotateZ(-9deg) scale3d(1, 1, 1);
    }
76% {
        transform: translate3d(8px, -4px, 0px) rotateZ(2deg) scale3d(1, 1, 1);
    }
90% {
        transform: translate3d(-2px, 1px, 0px) rotateZ(-2deg) scale3d(1, 1, 1);
    }
100% {
        transform: translate3d(0px, 0px, 0px) rotateZ(-1deg) scale3d(1, 1, 1);
        opacity: 1;
    }
}
#buff_card_1.FlyIn:hover,#buff_card_2.FlyIn:hover,#buff_card_3.FlyIn:hover {
    transform: translate3d(0px, -18px, 0px) rotateZ(0deg) scale3d(1.05, 1.05, 1);
    box-shadow: 0px 30px 44px 0px #000000f2;
    border-color: #6a5a38ff;
    sound: "Giga.CardHover";
}
#buff_card_1.FlyIn.Picked,#buff_card_2.FlyIn.Picked,#buff_card_3.FlyIn.Picked {
    transform: translate3d(0px, -24px, 0px) rotateZ(0deg) scale3d(1.06, 1.06, 1);
    border-color: #e8c15aff;
    box-shadow: 0px 0px 36px 4px #d8a83a66;
    sound: "Giga.CardPick";
}
#buff_card_1.FlyOut {
    transform: translate3d(-90px, 1300px, 0px) rotateZ(-48deg) scale3d(1, 1, 1);
    opacity: 0;
    animation-name: buffDrop1;
    animation-duration: 1.2s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
    sound: "Giga.CardSweep";
}
#buff_card_2.FlyOut {
    transform: translate3d(60px, 1300px, 0px) rotateZ(36deg) scale3d(1, 1, 1);
    opacity: 0;
    animation-name: buffDrop2;
    animation-duration: 1.2s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
    sound: "Giga.CardSweep";
}
#buff_card_3.FlyOut {
    transform: translate3d(-40px, 1300px, 0px) rotateZ(-30deg) scale3d(1, 1, 1);
    opacity: 0;
    animation-name: buffDrop3;
    animation-duration: 1.2s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
    sound: "Giga.CardSweep";
}
@keyframes 'buffDrop1' {
    0% {
        transform: translate3d(0px, 0px, 0px) rotateZ(-3deg) scale3d(1, 1, 1);
        opacity: 1;
    }
40% {
        transform: translate3d(-10px, -26px, 0px) rotateZ(-12deg) scale3d(1, 1, 1);
        opacity: 1;
    }
100% {
        transform: translate3d(-90px, 1300px, 0px) rotateZ(-48deg) scale3d(1, 1, 1);
        opacity: 0;
    }
}
@keyframes 'buffDrop2' {
    0% {
        transform: translate3d(0px, 0px, 0px) rotateZ(1.5deg) scale3d(1, 1, 1);
        opacity: 1;
    }
40% {
        transform: translate3d(8px, -26px, 0px) rotateZ(9deg) scale3d(1, 1, 1);
        opacity: 1;
    }
100% {
        transform: translate3d(60px, 1300px, 0px) rotateZ(36deg) scale3d(1, 1, 1);
        opacity: 0;
    }
}
@keyframes 'buffDrop3' {
    0% {
        transform: translate3d(0px, 0px, 0px) rotateZ(-1deg) scale3d(1, 1, 1);
        opacity: 1;
    }
40% {
        transform: translate3d(-6px, -26px, 0px) rotateZ(-8deg) scale3d(1, 1, 1);
        opacity: 1;
    }
100% {
        transform: translate3d(-40px, 1300px, 0px) rotateZ(-30deg) scale3d(1, 1, 1);
        opacity: 0;
    }
}
.bc_face {
    width: 280px;
    height: 400px;
    flow-children: none;
}
.bc_body {
    width: 280px;
    height: 400px;
    flow-children: down;
    visibility: collapse;
}
.bc_body.Visible {
    visibility: visible;
}
.bc_team_ct {
    background-color: gradient(radial, 50% 30%, 0% 0%, 90% 90%, from(#2a2010ff), to(#0a0805ff));
}
.bc_team_t {
    background-color: gradient(radial, 50% 30%, 0% 0%, 90% 90%, from(#142412ff), to(#050805ff));
}
.bc_stripe {
    width: 280px;
    height: 6px;
}
.bc_team_ct .bc_stripe {
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#8a6620ff), to(#e8c15aff));
}
.bc_team_t .bc_stripe {
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#3a6a20ff), to(#9ee05aff));
}
.bc_type {
    width: 280px;
    margin-top: 16px;
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 4px;
}
.bc_team_ct .bc_type {
    color: rgb(170, 140, 80);
}
.bc_team_t .bc_type {
    color: rgb(120, 170, 90);
}
.bc_emblem {
    width: 116px;
    height: 116px;
    horizontal-align: center;
    margin-top: 22px;
    flow-children: none;
}
.bc_emblem_ring {
    width: 116px;
    height: 116px;
    border-radius: 58px;
    border: 3px solid #ffffff22;
}
.bc_team_ct .bc_emblem_ring {
    border-color: #d8a83aff;
    background-color: gradient(radial, 50% 40%, 0% 0%, 60% 60%, from(#5a4418ff), to(#140f06ff));
    box-shadow: 0px 0px 26px 0px #d8a83a55;
}
.bc_team_t .bc_emblem_ring {
    border-color: #7fc24aff;
    background-color: gradient(radial, 50% 40%, 0% 0%, 60% 60%, from(#284a18ff), to(#080f06ff));
    box-shadow: 0px 0px 26px 0px #7fc24a55;
}
.bc_name {
    width: 280px;
    margin-top: 6px;
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    color: rgb(240, 232, 214);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 3px;
    text-shadow: 0px 3px 6px #000000ff;
}
.bc_divider {
    width: 60px;
    height: 2px;
    horizontal-align: center;
    margin-top: 12px;
}
.bc_team_ct .bc_divider {
    background-color: #d8a83aaa;
}
.bc_team_t .bc_divider {
    background-color: #7fc24aaa;
}
.bc_desc {
    width: 228px;
    horizontal-align: center;
    margin-top: 10px;
    text-align: center;
    font-size: 15px;
    color: rgb(176, 168, 150);
    font-family: Stratum2, 'Arial Unicode MS';
    text-shadow: 0px 2px 4px #000000ff;
}
.bc_rivet {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #4a4032ff;
    box-shadow: inset 0px 1px 1px 0px #00000099;
    z-index: 5;
}
.bc_rivet_tl {
    horizontal-align: left;
    vertical-align: top;
    margin: 14px 0px 0px 10px;
}
.bc_rivet_tr {
    horizontal-align: right;
    vertical-align: top;
    margin: 14px 10px 0px 0px;
}
.bc_rivet_bl {
    horizontal-align: left;
    vertical-align: bottom;
    margin: 0px 0px 10px 10px;
}
.bc_rivet_br {
    horizontal-align: right;
    vertical-align: bottom;
    margin: 0px 10px 10px 0px;
}
.bc_picked {
    width: 180px;
    height: 44px;
    horizontal-align: center;
    vertical-align: center;
    margin-top: 150px;
    border: 3px solid #e8c15aff;
    transform: rotateZ(-12deg) scale3d(1.6, 1.6, 1);
    opacity: 0;
    z-index: 10;
    transition-property: transform, opacity;
    transition-duration: 0.25s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.bc_picked_text {
    horizontal-align: center;
    vertical-align: center;
    font-size: 20px;
    font-weight: bold;
    color: rgb(232, 193, 90);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 6px;
}
.buff_card.Picked .bc_picked {
    transform: rotateZ(-12deg) scale3d(1, 1, 1);
    opacity: 0.9;
}
.bc_icon {
    width: 64px;
    height: 64px;
    horizontal-align: center;
    vertical-align: center;
}
.bc_team_ct .bc_icon {
    wash-color: #ffe08cff;
}
.bc_team_t .bc_icon {
    wash-color: #bef08cff;
}
.bc_stat {
    width: 280px;
    margin-top: 16px;
    text-align: center;
    font-size: 26px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 1px;
    text-shadow: 0px 3px 6px #000000ff;
}
.bc_team_ct .bc_stat {
    color: rgb(255, 214, 110);
}
.bc_team_t .bc_stat {
    color: rgb(170, 240, 110);
}
.bc_desc_cn {
    width: 228px;
    horizontal-align: center;
    margin-top: 6px;
    text-align: center;
    font-size: 14px;
    color: rgb(140, 132, 116);
    font-family: 'Arial Unicode MS', Stratum2;
    text-shadow: 0px 2px 4px #000000ff;
}
.knife_frenzy_banner {
    width: 580px;
    height: 64px;
    horizontal-align: center;
    vertical-align: top;
    margin-top: 170px;
    background-color: gradient(linear, 0% 0%, 0% 100%, from(#1e0606f0), to(#0c0202f0));
    border: 2px solid #e04040ff;
    box-shadow: 0px 0px 30px 0px #e0404088;
    z-index: 150;
    opacity: 0;
    transform: translate3d(0px, -30px, 0px) scale3d(1.2, 1.2, 1);
    transition-property: opacity, transform;
    transition-duration: 0.25s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.knife_frenzy_banner.Visible {
    opacity: 1;
    transform: translate3d(0px, 0px, 0px) scale3d(1, 1, 1);
}
.kf_fill {
    width: 100%;
    height: 100%;
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#7a1010f0), to(#e04040f0));
    transform-origin: 0% 50%;
    transform: scale3d(1, 1, 1);
}
.knife_frenzy_banner.Run .kf_fill {
    animation-name: kfDrain;
    animation-duration: 12s;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
}
@keyframes 'kfDrain' {
    0% {
        transform: scale3d(1, 1, 1);
    }
100% {
        transform: scale3d(0, 1, 1);
    }
}
.kf_row {
    width: fit-children;
    height: 100%;
    horizontal-align: center;
    flow-children: right;
}
.kf_icon {
    width: 40px;
    height: 40px;
    vertical-align: center;
    wash-color: #ffd0d0ff;
}
.kf_text {
    vertical-align: center;
    margin-left: 14px;
    font-size: 26px;
    font-weight: bold;
    color: rgb(255, 225, 225);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 4px;
    text-shadow: 0px 3px 6px #000000ff;
}
