let WORM_PART_DISTANCE = 128;
let NAV_POINT_LIST = [];

class NAV_POINT_WORM
{
    origin;
    parents;

    constructor(origin)
    {
        this.origin = origin;
        this.parents = [];
    }
    SetParent(id)
    {
        this.parents.push(id)
    }
}

