    z-index: 60;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.hint_container.Visible {
    opacity: 1;
}
.hint_text {
    width: 100%;
    text-align: center;
    font-size: 14px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 2px;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 1), 0px 0px 8px rgba(0, 0, 0, 0.9);
}
