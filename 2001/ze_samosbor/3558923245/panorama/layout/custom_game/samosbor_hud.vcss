.radar_legend {
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 130px;
    flow-children: right;
    width: fit-children;
    height: fit-children;
    z-index: 20;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.radar_container.Visible .radar_legend {
    opacity: 1;
}
.radar_legend_square {
    width: 12px;
    height: 12px;
    background-color: white;
    border: 1px solid white;
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
    margin-right: 6px;
    vertical-align: center;
}
.radar_legend_text {
    color: white;
    font-size: 14px;
    font-family: Stratum2, 'Arial Unicode MS';
    text-transform: uppercase;
    letter-spacing: 1px;
    vertical-align: center;
    text-shadow: 0 0 4px black;
}
.radar_axis_x {
    horizontal-align: center;
    vertical-align: top;
    margin-top: -20px;
    width: 750px;
    height: 20px;
    flow-children: right;
    z-index: 30;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.radar_container.Visible .radar_axis_x {
    opacity: 1;
}
.radar_axis_y {
    horizontal-align: left;
    vertical-align: top;
    margin-left: -20px;
    margin-top: -20px;
    width: 20px;
    height: 750px;
    flow-children: down;
    z-index: 30;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.radar_container.Visible .radar_axis_y {
    opacity: 1;
}
.radar_axis_label {
    width: 50px;
    height: 20px;
    text-align: center;
    vertical-align: center;
    font-size: 11px;
    font-family: Stratum2, 'Arial Unicode MS';
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 0 4px black;
    line-height: 20px;
}
.radar_axis_y .radar_axis_label {
    width: 20px;
    height: 50px;
    line-height: 50px;
    text-align: center;
    vertical-align: center;
}
.use_progress_container {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    flow-children: none;
    overflow: noclip;
    z-index: 160;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.use_progress_container.Visible {
    opacity: 1;
}
.use_progress_circle {
    width: 90px;
    height: 90px;
    horizontal-align: center;
    vertical-align: center;
    flow-children: none;
}
.use_progress_bg {
    width: 90px;
    height: 90px;
    horizontal-align: center;
    vertical-align: center;
    border: 8px solid #ffffff07;
    border-radius: 50%;
}
.use_progress_fill {
    width: 90px;
    height: 90px;
    horizontal-align: center;
    vertical-align: center;
    border: 8px solid #ffffffff;
    border-radius: 50%;
    clip: radial(50% 50%, 0deg, 0deg);
}
.use_progress_fill.Active.Dur7 {
    animation-name: useProgressFill;
    animation-duration: 7.0s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
}
.use_progress_fill.Active.Dur4 {
    animation-name: useProgressFill;
    animation-duration: 4.0s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
}
.use_progress_fill.Active.Dur2 {
    animation-name: useProgressFill;
    animation-duration: 2.0s;
    animation-timing-function: linear;
    animation-iteration-count: 1;
}
@keyframes 'useProgressFill' {
    0% {
        clip: radial(50% 50%, 0deg, 0deg);
    }
100% {
        clip: radial(50% 50%, 0deg, 360deg);
    }
}
.big_menu_body {
    width: 1280px;
    height: 792px;
    flow-children: none;
}
.tab_page {
    width: 1280px;
    height: 792px;
    flow-children: none;
    visibility: collapse;
    overflow: noclip;
}
.tab_page.Active {
    visibility: visible;
}
.col_header {
    text-align: left;
    font-size: 13px;
    font-weight: bold;
    color: rgb(120, 112, 118);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 5px;
    margin-bottom: 12px;
    margin-left: 4px;
}
.items_wrap {
    width: 1280px;
    height: 792px;
    flow-children: right;
}
.items_list {
    width: 330px;
    height: 792px;
    flow-children: down;
    padding: 18px;
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#0b0709ff), to(#000000ff));
    border-right: 1px solid #241d21ff;
}
.item_tab {
    width: 294px;
    height: 58px;
    margin-bottom: 6px;
    flow-children: none;
    background-color: #050405ff;
    border: 1px solid #241d21ff;
    border-radius: 2px;
    transition-property: background-color, border-color, transform;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.item_tab:hover {
    background-color: #130d10ff;
    border-color: #6a5058ff;
    transform: translate3d(5px, 0px, 0px);
    sound: 'UIPanorama.sidemenu_rollover';
}
.item_tab.Active {
    background-color: gradient(linear, 0% 0%, 100% 0%, from(#2a1620ff), to(#080507ff));
    border-color: #d0708fff;
    transform: translate3d(8px, 0px, 0px);
}
.item_tab_accent {
    width: 3px;
    height: 58px;
    horizontal-align: left;
    vertical-align: center;
}
.item_tab_icon {
    width: 38px;
    height: 38px;
    horizontal-align: left;
    vertical-align: center;
    margin-left: 16px;
}
.item_tab_name {
    horizontal-align: left;
    vertical-align: center;
    margin-left: 66px;
    font-size: 17px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 1px;
}
.items_detail {
    width: 950px;
    height: 792px;
    flow-children: none;
}
.item_page {
    width: 950px;
    height: 792px;
    flow-children: down;
    padding: 26px;
    visibility: collapse;
}
.item_page.Active {
    visibility: visible;
}
.item_head {
    width: 898px;
    height: 56px;
    flow-children: none;
    border-bottom: 1px solid #2a2226ff;
    margin-bottom: 18px;
}
.item_head_icon {
    width: 40px;
    height: 40px;
    horizontal-align: left;
    vertical-align: center;
}
.item_title {
    horizontal-align: left;
    vertical-align: center;
    margin-left: 56px;
    font-size: 30px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 4px;
}
.item_video_box {
    width: 898px;
    height: 290px;
    background-color: #000000ff;
    border: 1px solid #2e262aff;
    border-radius: 2px;
    flow-children: none;
    margin-bottom: 18px;
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.7);
}
.item_video {
    width: 896px;
    height: 288px;
    horizontal-align: center;
    vertical-align: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.item_vid_beer {
    background-image: url("file://{resources}/videos/gobutton.webm");
