                        </Panel>
                    </Panel>
                </Panel>
            </Panel>
            <Panel class="bottom_container">
                <Label id="voting_time_label" class="voting_time_label" text="VOTING TIME: {s:time_left}" />
                <Label id="current_mode_label" class="current_mode_label" text="{s:mode_status}" />
            </Panel>
