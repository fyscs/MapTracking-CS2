                <Panel id="buttons_row_container" class="buttons_row_container">
                    <Panel id="wrapper_left" class="button_wrapper">
                        <Button id="btn_left" class="big_button side_button">
                            <Label id="vote_percent_left" class="vote_percent_label" text="{s:percent}" />
                            <Label id="mode_label_left" class="mode_label_inside" text="{s:mode_name}" />
                        </Button>
                        <Label id="button_caption_left" class="button_caption" text="{s:mode_name}" />
                        <Panel class="info_panel">
                            <Label id="info_text_left" class="info_panel_text" text="{s:mode_desc}" />
                        </Panel>
                    </Panel>
                    <Panel id="wrapper_center" class="button_wrapper">
                        <Button id="btn_center" class="big_button center_button">
                            <Label id="vote_percent_center" class="vote_percent_label" text="{s:percent}" />
                            <Label id="mode_label_center" class="mode_label_inside" text="{s:mode_name}" />
