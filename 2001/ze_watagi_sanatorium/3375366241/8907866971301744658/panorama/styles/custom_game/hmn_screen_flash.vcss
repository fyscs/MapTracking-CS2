.Root {
    width: 100%;
    height: 100%;
}
#screen_flash_container {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
}
.ScreenFlashImage {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    opacity: 0.0;
    visibility: collapse;
    transition-property: opacity;
    transition-duration: 1.0s;
    transition-timing-function: ease-out;
}
.ScreenFlashImage.Visible {
    opacity: 1.0;
    visibility: visible;
}
.ScreenFlashImage.Hidden {
    opacity: 0.0;
}
.ScreenFlashOverlay {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    background-color: #00000000;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.30s;
    transition-timing-function: ease-out;
}
.ScreenFlashOverlay.Hidden {
    opacity: 0.0;
}
.ScreenFlashOverlay.FlashRed {
    background-color: #FF0000FF;
}
.ScreenFlashOverlay.FlashWhite {
    background-color: #FFFFFFFF;
}
.ScreenFlashOverlay.FlashBlack {
    background-color: #000000FF;
}
