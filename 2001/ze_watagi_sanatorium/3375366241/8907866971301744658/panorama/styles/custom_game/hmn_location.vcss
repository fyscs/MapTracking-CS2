    height: 100%;
}
.LocationContainer {
    width: 100%;
    height: 100%;
    horizontal-align: center;
    vertical-align: center;
    opacity: 1.0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-out;
}
.LocationContainer.Hidden {
    opacity: 0.0;
}
.LocationContent {
    width: 1100px;
