    color: #FFFFFFFF;
    letter-spacing: 1px;
    opacity: 1.0;
    transform: scale3d(1.0, 1.0, 1.0);
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    text-shadow: 0px 0px 2px #000000FF, 0px 0px 5px #000000FF;
    white-space: nowrap;
}
.LocationText.DialogueHidden {
    opacity: 0.0;
    transform: scale3d(0.96, 0.96, 1.0);
}
.LocationLine {
    width: 650px;
    height: 2px;
    horizontal-align: center;
    margin-top: 10px;
    margin-bottom: 6px;
    background-color: #FFFFFFFF;
    opacity: 1.0;
    transform: scaleX(1.0);
    transition-property: opacity, transform;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
.LocationLine.DialogueHidden {
    opacity: 0.0;
    transform: scaleX(0.0);
}
.LocationTitle {
    width: 100%;
    height: 32px;
    horizontal-align: center;
