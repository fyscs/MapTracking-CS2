    text-shadow: 0px 0px 3px #000000FF, 0px 0px 8px #000000FF;
    transition-property: opacity, transform;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    white-space: nowrap;
}
.LocationTitle.DialogueHidden {
    opacity: 0.0;
