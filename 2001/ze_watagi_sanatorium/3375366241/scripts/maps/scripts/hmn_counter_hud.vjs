// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";


/* =========================================================
   Counter HUD
   ========================================================= */

// HUDを管理するEntity名
const HUD_NAME = "hmn_counter_hud";


/* =========================================================
   カウンター設定
   ========================================================= */

const COUNTER_CONFIG = {

    // カウンター01
    counter01: {
        title: "ANOMALY",
        initialValue: 0,
        maxValue: 16,
        minValue: 0,
        displayDigits: 2
    },

    // カウンター02
    counter02: {
        title: "ITEM",
        initialValue: 0,
        maxValue: 10,
        minValue: 0,
        displayDigits: 2
    },

    // カウンター03
    counter03: {
        title: "KEY",
        initialValue: 0,
        maxValue: 99,
        minValue: 0,
        displayDigits: 2
    },

    // カウンター04
    counter04: {
        title: "POINT",
        initialValue: 0,
        maxValue: 999,
        minValue: 0,
        displayDigits: 3
    },

    // カウンター05
    counter05: {
        title: "CUSTOM",
        initialValue: 0,
        maxValue: 9999,
        minValue: 0,
        displayDigits: 4
    }

};


/* =========================================================
   カウンター数値管理
   ========================================================= */

// 設定から初期値を自動生成
let counterValues = {};

for (const counterId in COUNTER_CONFIG) {

    counterValues[counterId] =
        COUNTER_CONFIG[counterId].initialValue;

}

// HUD Entity
let counterHud = null;


/* =========================================================
   HUD取得
   ========================================================= */

function GetCounterHud() {

    if (counterHud && counterHud.IsValid()) {
        return counterHud;
    }

    const entities = Instance.FindEntitiesByName(HUD_NAME);

    if (entities.length > 0) {
        counterHud = entities[0];
    }

    return counterHud;
}


/* =========================================================
   プレイヤー処理
   ========================================================= */

function ForEachPlayer(callback) {

    for (let playerSlot = 0; playerSlot < 64; playerSlot++) {

        const player = Instance.GetPlayerController(playerSlot);

        if (!player) {
            continue;
        }

        callback(playerSlot);
    }

}


/* =========================================================
   数値フォーマット
   ========================================================= */

function FormatCounterValue(counterId) {

    const config = COUNTER_CONFIG[counterId];
    const currentValue = counterValues[counterId];

    if (!config || currentValue === undefined) {
        return "0 / 0";
    }

    // 現在値はゼロ埋めしない
    const current = String(currentValue);

    // 最大値のみ表示桁数を維持
    const digits = Math.max(
        config.displayDigits,
        String(config.maxValue).length
    );

    const maximum = String(
        config.maxValue
    ).padStart(digits, "0");

    return `${current} / ${maximum}`;

}


/* =========================================================
   HUD更新
   ========================================================= */

function UpdateCounterHUD(counterId) {

    const hud = GetCounterHud();
    const config = COUNTER_CONFIG[counterId];

    if (!hud || !config) {
        return;
    }

    const displayText = FormatCounterValue(counterId);

    ForEachPlayer((playerSlot) => {

        // タイトル更新
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            `${counterId}_title`,
            `${counterId}_title`,
            config.title
        );

        // 数値更新
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            `${counterId}_value`,
            `${counterId}_value`,
            displayText
        );

    });

}


/* =========================================================
   数値管理
   ========================================================= */

// 加算
function AddCounter(counterId, amount = 1) {

    const config = COUNTER_CONFIG[counterId];

    if (!config) {
        return;
    }

    counterValues[counterId] = Math.min(
        counterValues[counterId] + amount,
        config.maxValue
    );

    UpdateCounterHUD(counterId);

}


// 減算
function SubtractCounter(counterId, amount = 1) {

    const config = COUNTER_CONFIG[counterId];

    if (!config) {
        return;
    }

    counterValues[counterId] = Math.max(
        counterValues[counterId] - amount,
        config.minValue
    );

    UpdateCounterHUD(counterId);

}


// 初期化
function ResetCounter(counterId) {

    const config = COUNTER_CONFIG[counterId];

    if (!config) {
        return;
    }

    counterValues[counterId] = config.initialValue;

    UpdateCounterHUD(counterId);

}


/* =========================================================
   HUD一括非表示
   ========================================================= */

function HideCounterHUD() {

    const hud = GetCounterHud();

    if (!hud) {
        return;
    }

    ForEachPlayer((playerSlot) => {

        hud.SetHasClassForPlayer(
            playerSlot,
            "counter_container",
            "Visible",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "counter_container",
            "Hidden",
            true
        );

    });

}


/* =========================================================
   個別カウンター表示制御
   ========================================================= */

function SetCounterVisibility(counterId, visible) {

    const hud = GetCounterHud();

    if (!hud || !COUNTER_CONFIG[counterId]) {
        return;
    }

    const panelName = `${counterId}_container`;


    // 表示する場合は、先にタイトルと数値を更新
    if (visible) {
        UpdateCounterHUD(counterId);
    }


    ForEachPlayer((playerSlot) => {

        // 個別表示時は親HUDも表示状態にする
        if (visible) {

            hud.SetHasClassForPlayer(
                playerSlot,
                "counter_container",
                "Visible",
                true
            );

            hud.SetHasClassForPlayer(
                playerSlot,
                "counter_container",
                "Hidden",
                false
            );

        }

        // 個別カウンターの表示・非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            panelName,
            "CounterHidden",
            !visible
        );

    });

}


/* =========================================================
   Hammer入力：個別カウンター表示制御
   ========================================================= */

function RegisterCounterVisibilityInputs(counterId) {

    const counterNumber = counterId.replace("counter", "");


    // 個別表示
    Instance.OnScriptInput(
        `ShowCounter${counterNumber}`,
        () => {
            SetCounterVisibility(counterId, true);
        }
    );


    // 個別非表示
    Instance.OnScriptInput(
        `HideCounter${counterNumber}`,
        () => {
            SetCounterVisibility(counterId, false);
        }
    );

}


/* =========================================================
   Hammer入力：カウンター登録
   ========================================================= */

function RegisterCounterInputs(counterId) {

    // counter01 → 01
    const counterNumber = counterId.replace("counter", "");

    // 加算・減算する数値
    const amounts = [1, 5, 10, 50, 100, 500, 1000];


    // 加算入力
    for (const amount of amounts) {

        const suffix = amount === 1 ? "" : `_${amount}`;

        Instance.OnScriptInput(
            `AddCounter${counterNumber}${suffix}`,
            () => {
                AddCounter(counterId, amount);
            }
        );

    }


    // 減算入力
    for (const amount of amounts) {

        const suffix = amount === 1 ? "" : `_${amount}`;

        Instance.OnScriptInput(
            `SubtractCounter${counterNumber}${suffix}`,
            () => {
                SubtractCounter(counterId, amount);
            }
        );

    }


    // リセット入力
    Instance.OnScriptInput(
        `ResetCounter${counterNumber}`,
        () => {
            ResetCounter(counterId);
        }
    );

}


/* =========================================================
   全カウンターのHammer入力登録
   ========================================================= */

for (const counterId in COUNTER_CONFIG) {

    // 加算・減算・リセット
    RegisterCounterInputs(counterId);

    // 個別表示・非表示
    RegisterCounterVisibilityInputs(counterId);

}


/* =========================================================
   Hammer入力：HUD一括非表示
   ========================================================= */

Instance.OnScriptInput("HideCounterHUD", () => {
    HideCounterHUD();
});