// ==================================================
// フェード設定
// ==================================================

// 個別設定がない場合の標準フェード時間
const DEFAULT_FADE_IN = 0.4;
const DEFAULT_FADE_OUT = 0.5;

// フェード時間の最小・最大値
const MIN_FADE_DURATION = 0.0;
const MAX_FADE_DURATION = 2.0;

// タイトルを先行表示する時間
const TITLE_LEAD_TIME = 0.2;


// ==================================================
// Custom HUD
// ==================================================

const HUD_NAME = "hmn_lyrics_hud";

let lyricsHud = null;

// 再生セッション管理
let lyricsSession = 0;

// 現在の表示言語
let lyricsLanguage = "Japanese";

// 現在表示中の歌詞番号
let currentLyricsIndex = -1;

// 現在の歌詞のフェードアウト開始状態
let fadeOutStarted = false;


// ==================================================
// HUD取得
// ==================================================

function GetLyricsHud() {

    if (lyricsHud && lyricsHud.IsValid()) {
        return lyricsHud;
    }

    const entities = Entities.FindByName(HUD_NAME);

    if (entities.length > 0) {
        lyricsHud = entities[0];
    }

    return lyricsHud;
}


// ==================================================
// 全プレイヤー取得
// ==================================================

function GetPlayers() {
    return Instance.GetAllPlayerControllers();
}


// ==================================================
// フェード時間取得
// ==================================================

function GetFadeDuration(value, defaultValue) {

    let duration = Number(value);

    if (!Number.isFinite(duration)) {
        duration = defaultValue;
    }

    duration = Math.max(
        MIN_FADE_DURATION,
        Math.min(MAX_FADE_DURATION, duration)
    );

    // 0.1秒単位に丸める
    return Math.round(duration * 10) / 10;
}


// ==================================================
// フェード用クラス名取得
// ==================================================

function GetFadeDurationClass(duration) {

    const value = GetFadeDuration(
        duration,
        DEFAULT_FADE_IN
    );

    const index = Math.round(value * 10);

    return "FadeDuration" + index;
}


// ==================================================
// 言語別テキスト取得
// ==================================================

function GetCurrentLyricsText(lyric) {

    if (lyricsLanguage === "English") {
        return lyric.english || lyric.japanese || "";
    }

    return lyric.japanese || lyric.english || "";
}


// ==================================================
// 歌詞のフェードイン時間取得
// ==================================================

function GetLyricFadeIn(lyric) {

    return GetFadeDuration(
        lyric.fadeIn,
        DEFAULT_FADE_IN
    );
}


// ==================================================
// 歌詞のフェードアウト時間取得
// ==================================================

function GetLyricFadeOut(lyric) {

    return GetFadeDuration(
        lyric.fadeOut,
        DEFAULT_FADE_OUT
    );
}


// ==================================================
// プレイヤーのフェードクラス設定
// ==================================================

function SetLyricsFadeClass(
    playerSlot,
    fadeClass,
    enabled
) {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics",
        fadeClass,
        enabled
    );
}


// ==================================================
// タイトル専用フェードクラス
// ==================================================

function SetSongTitleFadeClass(
    playerSlot,
    fadeClass,
    enabled
) {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    hud.SetHasClassForPlayer(
        playerSlot,
        "song_title",
        fadeClass,
        enabled
    );
}


// ==================================================
// 全プレイヤーのタイトルをフェード前状態にする
// ==================================================

function PrepareSongTitleFadeForAllPlayers() {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        SetSongTitleFadeClass(
            playerSlot,
            "FadeIn",
            false
        );

        SetSongTitleFadeClass(
            playerSlot,
            "FadeOut",
            true
        );
    }
}


// ==================================================
// 全プレイヤーのタイトルをフェードイン
// ==================================================

function FadeInSongTitleForAllPlayers() {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        SetSongTitleFadeClass(
            playerSlot,
            "FadeOut",
            false
        );

        SetSongTitleFadeClass(
            playerSlot,
            "FadeIn",
            true
        );
    }
}


// ==================================================
// フェード時間クラス変更
// ==================================================

function SetLyricsFadeDuration(playerSlot, duration) {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    // 古い時間クラスを削除
    for (let i = 0; i <= 20; i++) {

        hud.SetHasClassForPlayer(
            playerSlot,
            "lyrics",
            "FadeDuration" + i,
            false
        );
    }

    // 新しい時間クラスを設定
    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics",
        GetFadeDurationClass(duration),
        true
    );
}


// ==================================================
// 1人のプレイヤーに歌詞を表示
// ==================================================

function SetLyricsForPlayer(
    playerSlot,
    text,
    lyric
) {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    // HUD表示
    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics_container",
        "Hidden",
        false
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics_container",
        "Visible",
        true
    );

    // 曲名
    const songTitle =
        lyricsLanguage === "English"
            ? SONG_CONFIG.titleEnglish
            : SONG_CONFIG.titleJapanese;

    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "song_title",
        "song_title",
        songTitle
    );

    // 歌詞
    hud.SetDialogVariableStringForPlayer(
        playerSlot,
        "lyrics",
        "lyrics",
        text
    );

    // フェードイン時間
    SetLyricsFadeDuration(
        playerSlot,
        GetLyricFadeIn(lyric)
    );

    // いったん透明状態にする
    SetLyricsFadeClass(
        playerSlot,
        "FadeIn",
        false
    );

    SetLyricsFadeClass(
        playerSlot,
        "FadeOut",
        true
    );
}


// ==================================================
// 全プレイヤーに歌詞を表示
// ==================================================

function SetLyricsForAllPlayers(text, lyric) {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        SetLyricsForPlayer(
            playerSlot,
            text,
            lyric
        );
    }
}


// ==================================================
// 全プレイヤーのフェードイン
// ==================================================

function FadeInLyricsForAllPlayers() {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        SetLyricsFadeClass(
            playerSlot,
            "FadeOut",
            false
        );

        SetLyricsFadeClass(
            playerSlot,
            "FadeIn",
            true
        );
    }
}


// ==================================================
// 全プレイヤーのフェードアウト
// ==================================================

function FadeOutLyricsForAllPlayers(lyric) {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        // フェードアウト時間を設定
        SetLyricsFadeDuration(
            playerSlot,
            GetLyricFadeOut(lyric)
        );

        SetLyricsFadeClass(
            playerSlot,
            "FadeIn",
            false
        );

        SetLyricsFadeClass(
            playerSlot,
            "FadeOut",
            true
        );
    }
}


// ==================================================
// 1人のHUDを非表示
// ==================================================

function HideLyricsForPlayer(playerSlot) {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics_container",
        "Visible",
        false
    );

    hud.SetHasClassForPlayer(
        playerSlot,
        "lyrics_container",
        "Hidden",
        true
    );

    // フェード状態を初期化
    SetLyricsFadeClass(
        playerSlot,
        "FadeIn",
        false
    );

    SetLyricsFadeClass(
        playerSlot,
        "FadeOut",
        true
    );
}


// ==================================================
// 全プレイヤーのHUDを非表示
// ==================================================

function HideLyricsForAllPlayers() {

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        HideLyricsForPlayer(playerSlot);
    }
}


// ==================================================
// 全プレイヤーのHUDをリセット
// ==================================================

function ResetLyricsForAllPlayers() {

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    const players = GetPlayers();

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        // 非表示
        hud.SetHasClassForPlayer(
            playerSlot,
            "lyrics_container",
            "Visible",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "lyrics_container",
            "Hidden",
            true
        );

        // 歌詞のフェード状態を初期化
        hud.SetHasClassForPlayer(
            playerSlot,
            "lyrics",
            "FadeIn",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "lyrics",
            "FadeOut",
            true
        );

        // 歌詞クリア
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "lyrics",
            "lyrics",
            ""
        );

        // タイトルのフェード状態を初期化
        hud.SetHasClassForPlayer(
            playerSlot,
            "song_title",
            "FadeIn",
            false
        );

        hud.SetHasClassForPlayer(
            playerSlot,
            "song_title",
            "FadeOut",
            true
        );

        // 曲名クリア
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "song_title",
            "song_title",
            ""
        );
    }
}


// ==================================================
// 現在の言語設定で歌詞を再表示
// ==================================================

function RefreshCurrentLyrics() {

    if (currentLyricsIndex < 0) {
        return;
    }

    const lyric = SONG_CONFIG.lyrics[currentLyricsIndex];

    if (!lyric) {
        return;
    }

    const hud = GetLyricsHud();

    if (!hud) {
        return;
    }

    const players = GetPlayers();

    const text = GetCurrentLyricsText(lyric);

    const songTitle =
        lyricsLanguage === "English"
            ? SONG_CONFIG.titleEnglish
            : SONG_CONFIG.titleJapanese;

    for (const controller of players) {

        if (!controller) {
            continue;
        }

        const playerSlot = controller.GetPlayerSlot();

        // 曲名
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "song_title",
            "song_title",
            songTitle
        );

        // 歌詞
        hud.SetDialogVariableStringForPlayer(
            playerSlot,
            "lyrics",
            "lyrics",
            text
        );
    }
}


// ==================================================
// 歌詞再生
// ==================================================

async function StartLyrics() {

    // 新しい再生セッション
    lyricsSession++;

    const mySession = lyricsSession;

    // 表示番号リセット
    currentLyricsIndex = -1;

    // フェードアウト状態リセット
    fadeOutStarted = false;

    // 再生開始時刻
    const startTime = Date.now();

    // タイトルをフェード前の状態にする
    PrepareSongTitleFadeForAllPlayers();

    // タイトルのフェード開始管理
    let titleFadeStarted = false;

    // 歌詞データ
    const lyrics = SONG_CONFIG.lyrics;

    // 再生時間管理
    while (mySession === lyricsSession) {

        // 楽曲開始からの経過秒数
        const elapsed = (Date.now() - startTime) / 1000;

        // 現在表示する歌詞を検索
        let targetIndex = -1;

        for (let i = 0; i < lyrics.length; i++) {

            const lyric = lyrics[i];

            if (
                elapsed >= lyric.start &&
                elapsed < lyric.end
            ) {
                targetIndex = i;
                break;
            }
        }

        // 歌詞が切り替わった場合
        if (targetIndex !== currentLyricsIndex) {

            currentLyricsIndex = targetIndex;

            // 新しい歌詞のフェードアウト状態を解除
            fadeOutStarted = false;

            if (targetIndex >= 0) {

                const lyric = lyrics[targetIndex];

                // 歌詞を一括表示
                SetLyricsForAllPlayers(
                    GetCurrentLyricsText(lyric),
                    lyric
                );

                // 画面上で透明状態を反映させるため少し待つ
                await Instance.Delay(0.03);

                // 待機中にリセット・再スタートされていないか確認
                if (
                    mySession !== lyricsSession ||
                    currentLyricsIndex !== targetIndex
                ) {
                    return;
                }

                // タイトルは曲の再生中に一度だけフェードイン
                if (!titleFadeStarted) {

                    titleFadeStarted = true;

                    // 先にタイトルをフェードイン
                    FadeInSongTitleForAllPlayers();

                    // タイトルを少し先行させる
                    await Instance.Delay(TITLE_LEAD_TIME);

                    // 待機中にリセット・再スタートされていないか確認
                    if (
                        mySession !== lyricsSession ||
                        currentLyricsIndex !== targetIndex
                    ) {
                        return;
                    }
                }

                // 歌詞のフェードイン開始
                FadeInLyricsForAllPlayers();

            } else {

                // 歌詞がない時間帯
                HideLyricsForAllPlayers();
            }
        }

        // 現在の歌詞がある場合
        if (targetIndex >= 0) {

            const lyric = lyrics[targetIndex];

            const fadeOutDuration = Math.min(
                GetLyricFadeOut(lyric),
                lyric.end - lyric.start
            );

            // 終了時刻より前にフェードアウトを開始
            if (
                !fadeOutStarted &&
                fadeOutDuration > 0 &&
                elapsed >= lyric.end - fadeOutDuration
            ) {

                fadeOutStarted = true;

                FadeOutLyricsForAllPlayers(lyric);
            }
        }

        // 全歌詞終了
        if (elapsed >= lyrics[lyrics.length - 1].end) {
            break;
        }

        // 約30ms間隔で時間確認
        await Instance.Delay(0.03);
    }

    // 別セッションに切り替わっていたら終了
    if (mySession !== lyricsSession) {
        return;
    }

    // 再生終了
    currentLyricsIndex = -1;
    fadeOutStarted = false;

    HideLyricsForAllPlayers();
}


// ==================================================
// Hammer → RunScriptInput
// ==================================================

// 歌詞再生開始
Instance.OnScriptInput("StartLyrics", (inputData) => {

    StartLyrics();
});


// 日本語に切り替え
Instance.OnScriptInput("EnableJapanese", (inputData) => {

    lyricsLanguage = "Japanese";

    RefreshCurrentLyrics();
});


// 英語に切り替え
Instance.OnScriptInput("EnableEnglish", (inputData) => {

    lyricsLanguage = "English";

    RefreshCurrentLyrics();
});


// ==================================================
// 再生停止・リセット
// ==================================================

Instance.OnScriptInput("ResetLyrics", (inputData) => {

    // 再生セッション無効化
    lyricsSession++;

    // 表示番号リセット
    currentLyricsIndex = -1;

    // フェードアウト状態リセット
    fadeOutStarted = false;

    // 全HUDリセット
    ResetLyricsForAllPlayers();
});