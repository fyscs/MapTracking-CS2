.Root {
    width: 100%;
    height: 100%;
}
#lyrics_container {
    width: 100%;
    height: 140px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 100px;
    flow-children: down;
}
#lyrics_container.Hidden {
    visibility: collapse;
}
#lyrics_container.Visible {
    visibility: visible;
}
.SongTitle {
    horizontal-align: center;
    font-size: 20px;
    color: #61f538;
    text-shadow: 0px 2px 4px #000000;
}
.Lyrics {
    horizontal-align: center;
    margin-top: 8px;
    font-size: 36px;
    font-weight: bold;
    color: white;
    text-align: center;
    text-shadow: 0px 2px 4px #000000, 0px 0px 8px #000000;
}
