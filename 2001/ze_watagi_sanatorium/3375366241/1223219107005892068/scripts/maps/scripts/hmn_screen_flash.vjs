import { Instance, Entities } from "cs_script/point_script";

// ============================================================
// HUD設定
// ============================================================

const HUD_NAME = "hmn_screen_flash_hud";

// ============================================================
// 画像設定
// ============================================================

const SCREEN_FLASH_IMAGES = {
    ScreenFlash01: "screen_flash_image_01",
    ScreenFlash02: "screen_flash_image_02",
};

// ============================================================
// 自動演出設定
// ============================================================

const SCREEN_FLASH_EFFECTS = {

    ScreenFlash01: {
        image: "ScreenFlash01",
        flashClass: "FlashRed",

        // フラッシュの表示時間
        flashDuration: 0.30,

        // 画像の表示時間
        displayDuration: 1.5,

        // 画像のフェードアウト時間
        fadeDuration: 1.0,
    },

    ScreenFlash02: {
        image: "ScreenFlash02",
        flashClass: "FlashWhite",

        // フラッシュの表示時間
        flashDuration: 0.25,

        // 画像の表示時間
        displayDuration: 2.5,

        // 画像のフェードアウト時間
        fadeDuration: 1.0,
    },

};

// ============================================================
// HUD管理
// ============================================================

let screenFlashHud = null;

// 現在表示している画像パネル
let currentImagePanel = null;

// 演出の中断管理
let effectToken = 0;

// ============================================================
// HUD取得
// ============================================================

function GetScreenFlashHud() {

    if (screenFlashHud && screenFlashHud.IsValid()) {
        return screenFlashHud;
    }

    const entities = Entities.FindByName(HUD_NAME);

    screenFlashHud = entities.find(
        entity => entity.IsValid()
    );

    return screenFlashHud;
}

// ============================================================
// 演出中断管理
// ============================================================

function StopCurrentEffect() {

    // 識別番号を更新して実行中の演出を中断
    effectToken++;
}

// ============================================================
// 画像表示管理
// ============================================================

// すべての画像を非表示にする
function HideAllImages() {

    const hud = GetScreenFlashHud();

    if (!hud) {
        return;
    }

    for (const panelId of Object.values(SCREEN_FLASH_IMAGES)) {

        hud.SetHasClassForPlayer(
            0,
            panelId,
            "Visible",
            false
        );

        hud.SetHasClassForPlayer(
            0,
            panelId,
            "Hidden",
            false
        );
    }

    currentImagePanel = null;
}

// 指定した画像を表示する
function ShowImage(imageName) {

    const hud = GetScreenFlashHud();

    if (!hud) {
        return;
    }

    const panelId = SCREEN_FLASH_IMAGES[imageName];

    if (!panelId) {
        return;
    }

    // ほかの画像を非表示にする
    HideAllImages();

    // フェードアウト状態を解除
    hud.SetHasClassForPlayer(
        0,
        panelId,
        "Hidden",
        false
    );

    // 画像を表示
    hud.SetHasClassForPlayer(
        0,
        panelId,
        "Visible",
        true
    );

    currentImagePanel = panelId;
}

// 表示中の画像をフェードアウトする
function FadeOutImage() {

    const hud = GetScreenFlashHud();

    if (!hud || !currentImagePanel) {
        return;
    }

    hud.SetHasClassForPlayer(
        0,
        currentImagePanel,
        "Hidden",
        true
    );
}

// ============================================================
// フラッシュ表示管理
// ============================================================

// 指定した色のフラッシュを表示する
function ShowFlash(flashClass) {

    const hud = GetScreenFlashHud();

    if (!hud) {
        return;
    }

    // 既存の色設定をすべて解除
    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        "FlashRed",
        false
    );

    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        "FlashWhite",
        false
    );

    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        "FlashBlack",
        false
    );

    // 新しい色を設定
    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        flashClass,
        true
    );

    // 非表示状態を解除
    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        "Hidden",
        false
    );
}

// フラッシュをフェードアウトする
function HideFlash() {

    const hud = GetScreenFlashHud();

    if (!hud) {
        return;
    }

    // 色設定を維持したまま透明化する
    hud.SetHasClassForPlayer(
        0,
        "screen_flash_overlay",
        "Hidden",
        true
    );
}

// ============================================================
// 自動演出
// ============================================================

async function PlayScreenFlash(effectName) {

    const effect = SCREEN_FLASH_EFFECTS[effectName];

    if (!effect) {
        return;
    }

    const hud = GetScreenFlashHud();

    if (!hud) {
        return;
    }

    // 新しい演出の識別番号を発行
    const myToken = ++effectToken;

    // 前の画像をリセット
    HideAllImages();

    // --------------------------------------------------------
    // 1. フラッシュと画像を表示
    // --------------------------------------------------------

    ShowFlash(effect.flashClass);

    // フラッシュ開始直後に画像を表示
    ShowImage(effect.image);

    // --------------------------------------------------------
    // 2. フラッシュ表示時間
    // --------------------------------------------------------

    await Instance.Delay(effect.flashDuration);

    // 古い演出なら中断
    if (myToken !== effectToken) {
        return;
    }

    // --------------------------------------------------------
    // 3. フラッシュをフェードアウト
    // --------------------------------------------------------

    HideFlash();

    // 画像の表示時間
    await Instance.Delay(effect.displayDuration);

    // 古い演出なら中断
    if (myToken !== effectToken) {
        return;
    }

    // --------------------------------------------------------
    // 4. 画像をフェードアウト
    // --------------------------------------------------------

    FadeOutImage();

    await Instance.Delay(effect.fadeDuration);

    // 古い演出なら中断
    if (myToken !== effectToken) {
        return;
    }

    // --------------------------------------------------------
    // 5. 演出終了後に画像を非表示化
    // --------------------------------------------------------

    hud.SetHasClassForPlayer(
        0,
        currentImagePanel,
        "Visible",
        false
    );

    hud.SetHasClassForPlayer(
        0,
        currentImagePanel,
        "Hidden",
        false
    );

    currentImagePanel = null;
}

// ============================================================
// 外部入力：自動演出
// ============================================================

Instance.OnScriptInput(
    "PlayScreenFlash01",
    () => PlayScreenFlash("ScreenFlash01")
);

Instance.OnScriptInput(
    "PlayScreenFlash02",
    () => PlayScreenFlash("ScreenFlash02")
);

// ============================================================
// 外部入力：画像の個別操作
// ============================================================

// 画像01を表示
Instance.OnScriptInput(
    "ShowScreenFlash01",
    () => {
        StopCurrentEffect();
        ShowImage("ScreenFlash01");
    }
);

// 画像02を表示
Instance.OnScriptInput(
    "ShowScreenFlash02",
    () => {
        StopCurrentEffect();
        ShowImage("ScreenFlash02");
    }
);

// すべての画像を非表示
Instance.OnScriptInput(
    "HideScreenFlash",
    () => {
        StopCurrentEffect();
        HideAllImages();
    }
);

// ============================================================
// 外部入力：フラッシュの個別操作
// ============================================================

// 赤色フラッシュ
Instance.OnScriptInput(
    "ShowRedFlash",
    () => {
        StopCurrentEffect();
        ShowFlash("FlashRed");
    }
);

// 白色フラッシュ
Instance.OnScriptInput(
    "ShowWhiteFlash",
    () => {
        StopCurrentEffect();
        ShowFlash("FlashWhite");
    }
);

// 黒色フラッシュ
Instance.OnScriptInput(
    "ShowBlackFlash",
    () => {
        StopCurrentEffect();
        ShowFlash("FlashBlack");
    }
);

// フラッシュを非表示
Instance.OnScriptInput(
    "HideFlash",
    () => {
        StopCurrentEffect();
        HideFlash();
    }
);