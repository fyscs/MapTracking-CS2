import { Instance, Entities } from "cs_script/point_script";

// ========================================
// アイテムデータ
// ========================================

const ITEM_01 = {
    name: "激痛",
    description1: "初級の玄武術。",
    description2: "怨霊の念を飛ばして足を挫かせる。",
    effect: "EFFECT : 小ダメージ／一定時間鈍足を付与",
    recast: "RECAST : 40.0 s"
};

const ITEM_02 = {
    name: "ITEM NAME 02",
    description1: "Description line 1.",
    description2: "Description line 2.",
    effect: "EFFECT : Example effect.",
    recast: "RECAST : 30.0 s"
};

const ITEM_03 = {
    name: "あああああ",
    description1: "あああああ",
    description2: "あああああ",
    effect: "EFFECT : あああああ",
    recast: "RECAST : あああああ"
};


// ========================================
// HUD設定
// ========================================

const HUD_NAME = "hmn_item_hud";
const ITEM_SOUND_NAME = "item_pip";

const DISPLAY_TIME = 8.0;
const FADE_OUT_TIME = 0.45;

const WINDOW_RESET_DELAY = 0.5;
const INITIAL_SOUND_DELAY = 0.05;

const ANIMATION_RESET_DELAY = 0.05;
const ANIMATION_START_DELAY = 0.5;
const LINE_ANIMATION_DELAY = 0.10;

const DESCRIPTION_1_DELAY = 0.15;
const DESCRIPTION_2_DELAY = 0.15;
const SEPARATOR_DELAY = 0.15;
const EFFECT_DELAY = 0.10;
const RECAST_DELAY = 0.15;


// ========================================
// 実行時データ
// ========================================

let itemHud = null;
const itemSessions = new Map();


// ========================================
// HUDエンティティの取得
// ========================================

function GetItemHud() {
    if (itemHud !== null && itemHud.IsValid()) {
        return itemHud;
    }

    const entities = Entities.FindByName(HUD_NAME);

    if (!entities || entities.length === 0) {
        Instance.Msg("[hmn_item_hud] ERROR: HUD entity not found.");
        return null;
    }

    itemHud = entities[0];
    return itemHud;
}


// ========================================
// アイテム取得音の再生
// ========================================

function PlayItemPip() {
    const sounds = Entities.FindByName(ITEM_SOUND_NAME);
    const sound = sounds[0];

    if (!sound) {
        Instance.Msg("[hmn_item_hud] ERROR: item_pip not found.");
        return;
    }

    sound.FireInput({
        input: "PlaySound"
    });
}


// ========================================
// テキストアニメーションのリセット
// ========================================

function ResetItemTextAnimation(playerSlot) {
    const hud = GetItemHud();
    if (!hud) return;

    // アイテム名
    hud.SetHasClassForPlayer(
        playerSlot, "item_name", "ItemNameVisible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_name", "ItemNameReset", true
    );

    // アイテム名の装飾ライン
    hud.SetHasClassForPlayer(
        playerSlot, "item_name_line", "ItemNameLineVisible", false
    );

    // 説明文 1行目
    hud.SetHasClassForPlayer(
        playerSlot, "item_description_1", "ItemDetailVisible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_1", "ItemDetailReset", true
    );

    // 説明文 2行目
    hud.SetHasClassForPlayer(
        playerSlot, "item_description_2", "ItemDetailVisible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_2", "ItemDetailReset", true
    );

    // 区切り線
    hud.SetHasClassForPlayer(
        playerSlot, "item_separator", "ItemSeparatorVisible", false
    );

    // アイテム効果
    hud.SetHasClassForPlayer(
        playerSlot, "item_effect", "ItemDetailVisible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_effect", "ItemDetailReset", true
    );

    // 再使用時間
    hud.SetHasClassForPlayer(
        playerSlot, "item_recast", "ItemDetailVisible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_recast", "ItemDetailReset", true
    );
}


// ========================================
// HUDのリセット
// ========================================

function ResetItemHUDForPlayer(playerSlot) {
    const hud = GetItemHud();
    if (!hud) return;

    // 現在のセッションを無効化
    itemSessions.delete(playerSlot);

    // HUDウィンドウを非表示にする
    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Visible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Hidden", true
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "ItemFadeOut", false
    );

    // テキストアニメーションをリセット
    ResetItemTextAnimation(playerSlot);
}


// ========================================
// 一定時間後にHUDを非表示にする
// ========================================

async function HideItemAfterDelay(playerSlot, sessionId) {
    await Instance.Delay(DISPLAY_TIME);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    const hud = GetItemHud();
    if (!hud) return;

    // 退場アニメーション
    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "ItemFadeOut", true
    );

    await Instance.Delay(FADE_OUT_TIME);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    // HUDを完全に非表示にする
    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Hidden", true
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Visible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "ItemFadeOut", false
    );

    // 退場後にテキストアニメーションをリセット
    ResetItemTextAnimation(playerSlot);

    itemSessions.delete(playerSlot);
}


// ========================================
// アイテム情報の表示
// ========================================

async function ShowItemForPlayer(playerSlot, item) {
    const hud = GetItemHud();
    if (!hud) return;

    const sessionId = Date.now() + Math.random();
    itemSessions.set(playerSlot, sessionId);

    // HUDウィンドウをリセット
    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Visible", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Hidden", true
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "ItemFadeOut", false
    );

    ResetItemTextAnimation(playerSlot);

    // ウィンドウのリセット完了を待つ
    await Instance.Delay(WINDOW_RESET_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    // アイテム情報を設定
    hud.SetDialogVariableStringForPlayer(
        playerSlot, "item_name", "item_name", item.name
    );

    hud.SetDialogVariableStringForPlayer(
        playerSlot, "item_description_1",
        "item_description_1", item.description1
    );

    hud.SetDialogVariableStringForPlayer(
        playerSlot, "item_description_2",
        "item_description_2", item.description2
    );

    hud.SetDialogVariableStringForPlayer(
        playerSlot, "item_effect", "item_effect", item.effect
    );

    hud.SetDialogVariableStringForPlayer(
        playerSlot, "item_recast", "item_recast", item.recast
    );

    // HUDウィンドウを表示
    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Hidden", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_container", "Visible", true
    );

    // アイテム取得音を再生
    await Instance.Delay(INITIAL_SOUND_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    PlayItemPip();

    // アイテム名アニメーションの準備
    await Instance.Delay(ANIMATION_RESET_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_name", "ItemNameReset", false
    );

    await Instance.Delay(ANIMATION_START_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    // アイテム名を表示
    hud.SetHasClassForPlayer(
        playerSlot, "item_name", "ItemNameVisible", true
    );

    // アイテム名の装飾ラインを表示
    await Instance.Delay(LINE_ANIMATION_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_name_line", "ItemNameLineVisible", true
    );

    // 説明文 1行目を表示
    await Instance.Delay(DESCRIPTION_1_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_1", "ItemDetailReset", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_1", "ItemDetailVisible", true
    );

    // 説明文 2行目を表示
    await Instance.Delay(DESCRIPTION_2_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_2", "ItemDetailReset", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_description_2", "ItemDetailVisible", true
    );

    // 区切り線を表示
    await Instance.Delay(SEPARATOR_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_separator", "ItemSeparatorVisible", true
    );

    // アイテム効果を表示
    await Instance.Delay(EFFECT_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_effect", "ItemDetailReset", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_effect", "ItemDetailVisible", true
    );

    // 再使用時間を表示
    await Instance.Delay(RECAST_DELAY);

    if (itemSessions.get(playerSlot) !== sessionId) return;

    hud.SetHasClassForPlayer(
        playerSlot, "item_recast", "ItemDetailReset", false
    );

    hud.SetHasClassForPlayer(
        playerSlot, "item_recast", "ItemDetailVisible", true
    );

    // 表示時間のカウントを開始
    HideItemAfterDelay(playerSlot, sessionId);
}


// ========================================
// アイテム取得処理
// ========================================

function HandleItemPickup(inputData, item) {
    if (!inputData || !inputData.activator) {
        Instance.Msg("[hmn_item_hud] ERROR: Activator not found.");
        return;
    }

    const controller =
        inputData.activator.GetOriginalPlayerController();

    if (!controller) {
        Instance.Msg("[hmn_item_hud] ERROR: Player controller not found.");
        return;
    }

    const playerSlot = controller.GetPlayerSlot();

    ShowItemForPlayer(playerSlot, item);
}


// ========================================
// スクリプト入力
// ========================================

Instance.OnScriptInput("ShowItem01", (inputData) => {
    HandleItemPickup(inputData, ITEM_01);
});

Instance.OnScriptInput("ShowItem02", (inputData) => {
    HandleItemPickup(inputData, ITEM_02);
});

Instance.OnScriptInput("ShowItem03", (inputData) => {
    HandleItemPickup(inputData, ITEM_03);
});


// ========================================
// 手動リセット用スクリプト入力
// ========================================

Instance.OnScriptInput("ResetItemHUD", (inputData) => {
    if (!inputData || !inputData.activator) {
        Instance.Msg("[hmn_item_hud] Reset requested.");

        // 有効なセッションを持つ全プレイヤーをリセット
        for (const playerSlot of itemSessions.keys()) {
            ResetItemHUDForPlayer(playerSlot);
        }

        return;
    }

    const controller =
        inputData.activator.GetOriginalPlayerController();

    if (!controller) {
        Instance.Msg("[hmn_item_hud] ERROR: Player controller not found.");
        return;
    }

    const playerSlot = controller.GetPlayerSlot();

    ResetItemHUDForPlayer(playerSlot);
});