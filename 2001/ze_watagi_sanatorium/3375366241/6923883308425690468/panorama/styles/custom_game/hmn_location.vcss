.Root {
    width: 100%;
    height: 100%;
}
#location_container {
    width: 100%;
    height: 100%;
}
#location_container.Hidden {
    visibility: collapse;
}
#location_container.Visible {
    visibility: visible;
}
#location_center {
    horizontal-align: center;
    vertical-align: center;
    flow-children: down;
    opacity: 0.0;
    transform: translateY(20px);
    transition-property: opacity, transform;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}
#location_center.LocationFadeIn {
    opacity: 1.0;
    transform: translateY(0px);
}
.LocationTitle {
    horizontal-align: center;
    font-size: 35px;
    color: #828ed1;
    text-align: center;
    opacity: 0.0;
    transform: translateY(5px);
    text-shadow: 0px 0px 1px #000000FF, 0px 0px 2px #000000AA;
    transition-property: opacity, transform, text-shadow;
    transition-duration: 1.0s;
    transition-delay: 0.0s;
    transition-timing-function: ease-in-out;
}
.LocationText {
    horizontal-align: center;
    font-size: 49px;
    color: white;
    text-align: center;
    opacity: 0.0;
    transform: translateY(5px);
    text-shadow: 0px 0px 1px #000000FF, 0px 0px 2px #000000AA;
    transition-property: opacity, transform, text-shadow;
    transition-duration: 1.0s;
    transition-delay: 0.25s;
    transition-timing-function: ease-in-out;
}
#location_center.LocationFadeIn .LocationTitle {
    opacity: 1.0;
    transform: translateY(0px);
    text-shadow: 0px 0px 4px #000000FF, 0px 0px 8px #000000FF;
}
#location_center.LocationFadeIn .LocationText {
    opacity: 1.0;
    transform: translateY(0px);
    text-shadow: 0px 0px 4px #000000FF, 0px 0px 8px #000000FF;
}
