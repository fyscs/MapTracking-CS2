// ==================================================
// Hammer → RunScriptInput
// ==================================================

Instance.OnScriptInput(
    "StartLyrics",
    (inputData) =>
    {
        // 誰が押したかは関係なく、
        // 全プレイヤーで歌詞を開始
        StartLyrics();
    }
);


// ==================================================
// ラウンド開始・リセット
// ==================================================

Instance.OnScriptInput(
    "ResetLyrics",
    (inputData) =>
    {
        // 現在進行中の歌詞再生を無効化
        lyricsSession++;


        // 全プレイヤーのHUDをリセット
        ResetLyricsForAllPlayers();
    }
);