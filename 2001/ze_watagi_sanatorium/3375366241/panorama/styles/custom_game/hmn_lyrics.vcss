.Root {
    width: 100%;
    height: 100%;
}
#lyrics_container {
    width: 100%;
    height: 140px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 100px;
    flow-children: down;
}
#lyrics_container.Hidden {
    visibility: collapse;
}
#lyrics_container.Visible {
    visibility: visible;
}
.SongTitle {
    horizontal-align: center;
    font-size: 20px;
    color: #61f538;
    text-shadow: 0px 2px 4px #000000;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}
.SongTitle.FadeIn {
    opacity: 1;
}
.SongTitle.FadeOut {
    opacity: 0;
}
.LyricsDivider {
    width: 420px;
    height: 1px;
    horizontal-align: center;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: gradient( linear, 0% 0%, 100% 0%, from(rgba(115, 152, 181, 0)), color-stop(0.5, rgba(183, 217, 242, 0.8)), to(rgba(115, 152, 181, 0)) );
}
.Lyrics {
    horizontal-align: center;
    margin-top: 8px;
    font-size: 36px;
    font-weight: bold;
    color: white;
    text-align: center;
    text-shadow: 0px 2px 4px #000000, 0px 0px 8px #000000;
    opacity: 0;
    transition-property: opacity;
}
.Lyrics.FadeIn {
    opacity: 1;
}
.Lyrics.FadeOut {
    opacity: 0;
}
.Lyrics.FadeDuration0 {
    transition-duration: 0s;
}
