  {
    "spawnflags": "4097",
    "StartDisabled": "0",
    "useLocalOffset": "0",
    "classname": "trigger_once",
    "origin": "-9335.500000 -9603.000000 -151.000000",
    "angles": "0.000000 0.000000 0.000000",
    "scales": "1.000000 1.000000 1.000000",
    "hammerUniqueId": "1446",
    "model": "maps\\ze_undertale_sans_final_1\\entities\\unnamed_1446.vmdl",
    "connections": [
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4",
        "input": "Toggle",
        "param": "",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I soon realized I didn\u0027t feel Anything about Anyone.",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say My compassion had disappeared!",
        "delay": 3,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say And believe me,it\u0027s not like I wasn\u0027t trying.",
        "delay": 5,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I wasted weeks with that stupid king,vainly hoping I would feel something.",
        "delay": 7,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say But it became too much for me.",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I ran away from home.Eventually,I reached the Ruins.Inside I found Her,Frisk.",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I thought of all people,She could make me feel whole again.She failed.Ha ha...",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4",
        "input": "Toggle",
        "param": "",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4-1",
        "input": "Toggle",
        "param": "",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4-1",
        "input": "Toggle",
        "param": "",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4",
        "input": "Toggle",
        "param": "",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I realized those two were useless.I became despondent.",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say I just wanted to love someone.I just wanted to care about someone.",
        "delay": 17,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say Frisk,you might not believe this...But I decided...It wasn\u0027t worth living anymore.",
        "delay": 19,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say Not in a world without love.Not in a world without you.",
        "delay": 21,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say So...I decided to follow in your footsteps.I would erase myself from existence.",
        "delay": 23,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 4",
        "input": "Command",
        "param": "say And you know what?I succeeded.",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4",
        "input": "Toggle",
        "param": "",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 4-1",
        "input": "Toggle",
        "param": "",
        "delay": 15,
        "limit": 1
      },
