  {
    "spawnflags": "4097",
    "StartDisabled": "0",
    "useLocalOffset": "0",
    "classname": "trigger_once",
    "origin": "-6559.000000 -9046.000000 -151.000000",
    "angles": "0.000000 0.000000 0.000000",
    "scales": "1.000000 1.000000 1.000000",
    "hammerUniqueId": "1459",
    "model": "maps\\ze_undertale_sans_final_1\\entities\\unnamed_1459.vmdl",
    "connections": [
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 6",
        "input": "Toggle",
        "param": "",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say It all started because I was curious.Curious what would happen if I killed them.",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say I don\u0027t like this,I told myself.I\u0027m just doing this because I have to know what happens.",
        "delay": 3,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say Ha ha ha...What an excuse!You of all people must kniw how liberating it is to act this way.",
        "delay": 5,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say At least we\u0027re better than those sickos that stand around and watch it happen...",
        "delay": 7,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say Those pathetic people that want to see it,but are too weak to do it themselves.",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say I bet someone like that\u0027s watching right now,aren\u0027t they...?",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say Nowadays,even that\u0027s grown tiring.You understand,Frisk.",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say I\u0027ve done everything this world has to offer.I\u0027ve read every book.I\u0027ve burned every book.",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say I\u0027ve won every game.I\u0027ve lost every game.I\u0027ve appeased everyone.I\u0027ve killed everyone.",
        "delay": 17,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say Set of number\u0027s...Lines of dialogue...I\u0027ve seen them all.",
        "delay": 19,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say But you...You\u0027re different.I never could predict you,Frisk.",
        "delay": 21,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say When I saw you in the Ruins,I didn\u0027t recognize you.I thought I could frighten you,then steal your soul.I failed.",
        "delay": 23,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say And when I tried to load my save file...It didn\u0027t work.",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 6",
        "input": "Command",
        "param": "say Frisk...Your determination!Somehow,it\u0027s even greater than mine!",
        "delay": 27,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 6",
        "input": "Toggle",
        "param": "",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 6-1",
        "input": "Toggle",
        "param": "",
        "delay": 13,
        "limit": 1
      },
      {
