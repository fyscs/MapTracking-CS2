        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say It doesn\u0027t matter now.I\u0027m so tired of this,Frisk.",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say I\u0027m tired of all these people.I\u0027m tired of all these places.I\u0027m tired of being a flower.",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Frisk.There\u0027s just one thing left I want to do.",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Let\u0027s finish what we started.Let\u0027s free everyone.",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Then...let\u0027s let them see what humanity is really like!",
        "delay": 17,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say That despite it all...This world is still kill or be killed!!",
        "delay": 19,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Then...?Well.I had...Been entertaining a few ways to use that power.",
        "delay": 21,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Hee hee hee...But seeing you here changed my mind.",
        "delay": 23,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Frisk...I think if you\u0027re around...Just living in the surface world doedn\u0027t seem so bad.",
        "delay": 25,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say We don\u0027t even need to leave to get them this time.The king has six of them locked away.",
        "delay": 27,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say I\u0027ve tried hundreds of ways to get him to show me them...But he just won\u0027t.",
        "delay": 29,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 7",
        "input": "Command",
        "param": "say Frisk...I know he\u0027ll do it for you.",
        "delay": 31,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flow 7",
        "input": "Toggle",
        "param": "",
        "delay": 17,
