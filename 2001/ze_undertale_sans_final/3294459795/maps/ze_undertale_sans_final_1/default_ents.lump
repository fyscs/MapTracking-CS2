      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say Why am I telling you all of this?Frisk,I said it before.",
        "delay": 1,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say Even after all this time...You\u0027re still the only one that understands me.You won\u0027t give me any worthless pity!",
        "delay": 3,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say Creatures like us...Wouldn\u0027t hesitate to kill each other if we got in each other\u0027s way.",
        "delay": 5,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say So that\u0027s...So...that\u0027s...Why...",
        "delay": 7,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say ...ha...ha......what\u0027s this......feeling?Why am I...Shaking?",
        "delay": 9,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say Hey...Frisk...No hard feelings about back then,right?",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say H-Hey,what are you doing!?B...back off!!",
        "delay": 13,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say I...I\u0027ve changed my mind about all this.This isn\u0027t a good idea anymore.",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
        "input": "Command",
        "param": "say Y-you should go back,Frisk.This place is fine the way it is!",
        "delay": 17,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]flowey say 8",
