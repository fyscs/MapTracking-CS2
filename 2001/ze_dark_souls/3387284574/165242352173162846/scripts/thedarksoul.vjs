});
I.OnScriptInput("SetLevel_AdminSwap", (data) => {
    if (CurrentLevel == Level.CHAMPION)
        Entities.FireInput({ name: "Admin_Set_Normal", input: "Trigger" });
    else
        Entities.FireInput({ name: "Admin_Set_Champion", input: "Trigger" });
