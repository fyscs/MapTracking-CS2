        if (activator instanceof CSPlayerPawn) {
            const controller = activator.GetPlayerController();
            if (controller?.IsValid() && activator.GetTeamNumber() == CS_TEAM_CT)
                emberVote.AddVote(controller, ember);
        }
    });
}
