    EmberVoteState[EmberVoteState["PhaseEnd"] = 3] = "PhaseEnd";
})(EmberVoteState || (EmberVoteState = {}));
const Embers = ["Divine", "Magic", "Dark", "Flame"];
const EMBER_BUTTON = "Vote_Ember_Button_";
const EMBER_PARTICLE = "Vote_Ember_Effect_";
const EMBER_VOTECOUNT = "Vote_Ember_VoteCount_";
const EMBER_COUNT = "Vote_Ember_Count_";
class EmberVote {
    state = EmberVoteState.NotStarted;
    results = new Map();
    voters = new Set();
    voteCounts = new Map();
    phase = 1; // there will be multiple of these votes so keep track
    startedAt = -1;
    phaseEndedAt = -1;
    Start() {
        if (this.phase > EmberVoteOptions.PHASES) {
            this.End();
            return;
        }
        this.state = EmberVoteState.NoVotes;
        Entities.FireInput({ name: `${EMBER_BUTTON}*`, input: "Unlock" });
        Entities.FireInput({ name: `${EMBER_PARTICLE}*`, input: "Start" });
        Entities.FireInput({ name: `${EMBER_VOTECOUNT}*`, input: "SetMessage", value: "0" });
        for (const ember of Embers)
            Entities.FireInput({ name: `${EMBER_COUNT}${ember}`, input: "SetMessage", value: `${(this.results.get(ember) ?? 0)}` });
        Entities.FireInput({ name: "Vote_Ember_Text", input: "SetMessage", value: `Vote Phase: ${this.phase}/${EmberVoteOptions.PHASES}` });
        Entities.FireInput({ name: "Vote_Ember_Text_Timeleft", input: "SetMessage", value: `Time left: ${EmberVoteOptions.PHASE_DURATION.toFixed(1)}` });
    }
    IsVoteInProgress() {
        if (this.state != EmberVoteState.NotStarted)
            return true;
        return false;
    }
    Tick() {
        if (this.state == EmberVoteState.Countdown) {
            const timeInPhase = I.GetGameTime() - this.startedAt;
            if (timeInPhase > EmberVoteOptions.PHASE_DURATION) {
                this.PhaseFinish();
            }
            const timeleft = Math.max(0, EmberVoteOptions.PHASE_DURATION - timeInPhase);
            Entities.FireInput({ name: "Vote_Ember_Text_Timeleft", input: "SetMessage", value: `Time left: ${timeleft.toFixed(1)}` });
        }
        else if (this.state == EmberVoteState.PhaseEnd) {
            const timeInPhaseEnd = I.GetGameTime() - this.phaseEndedAt;
            if (timeInPhaseEnd > EmberVoteOptions.TIME_BETWEEN_PHASES) {
                this.NextPhase();
                this.Start();
            }
        }
    }
    AddVote(player, choice) {
        if (!this.IsVoteInProgress())
            return false;
        if (!player.IsConnected())
            return false;
        if (this.voters.has(player))
            return false;
        this.voters.add(player);
        const newcount = (this.voteCounts.get(choice) ?? 0) + 1;
        this.voteCounts.set(choice, newcount);
        Entities.FireInput({ name: `${EMBER_VOTECOUNT}${choice}`, input: "SetMessage", value: `${newcount}` });
        const pawn = player.GetPlayerPawn();
        if (pawn?.IsValid())
            Entities.FireInput({ name: "votes.fade", input: "Fade", activator: pawn });
        if (this.state == EmberVoteState.NoVotes) {
            this.state = EmberVoteState.Countdown;
            this.startedAt = I.GetGameTime();
            I.SetNextThink(I.GetGameTime());
        }
        return true;
    }
    PhaseFinish() {
        this.state = EmberVoteState.PhaseEnd;
        this.phaseEndedAt = I.GetGameTime();
        Entities.FireInput({ name: `${EMBER_BUTTON}*`, input: "Lock" });
        Entities.FireInput({ name: `${EMBER_PARTICLE}*`, input: "Stop" });
        Entities.FireInput({ name: `${EMBER_VOTECOUNT}*`, input: "SetMessage", value: "" });
        const winner = this.GetWinner();
        Entities.FireInput({ name: `${winner}_Tottal`, input: "Add", value: 1 });
        // Set win count
        const winnerCount = (this.results.get(winner) ?? 0) + 1;
        Entities.FireInput({ name: `${EMBER_COUNT}${winner}`, input: "SetMessage", value: `${winnerCount}` });
        Entities.FireInput({ name: `${EMBER_PARTICLE}${winner}`, input: "Start", delay: 0.02 });
        this.results.set(winner, winnerCount);
    }
    GetWinner() {
        let winner = [];
        let highestCount = 0;
        for (const choice of Embers) {
            const count = this.voteCounts.get(choice) ?? 0;
            if (count > highestCount) {
                winner = [];
                winner.push(choice);
                highestCount = count;
            }
            else if (count === highestCount) {
                winner.push(choice);
            }
        }
        if (winner.length > 1)
            return winner[Math.floor(Math.random() * winner.length)];
        else
            return winner[0];
    }
    GetStage() {
        return this.phase;
    }
    NextPhase() {
        this.voters.clear();
        this.voteCounts.clear();
        this.phase++;
    }
    End() {
        Entities.FireInput({ name: "Vote_Ember_Push", input: "Kill" });
        Entities.FireInput({ name: `${EMBER_BUTTON}*`, input: "Kill" });
        Entities.FireInput({ name: `${EMBER_PARTICLE}*`, input: "Kill" });
        Entities.FireInput({ name: `${EMBER_COUNT}*`, input: "Kill" });
        Entities.FireInput({ name: `${EMBER_VOTECOUNT}*`, input: "Kill" });
        Entities.FireInput({ name: "Vote_Ember_Text", input: "Kill" });
        Entities.FireInput({ name: "Vote_Ember_Text_Timeleft", input: "Kill" });
    }
    RoundStart() {
        this.state = EmberVoteState.NotStarted;
        Entities.FireInput({ name: "Vote_Ember_Text", input: "SetMessage", value: "" });
        Entities.FireInput({ name: "Vote_Ember_Text_Timeleft", input: "SetMessage", value: "" });
        this.voters.clear();
        this.voteCounts.clear();
    }
    Reset() {
        this.RoundStart();
        this.results.clear();
        this.phase = 1;
    }
}
I.OnScriptInput("EmberVote_Start", (data) => {
    emberVote.Start();
});
I.OnScriptInput("EmberVote_Reset", (data) => {
    emberVote.Reset();
});
for (const ember of Embers) {
