var ChesterVoteState;
(function (ChesterVoteState) {
    ChesterVoteState[ChesterVoteState["NotStarted"] = 0] = "NotStarted";
    ChesterVoteState[ChesterVoteState["InProgress"] = 1] = "InProgress";
    ChesterVoteState[ChesterVoteState["Ended"] = 2] = "Ended";
})(ChesterVoteState || (ChesterVoteState = {}));
class ChesterSkip {
    state = ChesterVoteState.NotStarted;
    voters = new Set();
    passed = false;
    Reset() {
        this.state = ChesterVoteState.NotStarted;
        this.voters.clear();
        this.passed = false;
    }
    Start() {
        this.state = ChesterVoteState.InProgress;
        Entities.FireInput({ name: "Skip_Blevotnaya_Allow", input: "Compare" });
    }
    End() {
        this.state = ChesterVoteState.Ended;
        if (this.passed && CurrentLevel != Level.CHAMPION)
            Entities.FireInput({ name: "chesterskip.passed", input: "Trigger" });
        else
            Entities.FireInput({ name: "chesterskip.failed", input: "Trigger" });
    }
    Count() {
        // if we already passed then we cant un-pass
        if (this.passed)
            return;
        // Check if current votes pass
        let playerCount = 0;
        let voteCount = 0;
        for (const player of I.GetAllPlayerControllers()) {
            if (!player.IsConnected())
                continue;
            const pawn = player.GetPlayerPawn();
            if (!pawn?.IsValid() || pawn.GetTeamNumber() != CS_TEAM_CT || !pawn.IsAlive())
                continue;
            playerCount++;
            if (this.voters.has(player))
                voteCount++;
        }
        this.passed = (playerCount > 0) && (voteCount >= (playerCount * ChesterSkipVoteOptions.PASS_RATIO));
    }
    // player is ct here
    AddVote(player, pawn) {
        if (this.state != ChesterVoteState.InProgress)
            return;
        if (this.voters.has(player))
            return;
        this.voters.add(player);
        Entities.FireInput({ name: "votes.fade", input: "Fade", activator: pawn });
        Entities.FireInput({ name: "Skip_Blevotnaya_Touch", input: "Enable" });
        this.Count();
    }
    PlayerLeave() {
        if (this.state != ChesterVoteState.InProgress)
            return;
        this.Count();
    }
    PlayerTeamChange() {
        // Players old team was CT
        if (this.state == ChesterVoteState.InProgress)
            this.Count();
    }
}
I.OnScriptInput("ChesterSkip_Start", (data) => {
    chesterSkip.Start();
});
I.OnScriptInput("ChesterSkip_Choose", (data) => {
    chesterSkip.End();
});
I.OnScriptInput("ChesterSkip_Vote", ({ caller, activator }) => {
    if (activator instanceof CSPlayerPawn) {
        const controller = activator.GetPlayerController();
        if (controller?.IsValid() && activator.GetTeamNumber() == CS_TEAM_CT)
            chesterSkip.AddVote(controller, activator);
    }
});
/****************************************
****************************************/
/****************************************


    Ending Vote


****************************************/
function vec(_x, _y, _z) { return { x: _x, y: _y, z: _z }; }
function vecSubtract(a, b) { return vec(a.x - b.x, a.y - b.y, a.z - b.z); }
function vecLength2DSquared(vector) { return (vector.x * vector.x + vector.y * vector.y); }
function vecLength2D(vector) { return Math.sqrt(vecLength2DSquared(vector)); }
var EndingVoteState;
(function (EndingVoteState) {
    EndingVoteState[EndingVoteState["NotStarted"] = 0] = "NotStarted";
    EndingVoteState[EndingVoteState["InProgress"] = 1] = "InProgress";
    EndingVoteState[EndingVoteState["Ended"] = 2] = "Ended";
})(EndingVoteState || (EndingVoteState = {}));
class EndingVote {
    state = EndingVoteState.NotStarted;
    darkTarget = undefined;
    lightTarget = undefined;
    darkVotes = 0;
    lightVotes = 0;
    tickAt = -1;
    Start() {
        this.state = EndingVoteState.InProgress;
        this.tickAt = I.GetGameTime() + 1;
        I.SetNextThink(I.GetGameTime());
    }
    Tick() {
        const now = I.GetGameTime();
        if (now < this.tickAt)
            return;
        this.tickAt = now + 1;
        if (!this.darkTarget?.IsValid() || !this.lightTarget?.IsValid()) {
            if (!this.FindTargetEnts()) {
                Console.Log("ERROR: failed to find ending vote target ents. THIS IS BAD");
                return;
            }
        }
        // Check distance for each alive CT to targets (2D distance is fine its a flat arena)
        const darkPos = this.darkTarget.GetAbsOrigin();
        const lightPos = this.lightTarget.GetAbsOrigin();
        for (const player of I.GetAllPlayerControllers()) {
            const pawn = player.GetPlayerPawn();
            if (!pawn?.IsValid() || pawn.GetTeamNumber() != CS_TEAM_CT || !pawn.IsAlive())
                continue;
            const pos = pawn.GetAbsOrigin();
            const distToDark = vecLength2D(vecSubtract(pos, darkPos));
            if (distToDark <= EndingVoteOptions.DarkVoteRadius) {
                this.darkVotes++;
                continue;
            }
            const distToLight = vecLength2D(vecSubtract(pos, lightPos));
            if (distToLight <= EndingVoteOptions.LightVoteRadius) {
                this.lightVotes++;
            }
        }
    }
    End() {
        this.state = EndingVoteState.Ended;
        if (this.darkVotes > this.lightVotes || CurrentLevel == Level.CHAMPION)
            Entities.FireInput({ name: "endingvote.ending.dark", input: "Trigger" });
        else
            Entities.FireInput({ name: "endingvote.ending.light", input: "Trigger" });
    }
    IsVoteInProgress() {
        return this.state == EndingVoteState.InProgress;
    }
    Reset() {
        this.state = EndingVoteState.NotStarted;
        this.darkVotes = 0;
        this.lightVotes = 0;
        this.FindTargetEnts();
    }
    FindTargetEnts() {
        this.darkTarget = Entities.FindByName("endingvote.target.dark")[0];
        this.lightTarget = Entities.FindByName("endingvote.target.light")[0];
        return (this.darkTarget?.IsValid() && this.lightTarget?.IsValid());
    }
}
I.OnScriptInput("EndingVote_Start", (data) => {
    endingVote.Start();
});
I.OnScriptInput("EndingVote_End", (data) => {
    endingVote.End();
});
/****************************************
****************************************/
const champModeVote = new ChampModeVote();
const emberVote = new EmberVote();
const chesterSkip = new ChesterSkip();
const endingVote = new EndingVote();
I.SetThink(() => {
    let ticking = false;
    if (champModeVote.IsVoteInProgress()) {
        champModeVote.Check();
        ticking = true;
    }
    if (emberVote.IsVoteInProgress()) {
        emberVote.Tick();
        ticking = true;
    }
    if (endingVote.IsVoteInProgress()) {
        endingVote.Tick();
        ticking = true;
    }
    if (ticking)
        I.SetNextThink(I.GetGameTime());
});
I.OnRoundStart(() => {
    champModeVote.Reset();
    emberVote.RoundStart();
    chesterSkip.Reset();
    endingVote.Reset();
    Level_RoundStart();
    I.Delay(1).then(() => {
        GameRules.SetRoundRemainingTime((120 * 60) - 1);
    });
});
I.OnPlayerDisconnect((event) => {
    champModeVote.PlayerLeave();
    chesterSkip.PlayerLeave();
});
I.OnPlayerTeamChanged(({ player, oldTeam }) => {
    if (oldTeam == CS_TEAM_CT) {
        const controller = player.GetPlayerController();
        if (controller) {
            chesterSkip.PlayerTeamChange();
        }
    }
});
I.OnScriptReload({ before: () => {
        return { level: CurrentLevel };
    }, after: (data) => {
        CurrentLevel = data.level;
    } });
