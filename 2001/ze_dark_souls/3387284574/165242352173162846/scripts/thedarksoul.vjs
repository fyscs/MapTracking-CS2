var Level;
(function (Level) {
    Level[Level["WARMUP"] = 0] = "WARMUP";
    Level[Level["NORMAL"] = 1] = "NORMAL";
    Level[Level["CHAMPION"] = 2] = "CHAMPION";
})(Level || (Level = {}));
let CurrentLevel = Level.WARMUP;
function Level_RoundStart() {
    if (CurrentLevel == Level.WARMUP) {
        Entities.FireInput({ name: "Level_WarmUP_Trigger", input: "Trigger", delay: 1 });
    }
    else if (CurrentLevel == Level.NORMAL) {
        Entities.FireInput({ name: "Level_Normal_Trigger", input: "Trigger", delay: 1 });
    }
    else if (CurrentLevel == Level.CHAMPION) {
        Entities.FireInput({ name: "Level_Champion_Trigger", input: "Trigger", delay: 1 });
