/****************************************


    Champion Mode Vote


****************************************/
var ChampVoteState;
(function (ChampVoteState) {
    ChampVoteState[ChampVoteState["NotStarted"] = 0] = "NotStarted";
    ChampVoteState[ChampVoteState["InProgress"] = 1] = "InProgress";
    ChampVoteState[ChampVoteState["Ended"] = 2] = "Ended";
})(ChampVoteState || (ChampVoteState = {}));
class ChampModeVote {
    state = ChampVoteState.NotStarted;
    endAt = -1;
    passed = false;
    votes = new Set();
    Reset() {
        this.votes.clear();
        this.state = ChampVoteState.NotStarted;
        this.endAt = -1;
        this.passed = false;
    }
    Start() {
        this.Reset();
        this.state = ChampVoteState.InProgress;
        this.endAt = I.GetGameTime() + ChampModeVoteOptions.DURATION;
        I.SetNextThink(I.GetGameTime());
    }
    AddVote(player, pawn) {
        if (!this.IsVoteInProgress())
            return;
        if (!player.IsConnected())
            return;
        if (this.votes.has(player))
            return;
        this.votes.add(player);
        this.HasPassed();
        Entities.FireInput({ name: "votes.fade", input: "Fade", activator: pawn });
    }
    PlayerLeave() {
        if (!this.IsVoteInProgress())
            return;
        this.Check();
    }
    Check() {
        if (this.state != ChampVoteState.InProgress)
            return false;
        const passed = this.HasPassed();
        if (I.GetGameTime() < this.endAt)
            return false;
        this.state = ChampVoteState.Ended;
        if (passed)
            this.Passed();
        else
            this.Failed();
        return true;
    }
    HasPassed() {
        if (this.passed)
            return true;
        let playerCount = 0;
        let voteCount = 0;
        for (const player of I.GetAllPlayerControllers()) {
            if (!player.IsConnected())
                continue;
            playerCount++;
            if (this.votes.has(player))
                voteCount++;
        }
        this.passed = playerCount > 0 && voteCount >= Math.ceil(playerCount * ChampModeVoteOptions.PASS_RATIO);
        return this.passed;
    }
    Passed() {
        const relay = "champvote." + (CurrentLevel == Level.CHAMPION ? "normal" : "champ") + "passed";
        // The relay will change CurrentLevel variable
        Entities.FireInput({ name: relay, input: "Trigger" });
        this.End();
    }
    Failed() {
        this.End();
    }
    End() {
        Entities.FireInput({ name: "champvote.end", input: "Trigger" });
    }
    IsVoteInProgress() {
        return this.state == ChampVoteState.InProgress;
    }
}
I.OnScriptInput("ChampVote_Start", (data) => {
    champModeVote.Start();
});
I.OnScriptInput("ChampVote_Vote", ({ caller, activator }) => {
    if (activator instanceof CSPlayerPawn) {
        const controller = activator.GetPlayerController();
        if (controller?.IsValid())
            champModeVote.AddVote(controller, activator);
    }
});
