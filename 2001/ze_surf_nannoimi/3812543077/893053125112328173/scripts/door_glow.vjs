/**
 * door_glow.js —— 指路门/牌「靠近发光、远离熄灭」
 *
 * 挂法：地图里放一个 point_script（cs_script = scripts/door_glow.vjs），
 *      再由 logic_auto 在 OnMapSpawn 时向它发 RunScriptInput "door_glow_start" 启动。
 *
 * 原理：BaseModelEntity.Glow(color) / Unglow() 是**持久状态**，所以只在「状态翻转」时
 *      调用一次；每 0.2s 只做距离判断（16 个门 × 玩家数），开销可忽略。
 *      进入 radiusOn 就亮、离开 radiusOff 才灭 —— 中间留迟滞，防止在边界反复闪。
 */
import { Instance } from "cs_script/point_script";

const CFG = {
    // 需要发光的实体 targetname
    doors: [
        "door_1", "door_3", "door_5", "door_6",
        "door_12", "door_13", "door_14", "door_15", "door_16", "door_17", "door_18",
        "hideladder", "door_19", "door_20", "door_21", "door_22",
    ],
    color: { r: 80, g: 255, b: 120 },   // 发光颜色（绿）
    radiusOn: 320,        // 玩家进入这个距离 → 亮
    radiusOff: 420,       // 玩家离开到这个距离外 → 灭（必须 > radiusOn）
    interval: 0.2,        // 检测间隔（秒）
};

/** @type {{name: string, ent: any, on: boolean}[]} */
const doors = [];
let resolved = false;

/** 把名字解析成实体（脚本加载瞬间地图实体可能还没就绪，所以放到第一次 think 里做） */
function resolveDoors() {
    for (const name of CFG.doors) {
        const list = Instance.FindEntitiesByName(name);
        if (list && list.length > 0) {
            doors.push({ name: name, ent: list[0], on: false });
        }
    }
    resolved = true;
    Instance.Msg("[door_glow] 已解析 " + doors.length + "/" + CFG.doors.length + " 个指路实体\n");
}

/** 所有存活玩家的世界坐标 */
function playerPositions() {
    const out = [];
    for (const c of Instance.GetAllPlayerControllers()) {
        if (!c || !c.IsValid()) continue;
        const pw = c.GetPlayerPawn();
        if (!pw || !pw.IsValid()) continue;
        const p = pw.GetAbsOrigin();
        if (p) out.push(p);
    }
    return out;
}

function distSq(a, b) {
    const dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
    return dx * dx + dy * dy + dz * dz;
}

function think() {
    if (!resolved) resolveDoors();
    const ps = playerPositions();
    const onSq = CFG.radiusOn * CFG.radiusOn;
    const offSq = CFG.radiusOff * CFG.radiusOff;
    for (const d of doors) {
        if (!d.ent || !d.ent.IsValid()) continue;      // 实体被 kill/替换后跳过
        const o = d.ent.GetAbsOrigin();
        if (!o) continue;
        let nearest = Number.MAX_VALUE;
        for (const p of ps) {
            const q = distSq(o, p);
            if (q < nearest) nearest = q;
        }
        if (!d.on && nearest < onSq) {
            try { d.ent.Glow(CFG.color); d.on = true; } catch (e) { /* 个别类不支持发光 */ }
        } else if (d.on && nearest > offSq) {
            try { d.ent.Unglow(); d.on = false; } catch (e) { /* 同上 */ }
        }
    }
    Instance.SetNextThink(Instance.GetGameTime() + CFG.interval);
}

/** 由地图 IO 的 RunScriptInput "door_glow_start" 触发（point_script 首次收到脚本输入时才会真正加载/启动本脚本） */
Instance.OnScriptInput("door_glow_start", () => {
    Instance.SetThink(think);
    Instance.SetNextThink(Instance.GetGameTime() + 0.5);
});

// think 回调只注册一次；首帧延后 1s，等地图实体全部就绪
Instance.SetThink(think);
Instance.SetNextThink(Instance.GetGameTime() + 1.0);
