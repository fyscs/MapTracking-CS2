        "output": "OnCase02",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **An ancient shrine deep within the Jagd Ramooda**",
        "delay": 7,
        "limit": -1
      },
      {
        "output": "OnCase02",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **Like Raithwall?s tomb this too was constructed in the time of the Galtean Alliance**",
        "delay": 10,
        "limit": -1
      },
      {
        "output": "OnCase02",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **Originally to honor the ancient god of swords and martial**",
        "delay": 12,
        "limit": -1
      },
      {
        "output": "OnCase02",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **It is said that a Gran Kiltias of long ago selected the Stilshrine to house the relics of Dynast-King Raithwall!**",
        "delay": 14,
        "limit": -1
      },
      {
        "output": "OnCase04",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say **You Journed across the Paramina Rift to the Stilshrine of Miriam**",
