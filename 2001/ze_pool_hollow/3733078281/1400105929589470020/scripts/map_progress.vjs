/** slot -> 上一 tick 的翻页键状态，用来做"按下"的边沿检测 */
const pageKeyWasDown = {};

/** 墙钟（Date）能不能用：null = 还没测过 */
let clockOk = null;

/** 上次检查是否跨月的时间点 */
let lastMonthCheckAt = 0;

let cachedLayout;

// ============================================================================
//  四、存档读写
// ============================================================================

function Log(msg) {
	Instance.Msg(`[progress] ${msg}`);
}

// ============================================================================
//  三点五、墙钟 / 北京时间
//
//  cs_script 没有墙钟 API（GetGameTime 是"本局开始到现在"，换图就归零），
//  但 VM 的目标是 es2022（Valve 自己的 cs_script_demo/tsconfig.json 里写着 target: es2022），
//  所以直接用 JS 的 Date —— 并且用 UTC 方法 + 8 小时偏移换算成北京时间，
//  这样服务器在哪个时区、有没有夏令时都不影响"哪一刻算新月"。
//  万一 Date 拿不到（clockOk = false），月度榜退化成手动触发：
//  控制台 ent_fire progress_1 RunScriptInput progress_reset_month。
// ============================================================================

function pad2(n) {
	return (n < 10 ? "0" : "") + n;
}

/** 墙钟能不能用（结果缓存；测不到会打一条日志） */
function clockAvailable() {
	if (clockOk !== null) {
		return clockOk;
	}
	clockOk = false;
	try {
		if (typeof Date === "function") {
			const t = Date.now();
			if (typeof t === "number" && isFinite(t) && t > 1600000000000) {
				clockOk = true;
			}
		}
	} catch (e) {
		clockOk = false;
	}
	Log(clockOk ? `墙钟可用，北京时间为 ${beijingText()}` : "墙钟不可用（Date 拿不到），月度榜需手动触发 progress_reset_month");
	return clockOk;
}

/** 北京时间各部分（用 UTC 方法读，与服务器时区无关） */
function beijingParts() {
	if (clockOk === null && !clockAvailable()) {
		return null;
	}
	if (!clockOk) {
		return null;
	}
	try {
		const d = new Date(Date.now() + BEIJING_UTC_OFFSET_HOURS * 3600 * 1000);
		return {
			year: d.getUTCFullYear(),
			month: d.getUTCMonth() + 1,
			day: d.getUTCDate(),
			hour: d.getUTCHours(),
			minute: d.getUTCMinutes(),
			second: d.getUTCSeconds(),
		};
	} catch (e) {
		return null;
	}
}

/** 北京时间的月份键，形如 2026-10；没有墙钟返回 null */
function currentMonthKey() {
	const p = beijingParts();
	return p ? `${p.year}-${pad2(p.month)}` : null;
}

/** 北京时间文本，形如 2026-10-08 13:05:22 */
function beijingText() {
	const p = beijingParts();
	if (!p) {
		return "(没有墙钟)";
	}
	return `${p.year}-${pad2(p.month)}-${pad2(p.day)} ${pad2(p.hour)}:${pad2(p.minute)}:${pad2(p.second)}`;
}

/** 读整个 addon 存档并解析成对象；空/坏数据都返回 {} */
function readBlob() {
	let raw = "";
	try {
		raw = Instance.GetSaveData();
	} catch (e) {
		Log(`GetSaveData 失败：${e}`);
		return {};
	}
	if (!raw) {
		return {};
	}
	try {
		const parsed = JSON.parse(raw);
		if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
			return parsed;
		}
		Log("存档不是对象，已忽略");
	} catch (e) {
		Log(`存档不是合法 JSON，已忽略：${e}`);
	}
	return {};
}

/**
 * UTF-8 字节数的保守估计。
 * 引擎那边比的是**文件字节数**（`Addon save file exceeds max size setting`），而 JS 的
 * `text.length` 是 UTF-16 码元数 —— 一个中文在 JSON 里是 3 字节但 length 只算 1，
 * 直接用 length 会把中文名玩家的容量算大 3 倍，所以这里按 3 字节估非 ASCII。
 */
function estimateBytes(text) {
	let wide = 0;
	for (let i = 0; i < text.length; i++) {
		if (text.charCodeAt(i) >= 128) {
			wide++;
		}
	}
	return (text.length - wide) + wide * 3;
}

function buildBlobText(blob) {
	try {
		return JSON.stringify(blob);
	} catch (e) {
		Log(`序列化失败：${e}`);
		return null;
	}
}

/**
 * 写回整个 addon 存档，返回写入的字节数（失败返回 -1）。
 * 超过硬上限时先淘汰最低的记录再写 —— 宁可丢几条最冷门的记录，也不要整个存档写不进去
 * （写不进去会一直重试，之后所有人的数据都存不下来）。
 */
function writeBlob(blob) {
	let text = buildBlobText(blob);
	if (text === null) {
		return -1;
	}

	let bytes = estimateBytes(text);
	if (bytes > SIZE_HARD_BYTES) {
		for (let attempt = 0; attempt < 8 && bytes > SIZE_HARD_BYTES; attempt++) {
			const keys = Object.keys(mapData.players);
			if (keys.length <= MIN_PLAYERS_KEEP) {
				Log(`存档 ${bytes} 字节已超过 ${SIZE_HARD_BYTES}，但记录只剩 ${keys.length} 条，不再淘汰`);
				break;
			}
			keys.sort((a, b) => {
				const ra = mapData.players[a];
				const rb = mapData.players[b];
				if (ra.n !== rb.n) {
					return ra.n - rb.n;
				}
				return ra.name < rb.name ? -1 : (ra.name > rb.name ? 1 : 0);
			});
			const drop = Math.max(1, Math.floor(keys.length * 0.1));
			for (let i = 0; i < drop; i++) {
				delete mapData.players[keys[i]];
			}
			Log(`存档 ${bytes} 字节超过硬上限 ${SIZE_HARD_BYTES}，淘汰了 ${drop} 条最低记录（剩 ${keys.length - drop} 条）`);
			text = buildBlobText(blob);
			if (text === null) {
				return -1;
			}
			bytes = estimateBytes(text);
		}
	}

	try {
		Instance.SetSaveData(text);
	} catch (e) {
		Log(`SetSaveData 失败（可能超过 sv_workshop_map_save_data_max_filesize_mb）：${e}`);
		return -1;
	}
	if (bytes >= SIZE_WARN_BYTES) {
		Log(`警告：存档约 ${bytes} 字节，接近默认 1MB 上限`);
	}
	return bytes;
}

function normalizeMapData(raw) {
	const out = { v: SAVE_VERSION, total: 0, month: "", players: {} };
	if (!raw || typeof raw !== "object") {
		return out;
	}
	if (typeof raw.total === "number" && isFinite(raw.total)) {
		out.total = Math.max(0, Math.floor(raw.total));
	}
	if (typeof raw.month === "string") {
		out.month = raw.month;
	}
	const players = raw.players;
	if (players && typeof players === "object" && !Array.isArray(players)) {
		for (const key of Object.keys(players)) {
			const rec = players[key];
			if (!rec || typeof rec !== "object") {
				continue;
			}
			const n = typeof rec.n === "number" && isFinite(rec.n) ? Math.max(0, Math.floor(rec.n)) : 0;
			const name = typeof rec.name === "string" && rec.name ? rec.name : key;
			// m = 本月通关次数。
			// 老存档（还没有 month 字段）没有 m：把已有的累计次数当成"本月"的，不丢数据；
			// 已经有 month 的存档里 m 缺失（不该发生）就按 0 算，免得把上个月的次数带进新月。
			let m;
			if (typeof rec.m === "number" && isFinite(rec.m)) {
				m = Math.max(0, Math.floor(rec.m));
			} else {
				m = out.month ? 0 : n;
			}
			out.players[key] = { n: n, m: m, name: name };
		}
	}
	return out;
}

/**
 * 跨月检查：北京时间和存档里记的月份不一样就清零"本月次数"。
 * 第一次启用（存档里还没有 month）不清零，只把当前月份记下来。
 * @returns 是否发生了跨月清零
 */
function ensureMonth() {
	if (!MONTHLY_RESET || !mapData) {
		return false;
	}
	const mk = currentMonthKey();
	if (!mk || mapData.month === mk) {
		return false;
	}
	const previous = mapData.month;
	mapData.month = mk;
	boardVersion++;
	boardDirty = true;

	if (!previous) {
		// 第一次启用月度榜：normalizeMapData 已经把 n 继承进 m 了，这里不动
		Log(`月度榜启用：本期 ${mk}（北京时间，每月 1 日 0 点清零）`);
		markDirty();
		return false;
	}

	let cleared = 0;
	for (const key of Object.keys(mapData.players)) {
		if (mapData.players[key].m > 0) {
			cleared++;
		}
		mapData.players[key].m = 0;
	}
	Log(`新的一个月（北京时间 ${mk}，上期 ${previous}）→ 本月榜已清零，${cleared} 人的本月次数归零`);
	markDirty();
	return true;
}

/** 手动清零本月榜（Hammer 触发 / ent_fire / 控制台指令） */
function resetMonthly(reason) {
	if (!mapData) {
		return;
	}
	const mk = currentMonthKey() || mapData.month || "";
	let cleared = 0;
	for (const key of Object.keys(mapData.players)) {
		if (mapData.players[key].m > 0) {
			cleared++;
		}
		mapData.players[key].m = 0;
	}
	mapData.month = mk;
	boardVersion++;
	boardDirty = true;
	markDirty();
	flush(true);
	Log(`本月榜已手动清零（${reason}，${cleared} 人受影响，本期 ${mk || "无墙钟"}）`);
}

function loadFromDisk() {
	mapKey = Instance.GetMapName() || "unknown_map";
	const blob = readBlob();
	const ns = blob[SAVE_ROOT] && typeof blob[SAVE_ROOT] === "object" ? blob[SAVE_ROOT] : {};
	const maps = ns.maps && typeof ns.maps === "object" ? ns.maps : {};
	mapData = normalizeMapData(maps[mapKey]);
	dirty = false;
	boardVersion++;
	boardDirty = true;
	Log(`载入 ${mapKey}：累计 ${mapData.total} 次，记录 ${PlayerCount()} 名玩家`);
}

/**
 * 落盘：读-改-写。先把磁盘上最新的 blob 读回来，只替换本图那一段，
 * 这样别的脚本（或同一 addon 里别的图）写的键不会被覆盖。
 * （和 Valve 官方 cs_script_demo/maps/scripts/chess.js 的 readSaveKey/writeSaveKey 一个思路）
 */
function flush(force) {
	if (!mapData) {
		return;
	}
	if (!dirty && !force) {
		return;
	}
	const blob = readBlob();
	let ns = blob[SAVE_ROOT];
	if (!ns || typeof ns !== "object" || Array.isArray(ns)) {
		ns = {};
	}
	if (!ns.maps || typeof ns.maps !== "object" || Array.isArray(ns.maps)) {
		ns.maps = {};
	}
	ns.version = SAVE_VERSION;
	ns.maps[mapKey] = mapData;
	blob[SAVE_ROOT] = ns;

	const size = writeBlob(blob);
	if (size < 0) {
		return; // 没写成，保持 dirty，交给 tick 重试
	}
	dirty = false;
	lastFlushAt = Instance.GetGameTime();
	Log(`已保存 ${mapKey}：累计 ${mapData.total} 次，${PlayerCount()} 名玩家，${size} 字节`);
}

/** 标脏 + 排落盘时间（具体的写入交给 tick，避免同一队同时通关时写多次） */
function markDirty() {
	dirty = true;
	const now = Instance.GetGameTime();
	let when = now + FLUSH_DEBOUNCE;
	if (now - lastFlushAt > FLUSH_MAX_WAIT) {
		when = now;
	}
	if (when < pendingFlushAt) {
		pendingFlushAt = when;
		// 保险：万一 tick 没在跑（或被人为停掉），这里把时钟重新叫起来
		Instance.SetNextThink(pendingFlushAt);
	}
}

// ============================================================================
//  五、玩家与计数
// ============================================================================

function PlayerCount() {
	return mapData ? Object.keys(mapData.players).length : 0;
}

/** 名字 → 键：去首尾空格、折叠中间空白、转小写 */
function keyOf(name) {
	return String(name).trim().replace(/\s+/g, " ").toLowerCase();
}

/** 记录数超过上限时淘汰最低的：先比通关次数，再比名字（同分淘汰名字靠前的） */
function prunePlayers() {
	const keys = Object.keys(mapData.players);
	if (keys.length <= MAX_PLAYERS) {
		return;
	}
	keys.sort((a, b) => {
		const ra = mapData.players[a];
		const rb = mapData.players[b];
		if (ra.n !== rb.n) {
			return ra.n - rb.n;
		}
		return ra.name < rb.name ? -1 : (ra.name > rb.name ? 1 : 0);
	});
	const removeCount = keys.length - MAX_PLAYERS;
	for (let i = 0; i < removeCount; i++) {
		delete mapData.players[keys[i]];
	}
	Log(`记录数超过 ${MAX_PLAYERS}，淘汰了 ${removeCount} 条最低记录`);
}

/** 取记录，没有就建一条 */
function ensureRecord(name) {
	const key = keyOf(name);
	let rec = mapData.players[key];
	if (!rec) {
		rec = { n: 0, m: 0, name: name };
		mapData.players[key] = rec;
	}
	rec.name = name;
	if (typeof rec.n !== "number" || !isFinite(rec.n)) {
		rec.n = 0;
	}
	if (typeof rec.m !== "number" || !isFinite(rec.m)) {
		rec.m = 0;
	}
	return rec;
}

/** 排行榜用来排名的那一列：开了月度榜就是本月次数，否则是累计次数 */
function rankValue(rec) {
	return MONTHLY_RESET ? rec.m : rec.n;
}

function isHuman(controller) {
	if (!controller) {
		return false;
	}
	try {
		if (!controller.IsValid()) {
			return false;
		}
		if (controller.IsBot && controller.IsBot()) {
			return false;
		}
		if (controller.IsConnected && !controller.IsConnected()) {
			return false;
		}
		return true;
	} catch (e) {
		return false;
	}
}

/**
 * 给一个 controller 记一次通关。
 * @returns 该玩家的累计次数；没记成返回 -1
 */
function record(controller, reason) {
	if (!mapData || !isHuman(controller)) {
		return -1;
	}
	const name = controller.GetPlayerName();
	if (!name || !String(name).trim()) {
		return -1;
	}
	const key = keyOf(name);

	if (ONCE_PER_ROUND && awardedThisRound.has(key)) {
		return -1;
	}
	awardedThisRound.add(key);

	let rec = ensureRecord(name);
	rec.n += 1;
	rec.m += 1;
	mapData.total += 1;
	prunePlayers();
	markDirty();
	boardVersion++;
	boardDirty = true;

	Log(
		`${name} 通关 +1（${reason}），本月 ${rec.m} 次 / 累计 ${rec.n} 次，本图累计 ${mapData.total} 次`
	);
	return MONTHLY_RESET ? rec.m : rec.n;
}

/** 从输入回调里把「是谁触发的」翻成 controller */
function controllerFromInput(inputData) {
	const activator = inputData ? inputData.activator : undefined;
	if (!activator) {
		return undefined;
	}
	try {
		if (activator.GetClassName && activator.GetClassName() === "cs_player_controller") {
			return activator;
		}
		if (activator.GetPlayerController) {
			return activator.GetPlayerController();
		}
	} catch (e) {
		// 掉下去当拿不到处理
	}
	return undefined;
}

function recordAllAlive(reason) {
	for (const controller of Instance.GetAllPlayerControllers()) {
		if (!isHuman(controller) || !passesTeamFilter(controller)) {
			continue;
		}
		const pawn = controller.GetPlayerPawn();
		if (!pawn || !pawn.IsAlive()) {
			continue;
		}
		record(controller, reason);
	}
}

/** ENDZONE_TEAM 过滤（-1 = 不过滤） */
function passesTeamFilter(controller) {
	if (ENDZONE_TEAM < 0) {
		return true;
	}
	try {
		return controller.GetTeamNumber() === ENDZONE_TEAM;
	} catch (e) {
		return false;
	}
}

// ============================================================================
//  六、排行榜面板
// ============================================================================

/**
 * 取到 HUD 布局。缓存句柄，但引擎可能重建面板，所以先 IsValid 再复用。
 */
function GetLayout() {
	if (cachedLayout && cachedLayout.IsValid()) {
		return cachedLayout;
	}
	const found = Instance.FindEntitiesByName(HUD_NAME);
	cachedLayout = found.length > 0 ? found[0] : undefined;
	if (!cachedLayout) {
		Log(`找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
	}
	return cachedLayout;
}

/**
 * 数据变了才重排；返回按名次列降序、同次数按名字升序的键列表。
 * ⚠ 只收「名次列 > 0」的人：现在只要进过图就会有记录（记游玩时长），
 *   不做这个过滤的话，榜单人数不足 5 个时会冒出几个「0 次」占位。
 *   （名次列 = 本月次数或累计次数，见 rankValue）
 */
function SortedKeys() {
	if (sortedCacheVersion !== boardVersion) {
		sortedKeys = Object.keys(mapData.players).filter((k) => rankValue(mapData.players[k]) > 0);
		sortedKeys.sort((a, b) => {
			const diff = rankValue(mapData.players[b]) - rankValue(mapData.players[a]);
			if (diff !== 0) {
				return diff;
			}
			const an = mapData.players[a].name;
			const bn = mapData.players[b].name;
			return an < bn ? -1 : (an > bn ? 1 : 0);
		});
		sortedCacheVersion = boardVersion;
	}
	return sortedKeys;
}

/** 一共几页（按本月/累计次数排完序之后） */
function pageCount() {
	const total = SortedKeys().length;
	return total === 0 ? 1 : Math.ceil(total / ROWS_BLOCKS);
}

/** 底部那行小字：第几页 / 一共几页 + 按键提示 */
function pageText(page) {
	const pages = pageCount();
	if (!SHOW_PAGE_HINT) {
		return `第 ${page + 1} / ${pages} 页`;
	}
	if (pages <= 1) {
		return `第 1 / 1 页`;
	}
	return `第 ${page + 1} / ${pages} 页 · R 下页 F 上页`;
}

/**
 * 把某个玩家当前这一页刷到面板上。
 *
 * 榜内容是**每个玩家各自一份**的（不同人可以翻到不同页），所以全部走
 * SetDialogVariableStringForPlayer / SetHasClassForPlayer。
 *
 * ⚠ 行面板的 id 是用前缀 + 下标拼出来的，离线校验器靠脚本顶部那几对
 *   *_BLOCKS / *_BLOCK_PREFIX 常量去数 XML 里有没有 pb_row_1…N（以及每个 Label 的
 *   text 是不是 {s:同一个 id}），所以改行数要同步改 XML / CSS / 这里的常量。
 */
function PushRowsFor(layout, controller, slot) {
	const keys = SortedKeys();
	const pages = pageCount();
	let page = boardPage[slot] | 0;
	if (page < 0) {
		page = 0;
	}
	if (page > pages - 1) {
		page = pages - 1;
	}
	boardPage[slot] = page;

	const start = page * ROWS_BLOCKS;
	for (let i = 1; i <= ROWS_BLOCKS; i++) {
		const k = keys[start + i - 1];
		const rowId = ROWS_BLOCK_PREFIX + i;
		const rankId = RANKS_BLOCK_PREFIX + i;
		const nameId = NAMES_BLOCK_PREFIX + i;
		const countId = COUNTS_BLOCK_PREFIX + i;
		layout.SetDialogVariableStringForPlayer(slot, rankId, rankId, k ? String(start + i) : "");
		layout.SetDialogVariableStringForPlayer(slot, nameId, nameId, k ? mapData.players[k].name : "");
		layout.SetDialogVariableStringForPlayer(slot, countId, countId, k ? rankValue(mapData.players[k]) + " 次" : "");
		layout.SetHasClassForPlayer(slot, rowId, HIDDEN_CLASS, !k);
	}

	// 一条记录都没有时的提示
	if (keys.length === 0) {
		layout.SetDialogVariableStringForPlayer(
			slot,
			EMPTY_PANEL,
			EMPTY_VARIABLE,
			MONTHLY_RESET ? "本月还没有人通关过，第一个是你吗？" : "还没有人通关过，第一个是你吗？"
		);
		layout.SetHasClassForPlayer(slot, EMPTY_PANEL, HIDDEN_CLASS, false);
	} else {
		layout.SetHasClassForPlayer(slot, EMPTY_PANEL, HIDDEN_CLASS, true);
	}

	layout.SetDialogVariableStringForPlayer(slot, PAGE_PANEL, PAGE_VARIABLE, pageText(page));
	SetMeText(layout, controller, slot);
}

/**
 * 全局那几句空写入：纯粹是给离线校验器核对 XML 契约用的
 *   （校验器只能看字面量：panelId + {s:变量名} 必须一一对上）
 * 真正的每人数值都在 PushRowsFor 里按 slot 覆盖。
 */
function PushBoardGlobals(layout) {
	layout.SetDialogVariableString(EMPTY_PANEL, EMPTY_VARIABLE, "");
	layout.SetDialogVariableString(PAGE_PANEL, PAGE_VARIABLE, "");
	layout.SetDialogVariableString(ME_PANEL, ME_VARIABLE, "");
	boardDirty = false;
}

/** 某个玩家底部那行「你自己」 */
function SetMeText(layout, controller, slot) {
	let meText = "";
	try {
		const key = keyOf(controller.GetPlayerName());
		const rec = mapData.players[key];
		if (!rec || rankValue(rec) <= 0) {
			if (MONTHLY_RESET) {
				meText = rec && rec.n > 0 ? `你本月还没有通关（历史累计 ${rec.n} 次）` : "你还没有通关记录";
			} else {
				meText = `你还没有通关记录（本图累计 ${mapData.total} 次）`;
			}
		} else {
			const keys = SortedKeys();
			let rank = 0;
			for (let i = 0; i < keys.length; i++) {
				if (keys[i] === key) {
					rank = i + 1;
					break;
				}
			}
			meText = MONTHLY_RESET
				? `你：本月 ${rec.m} 次 · 第 ${rank} 名（累计 ${rec.n} 次）`
				: `你：${rec.n} 次 · 第 ${rank} 名（本图累计 ${mapData.total} 次）`;
		}
	} catch (e) {
		meText = "";
	}
	layout.SetDialogVariableStringForPlayer(slot, ME_PANEL, ME_VARIABLE, meText);
}

/** 这个玩家现在该不该看到排行榜 */
function WantsBoard(controller, slot) {
	if (forceBoard !== null) {
		return forceBoard;
	}
	// 聊天指令开的临时窗口（!top），优先于按键判定 —— 死了在观战也能用
	if (chatUntil[slot] !== undefined) {
		if (chatUntil[slot] > Instance.GetGameTime()) {
			return true;
		}
		delete chatUntil[slot];
	}
	if (!REQUIRE_HOLD_KEYS) {
		return true;
	}
	const pawn = controller.GetPlayerPawn();
	if (!pawn) {
		return false;
	}
	try {
		if (!pawn.IsInputPressed(HOLD_KEY_A)) {
			return false;
		}
		// HOLD_KEY_B = null → 单键模式：按住 TAB 就显示
		return HOLD_KEY_B === null ? true : pawn.IsInputPressed(HOLD_KEY_B);
	} catch (e) {
		return false;
	}
}

/** 翻页键当前是否按住（打开面板那一帧要把这个记下来，否则"打开前就按住 R"会在下一 tick 被当成一次按下） */
function currentPageKeyState(controller) {
	const st = { next: false, prev: false };
	const pawn = controller.GetPlayerPawn();
	if (!pawn) {
		return st;
	}
	try {
		st.next = !!pawn.IsInputPressed(PAGE_NEXT_KEY);
		st.prev = !!pawn.IsInputPressed(PAGE_PREV_KEY);
	} catch (e) {
		// 读不到就当没按
	}
	return st;
}

/** 翻页键的边沿检测：按住 TAB 看榜时，按一下 R / F 换一页 */
function HandlePageKeys(controller, slot, layout) {
	const pawn = controller.GetPlayerPawn();
	if (!pawn) {
		return false;
	}
	let nextDown = false;
	let prevDown = false;
	try {
		nextDown = !!pawn.IsInputPressed(PAGE_NEXT_KEY);
		prevDown = !!pawn.IsInputPressed(PAGE_PREV_KEY);
	} catch (e) {
		return false;
	}
	const was = pageKeyWasDown[slot] || { next: false, prev: false };
	pageKeyWasDown[slot] = { next: nextDown, prev: prevDown };

	const pages = pageCount();
	if (pages <= 1) {
		return false;
	}
	let page = boardPage[slot] | 0;
	let handled = false;
	if (nextDown && !was.next && page < pages - 1) {
		page++;
		handled = true;
	} else if (prevDown && !was.prev && page > 0) {
		page--;
		handled = true;
	}
	if (!handled) {
		return false;
	}
	boardPage[slot] = page;
	PushRowsFor(layout, controller, slot);
	Log(`${controller.GetPlayerName()} 排行榜翻到第 ${page + 1} / ${pages} 页`);
	return true;
}

/** 每个 tick 检查按键，只在状态变化时向引擎发命令 */
function UpdateBoardVisibility(layout) {
	let meDirty = false;
	for (const controller of Instance.GetAllPlayerControllers()) {
		if (!isHuman(controller)) {
			continue;
		}
		const slot = controller.GetPlayerSlot();
		const want = !!WantsBoard(controller, slot);
		if (boardVisible[slot] !== want) {
			boardVisible[slot] = want;
			layout.SetHasClassForPlayer(slot, BOARD_PANEL, HIDDEN_CLASS, !want);
			if (want) {
				boardPage[slot] = 0; // 每次打开都从第 1 页开始
				pageKeyWasDown[slot] = currentPageKeyState(controller);
				PushRowsFor(layout, controller, slot);
			} else {
				delete pageKeyWasDown[slot];
			}
			continue;
		}
		if (!want) {
			continue;
		}
		// 已经开着：先处理翻页；没翻页就看数据是否变了（有人通关 / 跨月清零）需要重刷
		if (HandlePageKeys(controller, slot, layout)) {
			meDirty = true;
			continue;
		}
		if (meVersion !== boardVersion) {
			PushRowsFor(layout, controller, slot);
			meDirty = true;
		}
	}
	if (meDirty) {
		meVersion = boardVersion;
	}
}

let meVersion = -1;

/** 新玩家进服 / 换图后，把该 slot 的历史覆盖清掉（否则会被上一任玩家的状态带着显示） */
function ResetSlot(slot) {
	const layout = GetLayout();
	boardVisible[slot] = false;
	delete chatUntil[slot];
	delete boardPage[slot];
	delete pageKeyWasDown[slot];
	if (!layout) {
		return;
	}
	layout.SetHasClassForPlayer(slot, BOARD_PANEL, HIDDEN_CLASS, true);
	layout.SetDialogVariableStringForPlayer(slot, ME_PANEL, ME_VARIABLE, "");
}

// ============================================================================
//  七、接线
// ============================================================================

function init() {
	if (initialized) {
		return;
	}
	initialized = true;
	loadFromDisk();
	ensureMonth(); // 换图时可能已经跨月了
	lastMonthCheckAt = Instance.GetGameTime();
	lastFlushAt = Instance.GetGameTime();
	pendingFlushAt = Infinity;
	forceBoard = null;
	awardedThisRound.clear();
	for (const slot of Object.keys(chatUntil)) {
		delete chatUntil[slot];
	}
	for (const slot of Object.keys(boardPage)) {
		delete boardPage[slot];
	}
	for (const slot of Object.keys(pageKeyWasDown)) {
		delete pageKeyWasDown[slot];
	}
	if (BOARD_ROWS_PER_PAGE !== ROWS_BLOCKS) {
		Log(`警告：BOARD_ROWS_PER_PAGE(${BOARD_ROWS_PER_PAGE}) 与 ROWS_BLOCKS(${ROWS_BLOCKS}) 不一致，面板行数会对不上`);
	}
	// ★ 必须在这里把 tick 叫起来：SetThink 只是"注册回调"，SetNextThink 才决定它什么时候跑。
	//   少了这一句，整条循环根本不会启动 —— 后果是「按键显隐永远不刷新」+「数据永远不落盘」
	//   （2026-10-08 的 console.log 里就是这个症状：[progress] 载入 → 通关 +1 → 再也没有「已保存」）。
	Instance.SetNextThink(Instance.GetGameTime());
}

Instance.OnActivate(() => {
	init();
	const layout = GetLayout();
	if (layout) {
		layout.Reset();
		PushBoardGlobals(layout);
	}
});

Instance.OnScriptReload({
	before: () => {
		try {
			flush(true);
		} catch (e) {
			Log(`reload 前落盘失败：${e}`);
		}
		return true;
	},
	after: () => {
		initialized = false;
		init();
		const layout = GetLayout();
		if (layout) {
			PushBoardGlobals(layout);
		}
	},
});

// 唯一的时钟：按键轮询 / 翻页 + 攒批落盘（SetThink 只注册一次，用 SetNextThink 排下一次）
Instance.SetThink(() => {
	const now = Instance.GetGameTime();

	// ★ 先结算数据、再渲染：跨月清零就发生在这里，
	//   放在面板之前就不会出现「本 tick 已经清零、面板还是上个月」的一帧延迟。
	// 跨月检查：服务器可能连开一个月不重启，所以运行中也要查
	//（每月 1 日 0 点北京时间那一刻起，最迟 MONTH_CHECK_INTERVAL 秒内清零本月榜）
	if (MONTHLY_RESET && now - lastMonthCheckAt >= MONTH_CHECK_INTERVAL) {
		lastMonthCheckAt = now;
		ensureMonth();
	}

	const layout = GetLayout();
	if (layout) {
		if (boardDirty) {
			PushBoardGlobals(layout);
		}
		if (REQUIRE_HOLD_KEYS || forceBoard !== null) {
			UpdateBoardVisibility(layout);
		}
	}

	if (dirty && now >= pendingFlushAt) {
		flush(false);
		if (dirty) {
			// 写失败（例如存档超过 sv_workshop_map_save_data_max_filesize_mb）：
			// 退避 FLUSH_RETRY 秒再试，别每 tick 都撞一次盘
			pendingFlushAt = now + FLUSH_RETRY;
		}
	}

	Instance.SetNextThink(Instance.GetGameTime() + TICK_INTERVAL);
});

// 终点触发区
Instance.OnScriptInput(ENDZONE_INPUT, (inputData) => {
	if (ENDZONE_AWARD_ALL_ALIVE) {
		recordAllAlive(ENDZONE_INPUT);
		return;
	}
	const controller = controllerFromInput(inputData);
	if (controller) {
		if (!passesTeamFilter(controller)) {
			Log(`${ENDZONE_INPUT} 触发者不是第 ${ENDZONE_TEAM} 队，不计（ENDZONE_TEAM = -1 可关掉队伍过滤）`);
			return;
		}
		record(controller, ENDZONE_INPUT);
		return;
	}
	Log(`${ENDZONE_INPUT} 拿不到 activator（把终点 trigger 的 OnStartTouch 直接连到本实体）`);
});

// 手动控制
Instance.OnScriptInput("progress_flush", () => {
	flush(true);
});
Instance.OnScriptInput("progress_dump", () => {
	Log(`${mapKey} = ${JSON.stringify(mapData)}`);
});
Instance.OnScriptInput("progress_reset", () => {
	mapData = { v: SAVE_VERSION, total: 0, players: {} };
	boardVersion++;
	boardDirty = true;
	markDirty();
	Log(`已清空 ${mapKey} 的统计`);
});
Instance.OnScriptInput("progress_show", () => {
	forceBoard = true;
});
Instance.OnScriptInput("progress_hide", () => {
	forceBoard = false;
});
Instance.OnScriptInput("progress_auto", () => {
	forceBoard = null;
});

// 手动清零本月榜（Hammer 连线，或服务器控制台 ent_fire progress_1 RunScriptInput progress_reset_month）
Instance.OnScriptInput("progress_reset_month", () => {
	resetMonthly("progress_reset_month");
});

// 新回合：清空「本回合已记过」的名单（顺便把攒着的数据写掉）
Instance.OnBeginRoundRestart(() => {
	awardedThisRound.clear();
	if (dirty) {
		flush(false);
	}
});

Instance.OnRoundStart(() => {
	awardedThisRound.clear();
});

// 聊天指令：!top / !progress / !rank —— 给自己开几秒排行榜
// （给不愿意改按键绑定的人，以及已经死了在观战、按键读不到的人用）
if (CHAT_COMMAND_ENABLED) {
	Instance.OnPlayerChat((event) => {
		if (!event || !event.player || !event.text) {
			return;
		}
		const text = String(event.text).trim().toLowerCase();
		if (text !== "!top" && text !== "!progress" && text !== "!rank") {
			return;
		}
		if (!isHuman(event.player)) {
			return;
		}
		const slot = event.player.GetPlayerSlot();
		chatUntil[slot] = Instance.GetGameTime() + CHAT_SHOW_SECONDS;
		Log(`${event.player.GetPlayerName()} 用聊天打开了排行榜（${CHAT_SHOW_SECONDS} 秒）`);
	});
}

// 新玩家进来时清掉该 slot 的历史覆盖（面板显隐 / 页码都是按 slot 存的）
Instance.OnPlayerActivate((event) => {
	if (event && event.player) {
		ResetSlot(event.player.GetPlayerSlot());
	}
});

Instance.OnPlayerDisconnect((event) => {
	if (event) {
		delete boardVisible[event.playerSlot];
		delete chatUntil[event.playerSlot];
		delete boardPage[event.playerSlot];
		delete pageKeyWasDown[event.playerSlot];
	}
	if (dirty) {
		flush(false);
	}
});

// ============================================================================
//  八、控制台测试指令（需 sv_cheats 1）
// ============================================================================

Instance.RegisterCheatCommand("progress_test_show", () => {
	forceBoard = true;
	Log("强制显示排行榜");
});

Instance.RegisterCheatCommand("progress_test_hide", () => {
	forceBoard = false;
	Log("强制隐藏排行榜");
});

Instance.RegisterCheatCommand("progress_test_auto", () => {
	forceBoard = null;
	Log("排行榜恢复为按键控制");
});

Instance.RegisterCheatCommand("progress_test_give_all", () => {
	for (const controller of Instance.GetAllPlayerControllers()) {
		if (isHuman(controller)) {
			record(controller, "测试");
		}
	}
});

Instance.RegisterCheatCommand("progress_test_dump", () => {
	const layout = GetLayout();
	Log(`map=${mapKey} dirty=${dirty} layout=${layout ? "OK" : "缺失"} size≈${JSON.stringify(mapData).length} 字节`);
	Log(JSON.stringify(mapData));
});

// 看榜：翻页 / 直接跳到第 N 页（不开键盘也能测）
Instance.RegisterCheatCommand("progress_test_page", (args) => {
	const n = Math.max(1, parseInt(String(args || "1").trim(), 10) || 1);
	const layout = GetLayout();
	forceBoard = true;
	let touched = 0;
	for (const controller of Instance.GetAllPlayerControllers()) {
		if (!isHuman(controller)) {
			continue;
		}
		const slot = controller.GetPlayerSlot();
		boardPage[slot] = n - 1;
		if (layout) {
			PushRowsFor(layout, controller, slot);
		}
		touched++;
	}
	Log(`排行榜跳到第 ${n} 页（共 ${pageCount()} 页），刷新了 ${touched} 名玩家`);
});

Instance.RegisterCheatCommand("progress_test_flush", () => {
	flush(true);
	Log(`强制落盘完成，dirty=${dirty}`);
});

Instance.RegisterCheatCommand("progress_test_reset", () => {
	mapData = { v: SAVE_VERSION, total: 0, month: "", players: {} };
	boardVersion++;
	boardDirty = true;
	awardedThisRound.clear();
	markDirty();
	flush(true);
	Log("已清空本图统计并落盘");
});

// 墙钟诊断：Date 能不能用、北京时间是多少、存档里记的期号是什么
Instance.RegisterCheatCommand("progress_test_clock", () => {
	Log(`墙钟可用=${clockAvailable()}  北京时间=${beijingText()}  本月键=${currentMonthKey() || "(无)"}`);
	Log(`服务器时区偏移=${clockOk ? new Date().getTimezoneOffset() : "?"} 分钟（不影响本月判定：用的是 UTC+${BEIJING_UTC_OFFSET_HOURS} 换算）`);
	Log(`存档里记的期号=${mapData.month || "(空，尚未写入)"}  本月榜开关 MONTHLY_RESET=${MONTHLY_RESET}  每页 ${ROWS_BLOCKS} 人 / 共 ${pageCount()} 页`);
});

// 手动清零本月榜（等价于 RunScriptInput: progress_reset_month）
Instance.RegisterCheatCommand("progress_test_reset_month", () => {
	resetMonthly("progress_test_reset_month");
});

Instance.RegisterCheatCommand("progress_test_blob", () => {
	const raw = Instance.GetSaveData();
	Log(`存档原文（${raw.length} 字节）：${raw}`);
});
