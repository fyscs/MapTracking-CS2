/* Generated by StarDance */
/* https://github.com/Kxnrl */

.LyricsRoot {
    width: 100%;
    height: 100%;
    flow-children: down;
}
#lyrics_spacer {
    width: 100%;
    height: fill-parent-flow( 1.0 );
}
#lyrics_bar {
    width: 86%;
    horizontal-align: center;
    margin-bottom: 130px;
    transition-property: opacity;
    transition-duration: .25s;
    opacity: 1;
}
#lyrics_bar.Hidden {
    opacity: 0;
}
#lyrics_line {
    width: 100%;
    flow-children: down;
    transition-property: opacity, transform;
    transition-duration: .22s;
    transition-timing-function: ease-out;
    opacity: 1;
    transform: translate3d( 0px, 0px, 0px );
}
#lyrics_line.LineIn {
    opacity: 0;
    transform: translate3d( 0px, 10px, 0px );
}
.LyricsCurrent {
    width: 100%;
    text-align: center;
    font-family: "Noto Sans SC";
    font-size: 34px;
    font-weight: bold;
    color: gradient( linear, 0% 0%, 0% 100%, from( #9FD4FF ), to( #FFFFFF ) );
    text-shadow: 2px 2px 8px 6.0 #000000FF;
    text-overflow: shrink;
}
#lyrics_line.Star .LyricsCurrent {
    color: #FFD23FFF;
}
#lyrics_line.Star .LyricsOriginal {
    color: #FFE08AC0;
}
.LyricsOriginal {
    width: 100%;
    text-align: center;
    font-family: "Noto Sans JP";
    font-size: 22px;
    font-weight: normal;
    color: #D8ECFFB0;
    text-shadow: 2px 2px 6px 5.0 #000000FF;
    margin-top: 4px;
    text-overflow: shrink;
}
.LyricsProgressTrack {
    flow-children: right;
    width: fit-children;
    height: 10px;
    horizontal-align: center;
    margin-top: 12px;
    transition-property: opacity;
    transition-duration: .2s;
    opacity: 1;
}
.LyricsProgressTrack.Hidden {
    opacity: 0;
}
.LyricsProgressUnit {
    width: 26px;
    height: 10px;
    margin-right: 4px;
    background-color: #FFFFFF26;
    border-radius: 1px;
    transform: skewx( -20deg );
    transition-property: background-color;
    transition-duration: .25s;
}
.LyricsProgressUnit.On {
    background-color: #BFE4FFFF;
}
