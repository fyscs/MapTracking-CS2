.ReviveRoot {
    width: 100%;
    height: 100%;
}
.ReviveTip {
    horizontal-align: center;
    text-align: center;
    margin-top: 96px;
    font-family: "Noto Sans SC";
    font-weight: bold;
    font-size: 26px;
    letter-spacing: 2px;
    color: #FFFFFFFF;
    text-shadow: 1px 1px 4px 2 #000000FF;
    text-shadow: 0px 0px 14px 3px #7FD8FF99;
    transition-property: opacity;
    transition-duration: 0.25s;
    opacity: 1;
}
.ReviveTip.Hidden {
    opacity: 0;
}
