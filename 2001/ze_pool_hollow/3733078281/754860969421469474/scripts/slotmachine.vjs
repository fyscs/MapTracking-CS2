import { Instance } from "cs_script/point_script";
// by wolfkk(STEAM_0:1:865131329)

const MODEL_NAME = "slotmachine_model";
const ROLLING_ANIM = "slotmachine_rolling";
const RESULT_DELAY = 2.0;
const COOLDOWN = 6.7;

const RESULTS = [
    { anim: "slotmachine_death", fireUser: "FireUser1" },
    { anim: "slotmachine_luck", fireUser: "FireUser3" },
    { anim: "slotmachine_sun", fireUser: "FireUser2" },
];

let busyUntil = 0;

function EntFire(name, input, value, delay, activator, caller) {
    Instance.EntFireAtName({
        name: name,
        input: input,
        value: value,
        delay: delay,
        activator: activator,
        caller: caller,
    });
}

function PickResult() {
    return RESULTS[Math.floor(Math.random() * RESULTS.length)];
}

Instance.OnBeginRoundRestart(() => {
    busyUntil = 0;
});

Instance.OnScriptInput("slotmachine_start", (data) => {
    const now = Instance.GetGameTime();
    if (busyUntil > now) {
        return;
    }

    const activator = data?.activator;
    // 判空：确保触发实体存在，避免非玩家触发时报错
    if (!activator) return;

    // ========== 新增：对触发玩家造成10点伤害 ==========
    activator.TakeDamage({
        damage: 10,
        damageFlags: CSDamageFlags.SUPPRESS_DAMAGE_MODIFICATION
    });
    // ==================================================

    busyUntil = now + COOLDOWN;

    EntFire(MODEL_NAME, "SetAnimationNotLooping", ROLLING_ANIM, 0, activator);

    Instance.Delay(RESULT_DELAY).then(() => {
        const result = PickResult();
        EntFire(MODEL_NAME, "SetAnimationNotLooping", result.anim, 0, activator);
        EntFire(MODEL_NAME, result.fireUser, undefined, 0, activator);
    });
});
