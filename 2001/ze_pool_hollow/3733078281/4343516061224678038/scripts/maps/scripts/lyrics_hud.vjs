const CUR_PANEL = "lyrics_current";
const ORIG_PANEL = "lyrics_original";
const LINE_PANEL = "lyrics_line";
const BAR_PANEL = "lyrics_bar";
const HIDDEN_CLASS = "Hidden";

/** 换行入场动画用的类：挂上它是「起点态」（透明 + 下移），摘掉它过渡回正常 */
const LINE_IN_CLASS = "LineIn";

/**
 * 「含 star 的句子」标记类：挂上后整行改成黄色（见 lyrics.css）。
 * 判定看英文原文的 star 或中文的 星 —— 歌词里 Shooting Star / 流星 都会命中。
 * 注意 Panorama 的 Label 只能有一种颜色，没法只染单词，所以是整行染色。
 */
const STAR_CLASS = "Star";

/**
 * 挂类与摘类之间必须跨过的 tick。
 * 实测：0.03 秒太短，客户端看不到起点态，过渡不会发生；0.8 秒肯定可以。
 * 0.2 秒是折中值 —— 它同时也是每句的提前量，所以越大越"早退场"。
 */
const LINE_IN_TICK = 0.2;

/**
 * 同一时间戳挤了多句时，摊开用的时间窗（秒）。
 * 只在「那一组是最后一句、后面没有时间点可参照」时才用到。
 */
const SPREAD_FALLBACK = 1.5;

/**
 * 进度条：副歌段里歌词收起后，用一排平行四边形单元表示「离下一句还有多远」。
 *
 * 服务端只能改文本和翻类名、不能下发数值，所以进度只能靠「点亮第几个单位」表达：
 * 每个单位一个 id（lyrics_unit_1 … lyrics_unit_N），脚本逐个挂 On 类点亮。
 * 单位个数 = 进度分辨率，必须与 XML 里的单位面板数量一致（校验器会核对）。
 */
const PROGRESS_TRACK_PANEL = "lyrics_progress_track";
const PROGRESS_UNIT_PREFIX = "lyrics_unit_";
const PROGRESS_UNITS = 20;
const PROGRESS_ON_CLASS = "On";

/** 单位点亮时的过渡秒数（必须与 CSS 里 .LyricsProgressUnit 的数值一致） */
const PROGRESS_STEP_SEC = 0.25;

/**
 * 副歌 / 间奏段（秒，时间轴与 LRC 相同，不需要再加 TIME_OFFSET）。
 *
 * 这段时间里只显示进度条、不显示歌词。起点决定那句歌词的待遇：
 *   · 起点**晚于**那句歌词的时间（例如 [14, 40]）→ 歌词先正常显示，到起点再收起、换成进度条
 *   · 起点**不晚于**那句歌词的时间（例如 [10, 40]）→ 那句歌词整个不显示，只推进度条
 * 区间结束后，下一句歌词照常显示。
 */
const INSTRUMENTAL = [];

/** 这个时刻是否落在某个副歌/间奏段里（判断某句歌词是否被整段吞掉） */
function InstrumentalWindowAt(time) {
	for (const w of INSTRUMENTAL) {
		if (time >= w[0] && time < w[1]) {
			return { start: w[0], end: w[1] };
		}
	}
	return null;
}

/** 与 [fromTime, toTime) 有交集的副歌/间奏段（判断一句歌词中途要不要换成进度条） */
function InstrumentalWindowIn(fromTime, toTime) {
	for (const w of INSTRUMENTAL) {
		if (w[1] > fromTime && w[0] < toTime) {
			return { start: w[0], end: w[1] };
		}
	}
	return null;
}

/** 第 1 首 + EXTRA_SONGS 归一化后的歌曲表 */
const SONGS = [
	{ id: 1, music: MUSIC_NAME, lrc: LRC, zh: ZH, offset: TIME_OFFSET },
	...EXTRA_SONGS.map((song, index) => ({
		id: song.id ?? index + 2,
		music: song.music,
		lrc: song.lrc ?? "",
		zh: song.zh ?? "",
		offset: song.offset ?? 0,
	})),
];

/** 第 1 首沿用 lyrics_start，其余是 lyrics_start_<id> */
function InputNameForSong(song) {
	return song.id === 1 ? START_INPUT : `${START_INPUT}_${song.id}`;
}

/** 每次启动/停止都自增，用来作废仍在 await 中的旧时间轴 */
let runToken = 0;

/** 当前正在播的歌曲，stop 时据此决定停哪个音源 */
let activeSong = null;

let cachedLayout;

function Log(msg) {
	Instance.Msg(`[lyrics] ${msg}`);
}

// 启动时检查一遍 id 是否重复：重复的话触发参数会互相覆盖，属于难查的配置错误
{
	const seen = new Set();
	for (const song of SONGS) {
		const name = InputNameForSong(song);
		if (seen.has(name)) {
			Log(`歌曲 id 重复，RunScriptInput 参数 "${name}" 会被覆盖，请检查 EXTRA_SONGS`);
		}
		seen.add(name);
	}
}

/**
 * 取到 custom_hud_layout 实体（实体被删除或换图后会重新查找）。
 *
 * ⚠ 不能直接拿 found[0]：同名实体可能不止一个（比如 point_script 也叫 lyrics_hud，
 *   或者图里留了个旧的同名实体），拿到非 HUD 实体后调 SetHasClass 会抛
 *   "layout.SetHasClass is not a function" 并且整段脚本停掉。
 *   这里用「有没有 SetHasClass 这个能力」来挑，不猜引擎类名；挑不到就把
 *   找到的实体类名打出来，方便一眼看出名字指到了谁。
 */
function GetLayout() {
	if (cachedLayout && cachedLayout.IsValid() && typeof cachedLayout.SetHasClass === "function") {
		return cachedLayout;
	}
	const found = Instance.FindEntitiesByName(HUD_NAME);
	const usable = found.filter((e) => e && typeof e.SetHasClass === "function");
	if (found.length > 0 && usable.length === 0) {
		const names = found.map((e) => {
			const cls = typeof e.GetClassName === "function" ? e.GetClassName() : "?";
			const nm = typeof e.GetEntityName === "function" ? e.GetEntityName() : "?";
			return `${cls}:${nm}`;
		}).join(", ");
		Log(`按名字 "${HUD_NAME}" 找到 ${found.length} 个实体，但都不是 custom_hud_layout（${names}）`);
	}
	cachedLayout = usable.length > 0 ? usable[0] : undefined;
	return cachedLayout;
}

function SetBarVisible(visible) {
	const layout = GetLayout();
	if (!layout) {
		return false;
	}
	layout.SetHasClass(BAR_PANEL, HIDDEN_CLASS, !visible);
	if (!visible) {
		HideProgress(layout);
	}
	return true;
}

/**
 * 写入当前这一行（中文主行 + 日文次行），并触发一次入场动画（淡入 + 上浮）。
 *
 * 用 transition 而不是 @keyframes：@keyframes 那套在客户端解析时报错（整张样式表被拒），
 * 而 transition / opacity 这套已验证可用。动画类挂在双语容器上，两行一起动。
 *
 * 时序很关键：挂类 → 跨一个 tick → 换文本 → 摘类（过渡回可见归位）。
 * 中间那个 tick 不能省，否则挂和摘发生在同一帧，客户端看不到起点态，就不会有过渡。
 *
 * ⚠ 跨完那个 tick 之后要再查一次 token：stop / 切歌 / 回合重启正好落在这 0.2 秒里时，
 *    不能再把这一行的文本写上去（否则会出现「停了以后还冒出一句」）。
 */
/** 这句要不要标黄 */
function IsStarLine(zh, ja) {
	return /star/i.test(String(ja)) || /星/.test(String(zh));
}

async function WriteCurrentLine(layout, zh, ja, token) {
	layout.SetHasClass(LINE_PANEL, LINE_IN_CLASS, true);          // 起点态：旧字开始淡出并下移
	await Instance.Delay(LINE_IN_TICK);                          // 跨帧，让起点态真正生效
	if (token !== undefined && token !== runToken) {
		return;
	}
	layout.SetDialogVariableString(CUR_PANEL, "current", zh);    // 此刻几乎不可见，换字看不出来
	layout.SetDialogVariableString(ORIG_PANEL, "original", ja);
	layout.SetHasClass(LINE_PANEL, STAR_CLASS, IsStarLine(zh, ja));   // 含 star/星 → 整行黄色
	layout.SetHasClass(LINE_PANEL, LINE_IN_CLASS, false);        // 过渡回可见归位 → 淡入 + 上浮
}

/** 当前已点亮的单位个数 */
let progressUnits = 0;

/**
 * 把进度设成「点亮前 filled 个单位」。
 * 只翻与实际变化相关的那些单位，不整排重刷。
 */
function SetProgress(layout, filled) {
	const target = Math.max(0, Math.min(PROGRESS_UNITS, filled));
	while (progressUnits < target) {
		progressUnits++;
		layout.SetHasClass(PROGRESS_UNIT_PREFIX + progressUnits, PROGRESS_ON_CLASS, true);
	}
	while (progressUnits > target) {
		layout.SetHasClass(PROGRESS_UNIT_PREFIX + progressUnits, PROGRESS_ON_CLASS, false);
		progressUnits--;
	}
}

/** 进度条归零（全部熄灭），并收起整条 */
function HideProgress(layout) {
	ClearProgress(layout);
	layout.SetHasClass(PROGRESS_TRACK_PANEL, HIDDEN_CLASS, true);
}

/** 只把已点亮的单位熄灭，整条的显示与否不动 */
function ClearProgress(layout) {
	while (progressUnits > 0) {
		layout.SetHasClass(PROGRESS_UNIT_PREFIX + progressUnits, PROGRESS_ON_CLASS, false);
		progressUnits--;
	}
}

/**
 * 把这 `seconds` 秒走完：每次点亮相隔 1/PROGRESS_UNITS 的一个单位，走完自己收起整条。
 * 整条的「显示」由调用方负责 —— 要在淡出歌词之前就显示出来，两者才叠得上。
 * 走到一半被 stop / 切歌打断时直接返回（token 已失效，整条由 stop 那条路收）。
 */
async function RunProgress(layout, seconds, token) {
	ClearProgress(layout);

	if (seconds > 0) {
		const step = seconds / PROGRESS_UNITS;

		for (let s = 1; s <= PROGRESS_UNITS; s++) {
			await Instance.Delay(step);
			if (token !== runToken) {
				return;
			}
			SetProgress(layout, s);
		}
	}

	layout.SetHasClass(PROGRESS_TRACK_PANEL, HIDDEN_CLASS, true);
	ClearProgress(layout);
}

/**
 * 解析 LRC。返回按时间升序的 { time, text } 数组。
 */
function ParseLrc(text) {
	const out = [];
	const stampRe = /\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;

	for (const rawLine of String(text).split(/\r?\n/)) {
		stampRe.lastIndex = 0;
		const times = [];
		let m;
		while ((m = stampRe.exec(rawLine)) !== null) {
			const minutes = parseInt(m[1], 10);
			const seconds = parseInt(m[2], 10);
			const fracText = m[3] || "0";
			const frac = parseInt(fracText, 10) / Math.pow(10, fracText.length);
			times.push(minutes * 60 + seconds + frac);
		}

		const body = rawLine.replace(stampRe, "").trim();
		if (times.length === 0 || body === "") {
			continue;
		}
		for (const t of times) {
			out.push({ time: t, text: body });
		}
	}

	out.sort((a, b) => a.time - b.time);
	return out;
}

/**
 * 摊开「同一时间戳挤了多句」的情况。
 *
 * 有些 LRC 会把一句话拆成两条、给了完全相同的时间戳；照原样播的话，
 * 前一句只会显示一个入场 tick（0.2 秒）就被后一句顶掉，看起来像故障。
 * 这里把同一时刻的连续若干句，在「到下一句之前」的时间窗里均分；
 * 如果这组已经是最后一句（后面没有时间点可参照），就按 SPREAD_FALLBACK 撑开。
 */
function SpreadSameTimestamp(lines) {
	const out = [];
	let i = 0;
	while (i < lines.length) {
		let j = i;
		while (j + 1 < lines.length && lines[j + 1].time === lines[i].time) {
			j++;
		}
		const runLength = j - i + 1;
		if (runLength === 1) {
			out.push(lines[i]);
			i++;
			continue;
		}
		const start = lines[i].time;
		const nextStart = j + 1 < lines.length
			? lines[j + 1].time
			: start + SPREAD_FALLBACK * runLength;
		const step = (nextStart - start) / runLength;
		for (let k = 0; k < runLength; k++) {
			out.push({ time: start + step * k, text: lines[i + k].text });
		}
		i = j + 1;
	}
	return out;
}

/**
 * 把一首歌的日语时间轴与中文译文配成 { time, zh, ja } 数组。
 * 中文按行对应；数量不一致时报警，并只取两者中较短的长度，避免串行。
 */
function BuildPairs(song) {
	const ja = SpreadSameTimestamp(ParseLrc(song.lrc));
	const zh = String(song.zh || "")
		.split(/\r?\n/)
		.map((s) => s.trim())
		.filter((s) => s !== "");

	if (zh.length !== ja.length) {
		Log(`第 ${song.id} 首：日文 ${ja.length} 行、中文 ${zh.length} 行，数量不一致；只播前 ${Math.min(ja.length, zh.length)} 句`);
	}

	const n = Math.min(ja.length, zh.length);
	const out = [];
	for (let i = 0; i < n; i++) {
		out.push({ time: ja[i].time, zh: zh[i], ja: ja[i].text });
	}
	return out;
}

/**
 * 播放某一首。不传参数时播第 1 首 —— 这样旧的接线（lyrics_start）行为完全不变。
 * 也可用控制台指令 lyrics_test_start / lyrics_test_start_<id> 触发。
 */
async function StartLyrics(song = SONGS[0]) {
	if (!song) {
		Log("没有可播放的歌曲配置");
		return;
	}

	const lines = BuildPairs(song);
	if (lines.length === 0) {
		Log(`第 ${song.id} 首没能配出任何双语歌词行，检查 LRC 时间标签与中文行数`);
		return;
	}

	const layout = GetLayout();
	if (!layout) {
		Log(`找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
		return;
	}

	const token = ++runToken;
	activeSong = song;

	if (TRIGGER_MUSIC && song.music) {
		// 找不到音源时给一句明确的话：否则 EntFireAtName 会静默失败，
		// 你会看到"歌词在走但没声音"，却不知道为什么
		if (Instance.FindEntitiesByName(song.music).length === 0) {
			Log(`没找到名为 "${song.music}" 的 ambient_generic —— 这次只放歌词，不放音乐`);
		} else {
			Instance.EntFireAtName({ name: song.music, input: "PlaySound" });
		}
	}

	layout.SetHasClass(LINE_PANEL, LINE_IN_CLASS, false);
	layout.SetDialogVariableString(CUR_PANEL, "current", "");
	layout.SetDialogVariableString(ORIG_PANEL, "original", "");
	HideProgress(layout);
	layout.SetHasClass(BAR_PANEL, HIDDEN_CLASS, false);

	Log(`开始播放第 ${song.id} 首歌词（音源 ${song.music ?? "未设置"}），共 ${lines.length} 行`);

	const t0 = Instance.GetGameTime();

	for (let i = 0; i < lines.length; i++) {
		// 提前一个 tick 起跑：这样「摘类开始淡入」正好落在 LRC 的时间点上。
		// 第一行没有提前量可用（时间轴从 0 开始），它会晚 LINE_IN_TICK 出现。
		const appear = lines[i].time + song.offset;
		const elapsed = Instance.GetGameTime() - t0;
		const remain = appear - LINE_IN_TICK - elapsed;
		if (remain > 0) {
			await Instance.Delay(remain);
		}

		// 被 stop、被另一首覆盖、或脚本重载时退出
		if (token !== runToken) {
			return;
		}

		// 这一句的显示区间 = 本句时间 → 下一句时间；副歌段可能落在中间
		const nextSongTime = i + 1 < lines.length ? lines[i + 1].time : lines[i].time + END_HOLD;
		const nextAppear = i + 1 < lines.length ? lines[i + 1].time + song.offset : appear + END_HOLD;
		const window = InstrumentalWindowIn(lines[i].time, nextSongTime);
		const swallowed = InstrumentalWindowAt(lines[i].time);

		if (swallowed) {
			// 整句都被副歌段吞掉：不写歌词，直接把进度条推满到这一段结束。
			layout.SetHasClass(PROGRESS_TRACK_PANEL, HIDDEN_CLASS, false);
			await WriteCurrentLine(layout, "", "", token);
		} else {
			// 正常显示这句歌词（中文行左右各加装饰符）
			await WriteCurrentLine(layout, ZH_PREFIX + lines[i].zh + ZH_SUFFIX, lines[i].ja, token);
		}
		if (token !== runToken) {
			return;
		}

		if (window) {
			// 歌词先显示一段时间，到副歌段起点再收起、换成进度条。
			// 结束点还要夹一次「下一句的起点」并留出提前量，
			// 这样即使副歌段划得比下一句还长，也绝不会把下一句挤晚。
			const startAt = Math.max(window.start + song.offset, appear);
			const waitFor = startAt - (Instance.GetGameTime() - t0);
			if (waitFor > 0) {
				await Instance.Delay(waitFor);
			}
			if (token !== runToken) {
				return;
			}

			if (!swallowed) {
				layout.SetHasClass(PROGRESS_TRACK_PANEL, HIDDEN_CLASS, false);
				await WriteCurrentLine(layout, "", "", token);   // 收起歌词，走同一个淡出动画
				if (token !== runToken) {
					return;
				}
			}

			const windowEnd = Math.min(window.end + song.offset, nextAppear);
			const runFor = (windowEnd - LINE_IN_TICK) - (Instance.GetGameTime() - t0);
			await RunProgress(layout, runFor, token);
			if (token !== runToken) {
				return;
			}
		}
	}

	if (END_HOLD > 0) {
		await Instance.Delay(END_HOLD);
	}
	if (token !== runToken) {
		return;
	}

	Log(`第 ${song.id} 首歌词播放结束`);
	SetBarVisible(false);
}

/** 停歌词（可选连音乐一起停） */
function StopLyrics() {
	runToken++;
	SetBarVisible(false);
	if (STOP_MUSIC_ON_STOP && TRIGGER_MUSIC && activeSong && activeSong.music) {
		Instance.EntFireAtName({ name: activeSong.music, input: "StopSound" });
	}
	activeSong = null;
}

/**
 * 诊断用：把一行固定文字显示出来，不播音乐、不读 LRC，PING_HOLD 秒后自动隐藏。
 * 如果连它都不出现，问题在 HUD 布局实体 / point_script 接线，而不是歌词时间轴。
 */
async function ShowPing() {
	const layout = GetLayout();
	if (!layout) {
		Log(`ping 失败：找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
		return;
	}

	const token = ++runToken;
	layout.SetHasClass(BAR_PANEL, HIDDEN_CLASS, false);
	await WriteCurrentLine(layout, PING_TEXT, PING_TEXT_SUB, token);
	Log(`ping：要求显示测试文字，${PING_HOLD} 秒后自动隐藏`);

	await Instance.Delay(PING_HOLD);
	if (token !== runToken) {
		return;
	}
	SetBarVisible(false);
	Log("ping：已隐藏");
}

// ============================================================================
//  三、事件接线
// ============================================================================

// 地图加载后先确保歌词条是隐藏的（XML 里已有 Hidden 类，这里是双保险）。
// 此时 custom_hud_layout 可能还没 spawn 完，找不到属正常，不报错；
// 真正的失败诊断在 StartLyrics 里。
Instance.OnActivate(() => {
	SetBarVisible(false);
});

// 由 Hammer 的 logic_relay / trigger 触发 point_script 的 RunScriptInput
for (const song of SONGS) {
	Instance.OnScriptInput(InputNameForSong(song), () => {
		StartLyrics(song);
	});
}
Instance.OnScriptInput(STOP_INPUT, () => {
	StopLyrics();
});
Instance.OnScriptInput(PING_INPUT, () => {
	ShowPing();
});

// 回合重启时整段复位：停歌词 + 按配置停音乐，避免时间轴跨回合继续跑
Instance.OnBeginRoundRestart(() => {
	StopLyrics();
});

// 控制台测试指令：先 sv_cheats 1，再输入 lyrics_test_start[_N] / lyrics_test_stop
for (const song of SONGS) {
	const name = song.id === 1 ? "lyrics_test_start" : `lyrics_test_start_${song.id}`;
	Instance.RegisterCheatCommand(name, () => {
		StartLyrics(song);
	});
}
Instance.RegisterCheatCommand("lyrics_test_stop", () => {
	StopLyrics();
});
Instance.RegisterCheatCommand("lyrics_test_ping", () => {
	ShowPing();
});

// Tools 模式保存脚本会重跑顶层，旧的时间轴协程还在跑，这里让它失效
Instance.OnScriptReload({
	before: () => {
		runToken++;
	},
	after: () => {
		SetBarVisible(false);
	},
});
