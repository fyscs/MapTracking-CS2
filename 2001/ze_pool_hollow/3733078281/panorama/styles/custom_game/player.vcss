.PlayerRoot {
    horizontal-align: right;
    vertical-align: top;
    width: fit-children;
    height: fit-children;
    margin-top: 18px;
    margin-right: 15px;
}
.PlayerCard {
    width: 340px;
    height: 124px;
    background-color: #00000096;
    border: 1px solid #FFFFFF2E;
    border-radius: 4px;
    opacity: 1.0;
    transition: opacity 0.25s linear 0.0s;
}
.PlayerCard.Hidden {
    opacity: 0.0;
}
.PlayerDisc {
    width: 100px;
    height: 100px;
    margin-left: 96px;
    margin-top: 12px;
    background-image: url("s2r://panorama/images/player/disc_png.vtex");
    background-size: 100% 100%;
}
.PlayerCover {
    width: 108px;
    height: 108px;
    margin-left: 6px;
    margin-top: 8px;
    background-image: url("s2r://panorama/images/player/cover_png.vtex");
    background-size: 100% 100%;
    border: 1px solid #FFFFFF59;
}
.PlayerRibbon {
    margin-left: 42px;
    margin-top: 10px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: #000000B4;
    font-family: "Stratum2";
    font-weight: bold;
    font-size: 7px;
    letter-spacing: 0.8px;
    color: #EAF6FFFF;
}
.PlayerTitle {
    margin-left: 208px;
    margin-top: 26px;
    width: 126px;
    font-family: "Stratum2";
    font-weight: bold;
    font-size: 21px;
    color: #FFFFFFFF;
    white-space: nowrap;
    text-overflow: shrink;
}
.PlayerArtist {
    margin-left: 208px;
    margin-top: 56px;
    width: 126px;
    font-family: "Noto Sans SC";
    font-weight: normal;
    font-size: 11px;
    color: #9FD8FFCC;
    white-space: nowrap;
    text-overflow: shrink;
}
.PlayerBars {
    flow-children: right;
    margin-left: 208px;
    margin-top: 80px;
    width: 70px;
    height: 20px;
}
.PlayerBar {
    width: 5px;
    margin-right: 4px;
    vertical-align: bottom;
    background-color: #7FE0FFFF;
    border-radius: 1px;
}
