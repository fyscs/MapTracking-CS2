/* Generated by StarDance */
/* https://github.com/Kxnrl */

.BoardRoot {
    width: 100%;
    height: 100%;
}
.Board {
    width: 300px;
    flow-children: down;
    padding-top: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #0B0F14E6;
    border-radius: 8px;
    z-index: 100;
    horizontal-align: right;
    vertical-align: center;
    margin-right: 16px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: .12s;
}
.Board.Hidden {
    opacity: 0;
}
.BoardTitle {
    width: 276px;
    text-align: center;
    font-family: "Noto Sans SC";
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #FFFFFFFF;
    text-shadow: 1px 1px 6px 3.5 #000000FF;
}
.BoardSep {
    width: 276px;
    height: 2px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: #FFFFFF33;
}
.BoardRows {
    width: 276px;
    flow-children: down;
}
.BoardRow {
    width: 276px;
    height: 23px;
    flow-children: right;
    opacity: 1;
    transition-property: opacity;
    transition-duration: .12s;
}
.BoardRow.Hidden {
    opacity: 0;
}
.RowRank {
    width: 30px;
    font-family: "Noto Sans SC";
    font-size: 15px;
    font-weight: bold;
    color: #FFD469FF;
    text-shadow: 1px 1px 5px 3 #000000FF;
}
.RowName {
    width: 166px;
    font-family: "Noto Sans SC";
    font-size: 15px;
    color: #FFFFFFFF;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 5px 3 #000000FF;
}
.RowCount {
    width: 80px;
    text-align: right;
    font-family: "Noto Sans SC";
    font-size: 15px;
    font-weight: bold;
    color: #9FD4FFFF;
    text-shadow: 1px 1px 5px 3 #000000FF;
}
.BoardEmpty {
    width: 276px;
    text-align: center;
    font-family: "Noto Sans SC";
    font-size: 14px;
    color: #FFFFFFB0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: .12s;
}
.BoardEmpty.Hidden {
    opacity: 0;
}
.BoardPage {
    width: 276px;
    text-align: center;
    font-family: "Noto Sans SC";
    font-size: 13px;
    color: #FFD469CC;
    text-overflow: shrink;
    text-shadow: 1px 1px 4px 3 #000000FF;
}
.BoardMe {
    width: 276px;
    text-align: center;
    font-family: "Noto Sans SC";
    font-size: 13px;
    color: #D8ECFFFF;
    text-overflow: shrink;
    text-shadow: 1px 1px 5px 3 #000000FF;
}
