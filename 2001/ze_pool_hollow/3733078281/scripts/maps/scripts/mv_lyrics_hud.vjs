//  二、锚点与节奏（一般不用改）
// ============================================================================

/** RunScriptInput 的参数名；控制台测试指令是加 test_ 前缀的版本 */
const START_INPUT = "mv_start";
const STOP_INPUT = "mv_stop";
const PING_INPUT = "mv_ping";

const LINE_PANEL = "mv_line";
const PLATE_PANEL = "mv_plate";
const JA_PANEL = "mv_ja";
const ZH_PANEL = "mv_zh";
const VJA_PANELS = ["mv_vja_1", "mv_vja_2", "mv_vja_3"];
/** 阴纹句的中文译文单独一条，固定在屏幕中间下方（不跟着阴纹走，免得盖住日文） */
const ZH_SUB_PANEL = "mv_zh_sub";
const ZH_SUB_VARIABLE = "zhsub";
const HIDDEN_CLASS = "Hidden";
/** 中文译文外面的「括号」：>> 译文 << */
const ZH_PREFIX = ">>";
const ZH_SUFFIX = "<<";

/** 锚点类的公共前缀：Pos1 … Pos12，必须与 mv_lyrics.css 里的类名一致 */
const ANCHOR_PREFIX = "Pos";
const ANCHOR_COUNT = 12;

/** 竖排锚点（黑底金字那个容器），只有 11 / 12 两个 */
const VERTICAL_ANCHORS = [11, 12];

/**
 * 横排锚点的出场顺序。10 个数字是 1…10 的一个排列，
 * 故意打乱，让相邻两句不会落在同一条水平线上；
 * 循环到末尾再从头开始，所以第 11 句会回到锚点 1。
 */
const HORIZONTAL_ORDER = [1, 5, 8, 3, 10, 6, 2, 9, 4, 7];

/**
 * 哪些句子用阴纹（黑底金字）。1 起的行号闭区间，不在区间里的句子走横排锚点。
 *
 * 现在填三段：第 1–9 句（00:25–00:56 前奏+主歌）、第 16–22 句
 * （01:32–01:47 Promise…見せつけてあげるわ）、第 27–30 句（02:22–02:41 第二段主歌）。
 * 其余句子走 10 个横排锚点。
 * 要改段落划分就改这张表，比如只让第一段阴纹就写 [[1, 9]]。
 */
const PLATE_LINES = [[1, 9], [16, 22], [27, 30]];

/**
 * 竖排一句话最多占多少"字宽"。超了就说明放不进一屏，自动退回横排锚点。
 * 单列 30 字宽；最长的那句「Lazy rainy my soulはご機嫌ななめ」按拉丁词折算是 17。
 */
const PLATE_MAX_CHARS = 30;

/**
 * 竖排排成几列。现在是 1 列：一句从上往下排到底，太长就靠缩小字号塞进去
 * （见 PLATE_SIZE_STEPS），不再分列。
 */
const PLATE_COLUMNS = 1;

/**
 * 竖排的字号档位：一行数（单元数）≤15 用默认 40px，超过就降到 30 / 24 / 20px，
 * 保证最长的一句也能一列排完、不顶出屏幕。
 */
const PLATE_SIZE_STEPS = [[15, ""], [20, "SizeS"], [25, "SizeXs"], [30, "SizeXxs"]];
const PLATE_SIZE_CLASSES = ["SizeS", "SizeXs", "SizeXxs"];

/** 一列最多放几个单位（= 竖排之后的行数上限，和 PLATE_MAX_CHARS 同源） */
const PLATE_COL_CHARS = PLATE_MAX_CHARS;

/**
 * 带英文的句子落这个锚点：屏幕中间下方的横排阴纹字幕（黑底金字一行）。
 * 竖排里拉丁词只能整词堆叠，读起来别扭，所以这类句子不走竖排。
 */
const PLATE_FLAT_ANCHOR = 13;

/**
 * 一句最多在屏幕上摆多久（秒）。到点就收起来，下一句再自己淡入。
 * 间奏段落（第 26→27 句之间有 22 秒）不让上一句一直杵在那儿。
 */
const MAX_HOLD_SEC = 5.0;

/** 淡出 → 换锚点换字 → 淡入 之间必须跨过的 tick（秒，与 CSS 的 .3s 过渡配合） */
const FADE_TICK = 0.32;

/** 同一时间戳挤了多句时，摊开用的时间窗（秒） */
const SPREAD_FALLBACK = 1.5;

let runToken = 0;
let cachedLayout;

/** 当前挂着的锚点（0 = 没挂），换句时先摘掉它 */
let shownAnchor = 0;
let shownPanel = "";

/** 锚点类的代次："延迟摘锚点" 用它对消（见 ClearAnchorSoon） */
let anchorEpoch = 0;

/** 锚点轮转的两个游标，每次开场清零 */
let horizontalCursor = 0;
let verticalCursor = 0;

function Log(msg) {
	Instance.Msg(`[mv_lyrics] ${msg}`);
}

/**
 * 取 custom_hud_layout 实体。
 * ⚠ 不能直接拿 found[0]：同名实体可能不止一个（比如 point_script 也叫这个名字），
 *   拿到非 HUD 实体后调 SetHasClass 会抛 layout.SetHasClass is not a function。
 *   这里按「有没有 SetHasClass 这个能力」筛，筛不到就把类名打出来。
 */
function GetLayout() {
	if (cachedLayout && cachedLayout.IsValid() && typeof cachedLayout.SetHasClass === "function") {
		return cachedLayout;
	}
	const found = Instance.FindEntitiesByName(HUD_NAME);
	const usable = found.filter((e) => e && typeof e.SetHasClass === "function");
	if (found.length > 0 && usable.length === 0) {
		const names = found.map((e) => {
			const cls = typeof e.GetClassName === "function" ? e.GetClassName() : "?";
			const nm = typeof e.GetEntityName === "function" ? e.GetEntityName() : "?";
			return `${cls}:${nm}`;
		}).join(", ");
		Log(`按名字 "${HUD_NAME}" 找到 ${found.length} 个实体，但都不是 custom_hud_layout（${names}）`);
	}
	cachedLayout = usable.length > 0 ? usable[0] : undefined;
	return cachedLayout;
}

// ============================================================================
//  三、锚点选择
// ============================================================================

/** 这一句（1 起的行号）该不该用竖排 */
function WantsPlate(lineNo) {
	for (const range of PLATE_LINES) {
		if (lineNo >= range[0] && lineNo <= range[1]) {
			return true;
		}
	}
	return false;
}

/**
 * 竖排的排字单位：汉字/假名一个字算一个单位，连续的拉丁字母算一个整体。
 *
 * 不这么做的话 "Lazy rainy" 会变成 L/a/z/y/r/a/i/n/y 一列竖着的散字母，读不出来；
 * 按词分组之后是 Lazy / rainy / my / soul 这样一行一个词，像正经竖排排版。
 */
function ColumnUnits(ja) {
	const units = [];
	let word = "";
	for (const ch of String(ja)) {
		if (/[A-Za-z0-9]/.test(ch)) {
			word += ch;
			continue;
		}
		if (word !== "") {
			units.push(word);
			word = "";
		}
		if (ch.trim() === "") {
			continue;
		}
		units.push(ch);
	}
	if (word !== "") {
		units.push(word);
	}
	return units;
}

/** 一个单位占几个字宽：拉丁词按每个字母 0.56 字宽算，最少占 2 个字宽 */
function UnitCost(unit) {
	if (/^[A-Za-z0-9]/.test(unit)) {
		return Math.max(2, Math.ceil(unit.length * 0.56));
	}
	return 1;
}

/** 竖排可用吗：所有单位的宽度加起来不超过一屏（3 列 × 10 字宽） */
function CanStackVertically(ja) {
	const units = ColumnUnits(ja);
	if (units.length === 0) {
		return false;
	}
	let used = 0;
	for (const unit of units) {
		used += UnitCost(unit);
	}
	return used <= PLATE_MAX_CHARS;
}

/**
 * 决定这一句挂哪个锚点，并推进游标。
 * 在 PLATE_LINES 里的句子（且放得下）走竖排，两个竖排锚点轮流用；其余走横排。
 */
function NextAnchor(lineIndex, ja) {
	const lineNo = lineIndex + 1;
	if (WantsPlate(lineNo) && CanStackVertically(ja)) {
		// 句子里有英文 → 底部横排阴纹，不去挤竖排（避免把单词拆成一列字母）
		if (HasLatin(ja)) {
			return PLATE_FLAT_ANCHOR;
		}
		const anchor = VERTICAL_ANCHORS[verticalCursor % VERTICAL_ANCHORS.length];
		verticalCursor++;
		return anchor;
	}
	const anchor = HORIZONTAL_ORDER[horizontalCursor % HORIZONTAL_ORDER.length];
	horizontalCursor++;
	return anchor;
}

/**
 * 把一句日文切成竖排的列：一个单位一行，按字宽预算换列。
 * 列依次从左往右排（CSS 的 flow-children: right）。
 */
function BuildColumns(ja) {
	const columns = [];
	let current = [];
	let used = 0;
	for (const unit of ColumnUnits(ja)) {
		const cost = UnitCost(unit);
		if (current.length > 0 && used + cost > PLATE_COL_CHARS) {
			columns.push(current.join("\n"));
			current = [];
			used = 0;
		}
		current.push(unit);
		used += cost;
	}
	if (current.length > 0) {
		columns.push(current.join("\n"));
	}
	return columns;
}

/** 这句竖排该用哪一档字号（"" = 默认 40px 档） */
function PlateSizeClass(ja) {
	const rows = ColumnUnits(ja).length;
	for (const step of PLATE_SIZE_STEPS) {
		if (rows <= step[0]) {
			return step[1];
		}
	}
	return PLATE_SIZE_STEPS[PLATE_SIZE_STEPS.length - 1][1];
}

/** 挂字号档位：三档里只有一档为 true，避免上一句的小字号残留 */
function ApplyPlateSize(layout, sizeClass) {
	for (const cls of PLATE_SIZE_CLASSES) {
		layout.SetHasClass(PLATE_PANEL, cls, cls === sizeClass);
	}
}

/** 这句里有没有拉丁字母（有就不竖排，改走底部横排阴纹） */
function HasLatin(ja) {
	return /[A-Za-z]/.test(ja);
}

function IsVerticalAnchor(anchor) {
	return VERTICAL_ANCHORS.indexOf(anchor) >= 0;
}

/** 摘掉旧锚点、挂上新锚点（同一面板同一个锚点就不动，省两次 SetHasClass） */
function ApplyAnchor(layout, panel, anchor) {
	// 换锚点意味着"这次换位是有意义的"，把还没执行的 ClearAnchorSoon 作废
	anchorEpoch++;

	if (shownAnchor !== 0 && (shownPanel !== panel || shownAnchor !== anchor)) {
		layout.SetHasClass(shownPanel, ANCHOR_PREFIX + shownAnchor, false);
	}
	layout.SetHasClass(panel, ANCHOR_PREFIX + anchor, true);
	shownPanel = panel;
	shownAnchor = anchor;
}

/**
 * 只把两个容器收起来，**不动锚点类**。
 *
 * ⚠ 这里千万不能顺手把 PosN 摘掉：面板一旦没有 PosN，就会回到布局默认的
 *   左上角 (0,0)，而 opacity 的淡出还要走 0.3 秒 —— 于是每句歌词收尾时
 *   都会在左上角闪一下。正确做法是让它原地淡出，等换下一句时再在
 *   「已经完全透明」的那一帧把 PosN 换掉（见 ShowLine / ApplyAnchor）。
 */
function HideAll(layout) {
	layout.SetHasClass(LINE_PANEL, HIDDEN_CLASS, true);
	layout.SetHasClass(PLATE_PANEL, HIDDEN_CLASS, true);
	layout.SetHasClass(ZH_SUB_PANEL, HIDDEN_CLASS, true);
}

/** 淡出已经结束之后再摘锚点类（stop / 播放结束 / 重载 用） */
function ClearAnchorSoon(layout) {
	if (shownAnchor === 0) {
		return;
	}
	const epoch = ++anchorEpoch;
	Instance.Delay(FADE_TICK).then(() => {
		if (epoch !== anchorEpoch || shownAnchor === 0) {
			return;
		}
		layout.SetHasClass(shownPanel, ANCHOR_PREFIX + shownAnchor, false);
		shownAnchor = 0;
		shownPanel = "";
	});
}

// ============================================================================
//  四、显示一句
// ============================================================================

/**
 * 中文一律套一层「>> … <<」，像括号一样把译文框起来。
 * 空串原样返回，避免没译文时冒出孤零零的 >> <<。
 */
function BracketZh(zh) {
	if (!zh) {
		return "";
	}
	return ZH_PREFIX + zh + ZH_SUFFIX;
}

/**
 * 阴纹句的中文译文：写进底部那条固定小字并放出来。
 * 阴纹里只有日文，中文一律走这条，位置写死，所以不管阴纹落在左、右还是底部
 * 都不会被日文盖住。
 */
function ShowZhSub(layout, zh) {
	layout.SetDialogVariableString(ZH_SUB_PANEL, ZH_SUB_VARIABLE, BracketZh(zh));
	layout.SetHasClass(ZH_SUB_PANEL, HIDDEN_CLASS, false);
}

/**
 * 显示一句歌词：淡出旧的 → 换个锚点 → 换字 → 淡入。
 *
 * 时序和普通歌词一样：先收起来，跨一个 tick 再改内容，最后放出来。
 * 中间那个 tick 不能省，否则客户端看不到「收起来」这一帧，换位置会显得生硬。
 * 跨完 tick 之后再查一次 token：stop / 换歌正好落在这 0.22 秒里时不能再写。
 */
async function ShowLine(layout, lineIndex, ja, zh, token) {
	const anchor = NextAnchor(lineIndex, ja);
	const onPlate = IsVerticalAnchor(anchor) || anchor === PLATE_FLAT_ANCHOR;
	const panel = onPlate ? PLATE_PANEL : LINE_PANEL;

	HideAll(layout);
	await Instance.Delay(FADE_TICK);
	if (token !== undefined && token !== runToken) {
		return anchor;
	}

	if (IsVerticalAnchor(anchor)) {
		// 竖排：切成几列，每列一个字一行；没用到的列写空串（空 Label 不占宽度）
		const columns = BuildColumns(ja);
		for (let i = 0; i < VJA_PANELS.length; i++) {
			layout.SetDialogVariableString(VJA_PANELS[i], "vja", columns[i] || "");
		}
		ApplyPlateSize(layout, PlateSizeClass(ja));
		ShowZhSub(layout, zh);
	} else if (anchor === PLATE_FLAT_ANCHOR) {
		// 底部横排：整句原样塞进第一个 Label（不插换行），字号走默认档
		layout.SetDialogVariableString(VJA_PANELS[0], "vja", ja);
		for (let i = 1; i < VJA_PANELS.length; i++) {
			layout.SetDialogVariableString(VJA_PANELS[i], "vja", "");
		}
		ApplyPlateSize(layout, "");
		ShowZhSub(layout, zh);
	} else {
		layout.SetDialogVariableString(JA_PANEL, "ja", ja);
		layout.SetDialogVariableString(ZH_PANEL, "zh", BracketZh(zh));
	}

	ApplyAnchor(layout, panel, anchor);
	layout.SetHasClass(panel, HIDDEN_CLASS, false);
	return anchor;
}

// ============================================================================
//  五、时间轴
// ============================================================================

/** 解析 LRC，返回按时间升序的 { time, text } */
function ParseLrc(text) {
	const out = [];
	const stampRe = /\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;

	for (const rawLine of String(text).split(/\r?\n/)) {
		stampRe.lastIndex = 0;
		const times = [];
		let m;
		while ((m = stampRe.exec(rawLine)) !== null) {
			const minutes = parseInt(m[1], 10);
			const seconds = parseInt(m[2], 10);
			const fracText = m[3] || "0";
			const frac = parseInt(fracText, 10) / Math.pow(10, fracText.length);
			times.push(minutes * 60 + seconds + frac);
		}

		const body = rawLine.replace(stampRe, "").trim();
		if (times.length === 0 || body === "") {
			continue;
		}
		for (const t of times) {
			out.push({ time: t, text: body });
		}
	}

	out.sort((a, b) => a.time - b.time);
	return out;
}

/** 把「同一时间戳挤了多句」在到下一句之前的时间窗里均分 */
function SpreadSameTimestamp(lines) {
	const out = [];
	let i = 0;
	while (i < lines.length) {
		let j = i;
		while (j + 1 < lines.length && lines[j + 1].time === lines[i].time) {
			j++;
		}
		const runLength = j - i + 1;
		if (runLength === 1) {
			out.push(lines[i]);
			i++;
			continue;
		}
		const start = lines[i].time;
		const nextStart = j + 1 < lines.length
			? lines[j + 1].time
			: start + SPREAD_FALLBACK * runLength;
		const step = (nextStart - start) / runLength;
		for (let k = 0; k < runLength; k++) {
			out.push({ time: start + step * k, text: lines[i + k].text });
		}
		i = j + 1;
	}
	return out;
}

/** 日文时间轴 + 中文译文配对；数量不一致时报警并只取较短的那一份 */
function BuildPairs() {
	const ja = SpreadSameTimestamp(ParseLrc(LRC));
	const zh = String(ZH || "")
		.split(/\r?\n/)
		.map((s) => s.trim())
		.filter((s) => s !== "");

	if (zh.length > 0 && zh.length !== ja.length) {
		Log(`日文 ${ja.length} 行、中文 ${zh.length} 行，数量不一致；只播前 ${Math.min(ja.length, zh.length)} 句`);
	}

	const n = zh.length === 0 ? ja.length : Math.min(ja.length, zh.length);
	const out = [];
	for (let i = 0; i < n; i++) {
		out.push({ time: ja[i].time, zh: zh.length === 0 ? "" : zh[i], ja: ja[i].text });
	}
	return out;
}

async function StartLyrics() {
	const lines = BuildPairs();
	if (lines.length === 0) {
		Log("没能解析出任何歌词行，检查 LRC 的时间标签");
		return;
	}

	const layout = GetLayout();
	if (!layout) {
		Log(`找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
		return;
	}

	const token = ++runToken;
	horizontalCursor = 0;
	verticalCursor = 0;

	if (TRIGGER_MUSIC) {
		if (Instance.FindEntitiesByName(MUSIC_NAME).length === 0) {
			Log(`没找到名为 "${MUSIC_NAME}" 的 ambient_generic —— 这次只放歌词，不放音乐`);
		} else {
			Instance.EntFireAtName({ name: MUSIC_NAME, input: "PlaySound" });
		}
	}

	HideAll(layout);
	Log(`开始播放 MV 歌词，共 ${lines.length} 行，锚点 ${ANCHOR_COUNT} 个`);

	const t0 = Instance.GetGameTime();

	for (let i = 0; i < lines.length; i++) {
		// 提前一个 tick 起跑，「放出来」那一刻正好落在 LRC 的时间点上
		const appear = lines[i].time + TIME_OFFSET;
		const elapsed = Instance.GetGameTime() - t0;
		const remain = appear - FADE_TICK - elapsed;
		if (remain > 0) {
			await Instance.Delay(remain);
		}
		if (token !== runToken) {
			return;
		}

		const anchor = await ShowLine(layout, i, lines[i].ja, lines[i].zh, token);
		if (token !== runToken) {
			return;
		}
		Log(`第 ${i + 1} 句 → 锚点 ${anchor}`);

		// 这一句最多摆 MAX_HOLD_SEC；间奏比这长就先收起来，屏幕留空
		const nextTime = i + 1 < lines.length
			? lines[i + 1].time + TIME_OFFSET
			: appear + END_HOLD;
		const nextFadeAt = nextTime - FADE_TICK;
		const holdUntil = Math.min(appear + MAX_HOLD_SEC, nextFadeAt);
		const holdFor = holdUntil - (Instance.GetGameTime() - t0);
		if (holdFor > 0) {
			await Instance.Delay(holdFor);
		}
		if (token !== runToken) {
			return;
		}

		// 提前收起：留给间奏一段空屏。下一句会自己先淡出再换位置，所以这里只收不摘锚点
		if (holdUntil < nextFadeAt) {
			HideAll(layout);
			if (i + 1 < lines.length) {
				const restFor = nextFadeAt - (Instance.GetGameTime() - t0);
				if (restFor > 0) {
					await Instance.Delay(restFor);
				}
				if (token !== runToken) {
					return;
				}
			}
		}
	}

	if (END_HOLD > 0) {
		await Instance.Delay(END_HOLD);
	}
	if (token !== runToken) {
		return;
	}

	Log("MV 歌词播放结束");
	HideAll(layout);
	ClearAnchorSoon(layout);
}

function StopLyrics() {
	runToken++;
	const layout = GetLayout();
	if (layout) {
		HideAll(layout);
		ClearAnchorSoon(layout);
	}
	if (TRIGGER_MUSIC) {
		Instance.EntFireAtName({ name: MUSIC_NAME, input: "StopSound" });
	}
}

/**
 * 诊断用：在指定锚点上显示固定文字，不读 LRC。
 * 连它都不出现的话，问题在 HUD 布局实体 / point_script 接线，不在时间轴。
 */
async function ShowPing(anchor = 7) {
	const layout = GetLayout();
	if (!layout) {
		Log(`ping 失败：找不到名为 "${HUD_NAME}" 的 custom_hud_layout 实体`);
		return;
	}

	const token = ++runToken;
	const vertical = IsVerticalAnchor(anchor);
	const panel = vertical ? PLATE_PANEL : LINE_PANEL;

	HideAll(layout);
	await Instance.Delay(FADE_TICK);
	if (token !== runToken) {
		return;
	}
	if (vertical) {
		const columns = ["テ\nス\nト", "", ""];
		for (let i = 0; i < VJA_PANELS.length; i++) {
			layout.SetDialogVariableString(VJA_PANELS[i], "vja", columns[i] || "");
		}
		ApplyPlateSize(layout, "");
	} else {
		layout.SetDialogVariableString(JA_PANEL, "ja", PING_TEXT);
		layout.SetDialogVariableString(ZH_PANEL, "zh", PING_TEXT_SUB);
	}
	ApplyAnchor(layout, panel, anchor);
	layout.SetHasClass(panel, HIDDEN_CLASS, false);
	Log(`ping：锚点 ${anchor}（${vertical ? "竖排" : "横排"}），${PING_HOLD} 秒后自动隐藏`);

	await Instance.Delay(PING_HOLD);
	if (token !== runToken) {
		return;
	}
	HideAll(layout);
}

// ============================================================================
//  六、播放器卡片（右上角"正在播放"）
//
//  和歌词共用同一个 custom_hud_layout / point_script：
//  歌曲开始时出现，结束时收起；黑胶转圈、音量条跳动都是"预先写好类 + 脚本切"。
// ============================================================================

/** 卡片容器 */
const CARD_PANEL = "player_card";
/** 黑胶面板（转圈的就是它） */
const DISC_PANEL = "player_disc";
/** 封面面板 */
const COVER_PANEL = "player_cover";
/** 三行文字 */
const RIBBON_PANEL = "player_ribbon";
const TITLE_PANEL = "player_title";
const ARTIST_PANEL = "player_artist";
/** 音量条（4 根） */
const BAR_PANELS = ["player_bar_1", "player_bar_2", "player_bar_3", "player_bar_4"];

/** 卡片上的文字。改歌就改这三行。 */
const RIBBON_TEXT = "Original Sound Track";
const TITLE_TEXT = "Awake Now";
const ARTIST_TEXT = "雄之助 feat. 初音ミク";

/** 黑胶转一圈切成多少份（CSS 里就有多少个 RotN 类），以及多久切一次 */
const SPIN_STEPS = 24;
const SPIN_STEP_SEC = 0.06;
const SPIN_CLASS_PREFIX = "Rot";

/** 音量条：每根条子有 4 档高矮，按下面的节奏表循环 */
const EQ_LEVELS = ["Eq1", "Eq2", "Eq3", "Eq4"];
const EQ_STEP_SEC = 0.16;
const BAR_PATTERNS = [
	[1, 3, 2, 4],
	[2, 4, 1, 3],
	[3, 1, 4, 2],
	[4, 2, 3, 1],
];

/** 播放器自己的输入 / 控制台前缀 */
const PLAYER_SHOW_INPUT = "player_show";
const PLAYER_HIDE_INPUT = "player_hide";
const PLAYER_PLAY_INPUT = "player_play";
const PLAYER_PAUSE_INPUT = "player_pause";
const PLAYER_CHEAT_PREFIX = "player_test";

/** 卡片动画的状态：token 每变一次，旧循环自己退出 */
let animToken = 0;
let cardShown = false;
let playing = false;
let spinIndex = 0;
let eqIndex = 0;

function ApplyCardTexts(layout) {
	layout.SetDialogVariableString(TITLE_PANEL, "title", TITLE_TEXT);
	layout.SetDialogVariableString(ARTIST_PANEL, "artist", ARTIST_TEXT);
	layout.SetDialogVariableString(RIBBON_PANEL, "ribbon", RIBBON_TEXT);
}

function ApplyBarLevel(layout, barIndex, level) {
	for (let i = 0; i < EQ_LEVELS.length; i++) {
		layout.SetHasClass(BAR_PANELS[barIndex], EQ_LEVELS[i], i === level - 1);
	}
}

function ResetBars(layout) {
	for (let i = 0; i < BAR_PANELS.length; i++) {
		ApplyBarLevel(layout, i, 1);
	}
}

function ApplySpin(layout, index) {
	for (let i = 0; i < SPIN_STEPS; i++) {
		layout.SetHasClass(DISC_PANEL, SPIN_CLASS_PREFIX + i, i === index);
	}
}

async function SpinLoop(layout, token) {
	while (token === animToken && playing) {
		spinIndex = (spinIndex + 1) % SPIN_STEPS;
		ApplySpin(layout, spinIndex);
		await Instance.Delay(SPIN_STEP_SEC);
	}
}

async function EqLoop(layout, token) {
	while (token === animToken && playing) {
		const pattern = BAR_PATTERNS[eqIndex % BAR_PATTERNS.length];
		for (let i = 0; i < BAR_PANELS.length; i++) {
			ApplyBarLevel(layout, i, pattern[i]);
		}
		eqIndex++;
		await Instance.Delay(EQ_STEP_SEC);
	}
}

function StartCardLoops(layout) {
	animToken++;
	const token = animToken;
	playing = true;
	SpinLoop(layout, token);
	EqLoop(layout, token);
}

function StopCardLoops(layout) {
	animToken++;
	playing = false;
	if (layout) {
		ResetBars(layout);
	}
}

function ShowPlayer() {
	const layout = GetLayout();
	if (!layout) {
		Log("找不到布局实体 " + HUD_NAME + "，播放器卡片没法显示");
		return;
	}
	cardShown = true;
	ApplyCardTexts(layout);
	ApplySpin(layout, spinIndex);
	layout.SetHasClass(CARD_PANEL, HIDDEN_CLASS, false);
	StartCardLoops(layout);
	Log("播放器： " + TITLE_TEXT + " — " + ARTIST_TEXT);
}

function HidePlayer() {
	const layout = GetLayout();
	if (layout) {
		StopCardLoops(layout);
		layout.SetHasClass(CARD_PANEL, HIDDEN_CLASS, true);
	} else {
		animToken++;
		playing = false;
	}
	cardShown = false;
}

function PlayCard() {
	const layout = GetLayout();
	if (!layout) {
		return;
	}
	cardShown = true;
	layout.SetHasClass(CARD_PANEL, HIDDEN_CLASS, false);
	StartCardLoops(layout);
}

function PauseCard() {
	const layout = GetLayout();
	StopCardLoops(layout);
	Log("播放器暂停（黑胶停转，音量条压平）");
}

function ToggleCard() {
	if (cardShown) {
		HidePlayer();
	} else {
		ShowPlayer();
	}
}

// ============================================================================
//  七、事件接线
// ============================================================================

Instance.OnActivate(() => {
	const layout = GetLayout();
	if (layout) {
		HideAll(layout);
		layout.SetHasClass(CARD_PANEL, HIDDEN_CLASS, true);
	}
});

Instance.OnScriptInput(START_INPUT, () => {
	StartLyrics();
	ShowPlayer();
});
Instance.OnScriptInput(STOP_INPUT, () => {
	StopLyrics();
	HidePlayer();
});

// 播放器卡片自己的开关（不进歌词时间轴时也能单独亮着）
Instance.OnScriptInput(PLAYER_SHOW_INPUT, () => {
	ShowPlayer();
});
Instance.OnScriptInput(PLAYER_HIDE_INPUT, () => {
	HidePlayer();
});
Instance.OnScriptInput(PLAYER_PLAY_INPUT, () => {
	PlayCard();
});
Instance.OnScriptInput(PLAYER_PAUSE_INPUT, () => {
	PauseCard();
});
Instance.OnScriptInput(PING_INPUT, () => {
	ShowPing(7);
});

Instance.OnBeginRoundRestart(() => {
	StopLyrics();
	HidePlayer();
});

Instance.RegisterCheatCommand("mv_test_start", () => {
	StartLyrics();
	ShowPlayer();
});
Instance.RegisterCheatCommand("mv_test_stop", () => {
	StopLyrics();
	HidePlayer();
});
Instance.RegisterCheatCommand("mv_test_ping", () => {
	ShowPing(7);
});

// 逐个锚点的测试指令：mv_test_anchor_1 … mv_test_anchor_12
for (let a = 1; a <= ANCHOR_COUNT; a++) {
	Instance.RegisterCheatCommand(`mv_test_anchor_${a}`, () => {
		ShowPing(a);
	});
}

// 播放器卡片的控制台命令
Instance.RegisterCheatCommand(PLAYER_CHEAT_PREFIX + "_show", () => {
	ShowPlayer();
});
Instance.RegisterCheatCommand(PLAYER_CHEAT_PREFIX + "_hide", () => {
	HidePlayer();
});
Instance.RegisterCheatCommand(PLAYER_CHEAT_PREFIX + "_toggle", () => {
	ToggleCard();
});

Instance.OnScriptReload({
	before: () => {
		runToken++;
		animToken++;
		playing = false;
	},
	after: () => {
		const layout = GetLayout();
		if (layout) {
			HideAll(layout);
			ClearAnchorSoon(layout);
			ResetBars(layout);
			layout.SetHasClass(CARD_PANEL, HIDDEN_CLASS, true);
		}
	},
});
