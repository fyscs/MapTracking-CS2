// Generated by StarDance
// https://github.com/Kxnrl

// ============================================================================
//  revive_speed.js —— 复活币加速（backroom 项目）
//
//  规则：
//    僵尸（T）在**局中**转成 CT 时，给他
//      · 前 10 秒：速度倍率 2.0
//      · 之后    ：速度倍率 1.4（一直保持）
//    重力不动（保持 0.9，由别处负责）。
//
//  ⚠ 为什么用 CS2Fixes 的 KeyValue 而不是 AddOutput：
//    Source 2 里 AddOutput 的 keyvalue 形式**已经失效**（CS2Fixes Wiki 明确写了：
//    "The KeyValue input is intended as a replacement for Source 1's AddOutput keyvalue
//     manipulation, which no longer works in Source 2."）
//    所以走 CS2Fixes 的 KeyValue 输入，参数格式是 "<键> <值>"。
//      https://github.com/Source2ZE/CS2Fixes/wiki/Custom-Mapping-Features
//
//    玩家的速度键有两个可选：
//      speed     **本脚本采用**。同 player_speedmod 的倍率；文档注明"客户端不预测"，
//                即速度只由服务器下发，本地手感可能略有延迟感。
//      runspeed  地面跑速倍率，客户端会预测（更跟手），但设成 <1 会慢慢回到 1。
//
//    重力的键是 gravity（缩放实体重力：1.0 = 原重力，0.9 = 90%）。
//    默认 APPLY_GRAVITY = true：拿到复活币的那名玩家在加速的同时被写成 gravity 0.9，
//    **只影响他一个人**，其他玩家不动。
//
//  ⚠ 注意：CS2Fixes 的这些输入在 Hammer 里可能显示为 invalid output，
//    但在装了 CS2Fixes 的服务器上是生效的（Wiki 原文如此）。
//
//  接线（Hammer）：三个实体
//    · point_script        Name = revive_speed_1   cs_script = maps/scripts/revive_speed.js
//    · point_servercommand Name = cmd             （聊天播报用，字段不用填）
//    · custom_hud_layout   Name = revive_hud
//          Layout = panorama/layout/custom_game/revive_hud.vxml（Observable 不勾）
//      这是开关状态提示条，压在通关排行榜上方：
//      开关打开 **并且该玩家按住 TAB（计分板）** 时才对他显示（跟计分板一起出现）。
//
//  总开关（只由 I/O 控制，发参数给 point_script revive_speed_1）：
//        revive_on       打开
//        revive_off      关闭（同时把加速中的人恢复常速）
//        revive_toggle   切换
//    例：trigger_multiple : OnStartTouch -> revive_speed_1 : RunScriptInput : revive_on
//
//  控制台测试（需 sv_cheats 1）：
//    revive_test           给当前所有玩家上加速（不用真的切阵营）
//    revive_test 3         只给 3 号玩家（playerSlot）
//    revive_status         打印当前在加速中的玩家
// ============================================================================

import { Instance, CSInputs } from "cs_script/point_script";

// ------------------------------- 配置 -------------------------------

/**
 * 速度倍率用的 keyvalue 键名（CS2Fixes 的 KeyValue 输入）：
 *   "speed"     player_speedmod 那套倍率（当前采用；客户端不预测）
 *   "runspeed"  地面跑速倍率（客户端会预测，但 <1 会慢慢回 1）
 */
const SPEED_KEY = "speed";

/** 重力键与数值（只在 APPLY_GRAVITY 打开时才用） */
const GRAVITY_KEY = "gravity";
const GRAVITY_VALUE = 0.9;

/**
 * 是否给**拿到复活币的那名玩家**一并设重力（默认开）。
 * 只作用于被加速的那个人，不动其他玩家。
 */
const APPLY_GRAVITY = true;

/**
 * 聊天公告用的 point_servercommand 实体名（Hammer 里放一个，Name 填这个）。
 * 播报方式就是给它发 Command 输入：say "文本"。
 */
const SERVERCOMMAND_NAME = "cmd";

/** 是否把加速公告打到聊天框（需要上面那个实体存在） */
const ANNOUNCE_SAY = true;

/** 是否连"加速结束"也播报（默认只播报获得加速那一下） */
const ANNOUNCE_END = false;

/** 切阵营后的前 BOOST_SEC 秒用这个倍率 */
const SPEED_BOOST = 2.0;

/** 之后一直用这个倍率 */
const SPEED_AFTER = 1.4;

/** 加速持续多久（秒） */
const BOOST_SEC = 10.0;

/**
 * 收到任何 I/O 之前，脚本初始是开还是关（开关本身由 I/O 控制，
 * 发 revive_on / revive_off / revive_toggle 给这个 point_script）。
 */
const START_ENABLED = false;

/** 常驻速度：关掉开关时，把正在加速的人恢复成这个 */
const SPEED_NORMAL = 1.0;

// ---------------- 开关状态提示条（压在通关排行榜上方） ----------------

/** Hammer 里 custom_hud_layout 实体的 Name */
const HUD_NAME = "revive_hud";

const TIP_PANEL = "revive_tip";
const TIP_VAR = "tip";
const HIDDEN_CLASS = "Hidden";

/** 开关打开时显示在上方的那行字 */
const TIP_TEXT = "复活币脚本启用中（测试）";

/**
 * 只在玩家**按住计分板键（TAB）**时显示提示条 —— 也就是跟计分板一起出现。
 * true  = 每个玩家各自判断，按 TAB 才看见（默认）
 * false = 只要开关开着就一直显示
 */
const TIP_ONLY_WITH_SCOREBOARD = true;

/** 检测是否按住计分板的轮询间隔（秒） */
const TICK_SEC = 0.1;

/**
 * 距离"回合开始"超过这么多秒才算**局中**。
 * 正常开局的分队发生在回合开始前后一两秒内，不应该触发加速；
 * 复活币造成的 T → CT 通常发生在局中，所以用这个门槛区分。
 */
const MID_ROUND_SEC = 5.0;

const TEAM_T = 2;
const TEAM_CT = 3;

// ============================================================================

/**
 * 本回合开始时的游戏时间；**-1 表示还没收到回合开始事件**。
 * ⚠ 不要用 0 当"没有"的标记：地图加载那一刻的 GetGameTime() 就是 0，
 * 第一回合的 OnRoundStart 会把这里设成 0，用 0 当哨兵会导致永远不加速
 * （这个坑仿真器抓到过）。
 */
let roundStartTime = -1;

/** 当前开关状态 */
let enabled = START_ENABLED;

/** 正在加速中的玩家：pawn -> 结束时刻 */
const boosted = [];
let tickArmed = false;

function Log(msg) {
	Instance.Msg(`[revive_speed] ${msg}`);
}

/**
 * 消毒：这条文本会被拼进服务器命令里，而玩家名是不可信输入 ——
 * 名字里若带引号/分号/换行，就能拼出额外命令（命令注入）。
 * 所以把危险字符全换成空格再压掉连续空格。
 */
function Sanitize(text) {
	return String(text).replace(/[";\r\n\t]/g, " ").replace(/\s+/g, " ").trim();
}

/** 用 point_servercommand 的 Command 输入在聊天框播报 */
function Say(text) {
	if (!ANNOUNCE_SAY) {
		return;
	}
	const safe = Sanitize(text);

	// 播报前确认实体存在，找不到就明确警告（改名/忘放都能一眼看出来）
	const found = Instance.FindEntitiesByName(SERVERCOMMAND_NAME);
	if (found.length === 0) {
		Log(`⚠ 找不到名为 "${SERVERCOMMAND_NAME}" 的 point_servercommand，聊天播报不会出现`);
	}

	Instance.EntFireAtName({
		name: SERVERCOMMAND_NAME,
		input: "Command",
		value: `say "${safe}"`,
	});
	Log(`聊天播报：${safe}`);
}

/** 往某个实体写 keyvalue（CS2Fixes 的 KeyValue 输入，参数格式 "<键> <值>"） */
function SetKeyValue(target, key, value) {
	Instance.EntFireAtTarget({
		target: target,
		input: "KeyValue",      // CS2Fixes 的 keyvalue 输入（AddOutput 的形式在 Source 2 已失效）
		value: `${key} ${value}`,
	});
}

/** 给某个玩家设速度倍率 */
function SetPlayerSpeed(pawn, speed) {
	SetKeyValue(pawn, SPEED_KEY, speed);
	if (APPLY_GRAVITY) {
		SetKeyValue(pawn, GRAVITY_KEY, GRAVITY_VALUE);
	}
}

/** 玩家槽位（d.ts 里没有 userid，能拿到的最接近的编号就是 playerSlot） */
let cachedLayout;
let hudWarned = false;

/** 取状态提示条的布局实体（缓存句柄，但引擎可能重建面板，所以先 IsValid 再复用） */
function GetHud() {
	if (cachedLayout && cachedLayout.IsValid()) {
		return cachedLayout;
	}
	const found = Instance.FindEntitiesByName(HUD_NAME);
	cachedLayout = found.length > 0 ? found[0] : undefined;
	if (!cachedLayout && !hudWarned) {
		hudWarned = true;
		Log(`⚠ 找不到名为 "${HUD_NAME}" 的 custom_hud_layout，开关状态提示条不会出现`);
	}
	return cachedLayout;
}

/**
 * 刷新提示条。
 * · 文字总是先写进去
 * · 关着开关：隐藏所有人
 * · 开着 + TIP_ONLY_WITH_SCOREBOARD：交给 ApplyTipForPlayer（每人各自看 TAB）
 * · 开着 + 不按 TAB 也显示：直接整块显示
 */
function ApplyTip() {
	const layout = GetHud();
	if (!layout) {
		return;
	}
	layout.SetDialogVariableString(TIP_PANEL, TIP_VAR, TIP_TEXT);

	if (!enabled) {
		layout.SetHasClass(TIP_PANEL, HIDDEN_CLASS, true);
		HideTipForEveryone();
		return;
	}
	if (!TIP_ONLY_WITH_SCOREBOARD) {
		layout.SetHasClass(TIP_PANEL, HIDDEN_CLASS, false);
	}
}

/** 把所有玩家的提示条都收掉（关开关时立刻生效，不等下一次轮询） */
function HideTipForEveryone() {
	const layout = GetHud();
	if (!layout) {
		return;
	}
	for (let slot = 0; slot < 64; slot++) {
		layout.SetHasClassForPlayer(slot, TIP_PANEL, HIDDEN_CLASS, true);
	}
}

/** 某个玩家现在该不该看到提示条 */
function TipVisibleFor(pawn) {
	if (!enabled) {
		return false;
	}
	if (!TIP_ONLY_WITH_SCOREBOARD) {
		return true;
	}
	return pawn.IsInputPressed(CSInputs.SHOW_SCORES);
}

/** 轮询：按"谁按住了 TAB"逐个玩家设置显隐 */
function PollTip() {
	if (!TIP_ONLY_WITH_SCOREBOARD) {
		return;
	}
	const layout = GetHud();
	if (!layout) {
		return;
	}
	for (let slot = 0; slot < 64; slot++) {
		const controller = Instance.GetPlayerController(slot);
		const pawn = controller ? controller.GetPlayerPawn() : undefined;
		if (!pawn || !pawn.IsValid()) {
			continue;
		}
		layout.SetHasClassForPlayer(slot, TIP_PANEL, HIDDEN_CLASS, !TipVisibleFor(pawn));
	}
}

/** 开关：关掉时把正在加速的人恢复常驻速度，并清空名单 */
function SetEnabled(on, why) {
	const next = !!on;
	if (next === enabled) {
		Log(`开关：已经${next ? "打开" : "关闭"}了${why ? `（${why}）` : ""}`);
		return;
	}
	enabled = next;
	Log(`开关：${next ? "打开" : "关闭"}${why ? `（${why}）` : ""}`);
	ApplyTip();
	if (enabled) {
		ArmTick();
	}

	if (!next) {
		for (const entry of boosted) {
			const pawn = entry.pawn;
			if (pawn && pawn.IsValid()) {
				SetPlayerSpeed(pawn, SPEED_NORMAL);
				Log(`${PlayerTag(pawn)} 因开关关闭，速度恢复 ${SPEED_NORMAL}`);
			}
		}
		boosted.length = 0;
		tickArmed = false;
	}
}

function PlayerSlot(pawn) {
	const controller = pawn.GetPlayerController();
	return controller ? controller.GetPlayerSlot() : "?";
}

/** 控制台里用来认人的标签："#3 NiLong" */
function PlayerTag(pawn) {
	const controller = pawn.GetPlayerController();
	const slot = PlayerSlot(pawn);
	const name = controller ? controller.GetPlayerName() : "?";
	return `#${slot} ${name}`;
}

/** 开始（或重新开始）某个玩家的加速 */
function StartBoost(pawn) {
	if (!pawn || !pawn.IsValid()) {
		return;
	}
	SetPlayerSpeed(pawn, SPEED_BOOST);

	// 已经在加速里就重新计时，不重复入表
	for (const entry of boosted) {
		if (entry.pawn === pawn) {
			entry.until = Instance.GetGameTime() + BOOST_SEC;
			const again = `${PlayerTag(pawn)} 又从僵尸变回了人类，${BOOST_SEC}s 的 ${SPEED_BOOST} 倍速重新计时！`;
			Log(again);
			Say(again);
			return;
		}
	}

	boosted.push({ pawn: pawn, until: Instance.GetGameTime() + BOOST_SEC });
	const announce = `${PlayerTag(pawn)} 从僵尸变回了人类，他获得了 ${BOOST_SEC}s 的 ${SPEED_BOOST} 倍速！`;
	Log(announce);
	Say(announce);
	ArmTick();
}

/** 心跳调度：用引擎的 think（SetThink + SetNextThink），由引擎按 tick 调用 */
function ArmTick() {
	if (tickArmed) {
		return;
	}
	tickArmed = true;
	Instance.SetThink(OnTick);
	Instance.SetNextThink(Instance.GetGameTime() + TICK_SEC);
}

function OnTick() {
	const now = Instance.GetGameTime();

	PollTip();

	for (let i = boosted.length - 1; i >= 0; i--) {
		const entry = boosted[i];
		const pawn = entry.pawn;

		if (!pawn || !pawn.IsValid()) {
			boosted.splice(i, 1);
			continue;
		}
		if (now < entry.until) {
			continue;
		}

		// 到点了：落到常驻倍率
		SetPlayerSpeed(pawn, SPEED_AFTER);
		Log(`${PlayerTag(pawn)} 加速结束，速度改为 ${SPEED_AFTER}`);
		if (ANNOUNCE_END) {
			Say(`${PlayerTag(pawn)} 的加速结束了，速度变为 ${SPEED_AFTER}`);
		}
		boosted.splice(i, 1);
	}

	// 只要开关开着（要按 TAB 判断）或有加速中的人，就继续跑心跳
	if (boosted.length > 0 || enabled) {
		Instance.SetNextThink(now + TICK_SEC);
	} else {
		tickArmed = false;
	}
}

/** 这个玩家算不算"局中切过来"的 */
function IsMidRoundSwitch() {
	if (roundStartTime < 0) {
		// 还没收到过回合开始事件（刚加载地图）：不认为在局中
		return false;
	}
	return Instance.GetGameTime() - roundStartTime >= MID_ROUND_SEC;
}

// ------------------------------- 事件 -------------------------------

Instance.OnActivate(() => {
	Log(`已加载：开关默认${START_ENABLED ? "打开" : "关闭"}；开启后 T → CT 局中切换给 ${SPEED_BOOST} 速度 ${BOOST_SEC} 秒，之后 ${SPEED_AFTER}，并给 gravity ${GRAVITY_VALUE}`);
	ApplyTip();
});

// 总开关（Hammer 里用 RunScriptInput 发这几个参数）
Instance.OnScriptInput("revive_on", () => {
	SetEnabled(true, "参数 revive_on");
});

Instance.OnScriptInput("revive_off", () => {
	SetEnabled(false, "参数 revive_off");
});

Instance.OnScriptInput("revive_toggle", () => {
	SetEnabled(!enabled, "参数 revive_toggle");
});

Instance.OnRoundStart(() => {
	roundStartTime = Instance.GetGameTime();
	boosted.length = 0;      // 新回合清空加速名单（速度倍率由游戏自己重置）
});

Instance.OnPlayerTeamChanged((event) => {
	const pawn = event.player;
	if (!pawn || !pawn.IsValid()) {
		return;
	}
	if (!enabled) {
		return;      // 总开关关着：什么都不做
	}
	// 只关心 T → CT
	if (event.oldTeam !== TEAM_T) {
		return;
	}
	if (pawn.GetTeamNumber() !== TEAM_CT) {
		return;
	}
	if (!IsMidRoundSwitch()) {
		Log(`${PlayerTag(pawn)} T → CT，但发生在回合刚开始，按普通换边处理（不加速）`);
		return;
	}
	StartBoost(pawn);
});

// ------------------------------- 控制台测试 -------------------------------

/** 给一个（或全部）玩家上加速，用来验证 keyvalue 是否真的生效 */
function TestBoost(slotText) {
	const trimmed = String(slotText || "").trim();
	if (trimmed === "") {
		let n = 0;
		for (let slot = 0; slot < 64; slot++) {
			const controller = Instance.GetPlayerController(slot);
			const pawn = controller ? controller.GetPlayerPawn() : undefined;
			if (pawn && pawn.IsValid()) {
				StartBoost(pawn);
				n++;
			}
		}
		Log(`测试：给 ${n} 个玩家上了加速`);
		return;
	}

	const slot = Number(trimmed);
	if (!Number.isFinite(slot)) {
		Log(`测试：参数 "${trimmed}" 不是玩家槽位号`);
		return;
	}
	const controller = Instance.GetPlayerController(slot);
	const pawn = controller ? controller.GetPlayerPawn() : undefined;
	if (!pawn || !pawn.IsValid()) {
		Log(`测试：${slot} 号槽位没有玩家`);
		return;
	}
	StartBoost(pawn);
}

Instance.RegisterCheatCommand("revive_test", (args) => {
	if (!enabled) {
		Log("开关是关着的：先用 Hammer 的 RunScriptInput 发 revive_on 打开");
		return;
	}
	TestBoost(args);
});

Instance.RegisterCheatCommand("revive_status", () => {
	if (boosted.length === 0) {
		Log("测试：当前没有玩家在复活加速中");
		return;
	}
	const now = Instance.GetGameTime();
	for (const entry of boosted) {
		const left = Math.max(0, entry.until - now);
		Log(`测试：${PlayerTag(entry.pawn)} 加速中，还剩 ${left.toFixed(1)} 秒`);
	}
});
