    white-space: normal;
    text-shadow: 0px 2px 4px #000000;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: linear;
}
.ItemText.ItemHidden {
    opacity: 0;
}
.ItemText.ItemFadeOut {
    transition-duration: 0.5s;
}
.ItemText.ItemInstant {
