.CosmoHud {
    width: 100%;
    height: 100%;
}
.StageText {
    horizontal-align: center;
    vertical-align: top;
    margin-top: 190px;
    font-family: Stratum2;
    font-size: 52px;
    font-weight: bold;
    text-align: center;
    color: #ff6600;
    text-shadow: 0px 2px 4px #000000;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 1s;
    transition-timing-function: linear;
}
.StageText.StageRage {
    color: #ff0000;
}
.StageText.StageHidden {
    opacity: 0;
}
.StageText.StageInstant {
    transition-duration: 0s;
}
.ItemText {
    position: 2% 45% 0px;
    width: 70%;
