    }
    get floored() {
        return Vector2Utils.floor(this);
    }
    get ceil() {
        return Vector2Utils.ceil(this);
    }
    get round() {
        return Vector2Utils.round(this);
    }
    /** Angle (radians) of this vector from the positive X axis. */
    get angle() {
        return Vector2Utils.angle(this);
    }
