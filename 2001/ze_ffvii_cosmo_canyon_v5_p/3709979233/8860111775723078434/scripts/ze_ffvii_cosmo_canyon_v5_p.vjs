    for (const slot of item_text_players.keys())
        resetItemText(slot);
    warmup = false;
    gi_nattak_silence = false;
    shinra_elevator = false;
    shinra_tp = false;
    zm_immunity = false;
    minion_origin_temp = [...minion_origin];
