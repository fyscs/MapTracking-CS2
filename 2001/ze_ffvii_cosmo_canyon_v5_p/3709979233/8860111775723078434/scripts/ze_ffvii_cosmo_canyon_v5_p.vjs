    /** Returns the vector rotated 90° counter-clockwise. */
    static perpendicular(vector) {
        return new Vec2(-vector.y, vector.x);
    }
    static withX(vector, x) {
        return new Vec2(x, vector.y);
    }
    static withY(vector, y) {
