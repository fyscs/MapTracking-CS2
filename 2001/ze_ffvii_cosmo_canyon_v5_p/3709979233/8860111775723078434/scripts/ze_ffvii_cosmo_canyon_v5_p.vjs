const item_text_players = new Map();
let item_text_revision = 0;
function resetItemText(playerSlot) {
    item_text_players.delete(playerSlot);
    const hud = Entities.FindByName("hud")[0];
    if (!(hud instanceof CustomHudLayout))
        return;
    hud.SetHasClassForPlayer(playerSlot, "item_text", "ItemInstant", true);
    hud.SetHasClassForPlayer(playerSlot, "item_text", "ItemHidden", true);
    hud.SetDialogVariableStringForPlayer(playerSlot, "item_text", "item", "");
}
for (const [name, text] of Object.entries(item_texts)) {
    Instance.OnScriptInput(`ShowItemText_${name}`, (data) => {
        const activator = data.activator;
        const player = activator instanceof CSPlayerPawn ? activator.GetPlayerController()
            : activator instanceof CSPlayerController ? activator : undefined;
        const hud = Entities.FindByName("hud")[0];
        if (!player || !(hud instanceof CustomHudLayout))
            return;
        const slot = player.GetPlayerSlot();
        const revision = ++item_text_revision;
        item_text_players.set(slot, revision);
        for (const definition of Object.values(item_texts)) {
            hud.SetHasClassForPlayer(slot, "item_text", definition.colorClass, definition.colorClass === text.colorClass);
        }
        hud.SetDialogVariableStringForPlayer(slot, "item_text", "item", text.message);
        hud.SetHasClassForPlayer(slot, "item_text", "ItemFadeOut", false);
        hud.SetHasClassForPlayer(slot, "item_text", "ItemInstant", false);
        hud.SetHasClassForPlayer(slot, "item_text", "ItemHidden", false);
        setTimeout(() => {
            if (item_text_players.get(slot) !== revision || !hud.IsValid())
                return;
            hud.SetHasClassForPlayer(slot, "item_text", "ItemFadeOut", true);
            hud.SetHasClassForPlayer(slot, "item_text", "ItemHidden", true);
        }, (text.fadein + text.holdtime) * 1000);
    });
}
Instance.OnPlayerDisconnect(({ playerSlot }) => resetItemText(playerSlot));
