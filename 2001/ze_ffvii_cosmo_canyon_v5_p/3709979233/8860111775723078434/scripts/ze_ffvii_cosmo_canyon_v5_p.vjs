    static distance2DSquared(a, b) {
        return new Vec3(a.x - b.x, a.y - b.y, 0).lengthSquared;
    }
    static floor(vector) {
        return new Vec3(Math.floor(vector.x), Math.floor(vector.y), Math.floor(vector.z));
    }
