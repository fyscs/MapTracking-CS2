const script_cosmo = "script_cosmo";
let levelcounter = 1;
let warmup = false;
const stage_overlays = {
    warmup_overlay: { text: "WARMUP", duration: 45 },
    normal_overlay: { text: "NORMAL", duration: 12 },
    hard_overlay: { text: "HARD", duration: 12 },
    extreme_overlay: { text: "EXTREME", duration: 12 },
    rage_overlay: { text: "RAGE", duration: 12, rage: true },
    zm_overlay: { text: "ZM", duration: 155 },
};
let stage_overlay_revision = 0;
function resetStageOverlays() {
    stage_overlay_revision++;
    const hud = Entities.FindByName("hud")[0];
    if (!(hud instanceof CustomHudLayout))
        return;
    hud.SetHasClass("stage_text", "StageInstant", true);
    hud.SetHasClass("stage_text", "StageHidden", true);
}
function showStageOverlay(stageName) {
    const hud = Entities.FindByName("hud")[0];
    if (!(hud instanceof CustomHudLayout))
        return;
    const stage = stage_overlays[stageName];
    if (!stage)
        return;
    resetStageOverlays();
    const revision = stage_overlay_revision;
    hud.SetDialogVariableString("stage_text", "stage", stage.text);
    hud.SetHasClass("stage_text", "StageRage", stage.rage === true);
    hud.SetHasClass("stage_text", "StageInstant", false);
    hud.SetHasClass("stage_text", "StageHidden", false);
    setTimeout(() => {
        if (revision !== stage_overlay_revision || !hud.IsValid())
            return;
        hud.SetHasClass("stage_text", "StageHidden", true);
    }, (stage.duration - 1) * 1000);
}
for (const name of Object.keys(stage_overlays)) {
    Instance.OnScriptInput(`ShowStage_${name}`, () => showStageOverlay(name));
}
