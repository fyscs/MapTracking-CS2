        // Binary search for the segment where cache[lo].x <= x <= cache[hi].x.
        let lo = 0;
        let hi = this._curveCache.length - 1;
        while (lo + 1 < hi) {
            const mid = (lo + hi) >> 1;
            if (this._curveCache[mid].x <= x) {
                lo = mid;
