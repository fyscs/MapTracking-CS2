    withYaw(yaw) {
        return EulerUtils.withYaw(this, yaw);
    }
    /**
     * Returns the same angle but with a supplied roll component
     */
    withRoll(roll) {
        return EulerUtils.withRoll(this, roll);
    }
    /**
