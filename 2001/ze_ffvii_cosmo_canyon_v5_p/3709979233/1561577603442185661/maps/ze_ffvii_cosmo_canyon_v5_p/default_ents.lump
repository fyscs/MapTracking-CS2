        "param": "",
        "delay": 0,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]lvl1_Rock_Temp",
        "input": "ForceSpawn",
        "param": "",
        "delay": 0,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Map_Random_Event_Case",
        "input": "Kill",
        "param": "",
        "delay": 0,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Cloud] Hmm.. Seems like the engines are broken.. We are stuck in the middle of this desert!",
        "delay": 5,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Red-XIII] Do not worry. I know this place.. I was born in here..",
        "delay": 7,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Cloud] Well.. That means.. That we can find some staff to make our ship working again.. Right",
        "delay": 9,
        "limit": 9
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Red-XIII] Of course. But I need to do something first.. I will see you in the Gi Cave. ",
        "delay": 11,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Red-XIII] There I will give you all the stuff you need. ",
        "delay": 13,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say [Cloud] No problem. I will wait for you in there..",
        "delay": 15,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Cloud] Ay.. There you are!\u003E2\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Red-XIII] Yes. They helped me a lot. Did you ask for that? This is for you..\u003E4\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Cloud] Thanks. But one question.. What did we forget here?\u003E6\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Red-XIII] This is the ancient cave of spirits.. Far ago my father was fighting with Gi Nattak..\u003E8\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Red-XIII] And he sacrificed himself in order to save the Cosmo Canyon..\u003E10\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Cloud] Oh what a pity.. \u003E12\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Red-XIII] Do not bring this close to your heart.. He died like a hero and I hope that you guys can defeat him..\u003E14\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
        "target": "[PR#]Hold7_Trigger",
        "input": "AddOutput",
        "param": "OnTrigger\u003Ecmd\u003ECommand\u003Esay [Cloud] Yea I wish you good luck. When you end with him I go repair our airship.. \u003E16\u003E1",
        "delay": 2,
        "limit": -1
      },
      {
        "output": "OnTrigger",
