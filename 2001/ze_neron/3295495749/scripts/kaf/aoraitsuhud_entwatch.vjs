import { Instance } from "cs_script/point_script";

const HUD_LAYOUT_NAME = "AoraitsuHUD_entwatch_layout";
const HIDDEN_CLASS = "Hidden";
const POLL_INTERVAL = 0.5;
const PICKUP_PAIR_WINDOW = 0.2;
const MAX_LIST_ROWS = 12;
const TEAM_T = 2;
const TEAM_CT = 3;

/**
 * @typedef {object} ArtifactConfig
 * @property {string} targetname 神器的唯一逻辑标识
 * @property {string} name HUD 显示的神器名
 * @property {number} cd 冷却时间（秒）
 * @property {"ct" | "t"} team 神器阵营
 * @property {0 | 1 | 2} hudMode 0=不显示，1=同阵营，2=全阵营
 * @property {0 | 1} [transparentForHolder] 1=本人中央区块透明但保留占位
 * @property {0 | 1} [closeAhudOnPickup] 1=注册后立即关闭并隐藏本人的共享神器列表
 */

/** @type {ArtifactConfig[]} */
const ARTIFACTS = [
    { targetname: "blue", name: "传送枪", cd: 70, team: "ct", hudMode: 1 },
    { targetname: "green", name: "护盾", cd: 70, team: "ct", hudMode: 1 },
    { targetname: "orange", name: "方块墙", cd: 65, team: "ct", hudMode: 1 },
    { targetname: "kiki", name: "Kiki", cd: 0, team: "ct", hudMode: 1, transparentForHolder: 1, closeAhudOnPickup: 1 },
    { targetname: "enidnu", name: "Enidnu", cd: 0, team: "ct", hudMode: 1 },
    { targetname: "red", name: "能量球", cd: 0, team: "ct", hudMode: 1 },
    { targetname: "zm_red", name: "能量球", cd: 70, team: "t", hudMode: 1 },
    { targetname: "zm_orange", name: "治疗", cd: 50, team: "t", hudMode: 1 },
    { targetname: "zm_green", name: "激光炮", cd: 65, team: "t", hudMode: 1 },
    { targetname: "zm_blue", name: "冰冻球", cd: 40, team: "t", hudMode: 1 },
    { targetname: "zm_purple", name: "黑洞", cd: 60, team: "t", hudMode: 1 },
    { targetname: "zm_ghost", name: "幽灵", cd: 0, team: "t", hudMode: 1 },
];

/**
 * @typedef {ArtifactConfig & {
 *     readyTime: number,
 *     readyPulseUntil: number,
 *     holderSlot: number | undefined,
 *     weapon: import("cs_script/point_script").CSWeaponBase | undefined,
 *     listed: boolean,
 * }} ArtifactState
 */

/** @type {import("cs_script/point_script").CustomHudLayout | undefined} */
let hudLayout;

/** @type {ArtifactState[]} */
const artifactStates = ARTIFACTS.map((artifact) => ({
    ...artifact,
    readyTime: 0,
    readyPulseUntil: 0,
    holderSlot: undefined,
    weapon: undefined,
    listed: false,
}));

/** @type {Map<number, {targetname: string, status: string}>} */
const renderedHud = new Map();
/** @type {Set<number>} */
const listEnabledPlayers = new Set();
/** @type {Map<number, string>} */
const listRenderCache = new Map();
/** @type {Map<number, string[]>} */
const listPositionCache = new Map();
/** @type {ArtifactState | undefined} */
let pendingPickupArtifact;
let pendingPickupTime = 0;
/** @type {{
 *     playerSlot: number,
 *     weapon: import("cs_script/point_script").CSWeaponBase,
 *     gameTime: number,
 * } | undefined} */
let lastWeaponPickup;

function getHudLayout() {
    if (!hudLayout) {
        hudLayout = /** @type {import("cs_script/point_script").CustomHudLayout | undefined} */ (
            Instance.FindEntityByName(HUD_LAYOUT_NAME)
        );
    }

    return hudLayout;
}

/** @param {import("cs_script/point_script").Entity | undefined} source */
function findInputPlayer(source) {
    const owner = source?.GetOwner();

    for (const player of Instance.GetAllPlayerControllers()) {
        if (
            player.IsConnected()
            && (
                player === source
                || player.GetPlayerPawn() === source
                || player.GetObserverPawn() === source
                || player.GetPlayerPawn() === owner
            )
        ) {
            return player;
        }
    }

    return undefined;
}

/** @param {number} playerSlot */
function hideHud(playerSlot) {
    getHudLayout()?.SetHasClassForPlayer(playerSlot, "artifact_hud", HIDDEN_CLASS, true);
    renderedHud.delete(playerSlot);
}

/**
 * @param {ArtifactState} artifact
 * @param {number} gameTime
 */
function getArtifactStatus(artifact, gameTime) {
    return gameTime >= artifact.readyTime
        ? "就绪"
        : `${Math.max(1, Math.ceil(artifact.readyTime - gameTime))}`;
}

/**
 * @param {number} playerSlot
 * @param {ArtifactState} artifact
 * @param {number} gameTime
 * @param {boolean} force
 */
function showArtifactHud(playerSlot, artifact, gameTime, force) {
    const layout = getHudLayout();
    if (!layout) {
        return;
    }

    const ready = gameTime >= artifact.readyTime;
    const noCooldown = artifact.cd === 0;
    const status = getArtifactStatus(artifact, gameTime);
    const rendered = renderedHud.get(playerSlot);
    const artifactChanged = rendered?.targetname !== artifact.targetname;
    const justBecameReady = ready
        && rendered?.targetname === artifact.targetname
        && rendered.status !== "就绪";

    if (justBecameReady) {
        artifact.readyPulseUntil = gameTime + 0.35;
    }

    if (force || artifactChanged) {
        setPlayerText(layout, playerSlot, "artifact_name", "name", artifact.name);
        setPlayerClass(layout, playerSlot, "artifact_hud", HIDDEN_CLASS, false);
    }
    setPlayerClass(
        layout,
        playerSlot,
        "artifact_hud",
        "Transparent",
        artifact.transparentForHolder === 1,
    );
    setPlayerClass(layout, playerSlot, "artifact_status", HIDDEN_CLASS, noCooldown);
    setPlayerClass(layout, playerSlot, "artifact_name", "NoCooldown", noCooldown);

    if (force || artifactChanged || rendered?.status !== status) {
        setPlayerText(layout, playerSlot, "artifact_status", "status", status);
        setPlayerClass(layout, playerSlot, "artifact_status", "Ready", ready);
    }
    setPlayerClass(
        layout,
        playerSlot,
        "artifact_status",
        "ReadyPulse",
        gameTime < artifact.readyPulseUntil,
    );

    renderedHud.set(playerSlot, { targetname: artifact.targetname, status });
}

/**
 * @param {number} gameTime
 * @param {boolean} [force]
 */
function refreshHud(gameTime, force = false) {
    /** @type {Map<number, ArtifactState>} */
    const artifactsByHolder = new Map();

    for (const artifact of artifactStates) {
        if (
            artifact.holderSlot !== undefined
            && !artifactsByHolder.has(artifact.holderSlot)
        ) {
            artifactsByHolder.set(artifact.holderSlot, artifact);
        }
    }

    for (const playerSlot of [...renderedHud.keys()]) {
        if (!artifactsByHolder.has(playerSlot)) {
            hideHud(playerSlot);
        }
    }

    for (const [playerSlot, artifact] of artifactsByHolder) {
        showArtifactHud(playerSlot, artifact, gameTime, force);
    }
}

/** @param {number} playerSlot */
function hideArtifactList(playerSlot) {
    getHudLayout()?.SetHasClassForPlayer(
        playerSlot,
        "artifact_list",
        HIDDEN_CLASS,
        true,
    );
    listRenderCache.delete(playerSlot);
}

/**
 * @param {import("cs_script/point_script").CSPlayerController} player
 * @param {ArtifactState} artifact
 */
function canPlayerSeeArtifact(player, artifact) {
    if (!artifact.listed || artifact.hudMode === 0) {
        return false;
    }
    if (artifact.hudMode === 2) {
        return true;
    }

    const artifactTeam = artifact.team === "ct" ? TEAM_CT : TEAM_T;
    return player.GetTeamNumber() === artifactTeam;
}

/**
 * @param {number} index
 * @param {boolean} hasPersonalHud
 * @param {number} rowCount
 */
function getListPositionClass(
    index,
    hasPersonalHud,
    rowCount,
) {
    if (!hasPersonalHud) {
        const offset = (2 * index) - (rowCount - 1);
        if (offset === 0) {
            return "ListCenter";
        }

        return offset < 0
            ? `ListOffsetN${Math.abs(offset)}`
            : `ListOffsetP${offset}`;
    }

    const sideIndex = index;
    const level = Math.floor(sideIndex / 2) + 1;
    return sideIndex % 2 === 0
        ? `ListLeft${level}`
        : `ListRight${level}`;
}

/**
 * @typedef {object} ArtifactListRow
 * @property {ArtifactState} artifact
 * @property {string} holderName
 * @property {string} status
 * @property {boolean} dropped
 */

function buildArtifactListRows(player, playerSlot, gameTime) {
    return artifactStates
        .filter((artifact) => (
            artifact.holderSlot !== playerSlot
            && canPlayerSeeArtifact(player, artifact)
        ))
        .slice(0, MAX_LIST_ROWS)
        .map((artifact) => {
            const holder = artifact.holderSlot === undefined
                ? undefined
                : Instance.GetPlayerController(artifact.holderSlot);
            return {
                artifact,
                holderName: holder?.IsConnected()
                    ? holder.GetPlayerName()
                    : "已丢弃",
                status: getArtifactStatus(artifact, gameTime),
                dropped: artifact.holderSlot === undefined,
            };
        });
}

function getArtifactListSignature(rows, hasPersonalHud) {
    return `${hasPersonalHud ? "personal" : "center"};${rows.map((row) => [
        row.artifact.targetname,
        row.holderName,
        row.status,
        row.dropped ? "dropped" : "held",
    ].join("|")).join(";")}`;
}

function setPlayerClass(layout, playerSlot, panelId, className, enabled) {
    layout.SetHasClassForPlayer(playerSlot, panelId, className, enabled);
}

function setPlayerText(layout, playerSlot, panelId, variable, value) {
    layout.SetDialogVariableStringForPlayer(
        playerSlot,
        panelId,
        variable,
        value,
    );
}

function clearListPositionClasses(layout, playerSlot, rowPanel) {
    setPlayerClass(layout, playerSlot, rowPanel, "ListCenter", false);
    for (let level = 1; level < MAX_LIST_ROWS; level += 1) {
        for (const prefix of ["ListLeft", "ListRight", "ListOffsetN", "ListOffsetP"]) {
            setPlayerClass(layout, playerSlot, rowPanel, `${prefix}${level}`, false);
        }
    }
}

function renderArtifactListRow(
    layout,
    playerSlot,
    row,
    index,
    rowCount,
    hasPersonalHud,
    positions,
) {
    const rowNumber = index + 1;
    const rowPanel = `artifact_list_row_${rowNumber}`;
    const position = getListPositionClass(index, hasPersonalHud, rowCount);
    const previousPosition = positions[index];
    if (previousPosition !== position) {
        if (previousPosition) {
            setPlayerClass(layout, playerSlot, rowPanel, previousPosition, false);
        } else {
            clearListPositionClasses(layout, playerSlot, rowPanel);
        }
        setPlayerClass(layout, playerSlot, rowPanel, position, true);
        positions[index] = position;
    }

    setPlayerText(layout, playerSlot, `artifact_list_name_${rowNumber}`, "name", row.artifact.name);
    setPlayerText(layout, playerSlot, `artifact_list_holder_${rowNumber}`, "holder", row.holderName);
    setPlayerText(layout, playerSlot, `artifact_list_status_${rowNumber}`, "status", row.status);
    setPlayerClass(layout, playerSlot, `artifact_list_status_${rowNumber}`, "Ready", row.status === "就绪");
    setPlayerClass(layout, playerSlot, `artifact_list_status_${rowNumber}`, HIDDEN_CLASS, row.artifact.cd === 0);
    setPlayerClass(layout, playerSlot, `artifact_list_holder_${rowNumber}`, "Dropped", row.dropped);
    setPlayerClass(layout, playerSlot, rowPanel, "NoCooldown", row.artifact.cd === 0);
}

/**
 * @param {import("cs_script/point_script").CSPlayerController} player
 * @param {number} gameTime
 * @param {boolean} [force]
 */
function refreshArtifactListForPlayer(player, gameTime, force = false) {
    const layout = getHudLayout();
    if (!layout) {
        return;
    }

    const playerSlot = player.GetPlayerSlot();
    if (!listEnabledPlayers.has(playerSlot)) {
        hideArtifactList(playerSlot);
        return;
    }

    const hasPersonalHud = artifactStates.some(
        (artifact) => artifact.holderSlot === playerSlot,
    );
    const rows = buildArtifactListRows(player, playerSlot, gameTime);
    const signature = getArtifactListSignature(rows, hasPersonalHud);

    if (!force && listRenderCache.get(playerSlot) === signature) {
        return;
    }

    setPlayerClass(layout, playerSlot, "artifact_list", HIDDEN_CLASS, rows.length === 0);
    const positions = listPositionCache.get(playerSlot) ?? [];

    for (let index = 0; index < MAX_LIST_ROWS; index += 1) {
        const row = rows[index];
        const rowPanel = `artifact_list_row_${index + 1}`;
        setPlayerClass(layout, playerSlot, rowPanel, HIDDEN_CLASS, !row);
        if (!row) {
            continue;
        }
        renderArtifactListRow(
            layout,
            playerSlot,
            row,
            index,
            rows.length,
            hasPersonalHud,
            positions,
        );
    }

    listPositionCache.set(playerSlot, positions);
    listRenderCache.set(playerSlot, signature);
}

/**
 * @param {number} gameTime
 * @param {boolean} [force]
 */
function refreshArtifactLists(gameTime, force = false) {
    for (const player of Instance.GetAllPlayerControllers()) {
        if (player.IsConnected()) {
            refreshArtifactListForPlayer(player, gameTime, force);
        }
    }
}

/**
 * @param {number} gameTime
 * @param {boolean} [force]
 */
function refreshAllHud(gameTime, force = false) {
    refreshHud(gameTime, force);
    refreshArtifactLists(gameTime, force);
}

/** @param {number} playerSlot */
function clearPlayerArtifacts(playerSlot) {
    for (const artifact of artifactStates) {
        if (artifact.holderSlot === playerSlot) {
            artifact.holderSlot = undefined;
            artifact.weapon = undefined;
        }
    }

    hideHud(playerSlot);
}

/**
 * @param {ArtifactState} artifact
 * @param {number} playerSlot
 * @param {import("cs_script/point_script").CSWeaponBase} [weapon]
 */
function registerArtifactHolder(artifact, playerSlot, weapon) {
    const gameTime = Instance.GetGameTime();
    clearPlayerArtifacts(playerSlot);
    artifact.holderSlot = playerSlot;
    artifact.weapon = weapon;
    artifact.listed = true;
    if (artifact.closeAhudOnPickup === 1) {
        listEnabledPlayers.delete(playerSlot);
        hideArtifactList(playerSlot);
    } else {
        listEnabledPlayers.add(playerSlot);
    }
    refreshAllHud(gameTime, true);
}

/** @param {number} gameTime */
function validateArtifactHolders(gameTime) {
    for (const artifact of artifactStates) {
        if (artifact.holderSlot === undefined) {
            continue;
        }

        const playerSlot = artifact.holderSlot;
        const player = Instance.GetPlayerController(playerSlot);
        const pawn = player?.GetPlayerPawn();
        const expectedTeam = artifact.team === "ct" ? TEAM_CT : TEAM_T;
        const waitingForWeapon = !artifact.weapon
            && pendingPickupArtifact === artifact
            && gameTime - pendingPickupTime <= PICKUP_PAIR_WINDOW;
        const weaponOwnerSlot = artifact.weapon?.IsValid()
            ? artifact.weapon.GetOwner()?.GetPlayerController()?.GetPlayerSlot()
            : undefined;

        if (
            !player?.IsConnected()
            || !pawn?.IsValid()
            || pawn.GetHealth() <= 0
            || pawn.GetTeamNumber() !== expectedTeam
            || (!waitingForWeapon && weaponOwnerSlot !== playerSlot)
        ) {
            artifact.holderSlot = undefined;
            artifact.weapon = undefined;
            if (pendingPickupArtifact === artifact) {
                pendingPickupArtifact = undefined;
                pendingPickupTime = 0;
            }
            hideHud(playerSlot);
        }
    }
}

function resetHud() {
    for (const artifact of artifactStates) {
        artifact.readyTime = 0;
        artifact.readyPulseUntil = 0;
        artifact.holderSlot = undefined;
        artifact.weapon = undefined;
        artifact.listed = false;
    }

    listEnabledPlayers.clear();
    for (const player of Instance.GetAllPlayerControllers()) {
        if (player.IsConnected()) {
            hideHud(player.GetPlayerSlot());
            hideArtifactList(player.GetPlayerSlot());
        }
    }
    renderedHud.clear();
    listRenderCache.clear();
    pendingPickupArtifact = undefined;
    pendingPickupTime = 0;
    lastWeaponPickup = undefined;
}

/** @param {number | undefined} playerSlot */
function getRecentWeaponPickup(playerSlot) {
    if (
        !lastWeaponPickup
        || Instance.GetGameTime() - lastWeaponPickup.gameTime > PICKUP_PAIR_WINDOW
        || (
            playerSlot !== undefined
            && lastWeaponPickup.playerSlot !== playerSlot
        )
    ) {
        return undefined;
    }

    return lastWeaponPickup;
}

for (const artifact of artifactStates) {
    /**
     * @param {{
     *     activator?: import("cs_script/point_script").Entity,
     *     caller?: import("cs_script/point_script").Entity,
     * }} inputData
     */
    const pickupHandler = ({ activator, caller }) => {
        const player = findInputPlayer(activator) ?? findInputPlayer(caller);
        const directPlayerSlot = player?.GetPlayerSlot();
        const recentPickup = getRecentWeaponPickup(directPlayerSlot);
        const playerSlot = directPlayerSlot ?? recentPickup?.playerSlot;
        if (playerSlot === undefined) {
            pendingPickupArtifact = artifact;
            pendingPickupTime = Instance.GetGameTime();
            return;
        }

        registerArtifactHolder(artifact, playerSlot, recentPickup?.weapon);
        pendingPickupArtifact = recentPickup ? undefined : artifact;
        pendingPickupTime = recentPickup ? 0 : Instance.GetGameTime();
    };

    /**
     * @param {{
     *     activator?: import("cs_script/point_script").Entity,
     *     caller?: import("cs_script/point_script").Entity,
     * }} inputData
     */
    const useHandler = ({ activator, caller }) => {
        const gameTime = Instance.GetGameTime();
        const player = findInputPlayer(activator) ?? findInputPlayer(caller);
        const renderedHolderSlot = [...renderedHud].find(
            ([, rendered]) => rendered.targetname === artifact.targetname,
        )?.[0];
        const holderSlot = player?.GetPlayerSlot()
            ?? artifact.holderSlot
            ?? renderedHolderSlot
            ?? getRecentWeaponPickup(undefined)?.playerSlot;

        if (holderSlot !== undefined) {
            if (artifact.holderSlot !== holderSlot) {
                clearPlayerArtifacts(holderSlot);
                artifact.holderSlot = holderSlot;
            }
        }

        artifact.readyTime = gameTime + artifact.cd;
        artifact.readyPulseUntil = 0;
        refreshAllHud(gameTime, true);
    };

    const capitalizedTargetname = artifact.targetname.charAt(0).toUpperCase()
        + artifact.targetname.slice(1);
    for (const inputTargetname of new Set([
        artifact.targetname,
        capitalizedTargetname,
    ])) {
        for (const pickupName of ["pickup", "Pickup"]) {
            Instance.OnScriptInput(`${inputTargetname}_${pickupName}`, pickupHandler);
        }
        for (const useName of ["use", "Use"]) {
            Instance.OnScriptInput(`${inputTargetname}_${useName}`, useHandler);
        }
    }
}

Instance.SetThink(() => {
    const gameTime = Instance.GetGameTime();
    validateArtifactHolders(gameTime);
    refreshAllHud(gameTime);
    Instance.SetNextThink(gameTime + POLL_INTERVAL);
});

Instance.OnActivate(() => {
    resetHud();
    Instance.SetNextThink(Instance.GetGameTime() + POLL_INTERVAL);
});

Instance.OnRoundStart(() => {
    resetHud();
});

Instance.OnPlayerActivate(({ player }) => {
    const playerSlot = player.GetPlayerSlot();
    listEnabledPlayers.delete(playerSlot);
    listPositionCache.delete(playerSlot);
    hideArtifactList(playerSlot);
});

Instance.OnPlayerChat(({ player, text }) => {
    if (!player || text.trim() !== "ahud") {
        return;
    }

    const playerSlot = player.GetPlayerSlot();
    if (listEnabledPlayers.has(playerSlot)) {
        listEnabledPlayers.delete(playerSlot);
        hideArtifactList(playerSlot);
        return;
    }

    listEnabledPlayers.add(playerSlot);
    refreshArtifactListForPlayer(player, Instance.GetGameTime(), true);
});

const clearPawnArtifacts = ({ player }) => {
    const controller = player.GetPlayerController();
    if (controller) {
        const playerSlot = controller.GetPlayerSlot();
        clearPlayerArtifacts(playerSlot);
    }
};

Instance.OnPlayerKill(clearPawnArtifacts);
Instance.OnPlayerReset(clearPawnArtifacts);

Instance.OnWeaponPickup(({ weapon }) => {
    const owner = weapon.GetOwner();
    const controller = owner?.GetPlayerController();
    if (!controller) {
        return;
    }

    const playerSlot = controller.GetPlayerSlot();
    lastWeaponPickup = {
        playerSlot,
        weapon,
        gameTime: Instance.GetGameTime(),
    };

    const artifact = artifactStates.find(
        (candidate) => candidate.targetname === weapon.GetEntityName(),
    );
    if (artifact) {
        registerArtifactHolder(artifact, playerSlot, weapon);
        pendingPickupArtifact = undefined;
        pendingPickupTime = 0;
        return;
    }

    if (pendingPickupArtifact) {
        registerArtifactHolder(pendingPickupArtifact, playerSlot, weapon);
        pendingPickupArtifact = undefined;
        pendingPickupTime = 0;
    }
});

Instance.OnWeaponDrop(({ weapon }) => {
    const artifact = artifactStates.find(
        (candidate) => candidate.weapon === weapon,
    );
    if (!artifact) {
        return;
    }

    const playerSlot = artifact.holderSlot;
    artifact.holderSlot = undefined;
    artifact.weapon = undefined;
    if (playerSlot !== undefined) {
        refreshAllHud(Instance.GetGameTime(), true);
    }
});

Instance.OnPlayerDisconnect(({ playerSlot }) => {
    clearPlayerArtifacts(playerSlot);
    listEnabledPlayers.delete(playerSlot);
    listRenderCache.delete(playerSlot);
    listPositionCache.delete(playerSlot);
});
