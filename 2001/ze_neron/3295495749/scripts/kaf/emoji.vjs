// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Console } from 'cs_script/point_script';

// ===================== 設定 =====================
// Hammer 裡 custom_hud_layout 實體的 targetname (要跟 Hammer 設定一致)
const HUD_ENTITY_NAME = 'emoji_hud';
// 展示後的冷卻秒數 (任何一張圖展示後，全部圖片都進入冷卻)
const COOLDOWN_SEC = 20;
// 圖片顯示多久 (秒)，要小於冷卻時間
const SHOW_SEC = 4;
// 個別圖片的顯示秒數 (沒列出的用 SHOW_SEC)
const SHOW_SEC_BY_PANEL = {
    emoji_gif1: 5,
};
// sprite sheet 動畫設定：frames = 總格數，fps = 每秒幾格
// (對應 CSS 的 .EmojiGif1.Frame00 ~ Frame74；原 GIF 的每格間隔可換算成 fps)
const GIF_CONFIG = {
    emoji_gif1: { frames: 75, fps: 15 },
    emoji_gif2: { frames: 5, fps: 33 },
};
// 顯示用的 CSS class (定義在 neron_emoji.css)
const VISIBLE_CLASS = 'EmojiVisible';

// 指令名稱 -> XML 裡的面板 id
//   ent_fire hud_emoji_script RunScriptInput use1    -> emoji_1
//   ent_fire hud_emoji_script RunScriptInput usekaf  -> emoji_kaf
const EMOJIS = {
    use1: 'emoji_1',
    use2: 'emoji_2',
    use3: 'emoji_3',
    use4: 'emoji_4',
    use5: 'emoji_5',
    use6: 'emoji_6',
    use7: 'emoji_7',
    use8: 'emoji_8',
    use9: 'emoji_9',
    usegif1: 'emoji_gif1',   // sprite sheet 動畫
    usegif2: 'emoji_gif2',
    usekaf: 'emoji_kaf',
};

// ===================== 狀態 =====================
let cooldownLeft = 0;   // 剩餘冷卻秒數，0 = 可以使用
let generation = 0;     // 回合重置時 +1，讓舊的計時器失效
let showRequestId = 0;  // 讓舊的「隱藏圖片」計時器失效
let enabled = true;     // 發送圖片功能總開關 (ent_fire map_emoji RunScriptInput enable / disable / toggle)

function getHud() {
    return Instance.FindEntityByName(HUD_ENTITY_NAME);
}

function hideAll() {
    ++showRequestId;
    const hud = getHud();
    if (!hud)
        return;
    for (const panelId of Object.values(EMOJIS)) {
        hud.SetHasClass(panelId, VISIBLE_CLASS, false);
    }
}

function frameClass(n) {
    return `Frame${String(n).padStart(2, '0')}`;
}

// 逐格播放 sprite sheet，直到圖片被隱藏 (showRequestId 改變) 或新回合
async function playGif(panelId, startGeneration, requestId) {
    const cfg = GIF_CONFIG[panelId];
    const frameTime = 1 / cfg.fps;
    let frame = 0;
    let prev = -1;
    while (startGeneration === generation && requestId === showRequestId) {
        const hud = getHud();
        if (!hud)
            break;
        if (prev >= 0)
            hud.SetHasClass(panelId, frameClass(prev), false);
        hud.SetHasClass(panelId, frameClass(frame), true);
        prev = frame;
        frame = (frame + 1) % cfg.frames;
        await Instance.Delay(frameTime);
    }
    if (prev >= 0)
        getHud()?.SetHasClass(panelId, frameClass(prev), false);
}

async function runCooldown(startGeneration) {
    while (cooldownLeft > 0) {
        await Instance.Delay(1);
        if (startGeneration !== generation)
            return;
        --cooldownLeft;
    }
}

// noCooldown = true：不檢查、也不觸發冷卻 (admin 用)
async function useEmoji(panelId, noCooldown = false) {
    // 功能關閉 -> 拒絕
    if (!enabled) {
        Console.ServerCommand(`say "Emoji is disabled"`);
        return;
    }
    // 冷卻中 -> 拒絕
    if (!noCooldown && cooldownLeft > 0) {
        Console.ServerCommand(`say "Emoji is on cooldown (${cooldownLeft}s left)"`);
        return;
    }
    const hud = getHud();
    if (!hud) {
        Console.Log(`[emoji] HUD entity "${HUD_ENTITY_NAME}" not found`);
        return;
    }
    const startGeneration = generation;
    hideAll();
    const requestId = showRequestId;

    hud.SetHasClass(panelId, VISIBLE_CLASS, true);
    if (GIF_CONFIG[panelId])
        void playGif(panelId, startGeneration, requestId);

    // 進入冷卻 (admin 不觸發冷卻，也不影響 svip / vip 的冷卻)
    if (!noCooldown) {
        cooldownLeft = COOLDOWN_SEC;
        void runCooldown(startGeneration);
    }

    // 顯示一段時間後隱藏
    await Instance.Delay(SHOW_SEC_BY_PANEL[panelId] ?? SHOW_SEC);
    if (startGeneration !== generation || requestId !== showRequestId)
        return;
    ++showRequestId; // 讓逐格播放的迴圈停止
    getHud()?.SetHasClass(panelId, VISIBLE_CLASS, false);
}

// ===================== 指令 =====================
//   use1 ~ use9 / usegif1 ...            -> 有 20 秒共用冷卻 (svip / vip)
//   use1_nocd ~ use9_nocd / usegif1_nocd -> 沒有冷卻 (admin)
for (const [inputName, panelId] of Object.entries(EMOJIS)) {
    Instance.OnScriptInput(inputName, () => {
        void useEmoji(panelId);
    });
    Instance.OnScriptInput(`${inputName}_nocd`, () => {
        void useEmoji(panelId, true);
    });
}

// 總開關 (控制台)：
//   ent_fire map_emoji RunScriptInput enable
//   ent_fire map_emoji RunScriptInput disable
//   ent_fire map_emoji RunScriptInput toggle
function setEnabled(on) {
    enabled = on;
    if (!on) hideAll();
}
Instance.OnScriptInput('enable', () => setEnabled(true));
Instance.OnScriptInput('disable', () => setEnabled(false));
Instance.OnScriptInput('toggle', () => setEnabled(!enabled));

// 新回合：隱藏圖片並重置冷卻
Instance.OnRoundStart(() => {
    ++generation;
    cooldownLeft = 0;
    hideAll();
});