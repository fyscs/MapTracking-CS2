// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, CSPlayerPawn, CSWeaponAttackType } from "cs_script/point_script";

// ============================================================
// 小羊坐騎（yarn mount）
// 撿起 yan_knife → 玩家隱形，小羊跟著玩家走；被攻擊 15 次羊被打爆
// 靜止 idle / 移動 run / 跳躍 jump / 右鍵 headbutt
// ============================================================

// ---- 可調整的設定 ----
const KNIFE_NAME = "yan_knife";    // Hammer 裡 weapon_knife 的名字
const SHEEP_NAME = "yarn_sheep";   // Hammer 裡 prop_dynamic 的名字
const YAW_OFFSET = 0;              // 小羊面向不對時改這裡：0 / 90 / 180 / -90
const SHEEP_SCALE = 1.0;           // 小羊大小倍率
const RUN_SPEED = 30;              // 水平速度超過這個值算「移動」（單位/秒）
const JUMP_TIME = 1.1;             // jump 動作長度（秒）
const HEADBUTT_TIME = 1.0;         // headbutt 動作長度（秒）
const HEADBUTT_COOLDOWN = 20.0;    // 頭槌冷卻（秒）
const HEADBUTT_TRIGGER = "yan_multiple"; // 頭槌時開關的實體（例如 trigger_multiple）
const TRIGGER_ON_DELAY = 0.5;      // 按右鍵後幾秒 Enable
const TRIGGER_ON_TIME = 0.3;       // Enable 之後幾秒 Disable
const THINK_INTERVAL = 0.05;       // 檢查間隔（秒）
const DEBUG = true;                // true 會在控制台印出狀態
const HITS_TO_BREAK = 15;          // 騎羊的人被攻擊幾「次」後羊被打爆（刀和槍都算一次，跟傷害量無關）
const HIT_MERGE_TIME = 0.1;        // 同一個攻擊者在這段時間內的多次傷害算同一次（例如霰彈槍一發多顆彈丸）
const RIDER_IMMUNE = true;         // true：騎羊期間玩家本身不會掉血（傷害都算在羊身上）
const VICTIM_NAME = "yan";         // 羊被打爆時，另外處死 targetname 為這個的玩家
const SHEEP_FADE_TIME = 1.5;       // 羊被打爆後淡出到完全透明的秒數（之後刪除）
const SHEEP_FADE_STEPS = 30;       // 淡出分幾段

// ---- 狀態 ----
/** @type {import("cs_script/point_script").CSPlayerPawn | undefined} */
let rider = undefined;
let currentAnim = "";
let lockUntil = 0;        // 播放一次性動作（jump/headbutt）時鎖住，時間到才切回
let nextHeadbutt = 0;

function log(msg) {
    if (DEBUG) Instance.Msg(`[yarn] ${msg}`);
}

function getSheep() {
    const e = Instance.FindEntityByName(SHEEP_NAME);
    return e && e.IsValid() ? e : undefined;
}

function getKnife() {
    const e = Instance.FindEntityByName(KNIFE_NAME);
    return e && e.IsValid() ? e : undefined;
}

function fire(target, input, value, delay = 0) {
    if (!target || !target.IsValid()) return;
    Instance.EntFireAtTarget({ target, input, value, delay });
}

/** 循環動作：設成 Idle Animation（循環）再播放，一次性動作結束後會自動回到它 */
function playLoop(name) {
    const sheep = getSheep();
    if (!sheep || currentAnim === name) return;
    fire(sheep, "SetAnimationLooping", name);   // 實測：會一直循環到切換動作為止
    currentAnim = name;
    log(`loop ${name}`);
}

/** 一次性動作：播放並鎖住一段時間 */
function playOnce(name, duration) {
    const sheep = getSheep();
    if (!sheep) return;
    fire(sheep, "SetAnimation", name);          // 實測：只播放一次
    currentAnim = name;
    lockUntil = Instance.GetGameTime() + duration;
    log(`once ${name}`);
}

function setPlayerVisible(pawn, visible) {
    if (!pawn || !pawn.IsValid()) return;
    fire(pawn, "Alpha", visible ? 255 : 0);
    const knife = getKnife();
    if (knife) fire(knife, "Alpha", visible ? 255 : 0);
}

/** 把小羊放到玩家腳下，並綁在玩家身上 */
function attachSheep(pawn) {
    const sheep = getSheep();
    if (!sheep) return;
    const pos = pawn.GetAbsOrigin();
    const ang = pawn.GetAbsAngles();
    sheep.SetParent(undefined);
    sheep.Teleport({
        position: { x: pos.x, y: pos.y, z: pos.z },
        angles: { pitch: 0, yaw: ang.yaw + YAW_OFFSET, roll: 0 },
    });
    sheep.SetParent(pawn);
    if (SHEEP_SCALE !== 1.0) sheep.SetModelScale(SHEEP_SCALE);
}

/** 小羊回到刀上（掉落、死亡、回合重置） */
function detachSheep() {
    const sheep = getSheep();
    if (!sheep) return;
    sheep.SetParent(undefined);
    const knife = getKnife();
    if (knife) {
        const p = knife.GetAbsOrigin();
        sheep.Teleport({ position: { x: p.x, y: p.y, z: p.z } });
        sheep.SetParent(knife);
    }
}

function mount(pawn) {
    if (rider && rider !== pawn) dismount();
    rider = pawn;
    kickThink();
    hitCount = 0;
    lastHitTime.clear();
    currentAnim = "";
    lockUntil = 0;
    setPlayerVisible(pawn, false);
    attachSheep(pawn);
    playLoop("idle");
    log("mounted");
}

function dismount() {
    if (rider) setPlayerVisible(rider, true);
    rider = undefined;
    currentAnim = "";
    lockUntil = 0;
    detachSheep();
    playLoop("idle");
    log("dismounted");
}

function isYarnKnife(weapon) {
    return !!weapon && weapon.IsValid() && weapon.GetEntityName() === KNIFE_NAME;
}

// ---- 騎羊的人被攻擊 15 次 → 羊被打爆：處死騎羊的人與 yan，羊淡出刪除 ----
let hitCount = 0;
let sheepBroken = false;
let allowKill = false;              // 腳本自己處死人時暫時不擋傷害
const lastHitTime = new Map();      // 攻擊者 → 上次算次數的時間

function killPawn(p) {
    if (!(p instanceof CSPlayerPawn) || !p.IsValid() || !p.IsAlive()) return;
    setPlayerVisible(p, true);   // 先把 alpha 調回 255 再處死（屍體也看得到）
    allowKill = true;
    p.TakeDamage({ damage: 999999 });
    allowKill = false;
}

function slayVictims() {
    if (rider) killPawn(rider);
    for (const e of Instance.FindEntitiesByName(VICTIM_NAME)) killPawn(e);
    log("slay rider / " + VICTIM_NAME);
}

let sheepFading = false;

/** 羊淡出到完全透明後刪除 */
function fadeOutSheep() {
    const sheep = getSheep();
    if (!sheep || sheepFading) return;
    sheepFading = true;
    for (let i = 1; i <= SHEEP_FADE_STEPS; i++) {
        const alpha = Math.round(255 * (1 - i / SHEEP_FADE_STEPS));
        fire(sheep, "Alpha", alpha, SHEEP_FADE_TIME * i / SHEEP_FADE_STEPS);
    }
    fire(sheep, "Kill", undefined, SHEEP_FADE_TIME + 0.05);
    log("sheep fade out");
}

function breakSheep() {
    if (sheepBroken) return;
    sheepBroken = true;
    slayVictims();
    fadeOutSheep();
}

/** 回傳 true 表示這次攻擊算進次數（同一攻擊者短時間內的多次傷害只算一次） */
function countHit(event) {
    if (sheepBroken || !rider || event.player !== rider) return false;
    const attacker = event.attacker;
    if (!(attacker instanceof CSPlayerPawn) || attacker === rider) return false;   // 只算其他玩家的攻擊（不算摔落、自己）
    const now = Instance.GetGameTime();
    const last = lastHitTime.get(attacker);
    if (last !== undefined && now - last < HIT_MERGE_TIME) return true;          // 同一次攻擊的其他彈丸：不加次數，但一樣擋傷害
    lastHitTime.set(attacker, now);
    hitCount++;
    log(`sheep hit ${hitCount}/${HITS_TO_BREAK}`);
    if (hitCount >= HITS_TO_BREAK) breakSheep();
    return true;
}

if (typeof Instance.OnBeforePlayerDamage === "function") {
    Instance.OnBeforePlayerDamage((event) => {
        if (allowKill) return;
        const counted = countHit(event);
        if (RIDER_IMMUNE && counted && !sheepBroken) return { abort: true };
    });
} else {
    // 舊版 API 沒有 OnBeforePlayerDamage：只能事後計次，無法擋傷害
    Instance.OnPlayerDamage((event) => { if (!allowKill) countHit(event); });
}

// ---- 每隔一段時間判斷要播哪個動作 ----
Instance.SetThink(() => {
    const now = Instance.GetGameTime();
    Instance.SetNextThink(now + THINK_INTERVAL);

    // 備援：不靠撿起事件，直接看 yarn_knife 現在在誰手上
    const knife = getKnife();
    const holder = knife ? knife.GetOwner() : undefined;
    if (holder instanceof CSPlayerPawn && holder.IsValid() && holder.IsAlive()) {
        if (rider !== holder) mount(holder);
    } else if (rider && knife) {
        dismount();
    }

    if (!rider) return;
    if (!rider.IsValid() || !rider.IsAlive()) {
        dismount();
        return;
    }

    // 小羊被意外解除綁定時重新綁回去
    const sheep = getSheep();
    if (sheep && sheep.GetParent() !== rider) attachSheep(rider);

    if (now < lockUntil) return;   // jump / headbutt 還在播

    const onGround = rider.GetGroundEntity() !== undefined;
    if (!onGround) {
        // 空中但不是自己跳的（例如掉下去），維持跑步
        playLoop("run");
        return;
    }
    const v = rider.GetAbsVelocity();
    const speed = Math.sqrt(v.x * v.x + v.y * v.y);
    playLoop(speed > RUN_SPEED ? "run" : "idle");
});

Instance.OnActivate(() => {
    Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);
});

// 腳本重新載入、或 OnActivate 沒觸發時也保證循環有在跑
function kickThink() {
    Instance.SetNextThink(Instance.GetGameTime() + THINK_INTERVAL);
}
kickThink();

// ---- 撿起 / 丟掉刀 ----
Instance.OnWeaponPickup(({ weapon }) => {
    if (weapon && weapon.IsValid()) log(`pickup name="${weapon.GetEntityName()}" class=${weapon.GetClassName()}`);
    if (!isYarnKnife(weapon)) return;
    const owner = weapon.GetOwner();
    if (owner instanceof CSPlayerPawn) mount(owner);
});

Instance.OnWeaponDrop(({ weapon }) => {
    if (!isYarnKnife(weapon)) return;
    dismount();
});

// ---- 跳躍 ----
Instance.OnPlayerJump(({ player }) => {
    if (player !== rider) return;
    if (Instance.GetGameTime() < lockUntil && currentAnim === "headbutt") return;   // 頭槌優先，播完才換
    playOnce("jump", JUMP_TIME);
});

Instance.OnPlayerLand(({ player }) => {
    if (player !== rider) return;
    if (currentAnim === "jump") lockUntil = 0;   // 落地就切回 idle/run
});

// ---- 右鍵頭槌（拿著這把刀按右鍵）----
Instance.OnKnifeAttack(({ weapon, attackType }) => {
    const owner = weapon && weapon.IsValid() ? weapon.GetOwner() : undefined;
    log(`knife attack name="${weapon && weapon.IsValid() ? weapon.GetEntityName() : "?"}" type=${attackType} rider=${!!rider} byRider=${!!rider && owner === rider}`);
    // 騎羊的人用任何一把刀按右鍵都算（不只認名字，避免刀被改名時失效）
    if (!rider || owner !== rider) return;
    if (attackType !== CSWeaponAttackType.SECONDARY) return;
    const now = Instance.GetGameTime();
    if (now < nextHeadbutt) {
        log(`headbutt cooldown ${(nextHeadbutt - now).toFixed(1)}s`);
        return;
    }
    nextHeadbutt = now + HEADBUTT_COOLDOWN;
    playOnce("headbutt", HEADBUTT_TIME);
    Instance.EntFireAtName({ name: HEADBUTT_TRIGGER, input: "Enable", delay: TRIGGER_ON_DELAY });
    Instance.EntFireAtName({ name: HEADBUTT_TRIGGER, input: "Disable", delay: TRIGGER_ON_DELAY + TRIGGER_ON_TIME });
});

// ---- 死亡 / 重生 / 新回合 ----
Instance.OnPlayerKill(({ player }) => {
    if (player === rider) dismount();
});

Instance.OnPlayerReset(({ player }) => {
    if (player === rider) dismount();
});

Instance.OnRoundStart(() => {
    kickThink();
    sheepFading = false;
    hitCount = 0;
    sheepBroken = false;
    lastHitTime.clear();
    rider = undefined;
    currentAnim = "";
    lockUntil = 0;
    nextHeadbutt = 0;
});
