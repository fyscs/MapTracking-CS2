// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, CSPlayerPawn } from "cs_script/point_script";

// 分组成员上限固定为 2。新增子分组时，在这里新增一个数组即可，例如 cp4: []。
// 每回合开始后，都要对脚本实体执行对应输入两次，重新加入两名玩家。
const groups = {
    cp1: [],// meru
    cp2: [],// nnan
    cp3: [],//
};

// 每个玩家每回合只能成功使用一次 @cptp。
const usedThisRound = new Set();

function getController(inputData) {
    const pawn = /** @type {CSPlayerPawn|undefined} */ (inputData.activator);
    const controller = pawn?.GetPlayerController();
    return controller && controller.IsValid() && controller.IsConnected()
        ? controller
        : undefined;
}

function getValidMembers(group) {
    return group.filter((controller) =>
        controller && controller.IsValid() && controller.IsConnected()
    );
}

// 每个子分组使用同名脚本输入：CP1、CP2、CP3。
// 对同一输入调用两次，分别加入该子分组的两名玩家。
for (const [groupName, members] of Object.entries(groups)) {
    Instance.OnScriptInput(groupName.toUpperCase(), (inputData) => {
        const controller = getController(inputData);
        if (!controller) return;

        // 同一玩家重复触发不占用另一个名额。
        if (members.includes(controller)) return;

        // 清除失效/已离线的控制器后再判断名额。
        for (let i = members.length - 1; i >= 0; i--) {
            const member = members[i];
            if (!member || !member.IsValid() || !member.IsConnected()) {
                members.splice(i, 1);
            }
        }

        if (members.length < 2) {
            members.push(controller);
        }
    });
}

Instance.OnRoundStart(() => {
    usedThisRound.clear();
    for (const members of Object.values(groups)) {
        members.length = 0;
    }
});

Instance.OnPlayerChat((event) => {
    if (event.text.trim().toLowerCase() !== "@cptp") return;

    const controller = event.player;
    if (!controller || !controller.IsValid() || !controller.IsConnected()) return;

    const pawn = controller.GetPlayerPawn();
    if (!pawn || !pawn.IsValid() || pawn.GetTeamNumber() !== 3) return; // CT
    if (usedThisRound.has(controller)) return;

    // 找到玩家所属子分组中登记的另一名在线玩家。
    let targetController;
    let registeredAlone = false;
    for (const members of Object.values(groups)) {
        const validMembers = getValidMembers(members);
        if (validMembers.includes(controller)) {
            targetController = validMembers.find((member) => member !== controller);
            registeredAlone = validMembers.length === 1;
            break;
        }
    }

    if (!targetController) {
        if (registeredAlone) {
            Instance.EntFireAtName({
                name: "cptp_say_relay",
                input: "Trigger",
                activator: pawn,
                caller: pawn,
            });
        }
        return;
    }
    const targetPawn = targetController.GetPlayerPawn();
    if (!targetPawn || !targetPawn.IsValid() || targetPawn.GetTeamNumber() !== 3) return;

    pawn.Teleport({
        position: targetPawn.GetAbsOrigin(),
        angles: targetPawn.GetEyeAngles(),
        velocity: { x: 0, y: 0, z: 0 },
    });
    usedThisRound.add(controller);
});



