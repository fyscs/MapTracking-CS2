import { CSGearSlot, CSPlayerController, CSPlayerPawn, CSWeaponType, Instance } from "cs_script/point_script";

Instance.OnScriptInput("use", ({ activator }) => {
    if (!activator?.IsValid()) {
        return;
    }

    const player = activator instanceof CSPlayerController
        ? activator.GetPlayerPawn()
        : activator;

    if (!(player instanceof CSPlayerPawn) || !player.IsValid()) {
        return;
    }

    const knife = player.FindWeaponBySlot(CSGearSlot.KNIFE);
    if (knife?.IsValid() && knife.GetData().GetType() === CSWeaponType.KNIFE) {
        player.DestroyWeapon(knife);
    }
});
