    width: 100%;
    height: 42px;
    text-align: center;
    font-size: 30px;
    font-weight: bold;
    color: #ff5252;
    text-shadow: 0px 1px 5px 2 #000000ee;
    white-space: nowrap;
    transition-property: color, brightness, transform;
    transition-duration: 0.18s;
}
.ArtifactStatus.Ready {
    color: #73e3b1;
    brightness: 1.08;
}
.ArtifactStatus.ReadyPulse {
    brightness: 2;
    transform: scale3d(1.18, 1.18, 1);
}
