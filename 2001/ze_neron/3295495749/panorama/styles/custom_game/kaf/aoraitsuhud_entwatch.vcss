#artifact_hud {
    width: 180px;
    height: 76px;
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 125px;
    flow-children: down;
    opacity: 1;
    transform: translate3d(0px, 0px, 0px);
    transition-property: opacity, transform;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
