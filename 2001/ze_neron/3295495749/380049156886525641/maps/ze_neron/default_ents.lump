      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:I remember now, that sound is from the head of this research institute, Brand.",
        "delay": 14,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:How did he end up like this?",
        "delay": 17,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:Karl, look at me. This is the teleportation project you vehemently denied at first.",
        "delay": 20,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:I\u0027ve successfully activated the teleportation portal.",
        "delay": 23,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:Despite having both my legs torn off by the creature inside and losing one hand to its bite.",
        "delay": 26,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:Luckily, I had a backup plan. I uploaded my consciousness to the network here.",
        "delay": 30,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:I can still manipulate everything here as a consciousness entity.",
        "delay": 34,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Brand:Now, I will make you experience my power.",
        "delay": 39,
        "limit": -1
      },
      {
        "output": "OnEntitySpawned",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:K!watch out",
        "delay": 43,
        "limit": -1
      },
