      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:Who blocked the entrance here? It seems we\u0027ll have to find another way out.",
        "delay": 0,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say K:Kiki....",
        "delay": 3,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:uh.Sorry? Did I talk too much?",
        "delay": 4,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:After all, you are the last investigator I\u0027m collaborating with.",
        "delay": 6,
