        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:I\u0027m feeling a bit restless.",
        "delay": 11,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say K:It\u0027s alright, just wanted to remind you to be more cautious. I have a feeling something is off.",
        "delay": 15,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:I will, K.",
        "delay": 18,
        "limit": 1
      },
      {
        "output": "OnStartTouch",
        "target": "[PR#]cmd",
        "input": "Command",
        "param": "say Kiki:This facility is truly remarkable, having such mysterious underground passages.",
        "delay": 40,
