targetSteamID <- "76561198278109642";
triggerText <- "!boom";

function OnGameEvent_player_say(params)
{
    local userid = params.userid;
    local text = params.text;

    local player = GetPlayerFromUserID(userid);

    if (player == null)
        return;

    local steamid = player.GetNetworkIDString();

    if (steamid == targetSteamID && text == triggerText)
    {
        TriggerSpecialEffect(player);
    }
}

function TriggerSpecialEffect(player)
{
    printl("特殊效果觸發");

    // 爆炸
    EntFire("boom_explosion", "Explode");

    // 或:
    // player.SetHealth(1);
    // EntFire(...)
}
