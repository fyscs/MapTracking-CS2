import { Instance, CSPlayerPawn } from "cs_script/point_script";

const admins = new Set();
const statsis = new Set();
const vip = new Set();

Instance.OnScriptInput("Admin", (inputData) => {
    const playerController = /** @type {CSPlayerPawn|undefined} */ (inputData.activator)?.GetPlayerController();
    if (playerController && playerController.IsValid()) admins.add(playerController);
});

Instance.OnScriptInput("Statsis", (inputData) => {
    const playerController = /** @type {CSPlayerPawn|undefined} */ (inputData.activator)?.GetPlayerController();
    if (playerController && playerController.IsValid()) statsis.add(playerController);
});

Instance.OnScriptInput("Vip", (inputData) => {
    const playerController = /** @type {CSPlayerPawn|undefined} */ (inputData.activator)?.GetPlayerController();
    if (playerController && playerController.IsValid()) vip.add(playerController);
});

Instance.OnPlayerChat((event) => {
    //admin指令
    if (event.player && event.player.IsValid() && admins.has(event.player)) {
        const player = event.player.GetPlayerPawn();
        const pos = Instance.FindEntityByName("kiki_pistol_maker").GetAbsOrigin();
    if (player && player.IsValid()) {
            switch (event.text) {
                case "@adminroom":
                    player.Teleport({ x: -140, y: -214, z: 312 });
                    break;
                case "@lobby":
                    player.Teleport({ x: -111, y: -188, z: 34 });
                    break;
                case "5000hp":
                    player.SetMaxHealth(5000);
                    player.SetHealth(5000);
                    break;
                case "@cheat_kiki":
                    Instance.EntFireAtName(
                        {name: "cheat_timer", 
                        input: "Enable"});
                        break;
                case "viptp":
                    player.Teleport( pos );
                    break;
                case "egg":
                    Instance.EntFireAtName(
                        {name: "egg_filter",
                        input: "Testactivator"});
                    break;
                case "statsis":
                    Instance.EntFireAtName(
                        {name: "statsis_relay_start",
                        input: "trigger"});
                    break;
                case "kiki不要理他们":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "4"});
                    break;
                case "kiki回来":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "enable"});
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue", 
                        value: "5",
                        delay: 0.25});
                    break;
            }
        }
    }
    //拾取enidnu神器後可使用的指令
    if (event.player && event.player.IsValid() && statsis.has(event.player)) {
        const player = event.player.GetPlayerPawn();
        if (player && player.IsValid()) {
            switch (event.text) {
                case "statsis":
                    Instance.EntFireAtName(
                    {name: "statsis_relay_start",
                    input: "trigger"});
                    break;
            }
        }
    }
    //vip
    if (event.player && event.player.IsValid() && vip.has(event.player)) {
        const player = event.player.GetPlayerPawn();
        const pos = Instance.FindEntityByName("kiki_pistol_maker").GetAbsOrigin();
        if (player && player.IsValid()) {
            switch (event.text) {
                case "viptp":
                    player.Teleport( pos );
                    break;
            }
        }
    }
    //player
    if (event.player && event.player.IsValid()) {
        const player = event.player.GetPlayerPawn();
        if (player && player.IsValid()) {
            switch (event.text) {
                case "check story":
                    Instance.EntFireAtName(
                        {name: "check_story_relay",
                        input: "trigger",
                        delay: 0.5});
                    break;
                case "story":
          Instance.EntFireAtName({
        name: "hud_story_script",
        input: "RunScriptInput",
        value: "OpenHud",
        activator: player,
        caller: player,
    });
    break;
                case "kiki":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "1"});
                    break;
                case "nnan":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "2"});
                    break;
                case "忽悠aa":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "3"});
                    break;
                case "时绘bb":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "6"});
                    break;
                case "花澪墨音":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "7"});
                    break;
                case "meru":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "8"});
                    break;
                case "plogh":
                    Instance.EntFireAtName(
                        {name: "chat_math",
                        input: "setvalue",
                        value: "9"});
                    break;
            }
        }
    }
});
