.Root {
    width: 100%;
    height: 100%;
    font-family: Stratum2, "Arial Unicode MS";
    color: #e9f2ff;
}
#story_dialog {
    width: 850px;
    height: 600px;
    horizontal-align: center;
    vertical-align: center;
    flow-children: down;
    padding: 26px;
    background-color: #080d18f2;
    border: 2px solid #7398bd;
    border-radius: 8px;
    box-shadow: #000000cc 0px 0px 28px 0px;
    opacity: 1;
    transition-property: opacity, transform;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
#story_dialog.Hidden {
    opacity: 0;
    transform: scale3d(0.97, 0.97, 1);
    visibility: collapse;
}
.HudHeader {
