}
.StoryButton {
    width: 148px;
    height: 210px;
    margin: 5px;
    flow-children: down;
    background-color: #15253be6;
    border: 1px solid #5e86ad;
    border-radius: 5px;
    box-shadow: #00000099 0px 3px 8px 0px;
    transition-property: background-color, border, brightness, transform;
    transition-duration: 0.08s;
}
.StoryButton:hover {
    background-color: #203d5de6;
    border: 1px solid #9bc8f2;
    brightness: 1.18;
    transform: translateY(-2px);
}
.StoryButton:active {
    brightness: 0.72;
