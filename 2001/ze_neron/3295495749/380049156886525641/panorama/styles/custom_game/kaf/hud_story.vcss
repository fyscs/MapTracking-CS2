    text-shadow: 0px 1px 4px 2 #000000cc;
}
#close_button {
    width: 86px;
    height: 42px;
    horizontal-align: right;
    vertical-align: center;
    background-color: #b72b38ee;
    border: 1px solid #ff717b;
    border-radius: 21px;
    transition-property: background-color, border, brightness;
    transition-duration: 0.08s;
}
#close_button:hover {
    background-color: #df3c49ee;
    border: 1px solid #ff9aa1;
    brightness: 1.2;
}
#close_button:active {
    brightness: 0.7;
}
.CloseText {
    horizontal-align: center;
