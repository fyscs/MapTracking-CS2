// Generated by StarDance
// https://github.com/Kxnrl

import { Instance, Entities } from "cs_script/point_script";

let h_Heal = 200;
let h_Armor = 100;
let h_Button = "heal_button";
let h_Script = "heal_script";
let h_fImmunity = "Block_ZM_Dmg";
let h_mAmmo = 150;
let h_Radius = 256;
let h_Duration = 8.00;
let h_sDuration = h_Duration;
let h_Tick = 0.01;

const Player_M = new Map();
let lastTime = null;

Instance.OnRoundStart(() => {
    lastTime = null;
});

Instance.OnScriptInput("Heal", () => {
    let button_h = Entities.FindByName(h_Button)[0];
    let players = Entities.FindByClass("player");
    if(players.length > 0 && button_h?.IsValid())
    {
        if(h_Duration > 0.00)
        {
            let currentTime = Instance.GetGameTime();
            if(lastTime === null) 
            {
                lastTime = currentTime;
            }

            let deltaTime = currentTime - lastTime;
            lastTime = currentTime;

            for(let i = 0; i < players.length; i++)
            {
                let player = players[i];
                if(IsValidEntityTeam(player, 3))
                {
                    if(VectorDistance(player.GetAbsOrigin(), button_h.GetAbsOrigin()) <= h_Radius)
                    {
                        player.FireInput({ input: "SetDamageFilter", value: ""+h_fImmunity });
                        player.FireInput({ input: "IgniteLifetime", value: "0" });
                        player.SetHealth(h_Heal);
                        player.SetArmor(h_Armor);
                        let player_weapon = player.GetActiveWeapon();
                        player_weapon.FireInput({ input: "SetAmmoAmount", value: ""+h_mAmmo });
                        Player_M.set(player, player);
                    }
                    let player_h = Player_M.get(player);
                    if(player_h?.IsValid())
                    {
                        if(VectorDistance(player_h.GetAbsOrigin(), button_h.GetAbsOrigin()) > h_Radius)
                        {
                            player_h.FireInput({ input: "SetDamageFilter", value: "", delay: 0.00 });
                            Player_M.delete(player_h);
                        }
                    }
                }
            }
            h_Duration -= deltaTime;
            Entities.FireInput({ name: h_Script, input: "RunScriptInput", value: "Heal", delay: h_Tick });
        }
        else
        {
            ClearDamageFilter();
        }
    }
});

function ClearDamageFilter()
{
    for(const [key, value] of Player_M) 
    {
        if(value?.IsValid())
        {
            value.FireInput({ input: "SetDamageFilter", value: "", delay: 0.00 });
        }
        
    }
    Player_M.clear();
    h_Duration = h_sDuration;
    lastTime = null;
}

function IsValidEntityTeam(ent, t)
{
    if(ent?.IsValid() && ent?.IsAlive() && ent?.GetTeamNumber() == t)
    {
        return true;
    }
    return false;
}

function VectorDistance(vec1, vec2) 
{
    const dx = vec1.x - vec2.x;
    const dy = vec1.y - vec2.y;
    const dz = vec1.z - vec2.z;

    return Math.sqrt(dx * dx + dy * dy + dz * dz);
}