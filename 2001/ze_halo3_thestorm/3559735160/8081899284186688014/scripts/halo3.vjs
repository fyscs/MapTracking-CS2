    ending_npc_killed = 0;
    skulls_collected = 0;
    block_zombie_items = false;
    CREDITS = false;
    CREDITS_END = false;

    plasma_charge = [];
    players_blocked_item = [];
    Items = [];

    NPCS.forEach(npc => {
        if (npc.interval) {
            clearInterval(npc.interval);
        }
    });

    NPCS = [];

    registerGruntButtons();
    setup_models();
    setup_kz();
    setup_level();
    setup_block_item_zones();
    setup_ending_requirement();
    loadSaveData();
});

Instance.OnRoundEnd((winningTeam) => {
