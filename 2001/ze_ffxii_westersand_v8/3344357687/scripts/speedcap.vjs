import { Instance } from "cs_script/point_script";

let SCRIPT = undefined;
const SPEED_CAP = 400;

Instance.OnScriptInput("ChangeSpeed", ({caller, activator}) => {
    const player = caller;
    if(player?.IsValid()){
        const velocity = player?.GetAbsVelocity();
        if (!velocity) return;
        const speed = VectorValue2D(velocity);
        if (speed < SPEED_CAP) return;

        const direction = Normalize2D(velocity);
        const newVelocity = {
            x: direction.x * SPEED_CAP,
            y: direction.y * SPEED_CAP,
            z: velocity.z
        };
        player?.Teleport({ velocity: newVelocity });
    }
});

Instance.OnPlayerJump((event) => {
    const player = event.player;
    if(player?.IsValid()){
        const velocity = player?.GetAbsVelocity();
        if (!velocity) return;
        const speed = VectorValue2D(velocity);
        if (speed < SPEED_CAP) return;
        Instance.EntFireAtTarget({ target: SCRIPT, input: "RunScriptInput", value: "ChangeSpeed", caller: player });
    }
});

Instance.OnRoundStart(() => {
    SCRIPT = Instance.FindEntityByName("Map_Script");
});

Instance.OnRoundEnd(() => {
    SCRIPT = undefined;
});

function VectorValue2D(vec)  {
    return Math.sqrt(vec.x * vec.x + vec.y * vec.y);
}

function Normalize2D(vec) {
    const value = VectorValue2D(vec);

    if (value === 0) {
        return { x: 0, y: 0 };
    }

    return {
        x: vec.x / value,
        y: vec.y / value
    };
}