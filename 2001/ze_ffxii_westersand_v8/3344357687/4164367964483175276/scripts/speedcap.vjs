// Generated by StarDance
// https://github.com/Kxnrl

import { Instance } from "cs_script/point_script";

// ===== 预设档位 =====
const PRESETS = {
    "SpeedCap_Off": -1,      // 关闭
    "SpeedCap_400": 400,     // 默认
    "SpeedCap_500": 500,
    "SpeedCap_600": 600,
    "SpeedCap_700": 700,
    "SpeedCap_800": 800,
};

let SPEED_CAP = -1;         

function VectorValue2D(vec) {
    return Math.sqrt(vec.x * vec.x + vec.y * vec.y);
}

function Normalize2D(vec) {
    const value = VectorValue2D(vec);
    if (value === 0) return { x: 0, y: 0 };
    return { x: vec.x / value, y: vec.y / value };
}

Object.entries(PRESETS).forEach(([name, value]) => {
    Instance.OnScriptInput(name, () => {
        SPEED_CAP = value;
        if (SPEED_CAP < 0) {
            Instance.Msg(`say [SpeedCap] Script disabled`);
        } else {
            Instance.Msg(`say [SpeedCap] Set to ${SPEED_CAP}`);
        }
    });
});

Instance.OnPlayerJump((event) => {
    if (SPEED_CAP < 0) return;

    const player = event.player;
    if (!player?.IsValid()) return;

    const velocity = player.GetAbsVelocity();
    if (!velocity) return;

    const speed = VectorValue2D(velocity);
    if (speed < SPEED_CAP) return;

    const direction = Normalize2D(velocity);

    const cappedHorizontal = {
        x: direction.x * SPEED_CAP,
        y: direction.y * SPEED_CAP
    };

    Instance.QueueAfterThinks(() => {
        if (!player.IsValid()) return;
        const currentVel = player.GetAbsVelocity();
        if (!currentVel) return;
        player.Move({
            velocity: {
                x: cappedHorizontal.x,
                y: cappedHorizontal.y,
                z: currentVel.z   
            }
        });
    });
});