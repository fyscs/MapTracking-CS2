(function (Instance) {

const HUD_ENTITY_NAME = "music_lyrics";   
const MUSIC_ENTITY    = "Music_HOLLOW_WORLD_LYRICS";     
const PLAY_MUSIC      = false;              
const JP_SLOTS = 41;                        
const CN_SLOTS = 20;                        
const NO_ANIM_HOLD  = 0.06;                 
const END_HIDE_DELAY = 1.5;                 
const LINE_HIDE_DELAY = 3.0;                

let hud = null;
let playing = false;
let playRun = 0;
let songStart = 0;
let events = [];
let evIdx = 0;

const FILL_STEPS = 25;                      
const STEP_DT    = 0.04;                    
const jpFill = [];                          
const cnFill = [];
for (let i = 0; i <= JP_SLOTS; i++) jpFill.push(0);
for (let i = 0; i <= CN_SLOTS; i++) cnFill.push(0);
let curLine = -1;                           

function cls(id, name, on) {
    if (hud && hud.IsValid()) hud.SetHasClass(id, name, on);
}

function setText(prefix, i, ch) {
    if (!hud || !hud.IsValid()) return;
    if (ch === "") ch = " ";   

const v = prefix + "_c" + i;
    hud.SetDialogVariableString(prefix + "_slot_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_base_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_top_" + i, v, ch);
}

function setJpSize(count, isEng) {
    cls("hw_lyric_jp", "Eng", !!isEng);
    cls("hw_lyric_jp", "SizeB", !isEng && count > 20 && count <= 30);
    cls("hw_lyric_jp", "SizeC", !isEng && count > 30);
}

function engWidthClass(ch) {
    const code = ch.charCodeAt(0);
    if (code >= 65 && code <= 90) {         
        if (code === 77 || code === 87) return "EW-w";   
        if (code === 73 || code === 74) return "EW-n";   
        return "EW-m";
    }
    if (code >= 97 && code <= 122) {        
        if (code === 109 || code === 119) return "EW-w"; 
        if ("iljtf".indexOf(ch) >= 0) return "EW-n";
        return "EW-m";
    }
    if (ch === "." || ch === "," || ch === "'" || ch === "!" || ch === ":" || ch === ";") return "EW-n";
    return "EW-m";                           
}

function showLine(idx) {
    const line = LYRICS[idx];
    curLine = idx;
    cls("hw_Re_Am_i_root", "Visible", true);   

for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
    for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);

const jpN = Math.min(line.jp.length, JP_SLOTS);
    const cnN = Math.min(line.cn.length, CN_SLOTS);
    try {
        for (let i = 1; i <= JP_SLOTS; i++) {
            const used = i <= jpN;
            cls("hw_jp_slot_" + i, "Hidden", !used);

const isSpc = used && line.jp[i - 1][2] === " ";
            cls("hw_jp_slot_" + i, "Spc", isSpc);

const ew = (used && !isSpc) ? engWidthClass(line.jp[i - 1][2]) : "";
            cls("hw_jp_slot_" + i, "EW-n", ew === "EW-n");
            cls("hw_jp_slot_" + i, "EW-m", ew === "EW-m");
            cls("hw_jp_slot_" + i, "EW-w", ew === "EW-w");
            setText("hw_jp", i, used ? line.jp[i - 1][2] : " ");
        }
        for (let i = 1; i <= CN_SLOTS; i++) {
            const used = i <= cnN;
            cls("hw_cn_slot_" + i, "Hidden", !used);
            setText("hw_cn", i, used ? line.cn[i - 1][2] : " ");
        }
    } catch (e) {
        log("[HOLLOW_WORLD_LYRICS] 写字异常: " + e);
    }

let asciiCnt = 0, letterCnt = 0;
    for (let k = 0; k < line.jp.length && k < JP_SLOTS; k++) {
        const ch = line.jp[k][2];
        if (!ch || ch === " ") continue;
        letterCnt++;
        const code = ch.charCodeAt(0);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) asciiCnt++;
    }
    setJpSize(jpN, letterCnt > 0 && asciiCnt * 2 > letterCnt);
}

function setFillStep(isJp, slotIdx, step) {
    if (step < 0) step = 0;
    if (step > FILL_STEPS) step = FILL_STEPS;
    const arr = isJp ? jpFill : cnFill;
    if (arr[slotIdx] === step) return;
    const clipId = (isJp ? "hw_jp_clip_" : "hw_cn_clip_") + slotIdx;
    if (arr[slotIdx] > 0) cls(clipId, "F" + arr[slotIdx], false);
    if (step > 0) cls(clipId, "F" + step, true);
    arr[slotIdx] = step;
}

function addFillEvents(c, slot, isJp, lineIdx) {
    const dur = c[1] - c[0];
    if (dur <= 0.001) {
        events.push({ t: c[0], p: 1, fn: ((s2, j2, li) => () => { if (li === curLine) setFillStep(j2, s2, FILL_STEPS); })(slot, isJp, lineIdx) });
        return;
    }
    let n = Math.round(dur / STEP_DT);
    if (n < 4) n = 4;
    if (n > FILL_STEPS) n = FILL_STEPS;
    const dt = dur / n;
    for (let i = 1; i <= n; i++) {
        const step = Math.round(i * FILL_STEPS / n);
        events.push({ t: c[0] + i * dt, p: 1, fn: ((s2, j2, st, li) => () => { if (li === curLine) setFillStep(j2, s2, st); })(slot, isJp, step, lineIdx) });
    }
}

function makeLineHide(li) {
    return function () {
        if (li === curLine) cls("hw_Re_Am_i_root", "Visible", false);
    };
}

function buildEvents() {
    events = [];
    for (let i = 0; i < LYRICS.length; i++) {
        const line = LYRICS[i];
        events.push({ t: line.t0, p: 0, fn: (li => () => showLine(li))(i) });
        for (let k = 0; k < line.jp.length; k++) addFillEvents(line.jp[k], k + 1, true, i);

if (line.cn.length > 0 && line.jp.length > 0) {
            const jpS = line.jp[0][0];
            let jpE = jpS;
            for (const c of line.jp) if (c[1] > jpE) jpE = c[1];
            const cnS = line.cn[0][0];
            let cnE = cnS;
            for (const c of line.cn) if (c[1] > cnE) cnE = c[1];
            const k2 = (cnE > cnS && jpE > jpS) ? (jpE - jpS) / (cnE - cnS) : 1;
            for (let k = 0; k < line.cn.length; k++) {
                const c = line.cn[k];
                addFillEvents(k2 === 1 ? c : [jpS + (c[0] - cnS) * k2, jpS + (c[1] - cnS) * k2, c[2]], k + 1, false, i);
            }
        } else {
            for (let k = 0; k < line.cn.length; k++) addFillEvents(line.cn[k], k + 1, false, i);
        }

let lineEnd = line.t0;
        for (const c of line.jp) if (c[1] > lineEnd) lineEnd = c[1];
        events.push({ t: lineEnd + LINE_HIDE_DELAY, p: 2, fn: makeLineHide(i) });
    }

const last = LYRICS[LYRICS.length - 1];
    let end = last.t0;
    for (const c of last.jp) if (c[1] > end) end = c[1];
    for (const c of last.cn) if (c[1] > end) end = c[1];
    events.push({ t: end + END_HIDE_DELAY, p: 2, fn: () => { stopInternal(false); } });
    events.sort((a, b) => (a.t - b.t) || (a.p - b.p));
}

function onThink() {
    if (!playing) return;
    const gt = Instance.GetGameTime();
    const now = gt - songStart;
    while (evIdx < events.length && events[evIdx].t <= now) {
        try {
            events[evIdx].fn();
        } catch (e) {
            log("[HOLLOW_WORLD_LYRICS] 事件异常 idx=" + evIdx + ": " + e);
        }
        evIdx++;
    }

if (evIdx < events.length) {
        const nextT = songStart + events[evIdx].t;
        Instance.SetNextThink(nextT > gt + 0.02 ? nextT : gt + 0.02);
    }
}

function stopInternal(stopMusic) {
    playing = false;
    curLine = -1;                   
    evIdx = events.length;
    const run = ++playRun;          
    if (stopMusic && PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StopSound" });
    }
    if (hud && hud.IsValid()) {

for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
        for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);
        for (let i = 1; i <= JP_SLOTS; i++) { cls("hw_jp_slot_" + i, "Hidden", true); setText("hw_jp", i, " "); }
        for (let i = 1; i <= CN_SLOTS; i++) { cls("hw_cn_slot_" + i, "Hidden", true); setText("hw_cn", i, " "); }
        cls("hw_Re_Am_i_root", "Visible", false);
    }
}

function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        log("[HOLLOW_WORLD_LYRICS] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

Instance.OnScriptInput("start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;

stopInternal(false);            
    playRun++;

if (PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StartSound" });
    }

cls("hw_Re_Am_i_root", "Visible", true);
    playing = true;
    songStart = Instance.GetGameTime();
    buildEvents();
    evIdx = 0;
    Instance.SetNextThink(Instance.GetGameTime() + 0.02);

log("[HOLLOW_WORLD_LYRICS] start，共 " + LYRICS.length + " 行歌词，首事件 t=" + events[0].t);
});

Instance.OnScriptInput("stop", () => {
    stopInternal(true);
    log("[HOLLOW_WORLD_LYRICS] stop");
});

Instance.OnRoundStart(() => {
    stopInternal(true);
});

const LYRICS = [
    { t0:17.12, jp:[[17.12,17.18,"I"],[17.18,17.24,"n"],[17.24,17.3," "],[17.3,17.336,"t"],[17.336,17.372,"h"],[17.372,17.408,"i"],[17.408,17.444,"s"],[17.444,17.48," "],[17.48,17.585,"p"],[17.585,17.69,"l"],[17.69,17.795,"a"],[17.795,17.9,"c"],[17.9,18.005,"e"],[18.005,18.11," "],[18.11,18.29,"i"],[18.29,18.47," "],[18.47,18.528,"h"],[18.528,18.586,"a"],[18.586,18.644,"v"],[18.644,18.702,"e"],[18.702,18.76," "],[18.76,18.963,"t"],[18.963,19.167,"o"],[19.167,19.37," "],[19.37,19.52,"s"],[19.52,19.67,"t"],[19.67,19.82,"a"],[19.82,21.1,"y"]], cn:[[17.12,17.452,"我"],[17.452,17.783,"是"],[17.783,18.115,"否"],[18.115,18.447,"，"],[18.447,18.778,"必"],[18.778,19.11,"须"],[19.11,19.442,"困"],[19.442,19.773,"守"],[19.773,20.105,"于"],[20.105,20.437,"此"],[20.437,20.768,"地"],[20.768,21.1,"？"]] },
    { t0:21.1, jp:[[21.1,21.16,"M"],[21.16,21.22,"y"],[21.22,21.28," "],[21.28,21.424,"m"],[21.424,21.569,"e"],[21.569,21.713,"m"],[21.713,21.857,"o"],[21.857,22.001,"r"],[22.001,22.146,"y"],[22.146,22.29," "],[22.29,22.4,"w"],[22.4,22.51,"e"],[22.51,22.62,"a"],[22.62,22.73,"r"],[22.73,22.84,"i"],[22.84,22.95,"n"],[22.95,23.06,"g"],[23.06,23.17," "],[23.17,23.347,"o"],[23.347,23.523,"f"],[23.523,24.93,"f"]], cn:[[21.1,21.526,"记"],[21.526,21.951,"忆"],[21.951,22.377,"正"],[22.377,22.802,"缓"],[22.802,23.228,"缓"],[23.228,23.653,"剥"],[23.653,24.079,"落"],[24.079,24.504,"消"],[24.504,24.93,"散"]] },
