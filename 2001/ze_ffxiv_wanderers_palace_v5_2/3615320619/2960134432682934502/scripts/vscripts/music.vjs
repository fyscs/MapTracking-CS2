    [87.1,[[87.1,100]],0.0], 
];

const RF_END_T = 97.1;                      

let kwRootShown = false;
let kwRootHideTok = 0;

function kwRootShow() {
    const tok = ++kwRootHideTok;           
    kwRootShown = true;

cls("Kw_root", "Visible", false);
    cls("Kw_root", "FadeOut", true);       
    Instance.Delay(0.02).then(() => {
        if (tok !== kwRootHideTok) return;  
        cls("Kw_root", "FadeOut", false);   
        cls("Kw_root", "Visible", true);
    });
}

function kwRootHide() {
    const tok = ++kwRootHideTok;
    if (!kwRootShown) {                    
        cls("Kw_root", "Visible", false);
        cls("Kw_root", "FadeOut", false);
        return;
    }
    kwRootShown = false;
    cls("Kw_root", "Visible", false);
    cls("Kw_root", "FadeOut", true);       
    Instance.Delay(KW_FADE + 0.02).then(() => {
        if (tok !== kwRootHideTok) return;
        cls("Kw_root", "FadeOut", false);  
    });
}

function setKwSweep(u, p) {
    if (p < 0) p = 0;
    if (p > 400) p = 400;
    const sw = "Kw_sweep_" + u;

if (kwCurW[u] !== undefined) cls(sw, "W" + kwCurW[u], false);
    if (p > 0) cls(sw, "W" + p, true);
    const dm = "Kw_dim_" + u;
    if (kwCurD[u] !== undefined) cls(dm, "W" + kwCurD[u], false);
    cls(dm, "W" + p, true);
    kwCurW[u] = p;
    kwCurD[u] = p;
}

let kwShowTok = 0;

function kwHideBox(i) {
    cls("Kw_box_" + i, "Hidden", true);
    cls("Kw_box_" + i, "FadeOut", false);
}

function kwShowUnit(u) {
    const prev = kwUnitNow;
    const tok = ++kwShowTok;

for (let i = 1; i <= KW_UNITS.length; i++) {
        if (i === u || i === prev) continue;
        kwHideBox(i);
    }

if (prev && prev !== u) {
        cls("Kw_box_" + prev, "Hidden", false);
        cls("Kw_box_" + prev, "FadeOut", true);
        const pv = prev;
        Instance.Delay(KW_FADE + 0.02).then(() => {
            if (kwUnitNow === pv) return;
            kwHideBox(pv);
        });
    }

const box = "Kw_box_" + u;
    if (prev === u) {
        cls(box, "Hidden", false);
        cls(box, "FadeOut", false);
    } else {
        cls(box, "Hidden", false);
        cls(box, "FadeOut", true);
        Instance.Delay(0.02).then(() => {
            if (tok !== kwShowTok) return;
            cls(box, "FadeOut", false);
        });
    }

if (kwCurW[u] !== undefined) cls("Kw_sweep_" + u, "W" + kwCurW[u], false);
    if (kwCurD[u] !== undefined) cls("Kw_dim_" + u, "W" + kwCurD[u], false);
    kwCurW[u] = 0;
    kwCurD[u] = 0;
    cls("Kw_dim_" + u, "W0", true);       
    kwUnitNow = u;
}

function kwResetBoxes() {
    for (let i = 1; i <= KW_UNITS.length; i++) {
        kwHideBox(i);
        if (kwCurW[i] !== undefined) cls("Kw_sweep_" + i, "W" + kwCurW[i], false);
        if (kwCurD[i] !== undefined) cls("Kw_dim_" + i, "W" + kwCurD[i], false);
        kwCurW[i] = 0;
        kwCurD[i] = 0;
    }
    kwUnitNow = 0;
}

function kwBuild() {
    kwEvents = [];
    for (let i = 0; i < KW_UNITS.length; i++) {
        const n = i + 1;
        const showT = KW_UNITS[i][0];
        kwEvents.push({ t: showT, fn: ((nn) => () => {
            kwRootShow();
            kwShowUnit(nn);
        })(n) });
        for (const e of KW_UNITS[i][1]) {
            kwEvents.push({ t: e[0], fn: ((nn, p) => () => {
                if (kwUnitNow === nn) setKwSweep(nn, p);
            })(n, e[1]) });
        }

const hideT = KW_UNITS[i][2];
        if (hideT > 0) {
            const fadeT = hideT - KW_FADE;
            kwEvents.push({ t: fadeT > 0 ? fadeT : hideT, fn: ((nn) => () => {
                if (kwUnitNow === nn) kwRootHide();
            })(n) });
        }
    }

kwEvents.push({ t: KW_END_T - KW_FADE, fn: () => { kwStop("时间轴播完 KW_END_T"); } });
    kwEvents.sort((a, b) => a.t - b.t);
}

function kwStop(reason) {
    if (kwPlaying) {
        log("[MUSIC_LYRICS] StarRingChild 停止（" + (reason || "未说明原因") + "）");
    }
    kwPlaying = false;
    kwIdx = kwEvents.length;
    kwRootHide();                          
}

function rfHideBox(i) {
    cls("Rf_box_" + i, "Hidden", true);
    cls("Rf_box_" + i, "FadeOut", false);
}

function rfShowUnit(u) {
    const prev = rfUnitNow;
    const tok = ++rfShowTok;

for (let i = 1; i <= RF_UNITS.length; i++) {
        if (i === u || i === prev) continue;
        rfHideBox(i);
    }

if (prev && prev !== u) {
        cls("Rf_box_" + prev, "Hidden", false);
        cls("Rf_box_" + prev, "FadeOut", true);
        const pv = prev;
        Instance.Delay(KW_FADE + 0.02).then(() => {
            if (rfUnitNow === pv) return;
            rfHideBox(pv);
        });
    }

const box = "Rf_box_" + u;
    if (prev === u) {
        cls(box, "Hidden", false);
        cls(box, "FadeOut", false);
    } else {
        cls(box, "Hidden", false);
        cls(box, "FadeOut", true);
        Instance.Delay(0.02).then(() => {
            if (tok !== rfShowTok) return;
            cls(box, "FadeOut", false);
        });
    }

if (rfCurW[u] !== undefined) cls("Rf_sweep_" + u, "W" + rfCurW[u], false);
    if (rfCurD[u] !== undefined) cls("Rf_dim_" + u, "W" + rfCurD[u], false);
    rfCurW[u] = 0;
    rfCurD[u] = 0;
    cls("Rf_dim_" + u, "W0", true);       
    rfUnitNow = u;
}

function rfResetBoxes() {
    for (let i = 1; i <= RF_UNITS.length; i++) {
        rfHideBox(i);
        if (rfCurW[i] !== undefined) cls("Rf_sweep_" + i, "W" + rfCurW[i], false);
        if (rfCurD[i] !== undefined) cls("Rf_dim_" + i, "W" + rfCurD[i], false);
        rfCurW[i] = 0;
        rfCurD[i] = 0;
    }
    rfUnitNow = 0;
}

function rfSetSweep(u, p) {
    if (p < 0) p = 0;
    if (p > 400) p = 400;
    const sw = "Rf_sweep_" + u;
    if (rfCurW[u] !== undefined) cls(sw, "W" + rfCurW[u], false);
    if (p > 0) cls(sw, "W" + p, true);
    const dm = "Rf_dim_" + u;
    if (rfCurD[u] !== undefined) cls(dm, "W" + rfCurD[u], false);
    cls(dm, "W" + p, true);
    rfCurW[u] = p;
    rfCurD[u] = p;
}

function rfBuild() {
    rfEvents = [];
    for (let i = 0; i < RF_UNITS.length; i++) {
        const n = i + 1;
        const showT = RF_UNITS[i][0];
        rfEvents.push({ t: showT, fn: ((nn) => () => {
            kwRootShow();
            rfShowUnit(nn);
        })(n) });
        for (const e of RF_UNITS[i][1]) {
            rfEvents.push({ t: e[0], fn: ((nn, p) => () => {
                if (rfUnitNow === nn) rfSetSweep(nn, p);
            })(n, e[1]) });
        }

const hideT = RF_UNITS[i][2];
        if (hideT > 0) {
            const fadeT = hideT - KW_FADE;
            rfEvents.push({ t: fadeT > 0 ? fadeT : hideT, fn: ((nn) => () => {
                if (rfUnitNow === nn) kwRootHide();
            })(n) });
        }
    }

rfEvents.push({ t: RF_END_T - KW_FADE, fn: () => { rfStop("时间轴播完 RF_END_T"); } });
    rfEvents.sort((a, b) => a.t - b.t);
}

function rfStop() {
    rfPlaying = false;
    rfIdx = rfEvents.length;
    kwRootHide();
}

Instance.OnScriptInput("StarRingChild_start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;

rfStop("切到第一首 StarRingChild");
    rfResetBoxes();
    kwStop("重新开始第一首");
    kwResetBoxes();          
    kwBuild();
    kwIdx = 0;
    kwCurW = new Array(KW_UNITS.length + 1).fill(0);
    kwCurD = new Array(KW_UNITS.length + 1).fill(0);
    kwPlaying = true;
    kwStart = Instance.GetGameTime();
    kickThink();
    log("[MUSIC_LYRICS] StarRingChild start，共 " + KW_UNITS.length + " 个单元");
});

Instance.OnScriptInput("StarRingChild_end", () => {
    kwStop("收到 StarRingChild_end 输入");
    log("[MUSIC_LYRICS] StarRingChild end");
});

Instance.OnScriptInput("refrain_start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;

kwStop("切到第二首 Ref_rain");
    kwResetBoxes();
    rfStop("重新开始第二首");
    rfResetBoxes();
    rfBuild();
    rfIdx = 0;
    rfCurW = new Array(RF_UNITS.length + 1).fill(0);
    rfCurD = new Array(RF_UNITS.length + 1).fill(0);
    rfPlaying = true;
    rfStart = Instance.GetGameTime();

if (RF_UNITS.length > 0) {
        kwRootShow();
        rfShowUnit(1);
    }
    kickThink();
    log("[MUSIC_LYRICS] refrain start，共 " + RF_UNITS.length + " 个单元");
});

Instance.OnScriptInput("refrain_end", () => {
    rfStop("收到 refrain_end 输入");
    log("[MUSIC_LYRICS] refrain end");
});

Instance.OnRoundStart(() => {

kwStop("回合开始重置（OnRoundStart）");
    rfStop("回合开始重置（OnRoundStart）");
});

Instance.OnScriptInput("kwdebug2", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    try {
        kwRootShow();
        hud.SetHasClass("Kw_dbg", "Hidden", false);
        log("[MUSIC_LYRICS] kwdebug2：应看到 KW-STRUCT-ALIVE 黄字");
    } catch (e) { log("[MUSIC_LYRICS] kwdebug2 ERR: " + e); }
});

Instance.OnScriptInput("kwdebug", () => {
    if (!hud || !hud.IsValid()) findHud();
    let info = "hud=" + (hud ? "found" : "NULL");
    if (hud) {
        try { info += " class=[" + hud.GetClassname() + "]"; } catch (e) { info += " classERR=" + e; }
        try { info += " name=[" + hud.GetName() + "]"; } catch (e) { info += " nameERR=" + e; }
        try { info += " valid=" + hud.IsValid(); } catch (e) { info += " validERR=" + e; }
    }
    log("[MUSIC_LYRICS] kwdebug: " + info);
    if (!hud) return;
    try {
        kwRootShow();
        log("[MUSIC_LYRICS] kwdebug: Kw_root Visible -> OK");
    } catch (e) { log("[MUSIC_LYRICS] kwdebug: Kw_root ERR: " + e); }
    try {
        kwShowUnit(1);
        log("[MUSIC_LYRICS] kwdebug: Kw_box_1 显示 -> OK");
    } catch (e) { log("[MUSIC_LYRICS] kwdebug: Kw_box_1 ERR: " + e); }
    try {
        hud.SetHasClass("Kw_sweep_1", "W400", true);
        log("[MUSIC_LYRICS] kwdebug: Kw_sweep_1 W400 -> OK");
    } catch (e) { log("[MUSIC_LYRICS] kwdebug: Kw_sweep_1 ERR: " + e); }
    try {
        hud.SetHasClass("NoSuchPanelX", "Visible", true);
        log("[MUSIC_LYRICS] kwdebug: 假面板ID测试 -> 无异常（说明ID不存在时不报错）");
    } catch (e) { log("[MUSIC_LYRICS] kwdebug: 假面板ID测试 -> 抛异常: " + e); }
});

for (let i = 1; i <= KW_UNITS.length; i++) {
    Instance.OnScriptInput("kwunit" + i, ((nn) => () => {
        if (!hud || !hud.IsValid()) findHud();
        if (!hud) return;
        kwRootShow();
        kwShowUnit(nn);
        setKwSweep(nn, 400);
        log("[MUSIC_LYRICS] kwunit" + nn + "：v7 应看到该单元整行红图（若控制台没有 v7 字样说明地图没重开，跑的是旧文件）");
    })(i));
}

Instance.OnScriptInput("kwtest", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    kwRootShow();
    kwShowUnit(1);
    setKwSweep(1, 200);
    log("[MUSIC_LYRICS] kwtest：第1单元左半红右半白");
});

Instance.OnScriptInput("kwfull", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    kwRootShow();
    kwShowUnit(1);
    setKwSweep(1, 400);
    log("[MUSIC_LYRICS] kwfull：第1单元双层完全重叠，不应露白");
});

Instance.OnScriptInput("kwdimonly", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    kwRootShow();
    kwShowUnit(1);
    setKwSweep(1, 0);
    hud.SetHasClass("Kw_dim_1", "Hidden", false);
    log("[MUSIC_LYRICS] kwdimonly：只应看到白图");
});
Instance.OnScriptInput("kwredonly", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;
    kwRootShow();
    kwShowUnit(1);
    hud.SetHasClass("Kw_dim_1", "Hidden", true);
    setKwSweep(1, 400);
    log("[MUSIC_LYRICS] kwredonly：只应看到红图");
});

})(makeSandbox(""));

(function (Instance) {

const HUD_ENTITY_NAME = "music_lyrics";   
const MUSIC_ENTITY    = "Music_Cold_Sun";     
const PLAY_MUSIC      = false;              
const JP_SLOTS = 41;                        
const CN_SLOTS = 20;                        
const NO_ANIM_HOLD  = 0.06;                 
const END_HIDE_DELAY = 1.5;                 
const LINE_HIDE_DELAY = 3.0;                

let hud = null;
let playing = false;
let playRun = 0;
let songStart = 0;
let events = [];
let evIdx = 0;

const FILL_STEPS = 25;                      
const STEP_DT    = 0.04;                    
const jpFill = [];                          
const cnFill = [];
for (let i = 0; i <= JP_SLOTS; i++) jpFill.push(0);
for (let i = 0; i <= CN_SLOTS; i++) cnFill.push(0);
let curLine = -1;                           

function cls(id, name, on) {
    if (hud && hud.IsValid()) hud.SetHasClass(id, name, on);
}

function setText(prefix, i, ch) {
    if (!hud || !hud.IsValid()) return;
    if (ch === "") ch = " ";   

const v = prefix + "_c" + i;
    hud.SetDialogVariableString(prefix + "_slot_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_base_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_top_" + i, v, ch);
}

function setJpSize(count, isEng) {
    cls("cs_lyric_jp", "Eng", !!isEng);
    cls("cs_lyric_jp", "SizeB", !isEng && count > 20 && count <= 30);
    cls("cs_lyric_jp", "SizeC", !isEng && count > 30);
}

function engWidthClass(ch) {
    const code = ch.charCodeAt(0);
    if (code >= 65 && code <= 90) {         
        if (code === 77 || code === 87) return "EW-w";   
        if (code === 73 || code === 74) return "EW-n";   
        return "EW-m";
    }
    if (code >= 97 && code <= 122) {        
        if (code === 109 || code === 119) return "EW-w"; 
        if ("iljtf".indexOf(ch) >= 0) return "EW-n";
        return "EW-m";
    }
    if (ch === "." || ch === "," || ch === "'" || ch === "!" || ch === ":" || ch === ";") return "EW-n";
    return "EW-m";                           
}

function showLine(idx) {
    const line = LYRICS[idx];
    curLine = idx;
    cls("cs_Re_Am_i_root", "Visible", true);   

for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
    for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);

const jpN = Math.min(line.jp.length, JP_SLOTS);
    const cnN = Math.min(line.cn.length, CN_SLOTS);
    try {
        for (let i = 1; i <= JP_SLOTS; i++) {
            const used = i <= jpN;
            cls("cs_jp_slot_" + i, "Hidden", !used);

const isSpc = used && line.jp[i - 1][2] === " ";
            cls("cs_jp_slot_" + i, "Spc", isSpc);

const ew = (used && !isSpc) ? engWidthClass(line.jp[i - 1][2]) : "";
            cls("cs_jp_slot_" + i, "EW-n", ew === "EW-n");
            cls("cs_jp_slot_" + i, "EW-m", ew === "EW-m");
            cls("cs_jp_slot_" + i, "EW-w", ew === "EW-w");
            setText("cs_jp", i, used ? line.jp[i - 1][2] : " ");
        }
        for (let i = 1; i <= CN_SLOTS; i++) {
            const used = i <= cnN;
            cls("cs_cn_slot_" + i, "Hidden", !used);
            setText("cs_cn", i, used ? line.cn[i - 1][2] : " ");
        }
    } catch (e) {
        log("[COLD_SUN] 写字异常: " + e);
    }

let asciiCnt = 0, letterCnt = 0;
    for (let k = 0; k < line.jp.length && k < JP_SLOTS; k++) {
        const ch = line.jp[k][2];
        if (!ch || ch === " ") continue;
        letterCnt++;
        const code = ch.charCodeAt(0);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) asciiCnt++;
    }
    setJpSize(jpN, letterCnt > 0 && asciiCnt * 2 > letterCnt);
}

function setFillStep(isJp, slotIdx, step) {
    if (step < 0) step = 0;
    if (step > FILL_STEPS) step = FILL_STEPS;
    const arr = isJp ? jpFill : cnFill;
    if (arr[slotIdx] === step) return;
    const clipId = (isJp ? "cs_jp_clip_" : "cs_cn_clip_") + slotIdx;
    if (arr[slotIdx] > 0) cls(clipId, "F" + arr[slotIdx], false);
    if (step > 0) cls(clipId, "F" + step, true);
    arr[slotIdx] = step;
}

function addFillEvents(c, slot, isJp, lineIdx) {
    const dur = c[1] - c[0];
    if (dur <= 0.001) {
        events.push({ t: c[0], p: 1, fn: ((s2, j2, li) => () => { if (li === curLine) setFillStep(j2, s2, FILL_STEPS); })(slot, isJp, lineIdx) });
        return;
    }
    let n = Math.round(dur / STEP_DT);
    if (n < 4) n = 4;
    if (n > FILL_STEPS) n = FILL_STEPS;
    const dt = dur / n;
    for (let i = 1; i <= n; i++) {
        const step = Math.round(i * FILL_STEPS / n);
        events.push({ t: c[0] + i * dt, p: 1, fn: ((s2, j2, st, li) => () => { if (li === curLine) setFillStep(j2, s2, st); })(slot, isJp, step, lineIdx) });
    }
}

function makeLineHide(li) {
    return function () {
        if (li === curLine) cls("cs_Re_Am_i_root", "Visible", false);
    };
}

function buildEvents() {
    events = [];
    for (let i = 0; i < LYRICS.length; i++) {
        const line = LYRICS[i];
        events.push({ t: line.t0, p: 0, fn: (li => () => showLine(li))(i) });
        for (let k = 0; k < line.jp.length; k++) addFillEvents(line.jp[k], k + 1, true, i);

if (line.cn.length > 0 && line.jp.length > 0) {
            const jpS = line.jp[0][0];
            let jpE = jpS;
            for (const c of line.jp) if (c[1] > jpE) jpE = c[1];
            const cnS = line.cn[0][0];
            let cnE = cnS;
            for (const c of line.cn) if (c[1] > cnE) cnE = c[1];
            const k2 = (cnE > cnS && jpE > jpS) ? (jpE - jpS) / (cnE - cnS) : 1;
            for (let k = 0; k < line.cn.length; k++) {
                const c = line.cn[k];
                addFillEvents(k2 === 1 ? c : [jpS + (c[0] - cnS) * k2, jpS + (c[1] - cnS) * k2, c[2]], k + 1, false, i);
            }
        } else {
            for (let k = 0; k < line.cn.length; k++) addFillEvents(line.cn[k], k + 1, false, i);
        }

let lineEnd = line.t0;
        for (const c of line.jp) if (c[1] > lineEnd) lineEnd = c[1];
        events.push({ t: lineEnd + LINE_HIDE_DELAY, p: 2, fn: makeLineHide(i) });
    }

const last = LYRICS[LYRICS.length - 1];
    let end = last.t0;
    for (const c of last.jp) if (c[1] > end) end = c[1];
    for (const c of last.cn) if (c[1] > end) end = c[1];
    events.push({ t: end + END_HIDE_DELAY, p: 2, fn: () => { stopInternal(false); } });
    events.sort((a, b) => (a.t - b.t) || (a.p - b.p));
}

function onThink() {
    if (!playing) return;
    const gt = Instance.GetGameTime();
    const now = gt - songStart;
    while (evIdx < events.length && events[evIdx].t <= now) {
        try {
            events[evIdx].fn();
        } catch (e) {
            log("[COLD_SUN] 事件异常 idx=" + evIdx + ": " + e);
        }
        evIdx++;
    }

if (evIdx < events.length) {
        const nextT = songStart + events[evIdx].t;
        Instance.SetNextThink(nextT > gt + 0.02 ? nextT : gt + 0.02);
    }
}

function stopInternal(stopMusic) {
    playing = false;
    curLine = -1;                   
    evIdx = events.length;
    const run = ++playRun;          
    if (stopMusic && PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StopSound" });
    }
    if (hud && hud.IsValid()) {

for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
        for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);
        for (let i = 1; i <= JP_SLOTS; i++) { cls("cs_jp_slot_" + i, "Hidden", true); setText("cs_jp", i, " "); }
        for (let i = 1; i <= CN_SLOTS; i++) { cls("cs_cn_slot_" + i, "Hidden", true); setText("cs_cn", i, " "); }
        cls("cs_Re_Am_i_root", "Visible", false);
    }
}

function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        log("[COLD_SUN] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

Instance.OnScriptInput("start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;

stopInternal(false);            
    playRun++;

if (PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StartSound" });
    }

cls("cs_Re_Am_i_root", "Visible", true);
    playing = true;
    songStart = Instance.GetGameTime();
    buildEvents();
    evIdx = 0;
    Instance.SetNextThink(Instance.GetGameTime() + 0.02);

log("[COLD_SUN] start，共 " + LYRICS.length + " 行歌词，首事件 t=" + events[0].t);
});

Instance.OnScriptInput("stop", () => {
    stopInternal(true);
    log("[COLD_SUN] stop");
});

Instance.OnRoundStart(() => {
    stopInternal(true);
});

const LYRICS = [
    { t0:0.71, jp:[[0.71,1.24,"重"],[1.24,1.42,"ね"],[1.42,2.08,"た"],[2.08,2.24,"言"],[2.24,2.84,"葉"],[2.84,3.7,"は"],[3.7,4.04,"何"],[4.04,4.24,"を"],[4.24,4.94,"守"],[4.94,5.44,"る"],[5.44,5.68,"た"],[5.68,6.36,"め"]], cn:[[0.71,1.087,"层"],[1.087,1.463,"层"],[1.463,1.84,"堆"],[1.84,2.217,"砌"],[2.217,2.593,"的"],[2.593,2.97,"话"],[2.97,3.347,"语"],[3.347,3.723,"究"],[3.723,4.1,"竟"],[4.1,4.477,"是"],[4.477,4.853,"为"],[4.853,5.23,"守"],[5.23,5.607,"护"],[5.607,5.983,"何"],[5.983,6.36,"物"]] },
    { t0:6.36, jp:[[6.36,6.7,"強"],[6.7,6.88,"く"],[6.88,7.06,"な"],[7.06,7.24,"れ"],[7.24,7.56,"る"],[7.56,7.78,"だ"],[7.78,8.32,"け"],[8.32,8.6,"で"],[8.6,9.76,"い"],[9.76,9.86,"い"]], cn:[[6.36,6.86,"只"],[6.86,7.36,"求"],[7.36,7.86,"能"],[7.86,8.36,"变"],[8.36,8.86,"得"],[8.86,9.36,"坚"],[9.36,9.86,"强"]] },
    { t0:9.86, jp:[[9.86,10.16,"答"],[10.16,10.48,"え"],[10.48,10.72,"は"],[10.72,11.04,"も"],[11.04,11.08,"う"],[11.08,11.22,"い"],[11.22,11.46,"ら"],[11.46,11.76,"な"],[11.76,12.02,"い"]], cn:[[9.86,10.13,"我"],[10.13,10.4,"已"],[10.4,10.67,"不"],[10.67,10.94,"再"],[10.94,11.21,"需"],[11.21,11.48,"要"],[11.48,11.75,"答"],[11.75,12.02,"案"]] },
    { t0:12.02, jp:[[12.02,12.62,"例"],[12.62,12.72,"え"],[12.72,13.44,"ば"],[13.44,13.6,"心"],[13.6,13.96,"は"],[13.96,15.02,"傷"],[15.02,15.6,"を"],[15.6,16.1,"負"],[16.1,16.24,"う"],[16.24,16.72,"だ"],[16.72,16.94,"け"],[16.94,17.66,"で"]], cn:[[12.02,12.49,"倘"],[12.49,12.96,"若"],[12.96,13.43,"人"],[13.43,13.9,"心"],[13.9,14.37,"生"],[14.37,14.84,"来"],[14.84,15.31,"只"],[15.31,15.78,"会"],[15.78,16.25,"承"],[16.25,16.72,"受"],[16.72,17.19,"伤"],[17.19,17.66,"痛"]] },
    { t0:17.66, jp:[[17.66,17.82,"そ"],[17.82,17.98,"れ"],[17.98,18.14,"だ"],[18.14,18.32,"け"],[18.32,18.5,"の"],[18.5,18.86,"も"],[18.86,19.08,"の"],[19.08,19.58,"だ"],[19.58,19.8,"と"],[19.8,20.16,"し"],[20.16,20.38,"た"],[20.38,21.0,"ら"]], cn:[[17.66,18.328,"若"],[18.328,18.996,"仅"],[18.996,19.664,"此"],[19.664,20.332,"而"],[20.332,21.0,"已"]] },
    { t0:21.0, jp:[[21.0,21.38,"悲"],[21.38,21.84,"し"],[21.84,22.0,"い"],[22.0,23.84,"ね"]], cn:[[21.0,21.473,"未"],[21.473,21.947,"免"],[21.947,22.42,"太"],[22.42,22.893,"过"],[22.893,23.367,"悲"],[23.367,23.84,"哀"]] },
    { t0:23.84, jp:[[23.84,24.02,"そ"],[24.02,24.18,"れ"],[24.18,24.48,"で"],[24.48,24.78,"も"],[24.78,25.6,"空"],[25.6,26.34,"を"],[26.34,26.64,"見"],[26.64,27.02,"上"],[27.02,27.4,"げ"],[27.4,27.68,"て"],[27.68,30.68,"る"]], cn:[[23.84,24.462,"即"],[24.462,25.084,"便"],[25.084,25.705,"如"],[25.705,26.327,"此"],[26.327,26.949,"我"],[26.949,27.571,"依"],[27.571,28.193,"旧"],[28.193,28.815,"仰"],[28.815,29.436,"望"],[29.436,30.058,"天"],[30.058,30.68,"空"]] },
    { t0:40.98, jp:[[40.98,41.46,"行"],[41.46,41.82,"き"],[41.82,42.16,"場"],[42.16,42.34,"を"],[42.34,42.84,"な"],[42.84,43.06,"く"],[43.06,43.62,"し"],[43.62,43.92,"た"],[43.92,44.52,"月"],[44.52,44.98,"の"],[44.98,46.46,"影"]], cn:[[40.98,41.763,"无"],[41.763,42.546,"处"],[42.546,43.329,"归"],[43.329,44.111,"依"],[44.111,44.894,"的"],[44.894,45.677,"月"],[45.677,46.46,"影"]] },
    { t0:46.46, jp:[[46.46,46.7,"勢"],[46.7,46.78,"い"],[46.78,47.16,"を"],[47.16,48.06,"増"],[48.06,48.5,"し"],[48.5,48.7,"た"],[48.7,49.26,"向"],[49.26,49.7,"か"],[49.7,49.92,"い"],[49.92,52.38,"風"]], cn:[[46.46,47.306,"愈"],[47.306,48.151,"发"],[48.151,48.997,"猛"],[48.997,49.843,"烈"],[49.843,50.689,"的"],[50.689,51.534,"逆"],[51.534,52.38,"风"]] },
    { t0:52.38, jp:[[52.38,52.8,"知"],[52.8,53.14,"ら"],[53.14,53.6,"な"],[53.6,53.8,"い"],[53.8,54.0,"ど"],[54.0,54.18,"こ"],[54.18,54.4,"か"],[54.4,55.22,"で"],[55.22,55.58,"手"],[55.58,55.88,"に"],[55.88,56.28,"し"],[56.28,56.84,"た"],[56.84,57.0,"何"],[57.0,57.24,"か"],[57.24,57.86,"は"]], cn:[[52.38,52.928,"在"],[52.928,53.476,"未"],[53.476,54.024,"知"],[54.024,54.572,"之"],[54.572,55.12,"地"],[55.12,55.668,"所"],[55.668,56.216,"得"],[56.216,56.764,"的"],[56.764,57.312,"一"],[57.312,57.86,"切"]] },
