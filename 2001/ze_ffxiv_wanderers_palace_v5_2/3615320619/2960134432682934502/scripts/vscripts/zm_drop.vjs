// ====================================================================
//  zm_drop.js —— 玩家武器/装备相关输入
//
//  输入：
//    DropWeapon             【原有，保留】丢掉当前手里的武器
//    drop_knife             【新增】立刻销毁触发者身上的刀
//    drop_knife_and_give    【新增】销毁刀 + 给 P90 + 满护甲和头盔 + 一颗手雷
//
//  用法（Hammer）：
//    trigger_once 的 OnStartTouch → 目标填这个脚本所在的 point_script 实体
//                                  → 输入 RunScriptInput
//                                  → 参数填 drop_knife 或 drop_knife_and_give
//    触发器会把"碰它的玩家"作为 activator 传进来，脚本就对他生效。
// ====================================================================

// 命名空间导入：Console 是 2026-10 更新新增的导出，老版本没有它；
// 用 import * as 而不是 import { Console }，老服务器不会因为"找不到导出"而加载失败。
import * as CS from "cs_script/point_script";

const Instance = CS.Instance;
const Console = CS.Console;                      // 老版本 = undefined
const CSGearSlot = CS.CSGearSlot;

// 日志统一出口（.bind 不能省，否则引擎会报 unrecognized 'this'）
const log = (typeof Console !== "undefined" && Console.Log)
    ? Console.Log.bind(Console)
    : Instance.Msg.bind(Instance);

// ---------- 通用：从 activator 取到玩家的 pawn ----------
// 触发器传进来的 activator 可能是 pawn，也可能是 controller，两种都兼容
function asPawn(ent) {
    if (!ent) return undefined;
    try { if (typeof ent.IsValid === "function" && !ent.IsValid()) return undefined; } catch (e) { }
    if (typeof ent.GetPlayerPawn === "function") return ent.GetPlayerPawn();          // 控制器 → pawn
    if (typeof ent.GetPlayerController === "function") {                              // pawn → 控制器 → pawn
        return ent.GetPlayerController()?.GetPlayerPawn();
    }
    return ent;                                                                       // 已经是 pawn
}

// ---------- 找刀：优先按装备槽，找不到再按名字兜底 ----------
function findKnife(pawn) {
    let knife = undefined;
    try { knife = pawn.FindWeaponBySlot(CSGearSlot.KNIFE); } catch (e) { }
    if (!knife) {
        try { knife = pawn.FindWeapon("weapon_knife"); } catch (e) { }
    }
    return knife || undefined;
}

// ---------- 销毁刀（内部复用） ----------
function destroyKnife(pawn, tag) {
    const knife = findKnife(pawn);
    if (!knife) {
        log("[DROP] " + tag + "：这名玩家身上没有刀");
        return false;
    }
    pawn.DestroyWeapon(knife);
    log("[DROP] " + tag + "：刀已销毁");
    return true;
}

// ====================================================================
//  原有输入：丢掉当前手里的武器（保持原样，未改动逻辑）
// ====================================================================
Instance.OnScriptInput("DropWeapon", ({ activator }) => {

    if (activator?.IsValid()) {
        const player = activator;
        const player_c = player?.GetPlayerController();
        const player_p = player_c?.GetPlayerPawn();
        const active_weapon = player_p?.GetActiveWeapon();
        if (active_weapon) {
            player_p?.DropWeapon(active_weapon);
        }
    }
});

// ====================================================================
//  新增输入①：立刻销毁身上的刀
// ====================================================================
Instance.OnScriptInput("drop_knife", ({ activator }) => {
    const pawn = asPawn(activator);
    if (!pawn) { log("[DROP] drop_knife：没拿到玩家（activator 为空）"); return; }
    destroyKnife(pawn, "drop_knife");
});

// ====================================================================
//  新增输入②：销毁刀 + 给 P90 + 满护甲&头盔 + 一颗手雷
// ====================================================================
const LOADOUT = {
    primary: "weapon_p90",        // 主武器
    grenade: "weapon_hegrenade",  // 手雷（想换：weapon_flashbang / weapon_smokegrenade / weapon_molotov）
    armor: 100,                   // 护甲值（100 = 满甲）
    helmet: true,                 // 头盔
};

Instance.OnScriptInput("drop_knife_and_give", ({ activator }) => {
    const pawn = asPawn(activator);
    if (!pawn) { log("[DROP] drop_knife_and_give：没拿到玩家（activator 为空）"); return; }

    // ① 先销毁刀
    destroyKnife(pawn, "drop_knife_and_give");

    // ② 护甲 + 头盔
    try {
        pawn.SetArmor(LOADOUT.armor);
        pawn.SetHasHelmet(LOADOUT.helmet);
    } catch (e) {
        log("[DROP] 设置护甲/头盔失败: " + e);
    }

    // ③ 发 P90（第二个参数 true = 立刻切到这把枪）
    try {
        pawn.GiveNamedItem(LOADOUT.primary, true);
    } catch (e) {
        log("[DROP] 发放 " + LOADOUT.primary + " 失败: " + e);
    }

    // ④ 发一颗手雷（false = 不自动切到手上）
    try {
        pawn.GiveNamedItem(LOADOUT.grenade, false);
    } catch (e) {
        log("[DROP] 发放 " + LOADOUT.grenade + " 失败: " + e);
    }

    log("[DROP] drop_knife_and_give：已销毁刀，并发放 P90 / 护甲+头盔 / 手雷");
});
