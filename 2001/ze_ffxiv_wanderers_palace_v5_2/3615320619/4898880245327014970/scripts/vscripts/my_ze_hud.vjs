// Generated by StarDance
// https://github.com/Kxnrl

// 从point_script模块导入Instance
import { Instance } from "cs_script/point_script";

// HUD实体名称（Hammer里 custom_hud_layout 的 Name）
const HUD_ENTITY_NAME = "my_ze_hud";

// 当前显示的 Stage 文字
const STAGE_TEXT = "Stage 1";

Instance.Msg("[ZE-HUD] 脚本已加载");

let hud = null;

// ==================== 查找 HUD 实体 ====================
Instance.OnActivate(() => {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        Instance.Msg("[ZE-HUD] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
        return;
    }
    Instance.Msg("[ZE-HUD] 已找到 HUD 实体");
});

// ==================== 按钮 A：显示 HUD ====================
Instance.OnScriptInput("show_stage", () => {
    if (!hud || !hud.IsValid()) return;

    // 设置文字内容
    hud.SetDialogVariableString("stage_label_text", "stage_text", STAGE_TEXT);

    // 显示容器
    hud.SetHasClass("stage_label_container", "Visible", true);

    Instance.Msg("[ZE-HUD] 显示 Stage: " + STAGE_TEXT);
});

// ==================== 按钮 B：隐藏 HUD ====================
Instance.OnScriptInput("hide_stage", () => {
    if (!hud || !hud.IsValid()) return;

    // 隐藏容器
    hud.SetHasClass("stage_label_container", "Visible", false);

    Instance.Msg("[ZE-HUD] 隐藏 Stage");
});

// ==================== 回合开始时重置（可选） ====================
Instance.OnRoundStart(() => {
    if (!hud || !hud.IsValid()) return;
    hud.SetHasClass("stage_label_container", "Visible", false);
});