import { Instance } from "cs_script/point_script";

// ====================================================================
// Cold Sun - KTV 逐字歌词
// 按钮 A -> RunScriptInput "start" ：放音乐 + 全屏逐字歌词
// RunScriptInput "stop"：停音乐 + 隐藏歌词（测试用）
// ====================================================================

// ==================== 配置 ====================
const HUD_ENTITY_NAME = "cold_sun_lyrics";   // Hammer 里 custom_hud_layout 实体的名称
const MUSIC_ENTITY    = "Music_Cold_Sun";     // 地图里放这首歌的实体（ambient_generic）
const PLAY_MUSIC      = false;              // 按按钮是否同时放音乐（ true=放，false=只出歌词 ）
const JP_SLOTS = 41;                        // 日文最大字数（长英文行）
const CN_SLOTS = 20;                        // 中文最大字数
const NO_ANIM_HOLD  = 0.06;                 // （已弃用，保留兼容）
const END_HIDE_DELAY = 1.5;                 // 最后一句结束后多久隐藏 HUD
const LINE_HIDE_DELAY = 3.0;                // 一行唱完后超过这么久没有新行 -> 先隐藏（长间奏不挂歌词）

// ==================== 状态 ====================
let hud = null;
let playing = false;
let playRun = 0;
let songStart = 0;
let events = [];
let evIdx = 0;
// 步进填充：不用 CSS transition（此桥接环境下 width 过渡行为不可靠），
// 由脚本按 STEP_DT 间隔逐步切换 F1..F25 宽度类，跳变模拟 KTV 从左到右填充
const FILL_STEPS = 25;                      // 填充档位（每档 4%）
const STEP_DT    = 0.04;                    // 步进目标间隔（秒）
const jpFill = [];                          // 每个槽当前填充档（0 = 无类/零宽）
const cnFill = [];
for (let i = 0; i <= JP_SLOTS; i++) jpFill.push(0);
for (let i = 0; i <= CN_SLOTS; i++) cnFill.push(0);
let curLine = -1;                           // 当前显示的行号（过期步进事件的判据）

// ==================== 小工具 ====================
function cls(id, name, on) {
    if (hud && hud.IsValid()) hud.SetHasClass(id, name, on);
}

function setText(prefix, i, ch) {
    if (!hud || !hud.IsValid()) return;
    if (ch === "") ch = " ";   // 空串可能让原生接口报错，用空格占位（不可见）
    // 字层面板 + 两个 Label 都设（与 my_ze_hud 已验证的写法一致，双保险）
    const v = prefix + "_c" + i;
    hud.SetDialogVariableString(prefix + "_slot_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_base_" + i, v, ch);
    hud.SetDialogVariableString(prefix + "_top_" + i, v, ch);
}

// 按行内字数切换三档宽度；英文行（字母占比过半）用 Eng 紧凑档：
// 窄槽 + 较大字号，让字母贴紧、清晰
function setJpSize(count, isEng) {
    cls("lyric_jp", "Eng", !!isEng);
    cls("lyric_jp", "SizeB", !isEng && count > 20 && count <= 30);
    cls("lyric_jp", "SizeC", !isEng && count > 30);
}

// 英文按字母宽度分三档（字号 42px 时的大致字宽 + 余量）：
//   EW-n 窄 ≈0.35em（i l j t f 及标点）、EW-m 中 ≈0.55em（大部分字母）、EW-w 宽 ≈0.85em（m w M W）
function engWidthClass(ch) {
    const code = ch.charCodeAt(0);
    if (code >= 65 && code <= 90) {         // 大写
        if (code === 77 || code === 87) return "EW-w";   // M W
        if (code === 73 || code === 74) return "EW-n";   // I J
        return "EW-m";
    }
    if (code >= 97 && code <= 122) {        // 小写
        if (code === 109 || code === 119) return "EW-w"; // m w
        if ("iljtf".indexOf(ch) >= 0) return "EW-n";
        return "EW-m";
    }
    if (ch === "." || ch === "," || ch === "'" || ch === "!" || ch === ":" || ch === ";") return "EW-n";
    return "EW-m";                           // 数字等其他字符
}

// ==================== 显示一行（全部瞬时跳变，无过渡） ====================
function showLine(idx) {
    const line = LYRICS[idx];
    curLine = idx;
    cls("Re_Am_i_root", "Visible", true);   // 间奏隐藏后，新行出现时重新显示

    // 1) 所有槽填充归零（跳变天然瞬时，无回缩动画问题）
    for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
    for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);

    // 2) 写本行文字（多余槽位隐藏，行宽收缩保持居中）
    const jpN = Math.min(line.jp.length, JP_SLOTS);
    const cnN = Math.min(line.cn.length, CN_SLOTS);
    try {
        for (let i = 1; i <= JP_SLOTS; i++) {
            const used = i <= jpN;
            cls("jp_slot_" + i, "Hidden", !used);
            // 英文行的空格槽收窄为词距（Spc 只在 Eng 档生效）
            const isSpc = used && line.jp[i - 1][2] === " ";
            cls("jp_slot_" + i, "Spc", isSpc);
            // 英文字母按宽度分三档（无 Eng 祖先时这些类不生效，日文行安全）
            const ew = (used && !isSpc) ? engWidthClass(line.jp[i - 1][2]) : "";
            cls("jp_slot_" + i, "EW-n", ew === "EW-n");
            cls("jp_slot_" + i, "EW-m", ew === "EW-m");
            cls("jp_slot_" + i, "EW-w", ew === "EW-w");
            setText("jp", i, used ? line.jp[i - 1][2] : " ");
        }
        for (let i = 1; i <= CN_SLOTS; i++) {
            const used = i <= cnN;
            cls("cn_slot_" + i, "Hidden", !used);
            setText("cn", i, used ? line.cn[i - 1][2] : " ");
        }
    } catch (e) {
        Instance.Msg("[COLD_SUN] 写字异常: " + e);
    }
    // 英文行判定：非空字符中字母占比过半
    let asciiCnt = 0, letterCnt = 0;
    for (let k = 0; k < line.jp.length && k < JP_SLOTS; k++) {
        const ch = line.jp[k][2];
        if (!ch || ch === " ") continue;
        letterCnt++;
        const code = ch.charCodeAt(0);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) asciiCnt++;
    }
    setJpSize(jpN, letterCnt > 0 && asciiCnt * 2 > letterCnt);
}

// ==================== 填充一个字到指定档（步进跳变，无 transition） ====================
function setFillStep(isJp, slotIdx, step) {
    if (step < 0) step = 0;
    if (step > FILL_STEPS) step = FILL_STEPS;
    const arr = isJp ? jpFill : cnFill;
    if (arr[slotIdx] === step) return;
    const clipId = (isJp ? "jp_clip_" : "cn_clip_") + slotIdx;
    if (arr[slotIdx] > 0) cls(clipId, "F" + arr[slotIdx], false);
    if (step > 0) cls(clipId, "F" + step, true);
    arr[slotIdx] = step;
}

// 一个字的填充拆成 n 个步进事件（n 按字时长 / STEP_DT 计算，4..25 档）
// 事件带行号：换行后上一行残留的步进事件（拖腔/回声字会越过行界）直接丢弃
function addFillEvents(c, slot, isJp, lineIdx) {
    const dur = c[1] - c[0];
    if (dur <= 0.001) {
        events.push({ t: c[0], p: 1, fn: ((s2, j2, li) => () => { if (li === curLine) setFillStep(j2, s2, FILL_STEPS); })(slot, isJp, lineIdx) });
        return;
    }
    let n = Math.round(dur / STEP_DT);
    if (n < 4) n = 4;
    if (n > FILL_STEPS) n = FILL_STEPS;
    const dt = dur / n;
    for (let i = 1; i <= n; i++) {
        const step = Math.round(i * FILL_STEPS / n);
        events.push({ t: c[0] + i * dt, p: 1, fn: ((s2, j2, st, li) => () => { if (li === curLine) setFillStep(j2, s2, st); })(slot, isJp, step, lineIdx) });
    }
}

// ==================== 事件表 ====================
// 长间奏隐藏：行唱完 LINE_HIDE_DELAY 秒后若仍是当前行（没有新行进来），隐藏 HUD
function makeLineHide(li) {
    return function () {
        if (li === curLine) cls("Re_Am_i_root", "Visible", false);
    };
}

function buildEvents() {
    events = [];
    for (let i = 0; i < LYRICS.length; i++) {
        const line = LYRICS[i];
        events.push({ t: line.t0, p: 0, fn: (li => () => showLine(li))(i) });
        for (let k = 0; k < line.jp.length; k++) addFillEvents(line.jp[k], k + 1, true, i);
        // 中文填充对齐日文行总时长：以日文行首字开始 -> 末字结束为区间，
        // 整行中文字等比缩放同步结束（避免日文唱完中文还停在中间）
        if (line.cn.length > 0 && line.jp.length > 0) {
            const jpS = line.jp[0][0];
            let jpE = jpS;
            for (const c of line.jp) if (c[1] > jpE) jpE = c[1];
            const cnS = line.cn[0][0];
            let cnE = cnS;
            for (const c of line.cn) if (c[1] > cnE) cnE = c[1];
            const k2 = (cnE > cnS && jpE > jpS) ? (jpE - jpS) / (cnE - cnS) : 1;
            for (let k = 0; k < line.cn.length; k++) {
                const c = line.cn[k];
                addFillEvents(k2 === 1 ? c : [jpS + (c[0] - cnS) * k2, jpS + (c[1] - cnS) * k2, c[2]], k + 1, false, i);
            }
        } else {
            for (let k = 0; k < line.cn.length; k++) addFillEvents(line.cn[k], k + 1, false, i);
        }
        // 该行唱完 LINE_HIDE_DELAY 秒后若仍没有新行（长间奏），先隐藏 HUD；
        // 下一行 showLine 时会重新显示。行号判据保证只 Hide 当前行，不误伤新行。
        let lineEnd = line.t0;
        for (const c of line.jp) if (c[1] > lineEnd) lineEnd = c[1];
        events.push({ t: lineEnd + LINE_HIDE_DELAY, p: 2, fn: makeLineHide(i) });
    }
    // 结束时间 = 最后一行最后一个字的结束时间
    const last = LYRICS[LYRICS.length - 1];
    let end = last.t0;
    for (const c of last.jp) if (c[1] > end) end = c[1];
    for (const c of last.cn) if (c[1] > end) end = c[1];
    events.push({ t: end + END_HIDE_DELAY, p: 2, fn: () => { stopInternal(false); } });
    events.sort((a, b) => (a.t - b.t) || (a.p - b.p));
}

// ==================== Think 主循环 ====================
function onThink() {
    if (!playing) return;
    const gt = Instance.GetGameTime();
    const now = gt - songStart;
    while (evIdx < events.length && events[evIdx].t <= now) {
        try {
            events[evIdx].fn();
        } catch (e) {
            Instance.Msg("[COLD_SUN] 事件异常 idx=" + evIdx + ": " + e);
        }
        evIdx++;
    }
    // 排队下一次 think（永不排过去的时间）
    if (evIdx < events.length) {
        const nextT = songStart + events[evIdx].t;
        Instance.SetNextThink(nextT > gt + 0.02 ? nextT : gt + 0.02);
    }
}

// ==================== 停止 / 清场 ====================
function stopInternal(stopMusic) {
    playing = false;
    curLine = -1;                   // 过期步进事件全部作废
    evIdx = events.length;
    const run = ++playRun;          // 让之前排队的延时回调全部失效
    if (stopMusic && PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StopSound" });
    }
    if (hud && hud.IsValid()) {
        // 停止即整体隐藏，填充档全部归零
        for (let i = 1; i <= JP_SLOTS; i++) setFillStep(true, i, 0);
        for (let i = 1; i <= CN_SLOTS; i++) setFillStep(false, i, 0);
        for (let i = 1; i <= JP_SLOTS; i++) { cls("jp_slot_" + i, "Hidden", true); setText("jp", i, " "); }
        for (let i = 1; i <= CN_SLOTS; i++) { cls("cn_slot_" + i, "Hidden", true); setText("cn", i, " "); }
        cls("Re_Am_i_root", "Visible", false);
    }
}

// ==================== 查找 HUD 实体 ====================
function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        Instance.Msg("[COLD_SUN] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

// ==================== 按钮 A：开始 ====================
Instance.OnScriptInput("start", () => {
    if (!hud || !hud.IsValid()) findHud();
    if (!hud) return;

    stopInternal(false);            // 清掉上一轮的状态和延时回调
    playRun++;

    // 放歌（默认关闭，音乐由地图自己的逻辑播放）
    if (PLAY_MUSIC) {
        Instance.EntFireAtName({ name: MUSIC_ENTITY, input: "StartSound" });
    }

    // 显示 HUD 并开始调度
    cls("Re_Am_i_root", "Visible", true);
    playing = true;
    songStart = Instance.GetGameTime();
    buildEvents();
    evIdx = 0;
    Instance.SetNextThink(Instance.GetGameTime() + 0.02);

    Instance.Msg("[COLD_SUN] start，共 " + LYRICS.length + " 行歌词，首事件 t=" + events[0].t);
});

// ==================== 手动停止（测试用） ====================
Instance.OnScriptInput("stop", () => {
    stopInternal(true);
    Instance.Msg("[COLD_SUN] stop");
});

// ==================== 回合开始重置 ====================
Instance.OnRoundStart(() => {
    stopInternal(true);
});

