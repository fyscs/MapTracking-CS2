/* Generated by StarDance */
/* https://github.com/Kxnrl */

.Root {
    width: 100%;
    height: 100%;
    flow-children: none;
    overflow: noclip;
    z-index: 999999;
}
.lyric_row {
    horizontal-align: center;
    vertical-align: bottom;
    margin-bottom: 250px;
    flow-children: right;
}
.digit {
    width: fit-children;
    height: fit-children;
    margin: 0px 8px;
}
.digit_text {
    font-size: 64px;
    font-weight: bold;
    font-family: Stratum2, 'Arial Unicode MS';
    text-align: center;
}
.digit_base {
    color: #ffffffff;
    text-shadow: 0px 2px 6px #000000ff;
}
.digit_clip {
    width: 0%;
    height: 100%;
    overflow: clip;
    transition-property: width;
    transition-duration: 0.9s;
    transition-timing-function: linear;
}
.digit_clip.Sweep {
    width: 100%;
}
.digit_top {
    color: #00c8ffff;
}
