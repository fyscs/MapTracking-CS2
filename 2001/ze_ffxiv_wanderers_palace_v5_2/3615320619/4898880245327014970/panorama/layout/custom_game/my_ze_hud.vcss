.Root {
    width: 100%;
    height: 100%;
    flow-children: none;
    overflow: noclip;
    z-index: 999999;
}
.stage_label_container {
    horizontal-align: center;
    vertical-align: top;
    margin-top: 105px;
    width: fit-children;
    height: fit-children;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}
.stage_label_container.Visible {
    opacity: 1;
}
.stage_label_text {
    text-align: center;
    font-size: 40px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    font-family: Stratum2, 'Arial Unicode MS';
    letter-spacing: 3px;
    text-transform: uppercase;
    text-shadow: 0px 4px 4px rgba(0, 0, 0, 1), 0px 2px 2px rgba(0, 0, 0, 0.9);
}
