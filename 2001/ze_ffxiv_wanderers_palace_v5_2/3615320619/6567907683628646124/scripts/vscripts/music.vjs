import { Instance } from "cs_script/point_script";

const HUD_ENTITY_NAME = "music";            

let hud = null;

function cls(id, name, on) {
    if (hud && hud.IsValid()) hud.SetHasClass(id, name, on);
}

function findHud() {
    hud = Instance.FindEntityByName(HUD_ENTITY_NAME);
    if (!hud) {
        Instance.Msg("[MUSIC_LYRICS] 警告：未找到 HUD 实体 '" + HUD_ENTITY_NAME + "'");
    }
}

Instance.OnActivate(() => { findHud(); });

let kwPlaying = false;
let kwStart = 0;
let kwEvents = [];
let kwIdx = 0;
let kwUnitNow = 0;
let kwCurW = [];                            
let kwCurD = [];                            

let rfPlaying = false;
let rfStart = 0;
let rfEvents = [];
let rfIdx = 0;
let rfUnitNow = 0;
let rfCurW = [];                            
let rfCurD = [];
let rfShowTok = 0;                          

function onThink() {
    const gt = Instance.GetGameTime();
    let nextT = -1;

if (kwPlaying) {
        const now = gt - kwStart;
        while (kwIdx < kwEvents.length && kwEvents[kwIdx].t <= now) {
            try {
                kwEvents[kwIdx].fn();
            } catch (e) {
                Instance.Msg("[MUSIC_LYRICS] 事件异常 idx=" + kwIdx + ": " + e);
            }
            kwIdx++;
        }
        if (kwIdx < kwEvents.length) {
            const t = kwStart + kwEvents[kwIdx].t;
            if (nextT < 0 || t < nextT) nextT = t;
        }
    }

if (rfPlaying) {
        const now = gt - rfStart;
        while (rfIdx < rfEvents.length && rfEvents[rfIdx].t <= now) {
            try {
                rfEvents[rfIdx].fn();
            } catch (e) {
                Instance.Msg("[MUSIC_LYRICS] Ref_rain 事件异常 idx=" + rfIdx + ": " + e);
            }
            rfIdx++;
        }
        if (rfIdx < rfEvents.length) {
            const t = rfStart + rfEvents[rfIdx].t;
            if (nextT < 0 || t < nextT) nextT = t;
        }
    }
    if (nextT > 0) {
        Instance.SetNextThink(nextT > gt + 0.02 ? nextT : gt + 0.02);
    }
}

function kickThink() {
    Instance.SetNextThink(Instance.GetGameTime() + 0.02);
}

Instance.SetThink(onThink);

