javascript
// 从point_script模块导入Instance
import { Instance } from "cs_script/point_script";

Instance.Msg("[HUD] 脚本已加载");

// logic_relay触发开始
Instance.OnScriptInput("start", () => {
    // 0秒显示第一组
    Instance.DebugScreenText({
        text: "Please hear me\n请聆听于我",
        x: 50,
        y: 40,
        duration: 3.5,
        color: { r: 255, g: 255, b: 255 }
    });
    
    // 3.5秒显示第二组
    Instance.SetNextThink(Instance.GetGameTime() + 3.5);
    Instance.SetThink(() => {
        Instance.DebugScreenText({
            text: "I want to tell you\n我想向你倾诉",
            x: 50,
            y: 40,
            duration: 2.9,
            color: { r: 255, g: 255, b: 255 }
        });
    });
});
