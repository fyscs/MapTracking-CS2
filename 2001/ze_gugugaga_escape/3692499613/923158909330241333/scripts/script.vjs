import { Instance } from "cs_script/point_script";


Instance.OnScriptInput("SetLeaderVip", (_input) => {

    let players = Instance.GetAllPlayerControllers()
    let player
    let max_score = 5000
    for (let _i = 0; _i < players.length; _i++) {
        let p_score = players[_i].GetScore();
        if(p_score > max_score){
            player = players[_i];   
            max_score = p_score;
        }
    }
    if(player){     
        Instance.EntFireAtName({ name: "LADDER_PIG", input: "FollowEntity", value: "!activator",activator:player.GetPlayerPawn()});
               Instance.EntFireAtTarget({ target: player.GetPlayerPawn(), input: "alpha", value: "0"});
    }
});