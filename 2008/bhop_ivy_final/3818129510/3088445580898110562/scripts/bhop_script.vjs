/*
    Made by tehlikeli91

    Script Setup:
    1) Add a point_script entity to your map, set its "cs_script" to this file.
    2) Add an empty logic_case entity to your map named "script_bhop" and done.
    
    Features:
        - Teleport example: OnWhatever > script_bhop > InValue > teleport stage1
            Here "stage1" is the name of the entity you want the player teleported to.
            
        - Landmark teleport example: OnWhatever > script_bhop > InValue > teleport stage1 land1
            Same as above, but "land1" is a landmark entity. The player's offset and view
            angle relative to "land1" are preserved and re-applied relative to "stage1"
            
        - Boost example: OnWhatever > script_bhop > InValue > boost 0 0 500
            Adds the given (x y z) vector to the player's current velocity.
            
        - Local boost example: OnWhatever > script_bhop > InValue > boostlocal 500 0 200
            Same as "boost", but relative to the player's current view direction instead of the world axes.
            
        - Velocity boost example: OnWhatever > script_bhop > InValue > boostvel 500 0 200
            Same as "boostlocal", but the forward/right basis comes from the player's
            current horizontal velocity direction instead of their view direction.
            
        - Strip example: OnWhatever > script_bhop > InValue > strip
            Removes all weapons from the player.
            
        - Give example: OnWhatever > script_bhop > InValue > give weapon_glock
            Gives the player the specified weapon by its classname.

        - Gravity example: OnWhatever > script_bhop > InValue > gravity 0.5
            Makes gravity feel like it's scaled by the given factor for that specific player.

        - Push example: OnWhatever > script_bhop > InValue > push 0 0 300 2
            It pushes the player similar to "trigger_push" but it does not contain some of the bugs on trigger_push.

    How to set-up bhop blocks:
        1) Add a trigger_multiple to the desired area named "bhop_block"
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output:
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up max jump zones:
        1) Add a trigger_multiple to the desired area named "bhop_maxjump_<N>",
           where <N> is the number of jumps allowed inside the zone.
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output,
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up single bhop blocks:
        1) Add a trigger_multiple to the single blocks named "bhop_single"
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output,
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up single multi bhop blocks:
        1) Add a trigger_multiple to the desired area named "bhop_single_multi"
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output.
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up anti bhop zones:
        1) Add a trigger_multiple to the desired area named "bhop_anti"
        2) Done. if necessary: Go to the trigger's Outputs tab and hook up the "OnUser1" output.
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up push zones:
        1) Add a trigger_multiple to the desired area named "bhop_push <x> <y> <z>", e.g. "bhop_push 0 300 0".

    How to set-up look zones:
        1) Add a trigger_multiple to the desired area, named "bhop_look : <target>"
		   or "bhop_look_away : <target>" where <target> is the name of the entity
		   the player is expected to look at/away.
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output.
           While a player is standing inside this trigger and looks at/away from entities,
		   OnUser1 fires, throttled by LOOK_FIRE_COOLDOWN.
			 - Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up styles/style zones:
        Available styles (aliases in parentheses):
            1) normal
            2) sideways (sw)
            3) hsw (half_sideways)
            4) w_only (wonly, w)
            5) a_only (aonly, a)
            6) d_only (donly, d)
            7) backwards (backward, bw)

        Style zones:
            1) Add a trigger_multiple named "bhop_style_<style>" (e.g. "bhop_style_hsw").
            2) While a player is inside it, If they strafe in a way that doesn't fit the style,
			   their speed is reduced and the trigger's OnUser1 fires.
				- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

        Default style example: OnWhatever > script_bhop > InValue > style hsw
            Sets the player's default style for the rest of the game.
*/

import { Instance, CSPlayerPawn, CSInputs } from 'cs_script/point_script';

const TRIGGER_NAME = "bhop_block";
const GROUND_THRESHOLD = 0.2;

const GROUND_FLICKER_TOLERANCE = 0.05;
const OUTPUT_INPUT_NAME = "FireUser1";
const RELAY_NAME = "script_bhop";

const MAXJUMP_NAME_PATTERN = /^bhop_maxjump_(\d+)$/i;
const TRIGGER_MULTIPLE_CLASSNAME = "trigger_multiple";
const MAXJUMP_RESET_TRIGGER_NAME = "bhop_maxjump_reset";

const SINGLE_TRIGGER_NAME = "bhop_single";
const NODOUBLE_TRIGGER_NAME = "bhop_single_multi";
const SINGLE_RESET_TRIGGER_NAME = "bhop_single_reset";

const ANTI_TRIGGER_NAME = "bhop_anti";
const ANTI_MAX_JUMPS = 1;
const ANTI_PENALTY_SPEED = 100;
const ANTI_GROUND_RESET_TIME = 0.1;
const ANTI_ENTRY_SPEED = 200;

const PUSH_ZONE_NAME_PATTERN = /^bhop_push\s+(\S+)\s+(\S+)\s+(\S+)\s*$/i;

const WORLD_GRAVITY = 800;
const BOOST_COOLDOWN = 0.05;

const LOOK_NAME_PATTERN = /^bhop_look\s*:\s*(.+)$/i;
const LOOK_AWAY_NAME_PATTERN = /^bhop_look_away\s*:\s*(.+)$/i;
const LOOK_ANGLE_THRESHOLD_DEGREES = 20;
const LOOK_AWAY_ANGLE_THRESHOLD_DEGREES = 40;
const LOOK_HOLD_THRESHOLD = 0.1;

const STYLE_TRIGGER_NAME_PATTERN = /^bhop_style_(.+)$/i;

const MovementStyles = {
    Normal: "normal",
    Sideways: "sideways",
    W_Only: "w_only",
    A_Only: "a_only",
    D_Only: "d_only",
    Half_Sideways: "hsw",
    Backwards: "backwards",
};

const STYLE_ALIASES = {
    normal: MovementStyles.Normal,
    default: MovementStyles.Normal,
    sideways: MovementStyles.Sideways,
    sw: MovementStyles.Sideways,
    wonly: MovementStyles.W_Only,
    w: MovementStyles.W_Only,
    aonly: MovementStyles.A_Only,
    a: MovementStyles.A_Only,
    donly: MovementStyles.D_Only,
    d: MovementStyles.D_Only,
    hsw: MovementStyles.Half_Sideways,
    halfsideways: MovementStyles.Half_Sideways,
    backwards: MovementStyles.Backwards,
    backward: MovementStyles.Backwards,
    bw: MovementStyles.Backwards,
};

const DEFAULT_STYLE = MovementStyles.Normal;

const AIR_SPEED_CAP = 30;
const STYLE_VIOLATION_FIRE_DELAY = 0.15;
const STYLE_PENALTY_DECEL = 500;
const STYLE_PENALTY_MIN_SPEED = 100;
const BACKWARDS_MAX_DOT = -0.5;

let triggers = [];
let relayOutput = undefined;
let hasAnnouncedStartup = false;
let triggerConnectionIds = [];

let playerStates = new Map();
let maxJumpTriggers = new Map();
let jumpStates = new Map();
let playerJumpCounts = new Map();
let lastZoneTrigger = new Map();

let playerGravityScale = new Map();
let lastGravityThinkTime = undefined;
let resetTriggers = [];
let boostCooldowns = new Map();

let singleTriggers = [];
let singleTouchedTriggers = new Map();

let nodoubleTriggers = [];
let nodoubleLastTrigger = new Map();
let singleResetTriggers = [];

let antiTriggers = [];
let antiTouchingTriggers = new Map();
let antiStates = new Map();

let activePushes = new Map();

let pushZoneTriggers = new Map();
let pushZoneTouching = new Map();
let pushLastVelocity = new Map();

let lookTriggers = new Map();
let lookTouchingTriggers = new Map();
let lookConditionState = new Map();

let styleTriggers = new Map();
let styleTouchStacks = new Map();
let playerDefaultStyle = new Map();
let styleLastSpeed = new Map();
let styleViolationState = new Map();
let lastStyleThinkTime = undefined;

function getBoostLastFireTime(slot, boostKey) {
    const perPlayer = boostCooldowns.get(slot);
    if (!perPlayer) return undefined;
    return perPlayer.get(boostKey);
}

function setBoostLastFireTime(slot, boostKey, value) {
    let perPlayer = boostCooldowns.get(slot);
    if (!perPlayer) {
        perPlayer = new Map();
        boostCooldowns.set(slot, perPlayer);
    }
    perPlayer.set(boostKey, value);
}

function TryConsumeBoostCooldown(slot, boostKey) {
    const now = Instance.GetGameTime();
    const lastFireTime = getBoostLastFireTime(slot, boostKey);

    if (lastFireTime !== undefined && (now - lastFireTime) < BOOST_COOLDOWN) {
        return false;
    }

    setBoostLastFireTime(slot, boostKey, now);
    return true;
}

function getZoneJumpCount(slot, trigger) {
    const zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts) return 0;
    return zoneCounts.get(trigger) || 0;
}

function setZoneJumpCount(slot, trigger, value) {
    let zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts) {
        zoneCounts = new Map();
        playerJumpCounts.set(slot, zoneCounts);
    }
    zoneCounts.set(trigger, value);
}

function Init() {
    for (const id of triggerConnectionIds) {
        if (id !== undefined && id !== 0) {
            Instance.DisconnectOutput(id);
        }
    }
    triggerConnectionIds = [];

    triggers = Instance.FindEntitiesByName(TRIGGER_NAME);

    for (const trigger of triggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnTriggerStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnTriggerEndTouch(trigger, inputData)));
    }

    InitMaxJumpTriggers();
    InitMaxJumpResetTriggers();
    InitSingleTriggers();
    InitNoDoubleTriggers();
    InitSingleResetTriggers();
    InitAntiTriggers();
    InitPushZoneTriggers();
    InitLookTriggers();
    InitStyleTriggers();

    InitScriptRelay();
    AnnounceStartupOnce();
}

Instance.OnActivate(Init);
Instance.OnScriptReload({ after: Init });
Instance.OnRoundStart(() => {
    playerStates.clear();
    jumpStates.clear();
    playerJumpCounts.clear();
    lastZoneTrigger.clear();
    playerGravityScale.clear();
    boostCooldowns.clear();
    singleTouchedTriggers.clear();
    nodoubleLastTrigger.clear();
    antiTouchingTriggers.clear();
    antiStates.clear();
    activePushes.clear();
    pushZoneTouching.clear();
    pushLastVelocity.clear();
    lookTouchingTriggers.clear();
    lookConditionState.clear();
    styleTouchStacks.clear();
    styleLastSpeed.clear();
    styleViolationState.clear();
    lastStyleThinkTime = undefined;
    Init();
});

function AnnounceStartupOnce() {
    if (hasAnnouncedStartup) return;
    hasAnnouncedStartup = true;
    Instance.Msg("Bhop script is running - by tehlikeli91");
}

function InitScriptRelay() {
    const relayEnt = Instance.FindEntityByName(RELAY_NAME);
    if (!relayEnt) return;

    if (relayOutput && relayOutput !== 0) {
        Instance.DisconnectOutput(relayOutput);
    }

    relayOutput = Instance.ConnectOutput(relayEnt, "OnDefault", OnRunScriptFunction);
}

function InitMaxJumpTriggers() {
    maxJumpTriggers.clear();

    const allTriggers = Instance.FindEntitiesByClass(TRIGGER_MULTIPLE_CLASSNAME);

    for (const trigger of allTriggers) {
        const name = trigger.GetEntityName();
        if (!name) continue;

        const match = name.match(MAXJUMP_NAME_PATTERN);
        if (!match) continue;

        const maxJumps = parseInt(match[1], 10);
        if (isNaN(maxJumps) || maxJumps <= 0) continue;

        maxJumpTriggers.set(trigger, maxJumps);

        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnMaxJumpStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnMaxJumpEndTouch(trigger, inputData)));
    }
}

function InitMaxJumpResetTriggers() {
    resetTriggers = Instance.FindEntitiesByName(MAXJUMP_RESET_TRIGGER_NAME);

    for (const trigger of resetTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnMaxJumpResetTouch(trigger, inputData)));
    }
}

function InitSingleTriggers() {
    singleTriggers = Instance.FindEntitiesByName(SINGLE_TRIGGER_NAME);

    for (const trigger of singleTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnSingleTriggerStartTouch(trigger, inputData)));
    }
}

function InitNoDoubleTriggers() {
    nodoubleTriggers = Instance.FindEntitiesByName(NODOUBLE_TRIGGER_NAME);

    for (const trigger of nodoubleTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnNoDoubleTriggerStartTouch(trigger, inputData)));
    }
}

function InitSingleResetTriggers() {
    singleResetTriggers = Instance.FindEntitiesByName(SINGLE_RESET_TRIGGER_NAME);

    for (const trigger of singleResetTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnSingleResetTouch(trigger, inputData)));
    }
}

function InitAntiTriggers() {
    antiTriggers = Instance.FindEntitiesByName(ANTI_TRIGGER_NAME);

    for (const trigger of antiTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnAntiTriggerStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnAntiTriggerEndTouch(trigger, inputData)));
    }
}

function OnAntiTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    let touchedSet = antiTouchingTriggers.get(slot);
    if (!touchedSet) {
        touchedSet = new Set();
        antiTouchingTriggers.set(slot, touchedSet);
    }
    touchedSet.add(trigger);

    const state = antiStates.get(slot);
    if (state) state.jumpCounts.delete(trigger);

    const velocity = activator.GetAbsVelocity();
    const speed = Math.sqrt(velocity.x * velocity.x + velocity.y * velocity.y);
    if (speed > ANTI_ENTRY_SPEED) {
        const scale = ANTI_ENTRY_SPEED / speed;
        activator.Teleport({
            velocity: {
                x: velocity.x * scale,
                y: velocity.y * scale,
                z: velocity.z,
            },
        });
        styleLastSpeed.delete(slot);
        pushLastVelocity.delete(slot);
    }
}

function OnAntiTriggerEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const touchedSet = antiTouchingTriggers.get(slot);
    if (!touchedSet) return;

    touchedSet.delete(trigger);
    if (touchedSet.size === 0) antiTouchingTriggers.delete(slot);
}

function ProcessAntiJump(pawn, slot) {
    const touchedSet = antiTouchingTriggers.get(slot);
    if (!touchedSet || touchedSet.size === 0) return;

    let state = antiStates.get(slot);
    if (!state) {
        state = { jumpCounts: new Map(), groundStartTime: undefined, pendingPenalty: false };
        antiStates.set(slot, state);
    }

    state.groundStartTime = undefined;

    for (const trigger of touchedSet) {
        const jumpCount = (state.jumpCounts.get(trigger) || 0) + 1;
        state.jumpCounts.set(trigger, jumpCount);

        if (jumpCount <= ANTI_MAX_JUMPS) continue;

        state.pendingPenalty = true;

        Instance.EntFireAtTarget({
            target: trigger,
            input: OUTPUT_INPUT_NAME,
            activator: pawn,
            caller: trigger,
        });
    }
}

function ProcessAntiStates() {
    if (antiStates.size === 0) return;

    const now = Instance.GetGameTime();

    for (const [slot, state] of antiStates) {
        const controller = Instance.GetPlayerController(slot);
        const pawn = controller ? controller.GetPlayerPawn() : undefined;
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) {
            antiStates.delete(slot);
            continue;
        }

        if (state.pendingPenalty) {
            state.pendingPenalty = false;
            state.groundStartTime = undefined;

            pushLastVelocity.delete(slot);

            const velocity = pawn.GetAbsVelocity();
            const speed = Math.sqrt(velocity.x * velocity.x + velocity.y * velocity.y);
            const scale = speed > ANTI_PENALTY_SPEED ? ANTI_PENALTY_SPEED / speed : 1;

            pawn.Teleport({
                velocity: {
                    x: velocity.x * scale,
                    y: velocity.y * scale,
                    z: 0,
                },
            });
            styleLastSpeed.delete(slot);
            continue;
        }

        if (pawn.GetGroundEntity() === undefined) {
            state.groundStartTime = undefined;
            continue;
        }

        if (state.groundStartTime === undefined) {
            state.groundStartTime = now;
        } else if ((now - state.groundStartTime) >= ANTI_GROUND_RESET_TIME) {
            antiStates.delete(slot);
        }
    }
}

function InitPushZoneTriggers() {
    pushZoneTriggers.clear();

    const allTriggers = Instance.FindEntitiesByClass(TRIGGER_MULTIPLE_CLASSNAME);

    for (const trigger of allTriggers) {
        const name = trigger.GetEntityName();
        if (!name) continue;

        const match = name.match(PUSH_ZONE_NAME_PATTERN);
        if (!match) continue;

        const vector = {
            x: parseFloat(match[1]),
            y: parseFloat(match[2]),
            z: parseFloat(match[3]),
        };
        if (isNaN(vector.x) || isNaN(vector.y) || isNaN(vector.z)) continue;
        if (vector.x === 0 && vector.y === 0 && vector.z === 0) continue;

        pushZoneTriggers.set(trigger, vector);

        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnPushZoneStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnPushZoneEndTouch(trigger, inputData)));
    }
}

function OnPushZoneStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    let touchedZones = pushZoneTouching.get(slot);
    if (!touchedZones) {
        touchedZones = new Map();
        pushZoneTouching.set(slot, touchedZones);
    }
    touchedZones.set(trigger, Instance.GetGameTime());
}

function OnPushZoneEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const touchedZones = pushZoneTouching.get(slot);
    if (!touchedZones) return;

    touchedZones.delete(trigger);
    if (touchedZones.size === 0) pushZoneTouching.delete(slot);
}

function InitLookTriggers() {
    lookTriggers.clear();

    const allTriggers = Instance.FindEntitiesByClass(TRIGGER_MULTIPLE_CLASSNAME);

    for (const trigger of allTriggers) {
        const name = trigger.GetEntityName();
        if (!name) continue;

        const awayMatch = name.match(LOOK_AWAY_NAME_PATTERN);
        const lookMatch = !awayMatch ? name.match(LOOK_NAME_PATTERN) : null;

        if (!awayMatch && !lookMatch) continue;

        const targetName = (awayMatch ? awayMatch[1] : lookMatch[1]).trim();
        if (!targetName) continue;

        const targetEntity = Instance.FindEntityByName(targetName);
        if (!targetEntity) continue;

        lookTriggers.set(trigger, {
            targetEntity: targetEntity,
            mode: awayMatch ? "fireWhenLooking" : "fireWhenNotLooking",
            angleThresholdDegrees: awayMatch ? LOOK_AWAY_ANGLE_THRESHOLD_DEGREES : LOOK_ANGLE_THRESHOLD_DEGREES,
        });

        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnLookTriggerStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnLookTriggerEndTouch(trigger, inputData)));
    }
}

function OnSingleTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    let touchedSet = singleTouchedTriggers.get(slot);
    if (!touchedSet) {
        touchedSet = new Set();
        singleTouchedTriggers.set(slot, touchedSet);
    }

    if (touchedSet.has(trigger)) {
        touchedSet.delete(trigger);

        Instance.EntFireAtTarget({
            target: trigger,
            input: OUTPUT_INPUT_NAME,
            activator: activator,
            caller: trigger,
        });
    } else {
        touchedSet.add(trigger);
    }
}

function OnNoDoubleTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const lastTrigger = nodoubleLastTrigger.get(slot);

    if (lastTrigger === trigger) {
        nodoubleLastTrigger.delete(slot);

        Instance.EntFireAtTarget({
            target: trigger,
            input: OUTPUT_INPUT_NAME,
            activator: activator,
            caller: trigger,
        });
    } else {
        nodoubleLastTrigger.set(slot, trigger);
    }
}

function OnSingleResetTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    singleTouchedTriggers.delete(slot);
    nodoubleLastTrigger.delete(slot);
}

function OnLookTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    let touchedSet = lookTouchingTriggers.get(slot);
    if (!touchedSet) {
        touchedSet = new Set();
        lookTouchingTriggers.set(slot, touchedSet);
    }
    touchedSet.add(trigger);
}

function OnLookTriggerEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const touchedSet = lookTouchingTriggers.get(slot);
    if (touchedSet) {
        touchedSet.delete(trigger);
        if (touchedSet.size === 0) {
            lookTouchingTriggers.delete(slot);
        }
    }

    const perPlayerState = lookConditionState.get(slot);
    if (perPlayerState) {
        perPlayerState.delete(trigger);
    }
}

function OnMaxJumpResetTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    playerJumpCounts.delete(slot);
}

function OnMaxJumpStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    jumpStates.set(slot, {
        trigger: trigger,
    });

    lastZoneTrigger.set(slot, trigger);

    const zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts || !zoneCounts.has(trigger)) {
        setZoneJumpCount(slot, trigger, 0);
    }
}

function OnMaxJumpEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const state = jumpStates.get(slot);
    if (state && state.trigger === trigger) {
        jumpStates.delete(slot);
    }
}

function OnRunScriptFunction(inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const inputString = inputData.value;
    if (!inputString || typeof inputString !== 'string') return;

    const runSlot = getPlayerSlot(activator);
    if (runSlot !== undefined) pushLastVelocity.delete(runSlot);

    const tokens = inputString.split(" ");

    switch (tokens[0]) {
        case "teleport": {
            const teleportSlot = getPlayerSlot(activator);
            if (teleportSlot !== undefined) styleLastSpeed.delete(teleportSlot);

            const targetName = tokens[1];
            if (!targetName) break;

            const destination = Instance.FindEntityByName(targetName);
            if (!destination) break;

            const landmarkName = tokens[2];

            if (!landmarkName) {
                activator.Teleport({
                    position: destination.GetAbsOrigin(),
                    angles: destination.GetAbsAngles(),
                });
                break;
            }

            const landmark = landmarkName.toLowerCase() === "!activator"
                ? activator
                : Instance.FindEntityByName(landmarkName);
            if (!landmark) break;

            const pawnOrigin = activator.GetAbsOrigin();
            const landmarkOrigin = landmark.GetAbsOrigin();
            const destinationOrigin = destination.GetAbsOrigin();

            const offset = {
                x: pawnOrigin.x - landmarkOrigin.x,
                y: pawnOrigin.y - landmarkOrigin.y,
                z: pawnOrigin.z - landmarkOrigin.z,
            };

            const newOrigin = {
                x: destinationOrigin.x + offset.x,
                y: destinationOrigin.y + offset.y,
                z: destinationOrigin.z + offset.z,
            };

            activator.Teleport({ position: newOrigin });
            break;
        }
        case "boost": {
            const x = parseFloat(tokens[1]);
            const y = parseFloat(tokens[2]);
            const z = parseFloat(tokens[3]);
            if (isNaN(x) || isNaN(y) || isNaN(z)) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;
            if (!TryConsumeBoostCooldown(slot, inputString)) break;
            styleLastSpeed.delete(slot);

            const currentVelocity = activator.GetAbsVelocity();
            const newVelocity = {
                x: currentVelocity.x + x,
                y: currentVelocity.y + y,
                z: currentVelocity.z + z,
            };

            activator.Teleport({ velocity: newVelocity });
            break;
        }
        case "boostlocal": {
            const forwardAmount = parseFloat(tokens[1]);
            const rightAmount = parseFloat(tokens[2]);
            const upAmount = parseFloat(tokens[3]);
            if (isNaN(forwardAmount) || isNaN(rightAmount) || isNaN(upAmount)) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;
            if (!TryConsumeBoostCooldown(slot, inputString)) break;
            styleLastSpeed.delete(slot);

            const eyeAngles = activator.GetEyeAngles();
            const { forward, right } = AnglesToVectors({ pitch: 0, yaw: eyeAngles.yaw, roll: 0 });

            const localVelocity = {
                x: forward.x * forwardAmount + right.x * rightAmount,
                y: forward.y * forwardAmount + right.y * rightAmount,
                z: upAmount,
            };

            const currentVelocity = activator.GetAbsVelocity();
            const newVelocity = {
                x: currentVelocity.x + localVelocity.x,
                y: currentVelocity.y + localVelocity.y,
                z: currentVelocity.z + localVelocity.z,
            };

            activator.Teleport({ velocity: newVelocity });
            break;
        }
        case "boostvel": {
            const forwardAmount = parseFloat(tokens[1]);
            const rightAmount = parseFloat(tokens[2]);
            const upAmount = parseFloat(tokens[3]);
            if (isNaN(forwardAmount) || isNaN(rightAmount) || isNaN(upAmount)) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;
            if (!TryConsumeBoostCooldown(slot, inputString)) break;
            styleLastSpeed.delete(slot);

            const currentVelocity = activator.GetAbsVelocity();
            const horizontalSpeed = Math.sqrt(
                currentVelocity.x * currentVelocity.x + currentVelocity.y * currentVelocity.y
            );

            let forward;
            if (horizontalSpeed > 1) {
                forward = {
                    x: currentVelocity.x / horizontalSpeed,
                    y: currentVelocity.y / horizontalSpeed,
                };
            } else {
                const eyeAngles = activator.GetEyeAngles();
                const flat = AnglesToVectors({ pitch: 0, yaw: eyeAngles.yaw, roll: 0 });
                forward = { x: flat.forward.x, y: flat.forward.y };
            }

            const right = { x: forward.y, y: -forward.x };

            const localVelocity = {
                x: forward.x * forwardAmount + right.x * rightAmount,
                y: forward.y * forwardAmount + right.y * rightAmount,
                z: upAmount,
            };

            const newVelocity = {
                x: currentVelocity.x + localVelocity.x,
                y: currentVelocity.y + localVelocity.y,
                z: currentVelocity.z + localVelocity.z,
            };

            activator.Teleport({ velocity: newVelocity });
            break;
        }
        case "push": {
            const x = parseFloat(tokens[1]);
            const y = parseFloat(tokens[2]);
            const z = parseFloat(tokens[3]);
            const duration = parseFloat(tokens[4]);
            if (isNaN(x) || isNaN(y) || isNaN(z) || isNaN(duration) || duration <= 0) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;
            if (!TryConsumeBoostCooldown(slot, inputString)) break;

            if (x === 0 && y === 0 && z === 0) break;

            let pushes = activePushes.get(slot);
            if (!pushes) {
                pushes = [];
                activePushes.set(slot, pushes);
            }
			
            const now = Instance.GetGameTime();
            pushes.push({
                vector: { x: x, y: y, z: z },
                duration: duration,
                waitingForAir: z > 0 && activator.GetGroundEntity() !== undefined,
                lastTime: now,
                endTime: now + duration,
            });
            break;
        }
        case "strip": {
            activator.DestroyWeapons();
            break;
        }
        case "give": {
            const weaponName = tokens[1];
            if (!weaponName) break;

            activator.GiveNamedItem(weaponName);
            break;
        }
        case "style": {
            const styleToken = tokens.slice(1).find((t) => t.length > 0);
            const style = ParseStyleName(styleToken);
            if (style === undefined) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;

            if (style === DEFAULT_STYLE) {
                playerDefaultStyle.delete(slot);
            } else {
                playerDefaultStyle.set(slot, style);
            }
            styleLastSpeed.delete(slot);
            break;
        }
        case "gravity": {
            const multiplier = parseFloat(tokens[1]);
            if (isNaN(multiplier)) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;

            playerGravityScale.set(slot, multiplier);
            break;
        }
    }
}

const DEG2RAD = Math.PI / 180;

function AnglesToVectors(angles) {
    const sy = Math.sin(angles.yaw * DEG2RAD);
    const cy = Math.cos(angles.yaw * DEG2RAD);
    const sp = Math.sin(angles.pitch * DEG2RAD);
    const cp = Math.cos(angles.pitch * DEG2RAD);
    const sr = Math.sin(angles.roll * DEG2RAD);
    const cr = Math.cos(angles.roll * DEG2RAD);

    return {
        forward: {
            x: cp * cy,
            y: cp * sy,
            z: -sp,
        },
        right: {
            x: -sr * sp * cy + -cr * -sy,
            y: -sr * sp * sy + -cr * cy,
            z: -sr * cp,
        },
        up: {
            x: cr * sp * cy + -sr * -sy,
            y: cr * sp * sy + -sr * cy,
            z: cr * cp,
        },
    };
}

function IsLookingAtEntity(pawn, targetEntity, thresholdDegrees) {
    const eyePosition = pawn.GetEyePosition();
    const eyeAngles = pawn.GetEyeAngles();
    const { forward } = AnglesToVectors(eyeAngles);

    const targetOrigin = targetEntity.GetAbsOrigin();
    const toTarget = {
        x: targetOrigin.x - eyePosition.x,
        y: targetOrigin.y - eyePosition.y,
        z: targetOrigin.z - eyePosition.z,
    };

    const distance = Math.sqrt(toTarget.x * toTarget.x + toTarget.y * toTarget.y + toTarget.z * toTarget.z);
    if (distance < 1) return true;

    const dir = {
        x: toTarget.x / distance,
        y: toTarget.y / distance,
        z: toTarget.z / distance,
    };

    const dot = forward.x * dir.x + forward.y * dir.y + forward.z * dir.z;
    const clampedDot = Math.max(-1, Math.min(1, dot));
    const angleDegrees = Math.acos(clampedDot) / DEG2RAD;

    return angleDegrees <= thresholdDegrees;
}

function getPlayerSlot(pawn) {
    const controller = pawn.GetPlayerController();
    if (!controller) return undefined;
    return controller.GetPlayerSlot();
}

function OnTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    playerStates.set(slot, {
        pawn: activator,
        trigger: trigger,
        groundStartTime: undefined,
        notified: false,
        lastGroundedTime: undefined,
    });
}

function OnTriggerEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const state = playerStates.get(slot);

    if (state && state.trigger === trigger) {
        playerStates.delete(slot);
    }
}

Instance.OnPlayerReset((event) => {
    const slot = getPlayerSlot(event.player);
    if (slot !== undefined) {
        playerStates.delete(slot);
        jumpStates.delete(slot);
        playerJumpCounts.delete(slot);
        lastZoneTrigger.delete(slot);
        playerGravityScale.delete(slot);
        boostCooldowns.delete(slot);
        singleTouchedTriggers.delete(slot);
        nodoubleLastTrigger.delete(slot);
        antiTouchingTriggers.delete(slot);
        antiStates.delete(slot);
        activePushes.delete(slot);
        pushZoneTouching.delete(slot);
        pushLastVelocity.delete(slot);
        lookTouchingTriggers.delete(slot);
        lookConditionState.delete(slot);
        styleTouchStacks.delete(slot);
        styleLastSpeed.delete(slot);
        styleViolationState.delete(slot);
    }
});

Instance.OnPlayerDisconnect((event) => {
    playerStates.delete(event.playerSlot);
    jumpStates.delete(event.playerSlot);
    playerJumpCounts.delete(event.playerSlot);
    lastZoneTrigger.delete(event.playerSlot);
    playerGravityScale.delete(event.playerSlot);
    boostCooldowns.delete(event.playerSlot);
    singleTouchedTriggers.delete(event.playerSlot);
    nodoubleLastTrigger.delete(event.playerSlot);
    antiTouchingTriggers.delete(event.playerSlot);
    antiStates.delete(event.playerSlot);
    activePushes.delete(event.playerSlot);
    pushZoneTouching.delete(event.playerSlot);
    pushLastVelocity.delete(event.playerSlot);
    lookTouchingTriggers.delete(event.playerSlot);
    lookConditionState.delete(event.playerSlot);
    styleTouchStacks.delete(event.playerSlot);
    styleLastSpeed.delete(event.playerSlot);
    styleViolationState.delete(event.playerSlot);
    playerDefaultStyle.delete(event.playerSlot);
});

function CheckGroundTimers() {
    const now = Instance.GetGameTime();

    for (const [slot, state] of playerStates) {
        const pawn = state.pawn;

        if (!pawn.IsValid() || !pawn.IsAlive()) {
            playerStates.delete(slot);
            continue;
        }

        const grounded = pawn.GetGroundEntity() !== undefined;

        if (grounded) {
            state.lastGroundedTime = now;

            if (state.groundStartTime === undefined) {
                state.groundStartTime = now;
            } else if (!state.notified && (now - state.groundStartTime) > GROUND_THRESHOLD) {
                state.notified = true;

                Instance.EntFireAtTarget({
                    target: state.trigger,
                    input: OUTPUT_INPUT_NAME,
                    activator: pawn,
                    caller: state.trigger,
                });
            }
        } else {
            const wasRecentlyGrounded = state.lastGroundedTime !== undefined
                && (now - state.lastGroundedTime) <= GROUND_FLICKER_TOLERANCE;

            if (!wasRecentlyGrounded) {
                state.groundStartTime = undefined;
                state.notified = false;
            }
        }
    }
}

function ProcessLookTriggers() {
    if (lookTouchingTriggers.size === 0) return;

    const now = Instance.GetGameTime();

    for (const [slot, touchedSet] of lookTouchingTriggers) {
        const controller = Instance.GetPlayerController(slot);
        if (!controller) continue;

        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;

        let perPlayerState = lookConditionState.get(slot);

        for (const trigger of touchedSet) {
            const config = lookTriggers.get(trigger);
            if (!config) continue;

            const targetEntity = config.targetEntity;
            if (!targetEntity.IsValid()) continue;

            const looking = IsLookingAtEntity(pawn, targetEntity, config.angleThresholdDegrees);
            const shouldFire = config.mode === "fireWhenLooking" ? looking : !looking;

            if (!shouldFire) {
                if (perPlayerState) {
                    perPlayerState.delete(trigger);
                }
                continue;
            }

            if (!perPlayerState) {
                perPlayerState = new Map();
                lookConditionState.set(slot, perPlayerState);
            }

            let triggerState = perPlayerState.get(trigger);
            if (!triggerState) {
                triggerState = { conditionStartTime: now, notified: false };
                perPlayerState.set(trigger, triggerState);
            }

            if (!triggerState.notified && (now - triggerState.conditionStartTime) >= LOOK_HOLD_THRESHOLD) {
                triggerState.notified = true;

                Instance.EntFireAtTarget({
                    target: trigger,
                    input: OUTPUT_INPUT_NAME,
                    activator: pawn,
                    caller: trigger,
                });
            }
        }
    }
}

Instance.OnPlayerJump((event) => {
    const pawn = event.player;
    if (!pawn || !pawn.IsValid()) return;

    const slot = getPlayerSlot(pawn);
    if (slot === undefined) return;

    ProcessAntiJump(pawn, slot);

    const state = jumpStates.get(slot);
    if (!state) return;

    const trigger = state.trigger;
    const jumpCount = getZoneJumpCount(slot, trigger) + 1;
    setZoneJumpCount(slot, trigger, jumpCount);

    const maxJumps = maxJumpTriggers.get(trigger);
    if (maxJumps !== undefined && jumpCount > maxJumps) {
        Instance.EntFireAtTarget({
            target: trigger,
            input: OUTPUT_INPUT_NAME,
            activator: pawn,
            caller: trigger,
        });

        setZoneJumpCount(slot, trigger, 0);
    }
});

Instance.OnPlayerLand((event) => {
    const pawn = event.player;
    if (!pawn || !pawn.IsValid()) return;

    const slot = getPlayerSlot(pawn);
    if (slot === undefined || jumpStates.has(slot)) return;

    const trigger = lastZoneTrigger.get(slot);
    if (trigger === undefined) return;

    setZoneJumpCount(slot, trigger, 0);
});

function ApplyGravityCompensation() {
    const now = Instance.GetGameTime();

    if (lastGravityThinkTime === undefined) {
        lastGravityThinkTime = now;
        return;
    }

    const dt = now - lastGravityThinkTime;
    lastGravityThinkTime = now;

    if (dt <= 0 || playerGravityScale.size === 0) return;

    for (const [slot, multiplier] of playerGravityScale) {
        const controller = Instance.GetPlayerController(slot);
        if (!controller) {
            playerGravityScale.delete(slot);
            continue;
        }

        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;

        if (pawn.IsNoclipping()) continue;

        const grounded = pawn.GetGroundEntity() !== undefined;
        if (grounded) continue;

        const compensation = WORLD_GRAVITY * (1 - multiplier) * dt;
        if (compensation === 0) continue;

        const velocity = pawn.GetAbsVelocity();
        pawn.Teleport({
            velocity: {
                x: velocity.x,
                y: velocity.y,
                z: velocity.z + compensation,
            },
        });
    }
}

function ProcessPushes() {
    const lastPushVelocities = pushLastVelocity;
    pushLastVelocity = new Map();

    if (activePushes.size === 0 && pushZoneTouching.size === 0) return;

    const now = Instance.GetGameTime();
    const slots = new Set([...activePushes.keys(), ...pushZoneTouching.keys()]);

    for (const slot of slots) {
        const controller = Instance.GetPlayerController(slot);
        const pawn = controller ? controller.GetPlayerPawn() : undefined;
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) {
            activePushes.delete(slot);
            pushZoneTouching.delete(slot);
            continue;
        }

        const grounded = pawn.GetGroundEntity() !== undefined;
        const total = { x: 0, y: 0, z: 0 };
        let gravityDt = 0;

        const pushes = activePushes.get(slot);
        if (pushes) {
            for (let i = pushes.length - 1; i >= 0; i--) {
                const push = pushes[i];

                if (push.waitingForAir) {
                    if (grounded) continue;

                    push.waitingForAir = false;
                    push.lastTime = now;
                    push.endTime = now + push.duration;
                    continue;
                }

                const stepEnd = Math.min(now, push.endTime);
                const dt = stepEnd - push.lastTime;
                if (dt > 0) {
                    total.x += push.vector.x * dt;
                    total.y += push.vector.y * dt;
                    total.z += push.vector.z * dt;
                    push.lastTime = stepEnd;

                    if (push.vector.z !== 0) gravityDt = Math.max(gravityDt, dt);
                }

                if (push.lastTime >= push.endTime) pushes.splice(i, 1);
            }

            if (pushes.length === 0) activePushes.delete(slot);
        }

        const touchedZones = pushZoneTouching.get(slot);
        let groundSet = undefined;

        if (touchedZones) {
            const zoneSum = { x: 0, y: 0, z: 0 };

            for (const [trigger, lastTime] of touchedZones) {
                touchedZones.set(trigger, now);

                const vector = pushZoneTriggers.get(trigger);
                if (!vector) continue;

                if (grounded) {
                    zoneSum.x += vector.x;
                    zoneSum.y += vector.y;
                    zoneSum.z += vector.z;
                    continue;
                }

                const dt = now - lastTime;
                if (dt <= 0) continue;

                total.x += vector.x * dt;
                total.y += vector.y * dt;
                total.z += vector.z * dt;

                if (vector.z !== 0) gravityDt = Math.max(gravityDt, dt);
            }

            if (grounded && !pawn.IsInputPressed(CSInputs.JUMP)) {
                groundSet = {};
                if (zoneSum.x !== 0) groundSet.x = zoneSum.x;
                if (zoneSum.y !== 0) groundSet.y = zoneSum.y;
            }
        }
		
        if (gravityDt > 0 && !grounded && !pawn.IsNoclipping()) {
            const gravityScale = playerGravityScale.has(slot) ? playerGravityScale.get(slot) : 1;
            total.z += WORLD_GRAVITY * gravityScale * gravityDt;
        }

        const currentVelocity = pawn.GetAbsVelocity();
        const velocity = { x: currentVelocity.x, y: currentVelocity.y, z: currentVelocity.z };

        let positionCorrection = undefined;
        const lastPush = lastPushVelocities.get(slot);
        if (!grounded && lastPush) {
            positionCorrection = CancelInputAgainstPush(pawn, velocity, lastPush.velocity, lastPush.pushVelocity, now - lastPush.time);
        }

        const newVelocity = {
            x: velocity.x + total.x,
            y: velocity.y + total.y,
            z: velocity.z + total.z,
        };

        if (groundSet) {
            for (const axis of Object.keys(groundSet)) {
                newVelocity[axis] = groundSet[axis];
            }
        }

        if (newVelocity.x === currentVelocity.x && newVelocity.y === currentVelocity.y && newVelocity.z === currentVelocity.z) continue;

        styleLastSpeed.delete(slot);

        if (grounded) {
            pawn.Move({ velocity: newVelocity });
            continue;
        }

        if (positionCorrection) {
            const origin = pawn.GetAbsOrigin();
            const trace = Instance.TracePlayer({
                start: origin,
                end: { x: origin.x + positionCorrection.x, y: origin.y + positionCorrection.y, z: origin.z },
                player: pawn,
            });

            if (!trace.startedInSolid) {
                pawn.Move({ position: trace.end, velocity: newVelocity });
            } else {
                pawn.Teleport({ velocity: newVelocity });
            }
        } else {
            pawn.Teleport({ velocity: newVelocity });
        }

        const pushVelocity = {
            x: (lastPush ? lastPush.pushVelocity.x : 0) + total.x,
            y: (lastPush ? lastPush.pushVelocity.y : 0) + total.y,
        };

        pushLastVelocity.set(slot, { velocity: newVelocity, time: now, pushVelocity: pushVelocity });
    }
}

function CancelInputAgainstPush(pawn, velocity, lastVelocity, lastPushVelocity, dt) {
    const wishDir = GetWishDirection(pawn);
    if (!wishDir) return undefined;

    const maxInputGain = AIR_SPEED_CAP - (lastVelocity.x * wishDir.x + lastVelocity.y * wishDir.y);
    if (maxInputGain <= 0) return undefined;

    const observedGain = (velocity.x - lastVelocity.x) * wishDir.x + (velocity.y - lastVelocity.y) * wishDir.y;
    const inputGain = Math.min(Math.max(observedGain, 0), maxInputGain);
    if (inputGain <= 0) return undefined;

    const ownWishSpeed = (lastVelocity.x - lastPushVelocity.x) * wishDir.x + (lastVelocity.y - lastPushVelocity.y) * wishDir.y;
    const allowedGain = Math.min(inputGain, Math.max(0, AIR_SPEED_CAP - ownWishSpeed));

    const removedGain = inputGain - allowedGain;
    if (removedGain <= 0) return undefined;

    velocity.x -= wishDir.x * removedGain;
    velocity.y -= wishDir.y * removedGain;

    return { x: -wishDir.x * removedGain * dt, y: -wishDir.y * removedGain * dt };
}

function ParseStyleName(rawName) {
    if (!rawName || typeof rawName !== 'string') return undefined;
    const key = rawName.toLowerCase().replace(/[^a-z]/g, "");
    return STYLE_ALIASES[key];
}

function InitStyleTriggers() {
    styleTriggers.clear();

    const allTriggers = Instance.FindEntitiesByClass(TRIGGER_MULTIPLE_CLASSNAME);

    for (const trigger of allTriggers) {
        const name = trigger.GetEntityName();
        if (!name) continue;

        const match = name.match(STYLE_TRIGGER_NAME_PATTERN);
        if (!match) continue;

        const style = ParseStyleName(match[1]);
        if (style === undefined) continue;

        styleTriggers.set(trigger, style);

        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnStyleTriggerStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnStyleTriggerEndTouch(trigger, inputData)));
    }
}

function OnStyleTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    let stack = styleTouchStacks.get(slot);
    if (!stack) {
        stack = [];
        styleTouchStacks.set(slot, stack);
    }

    const existingIndex = stack.indexOf(trigger);
    if (existingIndex !== -1) stack.splice(existingIndex, 1);
    stack.push(trigger);

    styleViolationState.delete(slot);
}

function OnStyleTriggerEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const stack = styleTouchStacks.get(slot);
    if (!stack) return;

    const index = stack.indexOf(trigger);
    if (index !== -1) stack.splice(index, 1);
    if (stack.length === 0) styleTouchStacks.delete(slot);

    styleViolationState.delete(slot);
}

function GetActiveStyle(slot) {
    const stack = styleTouchStacks.get(slot);
    if (stack) {
        for (let i = stack.length - 1; i >= 0; i--) {
            const trigger = stack[i];
            const style = styleTriggers.get(trigger);
            if (style !== undefined && trigger.IsValid()) {
                return { style: style, trigger: trigger };
            }
        }
    }

    return { style: playerDefaultStyle.get(slot) || DEFAULT_STYLE, trigger: undefined };
}

function IsMovementStyleValid(pawn, style, velocity, speed) {
    if (style === MovementStyles.Normal) return true;

    if (style === MovementStyles.Backwards) {
        const { forward: viewForward } = AnglesToVectors({ pitch: 0, yaw: pawn.GetEyeAngles().yaw, roll: 0 });
        const dot = velocity.x * viewForward.x + velocity.y * viewForward.y;
        return dot <= BACKWARDS_MAX_DOT * speed;
    }

    const forward = pawn.IsInputPressed(CSInputs.FORWARD);
    const back = pawn.IsInputPressed(CSInputs.BACK);
    const left = pawn.IsInputPressed(CSInputs.LEFT);
    const right = pawn.IsInputPressed(CSInputs.RIGHT);

    switch (style) {
        case MovementStyles.Sideways:
            return !left && !right;
        case MovementStyles.W_Only:
            return forward && !back && !left && !right;
        case MovementStyles.A_Only:
            return left && !forward && !back && !right;
        case MovementStyles.D_Only:
            return right && !forward && !back && !left;
        case MovementStyles.Half_Sideways:
            return forward && !back && (left || right);
    }

    return true;
}

function GetWishDirection(pawn) {
    const forwardMove = (pawn.IsInputPressed(CSInputs.FORWARD) ? 1 : 0) - (pawn.IsInputPressed(CSInputs.BACK) ? 1 : 0);
    const sideMove = (pawn.IsInputPressed(CSInputs.RIGHT) ? 1 : 0) - (pawn.IsInputPressed(CSInputs.LEFT) ? 1 : 0);
    if (forwardMove === 0 && sideMove === 0) return undefined;

    const { forward, right } = AnglesToVectors({ pitch: 0, yaw: pawn.GetEyeAngles().yaw, roll: 0 });
    const wishX = forward.x * forwardMove + right.x * sideMove;
    const wishY = forward.y * forwardMove + right.y * sideMove;
    const wishLength = Math.sqrt(wishX * wishX + wishY * wishY);
    if (wishLength < 0.0001) return undefined;

    return { x: wishX / wishLength, y: wishY / wishLength };
}

function IsAirStrafeAccelerating(pawn, velocity) {
    const wishDir = GetWishDirection(pawn);
    if (!wishDir) return false;

    const currentSpeed = velocity.x * wishDir.x + velocity.y * wishDir.y;
    return (AIR_SPEED_CAP - currentSpeed) > 0;
}

function ProcessMovementStyles() {
    const now = Instance.GetGameTime();

    let dt = lastStyleThinkTime === undefined ? 0 : now - lastStyleThinkTime;
    lastStyleThinkTime = now;
    if (dt <= 0) return;
    if (dt > 0.1) dt = 0.1;

    if (styleTouchStacks.size === 0 && playerDefaultStyle.size === 0) {
        styleLastSpeed.clear();
        styleViolationState.clear();
        return;
    }

    for (const controller of Instance.GetAllPlayerControllers()) {
        if (!controller.IsConnected()) continue;

        const slot = controller.GetPlayerSlot();

        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) {
            styleLastSpeed.delete(slot);
            styleViolationState.delete(slot);
            continue;
        }

        const active = GetActiveStyle(slot);

        if (active.style === MovementStyles.Normal || pawn.GetGroundEntity() !== undefined || pawn.IsNoclipping()) {
            styleLastSpeed.delete(slot);
            styleViolationState.delete(slot);
            continue;
        }

        const velocity = pawn.GetAbsVelocity();
        const speed = Math.sqrt(velocity.x * velocity.x + velocity.y * velocity.y);

        const previousSpeed = styleLastSpeed.get(slot);
        styleLastSpeed.set(slot, speed);

        if (IsMovementStyleValid(pawn, active.style, velocity, speed)) {
            styleViolationState.delete(slot);
            continue;
        }

        if (!IsAirStrafeAccelerating(pawn, velocity)) continue;

        let violation = styleViolationState.get(slot);
        if (!violation) {
            violation = { startTime: now };
            styleViolationState.set(slot, violation);
        }

        if (speed > STYLE_PENALTY_MIN_SPEED) {
            const baseSpeed = previousSpeed === undefined ? speed : Math.min(speed, previousSpeed);
            const targetSpeed = Math.max(STYLE_PENALTY_MIN_SPEED, baseSpeed - STYLE_PENALTY_DECEL * dt);
            const scale = targetSpeed / speed;

            pawn.Teleport({
                velocity: {
                    x: velocity.x * scale,
                    y: velocity.y * scale,
                    z: velocity.z,
                },
            });

            styleLastSpeed.set(slot, targetSpeed);
            pushLastVelocity.delete(slot);
        }

        if (active.trigger && (now - violation.startTime) >= STYLE_VIOLATION_FIRE_DELAY) {
            Instance.EntFireAtTarget({
                target: active.trigger,
                input: OUTPUT_INPUT_NAME,
                activator: pawn,
                caller: active.trigger,
            });
        }
    }
}

Instance.SetThink(() => {
    Instance.SetNextThink(Instance.GetGameTime());
    CheckGroundTimers();
    ApplyGravityCompensation();
    ProcessAntiStates();
    ProcessPushes();
    ProcessLookTriggers();
    ProcessMovementStyles();
});
Instance.SetNextThink(Instance.GetGameTime());
