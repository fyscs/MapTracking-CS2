/*
    Made by tehlikeli91

    Script Setup:
    1) Add a point_script entity to your map, set its "cs_script" to this file.
    2) Add an empty logic_case entity to your map named "script_bhop" and done.
    
    Features:
        - Teleport example: OnWhatever > script_bhop > InValue > teleport stage1
            Here "stage1" is the name of the entity you want the player teleported to.
            
        - Landmark teleport example: OnWhatever > script_bhop > InValue > teleport stage1 land1
            Same as above, but "land1" is a landmark entity. The player's offset and view
            angle relative to "land1" are preserved and re-applied relative to "stage1"
            
        - Boost example: OnWhatever > script_bhop > InValue > boost 0 0 500
            Adds the given (x y z) vector to the player's current velocity.
            
        - Strip example: OnWhatever > script_bhop > InValue > strip
            Removes all weapons from the player.
            
        - Give example: OnWhatever > script_bhop > InValue > give weapon_glock
            Gives the player the specified weapon by its classname.

        - Gravity example: OnWhatever > script_bhop > InValue > gravity 0.5
            Makes gravity feel like it's scaled by the given factor for that specific player.

    How to set-up bhop blocks:
        1) Add a trigger_multiple to the desired area named "bhop_block"
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output:
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1

    How to set-up max jump zones:
        1) Add a trigger_multiple to the desired area named "bhop_maxjump_<N>",
           where <N> is the number of jumps allowed inside the zone.
        2) Go to the trigger's Outputs tab and hook up the "OnUser1" output,
			- Teleport example: OnUser1 > script_bhop > InValue > teleport stage1
*/

import { Instance, CSPlayerPawn } from 'cs_script/point_script';

const TRIGGER_NAME = "bhop_block";
const GROUND_THRESHOLD = 0.2;

const GROUND_FLICKER_TOLERANCE = 0.05;
const OUTPUT_INPUT_NAME = "FireUser1";
const RELAY_NAME = "script_bhop";

const MAXJUMP_NAME_PATTERN = /^bhop_maxjump_(\d+)$/i;
const TRIGGER_MULTIPLE_CLASSNAME = "trigger_multiple";
const MAXJUMP_RESET_TRIGGER_NAME = "bhop_maxjump_reset";

const WORLD_GRAVITY = 800;
// Скорость отрыва от земли при перевёрнутой гравитации (батут). Примерно
// как у обычного прыжка: меньше — игрок остаётся стоять, больше — подкидывает
// резче, чем в оригинале CS:GO.
const TAKEOFF_SPEED = 300;

let triggers = [];
let relayOutput = undefined;
let hasAnnouncedStartup = false;
let triggerConnectionIds = [];

let playerStates = new Map();
let maxJumpTriggers = new Map();
let jumpStates = new Map();
let playerJumpCounts = new Map();
let lastZoneTrigger = new Map();

let playerGravityScale = new Map();
let lastGravityThinkTime = undefined;
let resetTriggers = [];

function getZoneJumpCount(slot, trigger) {
    const zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts) return 0;
    return zoneCounts.get(trigger) || 0;
}

function setZoneJumpCount(slot, trigger, value) {
    let zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts) {
        zoneCounts = new Map();
        playerJumpCounts.set(slot, zoneCounts);
    }
    zoneCounts.set(trigger, value);
}

function Init() {
    for (const id of triggerConnectionIds) {
        if (id !== undefined && id !== 0) {
            Instance.DisconnectOutput(id);
        }
    }
    triggerConnectionIds = [];

    triggers = Instance.FindEntitiesByName(TRIGGER_NAME);

    for (const trigger of triggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnTriggerStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnTriggerEndTouch(trigger, inputData)));
    }

    InitMaxJumpTriggers();
    InitMaxJumpResetTriggers();

    InitScriptRelay();
    AnnounceStartupOnce();
}

Instance.OnActivate(Init);
Instance.OnScriptReload({ after: Init });
Instance.OnRoundStart(() => {
    playerStates.clear();
    jumpStates.clear();
    playerJumpCounts.clear();
    lastZoneTrigger.clear();
    playerGravityScale.clear();
    lastGravityThinkTime = undefined;
    Init();
});

function AnnounceStartupOnce() {
    if (hasAnnouncedStartup) return;
    hasAnnouncedStartup = true;
    Instance.Msg("Bhop script is running - by tehlikeli91");
}

function InitScriptRelay() {
    const relayEnt = Instance.FindEntityByName(RELAY_NAME);
    if (!relayEnt) return;

    if (relayOutput && relayOutput !== 0) {
        Instance.DisconnectOutput(relayOutput);
    }

    relayOutput = Instance.ConnectOutput(relayEnt, "OnDefault", OnRunScriptFunction);
}

function InitMaxJumpTriggers() {
    maxJumpTriggers.clear();

    const allTriggers = Instance.FindEntitiesByClass(TRIGGER_MULTIPLE_CLASSNAME);

    for (const trigger of allTriggers) {
        const name = trigger.GetEntityName();
        if (!name) continue;

        const match = name.match(MAXJUMP_NAME_PATTERN);
        if (!match) continue;

        const maxJumps = parseInt(match[1], 10);
        if (isNaN(maxJumps) || maxJumps <= 0) continue;

        maxJumpTriggers.set(trigger, maxJumps);

        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnMaxJumpStartTouch(trigger, inputData)));
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnEndTouch", (inputData) => OnMaxJumpEndTouch(trigger, inputData)));
    }
}

function InitMaxJumpResetTriggers() {
    resetTriggers = Instance.FindEntitiesByName(MAXJUMP_RESET_TRIGGER_NAME);

    for (const trigger of resetTriggers) {
        triggerConnectionIds.push(Instance.ConnectOutput(trigger, "OnStartTouch", (inputData) => OnMaxJumpResetTouch(trigger, inputData)));
    }
}

function OnMaxJumpResetTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    playerJumpCounts.delete(slot);
}

function OnMaxJumpStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    jumpStates.set(slot, {
        trigger: trigger,
    });

    lastZoneTrigger.set(slot, trigger);

    const zoneCounts = playerJumpCounts.get(slot);
    if (!zoneCounts || !zoneCounts.has(trigger)) {
        setZoneJumpCount(slot, trigger, 0);
    }
}

function OnMaxJumpEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const state = jumpStates.get(slot);
    if (state && state.trigger === trigger) {
        jumpStates.delete(slot);
    }
}

function OnRunScriptFunction(inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const inputString = inputData.value;
    if (!inputString || typeof inputString !== 'string') return;

    const tokens = inputString.split(" ");

    switch (tokens[0]) {
        case "teleport": {
            const targetName = tokens[1];
            if (!targetName) break;

            const destination = Instance.FindEntityByName(targetName);
            if (!destination) break;

            const landmarkName = tokens[2];

            if (!landmarkName) {
                activator.Teleport({
                    position: destination.GetAbsOrigin(),
                    angles: destination.GetAbsAngles(),
                });
                break;
            }

            const landmark = Instance.FindEntityByName(landmarkName);
            if (!landmark) break;

            const pawnOrigin = activator.GetAbsOrigin();
            const landmarkOrigin = landmark.GetAbsOrigin();
            const destinationOrigin = destination.GetAbsOrigin();

            const offset = {
                x: pawnOrigin.x - landmarkOrigin.x,
                y: pawnOrigin.y - landmarkOrigin.y,
                z: pawnOrigin.z - landmarkOrigin.z,
            };

            const newOrigin = {
                x: destinationOrigin.x + offset.x,
                y: destinationOrigin.y + offset.y,
                z: destinationOrigin.z + offset.z,
            };

            activator.Teleport({ position: newOrigin });
            break;
        }
        case "boost": {
            const x = parseFloat(tokens[1]);
            const y = parseFloat(tokens[2]);
            const z = parseFloat(tokens[3]);
            if (isNaN(x) || isNaN(y) || isNaN(z)) break;

            const currentVelocity = activator.GetAbsVelocity();
            const newVelocity = {
                x: currentVelocity.x + x,
                y: currentVelocity.y + y,
                z: currentVelocity.z + z,
            };

            activator.Teleport({ velocity: newVelocity });
            break;
        }
        case "strip": {
            activator.DestroyWeapons();
            break;
        }
        case "give": {
            const weaponName = tokens[1];
            if (!weaponName) break;

            activator.GiveNamedItem(weaponName);
            break;
        }
        case "gravity": {
            const multiplier = parseFloat(tokens[1]);
            // ОТРИЦАТЕЛЬНЫЙ множитель разрешён: батуты в портированных картах
            // CS:GO сделаны через "gravity -1" (перевёрнутая гравитация на
            // полсекунды). Исходный скрипт их отбрасывал, и батут не работал.
            if (isNaN(multiplier)) break;

            const slot = getPlayerSlot(activator);
            if (slot === undefined) break;

            playerGravityScale.set(slot, multiplier);
            break;
        }
    }
}

function getPlayerSlot(pawn) {
    const controller = pawn.GetPlayerController();
    if (!controller) return undefined;
    return controller.GetPlayerSlot();
}

function OnTriggerStartTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    playerStates.set(slot, {
        pawn: activator,
        trigger: trigger,
        groundStartTime: undefined,
        notified: false,
        lastGroundedTime: undefined,
    });
}

function OnTriggerEndTouch(trigger, inputData) {
    const activator = inputData.activator;
    if (!activator || !activator.IsValid() || !(activator instanceof CSPlayerPawn)) return;

    const slot = getPlayerSlot(activator);
    if (slot === undefined) return;

    const state = playerStates.get(slot);

    if (state && state.trigger === trigger) {
        playerStates.delete(slot);
    }
}

Instance.OnPlayerReset((event) => {
    const slot = getPlayerSlot(event.player);
    if (slot !== undefined) {
        playerStates.delete(slot);
        jumpStates.delete(slot);
        playerJumpCounts.delete(slot);
        lastZoneTrigger.delete(slot);
        playerGravityScale.delete(slot);
    }
});

Instance.OnPlayerDisconnect((event) => {
    playerStates.delete(event.playerSlot);
    jumpStates.delete(event.playerSlot);
    playerJumpCounts.delete(event.playerSlot);
    lastZoneTrigger.delete(event.playerSlot);
    playerGravityScale.delete(event.playerSlot);
});

function CheckGroundTimers() {
    const now = Instance.GetGameTime();

    for (const [slot, state] of playerStates) {
        const pawn = state.pawn;

        if (!pawn.IsValid() || !pawn.IsAlive()) {
            playerStates.delete(slot);
            continue;
        }

        const grounded = pawn.GetGroundEntity() !== undefined;

        if (grounded) {
            state.lastGroundedTime = now;

            if (state.groundStartTime === undefined) {
                state.groundStartTime = now;
            } else if (!state.notified && (now - state.groundStartTime) > GROUND_THRESHOLD) {
                state.notified = true;

                Instance.EntFireAtTarget({
                    target: state.trigger,
                    input: OUTPUT_INPUT_NAME,
                    activator: pawn,
                    caller: state.trigger,
                });
            }
        } else {
            const wasRecentlyGrounded = state.lastGroundedTime !== undefined
                && (now - state.lastGroundedTime) <= GROUND_FLICKER_TOLERANCE;

            if (!wasRecentlyGrounded) {
                state.groundStartTime = undefined;
                state.notified = false;
            }
        }
    }
}

Instance.OnPlayerJump((event) => {
    const pawn = event.player;
    if (!pawn || !pawn.IsValid()) return;

    const slot = getPlayerSlot(pawn);
    if (slot === undefined) return;

    const state = jumpStates.get(slot);
    if (!state) return;

    const trigger = state.trigger;
    const jumpCount = getZoneJumpCount(slot, trigger) + 1;
    setZoneJumpCount(slot, trigger, jumpCount);

    const maxJumps = maxJumpTriggers.get(trigger);
    if (maxJumps !== undefined && jumpCount > maxJumps) {
        Instance.EntFireAtTarget({
            target: trigger,
            input: OUTPUT_INPUT_NAME,
            activator: pawn,
            caller: trigger,
        });

        setZoneJumpCount(slot, trigger, 0);
    }
});

Instance.OnPlayerLand((event) => {
    const pawn = event.player;
    if (!pawn || !pawn.IsValid()) return;

    const slot = getPlayerSlot(pawn);
    if (slot === undefined || jumpStates.has(slot)) return;

    const trigger = lastZoneTrigger.get(slot);
    if (trigger === undefined) return;

    setZoneJumpCount(slot, trigger, 0);
});

function ApplyGravityCompensation() {
    const now = Instance.GetGameTime();

    if (lastGravityThinkTime === undefined) {
        lastGravityThinkTime = now;
        return;
    }

    const dt = now - lastGravityThinkTime;
    lastGravityThinkTime = now;

    if (dt <= 0 || playerGravityScale.size === 0) return;

    for (const [slot, multiplier] of playerGravityScale) {
        const controller = Instance.GetPlayerController(slot);
        if (!controller) {
            playerGravityScale.delete(slot);
            continue;
        }

        const pawn = controller.GetPlayerPawn();
        if (!pawn || !pawn.IsValid() || !pawn.IsAlive()) continue;

        const grounded = pawn.GetGroundEntity() !== undefined;
        if (grounded) {
            // Пониженной гравитации на земле компенсация не нужна — иначе
            // игрока трясёт на месте.
            if (multiplier >= 0) continue;
            // А перевёрнутая гравитация обязана оторвать игрока от земли:
            // батут срабатывает именно когда он СТОИТ на нём. Прибавкой по
            // капле за тик он не взлетит — стоящему движок гасит вертикальную
            // скорость, — поэтому даём разовый рывок, как у прыжка.
            const gv = pawn.GetAbsVelocity();
            if (gv.z < TAKEOFF_SPEED) {
                pawn.Teleport({ velocity: { x: gv.x, y: gv.y, z: TAKEOFF_SPEED } });
            }
            continue;
        }

        const compensation = WORLD_GRAVITY * (1 - multiplier) * dt;
        if (compensation === 0) continue;

        const velocity = pawn.GetAbsVelocity();
        pawn.Teleport({
            velocity: {
                x: velocity.x,
                y: velocity.y,
                z: velocity.z + compensation,
            },
        });
    }
}

Instance.SetThink(() => {
    Instance.SetNextThink(Instance.GetGameTime());
    CheckGroundTimers();
    ApplyGravityCompensation();
});
Instance.SetNextThink(Instance.GetGameTime());